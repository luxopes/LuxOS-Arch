# LuxOS: config.h.in z AUR zaplat ma starou hlavicku -> autoheader ho nepregeneruje (chybi PACKAGE/PROG_PATH)
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -33,6 +33,9 @@
 	patch -p1 -i ${srcdir}/cups.patch
 	patch -p1 -i ${srcdir}/libpng15.patch
 	patch -p1 -i ${srcdir}/configures.patch
+	# LuxOS: autoheader (autoconf 2.72+) neprepise config.h.in, jehoz 1. radek nevypada jako od nej
+	# ("Generated automatically from") -> v config.h chybi PACKAGE, PROG_PATH ...; oprava jen hlavicky
+	find . -name config.h.in -exec sed -i '1s/ Generated automatically from / Generated from /' {} +
 	echo ${srcdir}
 
 	## Compile and install ${_model} stuff
