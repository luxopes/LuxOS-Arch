# LuxOS: cnpkmoduleufr2r bez setuid, /etc/cngplp2/account 0750 root:cups a options 0755 root misto 777 (luxos-cngplp2.install opravi i starsi instalace)
--- /dev/null
+++ b/luxos-cngplp2.install
@@ -0,0 +1,22 @@
+# LuxOS: pacman nemeni prava existujicich adresaru - starsi instalace mely /etc/cngplp2/account a options
+# s pravy 777 (pozdeji 1777). Odkazy a soubory, ktere tam mezitim zalozil kdokoli, patri rootovi.
+_luxos_cngplp2() {
+    if [ -d /etc/cngplp2/account ]; then
+        find /etc/cngplp2/account -mindepth 1 -type l -exec rm -f {} +
+        chown -R root:209 /etc/cngplp2/account
+        chmod 0750 /etc/cngplp2/account
+    fi
+    if [ -d /etc/cngplp2/options ]; then
+        find /etc/cngplp2/options -mindepth 1 -type l -exec rm -f {} +
+        chown -R root:root /etc/cngplp2/options
+        chmod 0755 /etc/cngplp2/options
+    fi
+}
+
+post_install() {
+    _luxos_cngplp2
+}
+
+post_upgrade() {
+    _luxos_cngplp2
+}
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -25,7 +25,7 @@
 
 pkgver="${_pkgver}.1.${_suffix2}"
 epoch=1
-pkgrel=2
+pkgrel=2.2
 pkgdesc='CUPS Canon UFR II LIPSLX CARPS2 printer driver for LBP iR MF ImageCLASS ImageRUNNER Laser Shot i-SENSYS ImagePRESS ADVANCE printers and copiers'
 arch=('x86_64' 'aarch64')
 # Direct links to the download reference go bad on the next version. We want something that will persist for a while.
@@ -45,6 +45,8 @@
 
 conflicts=(cndrvcups-lb cndrvcups-common-lb)
 options=(emptydirs !strip !libtool !debug)
+# LuxOS: bez setuid a bez adresaru zapisovatelnych pro vsechny (luxos-cngplp2.install opravi i starsi instalace)
+install=luxos-cngplp2.install
 
 source=(  "http://gdlp01.c-wss.com/gds/${_dl}/linux-UFRII-drv-v${_pkgver//\./}-${_suffix1}-${_suffix2}.tar.gz"
                 replace_incorrect_int_with_char.patch
@@ -191,6 +193,15 @@
     env "${_vars[@]}" \
     RPM_BUILD_ROOT="${pkgdir}" \
     sh 'make.install.Arch'
+
+    # LuxOS: cnpkmoduleufr2r bez setuid. CUPS spousti filtry pod svym uzivatelem (na Archu cups) a k vykresleni
+    # UFR II root netreba; Canon ho dava setuid jen kvuli cteni nastaveni uctovani uloh v /etc/cngplp2/account.
+    chmod 0755 "$pkgdir/usr/bin/cnpkmoduleufr2r"
+    # /etc/cngplp2: Canon dava 777. options/options.conf cte filtr (cnrsdrvufr2), account (uctovani uloh,
+    # hesla) jen filtr - skupina cups (209, pevne GID z balicku cups), ostatni uzivatele nic
+    chmod 0755 "$pkgdir/etc/cngplp2" "$pkgdir/etc/cngplp2/options"
+    chgrp 209 "$pkgdir/etc/cngplp2/account"
+    chmod 0750 "$pkgdir/etc/cngplp2/account"
     
     # package creates empty directories in /etc and /usr.
     # If those in /etc are not present, some functionality is unavailable. manually remove the empty in /usr
