[Unit]
Description=Initializes the package signing keyring
Requires=etc-pacman.d-gnupg.mount
After=etc-pacman.d-gnupg.mount time-sync.target
BindsTo=etc-pacman.d-gnupg.mount
Before=archlinux-keyring-wkd-sync.service

[Service]
Type=oneshot
RemainAfterExit=yes
# LuxOS: pacman-key je nastroj jadra lux (lux-engine), mimo /usr/bin
Environment=PATH=/usr/lib/lux/alpm/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/lux/alpm/bin/pacman-key --init
ExecStart=/usr/lib/lux/alpm/bin/pacman-key --populate

[Install]
WantedBy=multi-user.target
