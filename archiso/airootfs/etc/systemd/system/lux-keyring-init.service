[Unit]
Description=Initializes the package signing keyring
Requires=etc-lux-keyring.mount
After=etc-lux-keyring.mount time-sync.target
BindsTo=etc-lux-keyring.mount
Before=archlinux-keyring-wkd-sync.service

[Service]
Type=oneshot
RemainAfterExit=yes
# LuxOS: lux-engine-key je nastroj jadra lux (lux-engine), mimo /usr/bin
Environment=PATH=/usr/lib/lux/alpm/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/lux/alpm/bin/lux-engine-key --init
ExecStart=/usr/lib/lux/alpm/bin/lux-engine-key --populate

[Install]
WantedBy=multi-user.target
