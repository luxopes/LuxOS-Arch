# LuxOS - widgety na plose (luxos-widgets, na Waylandu plochy na vrstve BOTTOM); pro nahled, X11 je spousti
# luxos-session. Vypnute widgety (luxos-widgets off) hned skonci s kodem 0, proto bez Restart=always.
[Unit]
Description=LuxOS desktop widgets
PartOf=graphical-session.target
After=graphical-session.target luxos-backdrop.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=/usr/bin/luxos-widgets
Restart=on-failure
RestartSec=1
Slice=session.slice
