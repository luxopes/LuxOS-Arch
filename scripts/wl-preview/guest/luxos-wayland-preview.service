# LuxOS - nahled relace na Waylandu: uzivatel luxos prihlaseny automaticky na tty1 (misto getty).
# Relace logind (seat0, typ wayland) dava luxwm pristup k DRM a vstupum pres libseat. Prihlaseni na tty2 zustava.
[Unit]
Description=LuxOS Wayland preview session on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=luxos
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
WorkingDirectory=~
ExecStart=/usr/bin/luxos-wayland-preview
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
