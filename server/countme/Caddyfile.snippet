# LuxOS countme - vlozit do existujiciho bloku luxos.lux-ai.cz { ... } v /etc/caddy/Caddyfile
# PRED ostatni handle/handle_path (napr. /repo, /staging), pak: caddy validate && systemctl reload caddy
#
#   https://luxos.lux-ai.cz/countme?v=1.0.0&arch=x86_64&ch=stable&age=1  ->  http://127.0.0.1:8766/countme?...
#   https://luxos.lux-ai.cz/stats/usage.json                              ->  http://127.0.0.1:8766/stats/usage.json
#
# Soukromi: /countme NESMI mit access log (log_skip; Caddy < 2.8: skip_log) - jinak by v logu Caddy
# zustaly IP adresy pocitacu. Sluzba sama nic po pozadavcich neloguje a IP drzi jen jako HMAC v pameti.
# X-Forwarded-For nastavi Caddy sam na skutecnou IP klienta (hlavicku od nedoverujiciho klienta
# zahodi); sluzba bere posledni prvek.

	handle /countme {
		log_skip
		header {
			-Server
			Cache-Control "no-store"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
		}
		request_body {
			max_size 1KB
		}
		reverse_proxy 127.0.0.1:8766 {
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
				keepalive 60s
				keepalive_idle_conns 4
			}
		}
	}

	# verejna statistika pro web (luxos.lux-ai.cz/stats/); sluzba ji prepocita nejvys jednou za 10 min
	handle /stats/usage.json {
		encode zstd gzip
		header {
			-Server
			Cache-Control "public, max-age=600"
			X-Content-Type-Options nosniff
		}
		request_body {
			max_size 1KB
		}
		reverse_proxy 127.0.0.1:8766 {
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}
