# Maintainer: LuxOS Team

pkgname=lux
pkgver=0.3.0
pkgrel=14
pkgdesc="LuxOS package manager (libalpm via pyalpm, Flathub, community/AUR in the sandbox and .lux apps)"
arch=(any)
url="https://github.com/luxopes/LuxOS-Arch"
license=(GPL-3.0-or-later)
# "pacman" = virtualni zavislost (poskytuje ji lux-engine, drive luxos-pacman): starsi lux/Obchod,
# ktere nahrazeni baliku odmitnou, tak aktualizuji vse ostatni a lux-engine nahradi az novy lux.
# /etc/lux/lux.conf a lux-config jsou od LuxOS 0.9.6 v lux-engine (konfigurace i jadra).
depends=(bash python pyalpm pacman curl jq sudo reflector fzf tar zstd gnupg luxos-drivers luxos-keyring luxos-i18n)
optdepends=('luxos-sandbox: build and install community (AUR) packages isolated (default)'
            'base-devel: build community (AUR) packages into the system (--system)'
            'git: download community (AUR) build scripts'
            'flatpak: Flathub applications')

package() {
    install -Dm755 "$startdir/lux" "$pkgdir/usr/bin/lux"
    install -Dm644 "$startdir/luxpkg.sh" "$pkgdir/usr/lib/lux/luxpkg.sh"
    install -Dm755 "$startdir/lux_alpm.py" "$pkgdir/usr/lib/lux/lux_alpm.py"
    install -Dm755 "$startdir/lux_community.py" "$pkgdir/usr/lib/lux/lux_community.py"
    install -Dm755 "$startdir/pacman-hint" "$pkgdir/usr/lib/lux/pacman-hint"
    install -Dm644 "$startdir/lux.md" "$pkgdir/usr/share/doc/lux/lux.md"
    install -Dm644 "$startdir/lux.1" "$pkgdir/usr/share/man/man1/lux.1"   # makepkg ji zabali do lux.1.gz
    install -Dm644 "$startdir/lux-package-format.md" "$pkgdir/usr/share/doc/lux/lux-package-format.md"
    install -dm755 "$pkgdir/opt/lux" "$pkgdir/var/lib/lux/installed"
    install -Dm644 "$startdir/lux.bash-completion" "$pkgdir/usr/share/bash-completion/completions/lux"
}
