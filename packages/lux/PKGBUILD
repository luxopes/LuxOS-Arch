# Maintainer: LuxOS Team

pkgname=lux
pkgver=0.1.0
pkgrel=1
pkgdesc="LuxOS package manager (pacman, AUR and Flatpak frontend)"
arch=(any)
url="https://github.com/luxos"
license=(MIT)
depends=(bash pacman pacman-contrib curl jq sudo reflector luxos-drivers luxos-keyring)
optdepends=('base-devel: build packages from AUR'
            'git: build packages from AUR'
            'flatpak: Flathub applications')
backup=(etc/lux/lux.conf)

package() {
    install -Dm755 "$startdir/lux" "$pkgdir/usr/bin/lux"
    install -Dm644 "$startdir/lux.conf" "$pkgdir/etc/lux/lux.conf"
    install -Dm644 "$startdir/lux.bash-completion" "$pkgdir/usr/share/bash-completion/completions/lux"
}
