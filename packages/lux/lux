#!/bin/bash
# lux - spravce baliku LuxOS (prikaz pacman v LuxOS neni; kdo ho napise, shell ukaze prikaz lux)
#
# Repozitare Arch Linuxu a LuxOS spravuje pres libalpm (pyalpm, /usr/lib/lux/lux_alpm.py):
# databaze /var/lib/lux, konfigurace /etc/lux/lux.conf (vlastni format, lux-config), podpisy a hooky.
# Bez pyalpm (nebo s LUX_BACKEND=engine) pouzije nastroj jadra lux-engine (/usr/lib/lux/alpm/bin).
# Dale AUR, Flatpak a vlastni format .lux.
set -o pipefail

# Nastroje jadra (lux-engine, lux-engine-conf, lux-engine-key) jsou mimo PATH. Dedi to i hooky
# a skriptlety transakci a makepkg. Pro roota pevna cesta (ne PATH uzivatele).
LUX_ENGINE_BIN=${LUX_ENGINE_BIN:-/usr/lib/lux/alpm/bin}
LUX_ROOT_PATH="$LUX_ENGINE_BIN:/usr/local/sbin:/usr/local/bin:/usr/bin"
case ":$PATH:" in
    *:"$LUX_ENGINE_BIN":*) ;;
    *) export PATH="$LUX_ENGINE_BIN${PATH:+:$PATH}" ;;
esac

LUX_VERSION=0.3.0
[[ -r /usr/lib/luxos/i18n.sh ]] && . /usr/lib/luxos/i18n.sh
declare -F T >/dev/null || T() { local f=$1; shift; printf -- "$f" "$@"; }
LUX_AUR_RPC="https://aur.archlinux.org/rpc/v5"
LUX_AUR_GIT="https://aur.archlinux.org"

# Vychozi nastaveni (prepisuje /etc/lux/lux.conf a ~/.config/lux/lux.conf - nacte je lux-config,
# viz lux_load_config)
AUR=1
REVIEW_PKGBUILD=1
FLATPAK=1
CLEAN_KEEP=2
if [[ -z ${LUX_CONFIG-} ]]; then
    LUX_CONFIG=/usr/lib/lux/lux-config
    # spusteni z repozitare (packages/lux/lux -> packages/lux-engine/lux_config.py)
    [[ -x $LUX_CONFIG ]] || LUX_CONFIG="$(dirname "$(readlink -f "$0")")/../lux-engine/lux_config.py"
fi
LUX_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lux"
# Vlastni format balicku LuxOS (.lux)
LUXPKG=${LUXPKG:-/usr/lib/lux/luxpkg.sh}
[[ -r $LUXPKG ]] || LUXPKG="$(dirname "$(readlink -f "$0")")/luxpkg.sh"
. "$LUXPKG"

YES=0
VERBOSE=0
ONLY=""   # repo | aur
LUX_SELF=$(readlink -f "$0")
# Backend libalpm (vedle skriptu pri spusteni z repozitare)
LUX_ALPM=${LUX_ALPM:-/usr/lib/lux/lux_alpm.py}
[[ -x $LUX_ALPM ]] || LUX_ALPM="$(dirname "$LUX_SELF")/lux_alpm.py"
# nastroj jadra (lux-engine) pro zalozni backend a dotazy
LUX_ENGINE=${LUX_ENGINE:-$LUX_ENGINE_BIN/lux-engine}
# jadro z LuxOS 0.9.0 (luxos-pacman) do vymeny za lux-engine
[[ -x $LUX_ENGINE || ! -x $LUX_ENGINE_BIN/pacman ]] || LUX_ENGINE=$LUX_ENGINE_BIN/pacman
# Zdroj komunita (AUR) a Flathub: kontrola skriptu (LuxAI Lite) a vyhledani aplikaci
LUX_COMMUNITY=${LUX_COMMUNITY:-/usr/lib/lux/lux_community.py}
[[ -x $LUX_COMMUNITY ]] || LUX_COMMUNITY="$(dirname "$LUX_SELF")/lux_community.py"
LUX_SANDBOX=${LUX_SANDBOX:-/usr/bin/luxos-sandbox}
# Snimky systemu a navrat (LuxOS Care, luxos_snapshots.py)
LUX_CARE=${LUX_CARE:-/usr/bin/luxos-care}
LUX_CMDLINE=${LUX_CMDLINE:-/proc/cmdline}
SYSTEM_OK=0   # --system: balik z komunity smi do systemu (jinak sandbox)
# Napoveda pro zvyk z Archu (lux -Syu): /usr/lib/lux/pacman-hint, pri spusteni z repozitare vedle skriptu
LUX_HINT=${LUX_HINT:-/usr/lib/lux/pacman-hint}
[[ -x $LUX_HINT ]] || LUX_HINT="$(dirname "$LUX_SELF")/pacman-hint"

# --- Vystup ---------------------------------------------------------------
# Barvy se rozhodnou jednou (proces pod sudo/pkexec uz NO_COLOR ani terminal uzivatele nemusi videt)
if [[ -z ${LUX_COLOR-} ]]; then
    if [[ -t 1 && -z ${NO_COLOR-} ]]; then LUX_COLOR=always; else LUX_COLOR=never; fi
fi
export LUX_COLOR
if [[ $LUX_COLOR == always ]]; then
    B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' C=$'\e[38;2;167;123;255m' G=$'\e[32m' Y=$'\e[33m' E=$'\e[31m'
else
    B="" D="" R="" C="" G="" Y="" E=""
fi
say()  { printf '%s✦%s %s\n' "$C" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }
ask() {  # ask "Otazka" [Y|n] -> 0 = ano
    local def=${2:-Y} a
    ((YES)) && return 0
    if [[ $def == Y ]]; then read -rp "$B$1$R [Y/n] " a; [[ -z $a || $a == [yYaA]* ]]
    else read -rp "$B$1$R [y/N] " a; [[ $a == [yYaA]* ]]; fi
}
# Prava roota automaticky: sudo v terminalu, jinak pkexec (graficke overeni); jazyk a barvy se predaji
as_root() {
    if ((EUID == 0)); then "$@"; return; fi
    # sudo/pkexec nastavi vlastni PATH - nastroje jadra pro hooky a skriptlety transakci
    local -a envv=(/usr/bin/env "PATH=$LUX_ROOT_PATH" "LUX_COLOR=$LUX_COLOR" "LANG=${LANG:-C.UTF-8}")
    [[ -n ${LC_ALL-} ]] && envv+=("LC_ALL=$LC_ALL")
    [[ -n ${NO_COLOR-} ]] && envv+=("NO_COLOR=$NO_COLOR")
    [[ -n ${LUX_BACKEND-} ]] && envv+=("LUX_BACKEND=$LUX_BACKEND")
    if [[ -t 0 ]] && command -v sudo &>/dev/null; then sudo "${envv[@]}" "$@"
    elif command -v pkexec &>/dev/null && [[ -n ${DISPLAY-}${WAYLAND_DISPLAY-} ]]; then pkexec "${envv[@]}" "$@"
    elif command -v sudo &>/dev/null; then sudo "${envv[@]}" "$@"
    elif command -v pkexec &>/dev/null; then pkexec "${envv[@]}" "$@"
    else die "$(T "This needs administrator rights (sudo or pkexec).")"; fi
}
pac_yes() { ((YES)) && echo --noconfirm; }

# /etc/lux/lux.conf: nastaveni lux a konfigurace jadra (/run/lux/engine.conf). S chybou lux nebezi
# (lux-config vypise soubor a radek); jadro zatim pouziva posledni funkcni konfiguraci.
lux_load_config() {
    local env
    # bez lux-config (jadro z LuxOS 0.9.0 pred vymenou): vychozi nastaveni, lux update jadro vymeni
    [[ -x $LUX_CONFIG ]] || return 0
    if ! env=$("$LUX_CONFIG" env); then
        die "$(T "lux will not run until the configuration is fixed (/etc/lux/lux.conf). Check it with: lux config check")"
    fi
    local line
    while IFS= read -r line; do
        case $line in
            AUR=[01]|REVIEW_PKGBUILD=[01]|FLATPAK=[01]|CLEAN_KEEP=[0-9]*) eval "$line" ;;
            LUX_ENGINE_CONF=*)
                # uzivatel bez prav k /run/lux: vlastni kopie (nastroje jadra ji dostanou pres --config)
                [[ ${line#*=} != /run/lux/engine.conf ]] && export LUX_ENGINE_CONF_FILE=${line#*=} ;;
        esac
    done <<<"$env"
}
# --- Backend libalpm -------------------------------------------------------
# alpm_ok: pyalpm je k dispozici a umi vse, co konfigurace jadra pouziva (jinak se pouzije lux-engine)
alpm_ok() {
    if [[ -z ${LUX_ALPM_OK-} ]]; then
        if [[ ${LUX_BACKEND-} != @(engine|pacman) && -x $LUX_ALPM ]] && "$LUX_ALPM" available &>/dev/null; then
            LUX_ALPM_OK=1
        else
            LUX_ALPM_OK=0
        fi
    fi
    ((LUX_ALPM_OK))
}
alpm_flags() {
    local l=${LC_ALL:-${LC_MESSAGES:-${LANG-}}}
    ALPM_FLAGS=(--color="$LUX_COLOR")
    [[ -n $l ]] && ALPM_FLAGS+=(--lang "$l")
    ((YES)) && ALPM_FLAGS+=(-y)
    ((VERBOSE)) && ALPM_FLAGS+=(--verbose)
    # Sporic dat: stahovani se nezakazuje (uzivatel ho spustil sam), jen se pripomene velikost
    [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/luxos/datasaver ]] && ALPM_FLAGS+=(--datasaver)
    return 0
}
alpm()      { alpm_flags; "$LUX_ALPM" "${ALPM_FLAGS[@]}" "$@"; }
alpm_root() { alpm_flags; as_root "$LUX_ALPM" "${ALPM_FLAGS[@]}" "$@"; }

# Instalace z repozitaru / souboru .pkg.tar.* (pouziva i drivers, AUR a zavislosti .lux)
repo_install() {
    (($#)) || return 0
    if alpm_ok; then
        alpm_root install --needed -- "$@"
    else
        local -a names=() files=() a
        for a in "$@"; do if [[ $a == *.pkg.tar* && -f $a ]]; then files+=("$a"); else names+=("$a"); fi; done
        if ((${#names[@]})); then pac_run -S --needed $(pac_yes) "${names[@]}" || return 1; fi
        if ((${#files[@]})); then pac_run -U --needed $(pac_yes) "${files[@]}" || return 1; fi
        ok "$(T "Installed: %s" "$*")"
    fi
}

# Chyby site od jadra citelne: "failed retrieving file X from Y" -> jedna kratka radka
pac_net_filter() {  # pac_net_filter ZNACKA_SOUBOR (do souboru zapise "net", kdyz selhalo stahovani)
    local line="" c host seen=""
    pac_net_line() {
        # anglicky i cesky vystup jadra ("failed retrieving file 'X' from H" / "selhalo ziskani souboru 'X' z H")
        if [[ $line =~ (failed\ retrieving\ file|selhalo\ získání\ souboru)\ \'([^\']+)\'\ (from|z)\ ([^ :]+) ]]; then
            host=${BASH_REMATCH[4]}
            [[ " $seen " == *" $host "* ]] ||
                printf '%s  ↻ %s%s\n' "$D" "$(T "Server %s is not responding, trying another one…" "$host")" "$R" >&2
            seen+=" $host"
            echo net >"$1"
        elif [[ $line == *"too many errors from"* || $line == *"failed to retrieve some files"* ||
                $line == *"příliš mnoho chyb"* || $line == *"získání některých souborů"* ]]; then
            echo net >"$1"
        elif [[ ($line == *"failed to commit transaction"* || $line == *"selhalo provádění transakce"* ||
                 $line == *"žádné balíčky nebyly"* || $line == *"no packages were"*) && -s $1 ]]; then
            :
        else
            printf '%s\n' "$line" >&2
        fi
    }
    # Po znacich: otazka jadra ("Pokracovat v instalaci? [A/n]") nekonci novym radkem -
    # kdyz chvili nic neprijde, nedokonceny radek se vypise hned (jinak by otazka nebyla videt)
    while :; do
        if IFS= read -r -N 1 -t 0.15 c; then
            if [[ $c == $'\n' ]]; then pac_net_line "$1"; line=""; else line+=$c; fi
        elif (($? > 128)); then
            [[ -n $line ]] && { printf '%s' "$line" >&2; line=""; }
        else
            [[ -n $line ]] && pac_net_line "$1"
            break
        fi
    done
}

# lux-engine s opakovanim pri vypadku site (az 3 pokusy); prubeh stahovani zustava na terminalu
pac_run() {
    local attempt rc=0 mark extra=()
    mark=$(mktemp)
    for attempt in 1 2 3; do
        : >"$mark"
        if ((attempt > 1)); then
            printf '\n%s↻%s %s\n' "$Y" "$R" "$(T "Download failed, trying again (%s/3)…" "$attempt")"
            extra=(--noconfirm)      # souhlas uz padl pri prvnim pokusu
            sleep 2
        fi
        as_root "$LUX_ENGINE" "$@" "${extra[@]}" 2> >(pac_net_filter "$mark")
        rc=$?
        wait $! 2>/dev/null
        ((rc == 0)) && break
        [[ -s $mark ]] || break      # jina chyba nez sit (konflikt, zruseno...) - neopakovat
    done
    if ((rc != 0)) && [[ -s $mark ]]; then
        printf '%s✗%s %s\n' "$E" "$R" "$(T "Some packages could not be downloaded. Check your internet connection and try again.")" >&2
    fi
    rm -f "$mark"
    return "$rc"
}

# --- Pomocne funkce pro repozitare ------------------------------------------
in_repos()   { "$LUX_ENGINE" -Sp --print-format '%n' -- "$1" &>/dev/null || "$LUX_ENGINE" -Sg -- "$1" &>/dev/null; }
installed()  { "$LUX_ENGINE" -T -- "$1" &>/dev/null; }
strip_ver()  { sed -E 's/[<>=].*$//' <<<"$1"; }

# --- AUR --------------------------------------------------------------------
need_aur_tools() {
    ((AUR)) || die "$(T "AUR is disabled in lux.conf")"
    command -v jq &>/dev/null || die "$(T "jq is required for AUR support")"
    if ((EUID == 0)); then die "$(T "AUR packages must be built as a regular user (run lux without sudo)")"; fi
    if ! "$LUX_ENGINE" -Qq base-devel &>/dev/null || ! command -v git &>/dev/null; then
        say "$(T "Building AUR packages needs %sbase-devel%s and %sgit%s." "${B}" "${R}" "${B}" "${R}")"
        ask "$(T "Install them now?")" || exit 1
        (YES=1; repo_install base-devel git) || exit 1
    fi
}

# aur_info pkg... -> JSON pole vysledku
aur_info() {
    local q="" p
    for p in "$@"; do q+="&arg[]=$(jq -rn --arg v "$p" '$v|@uri')"; done
    curl -fsSL --max-time 20 "$LUX_AUR_RPC/info?${q#&}" | jq -c '.results'
}

aur_exists() { [[ $(aur_info "$1" | jq 'length') -gt 0 ]]; }

# Rekurzivne vyresi AUR zavislosti; vysledek v poli AUR_ORDER (zavislosti prvni), zavislosti
# z repozitaru v AUR_REPODEPS[balik]. Pro sandbox se nehledi na to, co je nainstalovane v systemu.
declare -a AUR_ORDER=()
declare -A AUR_SEEN=() AUR_BASE=() AUR_REPODEPS=()
aur_resolve() {
    local pkg=$1 info deps d name
    [[ -n ${AUR_SEEN[$pkg]-} ]] && return 0
    AUR_SEEN[$pkg]=1
    info=$(aur_info "$pkg") || die "$(T "AUR is not reachable")"
    [[ $(jq 'length' <<<"$info") -gt 0 ]] || die "$(T "Package '%s' was not found in repositories or AUR" "$pkg")"
    AUR_BASE[$pkg]=$(jq -r '.[0].PackageBase' <<<"$info")
    mapfile -t deps < <(jq -r '.[0] | (.Depends // []) + (.MakeDepends // []) + (.CheckDepends // []) | .[]' <<<"$info")
    AUR_REPODEPS[$pkg]=""
    for d in "${deps[@]}"; do
        name=$(strip_ver "$d")
        [[ $COMMUNITY_TARGET == system ]] && installed "$d" && continue
        if in_repos "$name"; then AUR_REPODEPS[$pkg]+=" $name"; continue; fi
        aur_resolve "$name"
    done
    AUR_ORDER+=("$pkg")
}

# Stazeni skriptu z AUR (git clone nic nespousti) do mezipameti uzivatele. Kontroluje a sestavuje se
# cisty export commitu HEAD (git archive) v AUR_DIR - zadne zbytky starych sestaveni ani neverzovane soubory.
aur_fetch() {  # aur_fetch base -> adresar v AUR_DIR
    local base=$1 git_dir
    # jmeno z AUR RPC slouzi jako cesta (a pak rm -rf) - jen platne jmeno baliku
    [[ $base =~ ^[A-Za-z0-9@_+][A-Za-z0-9@._+-]*$ ]] || die "$(T "Cannot clone %s from AUR" "$base")"
    git_dir="$LUX_CACHE/aur/$base"
    AUR_DIR="$LUX_CACHE/aur-build/$base"
    mkdir -p "$LUX_CACHE/aur" "$LUX_CACHE/aur-build"
    if [[ -d $git_dir/.git ]]; then
        git -C "$git_dir" fetch -q origin && git -C "$git_dir" reset -q --hard FETCH_HEAD ||
            die "$(T "Cannot update %s from AUR" "$base")"
    else
        git clone -q "$LUX_AUR_GIT/$base.git" "$git_dir" || die "$(T "Cannot clone %s from AUR" "$base")"
    fi
    # symbolicke odkazy (a podmoduly) by mohly ukazovat mimo repozitar - takovy balik se odmita
    if git -C "$git_dir" ls-tree -r --full-tree HEAD | grep -qE '^(120000|160000) '; then
        die "$(T "%s contains symbolic links - community packages with links are refused" "$base")"
    fi
    rm -rf "$AUR_DIR"
    mkdir -p "$AUR_DIR" || die "$(T "Cannot update %s from AUR" "$base")"
    if ! git -C "$git_dir" archive --format=tar HEAD | tar -x --no-same-owner -C "$AUR_DIR" -f -; then
        die "$(T "Cannot update %s from AUR" "$base")"
    fi
}

# Kontrola sestavovaciho skriptu: pevna pravidla + LuxAI Lite (lux_community.py review).
# Nastavi REVIEW_VERDICT (safe|suspicious|dangerous|unreviewed) a vypise vysledek.
REVIEW_VERDICT=unreviewed
aur_review() {  # aur_review adresar base
    local dir=$1 base=$2 kind a b c out
    REVIEW_VERDICT=unreviewed
    say "$(T "Checking the build script of %s (LuxAI Lite)" "${B}$base${R}")"
    out=$("$LUX_COMMUNITY" review "$dir" "$base" 2>/dev/null) || out=$'VERDICT\tunreviewed'
    while IFS=$'\t' read -r kind a b c; do
        case $kind in
            VERDICT) [[ $a == @(safe|suspicious|dangerous|unreviewed) ]] && REVIEW_VERDICT=$a ;;
        esac
    done <<<"$out"
    case $REVIEW_VERDICT in
        safe)       ok "$(T "LuxAI found nothing suspicious in the build script.")" ;;
        suspicious) warn "$(T "The build script looks suspicious:")" ;;
        dangerous)  printf '%s✗%s %s\n' "$E" "$R" "$(T "The build script looks dangerous:")" >&2 ;;
        *)          warn "$(T "The build script was not checked by LuxAI.")" ;;
    esac
    while IFS=$'\t' read -r kind a b c; do
        case $kind in
            REASON)  printf '    • %s\n' "$a" ;;
            FINDING) [[ $a == low ]] && ((!VERBOSE)) && continue
                     printf '    • %s%s%s\n' "$D" "$b" "$R" ;;
            NOTE)    printf '    %s(%s)%s\n' "$D" "$a" "$R" ;;
        esac
    done <<<"$out"
}

# Kam se balik z komunity nainstaluje: vychozi je sandbox, do systemu jen po vyslovnem svoleni
# (--system nebo napsane slovo "system"). S chybejicim terminalem (napr. LuxAI) jen sandbox.
COMMUNITY_TARGET=""
choose_target() {
    local a
    [[ -n $COMMUNITY_TARGET ]] && return 0
    if ((SYSTEM_OK)); then COMMUNITY_TARGET=system; return 0; fi    # bez terminalu odmitne aur_install
    COMMUNITY_TARGET=sandbox
    ((YES)) && return 0
    [[ -t 0 ]] || return 0
    printf '%s\n' "$(T "Where should it be installed?")"
    printf '  %s1%s  %s\n' "$B" "$R" "$(T "Sandbox - isolated from your files and system (recommended)")"
    printf '  %s2%s  %s\n' "$B" "$R" "$(T "System - full access to the computer")"
    read -rp "$B$(T "Choose 1 or 2:")$R [1] " a
    if [[ $a == 2 ]]; then
        read -rp "$B$(T "Type %s to confirm installing community code into the system:" "system")$R " a
        if [[ ${a,,} == system || ${a,,} == "$(T "system")" ]]; then COMMUNITY_TARGET=system
        else say "$(T "Installing into the sandbox instead.")"; fi
    fi
}

# Do systemu jen z interaktivniho terminalu (ne automat, ne presmerovany vstup)
system_needs_tty() {
    [[ $COMMUNITY_TARGET != system || -t 0 ]] && return 0
    warn "$(T "Community packages are installed into the system only from an interactive terminal (without --system they go to the sandbox).")"
    return 1
}

# Po kontrole: smi se pokracovat? (nebezpecny skript nikdy do systemu, s -y vubec)
review_allows() {  # review_allows base
    system_needs_tty || return 1
    case $REVIEW_VERDICT in
        safe) ask "$(T "Build and install %s?" "${B}$1${R}")" Y ;;
        dangerous)
            [[ $COMMUNITY_TARGET == system ]] && { warn "$(T "A dangerous build script is never installed into the system.")"; return 1; }
            ((YES)) && return 1
            YES=0 ask "$(T "Install %s into the sandbox anyway?" "${B}$1${R}")" n ;;
        *)
            if [[ $COMMUNITY_TARGET == system ]]; then
                ((YES)) && { warn "$(T "Without a clean check it needs your confirmation (run without -y).")"; return 1; }
                YES=0 ask "$(T "Install %s into the system anyway?" "${B}$1${R}")" n
            else
                ask "$(T "Build and install %s in the sandbox?" "${B}$1${R}")" Y
            fi ;;
    esac
}

aur_build() {  # aur_build pkg [asdeps]
    local pkg=$1 asdeps=${2:-0} base=${AUR_BASE[$1]:-$1}
    aur_fetch "$base"
    local dir=$AUR_DIR
    if ((REVIEW_PKGBUILD)); then
        aur_review "$dir" "$base"
        if ((!YES)) && [[ -t 0 ]] && ask "$(T "Show the build script (PKGBUILD) of %s?" "${B}$base${R}")" n; then
            if command -v bat &>/dev/null; then bat --paging=always -l bash "$dir/PKGBUILD"; else less "$dir/PKGBUILD"; fi
        fi
        review_allows "$base" || die "$(T "Cancelled")"
    elif [[ $COMMUNITY_TARGET == system ]]; then
        # kontrola vypnuta (REVIEW_PKGBUILD=0): do systemu jako nezkontrolovany skript
        REVIEW_VERDICT=unreviewed
        warn "$(T "The build script was not checked by LuxAI.")"
        review_allows "$base" || die "$(T "Cancelled")"
    fi
    if [[ $COMMUNITY_TARGET == sandbox ]]; then
        say "$(T "Building %s %s(community)%s in the sandbox" "${B}$base${R}" "${D}" "${R}")"
        local -a sflags=()
        ((asdeps)) && sflags+=(--asdeps)
        [[ -n ${AUR_REPODEPS[$pkg]// /} ]] && sflags+=(--deps "${AUR_REPODEPS[$pkg]# }")
        tar -C "$dir" -cf - . | "$LUX_SANDBOX" build-install "${sflags[@]}" "$base" ||
            die "$(T "Build of %s in the sandbox failed" "$base")"
        return 0
    fi
    say "$(T "Building %s %s(community)%s" "${B}$base${R}" "${D}" "${R}")"
    local flags=(-si --needed --noconfirm)
    ((asdeps)) && flags+=(--asdeps)
    (cd "$dir" && PACMAN=$LUX_ENGINE makepkg "${flags[@]}") || die "$(T "Build of %s failed (see %s)" "$base" "$dir")"
}

aur_install() {
    (($#)) || return 0
    ((AUR)) || die "$(T "AUR is disabled in lux.conf")"
    # LuxAI (a jine automaty) balik z komunity nikdy neinstaluji - jen uzivatel sam
    if [[ ${LUXAI_AGENT-} == 1 ]]; then
        die "$(T "%s is only in the community source (AUR). LuxAI does not install community packages - run in Terminal: lux install %s" "$*" "$*")"
    fi
    ((EUID == 0)) && die "$(T "Community packages are installed as a regular user (run lux without sudo)")"
    printf '%s!%s %s\n' "$Y" "$R" "$(T "%s comes from the community source (AUR): scripts by other users, not checked by LuxOS." "${B}$*${R}")" >&2
    choose_target
    system_needs_tty || exit 1
    if [[ $COMMUNITY_TARGET == sandbox ]]; then
        command -v jq &>/dev/null || die "$(T "jq is required for AUR support")"
        command -v git &>/dev/null || { (YES=1; repo_install git) || exit 1; }
        [[ -x $LUX_SANDBOX ]] || die "$(T "The sandbox is not installed (lux install luxos-sandbox), or install into the system with --system")"
        if ! "$LUX_SANDBOX" status --json 2>/dev/null | grep -q '"exists": true'; then
            say "$(T "Creating your sandbox first")"
            "$LUX_SANDBOX" create || exit 1
        fi
    else
        need_aur_tools
    fi
    AUR_ORDER=(); AUR_SEEN=(); AUR_BASE=(); AUR_REPODEPS=()
    local p
    for p in "$@"; do aur_resolve "$p"; done
    ((${#AUR_ORDER[@]} > $#)) && say "$(T "Community packages to build: %s" "${B}${AUR_ORDER[*]}${R}")"
    declare -A wanted=()
    for p in "$@"; do wanted[$p]=1; done
    for p in "${AUR_ORDER[@]}"; do
        if [[ -n ${wanted[$p]-} ]]; then aur_build "$p" 0; else aur_build "$p" 1; fi
    done
    if [[ $COMMUNITY_TARGET == sandbox ]]; then
        ok "$(T "Installed in the sandbox: %s" "$*")"
        say "$(T "Start it with: %s" "${B}luxos-sandbox run --gui --net $1${R}")"
    fi
}

# --- Flathub ----------------------------------------------------------------
# Aplikace z Flathubu (pred komunitou/AUR): bezi ve vlastnim izolovanem prostredi Flatpaku.
# flathub_resolve nazev -> FLATHUB_ID (zoom -> us.zoom.Zoom); vice shod = nabidka (bez terminalu nic)
FLATHUB_ID=""
APP_ID_RE='^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+){2,}$'   # jako APP_ID v lux_community.py
flathub_resolve() {
    local out state i
    local -a ids=()
    FLATHUB_ID=""
    out=$("$LUX_COMMUNITY" flathub "$1" 2>/dev/null) || return 1
    state=${out%%$'\t'*}
    read -ra ids <<<"${out#*$'\t'}"
    case $state in
        ok) FLATHUB_ID=${ids[0]} ;;
        ambiguous)
            ((YES)) || [[ ! -t 0 ]] && return 1
            say "$(T "Several apps on Flathub match '%s':" "$1")"
            for i in "${!ids[@]}"; do printf '  %s%d%s  %s\n' "$B" $((i + 1)) "$R" "${ids[$i]}"; done
            read -rp "$B$(T "Choose a number (Enter = none):")$R " i
            [[ $i =~ ^[0-9]+$ ]] && ((i >= 1 && i <= ${#ids[@]})) || return 1
            FLATHUB_ID=${ids[$((i - 1))]} ;;
        *) return 1 ;;
    esac
}

need_flatpak() {
    command -v flatpak &>/dev/null && return 0
    say "$(T "Apps from Flathub need %sflatpak%s." "${B}" "${R}")"
    ask "$(T "Install it now?")" || exit 1
    (YES=1; repo_install flatpak) || exit 1
}

flathub_install() {
    (($#)) || return 0
    need_flatpak
    flatpak remote-list --columns=name 2>/dev/null | grep -qx flathub ||
        as_root flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || exit 1
    local id sz dl inst rt
    for id in "$@"; do
        say "$(T "%s is installed from Flathub (isolated Flatpak app)" "${B}$id${R}")"
        if sz=$("$LUX_COMMUNITY" flathub-size "$id" 2>/dev/null); then
            dl=$(jq -r '.download + .runtime_download' <<<"$sz")
            inst=$(jq -r '.installed + .runtime_installed' <<<"$sz")
            rt=$(jq -r 'if .runtime_present or .runtime == "" then "" else .runtime end' <<<"$sz")
            printf '    %s %s, %s %s\n' "$(T "Download:")" "$(numfmt --to=iec-i --suffix=B "$dl" 2>/dev/null || echo "$dl")" \
                "$(T "on disk:")" "$(numfmt --to=iec-i --suffix=B "$inst" 2>/dev/null || echo "$inst")"
            [[ -n $rt ]] && printf '    %s%s%s\n' "$D" "$(T "includes the shared runtime %s (used by other Flatpak apps too)" "${rt%%/*}")" "$R"
        fi
        ask "$(T "Install %s?" "${B}$id${R}")" Y || die "$(T "Cancelled")"
        flatpak install -y --noninteractive flathub "$id" || exit 1
    done
}

# Flatpak aplikace k odebrani: ID nebo nazev nainstalovane aplikace -> ID
# (jen cele ID nebo presny nazev bez ohledu na velikost pismen; vic aplikaci se stejnym nazvem = nic)
flatpak_installed_id() {
    command -v flatpak &>/dev/null || return 1
    flatpak list --app --columns=application,name 2>/dev/null | awk -F'\t' -v q="${1,,}" '
        tolower($1) == q { print $1; found = 1; exit }
        tolower($2) == q { ids[++n] = $1 }
        END { if (!found && n == 1) print ids[1] }' | grep .
}

flatpak_cleanup() {  # nepouzivana prostredi (runtime) po odebrani a aktualizaci
    command -v flatpak &>/dev/null || return 0
    flatpak uninstall --unused -y --noninteractive >/dev/null 2>&1 || true
}

# --- Prikazy ----------------------------------------------------------------
cmd_install() {
    (($#)) || die "$(T "Usage: lux install <package...>")"
    local repo=() aur=() luxp=() flat=() p kind
    local -A inrepo=()
    # Ktere cile jsou v repozitarich (nazev, repo/nazev, skupina, provides) - jednim dotazem
    if [[ $ONLY != aur ]] && alpm_ok; then
        local -a q=()
        for p in "$@"; do [[ $p == *.lux || $p == *.pkg.tar* ]] || q+=("$p"); done
        if ((${#q[@]})); then
            while IFS=$'\t' read -r kind p; do [[ $kind == repo ]] && inrepo[$p]=1; done < <(alpm resolve -- "${q[@]}" 2>/dev/null)
        fi
    fi
    for p in "$@"; do
        if [[ $p == *.lux && -f $p ]]; then
            as_root "$LUX_SELF" __lux-file "$(readlink -f "$p")" || exit 1
        elif [[ $p == *.pkg.tar* && -f $p ]]; then repo+=("$(readlink -f "$p")")
        elif [[ $ONLY != aur ]] && if alpm_ok; then [[ -n ${inrepo[$p]-} ]]; else in_repos "$p"; fi; then repo+=("$p")
        elif [[ $ONLY != aur ]] && [[ -n $(lp_index_entry "$p") ]]; then luxp+=("$p")
        elif [[ -z $ONLY ]] && ((FLATPAK)) && flathub_resolve "$p"; then flat+=("$FLATHUB_ID")
        # ID aplikace Flathubu (org.example.App) nikdy nepropadne do komunity, jen s vyslovnym --aur
        elif [[ $ONLY != repo ]] && ((AUR)) && [[ $ONLY == aur || ! $p =~ $APP_ID_RE ]] && aur_exists "$p"; then aur+=("$p")
        else
            warn "$(T "Package '%s' not found. Try: lux search %s" "${B}$p${R}" "$p")"; return 1
        fi
    done
    if ((${#repo[@]})); then
        repo_install "${repo[@]}" || exit 1
    fi
    for p in "${luxp[@]}"; do
        as_root "$LUX_SELF" __lux-install "$p" || exit 1
    done
    flathub_install "${flat[@]}"
    aur_install "${aur[@]}"
}

cmd_remove() {
    (($#)) || die "$(T "Usage: lux remove <package...>")"
    local -a pac=() flat=()
    local p id
    for p in "$@"; do
        if lp_installed "$p"; then as_root "$LUX_SELF" __lux-remove "$p" || exit 1
        elif ! "$LUX_ENGINE" -Q -- "$p" &>/dev/null && id=$(flatpak_installed_id "$p"); then flat+=("$id")
        else pac+=("$p"); fi
    done
    if ((${#flat[@]})); then
        # bez terminalu a bez -y se nic neodebira (vychozi odpoved "ne")
        ask "$(T "Remove %s?" "${B}${flat[*]}${R}")" "$([[ -t 0 ]] && echo Y || echo n)" || die "$(T "Cancelled")"
        # data aplikaci (~/.var/app) zustavaji
        flatpak uninstall -y --noninteractive "${flat[@]}" || exit 1
        flatpak_cleanup
        ok "$(T "Removed: %s" "${flat[*]}")"
    fi
    ((${#pac[@]})) || return 0
    if alpm_ok; then alpm_root remove -- "${pac[@]}"
    else as_root "$LUX_ENGINE" -Rns $(pac_yes) "${pac[@]}"; fi
}

cmd_reinstall() {
    (($#)) || die "$(T "Usage: lux reinstall <package...>")"
    local -a pac=()
    local p
    for p in "$@"; do
        if lp_installed "$p"; then as_root "$LUX_SELF" __lux-install "$p" || exit 1
        else pac+=("$p"); fi
    done
    ((${#pac[@]})) || return 0
    if alpm_ok; then alpm_root reinstall -- "${pac[@]}"
    else pac_run -S $(pac_yes) "${pac[@]}"; fi
}

cmd_autoremove() {
    if alpm_ok; then alpm_root autoremove; return; fi
    local orphans
    orphans=$("$LUX_ENGINE" -Qdtq 2>/dev/null)
    if [[ -n $orphans ]]; then
        say "$(T "Unneeded packages: %s" "${B}$(tr '\n' ' ' <<<"$orphans")${R}")"
        ask "$(T "Remove them?")" Y && as_root "$LUX_ENGINE" -Rns --noconfirm $orphans
    else
        ok "$(T "No unneeded packages")"
    fi
}

cmd_update() {
    if alpm_ok; then
        # obnoveni databazi, nejdrive klice, pak cely system (jedna radka prubehu na fazi)
        alpm_root update || exit
    else
        say "$(T "Refreshing package databases")"
        pac_run -Sy || exit 1
        # Nejdrive klice - nejcastejsi pricina selhani aktualizaci v Archu
        if "$LUX_ENGINE" -Qu archlinux-keyring &>/dev/null; then
            pac_run -S --needed --noconfirm archlinux-keyring || exit 1
        fi
        say "$(T "Updating system packages")"
        pac_run -Su $(pac_yes) || exit 1
    fi

    if ((AUR)) && [[ $ONLY != repo ]] && command -v jq &>/dev/null && ((EUID != 0)); then
        local -a foreign=() outdated=()
        mapfile -t foreign < <("$LUX_ENGINE" -Qm 2>/dev/null)
        if ((${#foreign[@]})); then
            say "$(T "Checking AUR packages")"
            local names info line n v nv
            names=$(printf '%s\n' "${foreign[@]}" | awk '{print $1}')
            info=$(aur_info $names) || { warn "$(T "AUR is not reachable")"; info='[]'; }
            for line in "${foreign[@]}"; do
                n=${line% *}; v=${line#* }
                nv=$(jq -r --arg n "$n" '.[] | select(.Name==$n) | .Version' <<<"$info")
                [[ -n $nv ]] && (( $(vercmp "$nv" "$v") > 0 )) && outdated+=("$n") && printf '  %s %s%s%s → %s%s%s\n' "$n" "$D" "$v" "$R" "$G" "$nv" "$R"
            done
            if ((${#outdated[@]})) && [[ ${LUXAI_AGENT-} == 1 ]]; then
                warn "$(T "Community packages are updated only when you run it yourself: lux update")"
            elif ((${#outdated[@]})); then
                # balicky z komunity uz v systemu jsou (uzivatel je tam svolil); novy skript se znovu kontroluje
                (COMMUNITY_TARGET=system; aur_install "${outdated[@]}") || warn "$(T "Community packages were not updated")"
            else ok "$(T "AUR packages are up to date")"; fi
        fi
    fi

    if [[ $ONLY == "" ]]; then
        local -a lupd=()
        mapfile -t lupd < <(LUX_REFRESH=1 lp_updates)
        if ((${#lupd[@]})); then
            say "$(T "Updating LuxOS apps")"
            local l
            for l in "${lupd[@]}"; do
                printf '  %s %s%s%s → %s%s%s\n' "${l%% *}" "$D" "$(cut -d' ' -f2 <<<"$l")" "$R" "$G" "${l##* }" "$R"
                as_root "$LUX_SELF" __lux-install "${l%% *}" || exit 1
            done
        fi
    fi

    if ((FLATPAK)) && command -v flatpak &>/dev/null && [[ $ONLY == "" ]]; then
        say "$(T "Updating Flatpak apps")"; flatpak update -y --noninteractive
        flatpak_cleanup
    fi

    # Kroky jinych baliku LuxOS po aktualizaci (napr. luxos-care: prechod na jadro LuxOS);
    # bezi mimo transakci, takze smi instalovat. Chyba kroku aktualizaci nezastavi.
    if [[ $ONLY == "" ]]; then
        local hook
        for hook in /usr/lib/lux/after-update.d/*; do
            [[ -x $hook ]] || continue
            as_root "$hook" || warn "$(T "Step after the update failed:") ${hook##*/}"
        done
    fi

    local pacnew
    pacnew=$(find /etc -name '*.pacnew' 2>/dev/null)
    [[ -n $pacnew ]] && warn "$(T "New config files to review:")"$'\n'"$pacnew"
    [[ ! -d /usr/lib/modules/$(uname -r) ]] && warn "$(T "Kernel was updated - restart to use it.")"
    ok "$(T "System is up to date")"
}

cmd_search() {
    (($#)) || die "$(T "Usage: lux search <term>")"
    if [[ $ONLY != aur ]]; then
        printf '%sRepositories%s\n' "$B" "$R"
        if alpm_ok; then
            alpm search -- "$@" || echo "  (nothing)"
        else
            "$LUX_ENGINE" -Ss --color "$([[ $LUX_COLOR == always ]] && echo always || echo never)" -- "$@" || echo "  (nothing)"
        fi
    fi
    if [[ $ONLY != aur ]]; then
        lp_index | jq -r --arg q "${1,,}" '.packages[] | select((.name | ascii_downcase | contains($q)) or ((.summary // "") | ascii_downcase | contains($q))) | "\(.name)\t\(.version)-\(.release // 1)\t\(.summary // "")"' |
            while IFS=$'\t' read -r n v d; do
                printf '%slux/%s%s %s%s%s %s(LuxOS)%s\n    %s\n' "$C" "$n" "$R" "$G" "$v" "$R" "$D" "$R" "$d"
            done
    fi
    if [[ -z $ONLY ]] && ((FLATPAK)); then
        local fl
        if fl=$("$LUX_COMMUNITY" flathub-search "$@" 2>/dev/null) && [[ -n $fl ]]; then
            printf '\n%sFlathub%s\n' "$B" "$R"
            head -n 10 <<<"$fl" | while IFS=$'\t' read -r n t d _icon; do
                printf '%sflathub/%s%s %s%s%s\n    %s\n' "$C" "$n" "$R" "$B" "$t" "$R" "$d"
            done
        fi
    fi
    if [[ $ONLY != repo ]] && ((AUR)) && command -v jq &>/dev/null; then
        printf '\n%sAUR%s %s(%s)%s\n' "$B" "$R" "$D" "$(T "community - installed into the sandbox")" "$R"
        curl -fsSL --max-time 20 "$LUX_AUR_RPC/search/$(jq -rn --arg v "$1" '$v|@uri')?by=name-desc" |
            jq -r '.results | sort_by(-.Popularity) | .[:20][] | "\(.Name)\t\(.Version)\t\(.Description // "")"' |
            while IFS=$'\t' read -r n v d; do
                printf '%saur/%s%s %s%s%s\n    %s\n' "$C" "$n" "$R" "$G" "$v" "$R" "$d"
            done
    fi
}

cmd_info() {
    (($#)) || die "$(T "Usage: lux info <package>")"
    if alpm_ok; then
        alpm info -- "$1" 2>/dev/null && return
    else
        "$LUX_ENGINE" -Qi -- "$1" 2>/dev/null || "$LUX_ENGINE" -Si -- "$1" 2>/dev/null && return
    fi
    local meta
    if lp_installed "$1"; then meta=$(cat "$LUX_DB/$1.json"); else meta=$(lp_index_entry "$1"); fi
    if [[ -n $meta ]]; then
        jq -r '"Name            : \(.name)\nVersion         : \(.version)-\(.release // 1)\nDescription     : \(.summary // "")\nURL             : \(.url // "")\nLicense         : \(.license // "")\nDepends On      : \((.depends.system // []) + (.depends.lux // []) | join(" "))\nFormat          : lux"' <<<"$meta"
        lp_installed "$1" && echo "Installed       : $(jq -r .installed <<<"$meta")"
        return
    fi
    if ((AUR)); then
        aur_info "$1" | jq -r '.[0] // empty | "Name            : \(.Name)\nVersion         : \(.Version)\nDescription     : \(.Description)\nURL             : \(.URL)\nDepends On      : \((.Depends // []) | join(" "))\nMaintainer      : \(.Maintainer)\nVotes           : \(.NumVotes)\nRepository      : aur"' | grep . && return
    fi
    die "$(T "Package '%s' not found" "$1")"
}

cmd_list() {
    if alpm_ok; then
        case ${1-} in
            --lux)                lp_list ;;
            --aur|--foreign)      alpm list --foreign ;;
            --explicit)           alpm list --explicit ;;
            --orphans)            alpm list --orphans ;;
            --upgradable|--updates)
                alpm list --upgradable
                lp_updates | while read -r n o v; do printf '%s %s%s%s → %s%s%s %s(LuxOS)%s\n' "$n" "$D" "$o" "$R" "$G" "$v" "$R" "$C" "$R"; done ;;
            ""|--installed)       alpm list --installed; lp_list ;;
            *)                    alpm list --installed -- "$1" ;;
        esac
        return
    fi
    case ${1-} in
        --lux)      lp_list ;;
        --aur|--foreign) "$LUX_ENGINE" -Qm ;;
        --explicit) "$LUX_ENGINE" -Qe ;;
        --orphans)  "$LUX_ENGINE" -Qdt ;;
        --upgradable|--updates) "$LUX_ENGINE" -Qu; lp_updates ;;
        ""|--installed) "$LUX_ENGINE" -Q; lp_list ;;
        *)          "$LUX_ENGINE" -Q | grep -i -- "$1" ;;
    esac
}

cmd_files() {
    (($#)) || die "$(T "Usage: lux files <package>")"
    if lp_installed "$1"; then
        echo "$LUX_ROOT/$1/"
        jq -r '.installed_files // [] | .[]' "$LUX_DB/$1.json"
    elif alpm_ok; then alpm files -- "$1"
    else "$LUX_ENGINE" -Qlq -- "$1"; fi
}

cmd_owns() {
    (($#)) || die "$(T "Usage: lux owns <file>")"
    local f full rc=0 n
    for f in "$@"; do
        full=$(readlink -m -- "$f")
        # soubory balicku .lux (/opt/lux/<nazev>/..., odkazy v /usr/local)
        n=""
        if [[ $full == "$LUX_ROOT"/* ]]; then n=${full#"$LUX_ROOT"/}; n=${n%%/*}
        elif [[ -d $LUX_DB ]]; then
            n=$(for j in "$LUX_DB"/*.json; do [[ -e $j ]] && jq -e --arg f "$full" '.installed_files // [] | index($f)' "$j" >/dev/null && jq -r .name "$j"; done | head -1)
        fi
        if [[ -n $n ]] && lp_installed "$n"; then
            printf '%s %s %s%s%s %s%s%s %s(LuxOS)%s\n' "$full" "$(T "is owned by")" "$B" "$n" "$R" "$G" "$(lp_installed_version "$n")" "$R" "$C" "$R"
            continue
        fi
        if alpm_ok; then alpm owns -- "$f" || rc=1
        else "$LUX_ENGINE" -Qo -- "$f" || rc=1; fi
    done
    return "$rc"
}

cmd_clean() {
    say "$(T "Cleaning package cache (keeping %s versions)" "$CLEAN_KEEP")"
    if alpm_ok; then
        alpm_root clean --keep "$CLEAN_KEEP" --keep-uninstalled 0
    else
        as_root "$LUX_ENGINE" -Sc --noconfirm >/dev/null
    fi
    cmd_autoremove
    [[ -d $LUX_CACHE/aur ]] && find "$LUX_CACHE/aur" -maxdepth 2 -name '*.pkg.tar.*' -mtime +30 -delete 2>/dev/null
    rm -rf "$LUX_CACHE/aur-build"   # exporty ke kontrole a sestaveni (pri dalsim sestaveni se vytvori znovu)
    ok "$(T "Clean")"
}

# lux fix: zamcena databaze, nedokoncena stahovani, klice pro podpisy (jako root)
PKG_MANAGERS='lux-engine|lux-engine-key|pacman|lux_alpm.py|makepkg|pacstrap|yay|paru|pamac|pamac-daemon|packagekitd'
lux_fix() {
    local dbpath lock procs gpgdir d
    dbpath=$(lux-engine-conf DBPath 2>/dev/null); dbpath=${dbpath:-/var/lib/lux/}
    lock=${dbpath%/}/db.lck
    procs=$(pgrep -x "$PKG_MANAGERS" -l 2>/dev/null | awk '{print $2}' | sort -u | tr '\n' ' ')
    say "$(T "Checking the package database")"
    if [[ -e $lock ]]; then
        if [[ -n $procs ]]; then
            warn "$(T "Another package manager is running (%s) - wait until it finishes." "${procs% }")"
        elif ask "$(T "The package database is locked, but no package manager is running. Remove the stale lock?")" Y; then
            rm -f -- "$lock" && ok "$(T "Removed the stale database lock")"
        fi
    else
        ok "$(T "The package database is not locked")"
    fi
    if [[ -z $procs ]]; then
        while IFS= read -r d; do
            [[ -d $d ]] || continue
            find "$d" -maxdepth 1 -name '*.part' -delete 2>/dev/null
            find "$d" -mindepth 1 -maxdepth 1 -type d -name 'download-*' -exec rm -rf -- {} + 2>/dev/null
        done < <(lux-engine-conf CacheDir 2>/dev/null || echo /var/cache/lux/pkg/)
    fi

    say "$(T "Repairing the package signing keys")"
    gpgdir=$(lux-engine-conf GPGDir 2>/dev/null); gpgdir=${gpgdir:-/etc/lux/keyring/}
    local out
    if [[ ! -s ${gpgdir%/}/pubring.gpg && ! -s ${gpgdir%/}/pubring.kbx ]]; then
        out=$(lux-engine-key --init 2>&1) || { printf '%s\n' "$out" >&2; die "$(T "Could not create the signing keyring")"; }
        ((VERBOSE)) && printf '%s\n' "$out"
    fi
    out=$(lux-engine-key --populate 2>&1) || { printf '%s\n' "$out" >&2; die "$(T "Could not load the signing keys")"; }
    ((VERBOSE)) && printf '%s\n' "$out"
    ok "$(T "Signing keys loaded")"
    if [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == no ]]; then
        warn "$(T "The system clock is not synchronized, signature checks can fail. Turn it on: timedatectl set-ntp true")"
    fi
    local -a keys=() k
    for k in archlinux-keyring luxos-keyring; do "$LUX_ENGINE" -Q "$k" &>/dev/null && keys+=("$k"); done
    if ((${#keys[@]})); then
        if alpm_ok; then alpm_root install --refresh --needed -- "${keys[@]}" || exit
        else pac_run -Sy --needed $(pac_yes) "${keys[@]}" || exit 1; fi
    fi
    ok "$(T "Package manager repaired")"
}

cmd_fix() {
    local -a f=()
    ((YES)) && f+=(-y)
    ((VERBOSE)) && f+=(--verbose)
    as_root "$LUX_SELF" "${f[@]}" __fix
}

# Nove konfiguracni soubory z aktualizaci (.pacnew/.pacsave - jmena dava libalpm): porovnat a sloucit
LUX_CONFIGS_ROOT=${LUX_CONFIGS_ROOT:-/etc}
pending_configs() { find "$LUX_CONFIGS_ROOT" \( -name '*.pacnew' -o -name '*.pacsave' \) -type f 2>/dev/null | sort; }
cmd_configs() {
    if [[ -z $(pending_configs) ]]; then
        ok "$(T "No pending config files")"; return 0
    fi
    local -a f=()
    ((YES)) && f+=(-y)
    as_root "$LUX_SELF" "${f[@]}" __configs
}
lux_configs() {  # jako root: kazdy soubor zvlast - rozdil, nahradit, ponechat, upravit
    local new cur a diffcmd=(diff -u --color=auto)
    [[ $LUX_COLOR == always ]] && diffcmd=(diff -u --color=always)
    while IFS= read -r new; do
        [[ -f $new ]] || continue
        if [[ $new == *.pacnew ]]; then
            cur=${new%.pacnew}
            say "$(T "New version of %s from an update" "${B}$cur${R}")"
            [[ -f $cur ]] && "${diffcmd[@]}" -- "$cur" "$new"
            while :; do
                if ((YES)); then a=s; else
                    read -rp "$(T "[u] use the new version  [k] keep yours  [e] edit yours  [s] skip: ")" a </dev/tty || a=s
                fi
                case ${a,,} in
                    u) cp -a -- "$cur" "$cur.lux-old" 2>/dev/null; mv -f -- "$new" "$cur"
                       ok "$(T "Using the new version (yours is saved as %s)" "$cur.lux-old")"; break ;;
                    k) rm -f -- "$new"; ok "$(T "Kept your version")"; break ;;
                    e) "${EDITOR:-nano}" "$cur" "$new" </dev/tty >/dev/tty ;;
                    s|"") break ;;
                esac
            done
        else
            cur=${new%.pacsave}
            say "$(T "Saved configuration of a removed package: %s" "${B}$new${R}")"
            while :; do
                if ((YES)); then a=s; else
                    read -rp "$(T "[d] delete it  [r] restore it as %s  [s] skip: " "$cur")" a </dev/tty || a=s
                fi
                case ${a,,} in
                    d) rm -f -- "$new"; ok "$(T "Deleted")"; break ;;
                    r) mv -f -- "$new" "$cur"; ok "$(T "Restored")"; break ;;
                    s|"") break ;;
                esac
            done
        fi
    done < <(pending_configs)
}

cmd_drivers() {
    luxos-hwdetect --report
    local -a want=() missing=() svcs=()
    # Hlavicky jader (DKMS) podle nainstalovanych jader (/usr/lib/modules/*/pkgbase)
    mapfile -t want < <(luxos-hwdetect --packages)
    mapfile -t svcs < <(luxos-hwdetect --services)
    local p s
    local -a now=() later=()
    for p in "${want[@]}"; do installed "$p" || missing+=("$p"); done
    if ((${#missing[@]} == 0)); then ok "$(T "All drivers are installed")"; return; fi
    say "$(T "Missing: %s" "${B}${missing[*]}${R}")"
    ask "$(T "Install now?")" Y || return 0
    (YES=1; repo_install "${missing[@]}") || exit 1
    # nvidia-suspend/resume/hibernate bezi jen pri uspani - zapnout, ale nespoustet
    for s in "${svcs[@]}"; do if [[ $s == nvidia-* ]]; then later+=("$s"); else now+=("$s"); fi; done
    ((${#now[@]})) && as_root systemctl enable --now "${now[@]}"
    ((${#later[@]})) && as_root systemctl enable "${later[@]}"
    ok "$(T "Drivers installed - restart to activate them")"
}

cmd_mirrors() {
    say "$(T "Finding the fastest mirrors (this can take a minute)")"
    as_root "$LUX_SELF" __mirrors && ok "$(T "Mirror list updated")"
}
lux_mirrors() {  # jako root: reflector -> /etc/lux/mirrorlist (format lux: jedna adresa na radek)
    local tmp rc
    command -v reflector &>/dev/null || die "$(T "reflector is not installed (lux install reflector)")"
    tmp=$(mktemp) || exit 1
    reflector --latest 20 --protocol https --sort rate --fastest 10 --save "$tmp"
    rc=$?
    ((rc == 0)) && { "$LUX_CONFIG" mirrors-import "$tmp" --output "${LUX_MIRRORLIST:-/etc/lux/mirrorlist}"; rc=$?; }
    rm -f "$tmp"
    return "$rc"
}

# lux config [check|show|edit|engine]: /etc/lux/lux.conf
cmd_config() {
    case ${1:-check} in
        check)  "$LUX_CONFIG" check && "$LUX_CONFIG" ensure --quiet >/dev/null ;;
        show)   cat /etc/lux/lux.conf ;;
        engine) "$LUX_CONFIG" dump ;;
        edit)
            if ((EUID == 0)); then "${EDITOR:-nano}" /etc/lux/lux.conf
            elif command -v sudoedit &>/dev/null; then SUDO_EDITOR=${EDITOR:-nano} sudoedit /etc/lux/lux.conf
            else as_root "${EDITOR:-nano}" /etc/lux/lux.conf; fi
            "$LUX_CONFIG" check ;;
        *) die "$(T "Usage: lux config [check|show|edit|engine]")" ;;
    esac
}

cmd_check() {  # lux check: dostupne aktualizace (cerstve seznamy, bez prav roota, system beze zmeny)
    local out rc n=0 lines=() l name old new
    if alpm_ok; then
        out=$(alpm check-updates 2>&1); rc=$?
        if ((rc == 1)); then
            printf '%s\n' "$out" >&2
            return 1
        fi
        ((rc == 0)) && mapfile -t lines <<<"$out"
    else
        "$LUX_ENGINE" -Sy &>/dev/null || true
        mapfile -t lines < <("$LUX_ENGINE" -Qu 2>/dev/null | awk '{print $1, $2, "->", $4}')
    fi
    for l in "${lines[@]}"; do
        read -r name old _ new <<<"$l"
        [[ -n $name && -n $new ]] || continue
        printf '  %s%s%s %s%s%s → %s%s%s\n' "$B" "$name" "$R" "$D" "$old" "$R" "$G" "$new" "$R"
        ((n++))
    done
    while read -r name old new; do
        [[ -n $name ]] || continue
        printf '  %s%s%s %s%s%s → %s%s%s %s(LuxOS)%s\n' "$B" "$name" "$R" "$D" "$old" "$R" "$G" "$new" "$R" "$C" "$R"
        ((n++))
    done < <(lp_updates 2>/dev/null)
    if ((n)); then
        say "$(T "%s update(s) available - run: lux update" "$n")"
    else
        ok "$(T "System up to date")"
    fi
}

cmd_doctor() {
    local issues=0 n
    say "$(T "LuxOS system check")"
    n=$(systemctl --failed --no-legend 2>/dev/null | wc -l)
    if ((n)); then warn "$(T "%s failed service(s):" "$n")"; systemctl --failed --no-legend; ((issues++)); else ok "$(T "Services running")"; fi
    n=$(find /etc -name '*.pacnew' 2>/dev/null | wc -l)
    ((n)) && { warn "$(T "%s .pacnew config file(s) to merge - run: lux configs" "$n")"; ((issues++)); } || ok "$(T "No pending config files")"
    local use; use=$(df --output=pcent / | tail -1 | tr -dc 0-9)
    ((use > 90)) && { warn "$(T "Root filesystem is %s%% full" "${use}")"; ((issues++)); } || ok "$(T "Disk usage %s%%" "${use}")"
    n=$("$LUX_ENGINE" -Qdtq 2>/dev/null | wc -l)
    ((n)) && warn "$(T "%s unneeded package(s) - run: lux clean" "$n")" || ok "$(T "No orphaned packages")"
    if alpm_ok; then
        n=$(alpm check-updates 2>/dev/null | wc -l)
        ((n)) && warn "$(T "%s update(s) available - run: lux update" "$n")" || ok "$(T "System up to date")"
    fi
    if "$LUX_CONFIG" check &>/dev/null; then ok "$(T "Package manager configuration OK")"
    else warn "$(T "The package manager configuration has an error - run: lux config check")"; ((issues++)); fi
    if [[ -e /var/lib/pacman || -e /etc/pacman.conf ]]; then
        say "$(T "Old package manager files are cleaned up after the next restart")"
    fi
    # lux-engine musi drzet krok s jadrem pacman Arch Linuxu (pyalpm z Archu se sestavuje proti jeho libalpm)
    local own upstream
    own=$("$LUX_ENGINE" -Q lux-engine 2>/dev/null | awk '{print $2}')
    upstream=$(LC_ALL=C "$LUX_ENGINE" -Si core/pacman 2>/dev/null | awk -F': ' '/^Version/ {print $2; exit}')
    if [[ -n $own && -n $upstream ]] && (($(vercmp "$upstream" "$own" 2>/dev/null || echo 0) > 0)); then
        warn "$(T "The package manager core %s is older than the one in Arch Linux (%s); a LuxOS update will follow" "$own" "$upstream")"
    fi
    [[ -d /usr/lib/modules/$(uname -r) ]] || { warn "$(T "Running kernel was replaced - restart")"; ((issues++)); }
    n=$(journalctl -b -p err --no-pager -q 2>/dev/null | wc -l)
    ((n)) && warn "$(T "%s error message(s) in this boot's log (journalctl -b -p err)" "$n")"
    ((issues)) && return 1 || ok "$(T "Everything looks good")"
}

# --- Snimky systemu (LuxOS Care): pred kazdou aktualizaci, navrat i z nabidky zavadece ---------
need_care() { [[ -x $LUX_CARE ]] || die "$(T "System snapshots need LuxOS Care (lux install luxos-care).")"; }
cmd_snapshots() { need_care; as_root "$LUX_CARE" snapshots "$@"; }
cmd_snapshot() { need_care; as_root "$LUX_CARE" snapshot; }
cmd_rollback() {  # lux rollback [jmeno]: bez jmena snimek, ze ktereho system bezi, jinak vyber
    need_care
    local name=${1-} booted json n label
    booted=$(tr ' ' '\n' <"$LUX_CMDLINE" 2>/dev/null | sed -n 's/^luxos\.snapshot=//p' | tail -1)
    json=$(as_root "$LUX_CARE" snapshots --json) || exit 1
    local -a names=() labels=()
    mapfile -t names < <(jq -r 'reverse | .[].name' <<<"$json")
    mapfile -t labels < <(jq -r 'reverse | .[].label' <<<"$json")
    ((${#names[@]})) || die "$(T "No snapshots yet. One is taken before every update.")"
    if [[ -z $name && -n $booted ]]; then
        name=$booted
        say "$(T "LuxOS is running from a snapshot. Rollback keeps this version for good.")"
    elif [[ -z $name ]]; then
        ((YES)) && die "$(T "Usage: lux rollback <snapshot> (see lux snapshots)")"
        for n in "${!names[@]}"; do printf '  %s%2d%s  %s\n' "$B" $((n + 1)) "$R" "${labels[n]}"; done
        read -rp "$B$(T "Return to which state? (number)")$R " n
        [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#names[@]})) || die "$(T "Cancelled.")"
        name=${names[n - 1]}
    fi
    label=""
    for n in "${!names[@]}"; do [[ ${names[n]} == "$name" ]] && label=${labels[n]}; done
    [[ -n $label ]] || die "$(T "No such snapshot: %s" "$name")"
    printf '%s\n' "$(T "Your files in /home are not changed. The current system is kept as a snapshot.")"
    ask "$(T "Return LuxOS to: %s?" "$label")" n || die "$(T "Cancelled.")"
    as_root "$LUX_CARE" rollback "$name" --yes || exit 1
    ok "$(T "Restart the computer to finish.")"
}

cmd_history() {  # lux history [pocet] [balik]
    local n=25 pkg="" a log
    for a in "$@"; do if [[ $a =~ ^[0-9]+$ ]]; then n=$a; else pkg=$a; fi; done
    log=$(lux-engine-conf LogFile 2>/dev/null); log=${log:-/var/log/lux.log}
    grep -E '\[ALPM\] (installed|removed|upgraded|downgraded|reinstalled) ' "$log" |
        awk -v p="$pkg" '(p == "" || $4 == p)' | tail -n "$n" |
        awk -v d="$D" -v r="$R" -v g="$G" -v e="$E" -v y="$Y" -v c="$C" -v b="$B" '{
            t = substr($1, 2, 16); sub(/T/, " ", t)
            col = ($3 == "installed") ? g : ($3 == "removed") ? e : ($3 == "downgraded") ? y : c
            rest = ""; for (i = 5; i <= NF; i++) rest = rest " " $i
            printf "%s%s%s  %s%-11s%s %s%s%s%s%s%s\n", d, t, r, col, $3, r, b, $4, r, d, rest, r
        }'
}

usage() {
    local l
    printf '%s✦ lux%s %s%s%s - %s\n\n' "$C" "$R" "$D" "$LUX_VERSION" "$R" "$(T "LuxOS package manager")"
    printf '%s%s%s lux <%s> [%s] [%s]\n\n' "$B" "$(T "Usage:")" "$R" "$(T "command")" "$(T "options")" "$(T "arguments")"
    while IFS='|' read -r cmd desc; do
        printf '  %-22s%s\n' "$cmd" "$(T "$desc")"
    done <<'CMDS'
(no command)|interactive app store in the terminal
install, i <pkg...>|install packages (repositories, LuxOS, Flathub, then community/AUR)
remove, rm <pkg...>|remove packages (also Flatpak apps) and unneeded dependencies
update, upgrade, up|update everything (system, AUR, Flatpak)
check, check-updates|show available updates without installing them
search, s <term>|search repositories, Flathub and community (AUR)
info <pkg>|show package details
list [--installed]|list installed packages
list --upgradable|list available updates
list --lux, --aur|list LuxOS (.lux) or AUR packages
reinstall <pkg...>|install the same version again
autoremove|remove dependencies nothing needs any more
files <pkg>|files installed by a package
owns <file>|which package owns a file
clean|clean cache and remove unneeded packages
fix|repair a locked database and the signing keys
configs|review and merge new config files (.pacnew)
config check, edit|check or edit /etc/lux/lux.conf
history [n] [pkg]|recent package changes
pack <dir> [out]|build a .lux package from a directory with lux.json
drivers|detect and install missing drivers
mirrors|pick the fastest download mirrors
doctor|check system health
snapshots|list system snapshots (one before every update)
snapshot|take a system snapshot now
rollback [snapshot]|return the system to a snapshot (also from the boot menu)
CMDS
    printf '\n%s%s%s\n' "$B" "$(T "Options:")" "$R"
    while IFS='|' read -r opt desc; do
        printf '  %-22s%s\n' "$opt" "$(T "$desc")"
    done <<'OPTS'
-y, --yes|do not ask for confirmation
-v, --verbose|show all details (and raw errors)
    --repo|only official repositories
    --aur, --community|only the community source (AUR)
    --system|community package into the system instead of the sandbox
-h, --help|this help
-V, --version|version
OPTS
}

# --- Interaktivni rezim (TUI): repozitare LuxOS i Arch Linuxu ---------------
tui_list() {  # tui_list all|luxos|installed -> radky "zobrazeni<TAB>balik"
    tui_sync_list | awk -F'\t' -v filter="$1" -v sys="$(T "system")" '
        FNR == NR { inst[$0] = 1; next }
        {
            repo = $1; name = $2
            if (filter == "luxos" && repo !~ /^luxos/) next
            if (filter == "installed" && !(name in inst)) next
            if (repo == "luxos-apps") { o = 0; badge = "\033[1;38;2;167;123;255m✦ LuxOS \033[0m" }
            else if (repo ~ /^luxos/) { o = 1; badge = sprintf("\033[38;2;167;123;255m✦ %-6.6s\033[0m", sys) }
            else { o = 2; badge = sprintf("\033[2m  %-6.6s\033[0m", repo) }
            mark = (name in inst) ? "\033[32m●\033[0m" : " "
            printf "%d\t%s %s \033[1m%-26.26s\033[0m \033[2m%-14.14s\033[0m %s\t%s\n", o, badge, mark, name, $3, $4, name
        }' <("$LUX_ENGINE" -Qq 2>/dev/null) - | sort -t$'\t' -s -k1,1n | cut -f2-
}
tui_sync_list() {  # repo<TAB>nazev<TAB>verze<TAB>popis
    if alpm_ok; then
        alpm list --sync 2>/dev/null | cut -f1-3,5
    else
        "$LUX_ENGINE" -Sl 2>/dev/null | awk '{printf "%s\t%s\t%s\t\n", $1, $2, $3}'
    fi
}

cmd_tui() {
    command -v fzf &>/dev/null || die "$(T "The interactive mode needs fzf (lux install fzf)")"
    # cerstvy system (napr. live ISO) jeste nema seznamy baliku z repozitaru
    if ! compgen -G "${LUX_SYNC_DIR:-/var/lib/lux/sync}/*.db" >/dev/null; then
        say "$(T "Downloading the list of available software first")"
        if alpm_ok; then alpm_root sync || exit 1; else pac_run -Sy || exit 1; fi
    fi
    local filter=all out key label
    local -a sel
    local header
    header="$(T "Enter install · Ctrl-R remove · Ctrl-U update system · Tab select more")"$'\n'
    header+="$(T "Alt-L LuxOS apps · Alt-I installed · Alt-A all · Esc quit")"
    while :; do
        case $filter in
            luxos) label=" ✦ lux · $(T "LuxOS apps") " ;;
            installed) label=" ✦ lux · $(T "Installed") " ;;
            *) label=" ✦ lux · $(T "All packages") " ;;
        esac
        out=$(tui_list "$filter" | fzf --ansi --multi --layout=reverse --height=100% \
            --border=rounded --border-label="$label" --prompt="$(T "Search") › " \
            --header="$header" --header-first --delimiter=$'\t' --with-nth=1 \
            --preview='lux __preview {2}' --preview-window='right,45%,border-left,wrap' \
            --color='border:#7b6cff,label:#a77bff,prompt:#a77bff,pointer:#a77bff,marker:#5fd7a7,hl:#ffb86c,hl+:#ffb86c' \
            --pointer='▌' --marker='✓' --tiebreak=begin,length --no-hscroll --ellipsis='…' \
            --expect=enter,ctrl-r,ctrl-u,alt-l,alt-i,alt-a) || return 0
        key=$(head -n1 <<<"$out")
        mapfile -t sel < <(tail -n +2 <<<"$out" | cut -f2)
        case $key in
            alt-l) filter=luxos; continue ;;
            alt-i) filter=installed; continue ;;
            alt-a) filter=all; continue ;;
            ctrl-u) cmd_update ;;
            ctrl-r) ((${#sel[@]})) && cmd_remove "${sel[@]}" ;;
            *) ((${#sel[@]})) && cmd_install "${sel[@]}" ;;
        esac
        printf '\n'
        read -rp "$(T "Press Enter to continue")" _
    done
}

cmd_preview() {  # nahled pro TUI (bez ladicich hlasek jadra)
    [[ -n ${1-} ]] || return 0
    # --color=always: nazev pole zacina barevnym kodem, proto (\e[..m)* pred nazvem
    "$LUX_ENGINE" -Si --color=always -- "$1" 2>/dev/null |
        grep -vE $'^(\e\\[[0-9;]*m)*(Architecture|Packager|Build Date|Validated By|MD5|SHA256|Signatures|Conflicts With|Replaces|Optional Deps|Architektura|Sestaveno)' 
    if "$LUX_ENGINE" -Q -- "$1" &>/dev/null; then
        printf '\n\e[32m● %s\e[0m\n' "$(T "Installed")"
    fi
}

args=()
while (($#)); do
    case $1 in
        -y|--yes) YES=1 ;;
        -v|--verbose) VERBOSE=1 ;;
        --repo) ONLY=repo ;;
        --aur|--community) ONLY=aur ;;
        --system) SYSTEM_OK=1 ;;
        --sandbox) COMMUNITY_TARGET=sandbox ;;
        -h|--help) usage; exit 0 ;;
        -V|--version) echo "lux $LUX_VERSION"; exit 0 ;;
        *) args+=("$1") ;;
    esac
    shift
done
set -- "${args[@]}"
cmd=${1-}; shift 2>/dev/null

# Konfigurace (krome napovedy, kontroly konfigurace a vnitrnich prikazu - ty spousti lux, ktery uz
# konfiguraci overil)
case $cmd in
    config|__*|-[SRQUFDT]*) ;;
    *) lux_load_config ;;
esac

case $cmd in
    install|i|add)      cmd_install "$@" ;;
    remove|rm|uninstall) cmd_remove "$@" ;;
    reinstall)          cmd_reinstall "$@" ;;
    update|up|upgrade)  cmd_update ;;
    check|check-updates) cmd_check ;;
    search|s|find)      cmd_search "$@" ;;
    info|show)          cmd_info "$@" ;;
    list|ls)            cmd_list "$@" ;;
    files)              cmd_files "$@" ;;
    owns|owner)         cmd_owns "$@" ;;
    autoremove)         cmd_autoremove ;;
    clean)              cmd_clean ;;
    fix)                cmd_fix ;;
    configs)            cmd_configs "$@" ;;
    config)             cmd_config "$@" ;;
    __configs)          ((EUID == 0)) || exit 1; lux_configs ;;
    __mirrors)          ((EUID == 0)) || exit 1; lux_mirrors ;;
    __fix)              ((EUID == 0)) || exit 1; lux_fix ;;
    drivers)            cmd_drivers ;;
    mirrors)            cmd_mirrors ;;
    doctor)             cmd_doctor ;;
    history)            cmd_history "$@" ;;
    snapshots)          cmd_snapshots "$@" ;;
    snapshot)           cmd_snapshot ;;
    rollback)           cmd_rollback "$@" ;;
    tui|store)          cmd_tui ;;
    pack)               (($#)) || die "$(T "Usage: lux pack <directory> [output]")"; lp_pack "$@" ;;
    __lux-file)         ((EUID == 0)) || exit 1; lp_install_file "$1" ;;
    __index)            lp_index ;;
    __lux-install)      ((EUID == 0)) || exit 1; lp_install_name "$1" ;;
    __lux-remove)       ((EUID == 0)) || exit 1; lp_remove "$1" ;;
    __preview)          cmd_preview "$@" ;;
    "")                 if [[ -t 0 && -t 1 ]]; then cmd_tui; else usage; fi ;;
    # zvyk z pacmanu (lux -Syu, lux -S balik): ukazat odpovidajici prikaz lux
    -[SRQUFDT]*)        [[ -x $LUX_HINT ]] && exec "$LUX_HINT" "$cmd" "$@"
                        die "$(T "Unknown command '%s' (see lux --help)" "$cmd")" ;;
    *)                  die "$(T "Unknown command '%s' (see lux --help)" "$cmd")" ;;
esac
