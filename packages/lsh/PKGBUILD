prepare() {
    cd bash-$_bashver
    local p
    for ((p = 1; p <= 10#$_patchlevel; p++)); do
        patch -p0 -i "../bash${_bashver//.}-$(printf '%03d' $p)"
    done
    cp "$startdir/files/about.def" builtins/
    python3 "$startdir/files/apply-lsh.py" . "$pkgver"
}

build() {
    cd bash-$_bashver
    CFLAGS+=' -DDEFAULT_PATH_VALUE=\"/usr/local/sbin:/usr/local/bin:/usr/bin\" -DSTANDARD_UTILS_PATH=\"/usr/bin\"'
    ./configure --prefix=/usr --with-curses --enable-readline --without-bash-malloc --with-installed-readline
    make
}

check() {
    cd bash-$_bashver
    ./bash --version | grep -q '^lsh (Lux Shell) '"$pkgver"
    ./bash -c 'about shell' | grep -q 'lsh - the Lux shell'
    ./bash -c 'about os' | grep -q 'Kernel'
    ./bash -c 'about system' | grep -q 'Memory'
    ./bash -c 'about hw' | grep -q 'Hardware'
    ! ./bash -c 'about nonsense' 2>/dev/null
    [[ $(./bash -c 'echo $LSH_VERSION') == "$pkgver" ]]
}

package() {
    cd bash-$_bashver
    install -Dm755 bash "$pkgdir/usr/bin/lsh"
    install -Dm644 "$startdir/files/lshrc" "$pkgdir/etc/lsh/lshrc"
    install -Dm644 "$startdir/files/skel-lshrc" "$pkgdir/etc/skel/.lshrc"
}
