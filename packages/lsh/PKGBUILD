# Maintainer: LuxOS Team
# lsh - Lux Shell: fork GNU bash s prikazem about, primym spoustenim LSL a pip bez venv.

pkgname=lsh
pkgver=1.0.0
pkgrel=2
_bashver=5.3
_patchlevel=020
pkgdesc="lsh - the Lux shell (GNU bash fork with LuxOS and LSL integration)"
arch=(x86_64)
options=(!debug)
url="https://github.com/luxos"
license=(GPL-3.0-or-later)
depends=(glibc readline ncurses lsl python-pip)
makedepends=(python bison)
install=lsh.install
backup=(etc/lsh/lshrc)
source=(https://ftp.gnu.org/gnu/bash/bash-$_bashver.tar.gz)
for ((_p = 1; _p <= 10#$_patchlevel; _p++)); do
    source+=(https://ftp.gnu.org/gnu/bash/bash-$_bashver-patches/bash${_bashver//.}-$(printf '%03d' $_p))
done
