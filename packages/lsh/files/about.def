$PRODUCES about.c

$BUILTIN about
$FUNCTION about_builtin
$SHORT_DOC about [shell|os|lsl]
Show information about lsh, LuxOS and LSL.

Without an argument prints an overview of the shell, the system and the
Lux Simple Lang toolchain.  With an argument prints only that section.

Exit Status:
Returns success unless an invalid section is given.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  include <unistd.h>
#endif

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <dirent.h>
#include <sys/types.h>
#include <sys/utsname.h>

#include "../shell.h"
#include "../execute_cmd.h"
#include "../findcmd.h"
#include "../alias.h"
#include "common.h"

extern pid_t dollar_dollar_pid;
extern int interactive_shell;

static int use_color;

#define C(code) (use_color ? "\033[" code "m" : "")
#define RESET C("0")
#define BOLD C("1")
#define DIM C("2")
#define ACCENT C("1;38;5;141")
#define LABEL C("38;5;111")

/* Prvni radek vystupu prikazu (bez noveho radku), NULL pri chybe */
static char *
command_output (const char *cmd)
{
  static char buf[256];
  FILE *p;

  p = popen (cmd, "r");
  if (p == 0)
    return NULL;
  if (fgets (buf, sizeof (buf), p) == 0)
    buf[0] = '\0';
  pclose (p);
  buf[strcspn (buf, "\n")] = '\0';
  return buf[0] ? buf : NULL;
}

/* Hodnota KEY= z os-release (bez uvozovek) */
static char *
os_release (const char *key)
{
  static char buf[256];
  char line[512];
  size_t klen;
  FILE *f;

  f = fopen ("/etc/os-release", "r");
  if (f == 0)
    f = fopen ("/usr/lib/os-release", "r");
  if (f == 0)
    return NULL;
  klen = strlen (key);
  buf[0] = '\0';
  while (fgets (line, sizeof (line), f))
    if (strncmp (line, key, klen) == 0 && line[klen] == '=')
      {
	char *v = line + klen + 1;
	v[strcspn (v, "\n")] = '\0';
	if (*v == '"')
	  {
	    v++;
	    v[strcspn (v, "\"")] = '\0';
	  }
	snprintf (buf, sizeof (buf), "%s", v);
	break;
      }
  fclose (f);
  return buf[0] ? buf : NULL;
}

static long
meminfo_kb (const char *key)
{
  char line[256];
  long v = -1;
  size_t klen = strlen (key);
  FILE *f = fopen ("/proc/meminfo", "r");

  if (f == 0)
    return -1;
  while (fgets (line, sizeof (line), f))
    if (strncmp (line, key, klen) == 0 && line[klen] == ':')
      {
	v = atol (line + klen + 1);
	break;
      }
  fclose (f);
  return v;
}

static void
row (const char *label, const char *value)
{
  if (value && *value)
    printf ("  %s%-9s%s %s\n", LABEL, label, RESET, value);
}

static void
heading (const char *title)
{
  printf ("\n  %s%s%s\n", ACCENT, title, RESET);
}

static void
about_shell (void)
{
  char buf[256];

  heading ("lsh - the Lux shell");
  snprintf (buf, sizeof (buf), "%s (based on GNU bash %s)", LSH_VERSION, shell_version_string ());
  row ("Version", buf);
  row ("Binary", shell_name && *shell_name == '/' ? shell_name : "/usr/bin/lsh");
  row ("Config", "/etc/lsh/lshrc, ~/.lshrc");
  row ("History", "~/.lsh_history");
  printf ("\n  %sWhat lsh adds to bash:%s\n", BOLD, RESET);
  printf ("    %-22s %s\n", "about [shell|os|lsl]", "this overview");
  printf ("    %-22s %s\n", "print 6 * 7", "LSL statements right in the shell");
  printf ("    %-22s %s\n", "load time, x = 5", "kept for the session (lsl-session)");
  printf ("    %-22s %s\n", "./script.lsl", "runs LSL scripts directly");
  printf ("    %-22s %s\n", "pip install NAME", "works outside a venv, with a warning");
  printf ("  %sEverything else behaves exactly like bash 5.3.%s\n", DIM, RESET);
}

static void
about_os (void)
{
  struct utsname u;
  char buf[256], *v;
  FILE *f;
  double up;
  long total, avail;
  DIR *d;
  struct dirent *e;
  int n;

  heading ("System");
  v = os_release ("PRETTY_NAME");
  if (v)
    {
      char base[128];
      snprintf (base, sizeof (base), "%s", v);
      v = os_release ("ID_LIKE");
      snprintf (buf, sizeof (buf), "%s%s%s%s", base, v ? " (" : "", v ? v : "", v ? " based)" : "");
      row ("OS", buf);
    }
  if (uname (&u) == 0)
    {
      snprintf (buf, sizeof (buf), "%s %s", u.sysname, u.release);
      row ("Kernel", buf);
      row ("Host", u.nodename);
    }
  f = fopen ("/proc/uptime", "r");
  if (f && fscanf (f, "%lf", &up) == 1)
    {
      long m = (long)up / 60;
      if (m >= 1440)
	snprintf (buf, sizeof (buf), "%ld d %ld h %ld min", m / 1440, m % 1440 / 60, m % 60);
      else if (m >= 60)
	snprintf (buf, sizeof (buf), "%ld h %ld min", m / 60, m % 60);
      else
	snprintf (buf, sizeof (buf), "%ld min", m);
      row ("Uptime", buf);
    }
  if (f)
    fclose (f);
  total = meminfo_kb ("MemTotal");
  avail = meminfo_kb ("MemAvailable");
  if (total > 0 && avail >= 0)
    {
      snprintf (buf, sizeof (buf), "%.1f / %.1f GiB", (total - avail) / 1048576.0, total / 1048576.0);
      row ("Memory", buf);
    }
  v = command_output ("grep -m1 '^model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^ *//'");
  if (v)
    {
      snprintf (buf, sizeof (buf), "%s (%ld threads)", v, sysconf (_SC_NPROCESSORS_ONLN));
      row ("CPU", buf);
    }
  n = 0;
  d = opendir ("/var/lib/pacman/local");
  if (d)
    {
      while ((e = readdir (d)))
	if (e->d_name[0] != '.' && strcmp (e->d_name, "ALPM_DB_VERSION"))
	  n++;
      closedir (d);
      snprintf (buf, sizeof (buf), "%d (manage with lux)", n);
      row ("Packages", buf);
    }
  v = getenv ("XDG_CURRENT_DESKTOP");
  row ("Desktop", v);
  v = getenv ("TERM");
  row ("Terminal", v);
}

static void
about_lsl (void)
{
  char *path, *v;

  heading ("Lux Simple Lang");
  path = find_user_command ("lsl");
  if (path == 0)
    {
      row ("Status", "not installed (lux install lsl)");
      return;
    }
  v = command_output ("lsl version 2>/dev/null");
  row ("Version", v ? v : "unknown");
  row ("Binary", path);
  row ("Manual", "lsl man, lsl help");
  row ("Session", "lsl-session [show|clear]");
  free (path);
}

int
about_builtin (WORD_LIST *list)
{
  char *what;

  use_color = isatty (1) && getenv ("NO_COLOR") == 0;
  what = list ? list->word->word : NULL;
  if (what && (strcmp (what, "--help") == 0 || strcmp (what, "-h") == 0))
    {
      builtin_help ();
      return (EX_USAGE);
    }
  if (what && strcmp (what, "shell") && strcmp (what, "os") && strcmp (what, "lsl"))
    {
      builtin_error ("%s: unknown section (use shell, os or lsl)", what);
      return (EX_USAGE);
    }

  if (what == 0)
    printf ("\n  %s\342\234\246 LuxOS%s  %s\302\267  lsh %s%s\n", ACCENT, RESET, DIM, LSH_VERSION, RESET);
  if (what == 0 || strcmp (what, "shell") == 0)
    about_shell ();
  if (what == 0 || strcmp (what, "os") == 0)
    about_os ();
  if (what == 0 || strcmp (what, "lsl") == 0)
    about_lsl ();
  putchar ('\n');
  fflush (stdout);
  return (EXECUTION_SUCCESS);
}

/* ---- Integrace LSL --------------------------------------------------- */

/* Soubor relace: nactene moduly a prirazeni z teto instance shellu */
char *
lsh_lsl_session_file (void)
{
  static char path[512];
  const char *dir = getenv ("XDG_RUNTIME_DIR");

  if (dir == 0 || *dir == '\0')
    dir = "/tmp";
  snprintf (path, sizeof (path), "%s/lsh-lsl-%ld.lsl", dir, (long)dollar_dollar_pid);
  return path;
}

/* Pri ukonceni hlavniho shellu (ne subshellu) smazat soubor relace */
void
lsh_lsl_cleanup (void)
{
  if (interactive_shell && getpid () == dollar_dollar_pid)
    unlink (lsh_lsl_session_file ());
}

/* Je NAME prikaz shellu (alias, funkce, builtin nebo program v PATH)? */
static int
is_shell_command (const char *name)
{
  char *path;

#if defined (ALIAS)
  if (find_alias ((char *)name))
    return 1;
#endif
  if (find_function (name) || find_shell_builtin ((char *)name))
    return 1;
  path = find_user_command (name);
  if (path)
    {
      free (path);
      return 1;
    }
  return 0;
}

/* Radek LSL (print ..., load ..., NAZEV = ...) prepise na volani
   lsl-session run '...' jeste pred parserem shellu, takze v nem muzou byt
   zavorky, uvozovky i < >.  Vraci novy radek (xmalloc) nebo NULL. */
char *
lsh_lsl_rewrite (const char *line)
{
  const char *p, *w;
  char word[64], *out, *o, *lsl;
  size_t n;

  if (interactive_shell == 0 || line == 0)
    return NULL;
  for (p = line; *p == ' ' || *p == '\t'; p++)
    ;
  w = p;
  while (*p == '_' || (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (p > w && *p >= '0' && *p <= '9'))
    p++;
  n = p - w;
  if (n == 0 || n >= sizeof (word) || (*p != ' ' && *p != '\t'))
    return NULL;
  memcpy (word, w, n);
  word[n] = '\0';

  if (strcmp (word, "print") && strcmp (word, "load"))
    {
      /* prirazeni "x = vyraz" (bez mezery je to promenna shellu) */
      while (*p == ' ' || *p == '\t')
	p++;
      if (p[0] != '=' || p[1] == '=')
	return NULL;
    }
  if (is_shell_command (word) || find_function ("lsl-session") == 0)
    return NULL;
  lsl = find_user_command ("lsl");
  if (lsl == 0)
    return NULL;
  free (lsl);

  out = o = (char *)xmalloc (strlen (line) * 4 + 32);
  o += sprintf (o, "lsl-session run '");
  for (p = line; *p; p++)
    {
      if (*p == '\'')
	{
	  strcpy (o, "'\\''");
	  o += 4;
	}
      else
	*o++ = *p;
    }
  strcpy (o, "'");
  return out;
}

/* ./skript.lsl: spustit pres lsl i bez shebangu a prava ke spusteni */
void
lsh_exec_lsl_script (char *command, char **args, char **env)
{
  size_t len = strlen (command);
  char **argv;
  int n;

  if (len < 5 || strcmp (command + len - 4, ".lsl") != 0)
    return;
  for (n = 0; args[n]; n++)
    ;
  argv = (char **)xmalloc ((n + 2) * sizeof (char *));
  argv[0] = "lsl";
  argv[1] = command;
  memcpy (argv + 2, args + 1, n * sizeof (char *));	/* vcetne NULL */
  execvpe ("lsl", argv, env);
  /* lsl neni k dispozici: pokracovat jako bash */
  free (argv);
}
