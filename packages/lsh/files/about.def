Foundation, either version 3 of the License, or (at your option) any later
version.

$PRODUCES about.c

$BUILTIN about
$FUNCTION about_builtin
$SHORT_DOC about [shell|os|system|lsl]
Show information about lsh, LuxOS, this computer and LSL.

Without an argument prints an overview of all sections.  With an
argument prints only that section.

Sections:
  shell     lsh version, configuration files and what lsh adds to bash
  os        LuxOS version and build, kernel, host, uptime, packages,
            boot mode and desktop session (alias: luxos)
  system    hardware: model, CPU, GPU, memory, storage, drives,
            battery and displays (aliases: hardware, hw)
  lsl       Lux Simple Lang version and tools

Exit Status:
Returns success unless an invalid section is given.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  include <unistd.h>
#endif

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <dirent.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <sys/statvfs.h>
#include <sys/utsname.h>

#include "../shell.h"
#include "../execute_cmd.h"
#include "../findcmd.h"
#include "../alias.h"
#include "common.h"

extern pid_t dollar_dollar_pid;
extern int interactive_shell;

static int use_color;

#define C(code) (use_color ? "\033[" code "m" : "")
#define RESET C("0")
#define BOLD C("1")
#define DIM C("2")
#define ACCENT C("1;38;5;141")
#define LABEL C("38;5;111")

/* Prvni radek vystupu prikazu (bez noveho radku), NULL pri chybe */
static char *
command_output (const char *cmd)
{
  static char buf[256];
  FILE *p;

  p = popen (cmd, "r");
  if (p == 0)
    return NULL;
  if (fgets (buf, sizeof (buf), p) == 0)
    buf[0] = '\0';
  pclose (p);
  buf[strcspn (buf, "\n")] = '\0';
  return buf[0] ? buf : NULL;
}

/* Hodnota KEY= z os-release (bez uvozovek) */
static char *
os_release (const char *key)
{
  static char buf[256];
  char line[512];
  size_t klen;
  FILE *f;

  f = fopen ("/etc/os-release", "r");
  if (f == 0)
    f = fopen ("/usr/lib/os-release", "r");
  if (f == 0)
    return NULL;
  klen = strlen (key);
  buf[0] = '\0';
  while (fgets (line, sizeof (line), f))
    if (strncmp (line, key, klen) == 0 && line[klen] == '=')
      {
	char *v = line + klen + 1;
	v[strcspn (v, "\n")] = '\0';
	if (*v == '"')
	  {
	    v++;
	    v[strcspn (v, "\"")] = '\0';
	  }
	snprintf (buf, sizeof (buf), "%s", v);
	break;
      }
  fclose (f);
  return buf[0] ? buf : NULL;
}

static long
meminfo_kb (const char *key)
{
  char line[256];
  long v = -1;
  size_t klen = strlen (key);
  FILE *f = fopen ("/proc/meminfo", "r");

  if (f == 0)
    return -1;
  while (fgets (line, sizeof (line), f))
    if (strncmp (line, key, klen) == 0 && line[klen] == ':')
      {
	v = atol (line + klen + 1);
	break;
      }
  fclose (f);
  return v;
}

static void
row (const char *label, const char *value)
{
  if (value && *value)
    printf ("  %s%-9s%s %s\n", LABEL, label, RESET, value);
}

static void
heading (const char *title)
{
  printf ("\n  %s%s%s\n", ACCENT, title, RESET);
}

static void
about_shell (void)
{
  char buf[256];

  heading ("lsh - the Lux shell");
  snprintf (buf, sizeof (buf), "%s (based on GNU bash %s)", LSH_VERSION, shell_version_string ());
  row ("Version", buf);
  row ("Binary", shell_name && *shell_name == '/' ? shell_name : "/usr/bin/lsh");
  row ("Config", "/etc/lsh/lshrc, ~/.lshrc");
  row ("History", "~/.lsh_history");
  printf ("\n  %sWhat lsh adds to bash:%s\n", BOLD, RESET);
  printf ("    %-22s %s\n", "about [section]", "this overview (shell, os, system, lsl)");
  printf ("    %-22s %s\n", "print 6 * 7", "LSL statements right in the shell");
  printf ("    %-22s %s\n", "load time, x = 5", "kept for the session (lsl-session)");
  printf ("    %-22s %s\n", "./script.lsl", "runs LSL scripts directly");
  printf ("    %-22s %s\n", "pip install NAME", "works outside a venv, with a warning");
  printf ("  %sEverything else behaves exactly like bash 5.3.%s\n", DIM, RESET);
}

/* Prvni radek souboru bez noveho radku a koncovych mezer; NULL pri chybe
   nebo prazdnem souboru */
static char *
file_line (const char *path, char *buf, size_t size)
{
  FILE *f;
  size_t n;

  f = fopen (path, "r");
  if (f == 0)
    return NULL;
  if (fgets (buf, size, f) == 0)
    buf[0] = '\0';
  fclose (f);
  n = strcspn (buf, "\n");
  while (n > 0 && (buf[n - 1] == ' ' || buf[n - 1] == '\t'))
    n--;
  buf[n] = '\0';
  return buf[0] ? buf : NULL;
}

/* Hodnota souboru DIR/NAME (sysfs) */
static char *
sys_value (const char *dir, const char *name, char *buf, size_t size)
{
  char path[512];

  snprintf (path, sizeof (path), "%s/%s", dir, name);
  return file_line (path, buf, size);
}

/* Prave 4 hexadecimalni cislice na zacatku S (pci.ids) */
static int
hex4 (const char *s, unsigned *id)
{
  int i;

  for (i = 0; i < 4; i++)
    if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f') || (s[i] >= 'A' && s[i] <= 'F')))
      return 0;
  return sscanf (s, "%4x", id) == 1;
}

/* Kapacita citelne, dekadicky jako u vyrobcu disku */
static void
format_size (double bytes, char *buf, size_t size)
{
  if (bytes >= 1e12)
    snprintf (buf, size, "%.1f TB", bytes / 1e12);
  else if (bytes >= 1e9)
    snprintf (buf, size, "%.0f GB", bytes / 1e9);
  else
    snprintf (buf, size, "%.0f MB", bytes / 1e6);
}

/* Model procesoru z /proc/cpuinfo (bez spousteni programu) */
static char *
cpu_model (char *buf, size_t size)
{
  char line[512], *v, *o;
  FILE *f;

  buf[0] = '\0';
  f = fopen ("/proc/cpuinfo", "r");
  if (f == 0)
    return NULL;
  while (fgets (line, sizeof (line), f))
    if (strncmp (line, "model name", 10) == 0 && (v = strchr (line, ':')))
      {
	for (v++; *v == ' ' || *v == '\t'; v++)
	  ;
	v[strcspn (v, "\n")] = '\0';
	/* vicenasobne mezery slouci do jedne */
	for (o = buf; *v && o < buf + size - 1; v++)
	  if (*v != ' ' || (o > buf && o[-1] != ' '))
	    *o++ = *v;
	while (o > buf && o[-1] == ' ')
	  o--;
	*o = '\0';
	break;
      }
  fclose (f);
  return buf[0] ? buf : NULL;
}

/* Nazev vyrobce a zarizeni z databaze pci.ids (balik hwdata);
   vraci 1, kdyz zarizeni nasel */
static int
pci_lookup (unsigned vendor, unsigned device, char *vname, size_t vsize, char *dname, size_t dsize)
{
  static const char *paths[] = { "/usr/share/hwdata/pci.ids", "/usr/share/misc/pci.ids", 0 };
  char line[512];
  unsigned id;
  int i, in_vendor = 0;
  FILE *f = 0;

  vname[0] = dname[0] = '\0';
  for (i = 0; paths[i] && f == 0; i++)
    f = fopen (paths[i], "r");
  if (f == 0)
    return 0;
  while (fgets (line, sizeof (line), f))
    {
      line[strcspn (line, "\n")] = '\0';
      if (line[0] == '#' || line[0] == '\0')
	continue;
      if (line[0] != '\t')
	{
	  if (in_vendor)
	    break;		/* konec bloku vyrobce, zarizeni nenalezeno */
	  if (hex4 (line, &id) && id == vendor && line[4] == ' ' && strlen (line) > 6)
	    {
	      in_vendor = 1;
	      snprintf (vname, vsize, "%s", line + 6);
	    }
	}
      else if (in_vendor && line[1] != '\t' && hex4 (line + 1, &id) && id == device
	       && line[5] == ' ' && strlen (line) > 7)
	{
	  snprintf (dname, dsize, "%s", line + 7);
	  break;
	}
    }
  fclose (f);
  return dname[0] != '\0';
}

/* Kratky nazev vyrobce grafiky */
static const char *
gpu_vendor (unsigned vendor, const char *pciname)
{
  switch (vendor)
    {
    case 0x10de: return "NVIDIA";
    case 0x1002: return "AMD";
    case 0x8086: return "Intel";
    case 0x1af4: return "Virtio";
    case 0x1b36:
    case 0x1234: return "QEMU";
    case 0x15ad: return "VMware";
    case 0x80ee: return "VirtualBox";
    case 0x1414: return "Microsoft";
    }
  return *pciname ? pciname : "GPU";
}

/* Graficke karty z /sys/class/drm/cardN: vyrobce, model a ovladac */
static void
gpu_rows (void)
{
  char dir[128], buf[64], lpath[160], link[512], vname[256], dname[256], out[512];
  const char *vendor_s, *model, *drv;
  unsigned vendor, device;
  ssize_t n;
  int i;

  for (i = 0; i < 16; i++)
    {
      snprintf (dir, sizeof (dir), "/sys/class/drm/card%d/device", i);
      if (sys_value (dir, "vendor", buf, sizeof (buf)) == 0 || sscanf (buf, "%x", &vendor) != 1)
	continue;		/* napr. simpledrm nema PCI zarizeni */
      if (sys_value (dir, "device", buf, sizeof (buf)) == 0 || sscanf (buf, "%x", &device) != 1)
	continue;
      pci_lookup (vendor, device, vname, sizeof (vname), dname, sizeof (dname));
      vendor_s = gpu_vendor (vendor, vname);
      model = dname;
      /* "TU117M [GeForce GTX 1650]" -> obchodni nazev v hranatych zavorkach */
      if (strchr (dname, '[') && strchr (dname, ']') > strchr (dname, '['))
	{
	  model = strchr (dname, '[') + 1;
	  *strrchr (dname, ']') = '\0';
	}
      /* "Virtio 1.0 GPU" od vyrobce Virtio -> bez zdvojeneho nazvu */
      if (strncmp (model, vendor_s, strlen (vendor_s)) == 0 && model[strlen (vendor_s)] == ' ')
	model += strlen (vendor_s) + 1;

      snprintf (lpath, sizeof (lpath), "%s/driver", dir);
      n = readlink (lpath, link, sizeof (link) - 1);
      drv = 0;
      if (n > 0)
	{
	  link[n] = '\0';
	  drv = strrchr (link, '/') ? strrchr (link, '/') + 1 : link;
	}
      if (*model)
	snprintf (out, sizeof (out), "%s %s", vendor_s, model);
      else
	snprintf (out, sizeof (out), "%s [%04x:%04x]", vendor_s, vendor, device);
      if (drv)
	snprintf (out + strlen (out), sizeof (out) - strlen (out), " (%s)", drv);
      row ("GPU", out);
    }
}

/* Nesmyslne hodnoty DMI od vyrobcu desek */
static int
dmi_junk (const char *s)
{
  static const char *junk[] = { "To Be Filled By O.E.M.", "To be filled by O.E.M.", "System Product Name",
    "System manufacturer", "System Version", "Default string", "Not Applicable", "Not Specified",
    "O.E.M.", "OEM", "None", "Type1ProductConfigId", 0 };
  int i;

  if (s == 0 || *s == '\0')
    return 1;
  for (i = 0; junk[i]; i++)
    if (strcmp (s, junk[i]) == 0)
      return 1;
  return 0;
}

static void
model_row (void)
{
  const char *dmi = "/sys/class/dmi/id";
  char vendor[128], product[128], version[128], buf[400];
  char *v, *p, *ver;

  v = sys_value (dmi, "sys_vendor", vendor, sizeof (vendor));
  p = sys_value (dmi, "product_name", product, sizeof (product));
  ver = sys_value (dmi, "product_version", version, sizeof (version));
  if (dmi_junk (v))
    v = 0;
  if (dmi_junk (p))
    p = 0;
  /* Lenovo ma v product_name kod typu, obchodni nazev je v product_version */
  if (v && strcmp (v, "LENOVO") == 0 && !dmi_junk (ver))
    p = ver;
  if (v == 0 && p == 0)
    {
      v = sys_value (dmi, "board_vendor", vendor, sizeof (vendor));
      p = sys_value (dmi, "board_name", product, sizeof (product));
      if (dmi_junk (v))
	v = 0;
      if (dmi_junk (p))
	p = 0;
    }
  if (v && p && strncmp (p, v, strlen (v)) != 0)
    snprintf (buf, sizeof (buf), "%s %s", v, p);
  else
    snprintf (buf, sizeof (buf), "%s", p ? p : (v ? v : ""));
  row ("Model", buf);
}

static void
cpu_row (void)
{
  char model[256], buf[400], freq[32];
  long khz = 0;

  if (cpu_model (model, sizeof (model)) == 0)
    return;
  if (file_line ("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq", freq, sizeof (freq)))
    khz = atol (freq);
  if (khz > 0)
    snprintf (buf, sizeof (buf), "%s, %ld threads, up to %.2f GHz", model, sysconf (_SC_NPROCESSORS_ONLN), khz / 1e6);
  else
    snprintf (buf, sizeof (buf), "%s (%ld threads)", model, sysconf (_SC_NPROCESSORS_ONLN));
  row ("CPU", buf);
}

static void
memory_rows (void)
{
  char buf[128];
  long total, avail, swap, swfree;

  total = meminfo_kb ("MemTotal");
  avail = meminfo_kb ("MemAvailable");
  if (total > 0 && avail >= 0)
    {
      snprintf (buf, sizeof (buf), "%.1f / %.1f GiB used (%ld %%)", (total - avail) / 1048576.0,
		total / 1048576.0, (total - avail) * 100 / total);
      row ("Memory", buf);
    }
  swap = meminfo_kb ("SwapTotal");
  swfree = meminfo_kb ("SwapFree");
  if (swap > 0 && swfree >= 0)
    {
      snprintf (buf, sizeof (buf), "%.1f / %.1f GiB used", (swap - swfree) / 1048576.0, swap / 1048576.0);
      row ("Swap", buf);
    }
}

/* Typ souboroveho systemu pripojeneho v MNT (posledni zaznam vyhrava) */
static char *
mount_type (const char *mnt, char *buf, size_t size)
{
  char line[1024], dev[512], dir[512], type[64];
  FILE *f = fopen ("/proc/self/mounts", "r");

  buf[0] = '\0';
  if (f == 0)
    return NULL;
  while (fgets (line, sizeof (line), f))
    if (sscanf (line, "%511s %511s %63s", dev, dir, type) == 3 && strcmp (dir, mnt) == 0)
      snprintf (buf, size, "%s", type);
  fclose (f);
  return buf[0] ? buf : NULL;
}

static void
storage_row (const char *mnt)
{
  struct statvfs s;
  char buf[256], type[64];
  double total, used;
  int tb;

  if (statvfs (mnt, &s) != 0 || s.f_blocks == 0)
    return;
  total = (double)s.f_blocks * s.f_frsize;
  used = (double)(s.f_blocks - s.f_bfree) * s.f_frsize;
  tb = total >= 1e12;
  snprintf (buf, sizeof (buf), tb ? "%s  %.2f / %.2f TB used" : "%s  %.0f / %.0f GB used",
	    mnt, used / (tb ? 1e12 : 1e9), total / (tb ? 1e12 : 1e9));
  if (mount_type (mnt, type, sizeof (type)))
    snprintf (buf + strlen (buf), sizeof (buf) - strlen (buf), " (%s)", type);
  row ("Storage", buf);
}

static int
cmp_names (const void *a, const void *b)
{
  return strcmp (*(char * const *)a, *(char * const *)b);
}

/* Fyzicke disky z /sys/block (bez loop, zram, device-mapper, mechanik) */
static void
drive_rows (void)
{
  static const char *skip[] = { "loop", "ram", "zram", "dm-", "sr", "md", "fd", "nbd", "zd", 0 };
  char *names[32], dir[300], buf[256], model[128], size[32], out[400], real[4096];
  const char *kind;
  DIR *d;
  struct dirent *e;
  int n = 0, i, k;
  double bytes;

  d = opendir ("/sys/block");
  if (d == 0)
    return;
  while ((e = readdir (d)) && n < 32)
    {
      if (e->d_name[0] == '.')
	continue;
      for (k = 0; skip[k] && strncmp (e->d_name, skip[k], strlen (skip[k])); k++)
	;
      if (skip[k] == 0)
	names[n++] = savestring (e->d_name);
    }
  closedir (d);
  qsort (names, n, sizeof (char *), cmp_names);

  for (i = 0; i < n; i++)
    {
      snprintf (dir, sizeof (dir), "/sys/block/%s", names[i]);
      bytes = sys_value (dir, "size", buf, sizeof (buf)) ? atof (buf) * 512 : 0;
      if (bytes > 0)
	{
	  if (sys_value (dir, "device/model", model, sizeof (model)) == 0
	      && sys_value (dir, "device/name", model, sizeof (model)) == 0)
	    model[0] = '\0';
	  format_size (bytes, size, sizeof (size));
	  if (realpath (dir, real) && strstr (real, "/usb"))
	    kind = "USB";
	  else if (strncmp (names[i], "nvme", 4) == 0)
	    kind = "NVMe SSD";
	  else if (strncmp (names[i], "mmcblk", 6) == 0)
	    kind = "SD/eMMC";
	  else if (sys_value (dir, "queue/rotational", buf, sizeof (buf)) && strcmp (buf, "0") == 0)
	    kind = "SSD";
	  else
	    kind = "HDD";
	  snprintf (out, sizeof (out), "%s%s%s (%s, %s)", names[i], model[0] ? "  " : "", model, size, kind);
	  row ("Drive", out);
	}
      free (names[i]);
    }
}

/* Baterie notebooku (ne baterie mysi a klavesnic se scope=Device) */
static void
battery_rows (void)
{
  char dir[300], buf[64], cap[16], status[32], full[32], design[32], out[128];
  DIR *d;
  struct dirent *e;
  double f, ds;

  d = opendir ("/sys/class/power_supply");
  if (d == 0)
    return;
  while ((e = readdir (d)))
    {
      if (e->d_name[0] == '.')
	continue;
      snprintf (dir, sizeof (dir), "/sys/class/power_supply/%s", e->d_name);
      if (sys_value (dir, "type", buf, sizeof (buf)) == 0 || strcmp (buf, "Battery"))
	continue;
      if (sys_value (dir, "scope", buf, sizeof (buf)) && strcmp (buf, "Device") == 0)
	continue;
      if (sys_value (dir, "capacity", cap, sizeof (cap)) == 0)
	continue;
      snprintf (out, sizeof (out), "%s %%", cap);
      if (sys_value (dir, "status", status, sizeof (status)))
	snprintf (out + strlen (out), sizeof (out) - strlen (out), ", %s", status);
      if ((sys_value (dir, "energy_full", full, sizeof (full)) && sys_value (dir, "energy_full_design", design, sizeof (design)))
	  || (sys_value (dir, "charge_full", full, sizeof (full)) && sys_value (dir, "charge_full_design", design, sizeof (design))))
	{
	  f = atof (full);
	  ds = atof (design);
	  if (f > 0 && ds > 0)
	    snprintf (out + strlen (out), sizeof (out) - strlen (out), ", health %.0f %%", f * 100 / ds);
	}
      row ("Battery", out);
    }
  closedir (d);
}

/* Pripojene obrazovky a jejich nativni rozliseni z /sys/class/drm */
static void
display_rows (void)
{
  char dir[300], buf[32], mode[64], out[128];
  DIR *d;
  struct dirent *e;

  d = opendir ("/sys/class/drm");
  if (d == 0)
    return;
  while ((e = readdir (d)))
    {
      if (strncmp (e->d_name, "card", 4) || strchr (e->d_name, '-') == 0)
	continue;
      snprintf (dir, sizeof (dir), "/sys/class/drm/%s", e->d_name);
      if (sys_value (dir, "status", buf, sizeof (buf)) == 0 || strcmp (buf, "connected"))
	continue;
      if (sys_value (dir, "modes", mode, sizeof (mode)))
	snprintf (out, sizeof (out), "%s  %s", strchr (e->d_name, '-') + 1, mode);
      else
	snprintf (out, sizeof (out), "%s", strchr (e->d_name, '-') + 1);
      row ("Display", out);
    }
  closedir (d);
}

static void
about_os (void)
{
  struct utsname u;
  char buf[256], name[128], version[128], *v, *s;
  FILE *f;
  double up;
  DIR *d;
  struct dirent *e;
  int n;

  heading ("Operating system");
  /* OS: "LuxOS (arch based)", Version: "0.9.2 (Polaris)"; bez VERSION (Arch) PRETTY_NAME */
  v = os_release ("VERSION");
  snprintf (version, sizeof (version), "%s", v ? v : "");
  v = os_release (version[0] ? "NAME" : "PRETTY_NAME");
  snprintf (name, sizeof (name), "%s", v ? v : "");
  if (name[0])
    {
      v = os_release ("ID_LIKE");
      snprintf (buf, sizeof (buf), "%s%s%s%s", name, v ? " (" : "", v ? v : "", v ? " based)" : "");
      row ("OS", buf);
    }
  row ("Version", version);
  v = os_release ("BUILD_ID");
  row ("Build", v);
  if (uname (&u) == 0)
    {
      snprintf (buf, sizeof (buf), "%s %s (%s)", u.sysname, u.release, u.machine);
      row ("Kernel", buf);
      row ("Host", u.nodename);
    }
  f = fopen ("/proc/uptime", "r");
  if (f && fscanf (f, "%lf", &up) == 1)
    {
      long m = (long)up / 60;
      if (m >= 1440)
	snprintf (buf, sizeof (buf), "%ld d %ld h %ld min", m / 1440, m % 1440 / 60, m % 60);
      else if (m >= 60)
	snprintf (buf, sizeof (buf), "%ld h %ld min", m / 60, m % 60);
      else
	snprintf (buf, sizeof (buf), "%ld min", m);
      row ("Uptime", buf);
    }
  if (f)
    fclose (f);
  n = 0;
  d = opendir ("/var/lib/pacman/local");
  if (d)
    {
      while ((e = readdir (d)))
	if (e->d_name[0] != '.' && strcmp (e->d_name, "ALPM_DB_VERSION"))
	  n++;
      closedir (d);
      snprintf (buf, sizeof (buf), "%d (manage with lux)", n);
      row ("Packages", buf);
    }
  row ("Boot", access ("/sys/firmware/efi", F_OK) == 0 ? "UEFI" : "BIOS (legacy)");
  v = getenv ("XDG_CURRENT_DESKTOP");
  s = getenv ("XDG_SESSION_TYPE");
  if (v && *v)
    {
      snprintf (buf, sizeof (buf), "%s%s%s%s", v, s && *s ? " (" : "", s && *s ? s : "", s && *s ? ")" : "");
      row ("Desktop", buf);
    }
  v = getenv ("TERM");
  row ("Terminal", v);
}

static void
about_system (void)
{
  heading ("Hardware");
  model_row ();
  cpu_row ();
  gpu_rows ();
  memory_rows ();
  storage_row ("/");
  {
    struct stat r, h;
    /* /home jen kdyz je na jinem oddilu nez / */
    if (stat ("/", &r) == 0 && stat ("/home", &h) == 0 && r.st_dev != h.st_dev)
      storage_row ("/home");
  }
  drive_rows ();
  battery_rows ();
  display_rows ();
}

static void
about_lsl (void)
{
  char *path, *v;

  heading ("Lux Simple Lang");
  path = find_user_command ("lsl");
  if (path == 0)
    {
      row ("Status", "not installed (lux install lsl)");
      return;
    }
  v = command_output ("lsl version 2>/dev/null");
  row ("Version", v ? v : "unknown");
  row ("Binary", path);
  row ("Manual", "lsl man, lsl help");
  row ("Session", "lsl-session [show|clear]");
  free (path);
}

int
about_builtin (WORD_LIST *list)
{
  char *what;

  use_color = isatty (1) && getenv ("NO_COLOR") == 0;
  what = list ? list->word->word : NULL;
  if (what && (strcmp (what, "--help") == 0 || strcmp (what, "-h") == 0))
    {
      builtin_help ();
      return (EX_USAGE);
    }
  /* aliasy sekci */
  if (what && strcmp (what, "luxos") == 0)
    what = "os";
  else if (what && (strcmp (what, "hardware") == 0 || strcmp (what, "hw") == 0))
    what = "system";
  if (what && strcmp (what, "shell") && strcmp (what, "os") && strcmp (what, "system") && strcmp (what, "lsl"))
    {
      builtin_error ("%s: unknown section (use shell, os, system or lsl)", what);
      return (EX_USAGE);
    }

  if (what == 0)
    printf ("\n  %s\342\234\246 LuxOS%s  %s\302\267  lsh %s%s\n", ACCENT, RESET, DIM, LSH_VERSION, RESET);
  if (what == 0 || strcmp (what, "shell") == 0)
    about_shell ();
  if (what == 0 || strcmp (what, "os") == 0)
    about_os ();
  if (what == 0 || strcmp (what, "system") == 0)
    about_system ();
  if (what == 0 || strcmp (what, "lsl") == 0)
    about_lsl ();
  putchar ('\n');
  fflush (stdout);
  return (EXECUTION_SUCCESS);
}

/* ---- Integrace LSL --------------------------------------------------- */

/* Soubor relace: nactene moduly a prirazeni z teto instance shellu */
char *
lsh_lsl_session_file (void)
{
  static char path[512];
  const char *dir = getenv ("XDG_RUNTIME_DIR");

  if (dir == 0 || *dir == '\0')
    dir = "/tmp";
  snprintf (path, sizeof (path), "%s/lsh-lsl-%ld.lsl", dir, (long)dollar_dollar_pid);
  return path;
}

/* Pri ukonceni hlavniho shellu (ne subshellu) smazat soubor relace */
void
lsh_lsl_cleanup (void)
{
  if (interactive_shell && getpid () == dollar_dollar_pid)
    unlink (lsh_lsl_session_file ());
}

/* Je NAME prikaz shellu (alias, funkce, builtin nebo program v PATH)? */
static int
is_shell_command (const char *name)
{
  char *path;

#if defined (ALIAS)
  if (find_alias ((char *)name))
    return 1;
#endif
  if (find_function (name) || find_shell_builtin ((char *)name))
    return 1;
  path = find_user_command (name);
  if (path)
    {
      free (path);
      return 1;
    }
  return 0;
}

/* Radek LSL (print ..., load ..., NAZEV = ...) prepise na volani
   lsl-session run '...' jeste pred parserem shellu, takze v nem muzou byt
   zavorky, uvozovky i < >.  Vraci novy radek (xmalloc) nebo NULL. */
char *
lsh_lsl_rewrite (const char *line)
{
  const char *p, *w;
  char word[64], *out, *o, *lsl;
  size_t n;

  if (interactive_shell == 0 || line == 0)
    return NULL;
  for (p = line; *p == ' ' || *p == '\t'; p++)
    ;
  w = p;
  while (*p == '_' || (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (p > w && *p >= '0' && *p <= '9'))
    p++;
  n = p - w;
  if (n == 0 || n >= sizeof (word) || (*p != ' ' && *p != '\t'))
    return NULL;
  memcpy (word, w, n);
  word[n] = '\0';

  if (strcmp (word, "print") && strcmp (word, "load"))
    {
      /* prirazeni "x = vyraz" (bez mezery je to promenna shellu) */
      while (*p == ' ' || *p == '\t')
	p++;
      if (p[0] != '=' || p[1] == '=')
	return NULL;
    }
  if (is_shell_command (word) || find_function ("lsl-session") == 0)
    return NULL;
  lsl = find_user_command ("lsl");
  if (lsl == 0)
    return NULL;
  free (lsl);

  out = o = (char *)xmalloc (strlen (line) * 4 + 32);
  o += sprintf (o, "lsl-session run '");
  for (p = line; *p; p++)
    {
      if (*p == '\'')
	{
	  strcpy (o, "'\\''");
	  o += 4;
	}
      else
	*o++ = *p;
    }
  strcpy (o, "'");
  return out;
}

/* ./skript.lsl: spustit pres lsl i bez shebangu a prava ke spusteni */
void
lsh_exec_lsl_script (char *command, char **args, char **env)
{
  size_t len = strlen (command);
  char **argv;
  int n;

  if (len < 5 || strcmp (command + len - 4, ".lsl") != 0)
    return;
  for (n = 0; args[n]; n++)
    ;
  argv = (char **)xmalloc ((n + 2) * sizeof (char *));
  argv[0] = "lsl";
  argv[1] = command;
  memcpy (argv + 2, args + 1, n * sizeof (char *));	/* vcetne NULL */
  execvpe ("lsl", argv, env);
  /* lsl neni k dispozici: pokracovat jako bash */
  free (argv);
}
