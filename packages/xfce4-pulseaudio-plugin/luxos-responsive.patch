+typedef struct
+{
+  PulseaudioNotify *notify;
+  GCancellable     *cancellable;
+  gboolean          mic;
+} NotifyCall;
+
+
+
+static void pulseaudio_notify_notify (PulseaudioNotify *notify, gboolean mic);
+
+
+
+static void
+pulseaudio_notify_sent (GObject      *source,
+                        GAsyncResult *result,
+                        gpointer      user_data)
+{
+  NotifyCall       *call = user_data;
+  PulseaudioNotify *notify;
+  GError           *error = NULL;
+  GVariant         *ret;
+  gint              i = call->mic ? 1 : 0;
+
+  ret = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+
+  if (g_cancellable_is_cancelled (call->cancellable))
+    {
+      /* plugin uz skoncil - notify neexistuje */
+      if (ret != NULL)
+        g_variant_unref (ret);
+      g_clear_error (&error);
+      g_object_unref (call->cancellable);
+      g_free (call);
+      return;
+    }
+
+  notify = call->notify;
+  notify->pending[i] = FALSE;
+
+  if (ret != NULL)
+    {
+      g_variant_get (ret, "(u)", &notify->id[i]);
+      g_variant_unref (ret);
+      notify->failed = FALSE;
+    }
+  else
+    {
+      if (!notify->failed)
+        g_warning ("Error while sending notification : %s", error->message);
+      g_error_free (error);
+      notify->failed = TRUE;
+      notify->id[i] = 0;   /* server mohl mezitim skoncit, puvodni oznameni uz neexistuje */
+    }
+
+  g_object_unref (call->cancellable);
+  g_free (call);
+
+  if (notify->again[i])
+    {
+      notify->again[i] = FALSE;
+      pulseaudio_notify_notify (notify, i == 1);
+    }
+}
+
