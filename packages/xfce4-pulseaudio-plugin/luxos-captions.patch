diff --git a/panel-plugin/scalemenuitem.c b/panel-plugin/scalemenuitem.c
--- a/panel-plugin/scalemenuitem.c
+++ b/panel-plugin/scalemenuitem.c
@@ -199,6 +199,37 @@
 
 
 
+/* LuxOS: popisek nad posuvnikem (co ovlada: vystup / vstup a jaky zvukovy pristroj) */
+void
+xfpa_scale_menu_item_set_caption (XfpaScaleMenuItem *item,
+                                  const gchar       *caption)
+{
+  GtkWidget *column, *label;
+
+  g_return_if_fail (XFPA_IS_SCALE_MENU_ITEM (item));
+
+  if (caption == NULL || *caption == '\0')
+    return;
+
+  label = gtk_label_new (caption);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+  gtk_label_set_max_width_chars (GTK_LABEL (label), 32);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+  gtk_widget_set_name (label, "xfpa-caption");
+
+  /* posuvnik prestehovat do sloupce pod popisek (reference drzi polozka) */
+  column = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_container_remove (GTK_CONTAINER (item->hbox), item->scale);
+  gtk_box_pack_start (GTK_BOX (column), label, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (column), item->scale, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (item->hbox), column, TRUE, TRUE, 0);
+  gtk_box_reorder_child (GTK_BOX (item->hbox), column, 0);
+  gtk_widget_show_all (column);
+}
+
+
+
 void
 xfpa_scale_menu_item_set_base_icon_name (XfpaScaleMenuItem *item,
                                          const gchar       *base_icon_name)
