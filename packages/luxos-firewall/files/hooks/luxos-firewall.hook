# LuxOS firewall - po instalaci/odebrani baliku znovu zjistit aplikace s porty (LuxDrop, Steam, KDE Connect,
# Syncthing, sshd, Tailscale) a nahrat pravidla; jen kdyz firewall bezi (try-reload-or-restart)
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/bin/*
Target = usr/lib/systemd/system/*

[Action]
Description = Updating the firewall rules for installed apps...
When = PostTransaction
Exec = /usr/bin/sh -c '[ -d /run/systemd/system ] && systemctl try-reload-or-restart luxos-firewall.service; exit 0'
