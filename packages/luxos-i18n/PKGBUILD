# Maintainer: LuxOS Team
# Preklady aplikaci a skriptu LuxOS (anglictina je vychozi, cestina v cs.tsv)

pkgname=luxos-i18n
pkgver=1.0.0
pkgrel=34
pkgdesc="LuxOS translations (English, Czech, Slovak, Polish, Ukrainian, Hungarian, German, French, Spanish, Italian, Portuguese, Dutch, Swedish)"
arch=(any)
url="https://luxos.lux-ai.cz/repo/"
license=(MIT)
makedepends=(python)

package() {
    local f="$startdir/files"
    install -Dm644 "$f/i18n.sh" "$pkgdir/usr/lib/luxos/i18n.sh"
    install -Dm644 "$f/luxos_i18n.py" "$pkgdir/usr/lib/luxos/python/luxos_i18n.py"
    python -m compileall -q --invalidation-mode checked-hash -s "$pkgdir" -p / "$pkgdir/usr/lib/luxos/python"
    install -Dm644 -t "$pkgdir/usr/share/luxos/i18n" "$f"/*.tsv
}
