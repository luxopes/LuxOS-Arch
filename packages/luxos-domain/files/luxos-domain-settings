# ---- ciste funkce (testovane bez GTK) ------------------------------------------------------------
def parse_line(line):
    """Radek pomocnika -> ("step", text, n, total) | ("error", code, text) | ("done",) | ("log", radek)."""
    line = line.rstrip("\n")
    if line.startswith("@@STEP "):
        parts = line[7:].split(" ", 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            return ("step", parts[2], int(parts[0]), int(parts[1]))
        return ("step", line[7:], 0, 0)
    if line.startswith("@@ERROR "):
        code, _sep, text = line[8:].partition(" ")
        return ("error", code, text.strip())
    if line.strip() == "@@DONE":
        return ("done",)
    return ("log", line)


def error_text(code, text=""):
    """Hlaska pomocnika (uz prelozena v luxos-domain) ma prednost; jinak text podle kodu."""
    if text:
        return text
    return _(ERRORS.get(code, ERRORS["failed"]))


def describe(disc):
    """Vysledek discover -> "Microsoft Active Directory – firma.local – 2 controllers"."""
    n = len(disc.get("controllers") or [])
    kind = _("Microsoft Active Directory") if disc.get("type", "active-directory") == "active-directory" \
        else str(disc.get("type"))
    count = _("1 controller") if n == 1 else _("%d controllers") % n
    return " – ".join(x for x in (kind, disc.get("domain", ""), count if n else "") if x)


def search_domain(path=RESOLV):
    """Predvyplneni pole Domena: prvni "search"/"domain" z resolv.conf (z DHCP), mimo .local mDNS."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return ""
    for line in lines:
        p = line.split()
        if len(p) >= 2 and p[0] in ("search", "domain"):
            for d in p[1:]:
                d = d.rstrip(".")
                if DOMAIN_RE.match(d) and d not in ("lan", "home", "localdomain"):
                    return d
    return ""


def valid_domain(d):
    return bool(DOMAIN_RE.match(d or ""))


def when(iso):
    """ISO cas -> kratky mistni text ("26. 10. 14:05" / "Oct 26 14:05") nebo ""."""
    if not iso:
        return ""
    try:
        t = datetime.datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return str(iso)
    if t.tzinfo:
        t = t.astimezone()
    return t.strftime("%x %H:%M")


def helper_argv(action, *args):
    return HELPER + [action] + [str(a) for a in args if a is not None and a != ""]


def run_helper(action, args, password=None, on_line=None):
    """Spusti pomocnika (blokujici - volat ve vlakne). Heslo jen jako prvni radek stdin.
    -> (ok, kod chyby, text chyby)."""
    try:
        p = subprocess.Popen(helper_argv(action, *args), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True, bufsize=1)
    except OSError as e:
        return False, "failed", str(e)
    try:
        p.stdin.write((password or "") + "\n" if password is not None else "")
        p.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    code, text, log = "", "", []
    for line in p.stdout:
        item = parse_line(line)
        if item[0] == "error":
            code, text = item[1], item[2]
        elif item[0] == "log" and item[1].strip():
            log.append(item[1].strip())
        if on_line:
            on_line(item)
    rc = p.wait()
    if rc == 0 and not code:
        return True, "", ""
    if not code:
        # pkexec: 126 = zruseno uzivatelem, 127 = neopravneno / pomocnik chybi
        code = "cancelled" if rc in (126, 127) else "failed"
        text = "" if code == "cancelled" else (log[-1] if log else "")
    return False, code, text


def run_cli(args, timeout=60):
    """lux-domain ... --json -> slovnik (i pri chybe discover: {"ok": False, ...})."""
    try:
        r = subprocess.run([CLI] + args + ["--json"], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"ok": False, "error": "failed", "message": str(e)}
    try:
        data = json.loads(r.stdout or "{}")
    except ValueError:
        data = None
    if not isinstance(data, dict):
        return {"ok": False, "error": "failed", "message": (r.stderr or r.stdout or "").strip()[-300:]}
    return data


def background(fn, done):
    """fn() ve vlakne, done(vysledek) v hlavnim vlakne GTK."""
    def work():
        res = fn()
        GLib.idle_add(lambda: done(res) and False)
    t = threading.Thread(target=work, daemon=True)
    t.start()
    return t


# ---- GTK -----------------------------------------------------------------------------------------
class Group(Gtk.Box):
    def __init__(self, page, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("group-title")
        page.pack_start(label, False, False, 0)
        self.get_style_context().add_class("group")
        page.pack_start(self, False, False, 0)
        self.rows = 0

    def row(self, title, widget=None, hint=None):
        box = Gtk.Box(spacing=12)
        box.get_style_context().add_class("row")
        if self.rows:
            box.get_style_context().add_class("row-sep")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        t = Gtk.Label(label=title, xalign=0, wrap=True, max_width_chars=40)
        text.pack_start(t, False, False, 0)
        h = None
        if hint is not None:
            h = Gtk.Label(label=hint, xalign=0, wrap=True, max_width_chars=48)
            h.get_style_context().add_class("hint")
            text.pack_start(h, False, False, 0)
        box.pack_start(text, True, True, 0)
        if widget is not None:
            widget.set_valign(Gtk.Align.CENTER)
            box.pack_end(widget, False, False, 0)
        self.pack_start(box, False, False, 0)
        self.rows += 1
        box.title, box.hint = t, h
        return box


def styled(widget, *classes):
    for c in classes:
        widget.get_style_context().add_class(c)
    return widget


class DomainWindow(Gtk.Window):
