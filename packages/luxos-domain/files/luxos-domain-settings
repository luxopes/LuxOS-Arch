        self.set_icon_name("network-workgroup")
        self.set_wmclass(APP, APP)
        self.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=_("Organization Network")))
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.add(self.sw)
        self.status = None
        self.discovered = None
        self.busy_op = None          # bezici akce (jmeno) - zabranuje dvojimu spusteni
        self.last_threads = []
        self.show_loading()
        self.reload()

    # -- spolecne --
    def set_page(self, box):
        child = self.sw.get_child()
        if child is not None:
            self.sw.remove(child)
        self.page = box
        self.sw.add(box)
        self.sw.show_all()

    def new_page(self):
        return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=22, margin_top=10)

    def show_loading(self):
        box = self.new_page()
        sp = Gtk.Spinner(active=True, halign=Gtk.Align.CENTER, margin_top=80)
        box.pack_start(sp, False, False, 0)
        self.page_name = "loading"
        self.set_page(box)

    def reload(self):
        self.last_threads.append(background(lambda: run_cli(["status"]), self.loaded))

    def loaded(self, st):
        self.status = st if isinstance(st, dict) else {}
        if self.status.get("joined"):
            self.show_joined()
        else:
            self.show_join(self.status.get("message") if self.status.get("ok") is False else None)

    def say(self, label, text, kind="hint"):
        ctx = label.get_style_context()
        for c in ("hint", "good", "warn", "error"):
            ctx.remove_class(c)
        if kind:
            ctx.add_class(kind)
        label.set_text(text or "")
        label.set_visible(bool(text))

    def msg_label(self):
        lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=60, selectable=True)
        lbl.set_no_show_all(True)
        return lbl

    # -- pripojeni --
    def show_join(self, problem=None):
        self.page_name = "join"
        box = self.new_page()
        hero = Gtk.Label(label=_("Join an Organization Network"), xalign=0, margin_top=6)
        styled(hero, "hero-title")
        box.pack_start(hero, False, False, 0)
        intro = Gtk.Label(label=_("Connect this computer to the Windows domain (Active Directory) of your company or "
                                  "school. Then people sign in with their organization account, get shared folders "
                                  "and printers without another password, and IT can manage the computer."),
                          xalign=0, wrap=True, max_width_chars=70, margin_top=4)
        styled(intro, "hint")
        box.pack_start(intro, False, False, 0)

        g = Group(box, _("Domain"))
        self.domain_entry = Gtk.Entry(placeholder_text="firma.local", width_chars=24, activates_default=False)
        self.domain_entry.set_text(search_domain())
        self.domain_entry.connect("changed", self.on_domain_changed)
        self.domain_entry.connect("activate", lambda _e: self.find())
        self.find_btn = Gtk.Button(label=_("Find"))
        self.find_btn.connect("clicked", lambda _b: self.find())
        dbox = Gtk.Box(spacing=6)
        dbox.pack_start(self.domain_entry, False, False, 0)
        dbox.pack_start(self.find_btn, False, False, 0)
        g.row(_("Domain name"), dbox, _("For example firma.local or ad.school.cz"))
        res = Gtk.Box(spacing=8, margin_start=14, margin_end=14, margin_bottom=8)
