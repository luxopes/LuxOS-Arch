    def on_domain_changed(self, _e):
        self.discovered = None
        self.say(self.found, "")
        self.clock_btn.hide()
        self.update_join_button()

    def join_values(self):
        return (self.domain_entry.get_text().strip().lower(), self.user_entry.get_text().strip(),
                self.pw_entry.get_text(), self.ou_entry.get_text().strip(), self.admins_entry.get_text().strip())

    def update_join_button(self):
        d, u, pw, _ou, _a = self.join_values()
        self.join_btn.set_sensitive(self.busy_op is None and valid_domain(d) and bool(u) and bool(pw))
        self.find_btn.set_sensitive(self.busy_op is None and valid_domain(d))

    def set_busy(self, op):
        self.busy_op = op
        for w in (self.domain_entry, self.user_entry, self.pw_entry, self.ou_entry, self.admins_entry):
            w.set_sensitive(op is None)
        self.update_join_button()

    def find(self):
        d = self.domain_entry.get_text().strip().lower()
        if not valid_domain(d) or self.busy_op:
            return
        self.set_busy("find")
        self.find_spin.show()
        self.find_spin.start()
        self.say(self.found, _("Looking for the domain controllers…"))
        self.last_threads.append(background(lambda: run_cli(["discover", d], timeout=90), self.found_done))

    def found_done(self, res):
        self.find_spin.stop()
        self.find_spin.hide()
        self.set_busy(None)
        if not res.get("ok"):
            self.discovered = None
            self.say(self.found, error_text(res.get("error", "failed"), res.get("message", "")), "error")
            self.clock_btn.set_visible(res.get("error") == "clock")
            return
        self.discovered = res
        skew = res.get("clock_skew")
        if isinstance(skew, (int, float)) and abs(skew) > CLOCK_LIMIT:
            self.say(self.found, describe(res) + "\n" + error_text("clock"), "warn")
            self.clock_btn.show()
        else:
            self.say(self.found, describe(res), "good")
            self.clock_btn.hide()

    def sync_time(self):
        if self.busy_op:
            return
        self.set_busy("clock")
        self.say(self.found, _("Setting the clock from the domain…"))
        self.last_threads.append(background(lambda: run_helper("sync-time", []), self.sync_done))

    def sync_done(self, res):
        ok, code, text = res
        self.set_busy(None)
        if ok:
            self.clock_btn.hide()
            self.say(self.found, _("The clock now matches the domain."), "good")
        else:
            self.say(self.found, error_text(code, text), "error")

    def join(self):
        d, u, pw, ou, admins = self.join_values()
        if self.busy_op or not (valid_domain(d) and u and pw):
            return
        self.set_busy("join")
        self.progress.set_fraction(0.0)
        self.progress.show()
        self.say(self.result, "")
        self.say(self.step_label, _("Preparing…"))
        self.clock_btn.hide()
        self.pw_entry.set_text("")          # heslo nezustava v okne ani po chybe
        add_admins = admins and admins.lower() != DEFAULT_ADMINS.lower()

        def work():
            ok, code, text = run_helper("join", [d, u, ou], password=pw,
                                        on_line=lambda item: GLib.idle_add(self.on_progress, item))
            if ok and add_admins:
                ok2, code2, text2 = run_helper("admins-add", [admins])
                return True, ("admins", error_text(code2, text2)) if not ok2 else None
            return ok, (code, text)
        self.last_threads.append(background(work, self.join_done))

    def on_progress(self, item):
        if item[0] == "step":
            _k, text, n, total = item
            self.say(self.step_label, text)
            if total:
                self.progress.set_fraction(min(1.0, n / total))
            else:
                self.progress.pulse()
        return False

    def join_done(self, res):
        ok, detail = res
        self.set_busy(None)
        self.progress.hide()
        if ok:
            self.say(self.step_label, "")
            done = _("Done. Log out and sign in with your organization account.")
            if detail:
                done += "\n" + _("The administrators group could not be set: %s") % detail[1]
            self.joined_message = done
            self.reload()
            return
        code, text = detail
        self.say(self.step_label, "")
        self.say(self.result, error_text(code, text), "error")
        if code == "clock":
            self.clock_btn.show()

