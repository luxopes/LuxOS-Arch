        groups = st.get("admin_groups") or []
        for grp in groups:
            rm = Gtk.Button(label=_("Remove"))
            rm.connect("clicked", lambda _b, x=grp: self.admins("admins-remove", x))
            g.row(grp, rm, _("Domain group"))
        if not groups:
            g.row(_("No domain group – only local administrators."))
        add = Gtk.Box(spacing=6)
        self.admin_entry = Gtk.Entry(placeholder_text=_("Domain group"), width_chars=20)
        self.admin_entry.connect("activate", lambda _e: self.admins("admins-add", self.admin_entry.get_text().strip()))
        addb = Gtk.Button(label=_("Add"))
        addb.connect("clicked", lambda _b: self.admins("admins-add", self.admin_entry.get_text().strip()))
        add.pack_start(self.admin_entry, False, False, 0)
        add.pack_start(addb, False, False, 0)
        g.row(_("Add a group"), add)
        adays = st.get("admin_offline_days") or 7
        if st.get("admins_active", True):
            state = styled(Gtk.Label(label=_("Active")), "good")
            ah = _("Without a connection to the domain, administrator rights end after %d days.") % adays
        else:
            state = styled(Gtk.Label(label=_("Suspended")), "warn")
            ah = _("The computer has not reached the domain for more than %d days. Administrator rights of "
                   "domain groups return with the next connection.") % adays
        self.admins_row = g.row(_("Administrator rights"), state, ah)

        shares = st.get("shares") or []
        printers = st.get("printers") or []
        if shares or printers:
            g = Group(box, _("Shared folders and printers"))
            for s in shares:
                g.row(s.get("name") or s.get("url", ""), None, s.get("url"))
            for p in printers:
                g.row(p.get("name") or p.get("url", ""), None, p.get("url"))

        act = Gtk.Box(spacing=10, margin_top=18)
        self.leave_btn = styled(Gtk.Button(label=_("Leave the Organization Network…")), "destructive-action")
        self.leave_btn.connect("clicked", lambda _b: self.ask_leave())
        act.pack_start(self.leave_btn, False, False, 0)
        self.spin = Gtk.Spinner()
        self.spin.set_no_show_all(True)
        act.pack_end(self.spin, False, False, 0)
        box.pack_start(act, False, False, 0)
        self.step_label = self.msg_label()
        box.pack_start(self.step_label, False, False, 4)
        self.result = self.msg_label()
        box.pack_start(self.result, False, False, 4)
        self.set_page(box)

    def joined_action(self, action, args, password=None, after=None):
        """Akce pomocnika na strance Pripojeno; po uspechu znovu nacist stav."""
        if self.busy_op:
            return
        self.busy_op = action
        self.spin.show()
        self.spin.start()
        self.say(self.result, "")

        def done(res):
            ok, code, text = res
            self.busy_op = None
            self.spin.stop()
            self.spin.hide()
            if ok:
                if after:
                    after()
                self.reload()
            else:
                self.say(self.step_label, "")
                self.say(self.result, error_text(code, text), "error")
        self.last_threads.append(background(
            lambda: run_helper(action, args, password=password,
                               on_line=lambda item: GLib.idle_add(self.on_joined_progress, item)), done))

    def on_joined_progress(self, item):
        if item[0] == "step":
            self.say(self.step_label, item[1])
        return False

    def set_offline_days(self):
        self.joined_action("set-offline-days", [int(self.offline_spin.get_value())])

    def admins(self, action, group):
        if not group:
            return
        self.joined_action(action, [group])

    def leave_dialog(self):
        """Potvrzeni odpojeni (vraci dialog; odpoved resi on_leave_response)."""
        d = Gtk.Dialog(title=_("Leave the Organization Network"), transient_for=self, modal=True)
        d.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=_("Leave the Organization Network")))
        d.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        styled(d.add_button(_("Leave"), Gtk.ResponseType.OK), "destructive-action")
        area = d.get_content_area()
        area.set_spacing(10)
        area.set_border_width(16)
        area.pack_start(Gtk.Label(label=_(
            "Organization accounts will no longer be able to sign in on this computer and the settings of the "
            "organization stop applying. Personal files in home folders stay on this computer and are not "
            "deleted. Local accounts keep working."), xalign=0, wrap=True, max_width_chars=60), False, False, 0)
        d.remove_check = Gtk.CheckButton(label=_("Also remove the computer account from the domain "
                                                 "(needs a domain administrator)"))
        area.pack_start(d.remove_check, False, False, 0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=6, margin_start=24)
        d.user = Gtk.Entry(placeholder_text=_("Administrator"), width_chars=22)
        d.pw = Gtk.Entry(visibility=False, width_chars=22, input_purpose=Gtk.InputPurpose.PASSWORD)
        grid.attach(Gtk.Label(label=_("Name"), xalign=0), 0, 0, 1, 1)
        grid.attach(d.user, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label=_("Password"), xalign=0), 0, 1, 1, 1)
        grid.attach(d.pw, 1, 1, 1, 1)
        grid.set_no_show_all(True)
        for w in grid.get_children():
            w.show()
        area.pack_start(grid, False, False, 0)
        d.remove_check.connect("toggled", lambda c: grid.set_visible(c.get_active()))
        d.connect("response", self.on_leave_response)
        d.show_all()
        return d

    def ask_leave(self):
        if not self.busy_op:
            self.leave_d = self.leave_dialog()

    def on_leave_response(self, d, resp):
        remove = d.remove_check.get_active()
        user, pw = d.user.get_text().strip(), d.pw.get_text()
        if resp == Gtk.ResponseType.OK and remove and not (user and pw):
            d.user.grab_focus()
            return                          # bez jmena a hesla nelze ucet v domene smazat
        d.destroy()
        if resp != Gtk.ResponseType.OK:
            return
        self.leave(user if remove else None, pw if remove else None)

    def leave(self, user=None, password=None):
        self.say(self.step_label, _("Leaving the organization network…"))
        self.joined_action("leave", [user] if user else [], password=password if user else None,
                           after=lambda: setattr(self, "joined_message", None))


def main():
    if Gdk.Display.get_default() is None:
        print("luxos-domain-settings: no display", file=sys.stderr)
        return 1
    win = DomainWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
