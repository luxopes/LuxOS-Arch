# LuxOS - Kerberos pro organizacni sit (luxos-domain); puvodni soubor vrati "lux domain leave".
# Ticket drzi SSSD (KCM): prezije odhlaseni, obnovuje se a otevre sdilene slozky bez hesla.
[libdefaults]
    default_realm = {realm}
    dns_lookup_realm = false
    dns_lookup_kdc = true
    rdns = false
    ticket_lifetime = 24h
    renew_lifetime = 7d
    forwardable = true
    udp_preference_limit = 0
    default_ccache_name = KCM:

[domain_realm]
    .{domain} = {realm}
    {domain} = {realm}
