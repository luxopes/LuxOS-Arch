#!/usr/bin/env python3
"""Zastupny lux-domain pro GUI testy (jen cteni): status/discover --json podle $FAKE_DOMAIN_DIR."""
import json
import os
import sys

d = os.environ["FAKE_DOMAIN_DIR"]
with open(os.path.join(d, "calls.log"), "a", encoding="utf-8") as f:
    f.write("cli " + json.dumps(sys.argv[1:]) + "\n")
args = [a for a in sys.argv[1:] if a != "--json"]
if args[:1] == ["status"]:
    try:
        with open(os.path.join(d, "status.json"), encoding="utf-8") as f:
            print(f.read())
    except OSError:
        print(json.dumps({"joined": False}))
    sys.exit(0)
if args[:1] == ["discover"]:
    dom = args[1] if len(args) > 1 else ""
    if dom == "firma.local":
        print(json.dumps({"ok": True, "domain": "firma.local", "realm": "FIRMA.LOCAL", "short": "FIRMA",
                          "type": "active-directory", "controllers": ["dc1.firma.local", "dc2.firma.local"],
                          "site": "Default-First-Site-Name", "clock_skew": 3}))
        sys.exit(0)
    if dom == "skew.local":
        print(json.dumps({"ok": True, "domain": "skew.local", "realm": "SKEW.LOCAL", "short": "SKEW",
                          "type": "active-directory", "controllers": ["dc.skew.local"], "clock_skew": 900}))
        sys.exit(0)
    print(json.dumps({"ok": False, "error": "dns", "message": ""}))
    sys.exit(1)
sys.exit(2)
