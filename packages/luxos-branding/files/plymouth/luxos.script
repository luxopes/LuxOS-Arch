# LuxOS - boot splash pro Plymouth (styl macOS: cerne pozadi, logo, tenky progress bar)

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

# Logo - velikost podle vysky obrazovky
logo_raw = Image("logo.png");
logo_size = Math.Int(screen_h * 0.13);
if (logo_size < 80) logo_size = 80;
logo.image = logo_raw.Scale(logo_size, logo_size);
logo.sprite = Sprite(logo.image);
logo.x = screen_x + screen_w / 2 - logo_size / 2;
logo.y = screen_y + screen_h / 2 - logo_size / 2 - screen_h * 0.04;
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetOpacity(0);

# Progress bar
track.image = Image("bar-track.png");
fill_raw = Image("bar-fill.png");
bar.w = track.image.GetWidth();
bar.h = track.image.GetHeight();
bar.x = screen_x + screen_w / 2 - bar.w / 2;
bar.y = logo.y + logo_size + screen_h * 0.07;
track.sprite = Sprite(track.image);
track.sprite.SetPosition(bar.x, bar.y, 10);
track.sprite.SetOpacity(0);
fill.sprite = Sprite();
fill.sprite.SetPosition(bar.x, bar.y, 11);

fade = 0;
password_mode = 0;
shown_progress = 0;
target_progress = 0;
finishing = 0;

fun refresh_cb() {
    # Plynule zobrazeni loga
    if (fade < 1) {
        fade += 0.04;
        if (fade > 1) fade = 1;
        logo.sprite.SetOpacity(fade);
        if (!password_mode) track.sprite.SetOpacity(fade);
    }
    # Plynuly posun progress baru
    if (shown_progress < target_progress) {
        speed = 0.08;
        if (finishing) speed = 0.22;
        shown_progress += (target_progress - shown_progress) * speed + 0.002;
        if (shown_progress > target_progress) shown_progress = target_progress;
        w = Math.Int(bar.w * shown_progress);
        if (w < 1) w = 1;
        fill.sprite.SetImage(fill_raw.Scale(w, bar.h));
        if (!password_mode) fill.sprite.SetOpacity(fade);
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

fun progress_cb(duration, progress) {
    if (progress > target_progress) target_progress = progress;
}
Plymouth.SetBootProgressFunction(progress_cb);

# Start prihlasovaci obrazovky (luxos-plymouth-finish pred LightDM): dobehnout do konce
fun status_cb(status) {
    if (status == "luxos-finish") {
        finishing = 1;
        target_progress = 1;
    }
}
Plymouth.SetUpdateStatusFunction(status_cb);

# --- Zadani hesla (LUKS) -------------------------------------------------
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
entry.sprite = Sprite();
prompt.sprite = Sprite();
bullets = [];

fun hide_password() {
    password_mode = 0;
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    track.sprite.SetOpacity(fade);
    fill.sprite.SetOpacity(fade);
}

fun display_normal_cb() {
    hide_password();
}

fun display_password_cb(prompt_text, bullet_count) {
    password_mode = 1;
    track.sprite.SetOpacity(0);
    fill.sprite.SetOpacity(0);

    ex = screen_x + screen_w / 2 - entry.image.GetWidth() / 2;
    ey = bar.y - entry.image.GetHeight() / 2;
    entry.sprite.SetImage(entry.image);
    entry.sprite.SetPosition(ex, ey, 20);
    entry.sprite.SetOpacity(1);

    if (prompt_text == "") prompt_text = "Enter password";
    prompt.image = Image.Text(prompt_text, 1, 1, 1, 0.85, "Sans 11");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(screen_x + screen_w / 2 - prompt.image.GetWidth() / 2, ey + entry.image.GetHeight() + 14, 20);
    prompt.sprite.SetOpacity(1);

    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    max = 20;
    if (bullet_count < max) max = bullet_count;
    for (i = 0; i < max; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(ex + 18 + i * 12, ey + entry.image.GetHeight() / 2 - 5, 21);
        bullets[i].SetOpacity(1);
    }
}

Plymouth.SetDisplayNormalFunction(display_normal_cb);
Plymouth.SetDisplayPasswordFunction(display_password_cb);

# --- Zpravy (napr. chyby fsck) ---------------------------------------------
message.sprite = Sprite();
fun message_cb(text) {
    message.image = Image.Text(text, 1, 1, 1, 0.7, "Sans 10");
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(screen_x + screen_w / 2 - message.image.GetWidth() / 2, screen_y + screen_h * 0.9, 30);
}
Plymouth.SetMessageFunction(message_cb);

fun quit_cb() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_cb);
