# Maintainer: LuxOS Team
# Lokalni balik: zdrojove soubory jsou v ./files (odkazovano pres $startdir).

pkgname=luxos-branding
pkgver=1.1.0
pkgrel=17
pkgdesc="LuxOS branding: logo, wallpapers, Plymouth boot splash and os-release"
arch=(any)
url="https://github.com/luxos"
license=(MIT)
depends=(plymouth)
makedepends=(librsvg imagemagick python python-pillow python-numpy)

build() {
    local f="$startdir/files"
    mkdir -p render
    for s in 16 24 32 48 64 128 256 512; do
        rsvg-convert -w $s -h $s "$f/logo/luxos-logo.svg" -o render/logo-$s.png
    done
    rsvg-convert -w 256 -h 256 "$f/logo/luxos-logo-white.svg" -o render/logo-white.png
    for v in dark light; do
        rsvg-convert -w 3840 -h 2160 "$f/wallpapers/luxos-$v.svg" -o render/luxos-$v.png
        magick render/luxos-$v.png -quality 94 render/luxos-waves-$v.jpg
    done
    # Boot splash: kazda barevna varianta jako samostatny motiv Plymouth + nahledy pro Nastaveni
    python3 "$f/plymouth/make-variants.py" "$f/logo/luxos-logo.png" "$f/plymouth/luxos.script" render/plymouth
    rsvg-convert "$f/syslinux/splash.svg" -o render/splash.png
    # Ikony aplikaci LuxOS (512 px zdroj) v beznych velikostech
    local i
    for i in "$f"/icons/*.png; do
        for s in 48 64 128 256; do
            magick "$i" -filter Lanczos -resize ${s}x$s render/icon-$s-"${i##*/}"
        done
    done
}

package() {
    local f="$startdir/files"

    install -Dm644 "$f/logo/luxos-logo.svg"          "$pkgdir/usr/share/icons/hicolor/scalable/apps/luxos-logo.svg"
    install -Dm644 "$f/logo/luxos-logo-symbolic.svg" "$pkgdir/usr/share/icons/hicolor/symbolic/apps/luxos-logo-symbolic.svg"
    install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps" "$f"/symbolic/*.svg
    for s in 16 24 32 48 64 128 256 512; do
        install -Dm644 render/logo-$s.png "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/luxos-logo.png"
    done
    install -Dm644 render/logo-256.png "$pkgdir/usr/share/pixmaps/luxos-logo.png"
    local i
    for i in "$f"/icons/*.png; do
        install -Dm644 "$i" "$pkgdir/usr/share/icons/hicolor/512x512/apps/${i##*/}"
        for s in 48 64 128 256; do
            install -Dm644 render/icon-$s-"${i##*/}" "$pkgdir/usr/share/icons/hicolor/${s}x$s/apps/${i##*/}"
        done
    done
    install -Dm644 -t "$pkgdir/usr/share/luxos/logo" "$f"/logo/*.svg "$f"/logo/luxos-logo.png render/logo-white.png
    install -Dm644 render/splash.png "$pkgdir/usr/share/luxos/syslinux/splash.png"

    # Tapety; luxos-dark/light jsou vychozi pro tmavy a svetly rezim (luxos-appearance)
    install -Dm644 -t "$pkgdir/usr/share/backgrounds/luxos" "$f"/wallpapers/*.jpg \
        render/luxos-waves-dark.jpg render/luxos-waves-light.jpg
    ln -s luxos-flow-dark.jpg "$pkgdir/usr/share/backgrounds/luxos/luxos-dark.jpg"
    ln -s luxos-flow-light.jpg "$pkgdir/usr/share/backgrounds/luxos/luxos-light.jpg"

    # Motivy Plymouth: luxos (modra, vychozi), luxos-purple, -orange, -green, -light (luxos-splash)
    local t
    for t in render/plymouth/luxos*/; do
        t=${t%/}
        install -Dm644 -t "$pkgdir/usr/share/plymouth/themes/${t##*/}" "$t"/*
    done
    install -Dm644 -t "$pkgdir/usr/share/luxos/splash" render/plymouth/previews/*.png
    install -Dm755 "$f/plymouth/luxos-splash" "$pkgdir/usr/bin/luxos-splash"
    install -Dm644 "$f/plymouth/org.luxos.splash.policy" "$pkgdir/usr/share/polkit-1/actions/org.luxos.splash.policy"
    install -Dm755 "$f/plymouth/luxos-plymouth-finish" "$pkgdir/usr/lib/luxos/luxos-plymouth-finish"
    install -Dm644 "$f/plymouth/lightdm-plymouth.conf" "$pkgdir/usr/lib/systemd/system/lightdm.service.d/luxos-plymouth.conf"

    # verze LuxOS do os-release (files/version); BUILD_ID = den sestaveni
    local VERSION CODENAME
    . "$f/version"
    sed -e "s/@VERSION@/$VERSION/g" -e "s/@SHORT@/${VERSION%.0}/g" -e "s/@CODENAME@/$CODENAME/g" \
        -e "s/@CODENAME_LC@/${CODENAME,,}/g" -e "s/@BUILD@/$(date -u +%Y%m%d)/g" "$f/apply-branding" \
        | install -Dm755 /dev/stdin "$pkgdir/usr/lib/luxos/apply-branding"
    install -Dm644 "$f/version" "$pkgdir/usr/lib/luxos/version"
    # Co je noveho (luxos-whats-new po aktualizaci)
    install -Dm644 -t "$pkgdir/usr/share/luxos/whats-new" "$f"/whats-new/*.json
    install -Dm644 "$f/10-luxos-branding.hook" "$pkgdir/usr/share/libalpm/hooks/10-luxos-branding.hook"
}
