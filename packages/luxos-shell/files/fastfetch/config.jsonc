// LuxOS - fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Logo LuxOS ze znaku Unicode (bloky, sextanty, kliny; 24bit barvy) - scripts/render-terminal-logo.py --rows 12
    // (obrazek misto znaku neumi VTE/xfce4-terminal: podpora SIXEL byla z VTE odstranena)
    "type": "file-raw",
    "source": "/usr/share/luxos/fastfetch/logo.ans",
    "width": 31,
    "height": 12,
    "padding": { "top": 3, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "",
    // uzky terminal (80 sloupcu): radky orezat, nezalamovat pres logo
    "disableLinewrap": true,
    "key": { "width": 13 }
  },
  "modules": [
    { "type": "custom", "format": "LuxOS", "outputColor": "1;97" },
    { "type": "custom", "format": "SIMPLE  ·  FAST  ·  SECURE", "outputColor": "90" },
    "break",
    { "type": "os",       "key": "󰔶  OS",       "keyColor": "38;2;255;159;90",  "format": "{name} {version} {arch}" },
    { "type": "host",     "key": "󰍹  Host",     "keyColor": "38;2;255;210;90",
      "format": "{name}{?version} ({version}){?}" },
    { "type": "kernel",   "key": "  Kernel",   "keyColor": "38;2;95;211;141" },
    { "type": "uptime",   "key": "󰅐  Uptime",   "keyColor": "38;2;90;200;250" },
    // Baliky spravuje lux (databaze libalpm = "pacman" ve fastfetch); Flatpak/Snap/Nix jen kdyz nejake jsou
    { "type": "packages", "key": "󰏖  Packages", "keyColor": "38;2;180;140;255",
      "format": "{pacman} (lux){?flatpak-all}, {flatpak-all} (flatpak){?}{?snap}, {snap} (snap){?}{?nix-all}, {nix-all} (nix){?}" },
    { "type": "shell",    "key": "󰆍  Shell",    "keyColor": "38;2;255;122;217" },
    // Prostredi a terminal LuxOS pod vlastnimi jmeny (ne Xfce / xfce4-terminal)
    { "type": "command",  "key": "󰧨  Desktop",  "keyColor": "38;2;91;140;255", "shell": "/bin/sh",
      "text": "case \"$XDG_CURRENT_DESKTOP\" in *XFCE*|*LuxOS*|'') echo 'LuxOS Desktop' ;; *) echo \"$XDG_CURRENT_DESKTOP\" ;; esac" },
    { "type": "command",  "key": "󰞷  Terminal", "keyColor": "38;2;155;140;255", "shell": "/bin/sh",
      "text": "/usr/lib/luxos/fastfetch-terminal" },
    { "type": "cpu",      "key": "󰻟  CPU",      "keyColor": "38;2;255;107;154" },
    { "type": "gpu",      "key": "󰢮  GPU",      "keyColor": "38;2;255;107;213" },
    { "type": "memory",   "key": "󰍛  Memory",   "keyColor": "38;2;79;209;197" },
    { "type": "disk",     "key": "󰋊  Disk",     "keyColor": "38;2;90;200;250", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
