# LuxOS - konfigurace bashe (nacitana z ~/.bashrc)
# Vlastni nastaveni patri do ~/.bashrc pod radek se "source" nebo do
# ~/.config/luxos/shell.conf (napr. LUXOS_BLESH=0, LUXOS_FASTFETCH=0).

[[ $- != *i* ]] && return

LUXOS_BLESH=1
LUXOS_FASTFETCH=1
LUXOS_SHELL_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/luxos/shell.conf"
[[ -r $LUXOS_SHELL_CONF ]] && . "$LUXOS_SHELL_CONF"

# ble.sh (nasepavani + zvyrazneni syntaxe) se musi nacist co nejdrive
if [[ $LUXOS_BLESH == 1 && $TERM != linux && $TERM != dumb && -r /usr/share/blesh/ble.sh ]]; then
    _luxos_blecache=0
    compgen -G "${XDG_CACHE_HOME:-$HOME/.cache}/blesh/*/term.$TERM" >/dev/null && _luxos_blecache=1
    source /usr/share/blesh/ble.sh --noattach --rcfile /usr/share/luxos/shell/blerc
    # Pri prvnim spusteni ble.sh vypise radek "updating tput cache" - smazat ho
    [[ ${BLE_VERSION-} && $_luxos_blecache == 0 ]] && printf '\e[1A\e[2K\r'
    unset _luxos_blecache
fi

# Historie
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
HISTIGNORE='ls:ll:la:cd:pwd:exit:clear'
shopt -s histappend cmdhist checkwinsize autocd cdspell dirspell globstar extglob

# Doplnovani (bez ble.sh pres readline)
if [[ -z ${BLE_VERSION-} ]]; then
    bind 'set completion-ignore-case on'
    bind 'set show-all-if-ambiguous on'
    bind 'set colored-stats on'
    bind 'set colored-completion-prefix on'
    bind 'set mark-symlinked-directories on'
    bind '"\e[A": history-search-backward'
    bind '"\e[B": history-search-forward'
fi

. /usr/share/luxos/shell/aliases.sh

# Software spravuje lux; prikaz pacman v LuxOS neni. Kdo ho ze zvyku napise, dostane misto
# "command not found" i odpovidajici prikaz lux (/usr/lib/lux/pacman-hint, balik lux).
# Existujici obsluha (napr. z ~/.bashrc pred nactenim LuxOS) zustava pro ostatni prikazy.
if declare -F command_not_found_handle >/dev/null &&
    [[ $(declare -f command_not_found_handle) != *pacman-hint* ]]; then   # ne sama sebe (znovunacteni)
    eval "_luxos_cnf_prev() $(declare -f command_not_found_handle | tail -n +2)"
fi
command_not_found_handle() {
    if [[ $1 == pacman || $1 == pacman-* ]] && [[ -x /usr/lib/lux/pacman-hint ]]; then
        local sh=${0##*/}
        printf '%s: %s: %s\n' "${sh#-}" "$1" "command not found" >&2
        if [[ $1 == pacman ]]; then shift; else set --; fi
        /usr/lib/lux/pacman-hint "$@"
        return 127
    fi
    # zvyky z Debianu/Ubuntu, Fedory a openSUSE (apt, dnf, ifconfig, ...) -> prikaz v LuxOS
    case $1 in
        apt|apt-get|apt-cache|aptitude|dpkg|dpkg-reconfigure|dnf|yum|zypper|snap|\
        ifconfig|netstat|route|arp|iwconfig|nslookup|dig|host|traceroute|which)
            if [[ -x /usr/lib/luxos/command-hint ]]; then
                local sh=${0##*/}
                printf '%s: %s: %s\n' "${sh#-}" "$1" "command not found" >&2
                /usr/lib/luxos/command-hint "$@"
                return 127
            fi ;;
    esac
    if declare -F _luxos_cnf_prev >/dev/null; then _luxos_cnf_prev "$@"; return; fi
    local sh=${0##*/}
    printf '%s: %s: %s\n' "${sh#-}" "$1" "command not found" >&2
    return 127
}

command -v zoxide &>/dev/null && eval "$(zoxide init bash)"

if command -v fzf &>/dev/null; then
    if [[ ${BLE_VERSION-} ]]; then
        ble-import -d integration/fzf-completion
        ble-import -d integration/fzf-key-bindings
    else
        eval "$(fzf --bash)"
    fi
fi

# Prompt: starship v grafickem terminalu, jednoduchy prompt na TTY
if [[ $TERM != linux ]] && command -v starship &>/dev/null; then
    [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml ]] || export STARSHIP_CONFIG=/usr/share/luxos/shell/starship.toml
    # Prompt s casovym limitem: zaseknuty souborovy system (napr. sshfs po ztrate spojeni) jinak
    # zablokuje starship a s nim cely terminal - bez vyzvy, bez Ctrl+C. Po limitu nouzova vyzva.
    _luxos_starship() {
        local out
        if out=$(timeout -k 0.5 2 /usr/bin/starship "$@" 2>/dev/null); then
            printf '%s' "$out"
        elif [[ $1 == prompt && " $* " != *" --right "* && " $* " != *" --continuation "* ]]; then
            printf '%s' '\[\e[1m\]\w\[\e[0m\] \[\e[1;38;2;167;123;255m\]❯\[\e[0m\] '
        fi
    }
    eval "$(starship init bash --print-full-init | sed 's#/usr/bin/starship prompt#_luxos_starship prompt#g')"
else
    PS1='\[\e[38;2;167;123;255m\]✦\[\e[0m\] \[\e[1m\]\w\[\e[0m\] \$ '
fi

# Terminal LuxOS: nazev panelu a okna = aktualni slozka (jako macOS Terminal)
if [[ ${TERM_PROGRAM-} == LuxOS-Terminal ]]; then
    _luxos_title() { printf '\e]0;%s\a' "${PWD/#$HOME/\~}"; }
    [[ ${PROMPT_COMMAND-} == *_luxos_title* ]] || PROMPT_COMMAND="_luxos_title${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# Uvitani - fastfetch v kazdem novem okne terminalu (ne ve vnorenem shellu)
# Terminal LuxOS s obrazky SIXEL pripravi skutecne logo pro velikost pisma (LUXOS_TERMINAL_LOGO),
# jinde zustava logo ze znaku Unicode (tmux/screen maji vlastni TERM_PROGRAM/TERM)
if [[ $LUXOS_FASTFETCH == 1 && $TERM != linux ]] && command -v fastfetch &>/dev/null; then
    luxos_parent=
    read -r luxos_parent < /proc/$PPID/comm 2>/dev/null
    case $luxos_parent in
        bash|zsh|sh|lsh|fish|dash|su|sudo|login) ;;
        *) if [[ ${TERM_PROGRAM-} == LuxOS-Terminal && $TERM == xterm-256color && -r ${LUXOS_TERMINAL_LOGO-} ]]; then
               fastfetch --logo-type raw --logo "$LUXOS_TERMINAL_LOGO"
           else
               fastfetch
           fi ;;
    esac
    unset luxos_parent
fi

[[ ${BLE_VERSION-} ]] && ble-attach
