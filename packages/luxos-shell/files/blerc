# LuxOS - nastaveni ble.sh
# Sirka znaku napevno: automaticke mereni pri startu vypisuje testovaci znaky (probliknuti)
bleopt char_width_mode=west
bleopt char_width_version=16.0
# Pri zmene velikosti okna terminal text sam preskladne - prekreslit vyzvu na puvodni misto
bleopt canvas_winch_action=redraw-prev
bleopt complete_auto_delay=80
# Delka behu a chybovy kod na samostatnem radku nad vyzvou (ne uvnitr vyzvy):
# ⏱ 1m4s prikaz / ✘ 1 - delka jen u prikazu nad 5 s, %.0s schova vytizeni CPU
bleopt exec_errexit_mark=$'\e[38;5;203m✘ %d\e[m'
bleopt exec_elapsed_mark=$'\e[2m⏱ %s%.0s\e[m'
bleopt exec_elapsed_enabled='real>=5000'
bleopt edit_abell=
bleopt prompt_eol_mark=''
ble-face -s auto_complete fg=244
ble-face -s syntax_error fg=203
ble-face -s command_builtin fg=111
ble-face -s command_alias fg=111
ble-face -s command_function fg=111
ble-face -s command_file fg=111

# Enter spusti i viceradkovy prikaz (napr. vlozeny ze schranky), pokud je syntakticky uplny;
# jinak (neuzavrene if/uvozovky...) vlozi novy radek. Vychozi ble.sh u viceradkoveho textu Enterem
# jen pridava radky a spoustelo se az Ctrl+J, coz nikdo nehada.
function ble/widget/luxos/accept-or-newline {
  # vlozeni bez "bracketed paste" (radky prichazeji jako klavesy): odradkovat, ne spoustet po radcich
  if [[ $_ble_edit_str ]] && ble/decode/has-input &&
       ((0<=bleopt_accept_line_threshold&&bleopt_accept_line_threshold<=_ble_decode_input_count+ble_decode_char_rest)); then
    ble/widget/newline
    return
  fi
  ble-edit/content/update-syntax
  if [[ ! $_ble_edit_str ]] || ble/syntax:bash/is-complete; then
    ble/widget/accept-line
  else
    ble/widget/newline
  fi
}
ble-bind -m emacs -f 'C-m' luxos/accept-or-newline
ble-bind -m emacs -f 'RET' luxos/accept-or-newline
# historie sdilena mezi terminaly: kazdy prikaz se hned zapise a ostatni terminaly ho uvidi
bleopt history_share=1
