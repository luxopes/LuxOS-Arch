# LuxOS - konfigurace zsh (nacitana z ~/.zshrc)
[[ -o interactive ]] || return

LUXOS_FASTFETCH=1
LUXOS_SHELL_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/luxos/shell.conf"
[[ -r $LUXOS_SHELL_CONF ]] && . "$LUXOS_SHELL_CONF"

HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
setopt append_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments no_beep extended_glob

autoload -Uz compinit && compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

. /usr/share/luxos/shell/aliases.sh

# Software spravuje lux; prikaz pacman v LuxOS neni (viz bashrc): misto "command not found"
# i odpovidajici prikaz lux. Existujici obsluha zustava pro ostatni prikazy.
# (ne sama sebe pri znovunacteni)
if (( $+functions[command_not_found_handler] )) && [[ $functions[command_not_found_handler] != *pacman-hint* ]]; then
    functions -c command_not_found_handler _luxos_cnf_prev
fi
command_not_found_handler() {
    if [[ $1 == pacman || $1 == pacman-* ]] && [[ -x /usr/lib/lux/pacman-hint ]]; then
        printf 'zsh: command not found: %s\n' "$1" >&2
        if [[ $1 == pacman ]]; then shift; else set --; fi
        /usr/lib/lux/pacman-hint "$@"
        return 127
    fi
    # zvyky z Debianu/Ubuntu, Fedory a openSUSE (apt, dnf, ifconfig, ...) -> prikaz v LuxOS
    case $1 in
        apt|apt-get|apt-cache|aptitude|dpkg|dpkg-reconfigure|dnf|yum|zypper|snap|\
        ifconfig|netstat|route|arp|iwconfig|nslookup|dig|host|traceroute|which)
            if [[ -x /usr/lib/luxos/command-hint ]]; then
                printf 'zsh: command not found: %s\n' "$1" >&2
                /usr/lib/luxos/command-hint "$@"
                return 127
            fi ;;
    esac
    if (( $+functions[_luxos_cnf_prev] )); then _luxos_cnf_prev "$@"; return; fi
    printf 'zsh: command not found: %s\n' "$1" >&2
    return 127
}

command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
command -v fzf &>/dev/null && eval "$(fzf --zsh)"

if [[ $TERM != linux ]] && command -v starship &>/dev/null; then
    [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml ]] || export STARSHIP_CONFIG=/usr/share/luxos/shell/starship.toml
    eval "$(starship init zsh)"
else
    PROMPT='%F{141}✦%f %B%~%b %# '
fi

[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    . /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    . /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

if [[ $LUXOS_FASTFETCH == 1 && $TERM != linux && -n ${XDG_RUNTIME_DIR-} && ! -e $XDG_RUNTIME_DIR/luxos-greeted ]] \
    && (( $+commands[fastfetch] )); then
    : > "$XDG_RUNTIME_DIR/luxos-greeted"
    fastfetch
fi
