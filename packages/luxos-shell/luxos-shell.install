# Bash vlastni /etc/skel/.bashrc (v backup poli) - doplnime nacitani konfigurace LuxOS
_luxos_skel() {
    if ! grep -q '/usr/share/luxos/shell/bashrc' /etc/skel/.bashrc 2>/dev/null; then
        cat > /etc/skel/.bashrc <<'SKEL'
#
# ~/.bashrc
#

# Konfigurace LuxOS (ble.sh, starship, aliasy, historie)
[[ -r /usr/share/luxos/shell/bashrc ]] && . /usr/share/luxos/shell/bashrc

# Vlastni nastaveni pis sem:
SKEL
    fi
}

# Novi uzivatele (useradd, nastaveni uzivatelu) dostanou lsh
_luxos_default_shell() {
    sed -i 's#^SHELL=.*#SHELL=/usr/bin/lsh#' /etc/default/useradd 2>/dev/null
}

post_install() { _luxos_skel; _luxos_default_shell; }
post_upgrade() { _luxos_skel; _luxos_default_shell; }
