/* LuxOS - Launchpad */
* {
    lux-bg:       rgba(16, 16, 22, 90%);
    lux-fg:       #f2f2f7;
    lux-muted:    #a0a0aa;
    lux-accent:   rgba(255, 255, 255, 16%);
    lux-sel-fg:   #ffffff;
    lux-border:   rgba(255, 255, 255, 18%);
    lux-field:    rgba(255, 255, 255, 10%);
    font:              "Inter 11";
    background-color:  transparent;
    text-color:        @lux-fg;
}

window {
    fullscreen:        true;
    background-color:  @lux-bg;
    padding:           6% 12%;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  5%;
}

inputbar {
    children:         [ icon-search, entry ];
    expand:           false;
    margin:           0 34%;
    padding:          8px 14px;
    spacing:          8px;
    border-radius:    10px;
    border:           1px;
    border-color:     @lux-border;
    background-color: @lux-field;
}

icon-search {
    expand:         false;
    filename:       "system-search";
    size:           18px;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search";
    placeholder-color: @lux-muted;
    vertical-align:    0.5;
    horizontal-align:  0;
}

listview {
    columns:      7;
    lines:        4;
    fixed-height: true;
    fixed-columns: true;
    scrollbar:    false;
    spacing:      3%;
    flow:         horizontal;
}

element {
    orientation:   vertical;
    padding:       14px 6px;
    spacing:       10px;
    border-radius: 18px;
}

element selected.normal, element selected.active {
    background-color: @lux-accent;
    text-color:       @lux-sel-fg;
}

element-icon {
    size:             72px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color:       inherit;
}
