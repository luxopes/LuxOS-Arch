#!/bin/sh
# LuxOS - pred prihlasovaci obrazovkou: lehky kompozitor (pruhledne a zaoblene nabidky).
# Bez nej X server vyplni zaoblene rohy a pruhlednost cernou barvou.
# PID se zapise pro luxos-session-setup (ukonci jen tento kompozitor, ne procesy uzivatelu).
if command -v xcompmgr >/dev/null; then
    xcompmgr -n >/dev/null 2>&1 &
    d=${DISPLAY#*:}; d=${d%%.*}
    echo "$!" >"${LUXOS_GREETER_PIDDIR:-/run}/luxos-greeter-xcompmgr.${d:-0}" 2>/dev/null
fi
exit 0
