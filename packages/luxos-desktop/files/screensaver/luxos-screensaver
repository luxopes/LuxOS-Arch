#!/usr/bin/env python3
"""LuxOS - setrice obrazovky (styly vybira --style):

  desktop     tapeta plochy uzivatele a velke hodiny (vychozi; jako zamykaci obrazovka macOS) - presne
              jako klidovy stav luxos-greeter a zamykaciho dialogu xfce4-screensaver LuxOS
              (luxos-lock-ui.c), takze prechod setric -> dialog s heslem je plynuly
  wallpapers  tapety LuxOS s pomalym prolinanim a velke hodiny
  analog      tapety LuxOS s prolinanim a velke rucickove hodiny s datem (svetle/tmave podle vzhledu);
              mimo prolinani se prekresluji jen hodiny (plynula vterinova rucicka, 20 snimku/s)
  clock       velke hodiny na cernem pozadi, pomalu se posouvaji (setri OLED)
  aurora      plynule se prelevajici barevne svetlo
  photos      prezentace fotek z ~/Pictures (bez fotek tapety LuxOS)
  logo        logo LuxOS pomalu pluje po obrazovce

xfce4-screensaver ho spousti s XSCREENSAVER_WINDOW (X okno, do ktereho se kresli).
Bez teto promenne (nahled v nastaveni, test) otevre vlastni okno; --window na cele
obrazovce, jinak 640x400.
"""
import configparser
import glob
import math
import os
import random
import subprocess
import sys
import threading
import time

import cairo

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango, PangoCairo  # noqa: E402

WALLS = sorted(glob.glob("/usr/share/backgrounds/luxos/luxos-*.jpg"))
WALLS = sorted({os.path.realpath(w) for w in WALLS if not w.endswith(("luxos-dark.jpg", "luxos-light.jpg"))})
SLIDE = 20.0      # sekund na tapetu
FADE = 3.0        # delka prolinani
FPS = 15


STYLES = ("desktop", "wallpapers", "analog", "clock", "aurora", "photos", "logo", "blank")
ANALOG_FPS = 20       # vterinova rucicka plynule; prekresluje se jen ctverec s hodinami
ANALOG_SLIDE = 30.0   # rucickove hodiny: sekund na tapetu
ANALOG_FADE = 2.5
FULL_EVERY = 5.0      # cela obrazovka nejpozdeji po tolika sekundach (i kdyz se meni jen hodiny)
FULL_BURST = 0.5      # po odkryti / mezere: tak dlouho kazdy snimek cely (i kdyz okno prekresli jiny)
PHOTO_EXT = (".jpg", ".jpeg", ".png", ".webp")
LOGO = "/usr/share/icons/hicolor/scalable/apps/luxos-logo.svg"
GREETER_CONF = os.environ.get("LUXOS_GREETER_CONF", "/etc/lightdm/luxos-greeter.conf")


def greeter_formats():
    """Pismo a formaty hodin/data jako luxos-greeter (stejny soubor nastaveni)."""
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_TIME") or os.environ.get("LANG") or "en")
    lang = lang.split("_")[0].split(".")[0] or "en"
    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read(GREETER_CONF, encoding="utf-8")
    except (OSError, configparser.Error):
        pass
    g = cp["greeter"] if cp.has_section("greeter") else {}
    v = str(g.get("clock-24h", "")).strip().lower()
    h24 = lang != "en" if v in ("", "auto") else v in ("1", "true", "yes", "on")
    return (str(g.get("font", "")).strip() or "Inter",
            str(g.get("clock-format", "")).strip() or ("%-H:%M" if h24 else "%-I:%M"),
            str(g.get("date-format", "")).strip() or ("%A %-d. %B" if lang == "cs" else "%A, %B %-d"))


def text_layout(cr, text, px, weight, family):
    lay = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription()
    fd.set_family(f"{family},Inter,Cantarell,Noto Sans,sans-serif")
    fd.set_weight(weight)
    fd.set_absolute_size(px * Pango.SCALE)
    lay.set_font_description(fd)
    lay.set_text(text, -1)
    return lay


def shadow_text(cr, lay, x, y, alpha, blur):
    # mekky stin: nekolik posunutych kopii s malou pruhlednosti (jako luxos-greeter)
    for dx, dy in ((0, 1), (0, 2), (-1, 1.5), (1, 1.5), (0, 3)):
        cr.move_to(x + dx * blur * 0.35, y + dy * blur * 0.45)
        cr.set_source_rgba(0, 0, 0, 0.055 * alpha)
        PangoCairo.show_layout(cr, lay)
    cr.move_to(x, y)
    cr.set_source_rgba(1, 1, 1, alpha)
    PangoCairo.show_layout(cr, lay)


def desktop_wallpaper(monitor=None):
    """Tapeta plochy z xfconf (xfce4-desktop) ve stejnem poradi jako zamykaci dialog xfce4-screensaver:
    monitor<nazev>/workspace0, monitor<nazev>, monitor0/workspace0, pak kterykoli monitor;
    bez tapety vychozi tapeta LuxOS aktualniho rezimu (svetly/tmavy)."""
    have = {}
    try:
        out = subprocess.run(["xfconf-query", "-c", "xfce4-desktop", "-l", "-v"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    for line in out.splitlines():
        prop, _sep, val = line.partition(" ")
        if prop.startswith("/backdrop/screen0/monitor") and prop.endswith("/last-image") and val.strip():
            have[prop[len("/backdrop/screen0/"):-len("/last-image")]] = val.strip()
    keys = ([f"monitor{monitor}/workspace0", f"monitor{monitor}"] if monitor else []) + ["monitor0/workspace0"]
    keys += sorted(k for k in have if k.endswith("/workspace0")) + sorted(have)
    for k in keys:
        if k in have and os.path.isfile(have[k]):
            return have[k]
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(cfg, "luxos", "appearance"), encoding="utf-8") as f:
            mode = "dark" if f.read().strip() == "dark" else "light"
    except OSError:
        mode = "light"
    return f"/usr/share/backgrounds/luxos/luxos-{mode}.jpg"


def photo_list():
    pics = os.path.join(os.path.expanduser("~"), "Pictures")
    try:
        names = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=2).stdout.strip()
        if names and os.path.isdir(names):
            pics = names
    except (OSError, subprocess.TimeoutExpired):
        pass
    found = []
    for root, _dirs, files in os.walk(pics):
        found += [os.path.join(root, f) for f in files if f.lower().endswith(PHOTO_EXT)]
        if len(found) > 500:
            break
    random.shuffle(found)
    return found


class Saver:
    def __init__(self, style="desktop", monitor=None):
        self.images = {}
        self.start = time.monotonic()
        self.style = style if style in STYLES else "desktop"
        self.slides = WALLS
        if self.style == "photos":
            self.slides = photo_list() or WALLS
        elif self.style == "desktop":
            self.slides = [desktop_wallpaper(monitor)]
        self.logo = None
        self.phase = random.random() * 100
        self.frame = None           # desktop: tapeta s ztmavenim (kresli se jen jednou)
        self.formats = greeter_formats() if self.style in ("desktop", "analog") else None
        if self.style == "analog":
            self.analog = AnalogClock(self.slides, self.formats)

    def pixbuf(self, path, w, h):
        key = (path, w, h)
        if key not in self.images:
            try:
                src = GdkPixbuf.Pixbuf.new_from_file(path)
                scale = max(w / src.get_width(), h / src.get_height())
                sw, sh = int(src.get_width() * scale) + 1, int(src.get_height() * scale) + 1
                self.images = {k: v for k, v in self.images.items() if k[1:] == (w, h)}  # stara velikost pryc
                self.images[key] = (src.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR), sw, sh)
            except GLib.Error:
                self.images[key] = None
        return self.images[key]

    def invalidate(self, burst=FULL_BURST):
        """Obsah okna nelze brat za platny (odkryti, navrat od dialogu s heslem, mezera v kresleni):
        nekolik pristich snimku cele obrazovky."""
        self.full_until = max(getattr(self, "full_until", 0.0), time.monotonic() + burst)

    def dirty(self, w, h):
        """Obdelnik (x, y, sirka, vyska), ktery se zmenil od posledniho snimku; None = cela obrazovka."""
        now = time.monotonic()
        if now < getattr(self, "full_until", 0.0):
            return None
        if now - getattr(self, "full_at", -FULL_EVERY) >= FULL_EVERY:
            return None             # pojistka: obcas cela obrazovka, nikdy jen stary obsah okna
        if self.style == "analog":
            return self.analog.dirty(w, h, time.monotonic() - self.start)
        return None

    def draw(self, cr, w, h, full=True):
        if full:
            self.full_at = time.monotonic()
        t = time.monotonic() - self.start
        if self.style == "analog":
            self.analog.draw(cr, w, h, t)
            return
        if self.style in ("clock", "blank"):
            cr.set_source_rgb(0, 0, 0)
        else:
            cr.set_source_rgb(0.04, 0.04, 0.08)
        cr.paint()
        if self.style == "desktop":
            # tapeta stoji (stejna jako na plose), jen hodiny - jako klid luxos-greeter
            if self.frame is None or self.frame[1:] != (w, h):
                surf = cairo.ImageSurface(cairo.FORMAT_RGB24, max(1, w), max(1, h))
                c = cairo.Context(surf)
                self.paint_wall(c, self.slides[0], w, h, 1.0, None)
                c.set_source_rgba(0, 0, 0, 0.10)
                c.paint()
                self.frame = (surf, w, h)
                self.images = {}
            cr.set_source_surface(self.frame[0], 0, 0)
            cr.paint()
            self.greeter_clock(cr, w, h)
        elif self.style in ("wallpapers", "photos"):
            if self.slides:
                idx = int(t // SLIDE)
                phase = t - idx * SLIDE
                self.paint_wall(cr, self.slides[idx % len(self.slides)], w, h, 1.0, t)
                if phase > SLIDE - FADE:
                    alpha = (phase - (SLIDE - FADE)) / FADE
                    self.paint_wall(cr, self.slides[(idx + 1) % len(self.slides)], w, h, alpha, t)
            # ztmaveni pro citelnost hodin
            cr.set_source_rgba(0, 0, 0, 0.28)
            cr.paint()
            self.clock(cr, w, h)
        elif self.style == "clock":
            # pomaly posun, aby se hodiny nevypalily do displeje
            dx = math.sin(t / 47 + self.phase) * w * 0.18
            dy = math.cos(t / 61 + self.phase) * h * 0.14
            cr.translate(dx, dy + h * 0.12)
            self.clock(cr, w, h, alpha=0.9)
        elif self.style == "aurora":
            self.aurora(cr, w, h, t)
            self.clock(cr, w, h, alpha=0.75)
        elif self.style == "logo":
            self.floating_logo(cr, w, h, t)
        # "blank": jen cerna (nahled volby Cerna obrazovka)

    def aurora(self, cr, w, h, t):
        """Barevna svetla v nizkem rozliseni (levne i na 4K), roztazena pres obrazovku."""
        sw, sh = 96, max(54, int(96 * h / max(w, 1)))
        surf = cairo.ImageSurface(cairo.FORMAT_RGB24, sw, sh)
        c = cairo.Context(surf)
        c.set_source_rgb(0.03, 0.02, 0.09)
        c.paint()
        blobs = ((0.36, 0.30, 1.00), (0.75, 0.25, 0.95), (0.15, 0.65, 0.95), (0.95, 0.35, 0.60))
        for i, (r, g, b) in enumerate(blobs):
            x = sw * (0.5 + 0.42 * math.sin(t / (23 + i * 7) + i * 1.7 + self.phase))
            y = sh * (0.5 + 0.40 * math.cos(t / (29 + i * 5) + i * 2.3 + self.phase))
            rad = sw * (0.38 + 0.12 * math.sin(t / 17 + i))
            g_ = cairo.RadialGradient(x, y, 0, x, y, rad)
            g_.add_color_stop_rgba(0, r, g, b, 0.85)
            g_.add_color_stop_rgba(1, r, g, b, 0)
            c.set_source(g_)
            c.set_operator(cairo.OPERATOR_ADD)
            c.paint()
        cr.save()
        cr.scale(w / sw, h / sh)
        cr.set_source_surface(surf, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()

    def floating_logo(self, cr, w, h, t):
        if self.logo is None:
            try:
                size = int(h * 0.16)
                self.logo = GdkPixbuf.Pixbuf.new_from_file_at_size(LOGO, size, size)
            except GLib.Error:
                self.logo = False
        if not self.logo:
            return
        lw, lh = self.logo.get_width(), self.logo.get_height()
        # odraz od okraju (trojuhelnikova vlna)
        def bounce(v, span):
            v = v % (2 * span)
            return v if v < span else 2 * span - v
        x = bounce(t * w * 0.035 + self.phase * 97, max(w - lw, 1))
        y = bounce(t * h * 0.045 + self.phase * 53, max(h - lh, 1))
        Gdk.cairo_set_source_pixbuf(cr, self.logo, x, y)
        cr.paint_with_alpha(0.9)

    def paint_wall(self, cr, path, w, h, alpha, t):
        if t is None:      # bez pohybu, vystredene (jako tapeta plochy "Zvetsit" a luxos-greeter)
            try:
                src = GdkPixbuf.Pixbuf.new_from_file(path)
            except GLib.Error:
                return
            sc = max(w / src.get_width(), h / src.get_height())
            tw, th = max(1, round(src.get_width() * sc)), max(1, round(src.get_height() * sc))
            Gdk.cairo_set_source_pixbuf(cr, src.scale_simple(tw, th, GdkPixbuf.InterpType.BILINEAR),
                                        (w - tw) / 2, (h - th) / 2)
            cr.paint_with_alpha(alpha)
            return
        img = self.pixbuf(path, w, h)
        if not img:
            return
        pix, sw, sh = img
        # pomaly pohyb (Ken Burns) po zbyle plose obrazku
        dx = (sw - w) * (0.5 + 0.5 * math.sin(t / 37))
        dy = (sh - h) * (0.5 + 0.5 * math.cos(t / 53))
        Gdk.cairo_set_source_pixbuf(cr, pix, -dx, -dy)
        cr.paint_with_alpha(alpha)

    def greeter_clock(self, cr, w, h):
        """Datum a velke tenke hodiny presne jako luxos-greeter v klidu (draw_bg, t = 0)."""
        font, clock_fmt, date_fmt = self.formats
        u = max(0.55, h / 1080.0)
        now = time.localtime()
        try:
            clock, date = time.strftime(clock_fmt, now), time.strftime(date_fmt, now)
        except ValueError:
            clock, date = time.strftime("%H:%M", now), time.strftime("%x", now)
        y0 = h * 0.105
        dl = text_layout(cr, date, 27 * u, Pango.Weight.SEMIBOLD, font)
        _ink, logi = dl.get_pixel_extents()
        shadow_text(cr, dl, w / 2 - logi.width / 2, y0, 0.92, 2 * u)
        cl = text_layout(cr, clock, 180 * u, Pango.Weight.ULTRALIGHT, font)
        ink, _l = cl.get_pixel_extents()
        shadow_text(cr, cl, w / 2 - ink.x - ink.width / 2, y0 + logi.height + 14 * u - ink.y, 1.0, 4 * u)

    def clock(self, cr, w, h, alpha=0.95):
        now = time.localtime()
        hh = time.strftime("%H:%M", now)
        day = time.strftime("%A %-d. %B", now)
        size = max(48, h * 0.16)
        cr.select_font_face("Inter", 0, 1)
        cr.set_font_size(size)
        ext = cr.text_extents(hh)
        x, y = w / 2 - ext.x_advance / 2, h * 0.30
        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.move_to(x + 2, y + 3)
        cr.show_text(hh)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.move_to(x, y)
        cr.show_text(hh)
        cr.select_font_face("Inter", 0, 0)
        cr.set_font_size(max(16, size * 0.18))
        ext = cr.text_extents(day)
        cr.set_source_rgba(1, 1, 1, 0.85)
        cr.move_to(w / 2 - ext.x_advance / 2, y + size * 0.42)
        cr.show_text(day)


_DPMS = {"at": -10.0, "on": True}


def screen_on():
    """Monitor neni vypnuty (DPMS); dotaz nejvys jednou za 2 s, bez DPMS vzdy zapnuty."""
    now = time.monotonic()
    if now - _DPMS["at"] < 2.0:
        return _DPMS["on"]
    _DPMS["at"] = now
    try:
        if "ext" not in _DPMS:
            import ctypes
            x = ctypes.CDLL("libX11.so.6")
            ext = ctypes.CDLL("libXext.so.6")
            x.XOpenDisplay.restype = ctypes.c_void_p
            x.XOpenDisplay.argtypes = [ctypes.c_char_p]
            ext.DPMSQueryExtension.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
            ext.DPMSCapable.argtypes = [ctypes.c_void_p]
            ext.DPMSInfo.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ushort), ctypes.POINTER(ctypes.c_ubyte)]
            dpy = x.XOpenDisplay(None)
            a, b = ctypes.c_int(), ctypes.c_int()
            ok = bool(dpy) and ext.DPMSQueryExtension(dpy, ctypes.byref(a), ctypes.byref(b)) and ext.DPMSCapable(dpy)
            _DPMS.update(ctypes=ctypes, ext=ext, dpy=dpy, capable=ok)
        ct, ext, dpy = _DPMS["ctypes"], _DPMS["ext"], _DPMS["dpy"]
        if not _DPMS["capable"]:
            _DPMS["on"] = True
        else:
            level, state = ct.c_ushort(0), ct.c_ubyte(0)
            ext.DPMSInfo(dpy, ct.byref(level), ct.byref(state))
            _DPMS["on"] = not state.value or level.value == 0      # DPMSModeOn
    except (OSError, AttributeError):
        _DPMS["on"] = True
    return _DPMS["on"]


def appearance_dark():
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(cfg, "luxos", "appearance"), encoding="utf-8") as f:
            return f.read().strip() == "dark"
    except OSError:
        return False


class AnalogClock:
    """Tapety LuxOS s prolinanim a velke klasicke rucickove hodiny s datem.

    Tapety jsou predpocitane obrazky velikosti obrazovky (dalsi se pripravi ve vlakne, aby se
    vterinova rucicka nezastavila); mimo prolinani se prekresluje jen ctverec s hodinami.
    Ciselnik (stin, kotouc, rysky, cislice) je predkresleny; svetly nebo tmavy podle vzhledu LuxOS."""

    def __init__(self, slides, formats):
        self.slides = list(slides) or [None]
        self.offset = random.randrange(len(self.slides))
        self.formats = formats
        self.walls = {}             # (index, w, h) -> ImageSurface
        self.loading = set()
        self.lock = threading.Lock()
        self.face = None            # ((dark, w, h), surface, x, y)
        self.dark = appearance_dark()
        self.dark_at = time.monotonic()
        self.full = True            # pristi snimek cely (prvni, zmena vzhledu)
        self.drawn = None           # (tapeta, prolinani, den, tmavy) posledniho snimku

    # -- rozmery --
    def geometry(self, w, h):
        r = min(h * 0.235, w * 0.36)
        return w / 2.0, h * 0.44, r

    def box(self, w, h):
        cx, cy, r = self.geometry(w, h)
        m = r * 1.12                # i se stinem
        x, y = max(0, int(cx - m)), max(0, int(cy - m))
        return (x, y, min(w - x, int(2 * m) + 2), min(h - y, int(2 * m) + 2))

    def slide(self, t):
        n = len(self.slides)
        k = int(t // ANALOG_SLIDE)
        phase = t - k * ANALOG_SLIDE
        fade = max(0.0, (phase - (ANALOG_SLIDE - ANALOG_FADE)) / ANALOG_FADE) if n > 1 else 0.0
        return (k + self.offset) % n, fade

    def dirty(self, w, h, t):
        idx, fade = self.slide(t)
        if time.monotonic() - self.dark_at > 60:
            self.dark_at = time.monotonic()
            dark = appearance_dark()
            if dark != self.dark:
                self.dark, self.full = dark, True
        state = (idx, fade > 0, time.localtime().tm_yday, self.dark)
        with self.lock:
            have = (idx, w, h) in self.walls
        if self.full or fade > 0 or state != self.drawn or not have:
            return None
        return self.box(w, h)

    # -- tapety --
    def render_wall(self, idx, w, h):
        surf = cairo.ImageSurface(cairo.FORMAT_RGB24, max(1, w), max(1, h))
        cr = cairo.Context(surf)
        cr.set_source_rgb(0.05, 0.05, 0.09)
        cr.paint()
        path = self.slides[idx]
        try:
            src = GdkPixbuf.Pixbuf.new_from_file(path) if path else None
        except GLib.Error:
            src = None
        if src is not None:
            sc = max(w / src.get_width(), h / src.get_height())
            tw, th = max(1, round(src.get_width() * sc)), max(1, round(src.get_height() * sc))
            Gdk.cairo_set_source_pixbuf(cr, src.scale_simple(tw, th, GdkPixbuf.InterpType.BILINEAR),
                                        (w - tw) / 2, (h - th) / 2)
            cr.paint()
        cr.set_source_rgba(0, 0, 0, 0.16)       # citelnost hodin a data
        cr.paint()
        surf.flush()
        return surf

    def wall(self, idx, w, h, wait):
        key = (idx, w, h)
        with self.lock:
            if key in self.walls:
                return self.walls[key]
            if not wait:
                if key not in self.loading:
                    self.loading.add(key)
                    threading.Thread(target=self._load, args=key, daemon=True).start()
                return None
        surf = self.render_wall(idx, w, h)
        with self.lock:
            self.walls[key] = surf
        return surf

    def _load(self, idx, w, h):
        surf = self.render_wall(idx, w, h)
        with self.lock:
            self.walls[(idx, w, h)] = surf
            self.loading.discard((idx, w, h))

    def keep(self, keys):
        with self.lock:
            self.walls = {k: v for k, v in self.walls.items() if k in keys}

    # -- ciselnik a rucicky --
    def colors(self):
        if self.dark:
            return {"face": (0.10, 0.10, 0.13, 0.62), "rim": (1, 1, 1, 0.16), "ink": (0.96, 0.96, 0.98),
                    "minor": (1, 1, 1, 0.38), "shadow": 0.45}
        return {"face": (1, 1, 1, 0.80), "rim": (1, 1, 1, 0.9), "ink": (0.11, 0.11, 0.13),
                "minor": (0.11, 0.11, 0.13, 0.42), "shadow": 0.30}

    def face_surface(self, w, h):
        key = (self.dark, w, h)
        if self.face and self.face[0] == key:
            return self.face[1:]
        bx, by, bw, bh = self.box(w, h)
        cx, cy, r = self.geometry(w, h)
        c = self.colors()
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, max(1, bw), max(1, bh))
        cr = cairo.Context(surf)
        cr.translate(cx - bx, cy - by)
        for i in range(10, 0, -1):              # mekky stin pod kotoucem
            cr.arc(0, r * 0.025, r * (1.0 + i * 0.009), 0, 2 * math.pi)
            cr.set_source_rgba(0, 0, 0, c["shadow"] * 0.035)
            cr.fill()
        cr.arc(0, 0, r, 0, 2 * math.pi)
        cr.set_source_rgba(*c["face"])
        cr.fill_preserve()
        cr.set_line_width(max(1.0, r * 0.012))
        cr.set_source_rgba(*c["rim"])
        cr.stroke()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for i in range(60):
            a = i * math.pi / 30
            hour = i % 5 == 0
            r0 = r * (0.83 if hour else 0.89)
            cr.move_to(math.sin(a) * r0, -math.cos(a) * r0)
            cr.line_to(math.sin(a) * r * 0.93, -math.cos(a) * r * 0.93)
            cr.set_line_width(r * (0.022 if hour else 0.008))
            if hour:
                cr.set_source_rgb(*c["ink"])
            else:
                cr.set_source_rgba(*c["minor"])
            cr.stroke()
        font = self.formats[0] if self.formats else "Inter"
        for n in range(1, 13):
            a = n * math.pi / 6
            lay = text_layout(cr, str(n), r * 0.13, Pango.Weight.LIGHT, font)
            ink, _l = lay.get_pixel_extents()
            x, y = math.sin(a) * r * 0.70, -math.cos(a) * r * 0.70
            cr.move_to(x - ink.x - ink.width / 2, y - ink.y - ink.height / 2)
            cr.set_source_rgb(*c["ink"])
            PangoCairo.show_layout(cr, lay)
        surf.flush()
        self.face = (key, surf, bx, by)
        return surf, bx, by

    @staticmethod
    def hand(cr, angle, length, tail, width, rgb, shadow):
        cr.save()
        cr.rotate(angle)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(width)
        cr.move_to(width * 0.15, tail + width * 0.35)      # stin vpravo dole
        cr.line_to(width * 0.15, -length + width * 0.35)
        cr.set_source_rgba(0, 0, 0, shadow)
        cr.stroke()
        cr.move_to(0, tail)
        cr.line_to(0, -length)
        cr.set_source_rgb(*rgb)
        cr.stroke()
        cr.restore()

    def draw_hands(self, cr, w, h, now=None):
        cx, cy, r = self.geometry(w, h)
        c = self.colors()
        now = time.time() if now is None else now
        lt = time.localtime(now)
        sec = lt.tm_sec + (now % 1.0)
        mins = lt.tm_min + sec / 60.0
        hrs = (lt.tm_hour % 12) + mins / 60.0
        accent = (1.0, 0.42, 0.21)
        cr.save()
        cr.translate(cx, cy)
        self.hand(cr, hrs * math.pi / 6, r * 0.50, r * 0.08, r * 0.055, c["ink"], 0.18)
        self.hand(cr, mins * math.pi / 30, r * 0.76, r * 0.10, r * 0.038, c["ink"], 0.18)
        self.hand(cr, sec * math.pi / 30, r * 0.86, r * 0.20, r * 0.012, accent, 0.15)
        cr.arc(0, 0, r * 0.035, 0, 2 * math.pi)
        cr.set_source_rgb(*accent)
        cr.fill()
        cr.arc(0, 0, r * 0.012, 0, 2 * math.pi)
        cr.set_source_rgb(*c["ink"])
        cr.fill()
        cr.restore()

    def draw_date(self, cr, w, h):
        cx, cy, r = self.geometry(w, h)
        font, fmt = (self.formats[0], self.formats[2]) if self.formats else ("Inter", "%A, %B %-d")
        try:
            date = time.strftime(fmt, time.localtime())
        except ValueError:
            date = time.strftime("%x")
        u = max(0.55, h / 1080.0)
        lay = text_layout(cr, date, 30 * u, Pango.Weight.SEMIBOLD, font)
        _ink, logi = lay.get_pixel_extents()
        shadow_text(cr, lay, cx - logi.width / 2, cy + r * 1.16, 0.95, 2.5 * u)

    def draw(self, cr, w, h, t):
        idx, fade = self.slide(t)
        n = len(self.slides)
        nxt_idx = (idx + 1) % n
        cur = self.wall(idx, w, h, wait=True)
        # dalsi tapetu pripravit vcas na pozadi (nacteni velke tapety trva i stovky ms)
        nxt = self.wall(nxt_idx, w, h, wait=False) if n > 1 else None
        self.keep({(idx, w, h), (nxt_idx, w, h)})
        cr.set_source_surface(cur, 0, 0)
        cr.paint()
        if fade > 0 and nxt is not None:
            cr.set_source_surface(nxt, 0, 0)
            cr.paint_with_alpha(fade * fade * (3 - 2 * fade))
        face, bx, by = self.face_surface(w, h)
        cr.set_source_surface(face, bx, by)
        cr.paint()
        self.draw_hands(cr, w, h)
        self.draw_date(cr, w, h)
        self.full = False
        self.drawn = (idx, fade > 0, time.localtime().tm_yday, self.dark)


def fps(saver):
    # stojici tapeta s hodinami staci jednou za sekundu (setri procesor)
    if saver.style == "analog":
        return ANALOG_FPS
    return 1 if saver.style == "desktop" else FPS


def run_foreign(xid, style):
    """Kresleni do okna, ktere vytvoril xfce4-screensaver (jedno okno na monitor)."""
    gi.require_version("GdkX11", "3.0")
    from gi.repository import GdkX11
    display = Gdk.Display.get_default()
    win = GdkX11.X11Window.foreign_new_for_display(display, xid)
    if win is None:
        sys.exit(1)
    mon = display.get_monitor_at_window(win)
    saver = Saver(style, mon.get_model() if mon else None)
    interval = 1.0 / fps(saver)
    last = {"tick": time.monotonic(), "viewable": True}

    def tick():
        now = time.monotonic()
        # mezera (xfce4-screensaver nas pri dialogu s heslem pozastavi) = obsah okna neplati
        if now - last["tick"] > 3 * interval + 0.2:
            saver.invalidate()
        last["tick"] = now
        viewable = win.is_viewable()
        if viewable and not last["viewable"]:
            saver.invalidate()
        last["viewable"] = viewable
        if not viewable or not screen_on():
            return True             # skryte okno / monitor vypnuty (DPMS): nekreslit
        w, h = win.get_width(), win.get_height()
        region = win.get_visible_region()
        box = saver.dirty(w, h)
        if box is not None:
            region.intersect(cairo.Region(cairo.RectangleInt(*box)))
        if region.is_empty():
            return True
        ctx = win.begin_draw_frame(region)
        saver.draw(ctx.get_cairo_context(), w, h, full=box is None)
        win.end_draw_frame(ctx)
        return True

    def on_event(ev, *_a):
        # odkryti, namapovani, zmena velikosti nebo viditelnosti naseho okna: hned cela obrazovka
        if ev.get_window() == win and ev.type in (Gdk.EventType.EXPOSE, Gdk.EventType.MAP, Gdk.EventType.CONFIGURE,
                                                  Gdk.EventType.VISIBILITY_NOTIFY):
            saver.invalidate()
            GLib.idle_add(lambda: tick() and False)

    win.set_events(win.get_events() | Gdk.EventMask.EXPOSURE_MASK | Gdk.EventMask.STRUCTURE_MASK
                   | Gdk.EventMask.VISIBILITY_NOTIFY_MASK)
    Gdk.event_handler_set(on_event)
    GLib.timeout_add(int(1000 / fps(saver)), tick)
    tick()
    Gtk.main()


def run_window(saver, fullscreen):
    win = Gtk.Window(title="LuxOS")
    area = Gtk.DrawingArea()
    area.connect("draw", lambda wid, cr: saver.draw(cr, wid.get_allocated_width(), wid.get_allocated_height()))
    win.add(area)
    win.set_default_size(640, 400)
    if fullscreen:
        win.fullscreen()
        win.connect("key-press-event", lambda *_a: Gtk.main_quit())
        win.connect("button-press-event", lambda *_a: Gtk.main_quit())
    win.connect("destroy", Gtk.main_quit)
    GLib.timeout_add(int(1000 / fps(saver)), lambda: area.queue_draw() or True)
    win.show_all()
    Gtk.main()


def main():
    style = "desktop"
    if "--style" in sys.argv[:-1]:
        style = sys.argv[sys.argv.index("--style") + 1]
    xid = os.environ.get("XSCREENSAVER_WINDOW")
    if xid and "--window" not in sys.argv:
        run_foreign(int(xid, 0), style)
    else:
        run_window(Saver(style), "--window" in sys.argv)


if __name__ == "__main__":
    main()
