# LuxOS - server oznameni relace na Waylandu (luxos-notify). Zapina ho relace Wayland (WP-13), ne X11:
# tam oznameni dal obstarava xfce4-notifyd. Restart jako u xfce4-notifyd (luxos-restart.conf): earlyoom
# posila SIGTERM a aplikace se synchronnim Notify by jinak zamrzaly na 25 s.
[Unit]
Description=LuxOS notifications
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/lib/luxos/luxos-notify
Restart=on-abnormal
RestartForceExitStatus=SIGTERM
RestartSec=2
