# LuxOS - agent polkitu relace na Waylandu (luxos-polkit, LSL): okno s heslem, kdyz program zada o opravneni
# spravce. Spousti ho luxos-session.target (Wants=). Kod 2 = nema smysl spoustet znovu (bez systemove sbernice,
# bez relace logindu nebo uz je zaregistrovany jiny agent); jine pady systemd hned opravi.
[Unit]
Description=LuxOS authentication agent
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/lib/luxos/luxos-polkit
Restart=on-failure
RestartSec=500ms
RestartPreventExitStatus=2
# pojistka proti uniku pameti (necinny agent ~2.5 MB PSS, po prvnim okne s GTK ~16 MB)
MemoryHigh=64M
Slice=session.slice
