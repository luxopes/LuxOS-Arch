# LuxOS - prepinac oken Alt+Tab na Waylandu (luxos-switcher, LSL). Overlay se ukazuje pri Alt+Tab
# a skryva pri pusteni Alt. Spousti ho luxos-session.target.
[Unit]
Description=LuxOS window switcher
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/lib/luxos/luxos-switcher
Restart=always
RestartSec=200ms
RestartPreventExitStatus=2
MemoryHigh=48M
Slice=session.slice
