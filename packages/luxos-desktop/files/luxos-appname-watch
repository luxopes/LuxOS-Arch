#!/bin/bash
# LuxOS - sledovani aktivniho okna pro nazev aplikace v horni liste (spousti luxos-appname watch)
#
# Sleduje aktivni okno (xprop -spy, bez pravidelneho dotazovani), nazev aplikace zapise do
# $XDG_RUNTIME_DIR/luxos-appname a obnovi plugin genmon v panelu; vystup pluginu dela luxos-appname
# (LSL) - ten se spousti pri kazdem prepnuti okna, tento skript bezi po celou relaci jednou.
. /usr/lib/luxos/i18n.sh
state="${XDG_RUNTIME_DIR:-/tmp}/luxos-appname"
PLUGIN=genmon-2

# Kratke nazvy pro aplikace, jejichz Name= je zbytecne dlouhe
declare -A SHORT=(
    [thunar]=Files [luxos-terminal]=Terminal [xfce4-terminal]=Terminal
    [org.xfce.mousepad]="Text Editor" [mousepad]="Text Editor"
    [xfce4-settings-manager]=Settings [xfdesktop]=Desktop [org.xfce.ristretto]="Image Viewer" [ristretto]="Image Viewer"
    [org.gnome.evince]="Document Viewer" [evince]="Document Viewer" [xfce4-taskmanager]="System Monitor"
    [yad]=LuxOS [luxos-calendar]=Calendar [luxos-control-center]="Control Center"
    [luxos-whats-new]="What's New" [luxos-screenshot]=Screenshot
)

exec 9>"$state.lock"
flock -n 9 || exit 0     # jen jedna instance na uzivatele
declare -A cache=()
lang=${LANG%%.*}

resolve() {  # resolve <instance> <class> -> nazev aplikace
    local inst=${1,,} cls=${2,,} key f n
    key="$inst/$cls"
    [[ -n ${cache[$key]-} ]] && { echo "${cache[$key]}"; return; }
    for n in "$inst" "$cls"; do
        [[ -n ${SHORT[$n]-} ]] && { cache[$key]=$(T "${SHORT[$n]}"); echo "${cache[$key]}"; return; }
    done
    f=$(grep -lisE "^StartupWMClass=($inst|$cls)$" /usr/share/applications/*.desktop 2>/dev/null | head -1)
    if [[ -z $f ]]; then
        for n in "$inst" "$cls"; do
            for f in /usr/share/applications/{,*.}"$n".desktop; do [[ -e $f ]] && break 2; done
            f=""
        done
    fi
    # Prejmenovane aplikace LuxOS (luxos-apps-sync) maji prednost
    [[ -n $f && -e /var/lib/luxos/apps/applications/${f##*/} ]] && f=/var/lib/luxos/apps/applications/${f##*/}
    n=""
    if [[ -n $f ]]; then
        # Name[cs_CZ], pak Name[cs]
        n=$(grep -m1 "^Name\[$lang\]=" "$f" | cut -d= -f2-)
        [[ -z $n ]] && n=$(grep -m1 "^Name\[${lang%%_*}\]=" "$f" | cut -d= -f2-)
        [[ -z $n ]] && n=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    fi
    [[ -z $n ]] && n=${2:-$1}
    cache[$key]=$n
    echo "$n"
}

# Ostra ikona pro Alt+Tab (luxos_wm_icon.py) pri kazde aktivaci okna, na pozadi: GTK ikonu okna
# pozdeji nastavuje znovu (jen do 48 px) a velke velikosti by zmizely; skript nic nedela, kdyz
# okno uz ma ikonu aspon 96 px. Pri rychlem prepinani se nespousti vic najednou pro stejne okno.
WM_ICON=/usr/lib/luxos/python/luxos_wm_icon.py
declare -A icon_pid=()

last=""
xprop -root -spy _NET_ACTIVE_WINDOW 2>/dev/null | while read -r line; do
    # Format: "_NET_ACTIVE_WINDOW(WINDOW): window id # 0x3000003, 0x0"
    win=""
    [[ $line =~ \#\ (0x[0-9a-fA-F]+) ]] && win=${BASH_REMATCH[1]}
    name=""
    if [[ -n $win && $win != 0x0 ]]; then
        wmclass=$(xprop -id "$win" WM_CLASS 2>/dev/null)
        if [[ $wmclass =~ \"([^\"]*)\",\ \"([^\"]*)\" ]]; then
            # Nabidky horni listy (Whisker Menu, kalendar) nemeni nazev aplikace
            [[ ${BASH_REMATCH[1]} == @(xfce4-panel|wrapper-2.0) ]] && continue
            name=$(resolve "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")
            if [[ -r $WM_ICON ]] && ! { [[ -n ${icon_pid[$win]-} ]] && kill -0 "${icon_pid[$win]}" 2>/dev/null; }; then
                python3 -I "$WM_ICON" "$win" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" </dev/null >/dev/null 2>&1 &
                icon_pid[$win]=$!
            fi
        fi
    fi
    [[ -z $name ]] && name=$(T "Desktop")
    if [[ $name != "$last" ]]; then
        printf '%s' "$name" > "$state"
        # Primo pres D-Bus: "xfce4-panel --plugin-event" ukaze chybovy dialog,
        # pokud panel jeste nebezi (zacatek relace)
        timeout 2 gdbus call --session --dest org.xfce.Panel --object-path /org/xfce/Panel \
            --method org.xfce.Panel.PluginEvent "$PLUGIN" refresh '<true>' >/dev/null 2>&1
        last=$name
    fi
done
