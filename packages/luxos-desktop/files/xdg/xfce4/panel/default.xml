<?xml version="1.0" encoding="UTF-8"?>
<!-- LuxOS: horni lista ve stylu macOS (menu, nazev okna, ... , ikony, hodiny) -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="double" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="28"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="mode" type="uint" value="0"/>
      <property name="enable-struts" type="bool" value="true"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.09"/>
        <value type="double" value="0.09"/>
        <value type="double" value="0.12"/>
        <value type="double" value="0.62"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="10"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="luxos-logo-symbolic"/>
      <property name="show-button-title" type="bool" value="false"/>
      <property name="show-button-icon" type="bool" value="true"/>
      <!-- Vzhled LuxOS (upraveny xfce4-whiskermenu-plugin): nahore fotka a hledani, dole lista
           Zamknout obrazovku / Restartovat / Uspat / Vypnout s popisky (commands-alternate=false),
           Odhlasit v zahlavi. menu-opacity < 100 = pruhledne zaoblene rohy (styl v luxos.css). -->
      <property name="menu-width" type="int" value="480"/>
      <property name="menu-height" type="int" value="640"/>
      <property name="menu-opacity" type="int" value="96"/>
      <property name="position-search-alternate" type="bool" value="false"/>
      <property name="position-commands-alternate" type="bool" value="false"/>
      <property name="position-profile-alternate" type="bool" value="false"/>
      <property name="profile-shape" type="int" value="0"/>
      <property name="launcher-icon-size" type="int" value="2"/>
      <property name="category-icon-size" type="int" value="1"/>
      <!-- Kategorie "Chromium Apps" (aplikace z Chromia) slouci do Internetu -->
      <property name="custom-menu-file" type="string" value="/etc/xdg/luxos/menus/luxos-applications.menu"/>
      <property name="launcher-show-description" type="bool" value="false"/>
      <property name="show-command-menueditor" type="bool" value="false"/>
      <property name="show-command-lockscreen" type="bool" value="true"/>
      <property name="show-command-shutdown" type="bool" value="true"/>
      <property name="show-command-restart" type="bool" value="true"/>
      <property name="show-command-suspend" type="bool" value="true"/>
      <property name="show-command-logout" type="bool" value="true"/>
      <property name="show-command-switchuser" type="bool" value="false"/>
      <property name="command-lockscreen" type="string" value="xflock4"/>
      <property name="command-settings" type="string" value="xfce4-settings-manager"/>
      <property name="favorites" type="array">
        <value type="string" value="luxos-about.desktop"/>
        <value type="string" value="firefox.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="org.xfce.mousepad.desktop"/>
        <value type="string" value="luxos-welcome.desktop"/>
        <value type="string" value="xfce-settings-manager.desktop"/>
      </property>
    </property>
    <property name="plugin-2" type="string" value="genmon">
      <property name="command" type="string" value="luxos-appname print"/>
      <property name="update-period" type="int" value="86400000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
      <property name="font" type="string" value="Inter Bold 10"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="systray">
      <property name="square-icons" type="bool" value="false"/>
      <property name="icon-size" type="int" value="16"/>
      <property name="single-row" type="bool" value="true"/>
      <property name="symbolic-icons" type="bool" value="true"/>
    </property>
    <property name="plugin-5" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications" type="bool" value="true"/>
      <property name="mixer-command" type="string" value="pavucontrol"/>
    </property>
    <property name="plugin-6" type="string" value="power-manager-plugin"/>
    <!-- Lupa: Hledani (jako Super+Mezernik) -->
    <property name="plugin-10" type="string" value="genmon">
      <property name="command" type="string" value="luxos-search --panel"/>
      <property name="update-period" type="int" value="86400000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
    </property>
    <property name="plugin-7" type="string" value="notification-plugin"/>
    <!-- Hodiny (genmon misto pluginu clock, ten neumi spustit prikaz): klik = Kalendar -->
    <property name="plugin-8" type="string" value="genmon">
      <property name="command" type="string" value="luxos-clock"/>
      <property name="update-period" type="int" value="3000"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="enable-single-row" type="bool" value="true"/>
      <property name="font" type="string" value="Inter Semi-Bold 10"/>
    </property>
    <property name="plugin-9" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
  </property>
</channel>
