#
# LuxOS - vychozi aplikace pro exo-open (Soubory: "Otevrit terminal zde", odkazy, posta)
# Vlastni volba uzivatele: ~/.config/xfce4/helpers.rc
#
WebBrowser=firefox
# posta: aplikace pro mailto (vlastni volba, Thunderbird, LuxOS Mail), bez ni Obchod (luxos-mail-reader)
MailReader=luxos-mail-reader
TerminalEmulator=luxos-terminal
FileManager=thunar
