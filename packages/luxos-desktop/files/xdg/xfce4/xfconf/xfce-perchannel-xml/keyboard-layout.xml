<?xml version="1.0" encoding="UTF-8"?>
<!-- LuxOS: rozlozeni klavesnice ze systemu (/etc/X11/xorg.conf.d/00-keyboard.conf, aplikace Klavesnice),
     ne vlastni rozlozeni kazdeho uzivatele - novi uzivatele i prihlasovaci obrazovka maji stejne -->
<channel name="keyboard-layout" version="1.0">
  <property name="Default" type="empty">
    <property name="XkbDisable" type="bool" value="true"/>
  </property>
</channel>
