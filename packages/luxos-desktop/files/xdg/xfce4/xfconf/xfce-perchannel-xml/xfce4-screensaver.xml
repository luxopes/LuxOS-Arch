<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-screensaver" version="1.0">
  <property name="saver" type="empty">
    <!-- 2 = vybrane tema: stridajici se tapety LuxOS s hodinami (screensavers-luxos = styl wallpapers),
         viz Nastaveni > Zamykani obrazovky; uzivatel bez vlastni volby dostane tuto hodnotu i po aktualizaci -->
    <property name="mode" type="int" value="2"/>
    <property name="themes" type="empty">
      <property name="list" type="array">
        <value type="string" value="screensavers-luxos"/>
      </property>
    </property>
    <property name="idle-activation" type="empty">
      <property name="enabled" type="bool" value="true"/>
      <property name="delay" type="int" value="10"/>
    </property>
  </property>
  <property name="lock" type="empty">
    <property name="enabled" type="bool" value="true"/>
    <!-- Heslo hned po spusteni sporice (0 min): s 1 minutou sporic po Enteru pustil na plochu bez hesla -->
    <property name="saver-activation" type="empty">
      <property name="enabled" type="bool" value="true"/>
      <property name="delay" type="int" value="0"/>
    </property>
    <property name="sleep-activation" type="bool" value="true"/>
  </property>
</channel>
