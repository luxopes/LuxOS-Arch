# LuxOS - vychozi aplikace pro typy souboru (/etc/xdg/luxos je v XDG_CONFIG_DIRS pred /etc/xdg).
# Plati pro nove i stavajici uzivatele, dokud si v ~/.config/mimeapps.list nezvoli jinou aplikaci.
# Textovy editor LuxOS (luxos-text) misto Mousepadu; HTML nechava prohlizeci (luxos-new-user-defaults).
# PDF, obrazky a archivy vyslovne: jinak by o aplikaci rozhodovalo poradi v mimeinfo.cache (PDF ve Firefoxu,
# ZIP v PrismLauncheru po instalaci ze Obchodu ...); aplikace, ktera neni nainstalovana, se preskoci.
[Default Applications]
text/plain=luxos-text.desktop;
application/x-zerosize=luxos-text.desktop;
text/markdown=luxos-text.desktop;
text/x-markdown=luxos-text.desktop;
text/x-python=luxos-text.desktop;
text/x-python3=luxos-text.desktop;
text/x-csrc=luxos-text.desktop;
text/x-chdr=luxos-text.desktop;
text/x-c++src=luxos-text.desktop;
text/x-c++hdr=luxos-text.desktop;
text/x-java=luxos-text.desktop;
text/x-go=luxos-text.desktop;
text/x-rust=luxos-text.desktop;
text/x-log=luxos-text.desktop;
text/x-makefile=luxos-text.desktop;
text/x-cmake=luxos-text.desktop;
text/css=luxos-text.desktop;
text/x-tex=luxos-text.desktop;
text/x-patch=luxos-text.desktop;
text/x-diff=luxos-text.desktop;
text/x-readme=luxos-text.desktop;
text/x-changelog=luxos-text.desktop;
text/x-ini-file=luxos-text.desktop;
text/x-systemd-unit=luxos-text.desktop;
application/x-shellscript=luxos-text.desktop;
text/x-shellscript=luxos-text.desktop;
application/json=luxos-text.desktop;
application/xml=luxos-text.desktop;
text/xml=luxos-text.desktop;
application/x-yaml=luxos-text.desktop;
application/toml=luxos-text.desktop;
application/javascript=luxos-text.desktop;
text/javascript=luxos-text.desktop;
application/x-perl=luxos-text.desktop;
application/x-ruby=luxos-text.desktop;
application/x-php=luxos-text.desktop;
text/x-lua=luxos-text.desktop;
text/x-lsl=luxos-text.desktop;
# Prohlizec dokumentu (evince)
application/pdf=org.gnome.Evince.desktop;
application/x-bzpdf=org.gnome.Evince.desktop;
application/x-gzpdf=org.gnome.Evince.desktop;
application/x-xzpdf=org.gnome.Evince.desktop;
application/postscript=org.gnome.Evince.desktop;
image/x-eps=org.gnome.Evince.desktop;
application/x-dvi=org.gnome.Evince.desktop;
image/vnd.djvu=org.gnome.Evince.desktop;
application/oxps=org.gnome.Evince.desktop;
application/vnd.ms-xpsdocument=org.gnome.Evince.desktop;
application/vnd.comicbook+zip=org.gnome.Evince.desktop;
application/vnd.comicbook-rar=org.gnome.Evince.desktop;
application/x-cbz=org.gnome.Evince.desktop;
application/x-cbr=org.gnome.Evince.desktop;
application/x-cb7=org.gnome.Evince.desktop;
application/x-cbt=org.gnome.Evince.desktop;
# Obrazky (ristretto)
image/png=org.xfce.ristretto.desktop;
image/jpeg=org.xfce.ristretto.desktop;
image/gif=org.xfce.ristretto.desktop;
image/webp=org.xfce.ristretto.desktop;
image/bmp=org.xfce.ristretto.desktop;
image/tiff=org.xfce.ristretto.desktop;
image/svg+xml=org.xfce.ristretto.desktop;
image/x-pixmap=org.xfce.ristretto.desktop;
image/x-xpixmap=org.xfce.ristretto.desktop;
# Kancelarske dokumenty (LibreOffice z repozitare nebo Flathubu, ONLYOFFICE). Bez nich vyhraje v mimeinfo.cache
# archivator: .docx, .xlsx i .odt jsou technicky ZIP a xarchiver je uvadi.
application/vnd.oasis.opendocument.text=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.oasis.opendocument.text-template=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.template=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/msword=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/rtf=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
text/rtf=libreoffice-writer.desktop;org.libreoffice.LibreOffice.writer.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop;org.libreoffice.LibreOffice.calc.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.oasis.opendocument.spreadsheet-template=libreoffice-calc.desktop;org.libreoffice.LibreOffice.calc.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop;org.libreoffice.LibreOffice.calc.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.template=libreoffice-calc.desktop;org.libreoffice.LibreOffice.calc.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.ms-excel=libreoffice-calc.desktop;org.libreoffice.LibreOffice.calc.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.oasis.opendocument.presentation=libreoffice-impress.desktop;org.libreoffice.LibreOffice.impress.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.oasis.opendocument.presentation-template=libreoffice-impress.desktop;org.libreoffice.LibreOffice.impress.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=libreoffice-impress.desktop;org.libreoffice.LibreOffice.impress.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.presentationml.slideshow=libreoffice-impress.desktop;org.libreoffice.LibreOffice.impress.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
application/vnd.ms-powerpoint=libreoffice-impress.desktop;org.libreoffice.LibreOffice.impress.desktop;onlyoffice-desktopeditors.desktop;org.onlyoffice.desktopeditors.desktop;
# Archivy (xarchiver)
application/zip=xarchiver.desktop;
application/x-7z-compressed=xarchiver.desktop;
application/vnd.rar=xarchiver.desktop;
application/x-rar=xarchiver.desktop;
application/x-tar=xarchiver.desktop;
application/gzip=xarchiver.desktop;
application/x-compressed-tar=xarchiver.desktop;
application/x-bzip2-compressed-tar=xarchiver.desktop;
application/x-xz-compressed-tar=xarchiver.desktop;
application/x-zstd-compressed-tar=xarchiver.desktop;
application/x-xz=xarchiver.desktop;
application/zstd=xarchiver.desktop;
# Posta: Thunderbird (balik thunderbird i Flathub, stejne desktop-id). Bez nej rozhodne mimeinfo.cache
# (jina nainstalovana postovni aplikace); odkazy mailto: v Souborech jdou pres luxos-mail-reader (Obchod).
x-scheme-handler/mailto=org.mozilla.Thunderbird.desktop;
message/rfc822=org.mozilla.Thunderbird.desktop;
