[Desktop Entry]
Name=NetworkManager Applet
Comment=LuxOS: applet as StatusNotifier item (--indicator) - the top bar draws its symbolic icon in the bar text colour (an XEmbed icon kept the applet's own colour, e.g. black on a bar with white text)
Icon=nm-device-wireless
Exec=nm-applet --indicator
Terminal=false
Type=Application
NoDisplay=true
NotShowIn=KDE;GNOME;
X-GNOME-UsesNotifications=true
