#!/bin/bash
# LuxOS - jas displeje o krok nahoru/dolu (kolecko mysi nad baterii v horni liste)
#
#   luxos-brightness up|down     o 5 % (nejmene 10 %, jako posuvnik v Ovladacim centru)
#
# Ukaze stejny prubeh jako klavesy jasu (oznameni s hodnotou, dalsi krok ho nahradi).
# Bez podsviceni (stolni monitor) meni softwarovy jas jako Ovladaci centrum.
set -u
. /usr/lib/luxos/i18n.sh 2>/dev/null || T() { printf "$@"; }

STEP=5
MIN=10
backlight=${LUXOS_BACKLIGHT:-/sys/class/backlight}     # testy: falesne podsviceni

case ${1-} in
    up) sign=1 ;;
    down) sign=-1 ;;
    -h|--help) echo "$(T "Usage:") luxos-brightness up|down"; exit 0 ;;
    *) echo "$(T "Usage:") luxos-brightness up|down" >&2; exit 2 ;;
esac

# Rychle tocenim koleckem bezi vic kroku najednou: po jednom (jinak se predbihaji v cteni jasu
# a kazdy otevre vlastni oznameni)
run=${XDG_RUNTIME_DIR:-/tmp}
exec 9>"$run/luxos-brightness.lock" && flock -w 3 9

if [[ -n $(ls "$backlight" 2>/dev/null) ]]; then
    cur=$(brightnessctl get 2>/dev/null) max=$(brightnessctl max 2>/dev/null)
    [[ $cur =~ ^[0-9]+$ && $max =~ ^[0-9]+$ && $max -gt 0 ]] || exit 1
    pct=$(( (cur * 100 + max / 2) / max ))
    new=$(( pct + sign * STEP ))
    (( new < MIN )) && new=$MIN
    (( new > 100 )) && new=100
    brightnessctl -q set "$new%" || exit 1
else
    conf=${XDG_CONFIG_HOME:-$HOME/.config}/luxos
    pct=$(cat "$conf/brightness" 2>/dev/null)
    [[ $pct =~ ^[0-9]+$ ]] || pct=100
    new=$(( pct + sign * STEP ))
    (( new < MIN )) && new=$MIN
    (( new > 100 )) && new=100
    mkdir -p "$conf" && printf '%s' "$new" > "$conf/brightness"
    luxos-displays brightness "$new" >/dev/null 2>&1
fi

# -e: prechodne oznameni (jako ukazatel jasu se neuklada do historie oznameni)
# -r: nahradit predchozi oznameni jasu (xfce4-notifyd x-canonical-private-synchronous nezna,
# bez toho se pri toceni koleckem skladala jedno pod druhe)
idf=$run/luxos-brightness.notify-id
{ read -r prev <"$idf"; } 2>/dev/null
replace=()
[[ ${prev-} =~ ^[0-9]+$ ]] && replace=(-r "$prev")
id=$(notify-send -p "${replace[@]}" -a LuxOS -i display-brightness-symbolic -t 1500 -u low -e \
    -h "int:value:$new" -h string:x-canonical-private-synchronous:luxos-brightness \
    "$(T "Brightness")" "$new %" 2>/dev/null)
[[ $id =~ ^[0-9]+$ ]] && printf '%s\n' "$id" >"$idf"
exit 0
