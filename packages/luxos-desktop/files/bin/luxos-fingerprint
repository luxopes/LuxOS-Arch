#!/usr/bin/env python3
"""LuxOS - Otisk prstu: pridani a odebrani otisku pro prihlaseni, zamek, sudo a polkit.

Mluvi s fprintd pres D-Bus (net.reactivated.Fprint) - prubeh snimani ukazuje primo v okne.
Prihlasovani otiskem zapina luxos-fingerprint-pam (hook spravce baliku po instalaci fprintd).
LUXOS_FPRINT_BUS=session nebo adresa unix:...: fprintd na session / vlastni sbernici (testy s napodobenou sluzbou).
"""
import math
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

NAME = "net.reactivated.Fprint"
MANAGER = "/net/reactivated/Fprint/Manager"
IFACE_MANAGER = "net.reactivated.Fprint.Manager"
IFACE_DEVICE = "net.reactivated.Fprint.Device"
ERR = "net.reactivated.Fprint.Error."
# Sluzba fprintd se spousti pres D-Bus aktivaci - bez tohoto souboru neni nainstalovana
SERVICE_FILE = "/usr/share/dbus-1/system-services/net.reactivated.Fprint.service"
CALL_TIMEOUT = 25000
AUTH_TIMEOUT = 2 ** 31 - 1      # Claim/Delete muze cekat na heslo v okne polkitu

FINGERS = [
    ("right-index-finger", "Right index finger"), ("left-index-finger", "Left index finger"),
    ("right-thumb", "Right thumb"), ("left-thumb", "Left thumb"),
    ("right-middle-finger", "Right middle finger"), ("left-middle-finger", "Left middle finger"),
    ("right-ring-finger", "Right ring finger"), ("left-ring-finger", "Left ring finger"),
    ("right-little-finger", "Right little finger"), ("left-little-finger", "Left little finger"),
]

# Vysledky EnrollStatus -> (text, konec, chyba)
ENROLL = {
    "enroll-stage-passed": ("Lift your finger, then touch the sensor again", False, False),
    "enroll-retry-scan": ("Didn't catch that. Touch the sensor again.", False, True),
    "enroll-swipe-too-short": ("Swipe was too short. Try again.", False, True),
    "enroll-finger-not-centered": ("Center your finger on the sensor and try again.", False, True),
    "enroll-remove-and-retry": ("Lift your finger and try again.", False, True),
    "enroll-completed": ("Fingerprint added", True, False),
    "enroll-failed": ("The reader could not read your finger well enough. Clean the sensor and your finger, "
                      "then click Try Again.", True, True),
    "enroll-data-full": ("The reader cannot store more fingerprints. Remove one first.", True, True),
    "enroll-duplicate": ("This fingerprint is already added.", True, True),
    "enroll-disconnected": ("The fingerprint reader was disconnected.", True, True),
    "enroll-unknown-error": ("Something went wrong. Try again.", True, True),
}

CSS = b"""
.group { border-radius: 12px; border: 1px solid alpha(currentColor, 0.12); background-color: alpha(currentColor, 0.04); }
.group-title { font-weight: 700; font-size: 13px; margin: 14px 4px 6px; }
.row { padding: 8px 14px; min-height: 30px; }
.row-sep { border-top: 1px solid alpha(currentColor, 0.08); }
.hint { font-size: 11px; opacity: 0.6; }
.title-big { font-size: 18px; font-weight: 700; }
.status { font-size: 13px; }
.status.error { color: #e0443e; }
"""


def finger_label(key):
    return _(dict(FINGERS).get(key, key.replace("-", " ").capitalize()))


def enroll_message(result, swipe=False):
    """Text pro vysledek EnrollStatus: (text, konec, chyba)."""
    text, done, err = ENROLL.get(result, ("Something went wrong. Try again.", True, True))
    if result == "enroll-stage-passed" and swipe:
        text = "Swipe your finger again"
    text = _(text)
    if result in ("enroll-unknown-error", "enroll-failed") or result not in ENROLL:
        text += f"\n({result})"      # technicky duvod od ctecky (libfprint)
    return text, done, err


def error_message(err):
    """Srozumitelny text pro chybu volani fprintd (GLib.Error)."""
    name = Gio.DBusError.get_remote_error(err) or ""
    if name in (ERR + "PermissionDenied", "org.freedesktop.DBus.Error.AccessDenied"):
        return _("You are not allowed to change fingerprints.")
    if name == ERR + "AlreadyInUse":
        return _("The fingerprint reader is being used by another app. Try again later.")
    if name in (ERR + "NoSuchDevice", ERR + "Internal") or "NoSuchDevice" in name:
        return _("The fingerprint reader is not available.")
    if name == ERR + "PrintsNotDeleted":
        return _("Could not remove the fingerprint.")
    # neznama chyba: k obecne vete technicky duvod (podle nej jde chybu najit a opravit)
    detail = name.rsplit(".", 1)[-1] if name else ""
    msg = (err.message or "").strip()
    if msg and detail not in msg:
        detail = f"{detail}: {msg}" if detail else msg
    elif msg:
        detail = msg
    return _("Something went wrong. Try again.") + (f"\n({detail})" if detail else "")


class Fprint:
    """Asynchronni klient fprintd. Zpetna volani: ok(vysledek) / fail(GLib.Error)."""

    def __init__(self, bus=None):
        if bus is None:
            want = os.environ.get("LUXOS_FPRINT_BUS", "")
            if want.startswith("unix:"):
                # testy: vlastni sbernice podle adresy (nezavisle na sdilene session sbernici procesu)
                bus = Gio.DBusConnection.new_for_address_sync(
                    want, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
                    | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
            else:
                kind = Gio.BusType.SESSION if want == "session" else Gio.BusType.SYSTEM
                bus = Gio.bus_get_sync(kind, None)
        self.bus = bus
        self.dev = None             # cesta zarizeni
        self.props = {}
        self.claimed = False
        self.sub = 0

    def call(self, path, iface, method, args, ok, fail, timeout=CALL_TIMEOUT, reply=None):
        def done(bus, res):
            try:
                v = bus.call_finish(res)
            except GLib.Error as e:
                fail(e)
                return
            ok(v.unpack() if v is not None else ())
        self.bus.call(NAME, path, iface, method, args, GLib.VariantType(reply) if reply else None,
                      Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, timeout, None, done)

    def open(self, ok, fail):
        """Najde vychozi ctecku a nacte jeji vlastnosti; ok(True) / ok(False) bez ctecky."""
        def got_dev(v):
            self.dev = v[0]
            self.call(self.dev, "org.freedesktop.DBus.Properties", "GetAll", GLib.Variant("(s)", (IFACE_DEVICE,)),
                      got_props, lambda _e: got_props(({},)))

        def got_props(v):
            self.props = dict(v[0])
            ok(True)

        def no_dev(e):
            name = Gio.DBusError.get_remote_error(e) or ""
            if name.endswith("NoSuchDevice"):
                ok(False)
            else:
                fail(e)
        self.call(MANAGER, IFACE_MANAGER, "GetDefaultDevice", None, got_dev, no_dev)

    @property
    def name(self):
        return self.props.get("name") or _("Fingerprint reader")

    @property
    def stages(self):
        return int(self.props.get("num-enroll-stages", -1) or -1)

    @property
    def swipe(self):
        return self.props.get("scan-type") == "swipe"

    def list(self, ok, fail):
        def no_prints(e):
            if (Gio.DBusError.get_remote_error(e) or "").endswith("NoEnrolledPrints"):
                ok([])
            else:
                fail(e)
        self.call(self.dev, IFACE_DEVICE, "ListEnrolledFingers", GLib.Variant("(s)", ("",)),
                  lambda v: ok(list(v[0])), no_prints)

    def claim(self, ok, fail):
        def done(_v):
            self.claimed = True
            ok()
        self.call(self.dev, IFACE_DEVICE, "Claim", GLib.Variant("(s)", ("",)), done, fail, AUTH_TIMEOUT)

    def release(self, ok=None):
        if not self.claimed:
            if ok:
                ok()
            return
        self.claimed = False
        cb = (lambda *_a: ok()) if ok else (lambda *_a: None)
        self.call(self.dev, IFACE_DEVICE, "Release", None, cb, cb)

    def with_claim(self, method, args, ok, fail):
        """Claim -> metoda -> Release (zarizeni se uvolni i pri chybe)."""
        def failed(e):
            self.release(lambda: fail(e))

        def claimed():
            self.call(self.dev, IFACE_DEVICE, method, args, lambda v: self.release(lambda: ok(v)), failed,
                      AUTH_TIMEOUT)
        self.claim(claimed, fail)

    def delete(self, finger, ok, fail):
        self.with_claim("DeleteEnrolledFinger", GLib.Variant("(s)", (finger,)), ok, fail)

    def delete_all(self, ok, fail):
        self.with_claim("DeleteEnrolledFingers2", None, ok, fail)

    def enroll_start(self, finger, on_status, ok, fail):
        """Claim + EnrollStart; on_status(vysledek, konec) pro kazdy signal EnrollStatus."""
        def signal(_bus, _sender, _path, _iface, _sig, params):
            result, done = params.unpack()
            on_status(result, done)
        self.sub = self.bus.signal_subscribe(NAME, IFACE_DEVICE, "EnrollStatus", self.dev, None,
                                             Gio.DBusSignalFlags.NONE, signal)

        def failed(e):
            self.unsubscribe()
            self.release(lambda: fail(e))

        def claimed():
            self.call(self.dev, IFACE_DEVICE, "EnrollStart", GLib.Variant("(s)", (finger,)),
                      lambda _v: ok(), failed, AUTH_TIMEOUT)
        self.claim(claimed, lambda e: (self.unsubscribe(), fail(e)))

    def enroll_stop(self, ok=None):
        self.unsubscribe()
        if not self.claimed:
            if ok:
                ok()
            return
        self.call(self.dev, IFACE_DEVICE, "EnrollStop", None,
                  lambda _v: self.release(ok), lambda _e: self.release(ok))

    def unsubscribe(self):
        if self.sub:
            self.bus.signal_unsubscribe(self.sub)
            self.sub = 0


class Ridges(Gtk.DrawingArea):
    """Kresba otisku: hrebinky se postupne obarvuji podle prubehu snimani (0..1)."""

    def __init__(self, size=150):
        super().__init__()
        self.set_size_request(size, size)
        self.progress = 0.0
        self.error = False
        self.connect("draw", self.on_draw)

    def set(self, progress, error=False):
        self.progress, self.error = max(0.0, min(1.0, progress)), error
        self.queue_draw()

    def on_draw(self, w, cr):
        a = w.get_allocation()
        s = min(a.width, a.height)
        cx, cy = a.width / 2, a.height / 2
        fg = w.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        n = 7
        lit = round(self.progress * n)
        cr.set_line_cap(1)          # zaoblene konce
        cr.set_line_width(s * 0.035)
        for i in range(n):
            r = s * (0.08 + i * 0.058)
            # otevreny oblouk dole (jako konecek prstu), kazdy hrebinek trochu jinak
            gap = 0.55 + 0.12 * (i % 3)
            start, end = math.pi / 2 + gap, math.pi / 2 - gap + 2 * math.pi
            if i < lit:
                if self.error:
                    cr.set_source_rgba(0.88, 0.27, 0.24, 1)
                else:
                    cr.set_source_rgba(0.20, 0.52, 0.98, 1)
            else:
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.22)
            # elipsa vyssi nez sirsi - tvar konecku prstu
            cr.save()
            cr.translate(cx, cy + s * 0.04)
            cr.scale(0.8, 1.0)
            cr.new_sub_path()
            cr.arc(0, 0, r, start, end)
            cr.restore()
            cr.stroke()
        return False


class Group(Gtk.Box):
    def __init__(self, title=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.title = Gtk.Label(label=title or "", xalign=0)
        self.title.get_style_context().add_class("group-title")
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.box.get_style_context().add_class("group")
        self.pack_start(self.title, False, False, 0)
        self.pack_start(self.box, False, False, 0)
        self.rows = 0

    def clear(self):
        for c in self.box.get_children():
            self.box.remove(c)
        self.rows = 0

    def row(self, title, widget=None, icon=None):
        box = Gtk.Box(spacing=12)
        box.get_style_context().add_class("row")
        if self.rows:
            box.get_style_context().add_class("row-sep")
        if icon:
            box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
        box.pack_start(Gtk.Label(label=title, xalign=0), True, True, 0)
        if widget:
            widget.set_valign(Gtk.Align.CENTER)
            box.pack_end(widget, False, False, 0)
        self.box.pack_start(box, False, False, 0)
        box.show_all()
        self.rows += 1
        return box


class FingerprintWindow(Gtk.Window):
    def __init__(self, client=None):
        super().__init__(title=_("Fingerprint Login"))
        self.set_default_size(520, 500)
        self.set_icon_name("luxos-fingerprint")
        # HeaderBar zobrazit hned (okno se ukazuje pres show(), ne show_all() - jinak by chybelo zavirani)
        header = Gtk.HeaderBar(show_close_button=True, title=_("Fingerprint Login"))
        header.show_all()
        self.set_titlebar(header)
        self.fp = client
        self.enrolled = []
        self.finger = None
        self.passed = 0
        self.busy = False
        self.enrolling = False

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.add(self.stack)
        self.build_message()
        self.build_main()
        self.build_enroll()
        self.connect("delete-event", self.on_close)
        self.stack.show_all()
        self.show_message("content-loading-symbolic", _("Looking for a fingerprint reader…"), "", spinner=True)
        GLib.idle_add(self.start)

    # -- stranky --
    def build_message(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=30, valign=Gtk.Align.CENTER)
        self.msg_icon = Gtk.Image(pixel_size=64)
        self.msg_spinner = Gtk.Spinner(width_request=32, height_request=32)
        self.msg_title = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=40)
        self.msg_title.get_style_context().add_class("title-big")
        self.msg_text = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=48)
        self.msg_text.get_style_context().add_class("dim-label")
        self.msg_button = Gtk.Button(halign=Gtk.Align.CENTER, margin_top=8)
        self.msg_button.connect("clicked", lambda _b: self.msg_action and self.msg_action())
        self.msg_action = None
        for w in (self.msg_icon, self.msg_spinner, self.msg_title, self.msg_text, self.msg_button):
            page.pack_start(w, False, False, 0)
        self.stack.add_named(page, "message")

    def build_main(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=22, margin_top=10)
        top = Gtk.Box(spacing=14)
        top.pack_start(Gtk.Image(icon_name="luxos-fingerprint", pixel_size=56), False, False, 0)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, spacing=2)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=50, label=_(
            "Use your fingerprint to log in, unlock the screen and approve administrator actions. "
            "Your password always works too."))
        txt.pack_start(intro, False, False, 0)
        self.reader_label = Gtk.Label(xalign=0)
        self.reader_label.get_style_context().add_class("hint")
        txt.pack_start(self.reader_label, False, False, 0)
        top.pack_start(txt, True, True, 0)
        page.pack_start(top, False, False, 0)

        self.group = Group(_("Fingerprints"))
        page.pack_start(self.group, False, False, 0)
        self.status = Gtk.Label(xalign=0, wrap=True, margin_top=8)
        self.status.get_style_context().add_class("status")
        page.pack_start(self.status, False, False, 0)

        bar = Gtk.Box(spacing=8, margin_top=16)
        self.add_btn = Gtk.Button(label=_("Add Fingerprint…"))
        self.add_btn.get_style_context().add_class("suggested-action")
        self.add_btn.connect("clicked", self.on_add)
        bar.pack_start(self.add_btn, False, False, 0)
        self.remove_all_btn = Gtk.Button(label=_("Remove All"))
        self.remove_all_btn.connect("clicked", self.on_remove_all)
        bar.pack_end(self.remove_all_btn, False, False, 0)
        page.pack_start(bar, False, False, 0)
        self.stack.add_named(page, "main")

    def build_enroll(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=26, valign=Gtk.Align.CENTER)
        self.enroll_title = Gtk.Label()
        self.enroll_title.get_style_context().add_class("title-big")
        page.pack_start(self.enroll_title, False, False, 0)
        self.ridges = Ridges()
        self.ridges.set_halign(Gtk.Align.CENTER)
        page.pack_start(self.ridges, False, False, 6)
        self.enroll_status = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=44)
        self.enroll_status.get_style_context().add_class("status")
        page.pack_start(self.enroll_status, False, False, 0)
        self.enroll_count = Gtk.Label()
        self.enroll_count.get_style_context().add_class("hint")
        page.pack_start(self.enroll_count, False, False, 0)
        bar = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_top=10)
        self.enroll_cancel = Gtk.Button(label=_("Cancel"))
        self.enroll_cancel.connect("clicked", self.on_enroll_cancel)
        # Po neuspesnem pridani: znovu stejny prst (bez navratu na seznam a volby prstu)
        self.enroll_retry = Gtk.Button(label=_("Try Again"))
        self.enroll_retry.get_style_context().add_class("suggested-action")
        self.enroll_retry.connect("clicked", lambda _b: self.enroll(self.finger))
        self.enroll_retry.set_no_show_all(True)
        self.enroll_done = Gtk.Button(label=_("Done"))
        self.enroll_done.get_style_context().add_class("suggested-action")
        self.enroll_done.connect("clicked", lambda _b: self.refresh())
        bar.pack_start(self.enroll_cancel, False, False, 0)
        bar.pack_start(self.enroll_retry, False, False, 0)
        bar.pack_start(self.enroll_done, False, False, 0)
        page.pack_start(bar, False, False, 0)
        self.stack.add_named(page, "enroll")

    def show_message(self, icon, title, text, button=None, action=None, spinner=False):
        self.msg_icon.set_from_icon_name(icon, Gtk.IconSize.DIALOG)
        self.msg_icon.set_pixel_size(64)
        self.msg_icon.set_visible(not spinner)
        self.msg_spinner.set_visible(spinner)
        (self.msg_spinner.start if spinner else self.msg_spinner.stop)()
        self.msg_title.set_text(title)
        self.msg_text.set_text(text)
        self.msg_text.set_visible(bool(text))
        self.msg_button.set_label(button or "")
        self.msg_button.set_visible(bool(button))
        self.msg_action = action
        self.stack.set_visible_child_name("message")

    def set_status(self, text, error=False):
        self.status.set_text(text or "")
        (self.status.get_style_context().add_class if error else self.status.get_style_context().remove_class)("error")

    # -- prubeh --
    def start(self):
        if self.fp is None:
            if not os.path.exists(SERVICE_FILE) and not os.environ.get("LUXOS_FPRINT_BUS"):
                self.no_reader(installed=False)
                return False
            try:
                self.fp = Fprint()
            except GLib.Error as e:
                print("luxos-fingerprint:", e.message, file=sys.stderr)
                self.no_reader(installed=False)
                return False
        self.fp.open(self.opened, self.open_failed)
        return False

    def opened(self, found):
        if not found:
            self.no_reader(installed=True)
            return
        self.reader_label.set_text(self.fp.name)
        self.refresh()

    def open_failed(self, e):
        print("luxos-fingerprint:", e.message, file=sys.stderr)
        name = Gio.DBusError.get_remote_error(e) or ""
        if name in ("org.freedesktop.DBus.Error.ServiceUnknown", "org.freedesktop.DBus.Error.NameHasNoOwner"):
            self.no_reader(installed=False)
        else:
            self.show_message("dialog-error-symbolic", _("The fingerprint reader is not available."),
                              error_message(e), _("Try Again"), self.retry)

    def retry(self):
        self.show_message("content-loading-symbolic", _("Looking for a fingerprint reader…"), "", spinner=True)
        if self.fp:
            self.fp.open(self.opened, self.open_failed)
        else:
            self.start()

    def no_reader(self, installed):
        drivers = GLib.find_program_in_path("luxos-drivers")
        text = _("This computer has no supported fingerprint reader. If you connect one, "
                 "open Drivers to set it up.") if installed else _(
                 "Fingerprint support is not installed. Drivers installs it automatically "
                 "when your computer has a supported fingerprint reader.")
        self.show_message("luxos-fingerprint", _("No fingerprint reader found"), text,
                          _("Open Drivers") if drivers else None,
                          (lambda: subprocess.Popen([drivers], start_new_session=True)) if drivers else None)

    def refresh(self):
        self.fp.list(self.listed, self.list_failed)

    def list_failed(self, e):
        self.enrolled = []
        self.fill()
        self.set_status(error_message(e), True)

    def listed(self, fingers):
        self.enrolled = fingers
        self.fill()
        self.set_status("")

    def fill(self):
        self.group.clear()
        if not self.enrolled:
            self.group.row(_("No fingerprints added yet."))
        order = [k for k, _l in FINGERS]
        for f in sorted(self.enrolled, key=lambda k: order.index(k) if k in order else 99):
            b = Gtk.Button(label=_("Remove"))
            b.connect("clicked", self.on_remove, f)
            self.group.row(finger_label(f), b)
        free = [k for k, _l in FINGERS if k not in self.enrolled]
        self.add_btn.set_sensitive(bool(free) and not self.busy)
        self.remove_all_btn.set_visible(len(self.enrolled) > 1)
        self.remove_all_btn.set_sensitive(not self.busy)
        self.stack.set_visible_child_name("main")

    def set_busy(self, on):
        self.busy = on
        self.group.box.set_sensitive(not on)
        self.add_btn.set_sensitive(not on)
        self.remove_all_btn.set_sensitive(not on)

    # -- odebrani --
    def on_remove(self, _b, finger):
        if not self.confirm(_("Remove the fingerprint “%s”?") % finger_label(finger),
                            _("You will no longer be able to use this finger to log in.")):
            return
        self.set_busy(True)
        self.set_status(_("Removing…"))
        self.fp.delete(finger, lambda _v: self.removed(), self.remove_failed)

    def on_remove_all(self, _b):
        if not self.confirm(_("Remove all fingerprints?"),
                            _("You will need your password to log in.")):
            return
        self.set_busy(True)
        self.set_status(_("Removing…"))
        self.fp.delete_all(lambda _v: self.removed(), self.remove_failed)

    def removed(self):
        self.set_busy(False)
        self.refresh()

    def remove_failed(self, e):
        print("luxos-fingerprint:", e.message, file=sys.stderr)
        self.set_busy(False)
        self.set_status(error_message(e), True)

    def confirm(self, title, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.NONE, text=title)
        d.format_secondary_text(text)
        d.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        ok = d.add_button(_("Remove"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action")
        d.set_default_response(Gtk.ResponseType.CANCEL)
        r = d.run()
        d.destroy()
        return r == Gtk.ResponseType.OK

    # -- pridani --
    def on_add(self, _b):
        free = [(k, finger_label(k)) for k, _l in FINGERS if k not in self.enrolled]
        if not free:
            return
        d = Gtk.Dialog(title=_("Add Fingerprint"), transient_for=self, modal=True, use_header_bar=True)
        d.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        go = d.add_button(_("Continue"), Gtk.ResponseType.OK)
        go.get_style_context().add_class("suggested-action")
        d.set_default_response(Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(10)
        box.set_border_width(18)
        box.pack_start(Gtk.Label(label=_("Which finger do you want to add?"), xalign=0), False, False, 0)
        combo = Gtk.ComboBoxText()
        for k, label in free:
            combo.append(k, label)
        combo.set_active(0)
        box.pack_start(combo, False, False, 0)
        d.show_all()
        r = d.run()
        finger = combo.get_active_id()
        d.destroy()
        if r == Gtk.ResponseType.OK and finger:
            self.enroll(finger)

    def enroll(self, finger):
        self.finger, self.passed = finger, 0
        self.enroll_title.set_text(finger_label(finger))
        self.ridges.set(0)
        self.set_enroll_status(_("Swipe your finger across the sensor.") if self.fp.swipe else
                               _("Place your finger on the sensor, then lift it."))
        self.enroll_count.set_text("")
        self.enroll_cancel.set_label(_("Cancel"))
        self.enroll_cancel.set_visible(True)
        self.enroll_cancel.set_sensitive(True)
        self.enroll_done.set_visible(False)
        self.enroll_retry.set_visible(False)
        self.stack.set_visible_child_name("enroll")
        self.enrolling = True
        self.fp.enroll_start(finger, self.on_enroll_status, lambda: None, self.enroll_failed)

    def set_enroll_status(self, text, error=False):
        self.enroll_status.set_text(text)
        ctx = self.enroll_status.get_style_context()
        (ctx.add_class if error else ctx.remove_class)("error")

    def on_enroll_status(self, result, done):
        text, finished, err = enroll_message(result, self.fp.swipe)
        finished = finished or done
        if result == "enroll-stage-passed":
            self.passed += 1
        stages = self.fp.stages
        if result == "enroll-completed":
            progress = 1.0
        elif stages > 0:
            progress = min(self.passed / stages, 0.95)
            self.enroll_count.set_text(_("Step %d of %d") % (min(self.passed + 1, stages), stages))
        else:
            progress = min(self.passed * 0.12, 0.9)
        self.ridges.set(progress, err and finished)
        self.set_enroll_status(text, err)
        if finished:
            ok = result == "enroll-completed"
            self.enrolling = False
            self.enroll_count.set_text("")
            self.enroll_cancel.set_label(_("Back"))
            self.enroll_cancel.set_visible(not ok)
            self.enroll_done.set_visible(ok)
            # Zkusit znovu az po uvolneni ctecky (jinak by nove pridani narazilo na AlreadyInUse)
            again = not ok and result not in ("enroll-data-full", "enroll-duplicate")
            self.enroll_retry.set_visible(again)
            self.enroll_retry.set_sensitive(False)
            self.fp.enroll_stop(lambda: self.enroll_retry.set_sensitive(True))

    def enroll_failed(self, e):
        print("luxos-fingerprint:", e.message, file=sys.stderr)
        self.enrolling = False
        self.ridges.set(0)
        self.set_enroll_status(error_message(e), True)
        self.enroll_cancel.set_label(_("Back"))
        # ctecka uz je uvolnena (enroll_start pri chybe vola release)
        self.enroll_retry.set_visible(True)
        self.enroll_retry.set_sensitive(True)

    def on_enroll_cancel(self, _b):
        self.enroll_cancel.set_label(_("Cancel"))
        if self.enrolling:
            self.enrolling = False
            self.enroll_cancel.set_sensitive(False)
            self.fp.enroll_stop(self.refresh)
        else:
            self.refresh()

    def on_close(self, *_a):
        if self.fp and self.enrolling:
            self.enrolling = False
            self.fp.enroll_stop(Gtk.main_quit)
            self.hide()
            return True
        return False


def main():
    GLib.set_prgname("luxos-fingerprint")
    GLib.set_application_name(_("Fingerprint Login"))
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = FingerprintWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show()
    Gtk.main()


if __name__ == "__main__":
    main()
