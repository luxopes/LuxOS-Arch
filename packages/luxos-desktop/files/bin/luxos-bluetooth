#!/usr/bin/env python3
"""LuxOS - Bluetooth: zapnuti, sparovana zarizeni a pripojeni noveho jednim klikem.

Pracuje primo s BlueZ pres D-Bus. Pri otevrenem okne hleda zarizeni v okoli;
"Pripojit" u noveho zarizeni ho sparuje, nastavi jako duveryhodne a pripoji.
Pokud zarizeni chce potvrdit kod, zobrazi se dialog (vlastni agent BlueZ).
Jmeno pocitace viditelne pro ostatni zarizeni = vlastnost Alias adapteru (org.bluez.Adapter1);
prazdny Alias vrati vychozi jmeno systemu (pretty hostname). Zapis povoluje politika D-Bus BlueZ
(send_destination org.bluez pro vsechny), polkit neni potreba.
"""
import subprocess
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

BLUEZ = "org.bluez"
AGENT_PATH = "/org/luxos/bluetooth/agent"
AGENT_XML = """
<node>
  <interface name="org.bluez.Agent1">
    <method name="Release"/>
    <method name="RequestPinCode"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
    <method name="DisplayPinCode"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
    <method name="RequestPasskey"><arg type="o" direction="in"/><arg type="u" direction="out"/></method>
    <method name="DisplayPasskey"><arg type="o" direction="in"/><arg type="u" direction="in"/><arg type="q" direction="in"/></method>
    <method name="RequestConfirmation"><arg type="o" direction="in"/><arg type="u" direction="in"/></method>
    <method name="RequestAuthorization"><arg type="o" direction="in"/></method>
    <method name="AuthorizeService"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
    <method name="Cancel"/>
  </interface>
</node>
"""

CSS = b"""
.section-title { font-size: 13px; font-weight: 700; opacity: 0.7; margin: 14px 4px 6px; }
.group { border-radius: 12px; border: 1px solid alpha(currentColor, 0.12); background-color: alpha(currentColor, 0.04); }
.group row { padding: 8px 12px; }
.dev-name { font-weight: 600; }
.dev-sub { font-size: 11px; opacity: 0.6; }
.big-switch-label { font-size: 15px; font-weight: 700; }
.empty { opacity: 0.6; padding: 18px; }
"""

ALIAS_MAX = 248   # nejdelsi jmeno zarizeni v Bluetooth (HCI local name, bajty UTF-8)


def system_bus():
    return Gio.bus_get_sync(Gio.BusType.SYSTEM)


BUS = system_bus   # testy podstrci vlastni sbernici (falesny BlueZ)


def clean_alias(text):
    """Jmeno z pole formulare: bez mezer na zacatku a konci."""
    return (text or "").strip()


def alias_problem(name):
    """Proc jmeno nejde pouzit (None = lze). Prazdne jmeno = vychozi jmeno systemu."""
    if any(ord(c) < 32 or ord(c) == 127 for c in name):
        return _("The name cannot contain line breaks or control characters.")
    if len(name.encode("utf-8")) > ALIAS_MAX:
        return _("The name is too long (at most %d bytes).") % ALIAS_MAX
    return None


KIND = {
    "audio-headset": "Headphones", "audio-headphones": "Headphones", "audio-card": "Speaker",
    "input-mouse": "Mouse", "input-keyboard": "Keyboard", "input-gaming": "Game controller",
    "input-tablet": "Tablet", "phone": "Phone", "computer": "Computer",
}


class Bluez:
    """Tenka vrstva nad D-Bus API BlueZ (ObjectManager, Adapter1, Device1)."""

    def __init__(self, on_change):
        self.bus = BUS()
        self.on_change = on_change
        self.objects = {}
        for sig in ("InterfacesAdded", "InterfacesRemoved"):
            self.bus.signal_subscribe(BLUEZ, "org.freedesktop.DBus.ObjectManager", sig, None, None, 0,
                                      lambda *_a: self.reload())
        self.bus.signal_subscribe(BLUEZ, "org.freedesktop.DBus.Properties", "PropertiesChanged", None, None, 0,
                                  lambda *_a: self.reload())
        self.reload()

    def reload(self):
        try:
            r = self.bus.call_sync(BLUEZ, "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects", None,
                                   GLib.VariantType("(a{oa{sa{sv}}})"), 0, 3000, None)
            self.objects = r.unpack()[0]
        except GLib.Error:
            self.objects = {}
        self.on_change()

    def adapter(self):
        # Prvni adapter (hci0), poradi slovniku z D-Bus neni zarucene
        for path in sorted(self.objects):
            if "org.bluez.Adapter1" in self.objects[path]:
                return path, self.objects[path]["org.bluez.Adapter1"]
        return None, None

    def devices(self, adapter):
        out = []
        for path, ifaces in self.objects.items():
            d = ifaces.get("org.bluez.Device1")
            if d and d.get("Adapter") == adapter and (d.get("Name") or d.get("Paired")):
                out.append((path, d))
        return out

    def set_prop(self, path, iface, name, value, done=None):
        def finish(bus, res):
            try:
                bus.call_finish(res)
                err = None
            except GLib.Error as e:
                err = e
            if done:
                done(err)
        self.bus.call(BLUEZ, path, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", (iface, name, value)), None, 0, 10000, None, finish)

    def call(self, path, iface, method, args=None, done=None, timeout=60000):
        def finish(bus, res):
            try:
                bus.call_finish(res)
                err = None
            except GLib.Error as e:
                err = e
            if done:
                done(err)
        self.bus.call(BLUEZ, path, iface, method, args, None, 0, timeout, None, finish)


class Agent:
    """Agent BlueZ: potvrzeni a zadani kodu pri parovani v dialogu."""

    def __init__(self, bus, window):
        self.window = window
        node = Gio.DBusNodeInfo.new_for_xml(AGENT_XML)
        self.reg = bus.register_object(AGENT_PATH, node.interfaces[0], self.on_call, None, None)
        mgr = ("org.bluez", "/org/bluez", "org.bluez.AgentManager1")
        try:
            bus.call_sync(*mgr, "RegisterAgent", GLib.Variant("(os)", (AGENT_PATH, "KeyboardDisplay")), None, 0, 3000, None)
            bus.call_sync(*mgr, "RequestDefaultAgent", GLib.Variant("(o)", (AGENT_PATH,)), None, 0, 3000, None)
        except GLib.Error:
            pass

    def dialog(self, text, secondary, entry=False, buttons=True, ok_label=None):
        dlg = Gtk.MessageDialog(transient_for=self.window, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text=text)
        if buttons:
            dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        dlg.add_button(ok_label or _("OK"), Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        dlg.format_secondary_markup(secondary)
        field = None
        if entry:
            field = Gtk.Entry(activates_default=True)
            dlg.get_message_area().pack_start(field, False, False, 0)
            dlg.set_default_response(Gtk.ResponseType.OK)
            field.show()
        ok = dlg.run() == Gtk.ResponseType.OK
        value = field.get_text() if field else None
        dlg.destroy()
        return ok, value

    def on_call(self, _conn, _sender, _path, _iface, method, params, inv):
        args = params.unpack()
        reject = ("org.bluez.Error.Rejected", _("Rejected"))
        if method == "RequestConfirmation":
            ok, _v = self.dialog(_("Pair this device?"),
                                 _("Check that the device shows this code:") + f"\n\n<big><b>{args[1]:06d}</b></big>",
                                 ok_label=_("Pair"))
            if ok:
                inv.return_value(None)
            else:
                inv.return_dbus_error(*reject)
        elif method in ("DisplayPasskey", "DisplayPinCode"):
            code = f"{args[1]:06d}" if method == "DisplayPasskey" else args[1]
            self.dialog(_("Type this code on the device"), f"<big><b>{code}</b></big>\n\n" + _("Then press Enter on it."),
                        buttons=False)
            inv.return_value(None)
        elif method == "RequestPinCode":
            ok, v = self.dialog(_("Enter the PIN code"), _("Usually 0000 or 1234, see the device manual."), entry=True)
            if ok and v:
                inv.return_value(GLib.Variant("(s)", (v,)))
            else:
                inv.return_dbus_error(*reject)
        elif method == "RequestPasskey":
            ok, v = self.dialog(_("Enter the code"), _("Code shown on the device:"), entry=True)
            if ok and v and v.isdigit():
                inv.return_value(GLib.Variant("(u)", (int(v),)))
            else:
                inv.return_dbus_error(*reject)
        else:  # RequestAuthorization, AuthorizeService, Release, Cancel
            inv.return_value(None)


class DeviceRow(Gtk.ListBoxRow):
    def __init__(self, win, path, props):
        super().__init__(activatable=False)
        self.win, self.path = win, path
        box = Gtk.Box(spacing=12)
        icon = props.get("Icon") or "bluetooth"
        img = Gtk.Image.new_from_icon_name(icon + "-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        box.pack_start(img, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        name = Gtk.Label(label=props.get("Alias") or props.get("Name") or props.get("Address"), xalign=0,
                         ellipsize=Pango.EllipsizeMode.END)
        name.get_style_context().add_class("dev-name")
        self.sub = Gtk.Label(xalign=0)
        self.sub.get_style_context().add_class("dev-sub")
        text.pack_start(name, False, False, 0)
        text.pack_start(self.sub, False, False, 0)
        box.pack_start(text, True, True, 0)
        self.spinner = Gtk.Spinner()
        box.pack_start(self.spinner, False, False, 0)

        paired, connected = props.get("Paired"), props.get("Connected")
        kind = _(KIND.get(icon, "Device"))
        battery = win.battery_of(path)
        parts = [kind]
        if connected:
            parts.append(_("Connected"))
        elif paired:
            parts.append(_("Not connected"))
        if battery is not None:
            parts.append(_("battery %d %%") % battery)
        self.sub.set_text(" · ".join(parts))

        if paired:
            btn = Gtk.Button(label=_("Disconnect") if connected else _("Connect"), valign=Gtk.Align.CENTER)
            btn.connect("clicked", lambda _b: win.toggle_connect(self, connected))
            box.pack_start(btn, False, False, 0)
            forget = Gtk.Button.new_from_icon_name("user-trash-symbolic", Gtk.IconSize.BUTTON)
            forget.set_tooltip_text(_("Forget this device"))
            forget.set_valign(Gtk.Align.CENTER)
            forget.connect("clicked", lambda _b: win.forget(self))
            box.pack_start(forget, False, False, 0)
        else:
            btn = Gtk.Button(label=_("Connect"), valign=Gtk.Align.CENTER)
            btn.get_style_context().add_class("suggested-action")
            btn.connect("clicked", lambda _b: win.pair(self))
            box.pack_start(btn, False, False, 0)
        self.add(box)

    def busy(self, on, text=None):
        (self.spinner.start if on else self.spinner.stop)()
        if text:
            self.sub.set_text(text)


class BluetoothWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Bluetooth"))
        self.set_default_size(560, 620)
        self.set_icon_name("bluetooth")
        header = Gtk.HeaderBar(show_close_button=True, title=_("Bluetooth"))
        self.set_titlebar(header)

        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=20)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.add(page)
        self.add(scroll)

        top = Gtk.Box(spacing=12)
        lab = Gtk.Label(label=_("Bluetooth"), xalign=0)
        lab.get_style_context().add_class("big-switch-label")
        top.pack_start(lab, True, True, 0)
        self.power = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.power_handler = self.power.connect("notify::active", self.on_power)
        top.pack_end(self.power, False, False, 0)
        page.pack_start(top, False, False, 0)
        self.hint = Gtk.Label(xalign=0, wrap=True)
        self.hint.get_style_context().add_class("dev-sub")
        page.pack_start(self.hint, False, False, 4)

        # Jmeno tohoto pocitace (Alias adapteru) - vidi ho telefon, sluchatka...
        self.name_group = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, margin_top=10)
        self.name_group.get_style_context().add_class("group")
        nrow = Gtk.ListBoxRow(activatable=False)
        nbox = Gtk.Box(spacing=12)
        nbox.pack_start(Gtk.Image.new_from_icon_name("computer-symbolic", Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
        ntext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        self.name_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.name_label.get_style_context().add_class("dev-name")
        self.name_sub = Gtk.Label(xalign=0, wrap=True)
        self.name_sub.get_style_context().add_class("dev-sub")
        ntext.pack_start(self.name_label, False, False, 0)
        ntext.pack_start(self.name_sub, False, False, 0)
        nbox.pack_start(ntext, True, True, 0)
        self.rename_btn = Gtk.Button(label=_("Rename…"), valign=Gtk.Align.CENTER)
        self.rename_btn.connect("clicked", lambda _b: self.rename())
        nbox.pack_start(self.rename_btn, False, False, 0)
        nrow.add(nbox)
        self.name_group.add(nrow)
        page.pack_start(self.name_group, False, False, 0)

        self.lists = {}
        for key, title in (("paired", _("My devices")), ("nearby", _("Nearby devices"))):
            head = Gtk.Box(spacing=8)
            t = Gtk.Label(label=title.upper(), xalign=0)
            t.get_style_context().add_class("section-title")
            head.pack_start(t, False, False, 0)
            if key == "nearby":
                self.scan_spinner = Gtk.Spinner(valign=Gtk.Align.CENTER, margin_top=8)
                head.pack_start(self.scan_spinner, False, False, 0)
            page.pack_start(head, False, False, 0)
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lb.get_style_context().add_class("group")
            empty = Gtk.Label(label=_("No devices") if key == "paired" else
                              _("Searching… Put the device into pairing mode."))
            empty.get_style_context().add_class("empty")
            empty.show()
            lb.set_placeholder(empty)
            page.pack_start(lb, False, False, 0)
            self.lists[key] = lb
            setattr(self, f"head_{key}", head)

        self.busy = {}
        self.apath = None
        self.pending = True          # prvni vykresleni probehne nize
        self.bz = Bluez(self.schedule_refresh)
        self.agent = Agent(self.bz.bus, self)
        self.connect("destroy", lambda *_a: self.stop_scan())
        self.refresh()
        self.start_scan()

    def battery_of(self, path):
        b = self.bz.objects.get(path, {}).get("org.bluez.Battery1")
        return b.get("Percentage") if b else None

    def schedule_refresh(self):
        # Udalosti chodi v davkach - prekreslit jednou
        if not self.pending:
            self.pending = True
            GLib.timeout_add(250, self.refresh)

    def refresh(self):
        self.pending = False
        apath, adapter = self.bz.adapter()
        self.apath = apath
        if not apath:
            self.power.set_sensitive(False)
            self.hint.set_text(_("No Bluetooth adapter was found on this computer."))
            for lb in self.lists.values():
                lb.set_visible(False)
            self.head_paired.set_visible(False)
            self.head_nearby.set_visible(False)
            self.name_group.set_visible(False)
            return False
        on = bool(adapter.get("Powered"))
        self.power.handler_block(self.power_handler)
        self.power.set_active(on)
        self.power.handler_unblock(self.power_handler)
        alias = adapter.get("Alias") or adapter.get("Name") or ""
        if not on:
            self.hint.set_text(_("Turn on Bluetooth to connect headphones, a mouse, a keyboard or a phone."))
        elif adapter.get("Discoverable"):
            self.hint.set_text(_("Visible to nearby devices as “%s”.") % alias)
        else:
            self.hint.set_text(_("Other devices see this computer as “%s”.") % alias)
        self.name_label.set_text(alias)
        self.name_sub.set_text(_("This computer's name, shown to other Bluetooth devices")
                               + (" · " + _("visible now") if on and adapter.get("Discoverable") else ""))
        for lb in self.lists.values():
            lb.set_visible(on)
        self.head_paired.set_visible(on)
        self.head_nearby.set_visible(on)
        (self.scan_spinner.start if adapter.get("Discovering") else self.scan_spinner.stop)()
        for lb in self.lists.values():
            for row in lb.get_children():
                lb.remove(row)
        devs = sorted(self.bz.devices(apath), key=lambda d: (not d[1].get("Connected"), (d[1].get("Alias") or "").lower()))
        for path, props in devs:
            if not props.get("Paired") and not props.get("Name"):
                continue
            row = DeviceRow(self, path, props)
            self.lists["paired" if props.get("Paired") else "nearby"].add(row)
            if path in self.busy:
                row.busy(True, self.busy[path])
        self.show_all()
        return False

    # ---- akce ----
    def on_power(self, switch, _p):
        if not self.apath:
            return
        if switch.get_active():
            subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True)
        self.bz.set_prop(self.apath, "org.bluez.Adapter1", "Powered", GLib.Variant("b", switch.get_active()))
        if switch.get_active():
            GLib.timeout_add(800, lambda: self.start_scan() and False)

    def start_scan(self):
        if self.apath:
            self.bz.call(self.apath, "org.bluez.Adapter1", "StartDiscovery")
        return False

    def stop_scan(self):
        if self.apath:
            try:
                self.bz.bus.call_sync(BLUEZ, self.apath, "org.bluez.Adapter1", "StopDiscovery", None, None, 0, 2000, None)
            except GLib.Error:
                pass

    def mark(self, row, text):
        self.busy[row.path] = text
        row.busy(True, text)

    def done(self, row, err):
        self.busy.pop(row.path, None)
        if err:
            msg = err.message.split(":")[-1].strip()
            self.error(_("Could not connect"), msg)
        self.schedule_refresh()

    def pair(self, row):
        self.mark(row, _("Pairing…"))

        def paired(err):
            if err and "AlreadyExists" not in err.message:
                return self.done(row, err)
            self.bz.set_prop(row.path, "org.bluez.Device1", "Trusted", GLib.Variant("b", True))
            self.mark(row, _("Connecting…"))
            self.bz.call(row.path, "org.bluez.Device1", "Connect", done=lambda e: self.done(row, e))
        self.bz.call(row.path, "org.bluez.Device1", "Pair", done=paired)

    def toggle_connect(self, row, connected):
        self.mark(row, _("Disconnecting…") if connected else _("Connecting…"))
        self.bz.call(row.path, "org.bluez.Device1", "Disconnect" if connected else "Connect",
                     done=lambda e: self.done(row, e))

    def forget(self, row):
        self.bz.call(self.apath, "org.bluez.Adapter1", "RemoveDevice", GLib.Variant("(o)", (row.path,)),
                     done=lambda e: self.done(row, e))

    # ---- jmeno pocitace (Alias adapteru) ----
    def adapter_props(self):
        return self.bz.objects.get(self.apath, {}).get("org.bluez.Adapter1", {}) if self.apath else {}

    def rename_dialog(self):
        """Dialog prejmenovani -> (dialog, pole, chybovy text, tlacitko Prejmenovat)."""
        props = self.adapter_props()
        default = props.get("Name") or GLib.get_host_name()
        dlg = Gtk.Dialog(title=_("Rename This Computer"), transient_for=self, modal=True)
        dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        dlg.add_button(_("Use Default"), Gtk.ResponseType.REJECT).set_tooltip_text(
            _("Use the system name “%s”") % default)
        ok = dlg.add_button(_("Rename"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dlg.set_default_response(Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(12)
        box.set_margin_bottom(8)
        info = Gtk.Label(label=_("Other Bluetooth devices, such as your phone or headphones, show this name."),
                         xalign=0, wrap=True, max_width_chars=48)
        box.pack_start(info, False, False, 0)
        entry = Gtk.Entry(text=props.get("Alias") or default, activates_default=True, placeholder_text=default)
        box.pack_start(entry, False, False, 0)
        err = Gtk.Label(xalign=0, wrap=True, max_width_chars=48)
        err.get_style_context().add_class("dev-sub")
        box.pack_start(err, False, False, 0)

        def changed(_e):
            name = clean_alias(entry.get_text())
            problem = alias_problem(name)
            err.set_text(problem or (_("An empty name uses the system name “%s”.") % default if not name else ""))
            ok.set_sensitive(problem is None)
        entry.connect("changed", changed)
        changed(entry)
        box.show_all()
        return dlg, entry, err, ok

    def rename(self):
        if not self.apath:
            return
        dlg, entry, _err, _ok = self.rename_dialog()
        resp = dlg.run()
        value = clean_alias(entry.get_text())
        dlg.destroy()
        if resp == Gtk.ResponseType.REJECT:
            self.set_alias("")
        elif resp == Gtk.ResponseType.OK and alias_problem(value) is None:
            self.set_alias(value)

    def set_alias(self, name):
        """Novy Alias adapteru ("" = vychozi jmeno systemu); BlueZ ho ulozi trvale."""
        if not self.apath or alias_problem(name):
            return False

        def done(err):
            if err:
                self.error(_("Could not rename this computer"), err.message.split(":")[-1].strip(), advice=False)
            self.bz.reload()
        self.bz.set_prop(self.apath, "org.bluez.Adapter1", "Alias", GLib.Variant("s", name), done=done)
        return True

    def error(self, title, text, advice=True):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                buttons=Gtk.ButtonsType.CLOSE, text=title)
        if advice:
            text += "\n\n" + _("Make sure the device is on, close by and in pairing mode.")
        dlg.format_secondary_text(text)
        dlg.run()
        dlg.destroy()


def main():
    GLib.set_prgname("luxos-bluetooth")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = BluetoothWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
