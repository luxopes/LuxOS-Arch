#!/usr/bin/env python3
"""LuxOS - Rozlozeni klavesnice: rozlozeni klavesnice a jejich prepinani pro cely system.

Seznam rozlozeni (prvni = vychozi, nejvyse 4), prepinani zkratkou a tlacitko
"Pouzit pro vsechny uzivatele a prihlasovaci obrazovku": zapis pres localectl
(systemd-localed, opravneni overi polkit) do /etc/X11/xorg.conf.d/00-keyboard.conf
a /etc/vconsole.conf. Zmeny se hned zkusi v bezici relaci (setxkbmap); bez pouziti
se pri zavreni okna vrati puvodni stav. Uzivateli se zaroven vypne vlastni rozlozeni
Xfce (keyboard-layout /Default/XkbDisable = true), aby se ridil systemem.
"""
import os
import shutil
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402
import luxos_keyboard as kb  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

CSS = b"""
.group { border-radius: 12px; border: 1px solid alpha(currentColor, 0.12); background-color: alpha(currentColor, 0.04); }
.group-title { font-weight: 700; font-size: 13px; margin: 14px 4px 6px; }
.row { padding: 8px 14px; }
.row-sep { border-top: 1px solid alpha(currentColor, 0.08); }
.hint { font-size: 11px; opacity: 0.6; }
.badge { font-size: 10px; font-weight: 700; padding: 1px 7px; border-radius: 8px; color: #ffffff; background-color: #3d7bff; }
.flat-icon { padding: 2px; min-width: 24px; min-height: 24px; }
"""


def run(cmd, timeout=20):
    """(navratovy kod, vystup) - chybejici program neni vyjimka."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def user_override():
    """True, kdyz si uzivatel v Xfce nastavil vlastni rozlozeni (pak system prepisuje)."""
    rc, out = run(["xfconf-query", "-c", "keyboard-layout", "-p", "/Default/XkbDisable"], 5)
    return rc == 0 and out.strip().lower() == "false"


def session_state():
    """Rozlozeni bezici relace (setxkbmap -query) - pro navrat, kdyz se zmeny nepouziji."""
    rc, out = run(["setxkbmap", "-query"], 5)
    if rc != 0:
        return None
    vals = {}
    for line in out.splitlines():
        k, _sep, v = line.partition(":")
        vals[k.strip()] = v.strip()
    cfg = kb.from_strings(vals.get("layout", ""), vals.get("variant", ""), vals.get("options", ""))
    return cfg if cfg["layouts"] else None


class Group(Gtk.Box):
    def __init__(self, page, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("group-title")
        page.pack_start(label, False, False, 0)
        self.get_style_context().add_class("group")
        page.pack_start(self, False, False, 0)

    def row(self, title, widget=None, hint=None, first=False):
        box = Gtk.Box(spacing=10)
        box.get_style_context().add_class("row")
        if not first:
            box.get_style_context().add_class("row-sep")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        text.pack_start(Gtk.Label(label=title, xalign=0, wrap=True, max_width_chars=40), False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0, wrap=True, max_width_chars=46)
            h.get_style_context().add_class("hint")
            text.pack_start(h, False, False, 0)
        box.pack_start(text, True, True, 0)
        if widget is not None:
            widget.set_valign(Gtk.Align.CENTER)
            box.pack_end(widget, False, False, 0)
        self.pack_start(box, False, False, 0)
        return box


def icon_button(icon, tip, cb, sensitive=True):
    b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.get_style_context().add_class("flat-icon")
    b.set_tooltip_text(tip)
    b.set_sensitive(sensitive)
    b.connect("clicked", lambda _b: cb())
    return b


class AddDialog(Gtk.Dialog):
    """Vyber dalsiho rozlozeni s hledanim."""

    def __init__(self, parent, catalog, used):
        super().__init__(title=_("Add Layout"), transient_for=parent, modal=True)
        self.set_default_size(420, 460)
        self.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        self.ok = self.add_button(_("Add"), Gtk.ResponseType.OK)
        self.ok.get_style_context().add_class("suggested-action")
        self.ok.set_sensitive(False)
        self.set_default_response(Gtk.ResponseType.OK)
        area = self.get_content_area()
        area.set_spacing(8)
        area.set_border_width(12)
        self.entry = Gtk.SearchEntry(placeholder_text=_("Type to search"))
        area.pack_start(self.entry, False, False, 0)
        self.lb = Gtk.ListBox()
        for key, desc in catalog:
            if key in used:
                continue
            row = Gtk.ListBoxRow()
            row.key = key
            name = kb.describe(key, catalog, _)
            row.hay = f"{name} {desc} {key[0]} {key[1]}".lower()
            box = Gtk.Box(spacing=8, margin=6)
            box.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
            code = Gtk.Label(label=kb.short(key))
            code.get_style_context().add_class("hint")
            box.pack_end(code, False, False, 0)
            row.add(box)
            self.lb.add(row)
        self.lb.set_filter_func(self.flt)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.add(self.lb)
        area.pack_start(sw, True, True, 0)
        self.entry.connect("search-changed", lambda _e: self.lb.invalidate_filter())
        self.entry.connect("activate", lambda _e: self.pick_first())
        self.lb.connect("row-selected", lambda _l, r: self.ok.set_sensitive(r is not None))
        self.lb.connect("row-activated", lambda _l, _r: self.response(Gtk.ResponseType.OK))

    def flt(self, row):
        q = self.entry.get_text().strip().lower()
        return not q or q in row.hay

    def pick_first(self):
        for row in self.lb.get_children():
            if row.get_child_visible() and self.flt(row):
                self.lb.select_row(row)
                self.response(Gtk.ResponseType.OK)
                return

    def chosen(self):
        row = self.lb.get_selected_row()
        return row.key if row else None


class KeyboardSettings(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Keyboard Layouts"))
        self.set_default_size(560, 600)
        self.set_icon_name("preferences-desktop-keyboard")
        self.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=_("Keyboard Layouts")))
        self.catalog = kb.load_catalog()
        self.system = kb.read_system()
        self.layouts = list(self.system["layouts"])
        self.options = list(self.system["options"])
        self.override = user_override()
        self.session = session_state()
        self.applied = False
        self.busy = False

        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.add(sw)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=22, margin_top=6)
        sw.add(page)

        self.lay_group = Group(page, _("Layouts"))
        self.lay_group.set_name("layouts")
        hint = Gtk.Label(label=_("The first layout is the default. Switch between them with the shortcut "
                                 "below or by clicking the flag in the menu bar."),
                         xalign=0, wrap=True, max_width_chars=60)
        hint.get_style_context().add_class("hint")
        hint.set_margin_top(6)
        hint.set_margin_start(4)
        page.pack_start(hint, False, False, 0)

        g = Group(page, _("Switching"))
        self.switch = Gtk.ComboBoxText()
        for opt, label in kb.SWITCH_OPTIONS:
            self.switch.append(opt or "none", _(label))
        cur = kb.switch_of(self.options)
        known = [o for o, _l in kb.SWITCH_OPTIONS]
        if cur and cur not in known:   # jina volba z localectl - nabidnout ji, at se neztrati
            self.switch.append(cur, cur)
        self.switch.set_active_id(cur or "none")
        self.switch.connect("changed", self.on_switch)
        g.row(_("Switch layouts with"), self.switch, first=True)
        test = Gtk.Entry(placeholder_text=_("Type here to test your keyboard"), hexpand=True)
        tbox = Gtk.Box(margin=10)
        tbox.pack_start(test, True, True, 0)
        g.pack_start(tbox, False, False, 0)

        self.note = Gtk.Label(xalign=0, wrap=True, max_width_chars=60, no_show_all=True)
        self.note.get_style_context().add_class("hint")
        self.note.set_margin_top(12)
        page.pack_start(self.note, False, False, 0)

        bottom = Gtk.Box(spacing=8, margin_top=16)
        self.apply_btn = Gtk.Button(label=_("Apply to All Users and the Login Screen"))
        self.apply_btn.get_style_context().add_class("suggested-action")
        self.apply_btn.connect("clicked", self.on_apply)
        bottom.pack_start(self.apply_btn, False, False, 0)
        self.spinner = Gtk.Spinner()
        bottom.pack_start(self.spinner, False, False, 0)
        if os.path.exists("/usr/bin/xfce4-keyboard-settings"):
            more = Gtk.Button(label=_("More Keyboard Settings…"))
            more.set_tooltip_text(_("Key repeat and other keyboard settings"))
            more.connect("clicked", lambda _b: subprocess.Popen(["/usr/bin/xfce4-keyboard-settings"], start_new_session=True))
            bottom.pack_end(more, False, False, 0)
        page.pack_start(bottom, False, False, 0)
        self.status = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        self.status.set_margin_top(8)
        page.pack_start(self.status, False, False, 0)

        self.connect("delete-event", self.on_close)
        self.fill()

    # ---- seznam rozlozeni ----
    def fill(self):
        g = self.lay_group
        for c in g.get_children():
            g.remove(c)
        n = len(self.layouts)
        for i, key in enumerate(self.layouts):
            box = Gtk.Box(spacing=4)
            if i == 0:
                badge = Gtk.Label(label=_("Default"))
                badge.get_style_context().add_class("badge")
                box.pack_start(badge, False, False, 6)
            box.pack_start(icon_button("go-up-symbolic", _("Move up"), lambda i=i: self.move(i, -1), i > 0),
                           False, False, 0)
            box.pack_start(icon_button("go-down-symbolic", _("Move down"), lambda i=i: self.move(i, 1), i < n - 1),
                           False, False, 0)
            box.pack_start(icon_button("list-remove-symbolic", _("Remove"), lambda i=i: self.remove(i), n > 1),
                           False, False, 0)
            g.row(kb.describe(key, self.catalog, _), box, kb.short(key), first=i == 0)
        add = Gtk.Button(label=_("Add Layout…"))
        add.set_sensitive(n < kb.MAX_LAYOUTS)
        if n >= kb.MAX_LAYOUTS:
            add.set_tooltip_text(_("At most %d layouts are possible.") % kb.MAX_LAYOUTS)
        add.connect("clicked", self.on_add)
        g.row("", add)
        g.show_all()
        self.update()

    def move(self, i, d):
        j = i + d
        if 0 <= j < len(self.layouts):
            self.layouts[i], self.layouts[j] = self.layouts[j], self.layouts[i]
            self.changed()

    def remove(self, i):
        if len(self.layouts) > 1:
            del self.layouts[i]
            self.changed()

    def on_add(self, _b):
        dlg = AddDialog(self, self.catalog, set(self.layouts))
        dlg.show_all()
        resp = dlg.run()
        key = dlg.chosen() if resp == Gtk.ResponseType.OK else None
        dlg.destroy()
        if key and key not in self.layouts and len(self.layouts) < kb.MAX_LAYOUTS:
            self.layouts.append(key)
            # Druhe rozlozeni bez prepinani by neslo zapnout klavesnici - nabidnout obe klavesy Shift
            if len(self.layouts) == 2 and not kb.switch_of(self.options):
                self.options = kb.with_switch(self.options, kb.DEFAULT_SWITCH)
                self.switch.set_active_id(kb.DEFAULT_SWITCH)
            self.changed()

    def on_switch(self, c):
        sel = c.get_active_id()
        self.options = kb.with_switch(self.options, "" if sel == "none" else sel)
        self.changed(refill=False)

    def changed(self, refill=True):
        self.status.set_text("")
        self.preview(self.layouts, self.options)
        if refill:
            self.fill()
        else:
            self.update()

    def dirty(self):
        return self.layouts != self.system["layouts"] or self.options != self.system["options"]

    def update(self):
        if self.override:
            self.note.set_text(_("Your account uses its own keyboard layouts from Xfce settings. "
                                 "Applying switches it back to the layouts set here."))
            self.note.show()
        else:
            self.note.hide()
        self.apply_btn.set_sensitive(not self.busy and (self.dirty() or self.override))

    @staticmethod
    def preview(layouts, options):
        """Vyzkouseni v bezici relaci (jen tato relace, nic se neuklada)."""
        try:
            subprocess.Popen(kb.setxkbmap_cmd(layouts, options), stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except (OSError, kb.KeyboardError):
            pass

    # ---- pouziti pro cely system ----
    def on_apply(self, _b):
        layouts, options, model = list(self.layouts), list(self.options), self.system["model"]
        try:
            cmd = kb.localectl_cmd(layouts, options, model)
        except kb.KeyboardError as e:
            self.status.set_text(str(e))
            return
        self.busy = True
        self.update()
        self.spinner.start()
        self.status.set_text(_("Saving…"))

        def work():
            # localectl ceka na overeni (polkit) - mimo hlavni vlakno
            rc, out = run(cmd, timeout=180)
            if rc == 0:
                run(["xfconf-query", "-c", "keyboard-layout", "-p", "/Default/XkbDisable", "-n", "-t", "bool",
                     "-s", "true"], 5)
                run(kb.setxkbmap_cmd(layouts, options), 10)
            GLib.idle_add(done, rc, out)

        def done(rc, out):
            self.busy = False
            self.spinner.stop()
            if rc == 0:
                self.system = {"layouts": layouts, "model": model, "options": options}
                self.override = False
                self.applied = True
                self.status.set_text(_("Saved for all users and the login screen."))
            elif "denied" in out.lower() or "not authorized" in out.lower() or "dismissed" in out.lower():
                self.status.set_text(_("Not saved: administrator authentication was cancelled."))
            else:
                self.status.set_text(_("Could not save the keyboard layouts: %s") % (out.splitlines() or ["?"])[-1])
            self.update()
            return False
        threading.Thread(target=work, daemon=True).start()

    def on_close(self, *_a):
        # Nepouzite zmeny: vratit relaci do posledniho pouziteho stavu (nebo stavu pred otevrenim okna)
        back = self.system if self.applied else self.session
        if self.dirty() and back:
            try:
                run(kb.setxkbmap_cmd(back["layouts"], back["options"]), 10)
            except kb.KeyboardError:
                pass
        return False


def main():
    GLib.set_prgname("luxos-keyboard")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = KeyboardSettings()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.update()
    Gtk.main()


if __name__ == "__main__":
    main()
