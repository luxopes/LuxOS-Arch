#!/usr/bin/env python3
"""LuxOS - Zpetna vazba: hlaseni chyb a napadu primo autorovi LuxOS.

  luxos-feedback               okno (chyba / napad / neco jineho)
  luxos-feedback --send-outbox odesle ulozena hlaseni bez okna (napr. po pripojeni)

Hlaseni jde na POST https://lux-ai.cz/api/feedback (JSON). Prihlaseny ucet LuxAI se
prilozi jako cookie (stejne jako v ostatnich aplikacich), jinak je hlaseni anonymni.
Bez internetu se ulozi do ~/.local/share/luxos/feedback-outbox a odesle se pri
dalsim spusteni. Systemove udaje jsou bez osobnich souboru, tokenu, e-mailu a cesty domu.
"""
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/lib/luxos/python")
import luxai_account as acc  # noqa: E402
from luxos_i18n import _  # noqa: E402

ENDPOINT = "/api/feedback"
APP = "luxos-feedback"
OUTBOX = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "luxos/feedback-outbox")
MIN_LEN, MAX_LEN = 10, 8000
# pacman z jadra lux (lux-engine, mimo PATH) - jen dotazy na verze baliku
PACMAN = "/usr/lib/lux/alpm/bin/pacman" if os.access("/usr/lib/lux/alpm/bin/pacman", os.X_OK) else "pacman"
SYSTEM_MAX = 30000        # server bere nejvys ~32 KB
SHOT_WIDTH, SHOT_MAX = 1280, 1_400_000   # WEDOS proxy nema rada velka tela
KINDS = (
    ("bug", "Bug", "Something doesn't work", "dialog-error-symbolic",
     "What happened? What did you expect? Steps to reproduce help a lot."),
    ("idea", "Idea", "Suggest an improvement", "starred-symbolic",
     "What would you like to improve? How would it help you?"),
    ("other", "Something else", "Question or comment", "dialog-question-symbolic",
     "Write your message…"),
)
ERRORS = {
    "rate": "You have sent many reports in a short time. Please try again later.",
    "message_length": "The message must have 10 to 8000 characters.",
    "invalid_contact": "The e-mail address does not look valid.",
    "too_large": "The report is too large. Try it without the screenshot.",
    "invalid_screenshot": "The screenshot could not be accepted. Try it without the screenshot.",
}


def run(*cmd, timeout=8):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return ""


# ---- systemove udaje (bez osobnich dat) ---------------------------------------------
HOME = os.path.expanduser("~")
USER = os.environ.get("USER") or os.path.basename(HOME)
HOST = socket.gethostname()
RE_EMAIL = re.compile(r"[\w.+-]+@[\w-]+(\.[\w-]+)+")
RE_SECRET = re.compile(r"(?i)\b(token|password|passwd|secret|cookie|session|authorization|api[_-]?key)\b(\s*[=:]\s*)\S+")
RE_LONG = re.compile(r"[A-Za-z0-9_\-+=]{32,}")   # bez "/" - cesty nechat citelne
RE_IP = re.compile(r"(?<![\w.-])\d{1,3}(\.\d{1,3}){3}(?!\w|\.\d)")
RE_MAC = re.compile(r"\b[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}\b")


def redact(text):
    """Odstrani cestu domu, jmeno uzivatele/pocitace, e-maily, IP/MAC a vse, co vypada jako tajny klic."""
    text = text.replace(HOME, "~")
    text = RE_EMAIL.sub("<email>", text)
    text = RE_SECRET.sub(lambda m: m.group(1) + m.group(2) + "<redacted>", text)
    text = RE_LONG.sub("<redacted>", text)
    text = RE_MAC.sub("<mac>", text)
    text = RE_IP.sub("<ip>", text)
    for word, repl in ((USER, "<user>"), (HOST, "<host>")):
        if len(word) >= 3:
            text = re.sub(r"(?<![\w-])" + re.escape(word) + r"(?![\w-])", repl, text)
    return text


def log_lines(text, n=50):
    lines = [redact(line)[:300] for line in text.splitlines() if line.strip() and not line.startswith("-- ")]
    return lines[-n:]


def collect_system():
    """Slovnik presne toho, co se odesle (zobrazuje se i v okne)."""
    osr = {}
    for line in read("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            osr[k] = v.strip('"')
    mem = re.search(r"MemTotal:\s+(\d+)", read("/proc/meminfo"))
    cpu = re.search(r"model name\s*:\s*(.+)", read("/proc/cpuinfo"))
    gpu = [re.sub(r" \(rev .*\)$", "", line.split(": ", 1)[-1])
           for line in run("lspci").splitlines() if re.search(r"VGA|3D|Display", line)]
    pkgs = {}
    for line in run(PACMAN, "-Q").splitlines():
        name, _sp, ver = line.partition(" ")
        if re.match(r"^(luxos|lux$|lux-|luxai|lsl|linux$|linux-lts$|linux-zen$|mesa$|xorg-server$|xfce4-session$)", name):
            pkgs[name] = ver
    disk = os.statvfs("/")
    info = {
        "os": osr.get("PRETTY_NAME", "LuxOS"),
        "osVersion": osr.get("VERSION_ID", ""),
        "osBuild": osr.get("BUILD_ID") or osr.get("VERSION_ID") or "",
        "kernel": os.uname().release,
        "computer": " ".join(x for x in (read("/sys/class/dmi/id/sys_vendor"),
                                          read("/sys/class/dmi/id/product_name")) if x),
        "cpu": re.sub(r"\s+", " ", cpu.group(1)) if cpu else "",
        "cpuCores": os.cpu_count() or 0,
        "gpu": gpu[:3],
        "memoryGB": round(int(mem.group(1)) / 1024 / 1024, 1) if mem else 0,
        "diskFreeGB": round(disk.f_bavail * disk.f_frsize / 1e9, 1),
        "session": " ".join(x for x in (os.environ.get("XDG_CURRENT_DESKTOP", ""),
                                         os.environ.get("XDG_SESSION_TYPE", "")) if x),
        "language": os.environ.get("LANG", ""),
        "uptimeMin": int(float((read("/proc/uptime") or "0").split()[0]) // 60),
        "packages": pkgs,
        "userErrors": log_lines(run("journalctl", "--user", "-b", "-p", "err", "-n", "50", "--no-pager",
                                    "-o", "short", timeout=10)),
        "systemErrors": log_lines(run("journalctl", "-b", "-p", "err", "-n", "50", "--no-pager",
                                      "-o", "short", timeout=10)),
        "xsessionErrors": log_lines(read(os.path.join(HOME, ".xsession-errors"))),
    }
    # Systemovy zurnal muze obsahovat i radky uzivatelskeho - neposilat je dvakrat
    seen = set(info["userErrors"])
    info["systemErrors"] = [line for line in info["systemErrors"] if line not in seen]
    # Limit velikosti: nejdriv zkratit logy
    while len(json.dumps(info, ensure_ascii=False).encode()) > SYSTEM_MAX:
        longest = max(("userErrors", "systemErrors", "xsessionErrors"), key=lambda k: len(info[k]))
        if not info[longest]:
            break
        info[longest] = info[longest][len(info[longest]) // 2 + 1:]
    return info


def app_version():
    out = run(PACMAN, "-Q", "luxos-desktop")
    return out.split(" ", 1)[1] if " " in out else ""


# ---- odeslani a fronta ---------------------------------------------------------------
def send(payload):
    """Odesle hlaseni; vraci id. Pri vypadku site / chybe serveru zkusi jeste jednou."""
    account = acc.load()
    token = account["sessionToken"] if account else None
    origin = (account or {}).get("origin", acc.ORIGIN)
    for attempt in (1, 2):
        try:
            r = acc.request("POST", ENDPOINT, payload, token=token, origin=origin, timeout=45)
            return r.get("id") or ""
        except acc.AccountError as e:
            retry = e.code == "network" or e.status >= 500
            if attempt == 2 or not retry:
                raise
            time.sleep(2)
    return ""


def save_outbox(payload):
    os.makedirs(OUTBOX, mode=0o700, exist_ok=True)
    path = os.path.join(OUTBOX, time.strftime("%Y%m%d-%H%M%S-") + os.urandom(4).hex() + ".json")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(payload, f, ensure_ascii=False)
    return path


def flush_outbox():
    """Odesle ulozena hlaseni; vraci pocet odeslanych. Pri vypadku site skonci."""
    try:
        names = sorted(n for n in os.listdir(OUTBOX) if n.endswith(".json"))
    except OSError:
        return 0
    sent = 0
    for name in names:
        path = os.path.join(OUTBOX, name)
        try:
            with open(path) as f:
                payload = json.load(f)
        except (OSError, ValueError):
            os.replace(path, path + ".bad")
            continue
        try:
            send(payload)
        except acc.AccountError as e:
            if e.code == "network" or e.status >= 500 or e.status == 429:
                break
            os.replace(path, path + ".rejected")   # server ho odmitl - neposilat porad dokola
            continue
        os.unlink(path)
        sent += 1
    return sent


if len(sys.argv) > 1 and sys.argv[1] == "--send-outbox":
    print(flush_outbox())
    sys.exit(0)

import base64  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

CSS = b"""
