.dim { opacity: 0.65; }
.kind { border-radius: 14px; padding: 12px 8px; background-image: none; box-shadow: none;
        border: 2px solid alpha(currentColor, 0.10); background-color: alpha(currentColor, 0.04); }
.kind:hover { background-color: alpha(currentColor, 0.08); }
.kind:checked { border-color: #3d7bff; background-color: alpha(#3d7bff, 0.14); color: inherit; }
.kind:checked image { color: #3d7bff; }
.kind-title { font-weight: 700; }
.kind-sub { font-size: 11px; opacity: 0.65; }
.editor, .editor > border { border-radius: 12px; border: 1px solid alpha(currentColor, 0.15); }
.editor scrolledwindow, .editor textview, .editor text { border-radius: 12px; }
.editor textview, .editor text { background-color: transparent; }
