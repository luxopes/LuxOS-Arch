def label(text, cls=None, **kw):
    lbl = Gtk.Label(label=text, xalign=kw.pop("xalign", 0), wrap=kw.pop("wrap", True), **kw)
    if cls:
        lbl.get_style_context().add_class(cls)
    return lbl


def human(err):
    if err.code in ERRORS:
        return _(ERRORS[err.code])
    if err.code == "network":
        return _("LuxOS could not reach the server. Check the internet connection.")
    return _("Sending failed (%s).") % err.code


class FeedbackWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Feedback"))
        self.set_default_size(580, 720)
        self.set_icon_name("luxos-feedback")
        self.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=_("Feedback")))
        self.kind = "bug"
        self.shot = None          # JPEG bajty snimku
        self.system = None        # dict systemovych udaju
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.add(self.stack)
        self.build_form()
        self.stack.add_named(self.form, "form")
        threading.Thread(target=self.load_system, daemon=True).start()
        threading.Thread(target=self.flush_saved, daemon=True).start()

    # ---- formular ----
    def build_form(self):
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=22)
        scroll.add(box)
        self.form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.form.pack_start(scroll, True, True, 0)

        self.info = label("", "info")
        self.info.set_no_show_all(True)
        box.pack_start(self.info, False, False, 0)
        box.pack_start(label(_("Help us improve LuxOS"), "title"), False, False, 0)
        box.pack_start(label(_("Your report goes directly to the author of LuxOS."), "dim"), False, False, 0)

        cards = Gtk.Box(spacing=10, homogeneous=True, margin_top=6)
        group = None
        self.kind_buttons = {}
        for key, title, sub, icon, _hint in KINDS:
            b = Gtk.RadioButton(group=group, draw_indicator=False)
            group = group or b
            b.get_style_context().add_class("kind")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            inner.pack_start(Gtk.Image(icon_name=icon, pixel_size=26), False, False, 2)
            inner.pack_start(label(_(title), "kind-title", xalign=0.5, justify=Gtk.Justification.CENTER),
                             False, False, 0)
            inner.pack_start(label(_(sub), "kind-sub", xalign=0.5, justify=Gtk.Justification.CENTER),
                             False, False, 0)
            b.add(inner)
            b.connect("toggled", self.kind_changed, key)
            self.kind_buttons[key] = b
            cards.pack_start(b, True, True, 0)
        box.pack_start(cards, False, False, 0)

        # Text s napovedou (GTK3 TextView nema placeholder - prekryvny popisek)
        self.text = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=10, right_margin=10,
                                 top_margin=8, bottom_margin=8, accepts_tab=False)
        self.text.get_buffer().connect("changed", self.validate)
        tscroll = Gtk.ScrolledWindow(min_content_height=170, hscrollbar_policy=Gtk.PolicyType.NEVER)
        tscroll.add(self.text)
        self.placeholder = label("", "placeholder", valign=Gtk.Align.START, margin_start=12, margin_top=8,
                                 margin_end=12)
        overlay = Gtk.Overlay()
        overlay.add(tscroll)
        overlay.add_overlay(self.placeholder)
        overlay.set_overlay_pass_through(self.placeholder, True)
        frame = Gtk.Frame()
        frame.get_style_context().add_class("editor")
        frame.add(overlay)
        box.pack_start(frame, False, False, 0)
        self.counter = label("", "dim", xalign=1)
        box.pack_start(self.counter, False, False, 0)

        box.pack_start(label(_("Your e-mail (optional, if you would like a reply)"), "dim"), False, False, 0)
        self.contact = Gtk.Entry(placeholder_text="name@example.com", input_purpose=Gtk.InputPurpose.EMAIL)
        user = (acc.load() or {}).get("user") or {}
        self.contact.set_text(user.get("email", ""))
        self.contact.connect("changed", self.validate)
        box.pack_start(self.contact, False, False, 0)

        # Snimek obrazovky
        self.shot_check = Gtk.CheckButton(label=_("Attach a screenshot"))
        self.shot_check.connect("toggled", self.shot_toggled)
        box.pack_start(self.shot_check, False, False, 0)
        self.shot_row = Gtk.Box(spacing=12, margin_start=26)
        self.shot_img = Gtk.Image()
        self.shot_img.get_style_context().add_class("shot")
        retake = Gtk.Button(label=_("Take Again"), valign=Gtk.Align.CENTER)
        retake.connect("clicked", lambda _b: self.take_screenshot())
        self.shot_row.pack_start(self.shot_img, False, False, 0)
        self.shot_row.pack_start(retake, False, False, 0)
        self.shot_row.set_no_show_all(True)
        box.pack_start(self.shot_row, False, False, 0)

        # Systemove udaje
        self.sys_check = Gtk.CheckButton(label=_("Attach system information"), active=True)
        box.pack_start(self.sys_check, False, False, 0)
        box.pack_start(label(_("LuxOS and hardware versions and recent error messages. No personal files, "
                               "passwords or e-mail addresses."), "dim", margin_start=26), False, False, 0)
        exp = Gtk.Expander(label=_("Show what will be sent"), margin_start=26)
        self.sys_view = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.CHAR,
                                     left_margin=8, top_margin=6, bottom_margin=6)
        self.sys_view.get_style_context().add_class("sysinfo")
        self.sys_view.get_buffer().set_text(_("Collecting…"))
        sscroll = Gtk.ScrolledWindow(min_content_height=200, margin_top=6)
        sscroll.add(self.sys_view)
        exp.add(sscroll)
        box.pack_start(exp, False, False, 0)

        # Spodni lista
        bar = Gtk.Box(spacing=10, margin=14, margin_top=8)
        self.status = label("", "error", max_width_chars=36)
        self.spinner = Gtk.Spinner()
        self.send_btn = Gtk.Button(label=_("Send"))
        self.send_btn.get_style_context().add_class("primary")
        self.send_btn.connect("clicked", self.on_send)
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda _b: self.close())
        bar.pack_start(self.status, True, True, 0)
        bar.pack_end(self.send_btn, False, False, 0)
        bar.pack_end(cancel, False, False, 0)
        bar.pack_end(self.spinner, False, False, 0)
        self.form.pack_start(Gtk.Separator(), False, False, 0)
        self.form.pack_start(bar, False, False, 0)
        self.kind_changed(self.kind_buttons["bug"], "bug")

    def kind_changed(self, button, key):
        if not button.get_active():
            return
        self.kind = key
        self.placeholder.set_text(_(next(k[4] for k in KINDS if k[0] == key)))
        self.validate()

    def message(self):
        buf = self.text.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()

    def validate(self, *_a):
        n = len(self.message())
        self.placeholder.set_visible(not self.text.get_buffer().get_char_count())
        self.counter.set_text(_("At least %d characters") % MIN_LEN if n < MIN_LEN else f"{n} / {MAX_LEN}")
        contact = self.contact.get_text().strip()
        ok_contact = not contact or bool(re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", contact))
        self.send_btn.set_sensitive(MIN_LEN <= n <= MAX_LEN and ok_contact and not self.spinner.get_property("active"))

    # ---- snimek obrazovky (po skryti okna) ----
    def shot_toggled(self, check):
        if check.get_active():
            self.take_screenshot()
        else:
            self.shot = None
            self.shot_row.hide()

    def take_screenshot(self):
        self.hide()
        GLib.timeout_add(600, self.capture)

    def capture(self):
        try:
            root = Gdk.get_default_root_window()
            pb = Gdk.pixbuf_get_from_window(root, 0, 0, root.get_width(), root.get_height())
            data = b""
            if pb:
                w, h = pb.get_width(), pb.get_height()
                for width, quality in ((SHOT_WIDTH, "75"), (1024, "60"), (800, "50")):
                    scale = min(1.0, width / w)
                    small = pb.scale_simple(max(1, int(w * scale)), max(1, int(h * scale)),
                                            GdkPixbuf.InterpType.BILINEAR)
                    ok, data = small.save_to_bufferv("jpeg", ["quality"], [quality])
                    if ok and len(data) * 4 / 3 < SHOT_MAX:
                        break
            self.shot = bytes(data) if data else None
        except GLib.Error:
            self.shot = None
        self.show()
        self.present()
        if self.shot:
            loader = GdkPixbuf.PixbufLoader.new_with_type("jpeg")
            loader.write(self.shot)
            loader.close()
            pb = loader.get_pixbuf()
            self.shot_img.set_from_pixbuf(pb.scale_simple(200, max(1, int(200 * pb.get_height() / pb.get_width())),
                                                          GdkPixbuf.InterpType.BILINEAR))
            self.shot_row.set_no_show_all(False)
            self.shot_row.show_all()
        else:
            self.shot_check.set_active(False)
            self.status.set_text(_("The screenshot could not be taken."))
        return False

    # ---- systemove udaje ----
    def load_system(self):
        info = collect_system()

        def done():
            self.system = info
            self.sys_view.get_buffer().set_text(json.dumps(info, indent=2, ensure_ascii=False))
            return False
        GLib.idle_add(done)

    def flush_saved(self):
        n = flush_outbox()
        if n:
            GLib.idle_add(lambda: self.info.set_text(
                _("%d saved report(s) from earlier have been sent. Thank you!") % n) or self.info.show() or False)

    # ---- odeslani ----
    def payload(self):
        """Hlaseni z formulare (volat v hlavnim vlakne); systemove udaje doplni vlakno."""
        p = {"kind": self.kind, "message": self.message(), "app": APP}
        contact = self.contact.get_text().strip()
        if contact:
            p["contact"] = contact
        if self.sys_check.get_active():
            p["system"] = self.system
        if self.shot:
            p["screenshot"] = "data:image/jpeg;base64," + base64.b64encode(self.shot).decode()
        return p

    def on_send(self, _b):
        self.spinner.start()
        self.send_btn.set_sensitive(False)
        self.status.set_text(_("Sending…"))
        self.status.get_style_context().remove_class("error")

        p = self.payload()

        def work():
            p["version"] = app_version()
            if "system" in p and p["system"] is None:
                p["system"] = collect_system()
            try:
                rid, err, saved = send(p), None, False
            except acc.AccountError as e:
                rid, err, saved = "", e, False
                if e.code == "network" or e.status >= 500:
                    try:
                        save_outbox(p)
                        saved = True
                    except OSError:
                        pass
            GLib.idle_add(self.sent, rid, err, saved)
        threading.Thread(target=work, daemon=True).start()

    def sent(self, rid, err, saved):
        self.spinner.stop()
        if err and not saved:
            self.status.get_style_context().add_class("error")
            self.status.set_text(human(err))
            self.status.set_tooltip_text(human(err))
            self.send_btn.set_label(_("Try Again"))
            self.validate()
            return False
        self.show_done(rid, saved)
        return False

    def show_done(self, rid, saved):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=40, valign=Gtk.Align.CENTER)
        icon = Gtk.Image(icon_name="emblem-ok-symbolic" if not saved else "mail-send-symbolic", pixel_size=72)
        icon.get_style_context().add_class("ok-icon")
        box.pack_start(icon, False, False, 0)
        if saved:
            title, text = _("Saved for later"), _("You are offline. The report will be sent automatically "
                                                  "the next time you open Feedback with an internet connection.")
        else:
            title, text = _("Thank you for your feedback!"), _("Your report has been delivered to the author "
                                                              "of LuxOS. Every report helps make LuxOS better.")
        box.pack_start(label(title, "done-title", xalign=0.5), False, False, 0)
        box.pack_start(label(text, "dim", xalign=0.5, justify=Gtk.Justification.CENTER), False, False, 0)
        if rid:
            rl = label(_("Report ID: %s") % rid, "dim", xalign=0.5, selectable=True)
            box.pack_start(rl, False, False, 0)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_top=12)
        another = Gtk.Button(label=_("Send Another"))
        another.connect("clicked", self.reset)
        close = Gtk.Button(label=_("Close"))
        close.get_style_context().add_class("primary")
        close.connect("clicked", lambda _b: self.close())
        row.pack_start(another, False, False, 0)
        row.pack_start(close, False, False, 0)
        box.pack_start(row, False, False, 0)
        old = self.stack.get_child_by_name("done")
        if old:
            self.stack.remove(old)
        self.stack.add_named(box, "done")
        box.show_all()
        self.stack.set_visible_child_name("done")

    def reset(self, _b):
        self.text.get_buffer().set_text("")
        self.shot_check.set_active(False)
        self.status.set_text("")
        self.send_btn.set_label(_("Send"))
        self.stack.set_visible_child_name("form")
        self.validate()


def main():
    GLib.set_prgname("luxos-feedback")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = FeedbackWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.validate()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
