#!/usr/bin/env python3
"""LuxOS - jeden lehky proces relace misto nekolika samostatnych procesu na pozadi.

Drzi v pameti (sdilene GTK a Python) skryte okno Ovladaciho centra a Kalendare,
aby se po kliknuti v liste ukazaly okamzite, a k tomu hlida udalosti, ktere
driv obstaravaly samostatne smycky:

  SIGUSR1           prepne Ovladaci centrum (luxos-cc-toggle)
  SIGUSR2           prepne Kalendar (luxos-calendar-toggle)
  Trezor            zamkne pri zamceni obrazovky a pred uspanim (luxos-safe)
  Sporic dat        nove pripojena sit se hned oznaci jako merena
  Pamet             upozorneni, kdyz pojistka earlyoom ukonci program (nedostatek pameti)
  Internet          "!" v liste a upozorneni, kdyz je sit bez internetu (luxos-netcheck)
  Bluetooth         agent pro parovani z telefonu a sluchatek (misto blueman-applet)
  Svetly/tmavy      automaticky rezim podle vychodu a zapadu slunce
  Prehravani       pri hrajici hudbe/videu neuspava (ani zavreny vik), viz KeepAwake
  Ovladace          jednou za start upozorneni na chybejici ovladace (luxos-drivers)

Vsechno je rizene udalostmi (D-Bus, signaly); jediny casovac je kontrola
automatickeho vzhledu jednou za 5 minut, bez spousteni dalsich procesu.
"""
import importlib.machinery
import importlib.util
import os
import signal
import subprocess
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxos")
PIDFILES = [os.path.join(RUNTIME, n) for n in ("luxos-hub.pid", "luxos-control-center.pid",
                                                 "luxos-calendar.pid")]


def log(msg):
    print(f"luxos-hub: {msg}", file=sys.stderr, flush=True)


def load(name, path):
    """Nacte program LuxOS (soubor bez .py) jako modul; main() se nespousti."""
    if not os.path.exists(path):
        return None
    try:
        loader = importlib.machinery.SourceFileLoader(name, path)
        spec = importlib.util.spec_from_loader(name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception as e:  # noqa: BLE001 - jedna cast nesmi shodit ostatni
        log(f"{path}: {e}")
        return None


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        log(f"{cmd[0]}: {e}")


def signal_add(sig, cb):
    """Signal v hlavni smycce GLib (GLibUnix v novych PyGObject, jinak starsi GLib)."""
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_HIGH, sig, cb)
    except (ImportError, ValueError, AttributeError):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, cb)


def debounce(ms, fn):
    """Volani fn nejdriv po ms od posledni udalosti (davky signalu -> jedna akce)."""
    state = {}

    def fire():
        state.pop("id", None)
        fn()
        return False

    def trigger(*_a):
        if "id" in state:
            GLib.source_remove(state["id"])
        state["id"] = GLib.timeout_add(ms, fire)
    return trigger


# ---- Internet nedostupny: "!" v liste (luxos-netcheck) a jedno upozorneni ------------------
NM_CONNECTIVITY_FULL = 4


def panel_xfconf(*args):
    try:
        r = subprocess.run(("xfconf-query", "-c", "xfce4-panel") + args, capture_output=True, text=True, timeout=5)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def netcheck_plugin():
    """Id pluginu genmon s luxos-netcheck; starsim profilum ho jednou prida vedle ikon (systray)."""
    props = panel_xfconf("-l", "-p", "/plugins") or ""
    for prop in props.splitlines():
        if prop.endswith("/command") and (panel_xfconf("-p", prop) or "").startswith("luxos-netcheck"):
            return prop.split("/")[2].split("-")[1]
    mark = os.path.join(CFG, "netcheck-added")
    if os.path.exists(mark):
        return None                     # uzivatel ho z listy odebral
    ids = [int(p.split("-")[1]) for p in props.splitlines() if p.count("/") == 2 and p.startswith("/plugins/plugin-")]
    tray = next((p.split("-")[1] for p in props.splitlines()
                 if p.count("/") == 2 and panel_xfconf("-p", p) == "systray"), None)
    if not ids or tray is None:
        return None
    new = max(ids) + 1
    for panel in (panel_xfconf("-l", "-p", "/panels") or "").splitlines():
        if not panel.endswith("/plugin-ids"):
            continue
        order = (panel_xfconf("-p", panel) or "").split()
        order = [v for v in order if v.isdigit()]
        if tray not in order:
            continue
        order.insert(order.index(tray) + 1, str(new))
        base = f"/plugins/plugin-{new}"
        panel_xfconf("-p", base, "-n", "-t", "string", "-s", "genmon")
        panel_xfconf("-p", base + "/command", "-n", "-t", "string", "-s", "luxos-netcheck")
        panel_xfconf("-p", base + "/update-period", "-n", "-t", "int", "-s", "86400000")
        panel_xfconf("-p", base + "/use-label", "-n", "-t", "bool", "-s", "false")
        panel_xfconf("-p", base + "/enable-single-row", "-n", "-t", "bool", "-s", "true")
        args = ["-p", panel, "--force-array"]
        for v in order:
            args += ["-t", "int", "-s", v]
        panel_xfconf(*args)
        open(mark, "w").close()
        spawn("xfce4-panel", "-r")
        return str(new)
    return None


def watch_connectivity(system):
    state = {"plugin": None, "last": None}
    session = Gio.bus_get_sync(Gio.BusType.SESSION)

    def connectivity():
        try:
            r = system.call_sync("org.freedesktop.NetworkManager", "/org/freedesktop/NetworkManager",
                                 "org.freedesktop.DBus.Properties", "Get",
                                 GLib.Variant("(ss)", ("org.freedesktop.NetworkManager", "Connectivity")),
                                 None, 0, 3000, None)
            return r.unpack()[0]
        except GLib.Error:
            return None

    def update():
        if state["plugin"] is None:
            state["plugin"] = netcheck_plugin()
        if state["plugin"]:
            try:
                session.call_sync("org.xfce.Panel", "/org/xfce/Panel", "org.xfce.Panel", "PluginEvent",
                                  GLib.Variant("(ssv)", (f"genmon-{state['plugin']}", "refresh", GLib.Variant("b", True))),
                                  None, 0, 2000, None)
            except GLib.Error:
                pass
        c = connectivity()
        # 2 = prihlaseni do site (portal), 3 = bez internetu; jedno upozorneni na kazdou zmenu
        if c in (2, 3) and state["last"] not in (2, 3):
            spawn("notify-send", "-a", "LuxOS", "-i", "luxos-network-no-internet-symbolic",
                  _("No internet connection"),
                  _("Sign in to the network to use the internet.") if c == 2
                  else _("You are connected to the network, but the internet is not available."))
        state["last"] = c
        return False

    refresh = debounce(1000, update)
    GLib.timeout_add_seconds(8, update)     # po prihlaseni (panel uz bezi)

    def on_props(_c, _s, _p, _i, _sig, params):
        iface, changed, _inv = params.unpack()
        if iface == "org.freedesktop.NetworkManager" and ("Connectivity" in changed or "State" in changed):
            refresh()
    system.signal_subscribe("org.freedesktop.NetworkManager", "org.freedesktop.DBus.Properties",
                            "PropertiesChanged", "/org/freedesktop/NetworkManager", None, 0, on_props)


# ---- Nedostatek pameti: upozorneni od pojistky earlyoom (luxos-tweaks) ------------------
def watch_low_memory(system):
    import re
    last = {}

    def on_notify(_c, _s, _p, _i, _sig, params):
        text = " ".join(str(v) for v in params.unpack())
        m = re.search(r"process (\d+) (.+?)(?:[.,;]|$)", text)
        name = m.group(2).strip() if m else ""
        # davka signalu pri jednom zasahu -> jedno upozorneni
        if last.get("name") == name and GLib.get_monotonic_time() - last.get("t", 0) < 10_000_000:
            return
        last.update(name=name, t=GLib.get_monotonic_time())
        body = (_("“%s” used too much memory and was closed so the computer would not freeze.") % name
                if name else _("A program used too much memory and was closed so the computer would not freeze."))
        spawn("notify-send", "-a", "LuxOS", "-u", "critical", "-i", "dialog-warning",
              _("Memory is running low"), body)
    system.signal_subscribe(None, "net.nuetzlich.SystemNotifications", "Notify", None, None, 0, on_notify)


# ---- Sporic dat: merene pripojeni i pro nove pripojene site ---------------------------
def watch_networks(system):
    reapply = debounce(2000, lambda: os.path.exists(os.path.join(CFG, "datasaver"))
                       and spawn("luxos-datasaver", "reapply"))

    def on_props(_c, _s, _p, _i, _sig, params):
        iface, changed, _inv = params.unpack()
        if iface == "org.freedesktop.NetworkManager" and "ActiveConnections" in changed:
            reapply()
    system.signal_subscribe("org.freedesktop.NetworkManager", "org.freedesktop.DBus.Properties",
                            "PropertiesChanged", "/org/freedesktop/NetworkManager", None, 0, on_props)


# ---- Bluetooth: parovani a pripojeni z telefonu i bez otevrene aplikace -----------------
class BluetoothAgent:
    """Vychozi agent BlueZ na pozadi (misto blueman-applet). Dialogy a kody bere z luxos-bluetooth;
    na rozdil od aplikace se pred parovanim bez kodu a sluzbou neduveryhodneho zarizeni zepta."""

    def __init__(self, bus, mod):
        self.bus = bus
        self.mod = mod
        self.ui = mod.Agent.__new__(mod.Agent)      # jen dialogy a on_call, bez registrace
        self.ui.window = None
        node = Gio.DBusNodeInfo.new_for_xml(mod.AGENT_XML)
        bus.register_object(mod.AGENT_PATH, node.interfaces[0], self.on_call, None, None)

    def register(self):
        mgr = ("org.bluez", "/org/bluez", "org.bluez.AgentManager1")
        try:
            self.bus.call_sync(*mgr, "RegisterAgent", GLib.Variant("(os)", (self.mod.AGENT_PATH, "KeyboardDisplay")),
                               None, 0, 3000, None)
            self.bus.call_sync(*mgr, "RequestDefaultAgent", GLib.Variant("(o)", (self.mod.AGENT_PATH,)),
                               None, 0, 3000, None)
        except GLib.Error as e:
            log(f"bluetooth agent: {e.message}")

    def device(self, path):
        try:
            r = self.bus.call_sync("org.bluez", path, "org.freedesktop.DBus.Properties", "GetAll",
                                   GLib.Variant("(s)", ("org.bluez.Device1",)), None, 0, 3000, None)
            props = r.unpack()[0]
        except GLib.Error:
            props = {}
        return props.get("Alias") or props.get("Name") or path.rsplit("/", 1)[-1], bool(props.get("Trusted"))

    def on_call(self, conn, sender, path, iface, method, params, inv):
        if method in ("RequestAuthorization", "AuthorizeService"):
            name, trusted = self.device(params.unpack()[0])
            if method == "AuthorizeService" and trusted:
                inv.return_value(None)
                return
            text = (_("Allow “%s” to pair with this computer?") if method == "RequestAuthorization"
                    else _("Allow “%s” to connect?")) % name
            ok, _v = self.ui.dialog(text, _("Only allow devices you know."), ok_label=_("Allow"))
            if ok:
                inv.return_value(None)
            else:
                inv.return_dbus_error("org.bluez.Error.Rejected", _("Rejected"))
            return
        self.ui.on_call(conn, sender, path, iface, method, params, inv)


def watch_bluetooth(system):
    state = {}

    def appeared(*_a):
        if "agent" not in state:
            mod = load("luxos_bluetooth_app", "/usr/bin/luxos-bluetooth")
            if mod is None:
                return
            try:
                state["agent"] = BluetoothAgent(system, mod)
            except (GLib.Error, AttributeError) as e:
                log(f"bluetooth: {e}")
                return
        state["agent"].register()
    # BlueZ bezi jen s adapterem (i USB pripojenym pozdeji)
    state["watch"] = Gio.bus_watch_name_on_connection(system, "org.bluez", Gio.BusNameWatcherFlags.NONE,
                                                     appeared, None)


# ---- Neuspavat pri prehravani hudby/videa (i se zavrenym vikem) ------------------------
# Vikem i necinnosti uspava xfce4-power-manager (drzi si inhibitor handle-lid-switch v logind,
# takze inhibitor logind by nepomohl). Behem prehravani proto docasne nastavime jeho akci
# vika na "vypnout obrazovku" (0) a uspani pri necinnosti na "nikdy" (14); puvodni hodnoty
# jsou v SLEEP_OVERRIDE (obnovi se i po padu, pri dalsim startu). xfce4-power-manager cte
# nastaveni az v okamziku udalosti, takze zmena plati hned.
XFPM = "xfce4-power-manager"
SLEEP_OVERRIDE = os.path.join(CFG, "sleep-override")       # "vlastnost=puvodni hodnota"
SLEEP_WHILE_PLAYING = os.path.join(CFG, "sleep-while-playing")   # existuje = volba vypnuta
LID_PROPS = ("lid-action-on-battery", "lid-action-on-ac")
IDLE_PROPS = ("inactivity-on-battery", "inactivity-on-ac")
SLEEP_ACTIONS = (1, 2, 5)       # uspat, hibernovat, hybridni uspani (0 = vypnout obrazovku)
LID_SCREEN_OFF, IDLE_NEVER = 0, 14
PLAYBACK_GRACE = 30             # s ticha, nez se nastaveni vrati (mezery mezi skladbami, kratka pauza)


def read_override(path=SLEEP_OVERRIDE):
    vals = {}
    try:
        with open(path) as f:
            for line in f:
                k, _s, v = line.strip().partition("=")
                if v.isdigit():
                    vals[k] = int(v)
    except OSError:
        pass
    return vals


def write_override(vals, path=SLEEP_OVERRIDE):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(f"{k}={v}\n" for k, v in vals.items())
    os.replace(tmp, path)


def plan_override(current):
    """{vlastnost: hodnota} xfce4-power-manager -> {vlastnost: (puvodni, docasna)} pro dobu prehravani."""
    plan = {}
    for p in LID_PROPS:
        if current.get(p) in SLEEP_ACTIONS:
            plan[p] = (current[p], LID_SCREEN_OFF)
    for p in IDLE_PROPS:
        v = current.get(p)
        if v is not None and v > IDLE_NEVER:
            plan[p] = (v, IDLE_NEVER)
    return plan


def plan_restore(saved, current):
    """Co vratit: jen vlastnosti, ktere mezitim nikdo nezmenil (jinak plati novejsi volba uzivatele)."""
    temp = {p: (LID_SCREEN_OFF if p in LID_PROPS else IDLE_NEVER) for p in saved}
    return {p: v for p, v in saved.items() if current.get(p) in (temp[p], None)}


def lid_sleep_action(saved, on_battery, lid_closed, external_monitor):
    """Akce po skonceni prehravani se zavrenym vikem: "Suspend", "Hibernate" nebo None."""
    if not lid_closed or external_monitor:
        return None
    a = saved.get("lid-action-on-battery" if on_battery else "lid-action-on-ac")
    return {1: "Suspend", 5: "Suspend", 2: "Hibernate"}.get(a)


def external_monitor(base="/sys/class/drm"):
    """Pripojeny jiny nez vestaveny displej (s nim xfce4-power-manager vikem neuspava)."""
    try:
        names = os.listdir(base)
    except OSError:
        return False
    for n in names:
        if "-" not in n or any(t in n for t in ("-eDP", "-LVDS", "-DSI")):
            continue
        try:
            with open(os.path.join(base, n, "status")) as f:
                if f.read().strip() == "connected":
                    return True
        except OSError:
            continue
    return False


class KeepAwake:
    def __init__(self, session, system, watcher):
        self.session, self.system, self.watcher = session, system, watcher
        self.timer = 0
        self.engaged = False
        self.restore(sleep=False)           # zbytek po padu / odhlaseni behem prehravani
        watcher.connect(self.changed)
        self.monitor = Gio.File.new_for_path(SLEEP_WHILE_PLAYING).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_a: self.changed())
        self.changed()

    def xfconf(self, method, prop, value=None):
        args = (XFPM, f"/{XFPM}/{prop}") + ((value,) if value is not None else ())
        sig = "(ssv)" if value is not None else "(ss)"
        try:
            r = self.session.call_sync("org.xfce.Xfconf", "/org/xfce/Xfconf", "org.xfce.Xfconf", method,
                                       GLib.Variant(sig, args), None, 0, 3000, None)
            return r.unpack()[0] if value is None else True
        except GLib.Error:
            return None

    def current(self, props):
        vals = {}
        for p in props:
            v = self.xfconf("GetProperty", p)
            if isinstance(v, int):
                vals[p] = v
        return vals

    def changed(self):
        want = self.watcher.playing() and not os.path.exists(SLEEP_WHILE_PLAYING)
        if want:
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = 0
            # Jednou za prehravani (zmena metadat u dalsi skladby uz xfconf necte)
            if not self.engaged:
                self.engaged = True
                if not os.path.exists(SLEEP_OVERRIDE):
                    self.engage()
            return
        self.engaged = False
        if os.path.exists(SLEEP_OVERRIDE) and not self.timer:
            # Volbu uzivatel vypnul -> hned, jinak az po chvili ticha
            delay = 1 if os.path.exists(SLEEP_WHILE_PLAYING) else PLAYBACK_GRACE
            self.timer = GLib.timeout_add_seconds(delay, self.on_quiet)

    def engage(self):
        plan = plan_override(self.current(LID_PROPS + IDLE_PROPS))
        if not plan:
            return
        write_override({p: orig for p, (orig, _t) in plan.items()})
        for p, (_o, temp) in plan.items():
            self.xfconf("SetProperty", p, GLib.Variant("u", temp))

    def on_quiet(self):
        self.timer = 0
        if not self.watcher.playing() or os.path.exists(SLEEP_WHILE_PLAYING):
            self.restore(sleep=True)
        return False

    def upower(self, prop):
        try:
            r = self.system.call_sync("org.freedesktop.UPower", "/org/freedesktop/UPower",
                                      "org.freedesktop.DBus.Properties", "Get",
                                      GLib.Variant("(ss)", ("org.freedesktop.UPower", prop)), None, 0, 2000, None)
            return bool(r.unpack()[0])
        except GLib.Error:
            return False

    def restore(self, sleep):
        saved = read_override()
        if not saved:
            if os.path.exists(SLEEP_OVERRIDE):
                os.unlink(SLEEP_OVERRIDE)
            return
        for p, v in plan_restore(saved, self.current(saved)).items():
            self.xfconf("SetProperty", p, GLib.Variant("u", v))
        try:
            os.unlink(SLEEP_OVERRIDE)
        except OSError:
            pass
        if not sleep:
            return
        # Vik se zavrel behem prehravani: ted, kdyz hudba skoncila, uspat jako po zavreni vika
        action = lid_sleep_action(saved, self.upower("OnBattery"), self.upower("LidIsClosed"), external_monitor())
        if action:
            log(f"playback stopped with the lid closed: {action}")
            self.sleep(action)

    def sleep(self, action):
        # Pres xfce4-power-manager (zamkne obrazovku podle nastaveni), jinak primo logind
        try:
            self.session.call_sync("org.freedesktop.PowerManagement", "/org/freedesktop/PowerManagement",
                                   "org.freedesktop.PowerManagement", action, None, None, 0, 5000, None)
            return
        except GLib.Error as e:
            log(f"power manager {action}: {e.message}")
        try:
            self.system.call_sync("org.freedesktop.login1", "/org/freedesktop/login1",
                                  "org.freedesktop.login1.Manager", action, GLib.Variant("(b)", (False,)),
                                  None, 0, 5000, None)
        except GLib.Error as e:
            log(f"logind {action}: {e.message}")

    def shutdown(self):
        if os.path.exists(SLEEP_OVERRIDE):
            self.restore(sleep=False)


def watch_playback(system):
    try:
        import luxos_mpris
        return KeepAwake(Gio.bus_get_sync(Gio.BusType.SESSION), system, luxos_mpris.watcher())
    except (ImportError, GLib.Error) as e:
        log(f"playback: {e}")
        return None


# ---- Automaticky svetly/tmavy rezim ----------------------------------------------------
def appearance_check():
    prefs = {}
    try:
        with open(os.path.join(CFG, "appearance.conf")) as f:
            for line in f:
                k, _s, v = line.strip().partition("=")
                prefs[k] = v
    except OSError:
        pass
    if prefs.get("APPEARANCE_AUTO") != "1":
        return True
    try:
        import luxos_sun
        want = luxos_sun.mode()
        with open(os.path.join(CFG, "appearance")) as f:
            current = "dark" if f.read().strip() == "dark" else "light"
    except OSError:
        current = "light"
    except Exception as e:  # noqa: BLE001
        log(f"sun: {e}")
        return True
    if want != current:
        spawn("luxos-appearance", "auto")
    return True


def main():
    for p in PIDFILES:
        try:
            with open(p, "w") as f:
                f.write(str(os.getpid()))
        except OSError:
            pass
    GLib.set_prgname("luxos-hub")
    GLib.set_application_name("LuxOS")

    safe_mod = load("luxos_safe_app", "/usr/bin/luxos-safe")

    # Skryta okna Ovladaciho centra a Kalendare: vytvorit az po usazeni relace (nebrzdi prihlaseni),
    # nebo hned pri prvnim kliknuti, prijde-li driv. Pri chybe vytvoreni se program spusti samostatne.
    windows = {}
    APPS = {"cc": ("luxos_cc_app", "/usr/bin/luxos-control-center", {}),
            "cal": ("luxos_calendar_app", "/usr/bin/luxos-calendar", {"background": True})}

    def window(kind):
        if kind not in windows:
            name, path, kwargs = APPS[kind]
            windows[kind] = None
            mod = load(name, path)
            try:
                windows[kind] = mod.create(**kwargs) if mod else None
            except Exception as e:  # noqa: BLE001
                log(f"{kind}: {e}")
        return windows[kind]

    def prebuild():
        for kind in APPS:
            window(kind)
        return False
    GLib.timeout_add_seconds(6, prebuild)

    def toggle(kind, fallback):
        win = window(kind)
        if win is not None:
            win.toggle()
        else:
            spawn(fallback)
        return True
    signal_add(signal.SIGUSR1, lambda *_a: toggle("cc", "luxos-control-center"))
    signal_add(signal.SIGUSR2, lambda *_a: toggle("cal", "luxos-calendar"))
    signal_add(signal.SIGTERM, lambda *_a: Gtk.main_quit() or False)
    signal_add(signal.SIGINT, lambda *_a: Gtk.main_quit() or False)

    if safe_mod is not None:
        try:
            safe_mod.subscribe()
        except Exception as e:  # noqa: BLE001
            log(f"safe: {e}")

    # LuxOS Care (balik luxos-care): upozorneni na aktualizace a opravy, volba opravy pres LuxAI
    care_mod = load("luxos_care_session", "/usr/lib/luxos/python/luxos_care_session.py")
    if care_mod is not None:
        try:
            care_mod.subscribe()
        except Exception as e:  # noqa: BLE001
            log(f"care: {e}")

    # Ovladace (balik luxos-drivers): jednou za start upozorni na chybejici ovladace hardwaru
    drivers_mod = load("luxos_drivers_session", "/usr/lib/luxos/python/luxos_drivers_session.py")
    if drivers_mod is not None:
        try:
            drivers_mod.subscribe()
        except Exception as e:  # noqa: BLE001
            log(f"drivers: {e}")

    awake = None
    try:
        system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        watch_networks(system)
        watch_connectivity(system)
        watch_low_memory(system)
        watch_bluetooth(system)
        awake = watch_playback(system)

        # Po probuzeni (vecer otevreny notebook) hned zkontrolovat vzhled
        def on_sleep(_c, _s, _p, _i, _sig, params):
            if not params.unpack()[0]:
                GLib.timeout_add_seconds(3, lambda: appearance_check() and False)
        system.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                                "/org/freedesktop/login1", None, 0, on_sleep)
    except GLib.Error as e:
        log(f"system bus: {e}")
    GLib.timeout_add_seconds(300, appearance_check)

    try:
        Gtk.main()
    finally:
        if awake is not None:
            awake.shutdown()
        for p in PIDFILES:
            try:
                with open(p) as f:
                    if f.read().strip() == str(os.getpid()):
                        os.unlink(p)
            except OSError:
                pass


if __name__ == "__main__":
    main()
