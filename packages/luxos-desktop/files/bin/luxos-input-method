#!/usr/bin/env python3
"""LuxOS - metoda zadavani (psani vietnamsky pres fcitx5 + Bamboo), viz luxos_input_method.py.

  luxos-input-method status              aktivni metoda (vi, user nebo none) a zpusob psani
  luxos-input-method enable [vi] [--style Telex|VNI|VIQR]
  luxos-input-method disable
  luxos-input-method style Telex|VNI|VIQR
  luxos-input-method autostart           pri prihlaseni (xdg autostart): spusti fcitx5, jen kdyz ma bezet
"""
import os
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
import luxos_input_method as im  # noqa: E402

USAGE = "usage: luxos-input-method status | enable [vi] [--style Telex|VNI|VIQR] | disable | style STYLE | autostart"


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    cmd, args = argv[0], argv[1:]
    if os.geteuid() == 0 and cmd != "status":
        # nastaveni patri do domova uzivatele a fcitx5 do jeho relace - ne pod rootem
        print("luxos-input-method: run it as the user, not as root", file=sys.stderr)
        return 1
    try:
        if cmd == "status":
            a = im.active() or "none"
            print(f"input-method: {a}")
            if a == "vi":
                print(f"style: {im.style()}")
            print(f"installed: {'yes' if im.available() else 'no'}")
            return 0
        if cmd == "enable":
            lang, s = "vi", None
            while args:
                a = args.pop(0)
                if a == "--style" and args:
                    s = args.pop(0)
                elif a in im.LANGS:
                    lang = a
                else:
                    print(USAGE, file=sys.stderr)
                    return 2
            if not im.available(lang):
                print("luxos-input-method: fcitx5 or fcitx5-bamboo is not installed "
                      "(lux install fcitx5 fcitx5-gtk fcitx5-bamboo)", file=sys.stderr)
                return 1
            im.enable(lang, s)
            return 0
        if cmd == "disable" and not args:
            im.disable()
            return 0
        if cmd == "style" and len(args) == 1:
            im.set_style(args[0])
            return 0
        if cmd == "autostart" and not args:
            argv2 = im.autostart()
            if argv2:
                os.execv(argv2[0], argv2)
            return 0
    except (OSError, ValueError) as e:
        print(f"luxos-input-method: {e}", file=sys.stderr)
        return 2
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
