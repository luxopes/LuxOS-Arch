#!/bin/bash
# LuxOS - Launchpad (Super+A): mrizka aplikaci v panelu uprostred obrazovky
# Razeni dlazdic: tlacitka dole v Launchpadu (nebo Alt+1..4), pamatuje se pro uzivatele.
# Poradi pripravuje luxos_launchpad.py jako "historii" rofi (rofi3.druncache v -cache-dir);
# spusteni aplikaci se pocita jen mistne v ~/.local/share/luxos/launchpad-usage.json.
PY=${LUXOS_LAUNCHPAD_PY:-/usr/lib/luxos/python/luxos_launchpad.py}
conf=${XDG_CONFIG_HOME:-$HOME/.config}/luxos/launchpad-sort
cache=${XDG_CACHE_HOME:-$HOME/.cache}/luxos
run=${XDG_RUNTIME_DIR:-/tmp}/luxos-launchpad-$UID
modes=(alpha recent most category)

# poradi pro rofi: alpha = jen zarazka, ostatni pripravene po poslednim spusteni (jinak ted)
prepare_order() {
    # razeni podle kategorie: nove nainstalovana nebo odebrana aplikace (zmena slozky applications,
    # i odkazy na aplikace z Flathubu v /var/lib/luxos/apps) -> poradi znovu, jinak by nova aplikace
    # byla az na konci mrizky
    if [[ $sort == category && -e $cache/launchpad-order-$sort ]]; then
        local d dirs
        IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        for d in "${dirs[@]}"; do
            [[ -n $d && $d/applications -nt $cache/launchpad-order-$sort ]] || continue
            rm -f "$cache/launchpad-order-$sort"
            break
        done
    fi
    if [[ $sort == alpha ]]; then
        echo "0 luxos-launchpad-sentinel" >"$run/rofi3.druncache"
    elif [[ -s $cache/launchpad-order-$sort ]]; then
        cp "$cache/launchpad-order-$sort" "$run/rofi3.druncache"
    else
        python3 "$PY" order "$sort" "$cache/launchpad-order-$sort" 2>/dev/null &&
            cp "$cache/launchpad-order-$sort" "$run/rofi3.druncache"
    fi
    cp "$run/rofi3.druncache" "$run/before"
}

save_sort() {
    mkdir -p "${conf%/*}" && echo "$sort" >"$conf"
}

# Launchpad skryva panely Nastaveni (-drun-exclude-categories X-XFCE-SettingsDialog), ale tyto
# samostatne aplikace maji kategorii Nastaveni taky a v mrizce chybely. Pro rofi jejich kopie bez
# X-XFCE-SettingsDialog v $run/share pred systemovymi adresari: stejne desktop-id (pocty spusteni
# a razeni plati dal), menu, Hledani a Obchod se nemeni. Prepisuje se jen zmeneny soubor (cas
# zmeny slozky = nove razeni podle kategorie v prepare_order).
LAUNCHPAD_APPS=(luxos-companion luxos-bluetooth luxos-update luxos-firewall-settings luxos-account
                org.pulseaudio.pavucontrol)
launchpad_apps() {
    local out=$run/share/applications id d src f keep=" " sys=
    local -a dirs
    mkdir -p "$out" || return
    # bez vlastniho adresare (aplikace spustene z Launchpadu ho zdedi v XDG_DATA_DIRS)
    IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${dirs[@]}"; do
        [[ -n $d && $d != "$run/share" ]] && sys+=${sys:+:}$d
    done
    [[ -n $sys ]] || sys=/usr/local/share:/usr/share
    IFS=: read -ra dirs <<<"$sys"
    for id in "${LAUNCHPAD_APPS[@]}"; do
        src=
        for d in "${dirs[@]}"; do
            [[ -r $d/applications/$id.desktop ]] && { src=$d/applications/$id.desktop; break; }
        done
        [[ -n $src ]] || continue
        keep+="$id.desktop "
        f=$out/$id.desktop
        # docasny soubor mimo $out, jinak by se menil cas zmeny slozky i bez zmeny
        sed -E '/^Categories=/{s/([=;])X-XFCE-SettingsDialog(;|$)/\1/}' "$src" >"$run/launchpad-app.new" &&
            { cmp -s "$run/launchpad-app.new" "$f" || cp "$run/launchpad-app.new" "$f"; }
    done
    rm -f "$run/launchpad-app.new"
    # odinstalovana aplikace nebo odebrana ze seznamu
    for f in "$out"/*.desktop; do
        [[ -e $f && $keep != *" ${f##*/} "* ]] && rm -f "$f"
    done
    export XDG_DATA_DIRS="$run/share:$sys"
}

# --sort N (1..4): vola rofi (-custom-resort) po kliknuti na tlacitko / Alt+N - nova historie
# a ulozena volba; rofi pak preradi dlazdice na miste bez zavreni okna
if [[ $1 == --sort ]]; then
    [[ $2 == [1-4] ]] || exit 2
    sort=${modes[$2 - 1]}
    [[ -d $run ]] || exit 1
    save_sort
    prepare_order
    exit 0
fi

if pkill -x rofi; then exit 0; fi
. /usr/lib/luxos/i18n.sh 2>/dev/null || T() { printf "$@"; }
sort=most
[[ -r $conf ]] && read -r sort <"$conf"
[[ " ${modes[*]} " == *" $sort "* ]] || sort=most
mkdir -p -m 700 "$run" || exit 1
self=$0
launchpad_apps

base=(-theme-str "entry { placeholder: \"$(T "Search apps or ask LuxAI")\"; }")
[[ $(luxos-appearance status) == light ]] && base+=(-theme-str '@import "luxos-light-colors"')
labels=("$(T "Alphabetical")" "$(T "Recently used")" "$(T "Most used")" "$(T "Category")")
for i in 0 1 2 3; do
    base+=(-theme-str "button-sort-${modes[i]} { content: \"${labels[i]//\"/\\\"}\"; }")
done
# Aplikace + LuxAI: text bez shody s aplikaci (nebo Ctrl+Enter) je dotaz pro LuxAI (luxos-luxai-rofi)
# X-LuxOS-Launchpad: vybrane panely Nastaveni (Tiskarny a skenery, Ovladace) maji kopii s OnlyShowIn jen pro Launchpad
# (samostatne aplikace s kategorii Nastaveni dela launchpad_apps, viz LAUNCHPAD_APPS)
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}:X-LuxOS-Launchpad"

while :; do
    prepare_order
    # -scroll-method 1: kolecko/touchpad posouva mrizku plynule po radcich (ne skok o celou stranu)
    # -hover-select -hover-no-scroll (rofi z [luxos]): zvyraznena je dlazdice pod mysi jako v macOS,
    # ale pohled se najetim nehne (puvodni rofi vyber vycentroval a mrizka sama ujizdela); kolecko
    # posune pohled o radek i se zvyraznenim. Sipky zvyrazneni posouvaji dal, Enter spusti zvyraznenou
    # aplikaci, po psani nejlepsi shodu. Mys mimo mrizku zvyrazneni nemeni.
    # -custom-resort (rofi z [luxos]): tlacitko razeni / Alt+1..4 spusti "luxos-launchpad --sort N"
    # a rofi preradi dlazdice na miste (okno se nezavre, hledany text zustane, vybrana prvni).
    # -custom-exit: zaloha pro starsi rofi bez -custom-resort - konec s kodem 10..13 a nove spusteni
    rofi -show combi -modi combi -combi-modi "luxai:luxos-luxai-rofi,drun" -combi-hide-mode-prefix -theme luxos-launchpad -drun-exclude-categories 'X-XFCE-SettingsDialog,X-Xfce-Toplevel' "${base[@]}" \
        -theme-str "button-sort-$sort { background-color: @lux-accent; text-color: @lux-sel-fg; }" \
        -show-icons -drun-display-format '{name}' -matching fuzzy -sort -sorting-method fzf -scroll-method 1 \
        -hover-select -hover-no-scroll -me-select-entry '' -me-accept-entry MousePrimary \
        -cache-dir "$run" -max-history-size 100000 -custom-exit -custom-resort "bash ${self@Q} --sort"
    rc=$?
    if (( rc >= 10 && rc <= 13 )); then
        sort=${modes[rc - 10]}
        save_sort
        continue
    fi
    break
done
# razeni mohlo byt zmeneno v okne (--sort)
[[ -r $conf ]] && read -r sort <"$conf"
# spustena aplikace -> pocty a pripravene poradi (az po zavreni okna, nic nezdrzi)
if (( rc == 0 )); then
    (
        python3 "$PY" record "$run/before" "$run/rofi3.druncache"
        [[ $sort == category ]] && python3 "$PY" order category "$cache/launchpad-order-category"
    ) >/dev/null 2>&1 &
    disown
fi
exit 0
