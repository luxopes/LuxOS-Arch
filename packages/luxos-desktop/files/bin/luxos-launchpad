#!/bin/bash
# LuxOS - Launchpad (Super+A): mrizka aplikaci v panelu uprostred obrazovky
if pkill -x rofi; then exit 0; fi
. /usr/lib/luxos/i18n.sh 2>/dev/null || T() { printf "$@"; }
extra=(-theme-str "entry { placeholder: \"$(T "Search apps")\"; }")
[[ $(luxos-appearance status) == light ]] && extra+=(-theme-str '@import "luxos-light-colors"')
exec rofi -show drun -modi drun -theme luxos-launchpad -drun-exclude-categories 'X-XFCE-SettingsDialog,X-Xfce-Toplevel' "${extra[@]}" \
    -show-icons -drun-display-format '{name}' -matching fuzzy -sort -sorting-method fzf \
    -hover-select -me-select-entry '' -me-accept-entry MousePrimary
