#!/bin/sh
# LuxOS - klik na Ovladaci centrum v liste: bezici demon jen prepne (okamzite), jinak ho spusti
pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/luxos-control-center.pid" 2>/dev/null)
if [ -n "$pid" ] && grep -qa luxos-control-center "/proc/$pid/cmdline" 2>/dev/null; then
    exec kill -USR1 "$pid"
fi
exec luxos-control-center
