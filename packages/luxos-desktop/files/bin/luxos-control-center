def run(*cmd, timeout=3):
    """Vystup prikazu (str) nebo None pri chybe."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


# ---- stav systemu ------------------------------------------------------------
def wifi_state():
    radio = run("nmcli", "radio", "wifi")
    if radio is None:
        return None, ""
    on = radio == "enabled"
    ssid = ""
    out = run("nmcli", "-t", "-f", "ACTIVE,SSID", "device", "wifi") or ""
    for line in out.splitlines():
        if line.startswith("yes:"):
            ssid = line[4:]
            break
    if not on:
        return False, _("Off")
    if ssid:
        return True, ssid
    wired = run("nmcli", "-t", "-f", "TYPE,STATE", "device") or ""
    if "ethernet:connected" in wired:
        return True, _("Ethernet")
    return True, _("Not connected")


CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxos")
SOFT_BRIGHTNESS = os.path.join(CFG, "brightness")


def media_state():
    """Prehravac MPRIS (prednost ma ten, ktery prave hraje) nebo None."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames",
                              None, GLib.VariantType("(as)"), 0, 500, None).unpack()[0]
    except GLib.Error:
        return None
    best = None
    for name in sorted(n for n in names if n.startswith("org.mpris.MediaPlayer2.")):
        try:
            props = bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "GetAll",
                                  GLib.Variant("(s)", ("org.mpris.MediaPlayer2.Player",)),
                                  GLib.VariantType("(a{sv})"), 0, 500, None).unpack()[0]
        except GLib.Error:
            continue
        meta = props.get("Metadata", {}) or {}
        artist = meta.get("xesam:artist") or []
        state = {"bus": name, "app": name.split(".")[3].split(".")[0].capitalize(),
                 "title": str(meta.get("xesam:title") or ""),
                 "artist": ", ".join(artist) if isinstance(artist, list) else str(artist),
                 "art": str(meta.get("mpris:artUrl") or ""),
                 "playing": props.get("PlaybackStatus") == "Playing",
                 "can_next": bool(props.get("CanGoNext", True)), "can_prev": bool(props.get("CanGoPrevious", True))}
        if state["playing"]:
            return state
        if best is None and (state["title"] or props.get("PlaybackStatus") == "Paused"):
            best = state
    return best


def account_user():
    """Uzivatel prihlaseneho uctu LuxAI nebo None (cte jen soubor, bez site)."""
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxai/account.json")
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    if not data.get("sessionToken"):
        return None
    return data.get("user") or {}


def bluetooth_state():
    """Adapter BlueZ pres D-Bus (bez bluetoothctl, ktery bez sluzby visi sekundy)."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        has = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                            "NameHasOwner", GLib.Variant("(s)", ("org.bluez",)), GLib.VariantType("(b)"),
                            0, 500, None).unpack()[0]
        if not has:
            return None, _("Not available")
        r = bus.call_sync("org.bluez", "/org/bluez/hci0", "org.freedesktop.DBus.Properties", "Get",
                          GLib.Variant("(ss)", ("org.bluez.Adapter1", "Powered")), GLib.VariantType("(v)"),
                          0, 500, None)
        on = bool(r.unpack()[0])
        return on, _("On") if on else _("Off")
    except GLib.Error:
        return None, _("Not available")


def dnd_state():
    out = run("xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb")
    return out == "true"


def flag_state(name):
    """Sporic dat/baterie: priznakovy soubor v ~/.config/luxos (bez spousteni skriptu)."""
    return os.path.exists(os.path.join(CFG, name))


def dark_state():
    try:
        with open(os.path.join(CFG, "appearance")) as f:
            return f.read().strip() == "dark"
    except OSError:
        return False                # vychozi je svetly rezim


def battery():
    """(kapacita %, stav, minuty do vybiti/nabiti nebo None) - stejny odhad jako luxos-battery."""
    base = "/sys/class/power_supply"
    try:
        for name in sorted(os.listdir(base)):
            if name.startswith("BAT"):
                with open(f"{base}/{name}/capacity") as f:
                    cap = int(f.read().strip())
                with open(f"{base}/{name}/status") as f:
                    st = f.read().strip()
                return cap, st, battery_minutes(f"{base}/{name}", st)
    except (OSError, ValueError):
        pass
    return None


def battery_minutes(bat, st):
    """Odhad z aktualniho odberu (energy_* v uWh/uW, nebo charge_* v uAh/uA)."""
    def rd(*names):
        try:
            vals = []
            for n in names:
                with open(f"{bat}/{n}") as f:
                    vals.append(abs(int(f.read().strip())))
            return vals
        except (OSError, ValueError):
            return None
    v = rd("energy_now", "energy_full", "power_now") or rd("charge_now", "charge_full", "current_now")
    if not v or v[2] <= 0:
        return None
    now, full, rate = v
    if st == "Discharging":
        mins = now * 60 // rate
    elif st == "Charging" and full > now:
        mins = (full - now) * 60 // rate
    else:
        return None
    return mins if 0 < mins < 6000 else None


def fmt_minutes(mins):
    return f"{mins // 60} h {mins % 60} min" if mins >= 60 else f"{mins} min"


def volume():
    out = run("pactl", "get-sink-volume", "@DEFAULT_SINK@")
    mute = run("pactl", "get-sink-mute", "@DEFAULT_SINK@") or ""
    if not out:
        return None, False
    m = re.search(r"(\d+)%", out)
    return (int(m.group(1)) if m else 0), mute.endswith("yes")


def backlight():
    """Cesta k podsviceni (notebook) nebo None."""
    base = "/sys/class/backlight"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return None
    return os.path.join(base, names[0]) if names else None


def brightness():
    """Jas v procentech: podsviceni, jinak softwarovy jas monitoru (xrandr)."""
    bl = backlight()
    if bl:
        try:
            with open(f"{bl}/brightness") as f, open(f"{bl}/max_brightness") as g:
                return round(int(f.read()) * 100 / int(g.read()))
        except (OSError, ValueError, ZeroDivisionError):
            return None
    try:
        with open(SOFT_BRIGHTNESS) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 100


# ---- UI ----------------------------------------------------------------------
class Tile(Gtk.Button):
    def __init__(self, icon, title, on_click):
        super().__init__(can_focus=False)
        self.get_style_context().add_class("tile")
        box = Gtk.Box(spacing=10)
        bubble = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        bubble.get_style_context().add_class("bubble")
        self.image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
        self.image.set_hexpand(True)
        self.image.set_vexpand(True)
        bubble.pack_start(self.image, True, True, 0)
        box.pack_start(bubble, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(label=title, xalign=0)
        self.title.get_style_context().add_class("title")
        self.sub = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=12)
        self.sub.get_style_context().add_class("sub")
        text.pack_start(self.title, False, False, 0)
        text.pack_start(self.sub, False, False, 0)
        box.pack_start(text, True, True, 0)
        self.add(box)
        self.connect("clicked", lambda _b: on_click())

    def set_state(self, on, sub=None):
        ctx = self.get_style_context()
        if on is None:
            on = False
        (ctx.add_class if on else ctx.remove_class)("on")
        if sub is not None:
            self.sub.set_text(sub)


class SliderRow(Gtk.Box):
    def __init__(self, title, icon, on_change, on_icon=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.get_style_context().add_class("section")
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("title")
        self.pack_start(label, False, False, 0)
        row = Gtk.Box(spacing=8)
        btn = Gtk.Button(can_focus=False, relief=Gtk.ReliefStyle.NONE)
        self.icon = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
        btn.add(self.icon)
        if on_icon:
            btn.connect("clicked", lambda _b: on_icon())
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self._lock = False
        self.scale.connect("value-changed", lambda s: None if self._lock else on_change(int(s.get_value())))
        row.pack_start(btn, False, False, 0)
        row.pack_start(self.scale, True, True, 0)
        self.pack_start(row, False, False, 0)

    def set_value(self, v):
        self._lock = True
        self.scale.set_value(v)
        self._lock = False


class ControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Control Center"))
        self.get_style_context().add_class("cc")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.stick()
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)
        self.set_app_paintable(True)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.get_style_context().add_class("cc-box")
        outer.set_size_request(340, -1)
        self.add(outer)

        # Profil: ucet LuxAI (~/.config/luxai/account.json), klik otevre Ucet LuxAI
        prof = Gtk.Button(can_focus=False, relief=Gtk.ReliefStyle.NONE)
        prof.get_style_context().add_class("plain")
        pbox = Gtk.Box(spacing=10)
        pbox.get_style_context().add_class("section")
        avatar = self.p_avatar = Gtk.Label()
        avatar.get_style_context().add_class("avatar")
        ptext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        pt = self.p_title = Gtk.Label(xalign=0)
        pt.get_style_context().add_class("title")
        ps = self.p_sub = Gtk.Label(xalign=0)
        ps.get_style_context().add_class("sub")
        ptext.pack_start(pt, False, False, 0)
        ptext.pack_start(ps, False, False, 0)
        pbox.pack_start(avatar, False, False, 0)
        pbox.pack_start(ptext, True, True, 0)
        pbox.pack_end(Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU), False, False, 0)
        prof.add(pbox)
        prof.connect("clicked", lambda _b: (spawn("luxos-account"), self.close()))
        outer.pack_start(prof, False, False, 0)

        grid = Gtk.Grid(row_spacing=8, column_spacing=8, column_homogeneous=True)
        self.t_wifi = Tile("network-wireless-symbolic", _("Wi-Fi"), self.toggle_wifi)
        self.t_bt = Tile("bluetooth-active-symbolic", _("Bluetooth"), self.toggle_bt)
        self.t_dnd = Tile("notifications-disabled-symbolic", _("Do Not Disturb"), self.toggle_dnd)
        self.t_dark = Tile("weather-clear-night-symbolic", _("Dark Mode"), self.toggle_dark)
        self.t_data = Tile("network-cellular-signal-good-symbolic", _("Data Saver"), self.toggle_data)
        self.t_power = Tile("battery-level-50-symbolic", _("Battery Saver"), self.toggle_power)
        for i, t in enumerate((self.t_wifi, self.t_bt, self.t_dnd, self.t_dark, self.t_data, self.t_power)):
            grid.attach(t, i % 2, i // 2, 1, 1)
        outer.pack_start(grid, False, False, 0)

        # Klik na ikonu jasu otevre Monitory (rozliseni, velikost textu)
        self.s_bright = SliderRow(_("Display"), "display-brightness-symbolic", self.set_brightness,
                                  lambda: (spawn("luxos-display-settings"), self.close()))
        outer.pack_start(self.s_bright, False, False, 0)
        self.s_vol = SliderRow(_("Sound"), "audio-volume-high-symbolic", self.set_volume, self.toggle_mute)
        outer.pack_start(self.s_vol, False, False, 0)

        # Prave hrajici hudba (MPRIS: Firefox, Spotify, VLC, mpv...) - jen kdyz nejaky prehravac bezi
        media = self.media_box = Gtk.Box(spacing=10)
        media.get_style_context().add_class("section")
        self.m_art = Gtk.Image()
        art_wrap = Gtk.Box(valign=Gtk.Align.CENTER)
        art_wrap.get_style_context().add_class("art")
        art_wrap.pack_start(self.m_art, True, True, 0)
        media.pack_start(art_wrap, False, False, 0)
        mtext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        self.m_title = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=18)
        self.m_title.get_style_context().add_class("title")
        self.m_artist = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=18)
        self.m_artist.get_style_context().add_class("sub")
        mtext.pack_start(self.m_title, False, False, 0)
        mtext.pack_start(self.m_artist, False, False, 0)
        media.pack_start(mtext, True, True, 0)
        self.m_buttons = {}
        for name, icon in (("Previous", "media-skip-backward-symbolic"), ("PlayPause", "media-playback-start-symbolic"),
                           ("Next", "media-skip-forward-symbolic")):
            b = Gtk.Button(can_focus=False, valign=Gtk.Align.CENTER)
            b.get_style_context().add_class("media")
            b.add(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR if name == "PlayPause"
                                               else Gtk.IconSize.MENU))
            b.connect("clicked", lambda _b, m=name: self.media_call(m))
            self.m_buttons[name] = b
            media.pack_start(b, False, False, 0)
        media.set_no_show_all(True)
        outer.pack_start(media, False, False, 0)
        self.player = None

        self.bat_box = Gtk.Box(spacing=10)
        self.bat_box.get_style_context().add_class("section")
        bat_button = Gtk.Button(can_focus=False, relief=Gtk.ReliefStyle.NONE)
        bat_button.get_style_context().add_class("plain")
        bat_button.connect("clicked", lambda _b: (spawn("luxos-power"), self.close()))
        self.bat_icon = Gtk.Image.new_from_icon_name("battery-level-50-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        bat_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.bat_title = Gtk.Label(xalign=0)
        self.bat_title.get_style_context().add_class("title")
        self.bat_sub = Gtk.Label(xalign=0)
        self.bat_sub.get_style_context().add_class("sub")
        bat_text.pack_start(self.bat_title, False, False, 0)
        bat_text.pack_start(self.bat_sub, False, False, 0)
        self.bat_box.pack_start(self.bat_icon, False, False, 0)
        self.bat_box.pack_start(bat_text, True, True, 0)
        self.bat_box.pack_end(Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU), False, False, 0)
        bat_button.add(self.bat_box)
        self.bat_wrap = bat_button
        outer.pack_start(bat_button, False, False, 0)

        footer = Gtk.Box(spacing=4)
        for label, cmd in ((_("Desktop & Dock…"), "luxos-settings"), (_("Battery…"), "luxos-power"),
                           (_("All Settings…"), "xfce4-settings-manager")):
            b = Gtk.Button(label=label, can_focus=False)
            b.get_style_context().add_class("footer")
            b.connect("clicked", lambda _b, c=cmd: (spawn(c), self.close()))
            footer.pack_start(b, False, False, 0)
        outer.pack_start(footer, False, False, 0)

        self.connect("focus-out-event", lambda *_a: GLib.timeout_add(120, self.close_if_unfocused))
        self.connect("key-press-event", self.on_key)
        self.connect("realize", lambda *_a: self.place())
        # Demon: zavreni okno jen skryje, dalsi klik v liste ho hned ukaze (SIGUSR1)
        self.connect("delete-event", lambda *_a: self.hide() or True)
        self.refresh_fast()
        threading.Thread(target=self.refresh_slow, daemon=True).start()
        self.timer = None

    def toggle(self):
        if self.get_visible():
            self.hide()
        else:
            self.refresh_fast()
            threading.Thread(target=self.refresh_slow, daemon=True).start()
            self.show_all()
            self.place()
            self.present_with_time(Gtk.get_current_event_time() or Gdk.CURRENT_TIME)
            if self.timer is None:
                self.timer = GLib.timeout_add_seconds(3, self.periodic)
        return False

    # umisteni vpravo pod horni listou na monitoru s kurzorem
    def place(self):
        display = Gdk.Display.get_default()
        pointer = display.get_default_seat().get_pointer()
        _scr, px, py = pointer.get_position()
        mon = display.get_monitor_at_point(px, py)
        geo = mon.get_workarea()
        w, _h = self.get_size()
        self.move(geo.x + geo.width - w - 8, geo.y + 6)

    def close_if_unfocused(self):
        # is_active() zustava po kliknuti na plochu (xfdesktop drzi grab) chybne True,
        # proto rozhoduje i skutecne aktivni okno podle spravce oken (_NET_ACTIVE_WINDOW)
        active = self.get_screen().get_active_window()
        if not self.is_active() or (active is not None and active != self.get_window()):
            self.close()
        return False

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    # ---- obnova stavu ----
    def refresh_fast(self):
        """Okamzite udaje (soubory v ~/.config a /sys) - bez spousteni programu."""
        user = account_user()
        name = (user or {}).get("displayName") or (user or {}).get("email") or ""
        self.p_avatar.set_text((name[:1] or "\u2726").upper())
        self.p_title.set_text(name if user else _("Sign in to LuxAI"))
        self.p_sub.set_text(_("LuxAI Account") if user else _("AI in LuxAI, Lux Code and LSL IDE"))
        dark = dark_state()
        self.t_dark.set_state(dark, _("On") if dark else _("Off"))
        data = flag_state("datasaver")
        self.t_data.set_state(data, _("On") if data else _("Off"))
        power = flag_state("powersaver")
        self.t_power.set_state(power, _("On") if power else _("Off"))
        b = brightness()
        if b is not None:
            self.s_bright.set_value(b)
        bat = battery()
        self.bat_wrap.set_no_show_all(bat is None)
        self.bat_wrap.set_visible(bat is not None)
        if bat:
            cap, st, mins = bat
            level = min(100, (cap + 5) // 10 * 10)
            icon = f"battery-level-{level}{'-charging' if st == 'Charging' else ''}-symbolic"
            self.bat_icon.set_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
            self.bat_title.set_text(_("Battery") + f"  {cap} %")
            sub = {"Charging": _("Charging"), "Discharging": _("On battery")}.get(st, _("Fully charged"))
            if mins:
                sub += " · " + (_("%s remaining") if st == "Discharging" else _("%s until full")) % fmt_minutes(mins)
            self.bat_sub.set_text(sub)

    def refresh_slow(self):
        """Udaje ze sluzeb (sit, Bluetooth, zvuk, oznameni) - na pozadi."""
        wifi = wifi_state()
        bt = bluetooth_state()
        dnd = dnd_state()
        vol = volume()
        media = media_state()
        GLib.idle_add(self.apply_slow, wifi, bt, dnd, vol)
        GLib.idle_add(self.apply_media, media)

    def apply_media(self, media):
        if not media:
            self.player = None
            self.media_box.hide()
            return False
        self.player = media["bus"]
        self.m_title.set_text(media["title"] or media["app"])
        self.m_artist.set_text(media["artist"] or (media["app"] if media["title"] else ""))
        icon = "media-playback-pause-symbolic" if media["playing"] else "media-playback-start-symbolic"
        self.m_buttons["PlayPause"].get_child().set_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
        self.m_buttons["Next"].set_sensitive(media["can_next"])
        self.m_buttons["Previous"].set_sensitive(media["can_prev"])
        pix = None
        art = media["art"]
        if art.startswith("file://"):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(GLib.filename_from_uri(art)[0], 42, 42, True)
            except GLib.Error:
                pix = None
        if pix:
            self.m_art.set_from_pixbuf(pix)
        else:
            self.m_art.set_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        self.media_box.set_no_show_all(False)
        self.media_box.show_all()
        return False

    def media_call(self, method):
        if not self.player:
            return
        try:
            Gio.bus_get_sync(Gio.BusType.SESSION).call(
                self.player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method,
                None, None, 0, 2000, None, None, None)
        except GLib.Error:
            pass
        GLib.timeout_add(300, lambda: threading.Thread(target=self.refresh_slow, daemon=True).start() and False)

    def apply_slow(self, wifi, bt, dnd, vol):
        self.t_wifi.set_state(*wifi)
        self.t_bt.set_state(*bt)
        self.t_dnd.set_state(dnd, _("On") if dnd else _("Off"))
        level, muted = vol
        if level is not None:
            self.s_vol.set_value(level)
            self.s_vol.icon.set_from_icon_name(
                "audio-volume-muted-symbolic" if muted else "audio-volume-high-symbolic", Gtk.IconSize.MENU)
        return False

    def periodic(self):
        # Obnova jen pri zobrazenem okne (skryty demon se zbytecne nebudi)
        if self.get_visible():
            threading.Thread(target=self.refresh_slow, daemon=True).start()
            return True
        self.timer = None
        return False

    # ---- akce ----
    def toggle_wifi(self):
        on, _sub = wifi_state()
        run("nmcli", "radio", "wifi", "off" if on else "on", timeout=6)
        threading.Thread(target=self.refresh_slow, daemon=True).start()

    def toggle_bt(self):
        # Okno Bluetooth: zapnuti, sparovana zarizeni i pripojeni noveho
        spawn("luxos-bluetooth")
        self.close()

    def toggle_dnd(self):
        on = "on" not in self.t_dnd.get_style_context().list_classes()
        self.t_dnd.set_state(on, _("On") if on else _("Off"))
        spawn("xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb", "-n", "-t", "bool",
              "-s", "true" if on else "false")

    def toggle_dark(self):
        run("luxos-appearance", "toggle", timeout=20)
        self.close()

    def toggle_data(self):
        run("luxos-datasaver", "toggle", timeout=10)
        self.refresh_fast()

    def toggle_power(self):
        run("luxos-powersaver", "toggle", timeout=10)
        self.refresh_fast()

    def set_volume(self, v):
        spawn("pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{v}%")

    def toggle_mute(self):
        run("pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle")
        threading.Thread(target=self.refresh_slow, daemon=True).start()

    def set_brightness(self, v):
        v = max(v, 10)
        if backlight():
            spawn("brightnessctl", "-q", "set", f"{v}%")
            return
        # Monitor bez podsviceni (stolni pocitac, VM): softwarovy jas vsech vystupu
        os.makedirs(CFG, exist_ok=True)
        with open(SOFT_BRIGHTNESS, "w") as f:
            f.write(str(v))
        spawn("luxos-displays", "brightness", str(v))


def running_pid():
    """PID bezici instance (demon nebo luxos-daemon) nebo None."""
    try:
        with open(PIDFILE) as f:
            pid = int(f.read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmd = f.read()
        if b"luxos-control-center" in cmd or b"luxos-daemon" in cmd:
            return pid
    except (OSError, ValueError):
        pass
    return None


def create():
    """Skryte okno Ovladaciho centra se styly podle tematu (pouziva i luxos-daemon)."""
    provider = Gtk.CssProvider()

    def load_css(*_a):
        name = (Gtk.Settings.get_default().props.gtk_theme_name or "").lower()
        provider.load_from_data(((DARK if "dark" in name else LIGHT) + CSS).encode())
    load_css()
    # Svetly/tmavy rezim se muze prepnout za behu (automaticky podle slunce)
    Gtk.Settings.get_default().connect("notify::gtk-theme-name", load_css)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = ControlCenter()
    with warnings.catch_warnings():     # vlastni WM_CLASS i ve sdilenem procesu luxos-daemon
        warnings.simplefilter("ignore", DeprecationWarning)
        win.set_wmclass("luxos-control-center", "Luxos-control-center")
    return win


def main():
    # Klik v liste (luxos-control-center bez --daemon): bezici okno jen prepne
    pid = running_pid()
    if pid and pid != os.getpid():
        os.kill(pid, signal.SIGUSR1)
        return
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    GLib.set_prgname("luxos-control-center")
    win = create()
    win.connect("destroy", Gtk.main_quit)
    signal.signal(signal.SIGTERM, lambda *_a: GLib.idle_add(Gtk.main_quit))
    signal.signal(signal.SIGUSR1, lambda *_a: GLib.idle_add(win.toggle))
    if "--daemon" not in sys.argv:
        win.toggle()
    try:
        Gtk.main()
    finally:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


if __name__ == "__main__":
    main()
