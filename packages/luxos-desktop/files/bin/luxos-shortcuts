#!/usr/bin/env python3
"""LuxOS - Klavesove zkratky: prehled, zmena a vlastni zkratky.

Zkratky se ctou a zapisuji pres xfconf (kanal xfce4-keyboard-shortcuts), takze je
xfsettingsd (prikazy) a xfwm4 (okna) hned pouziji. Logika je v luxos_shortcuts.py.
Klik na zkratku -> "Stisknete novou zkratku" (Esc zrusi, Backspace vypne).
"""
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.environ.get("LUXOS_PYDIR") or "/usr/lib/luxos/python")
import luxos_shortcuts as ls  # noqa: E402
from luxos_i18n import _  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

CSS = b"""
.group { border-radius: 12px; border: 1px solid alpha(currentColor, 0.12); background-color: alpha(currentColor, 0.04); }
.group-title { font-weight: 700; font-size: 13px; margin: 14px 4px 6px; }
.row { padding: 8px 10px 8px 14px; }
.row-sep { border-top: 1px solid alpha(currentColor, 0.08); }
.hint { font-size: 11px; opacity: 0.6; }
.keycap { padding: 3px 10px; border-radius: 7px; border: 1px solid alpha(currentColor, 0.18);
          background-image: none; background-color: alpha(currentColor, 0.07); box-shadow: none;
          font-weight: 600; min-height: 0; }
.keycap:hover { background-color: alpha(currentColor, 0.13); }
.keycap.off { font-weight: 400; opacity: 0.55; }
.keycap.fixed { opacity: 0.8; }
.icon-btn { padding: 2px; min-height: 0; min-width: 0; }
.capture-keys { font-size: 22px; font-weight: 700; margin: 14px 0 6px; }
.capture-box { border-radius: 12px; border: 2px dashed alpha(@theme_selected_bg_color, 0.7);
               background-color: alpha(@theme_selected_bg_color, 0.07); padding: 6px 18px; }
"""

SECTION_HINTS = {
    "custom": "Your own shortcuts that open an app or run a command.",
    "other": "Standard Xfce shortcuts kept for compatibility.",
}


def section_title(key):
    return _(dict(ls.SECTIONS)[key])


class Group(Gtk.Box):
    """Skupina radku ve stylu Nastaveni macOS (stejne jako Monitory a Plocha a Dock)."""

    def __init__(self, parent, title, hint=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("group-title")
        parent.pack_start(label, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0, wrap=True, margin_start=4, margin_bottom=6)
            h.get_style_context().add_class("hint")
            parent.pack_start(h, False, False, 0)
        self.get_style_context().add_class("group")
        parent.pack_start(self, False, False, 0)
        self.rows = 0

    def row(self, title, widgets, hint=None):
        box = Gtk.Box(spacing=8)
        box.get_style_context().add_class("row")
        if self.rows:
            box.get_style_context().add_class("row-sep")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        t = Gtk.Label(label=title, xalign=0, ellipsize=Pango.EllipsizeMode.END)
        text.pack_start(t, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            h.get_style_context().add_class("hint")
            text.pack_start(h, False, False, 0)
        box.pack_start(text, True, True, 0)
        for w in reversed(widgets):
            w.set_valign(Gtk.Align.CENTER)
            box.pack_end(w, False, False, 0)
        self.pack_start(box, False, False, 0)
        self.rows += 1
        return box


def icon_button(icon, tooltip, callback):
    b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.MENU)
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.set_tooltip_text(tooltip)
    b.get_style_context().add_class("icon-btn")
    b.connect("clicked", lambda _b: callback())
    return b


def keycap(text, callback=None, off=False, tooltip=None):
    b = Gtk.Button(label=text)
    ctx = b.get_style_context()
    ctx.add_class("keycap")
    if off:
        ctx.add_class("off")
    if callback:
        b.connect("clicked", lambda _b: callback())
        b.set_tooltip_text(tooltip or _("Click to change the shortcut"))
    else:
        ctx.add_class("fixed")
        b.set_sensitive(True)
        b.set_can_focus(False)
        if tooltip:
            b.set_tooltip_text(tooltip)
    return b


def accel_from_event(event):
    """Zkratka ze stisku klavesy: zakladni klavesa (bez Shift: 4, ne dolar) a modifikatory."""
    keymap = Gdk.Keymap.get_for_display(Gdk.Display.get_default())
    keyval = event.keyval
    try:
        ok, kv, _g, _l, _c = keymap.translate_keyboard_state(event.hardware_keycode, 0, event.group)
        if ok and kv:
            keyval = kv
    except (TypeError, AttributeError):
        pass
    return accel_from_keyval(keyval, event.state)


def accel_from_keyval(keyval, state):
    name = Gdk.keyval_name(Gdk.keyval_to_lower(keyval))
    if not name:
        return None
    if name == "ISO_Left_Tab":
        name = "Tab"
    mods = set()
    if state & Gdk.ModifierType.CONTROL_MASK:
        mods.add("ctrl")
    if state & Gdk.ModifierType.SHIFT_MASK:
        mods.add("shift")
    if state & Gdk.ModifierType.MOD1_MASK:
        mods.add("alt")
    if state & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
        mods.add("super")
    return ls.make_accel(frozenset(mods), name)


class CaptureDialog(Gtk.Dialog):
    """"Stisknete novou zkratku": Esc zrusi, Backspace vypne. Klavesnice je zachycena,
    aby stisk nespustil existujici globalni zkratku."""

    def __init__(self, parent, title, allow_disable=True):
        super().__init__(title=_("Keyboard Shortcuts"), transient_for=parent, modal=True)
        self.result = None          # ("set", accel) / ("off", None) / None = zruseno
        self.allow_disable = allow_disable
        self.grabbed = None
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        self.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        box = self.get_content_area()
        box.set_border_width(18)
        box.set_spacing(4)
        head = Gtk.Label(xalign=0.5, wrap=True, max_width_chars=40)
        head.set_markup("<b>%s</b>" % GLib.markup_escape_text(_("Press the new shortcut for “%s”") % title))
        box.pack_start(head, False, False, 0)
        frame = Gtk.Box(halign=Gtk.Align.CENTER)
        frame.set_size_request(260, -1)
        frame.get_style_context().add_class("capture-box")
        self.keys = Gtk.Label(label="…", hexpand=True)
        self.keys.get_style_context().add_class("capture-keys")
        frame.pack_start(self.keys, False, False, 0)
        box.pack_start(frame, False, False, 8)
        hint = _("Esc cancels, Backspace turns the shortcut off.") if allow_disable else _("Esc cancels.")
        self.hint = Gtk.Label(label=hint, wrap=True, max_width_chars=44)
        self.hint.get_style_context().add_class("hint")
        box.pack_start(self.hint, False, False, 0)
        self.connect("key-press-event", self.on_key)
        self.connect("key-release-event", self.on_release)
        self.connect("map-event", self.on_map)
        self.connect("unmap", self.on_unmap)

    def on_map(self, *_a):
        seat = Gdk.Display.get_default().get_default_seat()
        if seat and self.get_window():
            st = seat.grab(self.get_window(), Gdk.SeatCapabilities.KEYBOARD, False, None, None, None, None)
            if st == Gdk.GrabStatus.SUCCESS:
                self.grabbed = seat
        return False

    def on_unmap(self, *_a):
        if self.grabbed:
            self.grabbed.ungrab()
            self.grabbed = None

    def on_release(self, _w, event):
        self.show_mods(event.state, released=Gdk.keyval_name(event.keyval) or "")
        return True

    def show_mods(self, state, pressed="", released=""):
        """Prubezne zobrazeni drzenych modifikatoru (Super + Shift + …)."""
        mods = []
        for mask, name, key in ((Gdk.ModifierType.CONTROL_MASK, "Ctrl", "Control"),
                                (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK, "Super", "Super"),
                                (Gdk.ModifierType.MOD1_MASK, "Alt", "Alt"),
                                (Gdk.ModifierType.SHIFT_MASK, "Shift", "Shift")):
            held = bool(state & mask) or pressed.startswith(key) or (key == "Super" and pressed.startswith("Meta"))
            if released.startswith(key) or (key == "Super" and released.startswith("Meta")):
                held = False
            if held:
                mods.append(name)
        self.keys.set_text(" + ".join(mods + ["…"]) if mods else "…")

    def on_key(self, _w, event):
        name = Gdk.keyval_name(event.keyval) or ""
        plain = not (event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK |
                                    Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK |
                                    Gdk.ModifierType.SHIFT_MASK))
        if ls.MODIFIER_KEYS.match(name):
            self.show_mods(event.state, pressed=name)
            return True
        if plain and name == "Escape":
            self.response(Gtk.ResponseType.CANCEL)
            return True
        if plain and name == "BackSpace" and self.allow_disable:
            self.result = ("off", None)
            self.response(Gtk.ResponseType.OK)
            return True
        return self.offer(accel_from_event(event))

    def offer(self, accel):
        """Prijme zkratku, pokud je pouzitelna; jinak upozorni a ceka dal."""
        if not accel:
            return True
        self.keys.set_text(ls.format_accel(accel))
        if not ls.accel_allowed(accel):
            self.hint.set_text(_("Use at least one of Ctrl, Alt or Super."))
            return True
        self.result = ("set", accel)
        self.response(Gtk.ResponseType.OK)
        return True


def ask(parent, text, secondary, ok_label, destructive=False):
    dlg = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
                            buttons=Gtk.ButtonsType.NONE, text=text)
    if secondary:
        dlg.format_secondary_text(secondary)
    dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
    b = dlg.add_button(ok_label, Gtk.ResponseType.OK)
    b.get_style_context().add_class("destructive-action" if destructive else "suggested-action")
    dlg.set_default_response(Gtk.ResponseType.OK)
    ok = dlg.run() == Gtk.ResponseType.OK
    dlg.destroy()
    return ok


def warn(parent, text):
    dlg = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.WARNING,
                            buttons=Gtk.ButtonsType.OK, text=text)
    dlg.run()
    dlg.destroy()


def installed_apps():
    """Aplikace z .desktop souboru: (nazev, prikaz, ikona) serazene podle nazvu."""
    out = []
    seen = set()
    for app in Gio.AppInfo.get_all():
        if not app.should_show():
            continue
        cmd = app.get_commandline() or ""
        name = app.get_display_name() or app.get_name() or ""
        if not cmd or not name:
            continue
        command = ls.strip_field_codes(cmd)
        if isinstance(app, Gio.DesktopAppInfo) and app.get_boolean("Terminal"):
            command = "xfce4-terminal -x " + command
        if (name, command) in seen:
            continue
        seen.add((name, command))
        out.append((name, command, app.get_icon()))
    return sorted(out, key=lambda a: a[0].lower())


class AppChooser(Gtk.Dialog):
    """Vyber aplikace pro vlastni zkratku (s hledanim)."""

    def __init__(self, parent):
        super().__init__(title=_("Choose App"), transient_for=parent, modal=True)
        self.set_default_size(380, 460)
        self.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        self.ok = self.add_button(_("Choose"), Gtk.ResponseType.OK)
        self.ok.get_style_context().add_class("suggested-action")
        self.ok.set_sensitive(False)
        box = self.get_content_area()
        box.set_border_width(10)
        box.set_spacing(8)
        self.search = Gtk.SearchEntry(placeholder_text=_("Search apps"))
        self.search.connect("search-changed", lambda _e: self.listbox.invalidate_filter())
        box.pack_start(self.search, False, False, 0)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_shadow_type(Gtk.ShadowType.IN)
        self.listbox = Gtk.ListBox()
        self.listbox.set_filter_func(self.filter)
        self.listbox.connect("row-selected", lambda _l, r: self.ok.set_sensitive(r is not None))
        self.listbox.connect("row-activated", lambda _l, _r: self.response(Gtk.ResponseType.OK))
        scroll.add(self.listbox)
        box.pack_start(scroll, True, True, 0)
        for name, command, icon in installed_apps():
            row = Gtk.ListBoxRow()
            row.app = (name, command)
            hb = Gtk.Box(spacing=10, margin=6)
            img = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.LARGE_TOOLBAR) if icon else \
                Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.LARGE_TOOLBAR)
            hb.pack_start(img, False, False, 0)
            hb.pack_start(Gtk.Label(label=name, xalign=0, ellipsize=Pango.EllipsizeMode.END), True, True, 0)
            row.add(hb)
            self.listbox.add(row)

    def filter(self, row):
        q = self.search.get_text().strip().lower()
        return not q or q in row.app[0].lower() or q in row.app[1].lower()

    def chosen(self):
        row = self.listbox.get_selected_row()
        return row.app if row else None


class CustomDialog(Gtk.Dialog):
    """Pridani / uprava vlastni zkratky: nazev, prikaz (nebo aplikace) a zkratka."""

    def __init__(self, parent, model, name="", command="", accel=None):
        title = _("Edit Shortcut") if accel else _("Add Shortcut")
        super().__init__(title=title, transient_for=parent, modal=True)
        self.model = model
        self.old = accel
        self.accel = accel
        self.set_resizable(False)
        self.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        self.save = self.add_button(_("Save"), Gtk.ResponseType.OK)
        self.save.get_style_context().add_class("suggested-action")
        box = self.get_content_area()
        box.set_border_width(16)
        grid = Gtk.Grid(row_spacing=10, column_spacing=12)
        box.pack_start(grid, False, False, 0)
        self.name = Gtk.Entry(text=name, width_chars=32, placeholder_text=_("e.g. Open my notes"))
        self.command = Gtk.Entry(text=command, hexpand=True, placeholder_text=_("Command, e.g. firefox"))
        choose = Gtk.Button(label=_("Choose App…"))
        choose.connect("clicked", self.on_choose)
        cmd_box = Gtk.Box(spacing=6)
        cmd_box.pack_start(self.command, True, True, 0)
        cmd_box.pack_start(choose, False, False, 0)
        self.key = Gtk.Button()
        self.key.get_style_context().add_class("keycap")
        self.key.set_halign(Gtk.Align.START)
        self.key.connect("clicked", self.on_record)
        for i, (label, widget) in enumerate(((_("Name"), self.name), (_("Command"), cmd_box),
                                             (_("Shortcut"), self.key))):
            lbl = Gtk.Label(label=label, xalign=1)
            grid.attach(lbl, 0, i, 1, 1)
            grid.attach(widget, 1, i, 1, 1)
        self.note = Gtk.Label(xalign=0, wrap=True, max_width_chars=50, margin_top=10)
        self.note.get_style_context().add_class("hint")
        box.pack_start(self.note, False, False, 0)
        self.name.connect("changed", lambda _e: self.update())
        self.command.connect("changed", lambda _e: self.update())
        self.update()

    def update(self):
        self.key.set_label(ls.format_accel(self.accel) if self.accel else _("Record Shortcut…"))
        clash = self.model.conflict(ls.Action("x", "custom", "", "cmd", [self.command.get_text().strip() or "\0"]),
                                    self.accel) if self.accel and self.accel != self.old else None
        self.clash = clash
        self.note.set_text(_("Already used by “%s” - it will be replaced.") % clash if clash else "")
        self.save.set_sensitive(bool(self.name.get_text().strip() and self.command.get_text().strip()
                                     and self.accel))

    def on_choose(self, _b):
        dlg = AppChooser(self)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK and dlg.chosen():
            name, command = dlg.chosen()
            if not self.name.get_text().strip():
                self.name.set_text(name)
            self.command.set_text(command)
        dlg.destroy()

    def on_record(self, _b):
        dlg = CaptureDialog(self, self.name.get_text().strip() or _("New Shortcut"), allow_disable=False)
        dlg.show_all()
        dlg.run()
        res = dlg.result
        dlg.destroy()
        if res and res[0] == "set":
            self.accel = ls.normalize(res[1])
            self.update()

    def values(self):
        return self.name.get_text().strip(), self.command.get_text().strip(), self.accel


class ShortcutsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Keyboard Shortcuts"))
        self.set_default_size(620, 720)
        self.set_icon_name("preferences-desktop-keyboard-shortcuts")
        header = Gtk.HeaderBar(show_close_button=True, title=_("Keyboard Shortcuts"))
        add = Gtk.Button.new_from_icon_name("list-add-symbolic", Gtk.IconSize.BUTTON)
        add.set_tooltip_text(_("Add Shortcut…"))
        add.connect("clicked", lambda _b: self.add_custom())
        header.pack_start(add)
        menu = Gtk.MenuButton(image=Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON))
        pop = Gtk.Menu()
        for label, cb in ((_("Send Feedback…"), self.feedback),):
            item = Gtk.MenuItem(label=label)
            item.connect("activate", lambda _i, cb=cb: cb())
            pop.append(item)
        pop.show_all()
        menu.set_popup(pop)
        header.pack_end(menu)
        self.set_titlebar(header)
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.add(self.scroll)
        self.model = ls.Shortcuts()
        self.page = None
        self.rows = {}              # id akce -> radek (pro testy)
        self.build()

    # ---- seznam ------------------------------------------------------------------------
    def build(self):
        vadj = self.scroll.get_vadjustment().get_value()
        child = self.scroll.get_child()
        if child:
            child.destroy()
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=22, margin_top=8)
        self.page = page
        self.scroll.add(page)
        self.rows = {}
        if not self.model.available:
            msg = Gtk.Label(label=_("Shortcuts could not be read from the Xfce settings service. "
                                    "Changes will not be saved."), wrap=True, xalign=0)
            msg.get_style_context().add_class("hint")
            page.pack_start(msg, False, False, 4)
        actions = self.model.actions()
        for key, _title in ls.SECTIONS:
            items = [a for a in actions if a.section == key]
            if key == "custom":
                self.build_custom(page, items)
                continue
            if not items:
                continue
            group = Group(page, section_title(key), _(SECTION_HINTS[key]) if key in SECTION_HINTS else None)
            if key == "apps":
                self.add_layout_row(group)
            for a in items:
                self.add_action_row(group, a)
                if a.id == "launchpad":
                    self.add_super_row(group)
        bottom = Gtk.Box(margin_top=18)
        reset = Gtk.Button(label=_("Restore All Defaults…"))
        reset.connect("clicked", lambda _b: self.restore_all())
        bottom.pack_end(reset, False, False, 0)
        page.pack_start(bottom, False, False, 0)
        page.show_all()
        adj = self.scroll.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(vadj) and False)   # zachovat pozici po prestaveni

    def add_action_row(self, group, action):
        accels = self.model.accels_for(action)
        text = ", ".join(ls.format_accel(a) for a in accels) if accels else _("Off")
        widgets = [keycap(text, lambda a=action: self.change(a), off=not accels)]
        if not self.model.is_default(action):
            widgets.append(icon_button("edit-undo-symbolic", _("Restore Default"), lambda a=action: self.restore(a)))
        else:
            spacer = Gtk.Box()
            spacer.set_size_request(24, -1)
            widgets.append(spacer)
        hint = action.value if action.section == "other" and action.value != action.label else None
        self.rows[action.id] = group.row(action.label, widgets, hint)

    def add_layout_row(self, group):
        toggle = ls.layout_switch()
        if not toggle:
            return
        # Meni se v aplikaci Klavesnice (XkbOptions grp:...), pokud je nainstalovana
        app = shutil.which("luxos-keyboard")
        cap = keycap(toggle, (lambda: self.launch([app])) if app else None,
                     tooltip=_("Set together with the keyboard layouts."))
        spacer = Gtk.Box()
        spacer.set_size_request(24, -1)
        self.rows["layout"] = group.row(_("Switch keyboard layout"), [cap, spacer])

    def add_super_row(self, group):
        # Tuknuti na samotnou Super (luxos-menubar); Super+klavesa zustava zkratkou
        sw = Gtk.Switch(active=ls.super_tap_enabled())
        sw.connect("notify::active", self.on_super_tap)
        spacer = Gtk.Box()
        spacer.set_size_request(24, -1)
        self.rows["super-tap"] = group.row(_("Super key alone opens Launchpad"), [sw, spacer],
                                           _("Tap and release Super without another key."))
        self.super_switch = sw

    def on_super_tap(self, sw, _p):
        if not ls.set_super_tap(sw.get_active()):
            warn(self, _("The setting could not be saved."))

    def build_custom(self, page, items):
        group = Group(page, section_title("custom"), _(SECTION_HINTS["custom"]))
        for a in items:
            norm = a.id.split(":", 1)[1]
            widgets = [keycap(ls.format_accel(norm), lambda a=a: self.change(a)),
                       icon_button("document-edit-symbolic", _("Edit…"), lambda a=a: self.edit_custom(a)),
                       icon_button("user-trash-symbolic", _("Delete"), lambda a=a: self.delete_custom(a))]
            hint = a.value if a.label != a.value else None
            self.rows[a.id] = group.row(a.label, widgets, hint)
        add = Gtk.Button(label=_("Add Shortcut…"))
        add.connect("clicked", lambda _b: self.add_custom())
        add.set_halign(Gtk.Align.START)
        box = Gtk.Box(margin=8, margin_start=10)
        box.get_style_context().add_class("row")
        if group.rows:
            box.get_style_context().add_class("row-sep")
        box.pack_start(add, False, False, 0)
        group.pack_start(box, False, False, 0)
        self.add_btn = add

    # ---- zmeny ------------------------------------------------------------------------------
    def capture(self, title, allow_disable=True):
        dlg = CaptureDialog(self, title, allow_disable)
        dlg.show_all()
        dlg.run()
        res = dlg.result
        dlg.destroy()
        return res

    def change(self, action):
        res = self.capture(action.label)
        if not res:
            return
        self.apply_change(action, res)

    def apply_change(self, action, res):
        """Pouzije vysledek zachyceni (oddeleno kvuli testum). Vraci True, kdyz se zapsalo."""
        kind, accel = res
        if kind == "off":
            ok = self.model.disable(action)
            if action.custom:
                self.forget_name(action)
        else:
            norm = ls.normalize(accel)
            clash = self.model.conflict(action, norm)
            if clash and not self.confirm_replace(norm, clash):
                return False
            if action.custom:
                old = action.id.split(":", 1)[1]
                name = action.label if self.model.names.get(old) else action.value
                ok = self.model.save_custom(name, action.value, norm, old=old)
            else:
                accels = self.model.accels_for(action)
                ok = self.model.assign(action, norm, replace=accels[0] if accels else None)
        self.after_write(ok)
        return ok

    def forget_name(self, action):
        norm = action.id.split(":", 1)[1]
        names = ls.load_names()
        if names.pop(norm, None) is not None:
            ls.save_names(names)
        self.model.reload()

    def confirm_replace(self, norm, clash):
        return ask(self, _("“%s” is already used by “%s”.") % (ls.format_accel(norm), clash),
                   _("Replace it? The other action will lose this shortcut."), _("Replace"))

    def restore(self, action):
        self.after_write(self.model.restore(action))

    def restore_all(self):
        if not ask(self, _("Restore all shortcuts to their defaults?"),
                   _("Your custom shortcuts are kept unless their keys are needed by a default shortcut."),
                   _("Restore Defaults"), destructive=True):
            return
        self.after_write(self.model.restore_all())

    def add_custom(self):
        self.custom_dialog()

    def edit_custom(self, action):
        norm = action.id.split(":", 1)[1]
        name = self.model.names.get(norm, {}).get("name") or ""
        self.custom_dialog(name, action.value, norm)

    def custom_dialog(self, name="", command="", accel=None):
        dlg = CustomDialog(self, self.model, name, command, accel)
        dlg.show_all()
        while dlg.run() == Gtk.ResponseType.OK:
            n, c, a = dlg.values()
            dlg.hide()
            self.after_write(self.model.save_custom(n, c, a, old=accel))
            break
        dlg.destroy()

    def delete_custom(self, action):
        if not ask(self, _("Delete the shortcut “%s”?") % action.label, None, _("Delete"), destructive=True):
            return
        self.after_write(self.model.delete_custom(action.id.split(":", 1)[1]))

    def after_write(self, ok):
        self.model.reload()
        self.build()
        if not ok:
            warn(self, _("The shortcut could not be saved."))

    def feedback(self):
        self.launch(["luxos-feedback"])

    @staticmethod
    def launch(argv):
        try:
            subprocess.Popen(argv, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


def main():
    GLib.set_prgname("luxos-shortcuts")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = ShortcutsWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
