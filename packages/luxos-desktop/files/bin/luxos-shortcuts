#!/bin/bash
# LuxOS - prehled klavesovych zkratek
. /usr/lib/luxos/i18n.sh
yad --title="$(T "Keyboard Shortcuts")" --name=luxos-shortcuts --class=luxos-shortcuts --window-icon=luxos-app --list --no-selection --width=560 --height=600 --center \
    --column="$(T "Shortcut")" --column="$(T "Action")" \
    "Super + Space" "$(T "Search")" \
    "Super + A" "Launchpad" \
    "Super + Q" "$(T "Close window")" \
    "Super + M / H" "$(T "Minimize window")" \
    "Super + Tab" "$(T "Switch windows")" \
    "Super + ↑ / ← / →" "$(T "Maximize / tile half")" \
    "Ctrl + Super + F" "$(T "Full screen")" \
    "Super + D" "$(T "Show desktop")" \
    "Ctrl + Super + ← / →" "$(T "Switch workspace")" \
    "Super + E" "$(T "Files")" \
    "Super + T" "$(T "Terminal")" \
    "Super + ," "$(T "Settings")" \
    "Super + L" "$(T "Lock screen")" \
    "Alt + Shift" "$(T "Switch keyboard layout")" \
    "Super + Shift + 3" "$(T "Screenshot")" \
    "Super + Shift + 4" "$(T "Screenshot of region")" \
    "Super + Shift + 5" "$(T "Screenshot tool")" \
    "Super + Alt + Esc" "$(T "System monitor (force quit)")" \
    --button="$(T "Close")!window-close:0"
