#!/usr/bin/env python3
"""LuxOS - Plocha a Dock: vzhled, tapeta, dock a horni lista na jednom miste.

Nahrazuje xfdesktop-settings (viz /usr/lib/luxos/override-bin). Dock se nastavuje
pres GSettings Planku, vzhled a pruhlednost pres luxos-appearance.
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

WALL_DIRS = ["/usr/share/backgrounds/luxos", os.path.expanduser("~/Pictures/Wallpapers")]
DOCK_SCHEMA = "net.launchpad.plank.dock.settings"
DOCK_PATH = "/net/launchpad/plank/docks/dock1/"
PREFS = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxos/appearance.conf")

CSS = b"""
.group { border-radius: 12px; border: 1px solid alpha(currentColor, 0.12); background-color: alpha(currentColor, 0.04); }
.group-title { font-weight: 700; font-size: 13px; margin: 14px 4px 6px; }
.row { padding: 10px 14px; }
.row-sep { border-top: 1px solid alpha(currentColor, 0.08); }
.hint { font-size: 11px; opacity: 0.6; }
.thumb { border-radius: 10px; padding: 3px; border: 2px solid transparent; background: none; }
.thumb.current { border-color: #3d7bff; }
.mode { border-radius: 12px; padding: 8px; border: 2px solid transparent; background: none; }
.mode.current { border-color: #3d7bff; }
"""


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_prefs():
    prefs = {"BAR_OPACITY": "62", "DOCK_OPACITY": ""}
    try:
        with open(PREFS) as f:
            for line in f:
                k, _sep, v = line.strip().partition("=")
                if k in prefs:
                    prefs[k] = v
    except OSError:
        pass
    return prefs


class Group(Gtk.Box):
    """Skupina radku ve stylu Nastaveni macOS."""

    def __init__(self, parent, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("group-title")
        parent.pack_start(label, False, False, 0)
        self.get_style_context().add_class("group")
        parent.pack_start(self, False, False, 0)
        self.rows = 0

    def row(self, title, widget, hint=None):
        box = Gtk.Box(spacing=12)
        box.get_style_context().add_class("row")
        if self.rows:
            box.get_style_context().add_class("row-sep")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        text.pack_start(Gtk.Label(label=title, xalign=0), False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0, wrap=True, max_width_chars=48)
            h.get_style_context().add_class("hint")
            text.pack_start(h, False, False, 0)
        box.pack_start(text, True, True, 0)
        widget.set_valign(Gtk.Align.CENTER)
        box.pack_end(widget, False, False, 0)
        self.pack_start(box, False, False, 0)
        self.rows += 1
        return box


def slider(lo, hi, value, on_change, width=220, step=1):
    s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
    s.set_value(value)
    s.set_draw_value(False)
    s.set_size_request(width, -1)
    pending = {"id": 0}

    def fire(scale):
        pending["id"] = 0
        on_change(int(scale.get_value()))
        return False

    def changed(scale):
        # Zmena se aplikuje az po kratke pauze (posuvnik posila mnoho udalosti)
        if pending["id"]:
            GLib.source_remove(pending["id"])
        pending["id"] = GLib.timeout_add(250, fire, scale)
    s.connect("value-changed", changed)
    return s


class Settings(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Desktop & Dock"))
        self.set_default_size(720, 720)
        self.set_icon_name("preferences-desktop-wallpaper")
        header = Gtk.HeaderBar(show_close_button=True, title=_("Desktop & Dock"))
        self.set_titlebar(header)

        source = Gio.SettingsSchemaSource.get_default()
        self.dock = Gio.Settings.new_with_path(DOCK_SCHEMA, DOCK_PATH) if source.lookup(DOCK_SCHEMA, True) else None
        self.prefs = read_prefs()

        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.add(scroll)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=22, margin_top=6)
        scroll.add(page)

        self.build_appearance(page)
        self.build_wallpaper(page)
        if self.dock:
            self.build_dock(page)
        self.build_bar(page)

        more = Gtk.Box(spacing=8, margin_top=18)
        for label, cmd in ((_("Advanced Desktop Settings…"), ["/usr/bin/xfdesktop-settings"]),
                           (_("Menu Bar Items…"), ["xfce4-panel", "--preferences"])):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, c=cmd: subprocess.Popen(c, start_new_session=True))
            more.pack_start(b, False, False, 0)
        page.pack_start(more, False, False, 0)

    # ---- Vzhled -----------------------------------------------------------
    def build_appearance(self, page):
        group = Group(page, _("Appearance"))
        box = Gtk.Box(spacing=12, margin=12, halign=Gtk.Align.START)
        current = run("luxos-appearance", "status") or "dark"
        self.mode_buttons = {}
        for mode, label, colors in (("light", _("Light"), ("#f5f6fb", "#d9dcea")),
                                    ("dark", _("Dark"), ("#23243a", "#3a3c5c"))):
            b = Gtk.Button()
            b.get_style_context().add_class("mode")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            prev = Gtk.DrawingArea()
            prev.set_size_request(120, 76)
            prev.connect("draw", self.draw_mode, colors)
            inner.pack_start(prev, False, False, 0)
            inner.pack_start(Gtk.Label(label=label), False, False, 0)
            b.add(inner)
            b.connect("clicked", lambda _b, m=mode: self.set_mode(m))
            if mode == current:
                b.get_style_context().add_class("current")
            self.mode_buttons[mode] = b
            box.pack_start(b, False, False, 0)
        group.pack_start(box, False, False, 0)

    @staticmethod
    def draw_mode(widget, cr, colors):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        def rgb(hexcolor):
            return tuple(int(hexcolor[i:i + 2], 16) / 255 for i in (1, 3, 5))
        r = 10
        cr.new_sub_path()
        cr.arc(w - r, r, r, -1.5708, 0)
        cr.arc(w - r, h - r, r, 0, 1.5708)
        cr.arc(r, h - r, r, 1.5708, 3.1416)
        cr.arc(r, r, r, 3.1416, 4.7124)
        cr.close_path()
        cr.set_source_rgb(*rgb(colors[0]))
        cr.fill()
        cr.set_source_rgb(*rgb(colors[1]))
        cr.rectangle(10, 10, w - 20, 10)
        cr.fill()
        cr.rectangle(10, 28, (w - 20) * 0.6, 34)
        cr.fill()
        cr.set_source_rgb(0.24, 0.48, 1.0)
        cr.rectangle(w * 0.6 + 4, 28, w * 0.4 - 14, 34)
        cr.fill()

    def set_mode(self, mode):
        for m, b in self.mode_buttons.items():
            (b.get_style_context().add_class if m == mode else b.get_style_context().remove_class)("current")
        subprocess.Popen(["luxos-appearance", mode], start_new_session=True)

    # ---- Tapeta -------------------------------------------------------------
    def build_wallpaper(self, page):
        group = Group(page, _("Wallpaper"))
        current = run("xfconf-query", "-c", "xfce4-desktop", "-p",
                      self.first_backdrop_prop()) if self.first_backdrop_prop() else ""
        current = os.path.realpath(current) if current else ""
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4,
                           column_spacing=6, row_spacing=6, margin=10, homogeneous=True)
        self.thumbs = {}
        seen = set()
        for d in WALL_DIRS:
            try:
                names = sorted(os.listdir(d))
            except OSError:
                continue
            for name in names:
                path = os.path.join(d, name)
                real = os.path.realpath(path)
                if real in seen or not name.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                    continue
                seen.add(real)
                self.add_thumb(flow, real, real == current)
        choose = Gtk.Button(label=_("Choose…"))
        choose.connect("clicked", self.choose_wallpaper)
        group.pack_start(flow, False, False, 0)
        group.row(_("Your own picture"), choose)

    def first_backdrop_prop(self):
        props = run("xfconf-query", "-c", "xfce4-desktop", "-l")
        for p in props.splitlines():
            if p.endswith("/workspace0/last-image"):
                return p
        return None

    def add_thumb(self, flow, path, is_current):
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 150, 94, False)
        except GLib.Error:
            return
        b = Gtk.Button()
        b.get_style_context().add_class("thumb")
        if is_current:
            b.get_style_context().add_class("current")
        b.add(Gtk.Image.new_from_pixbuf(pix))
        b.set_tooltip_text(os.path.basename(path).rsplit(".", 1)[0].replace("luxos-", "").replace("-", " ").title())
        b.connect("clicked", lambda _b: self.set_wallpaper(path))
        self.thumbs[path] = b
        flow.add(b)

    def set_wallpaper(self, path):
        for p, b in self.thumbs.items():
            (b.get_style_context().add_class if p == path else b.get_style_context().remove_class)("current")
        subprocess.Popen(["luxos-appearance", "wallpaper", path], start_new_session=True)

    def choose_wallpaper(self, _b):
        dlg = Gtk.FileChooserNative(title=_("Choose a picture"), transient_for=self, action=Gtk.FileChooserAction.OPEN)
        flt = Gtk.FileFilter()
        flt.set_name(_("Pictures"))
        flt.add_mime_type("image/*")
        dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            self.set_wallpaper(dlg.get_filename())

    # ---- Dock -------------------------------------------------------------
    def build_dock(self, page):
        d = self.dock
        group = Group(page, _("Dock"))

        hide = Gtk.Switch(active=d.get_string("hide-mode") == "auto")
        hide.connect("notify::active", self.toggle_autohide)
        group.row(_("Automatically hide and show the Dock"), hide,
                  _("The Dock appears when you move the pointer to the bottom edge."))

        group.row(_("Size"), slider(32, 80, d.get_int("icon-size"), lambda v: d.set_int("icon-size", v)))

        zoom = Gtk.Switch(active=d.get_boolean("zoom-enabled"))
        zoom.connect("notify::active", lambda s, _p: d.set_boolean("zoom-enabled", s.get_active()))
        group.row(_("Magnification"), zoom)
        group.row(_("Magnification size"), slider(110, 200, d.get_int("zoom-percent"),
                                                  lambda v: d.set_int("zoom-percent", v)))

        pos = Gtk.ComboBoxText()
        for key, label in (("bottom", _("Bottom")), ("left", _("Left")), ("right", _("Right"))):
            pos.append(key, label)
        pos.set_active_id(d.get_string("position") if d.get_string("position") in ("bottom", "left", "right") else "bottom")
        pos.connect("changed", lambda c: d.set_string("position", c.get_active_id()))
        group.row(_("Position on screen"), pos)

        opacity = int(self.prefs["DOCK_OPACITY"] or 75)
        group.row(_("Dock opacity"), slider(0, 100, opacity,
                                            lambda v: subprocess.Popen(["luxos-appearance", "dock-opacity", str(v)])))

    def toggle_autohide(self, switch, _p):
        """Skryvani Docku (oba rezimy Dock skryvaji, luxos-menubar ho vysune i kousek nad okrajem)."""
        on = switch.get_active()
        self.dock.set_string("hide-mode", "auto" if on else "window-dodge")
        flag = os.path.join(os.path.dirname(PREFS), "dock-autohide")
        os.makedirs(os.path.dirname(flag), exist_ok=True)
        open(flag, "w").close()

    # ---- Horni lista ----------------------------------------------------------
    def build_bar(self, page):
        group = Group(page, _("Menu Bar"))
        group.row(_("Menu bar opacity"), slider(0, 100, int(self.prefs["BAR_OPACITY"] or 62),
                                                lambda v: subprocess.Popen(["luxos-appearance", "bar-opacity", str(v)])))


def main():
    GLib.set_prgname("luxos-settings")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Settings()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
