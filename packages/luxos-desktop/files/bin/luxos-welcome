#!/bin/bash
# LuxOS - uvitaci okno
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/luxos"
mkdir -p "$cfg"
live=0; [[ -d /run/archiso ]] && live=1

while :; do
    mode=$(luxos-appearance status)
    buttons=()
    ((live)) && buttons+=(--button="Install LuxOS!system-software-install:10")
    buttons+=(--button="$([[ $mode == dark ]] && echo "Light Mode" || echo "Dark Mode")!preferences-desktop-theme:11")
    ((live)) || buttons+=(--button="Drivers!preferences-system:12" --button="Update!system-software-update:13")
    buttons+=(--button="Shortcuts!preferences-desktop-keyboard-shortcuts:14" --button="Close!window-close:0")

    yad --title="Welcome to LuxOS" --window-icon=luxos-logo \
        --image=/usr/share/icons/hicolor/128x128/apps/luxos-logo.png --borders=24 --width=640 --center \
        --text="<span size='xx-large' weight='bold'>Welcome to LuxOS</span>

Fast, light and beautifully simple.

<b>Super + Space</b>  ·  Spotlight: search apps and files
<b>Super + A</b>  ·  Launchpad: all applications
<b>Super + Q</b>  ·  close window
<b>Super + Shift + 4</b>  ·  screenshot of a region
<b>lux</b>  ·  install and update software from Terminal" \
        "${buttons[@]}"
    rc=$?
    case $rc in
        10) setsid -f luxos-install-gui; break ;;
        11) luxos-appearance toggle ;;
        12) xfce4-terminal --title="Drivers" -x bash -c 'lux drivers; echo; read -rp "Press Enter to close"' ;;
        13) xfce4-terminal --title="Update" -x bash -c 'lux update; echo; read -rp "Press Enter to close"' ;;
        14) luxos-shortcuts ;;
        *) break ;;
    esac
done
: > "$cfg/welcome-done"
