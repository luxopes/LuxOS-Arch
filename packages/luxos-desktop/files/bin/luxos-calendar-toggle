#!/bin/sh
# LuxOS - klik na hodiny v liste: bezici demon Kalendare jen prepne (okamzite), jinak ho spusti
pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/luxos-calendar.pid" 2>/dev/null)
if [ -n "$pid" ] && grep -qa luxos-calendar "/proc/$pid/cmdline" 2>/dev/null; then
    exec kill -USR1 "$pid"
fi
exec luxos-calendar
