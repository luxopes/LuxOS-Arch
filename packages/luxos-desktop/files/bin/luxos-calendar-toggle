#!/bin/sh
# LuxOS - klik na hodiny v liste: bezici luxos-hub (SIGUSR2) nebo Kalendar na pozadi (SIGUSR1) jen prepne okno
pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/luxos-calendar.pid" 2>/dev/null)
if [ -n "$pid" ] && grep -qa luxos-hub "/proc/$pid/cmdline" 2>/dev/null; then
    exec kill -USR2 "$pid"
elif [ -n "$pid" ] && grep -qa luxos-calendar "/proc/$pid/cmdline" 2>/dev/null; then
    exec kill -USR1 "$pid"
fi
exec luxos-calendar
