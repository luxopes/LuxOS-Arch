#!/usr/bin/env python3
"""LuxOS Snimek obrazovky - plovouci lista jako v macOS (Shift+Super+5, Print).

  luxos-screenshot                 lista: snimek obrazovky / okna / vyrezu, nahravani, volby
  luxos-screenshot --screen        hned snimek cele obrazovky (Shift+Super+3)
  luxos-screenshot --portion       vyrez tazenim mysi (Shift+Super+4; mezernik = okno)
  luxos-screenshot --window        okno kliknutim
  luxos-screenshot --record-screen / --record-portion   nahravani (ffmpeg x11grab -> mp4)
  luxos-screenshot --stop          zastavi nahravani (stejne jako dalsi spusteni pri nahravani)
  --clipboard   do schranky misto souboru      --output DIR   slozka pro ulozeni
  --region X,Y,W,H   vyrez bez vyberu mysi      --no-thumbnail  bez nahledu po ulozeni

Staticke snimky bere GDK primo z korenoveho okna X (zadna dalsi zavislost); vyrez a okno
se vybiraji nad zmrazenym snimkem obrazovky, takze lista ani prekryv ve snimku nejsou.
Popisek nad listou ukazuje rezim pod mysi / vybrany rezim a zkratku. Drzeny Ctrl pri zachyceni
= do schranky misto souboru (obrazek drzi xclip i po skonceni). Nahled po snimku ma akce
Kopirovat, Zobrazit v Souborech, Ulozit jako, Smazat (do Kose), Zavrit; i pres prave tlacitko.
Volby jsou v ~/.config/luxos/screenshot.json.
"""
import datetime
import json
import os
import re
import signal
import subprocess
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "luxos")
CFG_FILE = os.path.join(CFG_DIR, "screenshot.json")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
PIDFILE = os.path.join(RUNTIME, "luxos-screenshot.pid")

MODES = ("screen", "window", "portion", "rec_screen", "rec_portion")
# "screenshots" = Obrazky/Snimky obrazovky (nazev slozky podle jazyka), vytvori se az pri ulozeni
SAVE_TO = ("screenshots", "desktop", "pictures", "clipboard", "other")
TIMERS = (0, 5, 10)
DEFAULTS = {"save_to": "screenshots", "other_dir": "", "timer": 0, "pointer": False,
            "remember": True, "selection": None, "mode": "portion"}
# Verze souboru voleb: do 0.9.10 (bez klice "version") byla vychozi Plocha a ukladala se
# i bez vyberu uzivatele, takze "desktop" ze starsiho souboru se prevede na novou vychozi slozku
OPTIONS_VERSION = 2
HIDE_DELAY = 180        # ms: cas na prekresleni obrazovky po skryti listy
THUMB_TIME = 5000       # ms: jak dlouho je videt nahled po ulozeni


# ---- volby a nazvy souboru (bez GTK) -----------------------------------------
def load_options(path=CFG_FILE):
    """Volby ze souboru; neplatne nebo chybejici hodnoty nahradi vychozimi."""
    opts = dict(DEFAULTS)
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return opts
    if not isinstance(data, dict):
        return opts
    if data.get("save_to") in SAVE_TO:
        opts["save_to"] = data["save_to"]
    if opts["save_to"] == "desktop" and data.get("version") != OPTIONS_VERSION:
        opts["save_to"] = DEFAULTS["save_to"]
    if isinstance(data.get("other_dir"), str):
        opts["other_dir"] = data["other_dir"]
    if data.get("timer") in TIMERS and not isinstance(data.get("timer"), bool):
        opts["timer"] = data["timer"]
    for k in ("pointer", "remember"):
        if isinstance(data.get(k), bool):
            opts[k] = data[k]
    if data.get("mode") in MODES:
        opts["mode"] = data["mode"]
    sel = data.get("selection")
    if (isinstance(sel, list) and len(sel) == 4 and all(isinstance(v, int) and not isinstance(v, bool) for v in sel)
            and sel[2] > 0 and sel[3] > 0):
        opts["selection"] = sel
    if opts["save_to"] == "other" and not opts["other_dir"]:
        opts["save_to"] = DEFAULTS["save_to"]
    return opts


def save_options(opts, path=CFG_FILE):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            data = {k: opts.get(k, v) for k, v in DEFAULTS.items()}
            data["version"] = OPTIONS_VERSION
            json.dump(data, f, indent=1)
        os.replace(tmp, path)
    except OSError:
        pass


def file_name(when, video=False):
    """'Screenshot 2026-10-22 at 11.12.03.png' (slova podle jazyka, tecky v case jako v macOS)."""
    date, clock = when.strftime("%Y-%m-%d"), when.strftime("%H.%M.%S")
    tpl = _("Screen Recording %s at %s") if video else _("Screenshot %s at %s")
    try:
        name = tpl % (date, clock)
    except (TypeError, ValueError):          # poskozeny preklad
        name = ("Screen Recording %s at %s" if video else "Screenshot %s at %s") % (date, clock)
    return name.replace("/", "-") + (".mp4" if video else ".png")


def unique_path(folder, name):
    """Cesta v adresari, ktera jeste neexistuje: 'X.png', 'X (2).png', ..."""
    base, ext = os.path.splitext(name)
    path, n = os.path.join(folder, name), 2
    while os.path.lexists(path):
        path = os.path.join(folder, f"{base} ({n}){ext}")
        n += 1
    return path


def user_dir(kind):
    """Plocha / Obrazky podle xdg-user-dirs, jinak ~/Desktop, ~/Pictures."""
    from gi.repository import GLib
    special = {"desktop": GLib.UserDirectory.DIRECTORY_DESKTOP,
               "pictures": GLib.UserDirectory.DIRECTORY_PICTURES,
               "videos": GLib.UserDirectory.DIRECTORY_VIDEOS}[kind]
    d = GLib.get_user_special_dir(special)
    home = os.path.expanduser("~")
    if not d or os.path.realpath(d) == os.path.realpath(home):
        d = os.path.join(home, {"desktop": "Desktop", "pictures": "Pictures", "videos": "Videos"}[kind])
    return d


def screenshots_dir():
    """Obrazky/Snimky obrazovky - nazev podslozky podle jazyka (cs: Snimky obrazovky)."""
    name = (_("Screenshots") or "Screenshots").replace("/", "-").strip() or "Screenshots"
    return os.path.join(user_dir("pictures"), name)


def save_dir(opts, video=False, override=None):
    """Kam ulozit soubor; None = schranka (jen u snimku, video do schranky nejde)."""
    if override:
        return override
    to = opts.get("save_to")
    if to == "clipboard":
        return screenshots_dir() if video else None
    if to == "other" and opts.get("other_dir") and os.path.isdir(opts["other_dir"]):
        return opts["other_dir"]
    if to in ("desktop", "pictures"):
        return user_dir(to)
    return screenshots_dir()


def clamp_rect(rect, width, height):
    """Obdelnik oriznuty na obrazovku (x, y, w, h) nebo None, kdyz z nej nic nezbude."""
    x, y, w, h = (int(round(v)) for v in rect)
    if w < 0:
        x, w = x + w, -w
    if h < 0:
        y, h = y + h, -h
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(width, x + w), min(height, y + h)
    if x1 - x0 < 1 or y1 - y0 < 1:
        return None
    return x0, y0, x1 - x0, y1 - y0


def parse_region(text):
    m = re.fullmatch(r"\s*(-?\d+)\s*,\s*(-?\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*", text or "")
    if not m or int(m.group(3)) < 1 or int(m.group(4)) < 1:
        return None
    return tuple(int(v) for v in m.groups())


# ---- klavesove zkratky (napoveda v liste) ------------------------------------------
SHORTCUTS_XML = os.path.join("xfce4", "xfconf", "xfce-perchannel-xml", "xfce4-keyboard-shortcuts.xml")
MOD_NAMES = (("Super", ("super", "mod4", "meta", "hyper")), ("Ctrl", ("primary", "control", "ctrl")),
             ("Alt", ("alt", "mod1")), ("Shift", ("shift",)))


def shortcut_files():
    """Uzivatelske nastaveni zkratek Xfce, pak vychozi (XDG_CONFIG_DIRS, v LuxOS /etc/xdg/luxos)."""
    dirs = [os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")]
    dirs += (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":")
    return [os.path.join(d, SHORTCUTS_XML) for d in dirs if d]


def pretty_accel(accel):
    """'<Super><Shift>4' -> 'Super+Shift+4' (poradi jako v dokumentaci LuxOS)."""
    mods = [m.lower() for m in re.findall(r"<(\w+)>", accel or "")]
    key = re.sub(r"<\w+>", "", accel or "")
    if not key:
        return None
    parts = [name for name, aliases in MOD_NAMES if any(m in aliases for m in mods)]
    return "+".join(parts + [key.upper() if len(key) == 1 else key])


def global_shortcut(command, files=None):
    """Prvni zkratka pro prikaz ze zkratek Xfce ('Super+Shift+3') nebo None.

    Plati prvni soubor, ktery ma vlastni zkratky (commands/custom) - uzivatelsky prebiji vychozi."""
    import xml.etree.ElementTree as ET
    for path in shortcut_files() if files is None else files:
        try:
            root = ET.parse(path).getroot()
        except (OSError, ET.ParseError):
            continue
        custom = root.find("./property[@name='commands']/property[@name='custom']")
        if custom is None:
            continue
        for p in custom.findall("property"):
            if p.get("name") != "override" and (p.get("value") or "").strip() == command:
                return pretty_accel(p.get("name"))
        return None
    return None


# ---- nahravani (ffmpeg) --------------------------------------------------------
ENCODERS = (
    # H.264 (prehraje vse); Arch ffmpeg ma libx264 primo v balicku
    ("libx264", ["-c:v", "libx264", "-preset", "veryfast", "-crf", "23", "-pix_fmt", "yuv420p"]),
    ("libopenh264", ["-c:v", "libopenh264", "-b:v", "8M", "-pix_fmt", "yuv420p"]),
    # zaloha: vestaveny MPEG-4 part 2 (bez externich knihoven)
    ("mpeg4", ["-c:v", "mpeg4", "-q:v", "3", "-pix_fmt", "yuv420p"]),
)


def pick_encoder(encoders_text):
    """Argumenty kodeku podle vypisu 'ffmpeg -encoders' nebo None."""
    for name, args in ENCODERS:
        if re.search(r"^\s*V\S*\s+%s\s" % re.escape(name), encoders_text or "", re.M):
            return list(args)
    return None


def ffmpeg_cmd(display, rect, out, enc, fps=30, pointer=True):
    """Prikaz ffmpeg pro nahravani obdelniku obrazovky (sude rozmery kvuli yuv420p)."""
    x, y, w, h = rect
    w, h = max(2, w - w % 2), max(2, h - h % 2)
    return ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin",
            "-f", "x11grab", "-framerate", str(fps), "-video_size", f"{w}x{h}",
            "-draw_mouse", "1" if pointer else "0", "-i", f"{display}+{x},{y}",
            *enc, "-movflags", "+faststart", "-f", "mp4", "-y", out]


# ---- jedna instance ---------------------------------------------------------------
def other_instance():
    """(pid, stav) bezici instance: toolbar / recording / idle; jinak (None, None)."""
    try:
        with open(PIDFILE) as f:
            pid_s, _sep, state = f.read().strip().partition(" ")
        pid = int(pid_s)
        if pid == os.getpid():
            return None, None
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"luxos-screenshot" not in f.read():
                return None, None
        return pid, state
    except (OSError, ValueError):
        return None, None


def set_state(state):
    try:
        with open(PIDFILE, "w") as f:
            f.write(f"{os.getpid()} {state}")
    except OSError:
        pass


def drop_state():
    try:
        with open(PIDFILE) as f:
            mine = f.read().split(" ")[0] == str(os.getpid())
        if mine:
            os.unlink(PIDFILE)
    except OSError:
        pass


