# Stejne barvy jako Ovladaci centrum (luxos-control-center)
DARK = """
@define-color sb_bg rgba(32, 33, 52, 0.86); @define-color sb_border rgba(255, 255, 255, 0.14);
@define-color sb_fg #f4f4fa; @define-color sb_hover rgba(255, 255, 255, 0.10);
@define-color sb_active rgba(255, 255, 255, 0.20); @define-color sb_sep rgba(255, 255, 255, 0.16);
"""
LIGHT = """
@define-color sb_bg rgba(246, 247, 252, 0.88); @define-color sb_border rgba(0, 0, 0, 0.10);
@define-color sb_fg #1d1d2b; @define-color sb_hover rgba(0, 0, 0, 0.06);
@define-color sb_active rgba(0, 0, 0, 0.13); @define-color sb_sep rgba(0, 0, 0, 0.13);
"""
ACCENT = (0.24, 0.48, 1.0)     # #3d7bff jako v Ovladacim centru


def is_dark():
    s = Gtk.Settings.get_default()
    return "dark" in (s.props.gtk_theme_name or "").lower() or bool(s.props.gtk_application_prefer_dark_theme)


def install_css():
    provider = Gtk.CssProvider()
    composited = Gdk.Screen.get_default().is_composited()

    def load(*_a):
        css = (DARK if is_dark() else LIGHT) + CSS
        if not composited:          # bez kompozitoru pruhlednost nejde: neprusvitne pozadi
            css = re.sub(r"rgba\((\d+), (\d+), (\d+), 0\.8\d\)", r"rgb(\1, \2, \3)", css)
        provider.load_from_data(css.encode())
    load()
    s = Gtk.Settings.get_default()
    s.connect("notify::gtk-theme-name", load)
    s.connect("notify::gtk-application-prefer-dark-theme", load)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def rounded(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
    cr.arc(x + r, y + r, r, 3.1416, 4.7124)
    cr.close_path()


class Popup(Gtk.Window):
    """Okno bez dekorace mimo spravce oken (override-redirect): vzdy navrchu, bez animaci."""

    def __init__(self, radius=0):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.get_style_context().add_class("lx-shot")
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        self.composited = bool(visual and screen.is_composited())
        if self.composited:
            self.set_visual(visual)
        elif radius:
            # Bez kompozitoru by rohy byly cerne: tvar okna oriznout na zaobleny obdelnik
            self.connect("size-allocate", lambda w, a: self.shape(a.width, a.height, radius))

    def shape(self, w, h, r):
        surf = cairo.ImageSurface(cairo.FORMAT_A1, max(1, w), max(1, h))
        cr = cairo.Context(surf)
        rounded(cr, 0, 0, w, h, r)
        cr.fill()
        self.shape_combine_region(Gdk.cairo_region_create_from_surface(surf))


def grab_keyboard(win, tries=20):
    """Klavesnice pro okno mimo spravce oken (Esc, Enter); po klavesove zkratce chvili opakovat."""
    seat = Gdk.Display.get_default().get_default_seat()
    left = [tries]

    def attempt():
        gw = win.get_window()
        if gw and gw.is_visible():
            st = seat.grab(gw, Gdk.SeatCapabilities.KEYBOARD, True, None, None, None, None)
            if st == Gdk.GrabStatus.SUCCESS:
                return False
        left[0] -= 1
        return left[0] > 0
    if attempt():
        GLib.timeout_add(50, attempt)


def ungrab():
    Gdk.Display.get_default().get_default_seat().ungrab()


# ---- zachyceni obrazovky ----------------------------------------------------------
def root_window():
    return Gdk.get_default_root_window()


def grab(rect=None):
    """Pixbuf korenoveho okna (v pixelech zarizeni) nebo jeho casti v logickych souradnicich."""
    root = root_window()
    rw, rh = root.get_width(), root.get_height()
    r = clamp_rect(rect, rw, rh) if rect else (0, 0, rw, rh)
    if not r:
        return None
    return Gdk.pixbuf_get_from_window(root, *r)


def cursor_image():
    """Kurzor mysi (pixbuf, x, y leveho horniho rohu) pres XFixes, nebo None."""
    import ctypes
    import ctypes.util

    class Img(ctypes.Structure):
        _fields_ = [("x", ctypes.c_short), ("y", ctypes.c_short), ("width", ctypes.c_ushort),
                    ("height", ctypes.c_ushort), ("xhot", ctypes.c_ushort), ("yhot", ctypes.c_ushort),
                    ("serial", ctypes.c_ulong), ("pixels", ctypes.POINTER(ctypes.c_ulong)),
                    ("atom", ctypes.c_ulong), ("name", ctypes.c_char_p)]
    try:
        x11 = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
        xf = ctypes.CDLL(ctypes.util.find_library("Xfixes") or "libXfixes.so.3")
    except OSError:
        return None
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    x11.XFree.argtypes = [ctypes.c_void_p]
    xf.XFixesGetCursorImage.restype = ctypes.POINTER(Img)
    xf.XFixesGetCursorImage.argtypes = [ctypes.c_void_p]
    dpy = x11.XOpenDisplay(None)
    if not dpy:
        return None
    try:
        p = xf.XFixesGetCursorImage(dpy)
        if not p:
            return None
        im = p.contents
        w, h = im.width, im.height
        if not w or not h or w * h > 512 * 512:
            x11.XFree(p)
            return None
        buf = bytearray(w * h * 4)
        px = im.pixels
        for i in range(w * h):
            v = px[i] & 0xFFFFFFFF
            a = v >> 24
            if a:       # XFixes dava predem vynasobene ARGB, pixbuf chce RGBA bez nasobeni
                buf[i * 4] = min(255, ((v >> 16) & 255) * 255 // a)
                buf[i * 4 + 1] = min(255, ((v >> 8) & 255) * 255 // a)
                buf[i * 4 + 2] = min(255, (v & 255) * 255 // a)
                buf[i * 4 + 3] = a
        pos = (im.x - im.xhot, im.y - im.yhot)
        x11.XFree(p)
        pb = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(buf)), GdkPixbuf.Colorspace.RGB,
                                             True, 8, w, h, w * 4)
        return pb, pos[0], pos[1]
    finally:
        x11.XCloseDisplay(dpy)


def add_cursor(pb, origin, cursor, scale=1):
    """Vlozi kurzor (z cursor_image) do snimku, jehoz levy horni roh je na origin (logicky)."""
    if not pb or not cursor:
        return pb
    cpb, cx, cy = cursor        # XFixes vraci pixely zarizeni
    dx, dy = cx - origin[0] * scale, cy - origin[1] * scale
    x0, y0 = max(0, dx), max(0, dy)
    x1, y1 = min(pb.get_width(), dx + cpb.get_width()), min(pb.get_height(), dy + cpb.get_height())
    if x1 > x0 and y1 > y0:
        cpb.composite(pb, x0, y0, x1 - x0, y1 - y0, dx, dy, 1, 1, GdkPixbuf.InterpType.NEAREST, 255)
    return pb


def frame_extents(xid):
    """_GTK_FRAME_EXTENTS (neviditelny okraj se stinem u oken GTK s vlastni hlavickou)."""
    try:
        out = subprocess.run(["xprop", "-id", str(xid), "-notype", "_GTK_FRAME_EXTENTS"],
                             capture_output=True, text=True, timeout=1).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"=\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)", out)
    return tuple(int(v) for v in m.groups()) if m else None


class WindowList:
    """Viditelna okna aplikaci od nejvyssiho (libwnck se nacita az pri vyberu okna)."""

    def __init__(self):
        self.items = []
        try:
            gi.require_version("Wnck", "3.0")
            from gi.repository import Wnck
        except (ValueError, ImportError):
            return
        scr = Wnck.Screen.get_default()
        if not scr:
            return
        scr.force_update()
        ws = scr.get_active_workspace()
        ok = (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG, Wnck.WindowType.UTILITY,
              Wnck.WindowType.TOOLBAR, Wnck.WindowType.MENU, Wnck.WindowType.SPLASHSCREEN)
        for w in reversed(scr.get_windows_stacked() or []):
            if w.get_window_type() not in ok or w.is_minimized():
                continue
            if ws and not w.is_visible_on_workspace(ws):
                continue
            self.items.append([w, None])

    def rect(self, item):
        if item[1] is None:
            w = item[0]
            x, y, ww, hh = w.get_geometry()           # ramecek xfwm4 bez stinu kompozitoru
            ext = frame_extents(w.get_xid())
            if ext:
                cx, cy, cw, ch = w.get_client_window_geometry()
                l, r, t, b = ext
                if cw - l - r > 0 and ch - t - b > 0:
                    x, y, ww, hh = cx + l, cy + t, cw - l - r, ch - t - b
            item[1] = (x, y, ww, hh)
        return item[1]

    def at(self, px, py):
        for it in self.items:
            x, y, w, h = self.rect(it)
            if x <= px < x + w and y <= py < y + h:
                return (x, y, w, h)
        return None


# ---- ikony listy (vlastni kresba) --------------------------------------------------------
def _dashed(cr, x, y, w, h):
    cr.set_dash([2.2, 1.8])
    rounded(cr, x, y, w, h, 2)
    cr.stroke()
    cr.set_dash([])


def icon_close(cr, w, h, rgba):
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.22)
    cr.arc(w / 2, h / 2, 8, 0, 6.2832)
    cr.fill()
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.85)
    cr.set_line_width(1.5)
    for a, b in ((-3, 3), (3, -3)):
        cr.move_to(w / 2 - 3, h / 2 + a)
        cr.line_to(w / 2 + 3, h / 2 + b)
    cr.stroke()


def icon_screen(cr, w, h, rgba):
    rounded(cr, 2.5, 3.5, w - 5, h - 7, 2.5)
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.25)
    cr.fill_preserve()
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
    cr.stroke()


def icon_window(cr, w, h, rgba):
    _dashed(cr, 1.5, 1.5, w - 3, h - 3)
    rounded(cr, 5.5, 5.5, w - 11, h - 11, 1.5)
    cr.stroke()
    cr.rectangle(5.5, 5.5, w - 11, 2.5)
    cr.fill()


def icon_portion(cr, w, h, rgba):
    _dashed(cr, 2.5, 3.5, w - 5, h - 7)


def _rec_dot(cr, w, h, rgba):
    cr.set_operator(cairo.OPERATOR_CLEAR)
    cr.arc(w - 5, h - 4.5, 5, 0, 6.2832)
    cr.fill()
    cr.set_operator(cairo.OPERATOR_OVER)
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
    cr.arc(w - 5, h - 4.5, 3.2, 0, 6.2832)
    cr.fill()


def icon_rec_screen(cr, w, h, rgba):
    cr.push_group()
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
    cr.set_line_width(1.4)
    rounded(cr, 2.5, 3.5, w - 7, h - 8, 2.5)
    cr.stroke()
    _rec_dot(cr, w, h, rgba)
    cr.pop_group_to_source()
    cr.paint()


def icon_rec_portion(cr, w, h, rgba):
    cr.push_group()
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
    cr.set_line_width(1.4)
    _dashed(cr, 2.5, 3.5, w - 7, h - 8)
    _rec_dot(cr, w, h, rgba)
    cr.pop_group_to_source()
    cr.paint()


def icon_stop(cr, w, h, rgba):
    cr.set_source_rgb(1.0, 0.23, 0.19)
    rounded(cr, w / 2 - 5, h / 2 - 5, 10, 10, 2.5)
    cr.fill()


class Icon(Gtk.DrawingArea):
    def __init__(self, painter, w=26, h=18):
        super().__init__()
        self.set_size_request(w, h)
        self.painter = painter
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        ctx = widget.get_style_context()
        rgba = ctx.get_color(ctx.get_state())
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, rgba.alpha)
        cr.set_line_width(1.7)
        self.painter(cr, widget.get_allocated_width(), widget.get_allocated_height(), rgba)


# ---- okna ---------------------------------------------------------------------------------
def mode_name(mode):
    return {"screen": _("Capture Entire Screen"), "window": _("Capture Selected Window"),
            "portion": _("Capture Selected Portion"), "rec_screen": _("Record Entire Screen"),
            "rec_portion": _("Record Selected Portion")}[mode]


# Prikaz, jehoz globalni zkratku lista ukaze u rezimu
MODE_COMMANDS = {"screen": "luxos-screenshot --screen", "portion": "luxos-screenshot --portion"}
_SHORTCUTS = {}


def mode_shortcut(mode):
    cmd = MODE_COMMANDS.get(mode)
    if cmd and cmd not in _SHORTCUTS:
        _SHORTCUTS[cmd] = global_shortcut(cmd)       # soubor se cte jen jednou
    return _SHORTCUTS.get(cmd)


def ctrl_held():
    """Drzi uzivatel Ctrl? Ze stavu udalosti, ktera prave probiha (klik, klavesa)."""
    ok, state = Gtk.get_current_event_state()
    return bool(ok and state & Gdk.ModifierType.CONTROL_MASK)


class Caption(Popup):
    """Popisek nad listou: nazev rezimu pod mysi (hned, bez cekani jako u tooltipu)
    a jinak vybrany rezim; vpravo klavesova zkratka nebo napoveda."""

    def __init__(self):
        super().__init__(radius=9)
        box = Gtk.Box(spacing=7)
        box.get_style_context().add_class("caption")
        self.name, self.key, self.hint = Gtk.Label(), Gtk.Label(), Gtk.Label()
        for lab, cls in ((self.name, "name"), (self.key, "key"), (self.hint, "hint")):
            lab.get_style_context().add_class(cls)
            box.pack_start(lab, False, False, 0)
        self.add(box)
        box.show_all()
        self.text = None
        self.anchor = None          # (stred x, horni okraj listy)

    def set(self, name, key=None, hint=None):
        if self.text == (name, key, hint):
            return
        self.text = (name, key, hint)
        self.name.set_text(name)
        for lab, val in ((self.key, key), (self.hint, hint)):
            lab.set_text(val or "")
            lab.set_visible(bool(val))
        self.resize(1, 1)           # i zmensit, kdyz je novy text kratsi
        self.reposition()

    def reposition(self):
        if self.anchor:
            size = self.get_preferred_size()[1]
            self.move(self.anchor[0] - size.width // 2, self.anchor[1] - size.height - 6)


class Toolbar(Popup):
    def __init__(self, app):
        super().__init__(radius=18)
        self.app = app
        self.mode = None
        self.hovered = None
        self.ctrl = False
        self.caption = Caption()
        bar = Gtk.Box(spacing=4)
        bar.get_style_context().add_class("bar")
        self.add(bar)

        def tool(painter, key, cb, w=34, h=24):
            b = Gtk.Button(can_focus=False)
            b.add(Icon(painter, w, h))
            b.connect("clicked", lambda _b: cb())
            bar.pack_start(b, False, False, 0)
            self.hoverable(b, key)
            return b

        def sep():
            s = Gtk.Box()
            s.get_style_context().add_class("sep")
            bar.pack_start(s, False, False, 0)

        close = tool(icon_close, "close", app.cancel, 22, 22)
        close.get_style_context().add_class("close")
        sep()
        self.modes = {}
        for mode, painter in (("screen", icon_screen), ("window", icon_window), ("portion", icon_portion),
                              (None, None), ("rec_screen", icon_rec_screen), ("rec_portion", icon_rec_portion)):
            if mode is None:
                sep()
                continue
            self.modes[mode] = tool(painter, mode, lambda m=mode: app.set_mode(m), 40, 26)
        sep()
        opt = self.options = Gtk.Button(can_focus=False)
        ob = Gtk.Box(spacing=3)
        ob.pack_start(Gtk.Label(label=_("Options")), False, False, 0)
        ob.pack_start(Gtk.Image.new_from_icon_name("pan-down-symbolic", Gtk.IconSize.MENU), False, False, 0)
        opt.add(ob)
        opt.connect("clicked", lambda _b: app.options_menu(opt))
        bar.pack_start(opt, False, False, 0)
        self.hoverable(opt, "options")
        self.capture = Gtk.Button(label=_("Capture"), can_focus=False)
        self.capture.get_style_context().add_class("capture")
        self.capture.connect("clicked", lambda _b: app.capture())
        bar.pack_start(self.capture, False, False, 0)
        self.hoverable(self.capture, "capture")
        self.connect("key-press-event", app.on_key)
        self.connect("key-release-event", app.on_key_release)
        # Popisek je samostatne okno (bez kompozitoru nejde pruhledna mezera) - jde s listou
        self.connect("map", lambda _w: self.show_caption())
        self.connect("unmap", lambda _w: self.caption.hide())
        self.connect("destroy", lambda _w: self.caption.destroy())

    def hoverable(self, button, key):
        # Pristupnost: tlacitka s ikonou maji jmeno i bez tooltipu
        name = {"close": _("Close"), "options": _("Options"), "capture": _("Capture")}.get(key)
        button.get_accessible().set_name(name or mode_name(key))
        button.connect("enter-notify-event", lambda *_a: self.hover(key))
        button.connect("leave-notify-event", lambda *_a: self.hover(None))

    def describe(self, key):
        """(nazev, klavesa, napoveda) pro popisek nad listou."""
        mode = self.mode or "portion"
        if key == "close":
            return _("Close"), "Esc", None
        if key == "options":
            dest = {"screenshots": _("Screenshots"), "desktop": _("Desktop"), "pictures": _("Pictures"),
                    "clipboard": _("Clipboard")}.get(
                self.app.opts["save_to"]) or os.path.basename(self.app.opts["other_dir"].rstrip("/"))
            try:
                return _("Save to: %s") % dest, None, None
            except (TypeError, ValueError):         # poskozeny preklad
                return "Save to: %s" % dest, None, None
        if key == "capture":
            copy = not mode.startswith("rec_") and mode != "window"
            return mode_name(mode), "Enter", _("Hold Ctrl to copy to the clipboard") if copy else None
        if key in MODES:
            hint = _("Click a window to capture it") if key == "window" else None
            return mode_name(key), mode_shortcut(key), hint
        return "", None, None

    def hover(self, key):
        self.hovered = key
        self.update_caption()
        return False

    def update_caption(self):
        self.caption.set(*self.describe(self.hovered or self.mode or "portion"))

    def show_caption(self):
        self.update_caption()
        self.caption.show()
        gw = self.caption.get_window()
        if gw:
            gw.raise_()

    def set_mode(self, mode):
        self.mode = mode
        for m, b in self.modes.items():
            (b.get_style_context().add_class if m == mode else b.get_style_context().remove_class)("active")
        self.set_ctrl(self.ctrl)
        self.capture.set_sensitive(mode != "window")      # okno se zachyti kliknutim na nej
        self.update_caption()

    def set_ctrl(self, held):
        """Drzeny Ctrl: tlacitko ukaze Kopirovat (snimek pujde do schranky)."""
        self.ctrl = held
        mode = self.mode or "portion"
        if mode.startswith("rec_"):
            self.capture.set_label(_("Record"))
        else:
            self.capture.set_label(_("Copy") if held else _("Capture"))

    def place(self):
        """Dole uprostred monitoru s mysi, nad Dockem; popisek nad listou."""
        disp = Gdk.Display.get_default()
        mon = monitor_at_pointer(disp)
        g = mon.get_geometry()
        w, h = self.get_preferred_size()[1].width, self.get_preferred_size()[1].height
        x, y = g.x + (g.width - w) // 2, g.y + g.height - h - max(90, g.height // 10)
        self.move(x, y)
        self.caption.anchor = (x + w // 2, y)
        self.caption.reposition()


def monitor_at_pointer(disp):
    try:
        _s, x, y = disp.get_default_seat().get_pointer().get_position()
        return disp.get_monitor_at_point(x, y)
    except (AttributeError, TypeError):
        return disp.get_primary_monitor() or disp.get_monitor(0)


class Overlay(Popup):
    """Vyber vyrezu nebo okna pres celou plochu.

    quick (zkratka bez listy): ztmaveny zmrazeny snimek, mys i klavesnice jen pro vyber.
    S listou je prekryv zivy a pruhledny (surface None): mys zachyti jen ramecek vyberu, mimo nej
    jdou kliknuti do aplikaci pod nim - pri otevrene liste jde dal otevirat a klikat."""
    HANDLE = 9

    def __init__(self, app, surface, mode, selection=None, quick=False):
        super().__init__()
        self.app, self.surface, self.quick = app, surface, quick
        self.live = surface is None
        if self.live:
            vis = self.get_screen().get_rgba_visual()
            if vis:
                self.set_visual(vis)
            self.set_app_paintable(True)
        root = root_window()
        self.sw, self.sh = root.get_width(), root.get_height()
        self.move(0, 0)
        self.set_default_size(self.sw, self.sh)
        self.sel = list(selection) if selection else None
        self.drag = None
        self.hover = None
        self.windows = None
        self.mode = None
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.KEY_PRESS_MASK |
                        Gdk.EventMask.KEY_RELEASE_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("key-press-event", self.on_key)
        self.connect("key-release-event", app.on_key_release)
        self.connect("realize", lambda w: self.set_cursor("crosshair"))
        self.set_mode(mode)

    def set_cursor(self, name):
        gw = self.get_window()
        if gw:
            gw.set_cursor(Gdk.Cursor.new_from_name(gw.get_display(), name))

    def set_mode(self, mode):
        self.mode = "window" if mode == "window" else "portion"
        if self.mode == "window" and self.windows is None:
            self.windows = WindowList()
        if self.mode == "portion" and not self.sel and not self.quick:
            w, h = self.sw // 2, self.sh // 2
            self.sel = [(self.sw - w) // 2, (self.sh - h) // 2, w, h]
        self.hover = None
        self.set_cursor("crosshair" if self.mode == "portion" else "default")
        self.update_input()
        self.queue_draw()

    def update_input(self):
        """Zivy prekryv: mys jen v ramecku vyberu (+uchyty); v rezimu okna cela plocha (klik vybere okno)."""
        if not self.live:
            return
        sel = self.norm() if self.mode == "portion" else None
        if self.mode == "portion" and sel and not self.drag:
            m = self.HANDLE + 2
            x, y, w, h = sel
            region = cairo.Region(cairo.RectangleInt(int(x - m), int(y - m), int(w + 2 * m), int(h + 2 * m)))
        else:
            region = None
        self.input_shape_combine_region(region)

    def queue_draw(self):
        super().queue_draw()
        if getattr(self, "live", False) and self.get_realized():
            self.update_input()

    # -- kresleni
    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        if self.live:
            cr.set_source_rgba(0, 0, 0, 0)
        else:
            cr.set_source_surface(self.surface, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if self.mode == "window":
            if self.hover:
                x, y, w, h = self.hover
                cr.rectangle(x, y, w, h)
                cr.set_source_rgba(*ACCENT, 0.28)
                cr.fill()
            return
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        cr.rectangle(0, 0, self.sw, self.sh)
        sel = self.norm()
        if sel:
            cr.rectangle(*sel)
        cr.set_source_rgba(0, 0, 0, 0.22 if self.live else 0.38)
        cr.fill()
        if not sel:
            return
        x, y, w, h = sel
        cr.set_line_width(1)
        cr.rectangle(x - 0.5, y - 0.5, w + 1, h + 1)
        cr.set_source_rgba(0, 0, 0, 0.5)
        cr.stroke()
        cr.rectangle(x + 0.5, y + 0.5, max(0, w - 1), max(0, h - 1))
        cr.set_source_rgba(1, 1, 1, 0.95)
        cr.stroke()
        if not self.quick:
            for hx, hy, _e in self.handles(sel):
                cr.arc(hx, hy, 4.5, 0, 6.2832)
                cr.set_source_rgba(1, 1, 1, 1)
                cr.fill_preserve()
                cr.set_source_rgba(0, 0, 0, 0.35)
                cr.stroke()
        # Popisek s rozmery pod vyberem
        text = f"{w} × {h}"
        cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(12)
        ext = cr.text_extents(text)
        bw, bh = ext.width + 16, 22
        bx = min(max(4, x + (w - bw) / 2), self.sw - bw - 4)
        by = y + h + 10 if y + h + 10 + bh < self.sh else y + h - bh - 10
        if by < 4:
            by = 4
        rounded(cr, bx, by, bw, bh, 6)
        cr.set_source_rgba(0.1, 0.1, 0.14, 0.82)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.move_to(bx + 8 - ext.x_bearing, by + bh / 2 - ext.y_bearing - ext.height / 2)
        cr.show_text(text)

    def norm(self):
        if not self.sel:
            return None
        return clamp_rect(self.sel, self.sw, self.sh)

    @staticmethod
    def handles(sel):
        x, y, w, h = sel
        return [(x, y, "nw"), (x + w / 2, y, "n"), (x + w, y, "ne"), (x + w, y + h / 2, "e"),
                (x + w, y + h, "se"), (x + w / 2, y + h, "s"), (x, y + h, "sw"), (x, y + h / 2, "w")]

    def hit(self, px, py):
        sel = self.norm()
        if not sel or self.quick:
            return None
        for hx, hy, edge in self.handles(sel):
            if abs(px - hx) <= self.HANDLE and abs(py - hy) <= self.HANDLE:
                return edge
        x, y, w, h = sel
        return "move" if x <= px < x + w and y <= py < y + h else None

    # -- mys a klavesy
    def on_press(self, _w, ev):
        if ev.button != 1:
            if ev.button == 3 and self.quick:
                self.app.cancel()
            return True
        if self.mode == "window":
            r = self.windows.at(ev.x_root, ev.y_root) if self.windows else None
            if r:
                self.app.selected(r, window=True, ctrl=bool(ev.state & Gdk.ModifierType.CONTROL_MASK))
            return True
        if ev.type == Gdk.EventType._2BUTTON_PRESS and self.hit(ev.x, ev.y) == "move":
            self.app.capture()
            return True
        part = self.hit(ev.x, ev.y)
        if part:
            self.drag = (part, ev.x, ev.y, list(self.norm()), self.sel)
        else:
            self.drag = ("new", ev.x, ev.y, None, self.sel)
            self.sel = [int(ev.x), int(ev.y), 0, 0]
        self.queue_draw()
        return True

    def on_motion(self, _w, ev):
        if self.mode == "window":
            r = self.windows.at(ev.x_root, ev.y_root) if self.windows else None
            if r != self.hover:
                self.hover = r
                self.queue_draw()
            return True
        if not self.drag:
            part = self.hit(ev.x, ev.y)
            names = {"move": "move", "n": "n-resize", "s": "s-resize", "e": "e-resize", "w": "w-resize",
                     "ne": "ne-resize", "nw": "nw-resize", "se": "se-resize", "sw": "sw-resize"}
            self.set_cursor(names.get(part, "crosshair"))
            return True
        kind, x0, y0, orig, _prev = self.drag
        dx, dy = ev.x - x0, ev.y - y0
        if kind == "new":
            self.sel = [int(x0), int(y0), int(dx), int(dy)]
        elif kind == "move":
            x = min(max(0, orig[0] + dx), self.sw - orig[2])
            y = min(max(0, orig[1] + dy), self.sh - orig[3])
            self.sel = [int(x), int(y), orig[2], orig[3]]
        else:
            x, y, w, h = orig
            x1, y1 = x + w, y + h
            if "w" in kind:
                x = x + dx
            if "e" in kind:
                x1 = x1 + dx
            if "n" in kind:
                y = y + dy
            if "s" in kind:
                y1 = y1 + dy
            self.sel = [int(x), int(y), int(x1 - x), int(y1 - y)]
        self.queue_draw()
        return True

    def on_release(self, _w, ev):
        if ev.button != 1 or not self.drag:
            return True
        prev = self.drag[4]
        self.drag = None
        sel = self.norm()
        if not sel or sel[2] < 3 or sel[3] < 3:
            self.sel = prev     # pouhy klik: puvodni vyber zustava
            self.queue_draw()
            return True
        self.sel = list(sel)
        if self.quick:
            self.app.selected(sel, ctrl=bool(ev.state & Gdk.ModifierType.CONTROL_MASK))
        self.queue_draw()           # zivy prekryv: zachytavani mysi zase jen v ramecku
        return True

    def on_key(self, w, ev):
        if ev.keyval == Gdk.KEY_space and self.quick and not self.drag and self.app.mode != "rec_portion":
            self.set_mode("portion" if self.mode == "window" else "window")
            return True
        return self.app.on_key(w, ev)


class Thumbnail(Popup):
    """Nahled vpravo dole s akcemi Kopirovat / Zobrazit v Souborech / Ulozit jako / Smazat / Zavrit.

    Klik na obrazek otevre soubor, tazenim ho lze vlozit do jine aplikace, prave tlacitko = nabidka."""

    def __init__(self, app, path, pb, copied=False, video=False):
        super().__init__(radius=12)
        self.app, self.path, self.full, self.copied, self.video = app, path, pb, copied, video
        self.on_done = app.done
        w, h = pb.get_width(), pb.get_height()
        s = min(200 / w, 140 / h, 1)
        self.pb = pb.scale_simple(max(1, int(w * s)), max(1, int(h * s)), GdkPixbuf.InterpType.BILINEAR)
        card = Gtk.Box(spacing=8)
        card.get_style_context().add_class("thumb")
        img = self.image = Gtk.DrawingArea()
        img.set_size_request(self.pb.get_width(), self.pb.get_height())
        img.set_valign(Gtk.Align.CENTER)
        img.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK)
        img.connect("draw", self.on_draw)
        img.connect("button-release-event", self.on_click)
        img.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, [], Gdk.DragAction.COPY)
        if path:
            img.drag_source_add_uri_targets()
        else:
            img.drag_source_add_image_targets()
        img.drag_source_set_icon_pixbuf(self.pb)
        img.connect("drag-data-get", self.on_drag_get)
        img.connect("drag-begin", lambda *_a: setattr(self, "dragging", True))
        img.connect("drag-end", lambda *_a: self.finish())
        card.pack_start(img, False, False, 0)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        col.set_valign(Gtk.Align.CENTER)
        if copied:          # snimek uz je ve schrance (volba Schranka nebo Ctrl)
            st = Gtk.Box(spacing=6, margin_start=7, margin_bottom=3)
            st.pack_start(Gtk.Image.new_from_icon_name("object-select-symbolic", Gtk.IconSize.MENU), False, False, 0)
            lab = Gtk.Label(label=_("Copied to Clipboard"), xalign=0)
            lab.get_style_context().add_class("status")
            st.pack_start(lab, False, False, 0)
            col.pack_start(st, False, False, 0)
        self.buttons = {}
        for key, icon, label in self.actions():
            b = Gtk.Button(can_focus=False)
            bx = Gtk.Box(spacing=7)
            image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
            lab = Gtk.Label(label=label, xalign=0)
            bx.pack_start(image, False, False, 0)
            bx.pack_start(lab, True, True, 0)
            b.add(bx)
            b.connect("clicked", lambda _b, k=key: self.act(k))
            col.pack_start(b, False, False, 0)
            self.buttons[key] = (b, image, lab)
        card.pack_start(col, False, False, 0)
        self.add(card)
        card.show_all()
        g = monitor_at_pointer(Gdk.Display.get_default()).get_geometry()
        size = self.get_preferred_size()[1]
        self.move(g.x + g.width - size.width - 24, g.y + g.height - size.height - 96)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK |
                        Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("button-press-event", self.on_press)
        self.connect("enter-notify-event", lambda *_a: self.stop_timer())
        self.connect("leave-notify-event", self.on_leave)
        self.dragging = False
        self.menu = None
        self.timer = None
        self.start_timer()

    def actions(self):
        """(klic, ikona, popisek) tlacitek podle toho, co se zachytilo."""
        acts = []
        if not self.video and not self.copied:
            acts.append(("copy", "edit-copy-symbolic", _("Copy")))
        if self.path:
            acts.append(("reveal", "folder-open-symbolic", _("Show in Files")))
        acts.append(("save_as", "document-save-as-symbolic", _("Save As…")))
        if self.path:
            acts.append(("delete", "user-trash-symbolic", _("Delete")))
        acts.append(("close", "window-close-symbolic", _("Close")))
        return acts

    def start_timer(self):
        self.stop_timer()
        if self.on_done:
            self.timer = GLib.timeout_add(THUMB_TIME, self.finish)

    def stop_timer(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None

    def on_leave(self, _w, ev):
        if ev.detail != Gdk.NotifyType.INFERIOR and not self.menu:   # presun na tlacitko neni odchod
            self.start_timer()
        return False

    def on_draw(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        rounded(cr, 0, 0, w, h, 7)
        cr.clip()
        Gdk.cairo_set_source_pixbuf(cr, self.pb, (w - self.pb.get_width()) / 2, (h - self.pb.get_height()) / 2)
        cr.paint()
        cr.reset_clip()
        rounded(cr, 0.5, 0.5, w - 1, h - 1, 7)
        cr.set_source_rgba(0, 0, 0, 0.16)
        cr.set_line_width(1)
        cr.stroke()

    def on_drag_get(self, _w, _ctx, data, _info, _time):
        if self.path:
            data.set_uris([GLib.filename_to_uri(self.path)])
        else:
            data.set_pixbuf(self.full)

    def on_click(self, _w, ev):
        if ev.button == 1 and not self.dragging:
            if self.path:
                open_uri(GLib.filename_to_uri(self.path))
                self.finish()
            return True
        return False

    def on_press(self, _w, ev):
        if ev.button == 3:
            self.popup_menu(ev)
            return True
        return False

    def popup_menu(self, ev=None):
        menu = Gtk.Menu()
        items = ([("open", None, _("Open"))] if self.path else []) + self.actions()
        for key, _icon, label in items:
            if key == "close":
                menu.append(Gtk.SeparatorMenuItem())
            it = Gtk.MenuItem(label=label)
            # akce az po zavreni nabidky (dialog Ulozit jako nesmi bezet pod jejim zachycenim)
            it.connect("activate", lambda _i, k=key: GLib.idle_add(lambda: self.act(k) and False))
            menu.append(it)
        menu.show_all()
        menu.attach_to_widget(self, None)
        self.stop_timer()

        def closed(_m):
            self.menu = None
            self.start_timer()
        menu.connect("hide", closed)
        self.menu = menu
        if ev:
            menu.popup_at_pointer(ev)
        else:
            menu.popup_at_widget(self, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.SOUTH_WEST, None)
        return menu

    def act(self, key):
        if not self.on_done:            # nahled uz je zavreny
            return False
        if key == "copy":
            if self.app.copy_image(self.full):
                _b, image, lab = self.buttons["copy"]
                image.set_from_icon_name("object-select-symbolic", Gtk.IconSize.MENU)
                lab.set_text(_("Copied"))
            self.start_timer()
        elif key == "open":
            open_uri(GLib.filename_to_uri(self.path))
            self.finish()
        elif key == "reveal":
            self.stop_timer()
            self.hide()
            self.app.reveal(self.path, self.finish)
        elif key == "save_as":
            self.stop_timer()
            self.hide()             # dialog spravuje WM, nahled mimo WM by ho zakryl
            if self.app.save_as(self.full, self.path, self.video):
                self.finish()
            else:
                self.show()
                self.start_timer()
        elif key == "delete":
            if self.app.trash(self.path):
                self.finish()
        elif key == "close":
            self.finish()
        return False

    def finish(self, *_a):
        self.stop_timer()
        if self.on_done:
            cb, self.on_done = self.on_done, None
            self.destroy()
            cb()
        return False


class Pill(Popup):
    """Plovouci tlacitko pri nahravani: cas a Zastavit."""

    def __init__(self, on_stop, avoid=None):
        super().__init__(radius=16)
        box = Gtk.Box(spacing=8)
        box.get_style_context().add_class("pill")
        dot = Icon(lambda cr, w, h, _c: (cr.set_source_rgb(1, 0.23, 0.19), cr.arc(w / 2, h / 2, 4.5, 0, 6.2832),
                                         cr.fill()), 10, 18)
        box.pack_start(dot, False, False, 0)
        self.label = Gtk.Label(label="0:00")
        box.pack_start(self.label, False, False, 0)
        stop = Gtk.Button(can_focus=False, tooltip_text=_("Stop Recording"))
        sb = Gtk.Box(spacing=5)
        sb.pack_start(Icon(icon_stop, 14, 18), False, False, 0)
        sb.pack_start(Gtk.Label(label=_("Stop")), False, False, 0)
        stop.add(sb)
        stop.connect("clicked", lambda _b: on_stop())
        box.pack_start(stop, False, False, 0)
        self.add(box)
        box.show_all()
        disp = Gdk.Display.get_default()
        g = monitor_at_pointer(disp).get_geometry()
        w, h = self.get_preferred_size()[1].width, self.get_preferred_size()[1].height
        x, y = g.x + (g.width - w) // 2, g.y + 40          # pod horni listou
        if avoid:      # u vyrezu tlacitko mimo nahravanou oblast (nad ni nebo pod ni)
            ax, ay, aw, ah = avoid
            if ay < y + h + 8 and y < ay + ah:
                y = ay + ah + 10 if ay + ah + 10 + h < g.y + g.height else max(g.y, ay - h - 10)
                x = min(max(g.x, ax + (aw - w) // 2), g.x + g.width - w)
        self.move(x, y)

    def set_time(self, secs):
        self.label.set_text(f"{secs // 60}:{secs % 60:02d}")


class Countdown(Popup):
    def __init__(self):
        super().__init__(radius=22)
        box = Gtk.Box()
        box.get_style_context().add_class("count")
        self.label = Gtk.Label()
        box.pack_start(self.label, True, True, 0)
        self.add(box)
        box.show_all()

    def show_n(self, n):
        self.label.set_text(str(n))
        g = monitor_at_pointer(Gdk.Display.get_default()).get_geometry()
        size = self.get_preferred_size()[1]
        self.move(g.x + (g.width - size.width) // 2, g.y + g.height - size.height - 120)
        self.show()


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def notify(text, icon="dialog-warning"):
    print(f"luxos-screenshot: {text}", file=sys.stderr)
    spawn("notify-send", "-a", _("Screenshot"), "-i", icon, _("Screenshot"), text)


def open_uri(uri):
    try:
        Gio.AppInfo.launch_default_for_uri(uri, None)
    except GLib.Error:
        spawn("xdg-open", uri)


def clipboard_png(pb):
    """Obrazek do schranky pres xclip: drzi ho samostatny proces xclip, takze zustane ve schrance
    i po skonceni tohoto programu (do dalsiho kopirovani). False = xclip neni / selhal."""
    import shutil
    if not pb or not shutil.which("xclip"):
        return False
    try:
        ok, data = pb.save_to_bufferv("png", [], [])
    except GLib.Error:
        return False
    if not ok:
        return False
    try:
        p = subprocess.Popen(["xclip", "-selection", "clipboard", "-t", "image/png", "-i"],
                             stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        p.communicate(bytes(data), timeout=10)      # xclip nacte data a odejde do pozadi
    except (OSError, subprocess.TimeoutExpired):
        return False
    return p.returncode == 0


def trash_file(path):
    """Smazat = do Kose; 'trash', nebo 'deleted', kdyz slozka Kos nepodporuje (napr. tmpfs).

    Bez Kose se maze napevno - jde o snimek, ktery tento program prave vytvoril."""
    f = Gio.File.new_for_path(path)
    try:
        f.trash(None)
        return "trash"
    except GLib.Error as e:
        if not e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_SUPPORTED):
            raise
    os.unlink(path)
    return "deleted"


def write_copy(pb, src, dest, video=False):
    """Ulozit jako: video/soubor zkopiruje, obrazek ulozi podle pripony (.jpg = JPEG, jinak PNG)."""
    import shutil
    if video or pb is None:
        if src and not (os.path.exists(dest) and os.path.samefile(src, dest)):
            shutil.copyfile(src, dest)
        return dest
    if os.path.splitext(dest)[1].lower() in (".jpg", ".jpeg"):
        if pb.get_has_alpha():
            pb = pb.composite_color_simple(pb.get_width(), pb.get_height(), GdkPixbuf.InterpType.NEAREST,
                                           255, 8, 0xffffff, 0xffffff)
        pb.savev(dest, "jpeg", ["quality"], ["92"])
    else:
        pb.savev(dest, "png", [], [])
    return dest


def _die_with_parent():
    """ffmpeg skonci (a dopise soubor), i kdyby luxos-screenshot nekdo zabil."""
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGINT)    # PR_SET_PDEATHSIG
    except (OSError, AttributeError):
        pass


class Recorder:
    def __init__(self, app, rect, folder):
        self.app, self.rect, self.folder = app, rect, folder
        self.proc = None
        self.started = 0
        self.stopping = False

    def start(self):
        try:
            enc_text = subprocess.run(["ffmpeg", "-hide_banner", "-encoders"], capture_output=True,
                                      text=True, timeout=10).stdout
        except (OSError, subprocess.TimeoutExpired):
            notify(_("Screen recording is not available: ffmpeg was not found."))
            return False
        enc = pick_encoder(enc_text)
        if not enc:
            notify(_("Screen recording is not available: ffmpeg was not found."))
            return False
        try:
            os.makedirs(self.folder, exist_ok=True)
        except OSError:
            pass
        self.final = unique_path(self.folder, file_name(datetime.datetime.now(), video=True))
        self.part = os.path.join(self.folder, "." + os.path.basename(self.final) + ".part")
        scale = root_window().get_scale_factor()
        rect = tuple(v * scale for v in self.rect)
        cmd = ffmpeg_cmd(os.environ.get("DISPLAY", ":0"), rect, self.part, enc)
        import tempfile
        self.err = tempfile.TemporaryFile()
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                         stderr=self.err, preexec_fn=_die_with_parent)
        except OSError:
            notify(_("Screen recording is not available: ffmpeg was not found."))
            return False
        self.started = GLib.get_monotonic_time()
        GLib.timeout_add(250, self.poll)
        return True

    def elapsed(self):
        return int((GLib.get_monotonic_time() - self.started) / 1e6)

    def stop(self):
        if self.proc and self.proc.poll() is None and not self.stopping:
            self.stopping = True
            self.proc.send_signal(signal.SIGINT)        # ffmpeg dopise mp4 a skonci
            GLib.timeout_add(15000, self.kill)

    def kill(self):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()
        return False

    def poll(self):
        if self.proc.poll() is None:
            self.app.rec_tick(self.elapsed())
            return True
        ok = os.path.exists(self.part) and os.path.getsize(self.part) > 0
        if ok:
            try:
                os.replace(self.part, self.final)
            except OSError:
                ok = False
        if not ok:
            try:
                self.err.seek(0)
                msg = self.err.read().decode(errors="replace").strip().splitlines()[-1:]
            except (OSError, IndexError):
                msg = []
            notify(_("The screen recording failed.") + (" " + msg[0] if msg else ""))
            try:
                os.unlink(self.part)
            except OSError:
                pass
        self.app.rec_done(self.final if ok else None)
        return False


def video_frame(path):
    """Prvni snimek videa jako pixbuf (pro nahled) nebo None."""
    try:
        data = subprocess.run(["ffmpeg", "-v", "error", "-i", path, "-frames:v", "1", "-vf", "scale=440:-2",
                               "-f", "image2pipe", "-c:v", "png", "-"], capture_output=True, timeout=10).stdout
        if not data:
            return None
        loader = GdkPixbuf.PixbufLoader.new_with_type("png")
        loader.write(data)
        loader.close()
        return loader.get_pixbuf()
    except (OSError, subprocess.TimeoutExpired, GLib.Error):
        return None


# ---- rizeni -----------------------------------------------------------------------------
class App:
    def __init__(self, args):
        self.args = args
        self.opts = load_options()
        self.toolbar = self.overlay = self.thumb = self.pill = self.countdown = None
        self.frozen = None          # (pixbuf, kurzor) zmrazeneho snimku
        self.surface = None
        self.rec = None
        self.mode = self.opts["mode"]
        self.holding_clip = False
        self.to_clip = False        # Ctrl pri zachyceni: do schranky misto souboru
        self.clip_owner = None      # okno GTK, ktere drzi schranku (jen bez xclipu)
        self.busy = False
        self.scale = root_window().get_scale_factor()

    # -- zivotni cyklus
    def quit(self, *_a):
        drop_state()
        Gtk.main_quit()

    def cancel(self):
        if self.rec:
            self.rec.stop()
            return
        for w in (self.overlay, self.toolbar, self.countdown):
            if w:
                w.destroy()
        self.overlay = self.toolbar = self.countdown = None
        ungrab()
        self.quit()

    def on_signal(self, sig):
        """SIGUSR1: zastavit nahravani / zavrit listu; SIGUSR2: nova instance - skryt nahled."""
        if sig == signal.SIGUSR2:
            if self.thumb:
                self.thumb.finish()
        elif self.rec:
            self.rec.stop()
        elif sig == signal.SIGTERM or not self.holding_clip:
            self.cancel()
        return True

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.cancel()
            return True
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and self.toolbar:
            self.capture(ctrl=bool(ev.state & Gdk.ModifierType.CONTROL_MASK))
            return True
        if ev.keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R) and self.toolbar:
            self.toolbar.set_ctrl(True)
        return False

    def on_key_release(self, _w, ev):
        if ev.keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R) and self.toolbar:
            self.toolbar.set_ctrl(False)
        return False

    # -- start podle prepinacu
    def run(self):
        a = self.args
        if a["action"] == "toolbar":
            set_state("toolbar")
            self.toolbar = Toolbar(self)
            self.toolbar.get_child().show_all()
            self.set_mode(self.mode if self.mode in MODES else "portion", initial=True)
        elif a["action"] in ("screen", "rec_screen") or a.get("region"):
            set_state("toolbar")
            rect = a.get("region") or self.screen_rect()
            if a["action"].startswith("rec_"):
                GLib.idle_add(self.start_recording, rect)
            else:
                GLib.idle_add(self.capture_rect, rect, True)
        else:           # --portion, --window, --record-portion: vyber mysi bez listy
            set_state("toolbar")
            self.mode = a["action"]
            self.freeze()
            self.show_overlay(a["action"], quick=True)

    def screen_rect(self):
        root = root_window()
        return (0, 0, root.get_width(), root.get_height())

    # -- lista a prekryv
    def set_mode(self, mode, initial=False):
        self.mode = mode
        if self.opts["mode"] != mode:
            self.opts["mode"] = mode
            save_options(self.opts)
        self.toolbar.set_mode(mode)
        if mode in ("screen", "rec_screen"):
            if self.overlay:
                self.overlay.destroy()
                self.overlay = None
            self.show_toolbar()
        elif self.overlay:
            self.overlay.set_mode(mode)
            self.show_toolbar()
        else:
            # S listou zivy prekryv bez zmrazeni: snimek se porizuje az pri Zachytit
            self.show_overlay(mode)

    def show_toolbar(self):
        tb = self.toolbar
        tb.place()
        tb.show()
        tb.get_window().raise_()
        tb.show_caption()
        # Klavesnici nezabirat: pri otevrene liste funguji zkratky a psani v aplikacich
        # (Esc/Enter jen u rychleho vyberu bez listy, jinak tlacitka listy)

    def freeze(self):
        pb = grab()
        cur = cursor_image() if self.opts["pointer"] else None
        self.frozen = (pb, cur)
        self.surface = Gdk.cairo_surface_create_from_pixbuf(pb, self.scale, None) if pb else None

    def show_overlay(self, mode, quick=False):
        live = not quick and self.toolbar is not None and Gdk.Screen.get_default().get_rgba_visual() is not None
        if not live and not self.surface:
            self.freeze()
        if not live and not self.surface:
            notify(_("The screenshot could not be taken."))
            self.cancel()
            return
        sel = None
        if not quick and self.opts["remember"] and self.opts["selection"]:
            root = root_window()
            sel = clamp_rect(self.opts["selection"], root.get_width(), root.get_height())
        self.overlay = Overlay(self, None if live else self.surface, mode, sel, quick=quick)
        self.overlay.show()
        if self.toolbar:
            self.show_toolbar()
        else:
            grab_keyboard(self.overlay)

    # -- volby
    def options_menu(self, button):
        menu = Gtk.Menu()
        o = self.opts

        def header(text):
            it = Gtk.MenuItem(label=text, sensitive=False)
            menu.append(it)

        def radio(group, label, active, cb):
            it = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
            it.set_active(active)
            it.connect("toggled", lambda w: w.get_active() and cb())
            menu.append(it)
            return it

        header(_("Save to"))
        g = None
        for key, label in (("screenshots", _("Screenshots")), ("desktop", _("Desktop")), ("pictures", _("Pictures")),
                           ("clipboard", _("Clipboard"))):
            g = radio(g, label, o["save_to"] == key, lambda k=key: self.set_opt("save_to", k))
        # Napoveda pod Schrankou: kopie jednoho snimku bez zmeny volby
        hint = Gtk.MenuItem(sensitive=False)
        lab = Gtk.Label(xalign=0)
        lab.set_markup("<small>%s</small>" % GLib.markup_escape_text(_("Hold Ctrl to copy to the clipboard")))
        hint.add(lab)
        menu.append(hint)
        if o["other_dir"]:
            g = radio(g, os.path.basename(o["other_dir"].rstrip("/")) or o["other_dir"], o["save_to"] == "other",
                      lambda: self.set_opt("save_to", "other"))
        other = Gtk.MenuItem(label=_("Other…"))
        other.connect("activate", lambda _i: GLib.idle_add(self.choose_folder))
        menu.append(other)
        menu.append(Gtk.SeparatorMenuItem())
        header(_("Timer"))
        g = None
        for secs, label in ((0, _("None")), (5, _("5 Seconds")), (10, _("10 Seconds"))):
            g = radio(g, label, o["timer"] == secs, lambda s=secs: self.set_opt("timer", s))
        menu.append(Gtk.SeparatorMenuItem())
        header(_("Options"))
        for key, label in (("pointer", _("Show Mouse Pointer")), ("remember", _("Remember Last Selection"))):
            it = Gtk.CheckMenuItem(label=label, active=o[key])
            it.connect("toggled", lambda w, k=key: self.set_opt(k, w.get_active()))
            menu.append(it)
        menu.show_all()
        menu.attach_to_widget(button, None)
        # Po zavreni nabidky GTK uvolni vsechna zachyceni: klavesnici vzit zpet
        menu.connect("deactivate", lambda _m: GLib.idle_add(
            lambda: self.overlay and self.overlay.quick and grab_keyboard(self.overlay)))
        self.menu = menu
        menu.popup_at_widget(button, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.SOUTH_WEST, None)

    def set_opt(self, key, value):
        self.opts[key] = value
        save_options(self.opts)
        if self.toolbar:
            self.toolbar.update_caption()
        if key == "pointer" and value and self.frozen and self.frozen[1] is None:
            self.frozen = (self.frozen[0], cursor_image())

    def choose_folder(self):
        # Dialog spravuje WM - lista a prekryv (mimo WM) by ho zakryly
        for w in (self.overlay, self.toolbar):
            if w:
                w.hide()
        ungrab()
        dlg = Gtk.FileChooserDialog(title=_("Choose a Folder"), action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("Choose"), Gtk.ResponseType.OK)
        dlg.set_keep_above(True)
        if self.opts["other_dir"]:
            dlg.set_current_folder(self.opts["other_dir"])
        if dlg.run() == Gtk.ResponseType.OK and dlg.get_filename():
            self.opts["other_dir"] = dlg.get_filename()
            self.set_opt("save_to", "other")
        dlg.destroy()
        if self.overlay:
            self.overlay.show()
        self.show_toolbar()
        return False

    # -- zachyceni
    def capture(self, ctrl=None):
        """Tlacitko Zachytit / Nahrat nebo Enter; s Ctrl jde snimek do schranky."""
        if self.busy:
            return
        mode = self.mode
        self.to_clip = ctrl_held() if ctrl is None else bool(ctrl)
        if mode in ("portion", "rec_portion"):
            sel = self.overlay.norm() if self.overlay else None
            if not sel or sel[2] < 3 or sel[3] < 3:
                return
            self.remember(sel)
            if mode == "portion":
                self.capture_rect(sel)
            else:
                self.start_recording(sel)
        elif mode == "screen":
            self.capture_rect(self.screen_rect(), live=True)
        elif mode == "rec_screen":
            self.start_recording(self.screen_rect())

    def remember(self, sel):
        if self.opts["remember"]:
            self.opts["selection"] = [int(v) for v in sel]
            save_options(self.opts)

    def hide_ui(self):
        """Skryje listu a prekryv; vrati prodlevu (ms) pred snimkem."""
        shown = False
        for w in (self.toolbar, self.overlay):
            if w and w.get_visible():
                shown = True
                w.hide()
        ungrab()
        return HIDE_DELAY if shown else 0

    def after_timer(self, delay, cb):
        """Skryti UI, pripadne odpocet podle volby Casovac, pak cb()."""
        secs = self.opts["timer"] if self.toolbar else 0
        if not secs:
            if delay:
                GLib.timeout_add(delay, lambda: cb() and False)
            else:
                cb()
            return
        self.countdown = Countdown()
        left = [secs]

        def tick():
            if left[0] <= 0:
                self.countdown.destroy()
                self.countdown = None
                GLib.timeout_add(HIDE_DELAY, lambda: cb() and False)
                return False
            self.countdown.show_n(left[0])
            left[0] -= 1
            return True
        GLib.timeout_add(max(delay, 1), lambda: tick() and GLib.timeout_add(1000, tick) and False)

    def selected(self, rect, window=False, ctrl=False):
        """Vyber v prekryvu hotov: vyrez pustenim mysi (bez listy) nebo klik na okno."""
        if self.busy:
            return
        self.to_clip = bool(ctrl)
        if self.mode == "rec_portion":
            self.start_recording(rect)
        else:
            self.capture_rect(rect)

    def capture_rect(self, rect, live=False):
        self.busy = True
        delay = self.hide_ui()
        use_frozen = self.frozen and not live and not (self.toolbar and self.opts["timer"])

        def shoot():
            if use_frozen:
                pb, cur = self.frozen
                s = self.scale
                r = clamp_rect([v * s for v in rect], pb.get_width(), pb.get_height())
                out = pb.new_subpixbuf(*r).copy() if r else None
                out = add_cursor(out, rect[:2], cur, s) if self.opts["pointer"] else out
            else:
                out = grab(rect)
                if out and self.opts["pointer"]:
                    out = add_cursor(out, rect[:2], cursor_image(), self.scale)
            self.deliver(out)
            return False
        self.after_timer(delay if not use_frozen else 0, shoot)
        return False

    def deliver(self, pb):
        for w in (self.overlay, self.toolbar):
            if w:
                w.destroy()
        self.overlay = self.toolbar = None
        self.frozen = self.surface = None
        if not pb:
            notify(_("The screenshot could not be taken."))
            self.quit()
            return
        out = self.args.get("output")
        if self.args.get("clipboard"):
            folder = out                    # --clipboard --output: soubor do slozky (jako drive)
        else:
            folder = save_dir(self.opts, override=out)
        if self.to_clip or folder is None:
            if not self.copy_image(pb):
                notify(_("The screenshot could not be copied to the clipboard."))
            self.show_thumb(None, pb, copied=True)
            return
        try:
            os.makedirs(folder, exist_ok=True)
            path = unique_path(folder, file_name(datetime.datetime.now()))
            pb.savev(path, "png", [], [])
        except (OSError, GLib.Error) as e:
            notify(_("The screenshot could not be saved.") + f" {e}")
            self.quit()
            return
        print(path)
        self.show_thumb(path, pb)

    def show_thumb(self, path, pb, copied=False, video=False):
        if self.args.get("no_thumb") or not pb:
            self.done()
            return
        set_state("idle")
        self.thumb = Thumbnail(self, path, pb, copied=copied, video=video)
        self.thumb.show_all()

    def done(self):
        """Nahled zavreny: konec, jen obrazek ve schrance drzeny primo timto procesem pocka."""
        self.thumb = None
        if self.holding_clip and self.own_clipboard():
            set_state("idle")
            return
        self.quit()

    # -- akce nahledu
    def copy_image(self, pb):
        if clipboard_png(pb):
            return True
        if not pb:
            return False
        # Bez xclipu drzi obrazek tento proces (a ceka, dokud schranku neprevezme nekdo jiny)
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_image(pb)
        clip.store()          # spravce schranky (pokud bezi) si obrazek prevezme
        self.clip_owner = Gdk.selection_owner_get(Gdk.SELECTION_CLIPBOARD)
        if not self.holding_clip:
            self.holding_clip = True
            GLib.timeout_add(1500, lambda: clip.connect("owner-change", self.clip_lost) and False)
        return True

    def own_clipboard(self):
        owner = Gdk.selection_owner_get(Gdk.SELECTION_CLIPBOARD)
        return owner is not None and owner == self.clip_owner

    def clip_lost(self, *_a):
        if not self.thumb and not self.own_clipboard():
            self.quit()

    def reveal(self, path, cb):
        """Zobrazit v Souborech: spravce souboru oznaci soubor (FileManager1), jinak otevre slozku."""
        def fallback():
            open_uri(GLib.filename_to_uri(os.path.dirname(path)))

        def reply(conn, res):
            try:
                conn.call_finish(res)
            except GLib.Error:
                fallback()
            cb()
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bus.call("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                     "org.freedesktop.FileManager1", "ShowItems",
                     GLib.Variant("(ass)", ([GLib.filename_to_uri(path)], "")),
                     None, Gio.DBusCallFlags.NONE, 8000, None, reply)
        except GLib.Error:
            fallback()
            cb()

    def ask_save_path(self, src, video=False):
        """Dialog Ulozit jako; vrati cestu nebo None."""
        dlg = Gtk.FileChooserDialog(title=_("Save Recording") if video else _("Save Screenshot"),
                                    action=Gtk.FileChooserAction.SAVE)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("Save"), Gtk.ResponseType.ACCEPT)
        dlg.set_default_response(Gtk.ResponseType.ACCEPT)
        dlg.set_do_overwrite_confirmation(True)
        dlg.set_keep_above(True)
        folder = os.path.dirname(src) if src else user_dir("pictures")
        if os.path.isdir(folder):
            dlg.set_current_folder(folder)
        dlg.set_current_name(os.path.basename(src) if src else file_name(datetime.datetime.now()))
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.ACCEPT else None
        dlg.destroy()
        if path and not video and not os.path.splitext(path)[1]:
            path = unique_path(os.path.dirname(path), os.path.basename(path) + ".png")
        return path

    def save_as(self, pb, src, video=False):
        dest = self.ask_save_path(src, video)
        if not dest:
            return None
        try:
            return write_copy(pb, src, dest, video)
        except (OSError, GLib.Error) as e:
            notify(_("The screenshot could not be saved.") + f" {e}")
            return None

    def trash(self, path):
        try:
            trash_file(path)
            return True
        except (OSError, GLib.Error) as e:
            notify(_("The file could not be moved to the Trash.") + " " + (getattr(e, "message", None) or str(e)))
            return False

    # -- nahravani
    def start_recording(self, rect):
        self.busy = True
        folder = save_dir(self.opts, video=True, override=self.args.get("output"))
        self.rec = Recorder(self, rect, folder)
        delay = self.hide_ui()

        def go():
            for w in (self.overlay, self.toolbar):
                if w:
                    w.destroy()
            self.overlay = self.toolbar = None
            self.frozen = self.surface = None
            if not self.rec.start():
                self.rec = None
                self.quit()
                return
            set_state("recording")
            full = rect == self.screen_rect()
            self.pill = Pill(self.rec.stop, None if full else rect)
            self.pill.show()
        self.after_timer(delay, go)
        return False

    def rec_tick(self, secs):
        if self.pill:
            self.pill.set_time(secs)

    def rec_done(self, path):
        if self.pill:
            self.pill.destroy()
            self.pill = None
        self.rec = None
        if not path:
            self.quit()
            return
        print(path)
        self.show_thumb(path, None if self.args.get("no_thumb") else video_frame(path), video=True)


def unix_signal(sig, cb):
    """Signal zpracovany v hlavni smycce GLib (GLibUnix v novem PyGObject, jinak GLib)."""
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, sig, cb, sig)
    except (ValueError, ImportError, AttributeError):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, cb, sig)


def parse_args(argv):
    a = {"action": "toolbar"}
    it = iter(argv)
    flags = {"--screen": "screen", "--portion": "portion", "--selection": "portion", "--window": "window",
             "--record-screen": "rec_screen", "--record-portion": "rec_portion", "--toolbar": "toolbar"}
    for arg in it:
        if arg in flags:
            a["action"] = flags[arg]
        elif arg == "--stop":
            a["stop"] = True
        elif arg == "--clipboard":
            a["clipboard"] = True
        elif arg == "--no-thumbnail":
            a["no_thumb"] = True
        elif arg == "--output":
            a["output"] = os.path.abspath(os.path.expanduser(next(it, ".")))
        elif arg == "--region":
            a["region"] = parse_region(next(it, ""))
            if not a["region"]:
                raise SystemExit("luxos-screenshot: --region X,Y,W,H")
        elif arg in ("-h", "--help"):
            print(__doc__)
            raise SystemExit(0)
        else:
            raise SystemExit(f"luxos-screenshot: unknown option {arg}")
    return a


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    pid, state = other_instance()
    if args.get("stop"):
        if pid and state == "recording":
            os.kill(pid, signal.SIGUSR1)
        return 0
    if pid:
        if state == "recording":            # dalsi spusteni nahravani zastavi (jako v macOS)
            os.kill(pid, signal.SIGUSR1)
            return 0
        if state == "toolbar":
            os.kill(pid, signal.SIGTERM)
            if args["action"] == "toolbar":  # znovu stejna zkratka listu zavre
                return 0
        else:                               # nahled predchoziho snimku nesmi byt v novem
            os.kill(pid, signal.SIGUSR2)
        GLib.usleep(120000)
    GLib.set_prgname("luxos-screenshot")
    Gdk.set_program_class("luxos-screenshot")
    install_css()
    app = App(args)
    for sig in (signal.SIGUSR1, signal.SIGUSR2, signal.SIGTERM, signal.SIGINT):
        unix_signal(sig, app.on_signal)
    app.run()
    try:
        Gtk.main()
    finally:
        drop_state()
    return 0


if __name__ == "__main__":
    sys.exit(main())
