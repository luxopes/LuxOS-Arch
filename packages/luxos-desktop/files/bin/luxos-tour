    cr.fill()
    rrect(cr, px + 24, py + 48, 132, 10, 5)
    fill(cr, hexc("#3a3c47"))
    cr.arc(px + 156, py + 22, 5, 0, 2 * math.pi)
    fill(cr, hexc("#28c840"))
