# ---- zvyrazneni skutecne horni listy / Docku na obrazovce --------------------------------
def screen_rects():
    """Skutecna poloha horni listy a Docku {"bar": (x, y, w, h), "dock": ...} v logickych px."""
    rects = {}
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    if not mon:
        return rects
    g, wa, scale = mon.get_geometry(), mon.get_workarea(), mon.get_scale_factor() or 1
    try:
        gi.require_version("Wnck", "3.0")
        from gi.repository import Wnck
        scr = Wnck.Screen.get_default()
        scr.force_update()
        for w in scr.get_windows():
            cls = (w.get_class_group_name() or "").lower() + " " + (w.get_class_instance_name() or "").lower()
            x, y, ww, hh = (v / scale for v in w.get_geometry())
            if "plank" in cls and hh >= 24 and ww >= 48 and y + hh > g.y + g.height * 0.6:
                rects["dock"] = (x, y, ww, hh)
            elif "xfce4-panel" in cls and ww >= g.width * 0.8 and abs(y - g.y) < 4 and 14 <= hh <= 80:
                rects["bar"] = (x, y, ww, hh)
    except (ValueError, ImportError, AttributeError):
        pass
    if "bar" not in rects and 14 <= wa.y - g.y <= 80:   # horni lista si rezervuje okraj obrazovky
        rects["bar"] = (g.x, g.y, g.width, wa.y - g.y)
    return rects


class Spotlight(Gtk.Window):
    """Pruhledny prekryv pres monitor, ktery kliky propousti; dvakrat pulzuje kolem oblasti."""

    def __init__(self, rect, text):
        super().__init__(type=Gtk.WindowType.POPUP)
        display = Gdk.Display.get_default()
        mon = display.get_monitor_at_point(int(rect[0] + rect[2] / 2), int(rect[1] + rect[3] / 2))
        self.g = mon.get_geometry()
        self.rect, self.label, self.t = rect, text, 0
        self.set_visual(self.get_screen().get_rgba_visual())
        self.set_app_paintable(True)
        self.set_keep_above(True)
        self.move(self.g.x, self.g.y)
        self.set_default_size(self.g.width, self.g.height)
        self.connect("draw", self.on_draw)
        self.connect("realize", lambda w: w.get_window().input_shape_combine_region(cairo.Region(), 0, 0))
        GLib.timeout_add(30, self.tick)

    def tick(self):
        self.t += 0.03
        if self.t >= 2.8:
            self.destroy()
            return False
        self.queue_draw()
        return True

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        fade = min(1.0, self.t / 0.25, (2.8 - self.t) / 0.4)
        pulse = 0.5 + 0.5 * math.sin(self.t * 2 * math.pi / 1.2)
        x, y, w, h = self.rect
        x, y = x - self.g.x, y - self.g.y
        m = 3 + 5 * pulse
        # ztlumit zbytek obrazovky
        cr.rectangle(0, 0, self.g.width, self.g.height)
        rrect(cr, x - m, y - m, w + 2 * m, h + 2 * m, 12)
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        cr.set_source_rgba(0, 0, 0, 0.28 * fade)
        cr.fill()
        for lw, a in ((14, 0.12), (8, 0.22), (3, 1.0)):
            rrect(cr, x - m, y - m, w + 2 * m, h + 2 * m, 12)
            cr.set_source_rgba(*ACCENT, a * fade)
            cr.set_line_width(lw)
            cr.stroke()
        # popisek pod/nad oblasti
        lay = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription.from_string("Sans Bold")
        fd.set_absolute_size(14 * Pango.SCALE)
        lay.set_font_description(fd)
        lay.set_text(self.label, -1)
        tw, th = lay.get_pixel_size()
        lx = min(max(x + w / 2 - tw / 2 - 14, 12), self.g.width - tw - 40)
        ly = y + h + m + 14 if y < self.g.height / 2 else y - m - th - 26
        rrect(cr, lx, ly, tw + 28, th + 12, (th + 12) / 2)
        cr.set_source_rgba(*ACCENT, 0.95 * fade)
        cr.fill()
        cr.move_to(lx + 14, ly + 6)
        cr.set_source_rgba(1, 1, 1, fade)
        PangoCairo.show_layout(cr, lay)


# ---- okno pruvodce ------------------------------------------------------------------------
def launch(*cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def have(cmd):
    return GLib.find_program_in_path(cmd) is not None


def appearance_mode():
    try:
        r = subprocess.run(["luxos-appearance", "mode"], capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


def pages():
    """(titulek, text, kresleni, akce); akce = (popisek, prikaz | "spot:bar|dock" | "mode")."""
    return [
        (_("Welcome to LuxOS"),
