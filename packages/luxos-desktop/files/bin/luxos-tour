# ---- ilustrace jednotlivych stranek (virtualni plocha 640 x 300) -------------------------
def draw_welcome(p):
    cr = p.cr
    p.wallpaper(0, 0, VW, VH, 18)
    cx, cy, s = VW / 2, VH / 2 - 6, 150
    # mekka zare za logem
    g = cairo.RadialGradient(cx, cy + 10, 10, cx, cy + 10, 170)
    g.add_color_stop_rgba(0, 1, 1, 1, 0.55 if not p.dark else 0.22)
    g.add_color_stop_rgba(1, 1, 1, 1, 0)
    cr.set_source(g)
    cr.paint()
    for k, a in ((1.0, 0.18), (1.35, 0.10), (1.75, 0.06)):
        cr.arc(cx, cy + 12, s * 0.55 * k, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, a)
        cr.set_line_width(1.2)
        cr.stroke()
    logo(cr, cx - s / 2, cy - s / 2 - 4, s, color=(1, 1, 1, 0.95) if p.dark else None)
    p.text("LuxOS", cx, VH - 34, 22, (1, 1, 1, 0.95) if p.dark else hexc("#1d1d1f", 0.85), bold=True, align="c")


def draw_menubar(p):
    cr = p.cr
    p.wallpaper(0, 0, VW, VH, 18)
    by, bh = 40, 34
    pos = p.topbar(14, by, VW - 28, bh, _("Files"), [_("File"), _("Edit"), _("View"), _("Go")], big=True)
    # Ovladaci centrum rozbalene pod ikonou
    ccx, bellx = pos["cc"][0], pos["bell"][0]
    pw, ph = 224, 196
    px, py = min(VW - 14 - pw, ccx - 40), by + bh + 10
    shadow(cr, px, py, pw, ph, 16, p.dark)
    rrect(cr, px, py, pw, ph, 16)
    fill(cr, hexc("#22242e", 0.94) if p.dark else hexc("#f7f7fa", 0.95))
    tiles = (_("Wi-Fi"), _("Bluetooth"), _("Do Not Disturb"), _("Dark Mode"))
    for i, name in enumerate(tiles):
        on = i < 2 or (i == 3 and p.dark)
        tx = px + 10 + (i % 2) * 104
        ty = py + 10 + (i // 2) * 50
        rrect(cr, tx, ty, 98, 42, 12)
        fill(cr, hexc("#ffffff", 0.07) if p.dark else hexc("#000000", 0.05))
        cr.arc(tx + 19, ty + 21, 12.5, 0, 2 * math.pi)
        fill(cr, rgba(ACCENT) if on else (hexc("#ffffff", 0.15) if p.dark else hexc("#000000", 0.12)))
        ic = (1, 1, 1, 1) if on else p.fg
        if i == 0:
            p.g_wifi(tx + 19, ty + 21, 14, ic)
        elif i == 1:
            p.text("ᛒ", tx + 19, ty + 21, 13, ic, bold=True, align="c")
        elif i == 2:
            cr.save()
            cr.arc(tx + 19, ty + 21, 6.5, 0, 2 * math.pi)
            cr.arc_negative(tx + 22.5, ty + 18, 5.5, 2 * math.pi, 0)
            cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
            fill(cr, ic)
            cr.restore()
        else:
            cr.arc(tx + 19, ty + 21, 6.5, -math.pi / 2, math.pi / 2)
            fill(cr, ic)
            cr.arc(tx + 19, ty + 21, 6.5, 0, 2 * math.pi)
            cr.set_source_rgba(*ic)
            cr.set_line_width(1.5)
            cr.stroke()
        p.text(name, tx + 36, ty + 21, 9, bold=True, maxw=58, lines=2)
    for j, (name, val) in enumerate(((_("Display"), 0.7), (_("Sound"), 0.45))):
        sy = py + 118 + j * 32
        p.text(name, px + 12, sy, 9, p.dim, bold=True)
        rrect(cr, px + 12, sy + 8, pw - 24, 11, 5.5)
        fill(cr, hexc("#ffffff", 0.12) if p.dark else hexc("#000000", 0.08))
        rrect(cr, px + 12, sy + 8, (pw - 24) * val, 11, 5.5)
        fill(cr, hexc("#ffffff", 0.92) if p.dark else rgba(ACCENT, 0.9))
    yb = py + ph - 14
    p.g_battery(px + 22, yb, 16, p.fg)
    p.text(_("82 % · 3:12 h left"), px + 38, yb, 9.5, p.dim, bold=True)
    p.ring(ccx - 13, by + 3, 26, bh - 6, 7)
    # vysvetlivky nad listou (Ovladaci centrum, upozorneni)
    p.pill(_("Control Center"), ccx + 10, 19, align="r")
    p.pill(_("Notifications"), bellx - 10, 19, align="l")
    # vysvetlivky vlevo pod listou
    for key, label, ly in (("logo", _("System menu"), 128), ("menus", _("App menus"), 182),
                           ("wifi", _("Wi-Fi, sound, battery"), 236)):
        x0, y0 = pos[key]
        lx = min(max(x0, 80), px - 96)
        p.leader(x0, y0 - 2, lx, ly - 10)
        p.pill(label, lx, ly)


def draw_dock(p):
    cr = p.cr
    p.wallpaper(0, 0, VW, VH, 18)
    rrect(cr, 0, 0, VW, 18, 0)
    p.topbar(0, 0, VW, 18, "LuxOS", [])
    top = p.window(150, 40, 340, 150, _("Files"))
    rrect(cr, 151, top, 90, 150 - (top - 40) - 1, 0)
    fill(cr, p.win2)
    for k in range(4):
        rrect(cr, 162, top + 14 + k * 20, 58 - k * 6, 7, 3.5)
        fill(cr, p.dim[:3] + (0.3,))
        p.icon(["folder"], 262 + k * 54, top + 22, 36, (0.35, 0.6, 1.0), "")
    x, y, w, h = p.dock(VW / 2, VH - 86, 48, DOCK_ITEMS, running=(3, 4))
    p.ring(x - 4, y - 4, w + 8, h + 8, 20)
    # bublina s nazvem nad ikonou Soubory
    fx = x + 48 * 0.25 + 3 * (48 + 48 * 0.22) + 24
    x0, bw = p.pill(_("Files"), fx, y - 22, 10.5, color=(0.15, 0.16, 0.2) if not p.dark else (0.35, 0.37, 0.45))
    cr.move_to(fx - 5, y - 13)
    cr.line_to(fx + 5, y - 13)
    cr.line_to(fx, y - 8)
    cr.close_path()
    fill(cr, (0.15, 0.16, 0.2, 0.95) if not p.dark else (0.35, 0.37, 0.45, 0.95))
    p.text(_("● = app is running"), x + w - 6, y + h + 14, 10, p.fg, bold=True, align="r")


