class TourWindow(Gtk.ApplicationWindow):
    def __init__(self, app, start=0):
        super().__init__(application=app, title=_("LuxOS Tour"))
        self.set_default_size(780, -1)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("luxos-tour")
        hb = Gtk.HeaderBar(show_close_button=True, title=_("LuxOS Tour"))
        self.set_titlebar(hb)
        self.pages = pages()
        self.mode = appearance_mode()
        self.mode_buttons = {}
        self.areas = []
        self.index = 0
        # bez kompozitoru by prekryv nebyl pruhledny; bez zjistene polohy neni co ukazat
        self.spots = screen_rects() if self.get_screen().is_composited() else {}
        self.spot_win = None

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        self.stack = Gtk.Stack(transition_duration=260, vexpand=True)
        root.pack_start(self.stack, True, True, 0)
        for i, page in enumerate(self.pages):
            self.stack.add_named(self.build_page(i, *page), str(i))

        root.pack_start(Gtk.Separator(), False, False, 0)
        bar = Gtk.Box(spacing=8, margin=14, margin_start=18, margin_end=18)
        self.skip = Gtk.Button(label=_("Skip Tour"), relief=Gtk.ReliefStyle.NONE)
        self.skip.connect("clicked", lambda _b: self.close())
        bar.pack_start(self.skip, False, False, 0)
        dots = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.dots = []
        for i in range(len(self.pages)):
            d = Gtk.Button(valign=Gtk.Align.CENTER, tooltip_text=self.pages[i][0])
            d.get_style_context().add_class("dot")
            d.connect("clicked", lambda _b, k=i: self.go(k))
            dots.pack_start(d, False, False, 0)
            self.dots.append(d)
        bar.set_center_widget(dots)
        self.next_btn = Gtk.Button(label=_("Continue"), can_default=True)
        self.next_btn.get_style_context().add_class("primary")
        self.next_btn.connect("clicked", lambda _b: self.step(1))
        self.back_btn = Gtk.Button(label=_("Back"))
        self.back_btn.get_style_context().add_class("pill")
        self.back_btn.connect("clicked", lambda _b: self.step(-1))
        bar.pack_end(self.next_btn, False, False, 0)
        bar.pack_end(self.back_btn, False, False, 0)
        root.pack_start(bar, False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("style-updated", lambda *_a: [a.queue_draw() for a in self.areas])
        self.show_all()
        self.next_btn.grab_default()
        self.go(max(0, min(start, len(self.pages) - 1)), animate=False)

    def build_page(self, i, title, body, draw, actions):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=24, margin_bottom=10)
        area = Gtk.DrawingArea(height_request=VH + 36, vexpand=True)
        area.connect("draw", self.on_draw, draw)
        self.areas.append(area)
        box.pack_start(area, True, True, 0)
        t = Gtk.Label(label=title, wrap=True, justify=Gtk.Justification.CENTER, margin_top=8)
        t.get_style_context().add_class("tour-title")
        box.pack_start(t, False, False, 0)
        b = Gtk.Label(label=body, wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=72)
        b.get_style_context().add_class("tour-body")
        box.pack_start(b, False, False, 0)
        row = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_top=4)
        for label, cmd in actions:
            if cmd == "mode":
                group = Gtk.Box(spacing=6)
                first = None
                for key, name in (("light", _("Light")), ("dark", _("Dark")), ("auto", _("Auto"))):
                    rb = Gtk.RadioButton(group=first, label=name, draw_indicator=False)
                    first = first or rb
                    rb.get_style_context().add_class("pill")
                    rb.set_active(key == self.mode)
                    rb.connect("toggled", self.set_mode, key)
                    self.mode_buttons[key] = rb
                    group.pack_start(rb, False, False, 0)
                if have("luxos-appearance"):
                    row.pack_start(group, False, False, 0)
                continue
            if isinstance(cmd, str) and cmd.startswith("spot:"):
                if cmd[5:] not in self.spots:
                    continue
                btn = Gtk.Button(label=label)
                btn.connect("clicked", self.spotlight, cmd[5:], title)
            else:
                if not have(cmd[0]):
                    continue
                btn = Gtk.Button(label=label)
                btn.connect("clicked", lambda _b, c=cmd: launch(*c))
            btn.get_style_context().add_class("pill")
            row.pack_start(btn, False, False, 0)
        box.pack_start(row, False, False, 0)
        return box

    def is_dark(self):
        c = self.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        return (0.2126 * c.red + 0.7152 * c.green + 0.0722 * c.blue) > 0.5

    def on_draw(self, area, cr, draw):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        s = min(w / VW, h / VH)
        cr.translate((w - VW * s) / 2, 0)
        cr.scale(s, s)
        rrect(cr, 0, 0, VW, VH, 18)
        cr.clip()
        p = Painter(cr, area, self.is_dark())
        if draw is draw_appearance:
            draw(p, self.mode)
        else:
            draw(p)
        return False

    def set_mode(self, rb, key):
        if not rb.get_active() or key == self.mode:
            return
        self.mode = key
        launch("luxos-appearance", key)
        for a in self.areas:
            a.queue_draw()

    def spotlight(self, _b, which, title):
        rect = screen_rects().get(which) or self.spots.get(which)
        if self.spot_win:
            self.spot_win.destroy()
        self.spot_win = Spotlight(rect, title)
        self.spot_win.connect("destroy", lambda w: setattr(self, "spot_win", None) if self.spot_win is w else None)
        self.spot_win.show_all()

    def go(self, i, animate=True):
        if not 0 <= i < len(self.pages):
            return
        direction = Gtk.StackTransitionType.SLIDE_LEFT if i > self.index else Gtk.StackTransitionType.SLIDE_RIGHT
        self.stack.set_visible_child_full(str(i), direction if animate else Gtk.StackTransitionType.NONE)
        self.index = i
        last = i == len(self.pages) - 1
        self.back_btn.set_visible(i > 0)
        self.skip.set_visible(not last)
        self.next_btn.set_label(_("Get Started") if last else _("Continue"))
        for k, d in enumerate(self.dots):
            ctx = d.get_style_context()
            (ctx.add_class if k == i else ctx.remove_class)("active")
        self.next_btn.grab_focus()

    def step(self, d):
        if d > 0 and self.index == len(self.pages) - 1:
            self.close()
        else:
            self.go(self.index + d)

    def on_key(self, _w, ev):
        k = ev.keyval
        # sipky v prepinaci Svetly/Tmavy/Auto patri prepinaci, ne strankovani
        if isinstance(self.get_focus(), Gtk.RadioButton) and k in (Gdk.KEY_Left, Gdk.KEY_Right):
            return False
        if k in (Gdk.KEY_Right, Gdk.KEY_Page_Down):
            self.step(1)
        elif k in (Gdk.KEY_Left, Gdk.KEY_Page_Up):
            self.step(-1)
        elif k == Gdk.KEY_Home:
            self.go(0)
        elif k == Gdk.KEY_End:
            self.go(len(self.pages) - 1)
        elif k == Gdk.KEY_Escape:
            self.close()
        else:
            return False
        return True


def mark_done():
    try:
        os.makedirs(CFG, exist_ok=True)
        with open(MARKER, "w"):
            pass
    except OSError:
        pass


def main():
    args = sys.argv[1:]
    if "--first-run" in args and os.path.exists(MARKER):
        return 0
    start = 0
    if "--page" in args:
        try:
            start = int(args[args.index("--page") + 1]) - 1
        except (IndexError, ValueError):
            pass
    GLib.set_prgname("luxos-tour")
    GLib.set_application_name(_("LuxOS Tour"))
    app = Gtk.Application(application_id="cz.luxos.Tour", flags=Gio.ApplicationFlags.FLAGS_NONE)

    def activate(a):
        wins = a.get_windows()
        if wins:
            wins[0].present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        TourWindow(a, start)
        mark_done()          # jen jednou, i kdyz se relace ukonci uprostred prohlidky
    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
