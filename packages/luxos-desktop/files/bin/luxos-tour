#!/usr/bin/env python3
"""LuxOS - Prohlidka LuxOS: kratky pruvodce systemem (kde je co), jako uvitani v macOS.

  luxos-tour               okno pruvodce (Launchpad, Uvitani, O tomto pocitaci)
  luxos-tour --first-run   prvni prihlaseni (luxos-session): jen pokud jeste nebezel
  luxos-tour --page N      otevre rovnou N-tou stranku (od 1)

Pri prvnim zobrazeni zapise ~/.config/luxos/tour-done, takze se sam spusti jen jednou.
Ilustrace se kresli v cairo (zadne obrazky), barvy podle svetleho/tmaveho vzhledu.
Tlacitko "Ukazat na obrazovce" zvyrazni skutecnou horni listu / Dock pruhlednym
prekryvem (jen s kompozitorem a se zjistenou polohou; jinak se nezobrazi).
"""
import math
import os
import re
import subprocess
import sys

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402

CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "luxos")
MARKER = os.path.join(CFG, "tour-done")
ACCENT = (0.24, 0.48, 1.0)          # #3d7bff
VIOLET = (0.55, 0.36, 1.0)          # #8b5cff
VW, VH = 640, 300                   # virtualni plocha ilustraci (zmensuje se podle okna)

# Logo LuxOS (luxos-branding/files/logo/luxos-logo.svg, viewBox 256)
LOGO_PATH = ("M246.27 209.91C188.18 163.23 147.07 104.71 133.55 30.45C116.12 140.58 158.36 161.65 246.27 209.91Z"
             "M8.09 211.18C89.02 173.90 133.08 136.86 126.09 40.64C105.95 110.22 62.88 165.17 8.09 211.18Z"
             "M248.64 226.09C158.26 151.17 105.77 146.57 13.73 222.82C95.86 182.21 167.60 183.49 248.64 226.09Z")

CSS = b"""
.tour-title { font-size: 24px; font-weight: 800; }
.tour-body { font-size: 14px; opacity: 0.78; }
.primary { border-radius: 999px; padding: 6px 24px; font-weight: 700; background-image: none;
           background-color: #3d7bff; color: white; border: none; box-shadow: none; }
.primary:hover { background-color: #5a8fff; }
.primary:focus { box-shadow: 0 0 0 3px alpha(#3d7bff, 0.35); }
.pill { border-radius: 999px; padding: 4px 16px; }
.pill:checked { background-image: none; background-color: alpha(#3d7bff, 0.18); border-color: #3d7bff;
                color: inherit; }
.dot { min-width: 8px; min-height: 8px; padding: 0; margin: 0 3px; border-radius: 999px; border: none;
       background-image: none; box-shadow: none; background-color: alpha(currentColor, 0.22); }
.dot:hover { background-color: alpha(currentColor, 0.45); }
.dot.active { background-color: #3d7bff; min-width: 22px; }
.dot:focus { box-shadow: 0 0 0 2px alpha(#3d7bff, 0.5); }
"""


# ---- pomocne kresleni --------------------------------------------------------------------
def rgba(c, a=1.0):
    return (c[0], c[1], c[2], a)


def hexc(h, a=1.0):
    h = h.lstrip("#")
    return (int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255, a)


def rrect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def fill(cr, color):
    cr.set_source_rgba(*color)
    cr.fill()


def vgrad(y0, y1, c0, c1):
    g = cairo.LinearGradient(0, y0, 0, y1)
    g.add_color_stop_rgba(0, *c0)
    g.add_color_stop_rgba(1, *c1)
    return g


def shadow(cr, x, y, w, h, r, dark, depth=10):
    """Mekky stin pod oknem (nekolik pruhlednych vrstev)."""
    for i in range(depth, 0, -2):
        rrect(cr, x - i * 0.3, y + i * 0.5, w + i * 0.6, h + i * 0.4, r + i * 0.5)
        cr.set_source_rgba(0, 0, 0, (0.05 if dark else 0.025))
        cr.fill()


def logo_path(cr, x, y, size):
    """Vlozi do cesty logo LuxOS o velikosti size (levy horni roh x, y)."""
    s = size / 256
    tok = re.findall(r"[MCZ]|-?\d+(?:\.\d+)?", LOGO_PATH)
    i = 0
    while i < len(tok):
        t = tok[i]
        if t == "M":
            cr.move_to(x + float(tok[i + 1]) * s, y + float(tok[i + 2]) * s)
            i += 3
        elif t == "C":
            p = [float(v) for v in tok[i + 1:i + 7]]
            cr.curve_to(x + p[0] * s, y + p[1] * s, x + p[2] * s, y + p[3] * s, x + p[4] * s, y + p[5] * s)
            i += 7
        else:
            cr.close_path()
            i += 1


def logo(cr, x, y, size, color=None):
    logo_path(cr, x, y, size)
    if color:
        cr.set_source_rgba(*color)
    else:
        g = cairo.LinearGradient(x + size * 0.16, y + size * 0.12, x + size * 0.88, y + size * 0.9)
        g.add_color_stop_rgb(0, 0.48, 0.72, 1.0)
        g.add_color_stop_rgb(0.5, 0.36, 0.49, 1.0)
        g.add_color_stop_rgb(1, 0.63, 0.42, 1.0)
        cr.set_source(g)
    cr.fill()


class Painter:
    """Kontext jedne ilustrace: barvy podle vzhledu, text pres Pango, ikony z motivu."""
    _icons = {}

    def __init__(self, cr, widget, dark):
        self.cr, self.widget, self.dark = cr, widget, dark
        self.fg = hexc("#f2f3f7") if dark else hexc("#1d1d1f")
        self.dim = hexc("#f2f3f7", 0.6) if dark else hexc("#1d1d1f", 0.55)
        self.win = hexc("#262833") if dark else hexc("#ffffff")
        self.win2 = hexc("#1e2029") if dark else hexc("#f3f4f8")
        self.line = (1, 1, 1, 0.10) if dark else (0, 0, 0, 0.10)
        self.font = widget.get_pango_context().get_font_description().get_family() or "Sans"

    # text: vraci sirku; align l/c/r vuci x
    def text(self, s, x, y, size=11, color=None, bold=False, align="l", mono=False, maxw=None, lines=1):
        cr = self.cr
        lay = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription.from_string(("Monospace" if mono else self.font) + " " + str(size))
        fd.set_absolute_size(size * Pango.SCALE)
        if bold:
            fd.set_weight(Pango.Weight.BOLD)
        lay.set_font_description(fd)
        lay.set_text(s, -1)
        if maxw:
            lay.set_width(int(maxw * Pango.SCALE))
            lay.set_ellipsize(Pango.EllipsizeMode.END)
            if lines > 1:
                lay.set_wrap(Pango.WrapMode.WORD_CHAR)
                lay.set_height(-lines)
        w, h = lay.get_pixel_size()
        if maxw and lines > 1 and align != "l":
            lay.set_alignment(Pango.Alignment.CENTER if align == "c" else Pango.Alignment.RIGHT)
            w = maxw
        dx = {"l": 0, "c": -w / 2, "r": -w}[align]
        cr.move_to(x + dx, y - h / 2)
        cr.set_source_rgba(*(color or self.fg))
        PangoCairo.show_layout(cr, lay)
        return w

    def text_width(self, s, size=11, bold=False):
        lay = PangoCairo.create_layout(self.cr)
        fd = Pango.FontDescription.from_string(self.font)
        fd.set_absolute_size(size * Pango.SCALE)
        if bold:
            fd.set_weight(Pango.Weight.BOLD)
        lay.set_font_description(fd)
        lay.set_text(s, -1)
        return lay.get_pixel_size()[0]

    def icon(self, names, x, y, size, fallback=ACCENT, glyph=""):
        """Ikona aplikace z motivu ikon (prvni existujici), jinak barevna dlazdice."""
        cr = self.cr
        px = int(size * 2)          # vetsi rozliseni - ilustrace se zvetsuje
        pb = None
        for n in names:
            key = (n, px)
            if key not in self._icons:
                try:
                    self._icons[key] = Gtk.IconTheme.get_default().load_icon(
                        n, px, Gtk.IconLookupFlags.FORCE_SIZE)
                except GLib.Error:
                    self._icons[key] = None
            pb = self._icons[key]
            if pb:
                break
        if pb:
            cr.save()
            cr.translate(x, y)
            cr.scale(size / pb.get_width(), size / pb.get_height())
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
            cr.restore()
            return
        rrect(cr, x + size * 0.06, y + size * 0.06, size * 0.88, size * 0.88, size * 0.22)
        cr.set_source(vgrad(y, y + size, rgba(tuple(min(1, c + 0.18) for c in fallback)), rgba(fallback)))
        cr.fill()
        if glyph:
            self.text(glyph, x + size / 2, y + size / 2, size * 0.42, (1, 1, 1, 1), bold=True, align="c")

    def keycap(self, label, x, y, h=26, size=11):
        """Klavesa; vraci sirku."""
        cr = self.cr
        w = max(h, self.text_width(label, size, True) + 18)
        rrect(cr, x, y + 2, w, h, 6)
        fill(cr, (0, 0, 0, 0.35 if self.dark else 0.12))
        rrect(cr, x, y, w, h, 6)
        cr.set_source(vgrad(y, y + h, hexc("#3a3d4a") if self.dark else hexc("#ffffff"),
                            hexc("#30323d") if self.dark else hexc("#eef0f5")))
        cr.fill_preserve()
        cr.set_source_rgba(*self.line)
        cr.set_line_width(1)
        cr.stroke()
        self.text(label, x + w / 2, y + h / 2, size, bold=True, align="c")
        return w

    def combo(self, keys, x, y, h=24, size=10, align="l"):
        """Kombinace klaves "Super + A"; vraci sirku."""
        widths = [max(h, self.text_width(k, size, True) + 18) for k in keys]
        total = sum(widths) + 16 * (len(keys) - 1)
        kx = x - total / 2 if align == "c" else x
        for i, k in enumerate(keys):
            if i:
                self.text("+", kx + 8, y + h / 2, size + 1, self.dim, bold=True, align="c")
                kx += 16
            kx += self.keycap(k, kx, y, h, size)
        return total

    def pill(self, s, x, y, size=10.5, color=ACCENT, align="c"):
        """Popisek v barevnem stitku (vysvetlivka v ilustraci)."""
        cr = self.cr
        w = self.text_width(s, size, True) + 18
        h = size + 11
        x0 = {"l": x, "c": x - w / 2, "r": x - w}[align]
        rrect(cr, x0, y - h / 2, w, h, h / 2)
        fill(cr, rgba(color, 0.95))
        self.text(s, x0 + w / 2, y, size, (1, 1, 1, 1), bold=True, align="c")
        return x0, w

    def leader(self, x0, y0, x1, y1, color=ACCENT):
        cr = self.cr
        cr.set_source_rgba(*rgba(color, 0.9))
        cr.set_line_width(1.5)
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        cr.arc(x0, y0, 3, 0, 2 * math.pi)
        cr.fill()

    def ring(self, x, y, w, h, r, color=ACCENT):
        """Zvyrazneni oblasti: zareni + ostra linka."""
        cr = self.cr
        for lw, a in ((12, 0.10), (7, 0.18), (2.5, 0.95)):
            rrect(cr, x, y, w, h, r)
            cr.set_source_rgba(*rgba(color, a))
            cr.set_line_width(lw)
            cr.stroke()

    def wallpaper(self, x, y, w, h, r=10, dark=None):
        """Tapeta LuxOS v miniature: prechod modra -> fialova s vlnami."""
        cr = self.cr
        dark = self.dark if dark is None else dark
        cr.save()
        rrect(cr, x, y, w, h, r)
        cr.clip()
        g = cairo.LinearGradient(x, y, x + w, y + h)
        if dark:
            g.add_color_stop_rgb(0, 0.06, 0.10, 0.26)
            g.add_color_stop_rgb(0.55, 0.17, 0.14, 0.45)
            g.add_color_stop_rgb(1, 0.33, 0.16, 0.52)
        else:
            g.add_color_stop_rgb(0, 0.62, 0.78, 1.0)
            g.add_color_stop_rgb(0.55, 0.70, 0.66, 1.0)
            g.add_color_stop_rgb(1, 0.86, 0.68, 1.0)
        cr.set_source(g)
        cr.paint()
        for i, a in enumerate((0.16, 0.11, 0.08)):
            yy = y + h * (0.45 + i * 0.16)
            cr.move_to(x - 10, yy)
            cr.curve_to(x + w * 0.3, yy - h * 0.35, x + w * 0.6, yy + h * 0.3, x + w + 10, yy - h * 0.15)
            cr.line_to(x + w + 10, y + h + 10)
            cr.line_to(x - 10, y + h + 10)
            cr.close_path()
            cr.set_source_rgba(1, 1, 1, a)
            cr.fill()
        cr.restore()

    # ---- symbolicke ikony horni listy (stred cx, cy; velikost s) ----
    def g_wifi(self, cx, cy, s, c):
        cr = self.cr
        cr.set_source_rgba(*c)
        cr.set_line_width(s * 0.13)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        by = cy + s * 0.38
        for k in (0.30, 0.56, 0.82):
            cr.arc(cx, by, s * k * 0.75, math.radians(-135), math.radians(-45))
            cr.stroke()
        cr.arc(cx, by - s * 0.02, s * 0.08, 0, 2 * math.pi)
        cr.fill()

    def g_sound(self, cx, cy, s, c):
        cr = self.cr
        cr.set_source_rgba(*c)
        x = cx - s * 0.45
        cr.move_to(x, cy - s * 0.14)
        cr.line_to(x + s * 0.18, cy - s * 0.14)
        cr.line_to(x + s * 0.42, cy - s * 0.36)
        cr.line_to(x + s * 0.42, cy + s * 0.36)
        cr.line_to(x + s * 0.18, cy + s * 0.14)
        cr.line_to(x, cy + s * 0.14)
        cr.close_path()
        cr.fill()
        cr.set_line_width(s * 0.1)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for k in (0.2, 0.38):
            cr.arc(x + s * 0.42, cy, s * k, -0.9, 0.9)
            cr.stroke()

    def g_battery(self, cx, cy, s, c, level=0.82):
        cr = self.cr
        w, h = s * 1.15, s * 0.58
        x, y = cx - w / 2, cy - h / 2
        rrect(cr, x, y, w, h, h * 0.28)
        cr.set_source_rgba(*c)
        cr.set_line_width(s * 0.08)
        cr.stroke()
        rrect(cr, x + s * 0.1, y + s * 0.1, (w - s * 0.2) * level, h - s * 0.2, h * 0.14)
        cr.fill()
        rrect(cr, x + w + s * 0.04, cy - h * 0.2, s * 0.08, h * 0.4, s * 0.04)
        cr.fill()

    def g_cc(self, cx, cy, s, c):
        cr = self.cr
        cr.set_source_rgba(*c)
        cr.set_line_width(s * 0.08)
        for dy, knob in ((-0.22, -0.2), (0.22, 0.2)):
            rrect(cr, cx - s * 0.42, cy + dy * s - s * 0.16, s * 0.84, s * 0.32, s * 0.16)
            cr.stroke()
            cr.arc(cx + knob * s, cy + dy * s, s * 0.1, 0, 2 * math.pi)
            cr.fill()

    def g_bell(self, cx, cy, s, c):
        cr = self.cr
        cr.set_source_rgba(*c)
        cr.move_to(cx - s * 0.36, cy + s * 0.22)
        cr.curve_to(cx - s * 0.26, cy + s * 0.08, cx - s * 0.3, cy - s * 0.38, cx, cy - s * 0.38)
        cr.curve_to(cx + s * 0.3, cy - s * 0.38, cx + s * 0.26, cy + s * 0.08, cx + s * 0.36, cy + s * 0.22)
        cr.close_path()
        cr.fill()
        cr.arc(cx, cy + s * 0.32, s * 0.09, 0, 2 * math.pi)
        cr.fill()

    def g_lock(self, cx, cy, s, c):
        cr = self.cr
        cr.set_source_rgba(*c)
        cr.set_line_width(s * 0.12)
        cr.arc(cx, cy - s * 0.08, s * 0.24, math.pi, 0)
        cr.line_to(cx + s * 0.24, cy + s * 0.02)
        cr.move_to(cx - s * 0.24, cy + s * 0.02)
        cr.line_to(cx - s * 0.24, cy - s * 0.08)
        cr.stroke()
        rrect(cr, cx - s * 0.36, cy, s * 0.72, s * 0.5, s * 0.1)
        cr.fill()

    def topbar(self, x, y, w, h, app, menus, big=False):
        """Horni lista; vraci polohy prvku pro vysvetlivky."""
        cr = self.cr
        rrect(cr, x, y, w, h, 0 if not big else 10)
        fill(cr, hexc("#1c1d24", 0.78) if self.dark else hexc("#ffffff", 0.82))
        fs = h * 0.42
        c = self.fg
        pos = {}
        lx = x + h * 0.45
        logo(cr, lx, y + h * 0.2, h * 0.6, color=c)
        pos["logo"] = (lx + h * 0.3, y + h)
        # vpravo: hodiny, upozorneni, ovladaci centrum, baterie, zvuk, Wi-Fi
        clock = GLib.DateTime.new_now_local().format("%a %e %b  %H:%M") or "9:41"
        rx = x + w - h * 0.4
        cw = self.text(clock.replace("  ", " "), rx, y + h / 2, fs, c, bold=True, align="r")
        pos["clock"] = (rx - cw / 2, y + h)
        rx -= cw + h * 0.75
        gs = h * 0.52
        for name, fn in (("bell", self.g_bell), ("cc", self.g_cc), ("battery", self.g_battery),
                         ("sound", self.g_sound), ("wifi", self.g_wifi)):
            fn(rx, y + h / 2, gs, c)
            pos[name] = (rx, y + h)
            rx -= h * (1.0 if name != "battery" else 1.05)
        # vlevo: aplikace a jeji nabidky (jen ty, ktere se vejdou pred stavove ikony)
        limit = rx - h * 0.2
        tx = lx + h * 0.95
        tw = self.text(app, tx, y + h / 2, fs, c, bold=True)
        mx = tx + tw + h * 0.6
        m0 = mx
        for m in menus:
            mw = self.text_width(m, fs)
            if mx + mw > limit:
                break
            self.text(m, mx, y + h / 2, fs, c)
            mx += mw + h * 0.55
        pos["menus"] = ((m0 + mx - h * 0.55) / 2 if mx > m0 else m0, y + h)
        return pos

    def window(self, x, y, w, h, title="", r=10):
        """Okno aplikace s titulkem a semafory; vraci y obsahu."""
        cr = self.cr
        shadow(cr, x, y, w, h, r, self.dark)
        rrect(cr, x, y, w, h, r)
        fill(cr, self.win)
        rrect(cr, x, y, w, h, r)
        cr.set_source_rgba(*self.line)
        cr.set_line_width(1)
        cr.stroke()
        for i, col in enumerate(("#ff5f57", "#febc2e", "#28c840")):
            cr.arc(x + 14 + i * 13, y + 13, 4.2, 0, 2 * math.pi)
            fill(cr, hexc(col))
        if title:
            self.text(title, x + w / 2, y + 13, 10, self.dim, bold=True, align="c")
        return y + 26

    def dock(self, cx, y, size, items, running=(), gap=None):
        """Dock s ikonami; vraci (x, y, w, h) panelu."""
        cr = self.cr
        gap = gap if gap is not None else size * 0.22
        n = len(items)
        w = n * size + (n - 1) * gap + size * 0.5
        h = size * 1.32
        x = cx - w / 2
        rrect(cr, x, y, w, h, size * 0.32)
        fill(cr, hexc("#2b2c36", 0.72) if self.dark else hexc("#ffffff", 0.55))
        rrect(cr, x, y, w, h, size * 0.32)
        cr.set_source_rgba(1, 1, 1, 0.22 if self.dark else 0.7)
        cr.set_line_width(1)
        cr.stroke()
        ix = x + size * 0.25
        for i, it in enumerate(items):
            self.icon(it[0], ix, y + size * 0.14, size, it[1], it[2])
            if i in running:
                cr.arc(ix + size / 2, y + h - size * 0.09, size * 0.045, 0, 2 * math.pi)
                fill(cr, self.fg)
            ix += size + gap
        return x, y, w, h


DOCK_ITEMS = [
    (["luxos-launchpad"], (0.35, 0.45, 1.0), "⋮⋮"),
    (["luxai", "luxos-app"], (0.30, 0.42, 1.0), "✦"),
    (["luxos-store"], (0.20, 0.55, 1.0), "S"),
    (["luxos-files", "org.xfce.thunar", "system-file-manager"], (0.25, 0.6, 1.0), "▤"),
    (["firefox", "luxos-web-browser", "web-browser"], (1.0, 0.5, 0.2), "◉"),
    (["utilities-terminal", "org.xfce.terminal"], (0.2, 0.22, 0.26), ">_"),
    (["luxos-notes", "accessories-text-editor", "org.xfce.mousepad"], (1.0, 0.65, 0.2), "✎"),
    (["luxos-settings", "preferences-system", "org.xfce.settings.manager"], (0.45, 0.5, 0.6), "⚙"),
    (["user-trash"], (0.7, 0.72, 0.76), "◌"),
]
GRID_ITEMS = DOCK_ITEMS[2:8] + [
    (["luxos-calculator", "accessories-calculator"], (1.0, 0.6, 0.1), "±"),
    (["luxos-camera", "camera-app", "cheese"], (0.3, 0.3, 0.35), "◎"),
    (["luxdrop"], (0.2, 0.7, 0.9), "⇄"),
