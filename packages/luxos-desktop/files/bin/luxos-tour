def draw_files(p):
    cr = p.cr
    p.wallpaper(0, 0, VW, VH, 18)
    x, y, w, h = 60, 24, 440, 252
    top = p.window(x, y, w, h, _("Home"))
    sb = 128
    rrect(cr, x + 1, top, sb, h - (top - y) - 1, 0)
    fill(cr, p.win2)
    items = ((_("Home"), "go-home"), (_("Documents"), "folder-documents"), (_("Downloads"), "folder-download"),
             (_("Pictures"), "folder-pictures"), (_("Music"), "folder-music"), (_("Safe"), None))
    for i, (name, _ic) in enumerate(items):
        iy = top + 18 + i * 28
        if name == _("Safe"):
            rrect(cr, x + 8, iy - 12, sb - 14, 24, 7)
            fill(cr, rgba(ACCENT, 0.18))
            p.g_lock(x + 22, iy, 13, rgba(ACCENT))
            p.text(name, x + 36, iy, 10.5, bold=True, maxw=sb - 44)
            p.ring(x + 6, iy - 14, sb - 10, 28, 8)
        else:
            rrect(cr, x + 16, iy - 5, 12, 10, 2)
            fill(cr, rgba(ACCENT, 0.75))
            p.text(name, x + 36, iy, 10.5, maxw=sb - 40)
    for i, name in enumerate((_("Documents"), _("Downloads"), _("Pictures"), _("Music"), _("Videos"),
                              _("Desktop"))):
        fx = x + sb + 26 + (i % 3) * 96
        fy = top + 22 + (i // 3) * 98
        p.icon(["folder"], fx + 14, fy, 54, (0.35, 0.6, 1.0), "")
        p.text(name, fx + 41, fy + 66, 10, align="c", maxw=90)
    # velky zamek Trezoru
    lx, ly = 552, 196
    cr.arc(lx, ly, 52, 0, 2 * math.pi)
    cr.set_source(vgrad(ly - 52, ly + 52, rgba(ACCENT), rgba(VIOLET)))
    cr.fill()
    p.g_lock(lx, ly + 2, 50, (1, 1, 1, 1))
    p.text(_("Encrypted"), lx, ly + 72, 11, (1, 1, 1, 0.95) if p.dark else p.fg, bold=True, align="c")


def draw_store(p):
    cr = p.cr
    p.wallpaper(0, 0, VW, VH, 18)
    x, y, w, h = 24, 20, 380, 236
    top = p.window(x, y, w, h, "LuxOS Store")
    sb = 108
    rrect(cr, x + 1, top, sb, h - (top - y) - 1, 0)
    fill(cr, p.win2)
    for i, name in enumerate((_("Discover"), _("Internet"), _("Office"), _("Graphics"), _("Games"),
                              _("Updates"))):
        iy = top + 18 + i * 26
        if i == 0:
            rrect(cr, x + 8, iy - 11, sb - 14, 22, 7)
            fill(cr, rgba(ACCENT, 0.18))
        p.text(name, x + 18, iy, 10.5, bold=(i == 0), maxw=sb - 24)
    apps = ((["gimp"], (0.4, 0.4, 0.35), "G", "GIMP"), (["libreoffice-main", "libreoffice-startcenter"],
            (0.2, 0.6, 0.3), "L", "LibreOffice"), (["vlc"], (1.0, 0.5, 0.1), "▶", "VLC"),
            (["inkscape"], (0.2, 0.2, 0.2), "I", "Inkscape"))
    for i, (ic, col, gl, name) in enumerate(apps):
        cx = x + sb + 14 + (i % 2) * 130
        cy = top + 14 + (i // 2) * 96
        rrect(cr, cx, cy, 120, 84, 12)
        fill(cr, hexc("#ffffff", 0.05) if p.dark else hexc("#000000", 0.035))
        p.icon(ic, cx + 10, cy + 10, 38, col, gl)
        p.text(name, cx + 10, cy + 62, 10.5, bold=True, maxw=64)
        bw = max(40, p.text_width(_("Get"), 9.5, True) + 16)
        rrect(cr, cx + 112 - bw, cy + 52, bw, 20, 10)
        fill(cr, rgba(ACCENT, 0.16))
        p.text(_("Get"), cx + 112 - bw / 2, cy + 62, 9.5, rgba(ACCENT), bold=True, align="c")
    # Terminal s prikazem lux
    tx, ty, tw, th = 340, 128, 278, 152
    shadow(cr, tx, ty, tw, th, 10, True)
    rrect(cr, tx, ty, tw, th, 10)
    fill(cr, hexc("#16171d", 0.97))
    for i, col in enumerate(("#ff5f57", "#febc2e", "#28c840")):
        cr.arc(tx + 14 + i * 13, ty + 13, 4.2, 0, 2 * math.pi)
        fill(cr, hexc(col))
    lines = (("❯ ", "lux install gimp", "#8ab4ff"), ("", ":: " + _("Installing") + " gimp…", "#a9adbb"),
             ("", "✓ gimp " + _("installed"), "#5fd38d"), ("❯ ", "lux update", "#8ab4ff"),
             ("", "✓ " + _("System is up to date"), "#5fd38d"))
    for i, (pr, s, col) in enumerate(lines):
        ly = ty + 38 + i * 21
        off = 0
        if pr:
            off = p.text(pr, tx + 14, ly, 11, hexc("#b48cff"), mono=True)
        p.text(s, tx + 14 + off, ly, 11, hexc(col) if not pr else hexc("#f2f3f7"), mono=True, maxw=tw - 30)


def mini_desktop(p, x, y, w, h, dark):
    cr = p.cr
    shadow(cr, x, y, w, h, 12, p.dark)
    p.wallpaper(x, y, w, h, 12, dark=dark)
    cr.save()
    rrect(cr, x, y, w, h, 12)
    cr.clip()
    cr.rectangle(x, y, w, 12)
    fill(cr, hexc("#1c1d24", 0.8) if dark else hexc("#ffffff", 0.8))
    wx, wy, ww, wh = x + w * 0.16, y + h * 0.22, w * 0.62, h * 0.48
    rrect(cr, wx, wy, ww, wh, 7)
    fill(cr, hexc("#262833") if dark else hexc("#ffffff"))
    rrect(cr, wx, wy, ww * 0.3, wh, 7)
    fill(cr, hexc("#1e2029") if dark else hexc("#f0f1f5"))
    for k in range(3):
        rrect(cr, wx + ww * 0.38, wy + 14 + k * 12, ww * (0.5 - k * 0.1), 5, 2.5)
        fill(cr, hexc("#ffffff", 0.25) if dark else hexc("#000000", 0.15))
    rrect(cr, x + w * 0.3, y + h - 22, w * 0.4, 16, 6)
    fill(cr, hexc("#2b2c36", 0.75) if dark else hexc("#ffffff", 0.6))
    cr.restore()


def draw_appearance(p, mode=None):
    cr = p.cr
    rrect(cr, 0, 0, VW, VH, 18)
    fill(cr, hexc("#1a1c26") if p.dark else hexc("#eef0f8"))
    names = (("light", _("Light")), ("dark", _("Dark")), ("auto", _("Auto")))
    for i, (key, name) in enumerate(names):
        x, y, w, h = 28 + i * 200, 40, 184, 170
        if key == "auto":
            cr.save()
            cr.move_to(x - 20, y - 20)
            cr.line_to(x + w + 20, y - 20)
            cr.line_to(x - 20, y + h + 20)
            cr.close_path()
            cr.clip()
            mini_desktop(p, x, y, w, h, False)
            cr.restore()
            cr.save()
            cr.move_to(x + w + 20, y - 20)
            cr.line_to(x + w + 20, y + h + 20)
            cr.line_to(x - 20, y + h + 20)
            cr.close_path()
            cr.clip()
            mini_desktop(p, x, y, w, h, True)
            cr.restore()
            # slunce a mesic
            cr.arc(x + 22, y + 30, 8, 0, 2 * math.pi)
            fill(cr, hexc("#ffb02e"))
            cr.arc(x + w - 22, y + h - 40, 8, 0, 2 * math.pi)
            fill(cr, hexc("#f4f4ff"))
            cr.arc(x + w - 18, y + h - 44, 7, 0, 2 * math.pi)
            fill(cr, hexc("#3b3170"))
        else:
            mini_desktop(p, x, y, w, h, key == "dark")
        if key == mode:
            p.ring(x - 5, y - 5, w + 10, h + 10, 16)
        p.text(name, x + w / 2, y + h + 32, 13, bold=(key == mode), align="c")


