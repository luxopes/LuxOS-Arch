#!/bin/bash
# LuxOS - vzhled: svetly/tmavy rezim, tapeta, pruhlednost horni listy a docku
# Pouziti: luxos-appearance [dark|light|auto|toggle|status|mode|watch|reapply]
#          auto = podle vychodu/zapadu slunce (poloha z casoveho pasma), watch = hlidani v relaci
#          luxos-appearance wallpaper SOUBOR | bar-opacity 0-100 | dock-opacity 0-100|default
set -u

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/luxos"
state_file="$state_dir/appearance"
prefs="$state_dir/appearance.conf"   # BAR_OPACITY, DOCK_OPACITY (nastaveni Plocha a Dock)
wall_dir=/usr/share/backgrounds/luxos
BAR_OPACITY=62
DOCK_OPACITY=
APPEARANCE_AUTO=0
[[ -r $prefs ]] && . "$prefs"

set_pref() {  # set_pref KLIC HODNOTA
    mkdir -p "$state_dir"
    touch "$prefs"
    sed -i "/^$1=/d" "$prefs"
    echo "$1=$2" >>"$prefs"
}

# Tema docku: WhiteSur, nebo jeho kopie s vlastni pruhlednosti pozadi
dock_theme() {  # dock_theme Dark|Light -> nazev tematu Planku
    local base=/usr/share/plank/themes/WhiteSur-$1/dock.theme dir a
    if [[ -z $DOCK_OPACITY || ! -r $base ]]; then
        echo "WhiteSur-$1"
        return
    fi
    dir="${XDG_DATA_HOME:-$HOME/.local/share}/plank/themes/LuxOS-$1"
    a=$(( DOCK_OPACITY * 255 / 100 ))
    mkdir -p "$dir"
    sed -E "s/^(Fill(Start|End)Color=[0-9]+;;[0-9]+;;[0-9]+;;)[0-9]+/\1$a/" "$base" >"$dir/dock.theme"
    echo "LuxOS-$1"
}

current() {
    local m
    m=$(cat "$state_file" 2>/dev/null)
    [[ $m == dark ]] && echo dark || echo light    # vychozi je svetly rezim
}

sun_mode() {
    python3 -I /usr/lib/luxos/python/luxos_sun.py mode 2>/dev/null || current
}

# Nastavi tapetu LuxOS na vsech monitorech a plochach.
# force=0: jen tam, kde zadna tapeta neni; force=1 i misto vychozi tapety druheho
# rezimu (jinou vybranou tapetu, i z galerie LuxOS, nemeni).
set_wallpaper() {
    local mode=$1 force=${2:-0} img="$wall_dir/luxos-$1.jpg" mon ws prop cur
    command -v xfconf-query >/dev/null || return 0
    for mon in $(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
        for ws in 0 1 2 3; do
            prop="/backdrop/screen0/monitor$mon/workspace$ws"
            cur=$(xfconf-query -c xfce4-desktop -p "$prop/last-image" 2>/dev/null)
            if [[ -z $cur ]] || [[ $force == 1 && $cur == "$wall_dir"/luxos-@(dark|light).jpg ]]; then
                xfconf-query -c xfce4-desktop -p "$prop/last-image" -n -t string -s "$img"
                xfconf-query -c xfce4-desktop -p "$prop/image-style" -n -t int -s 5
            fi
        done
    done
}

# Barva textu horni listy: WhiteSur pocita s tmavou listou, ve svetlem rezimu ji prebarvime.
# Spravovany blok v ~/.config/gtk-3.0/gtk.css (ostatni obsah souboru zustava).
panel_css() {
    local mode=$1 css="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/gtk.css"
    mkdir -p "${css%/*}"
    touch "$css"
    sed -i '/\/\* LuxOS appearance begin \*\//,/\/\* LuxOS appearance end \*\//d' "$css"
    if [[ $mode == light ]]; then
        cat >> "$css" <<'CSS'
/* LuxOS appearance begin */
.xfce4-panel, .xfce4-panel label, .xfce4-panel button, .xfce4-panel image { color: #1d1d1f; }
/* LuxOS appearance end */
CSS
    fi
}

apply() {
    local mode=$1 gtk icons rgba prefer
    local alpha
    alpha=$(LC_ALL=C awk -v o="$BAR_OPACITY" 'BEGIN { printf "%.2f", o / 100 }')
    if [[ $mode == light ]]; then
        gtk=WhiteSur-Light icons=WhiteSur-light prefer=prefer-light
        rgba=(0.96 0.96 0.97 "$alpha")
    else
        gtk=WhiteSur-Dark icons=WhiteSur-dark prefer=prefer-dark
        rgba=(0.09 0.09 0.12 "$alpha")
    fi

    if command -v xfconf-query >/dev/null; then
        xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$gtk"
        xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$icons"
        xfconf-query -c xfwm4 -p /general/theme -n -t string -s "$gtk"
        xfconf-query -c xfce4-notifyd -p /theme -n -t string -s "$gtk"
        xfconf-query -c xfce4-panel -p /panels/dark-mode -n -t bool -s "$([[ $mode == dark ]] && echo true || echo false)"
        xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n \
            -t double -s "${rgba[0]}" -t double -s "${rgba[1]}" -t double -s "${rgba[2]}" -t double -s "${rgba[3]}"
    fi
    if command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface color-scheme "$prefer" 2>/dev/null
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null
        gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null
        local dock=net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ theme
        theme=$(dock_theme "${gtk#WhiteSur-}")
        # Plank nenacte zmenene tema se stejnym nazvem - prepnout pres puvodni
        [[ $(gsettings get "$dock" theme 2>/dev/null) == "'$theme'" && $theme == LuxOS-* ]] &&
            gsettings set "$dock" theme "$gtk" 2>/dev/null
        gsettings set "$dock" theme "$theme" 2>/dev/null
    fi
    local old
    old=$(cat "$state_file" 2>/dev/null)
    panel_css "$mode"
    mkdir -p "$state_dir"
    echo "$mode" > "$state_file"
    # Panel nacita gtk.css jen pri startu
    if [[ $old != "$mode" ]] && pgrep -u "$USER" -x xfce4-panel >/dev/null; then
        xfce4-panel -r >/dev/null 2>&1 &
    fi
}

case ${1:-status} in
    dark|light) set_pref APPEARANCE_AUTO 0; apply "$1"; set_wallpaper "$1" 1 ;;
    toggle)     set_pref APPEARANCE_AUTO 0
                m=$([[ $(current) == dark ]] && echo light || echo dark); apply "$m"; set_wallpaper "$m" 1 ;;
    auto)       set_pref APPEARANCE_AUTO 1; m=$(sun_mode); apply "$m"; set_wallpaper "$m" 1 ;;
    mode)       [[ $APPEARANCE_AUTO == 1 ]] && echo auto || current ;;
    watch)
        # Automaticky rezim: kontrola kazdych 5 minut (zmena nastaveni se nacte znovu)
        while sleep 300; do
            APPEARANCE_AUTO=0
            [[ -r $prefs ]] && . "$prefs"
            [[ $APPEARANCE_AUTO == 1 ]] || continue
            m=$(sun_mode)
            [[ $m == "$(current)" ]] || { apply "$m"; set_wallpaper "$m" 1; }
        done ;;
    reapply)    set_wallpaper "$(current)" 0 ;;
    status)     current ;;
    wallpaper)
        [[ -r ${2-} ]] || { echo "Usage: luxos-appearance wallpaper FILE" >&2; exit 2; }
        for mon in $(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
            for ws in 0 1 2 3; do
                xfconf-query -c xfce4-desktop -p "/backdrop/screen0/monitor$mon/workspace$ws/last-image" -n -t string -s "$2"
                xfconf-query -c xfce4-desktop -p "/backdrop/screen0/monitor$mon/workspace$ws/image-style" -n -t int -s 5
            done
        done ;;
    bar-opacity|dock-opacity)
        v=${2-}
        [[ $1 == dock-opacity && $v == default ]] && v=
        [[ -z $v || $v =~ ^[0-9]+$ && $v -le 100 ]] || { echo "Usage: luxos-appearance $1 0-100" >&2; exit 2; }
        if [[ $1 == bar-opacity ]]; then BAR_OPACITY=$v; set_pref BAR_OPACITY "$v"
        else DOCK_OPACITY=$v; set_pref DOCK_OPACITY "$v"; fi
        apply "$(current)" ;;
    *) echo "Usage: luxos-appearance [dark|light|auto|toggle|status|mode|watch|wallpaper FILE|bar-opacity N|dock-opacity N]" >&2; exit 2 ;;
esac
