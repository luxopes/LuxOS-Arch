#!/bin/bash
# LuxOS - vzhled: svetly/tmavy rezim, tapeta, pruhlednost horni listy a docku
# Pouziti: luxos-appearance [dark|light|auto|toggle|status|mode|watch|reapply|greeter-sync]
#          auto = podle vychodu/zapadu slunce (poloha z casoveho pasma), watch = hlidani v relaci
#          luxos-appearance wallpaper SOUBOR | bar-opacity 0-100 | dock-opacity 0-100|default
set -u

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/luxos"
state_file="$state_dir/appearance"
prefs="$state_dir/appearance.conf"   # BAR_OPACITY, DOCK_OPACITY (nastaveni Plocha a Dock)
wall_dir=/usr/share/backgrounds/luxos
BAR_OPACITY=62
DOCK_OPACITY=
APPEARANCE_AUTO=0
LOGIN_WALLPAPER=1    # 0 = prihlasovaci obrazovka si necha vlastni tapetu
[[ -r $prefs ]] && . "$prefs"

set_pref() {  # set_pref KLIC HODNOTA
    mkdir -p "$state_dir"
    touch "$prefs"
    sed -i "/^$1=/d" "$prefs"
    echo "$1=$2" >>"$prefs"
}

# Tema docku: WhiteSur, nebo jeho kopie s vlastni pruhlednosti pozadi
dock_theme() {  # dock_theme Dark|Light -> nazev tematu Planku
    local base=/usr/share/plank/themes/WhiteSur-$1/dock.theme dir a
    if [[ -z $DOCK_OPACITY || ! -r $base ]]; then
        echo "WhiteSur-$1"
        return
    fi
    dir="${XDG_DATA_HOME:-$HOME/.local/share}/plank/themes/LuxOS-$1"
    a=$(( DOCK_OPACITY * 255 / 100 ))
    mkdir -p "$dir"
    sed -E "s/^(Fill(Start|End)Color=[0-9]+;;[0-9]+;;[0-9]+;;)[0-9]+/\1$a/" "$base" >"$dir/dock.theme"
    echo "LuxOS-$1"
}

current() {
    local m
    m=$(cat "$state_file" 2>/dev/null)
    [[ $m == dark ]] && echo dark || echo light    # vychozi je svetly rezim
}

sun_mode() {
    python3 -I /usr/lib/luxos/python/luxos_sun.py mode 2>/dev/null || current
}

# Nastavi tapetu LuxOS na vsech monitorech a plochach.
# force=0: jen tam, kde zadna tapeta neni; force=1 i misto vychozi tapety druheho
# rezimu (jinou vybranou tapetu, i z galerie LuxOS, nemeni).
set_wallpaper() {
    local mode=$1 force=${2:-0} img="$wall_dir/luxos-$1.jpg" mon ws prop cur line
    command -v xfconf-query >/dev/null || return 0
    # Ulozene tapety jednim dotazem (drive jedno volani xfconf-query na monitor a plochu,
    # pri kazdem prihlaseni); hodnota nasleduje za nazvem vlastnosti po mezerach
    local -A have=()
    while IFS= read -r line; do
        [[ $line == /backdrop/screen0/monitor*/last-image* ]] || continue
        prop=${line%%[[:space:]]*}
        cur=${line#"$prop"}
        have[$prop]=${cur#"${cur%%[![:space:]]*}"}
    done < <(xfconf-query -c xfce4-desktop -l -v 2>/dev/null)
    for mon in $(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
        for ws in 0 1 2 3; do
            prop="/backdrop/screen0/monitor$mon/workspace$ws"
            cur=${have[$prop/last-image]-}
            if [[ -z $cur ]] || [[ $force == 1 && $cur == "$wall_dir"/luxos-@(dark|light).jpg ]]; then
                xfconf-query -c xfce4-desktop -p "$prop/last-image" -n -t string -s "$img"
                xfconf-query -c xfce4-desktop -p "$prop/image-style" -n -t int -s 5
            fi
        done
    done
}

# Tapeta plochy na hlavnim monitoru (plocha 0, stejne jako zamykaci dialog xfce4-screensaver)
desktop_wallpaper() {
    local mon line prop val first=
    local -A have=()
    while IFS= read -r line; do
        [[ $line == /backdrop/screen0/monitor*/last-image* ]] || continue
        prop=${line%%[[:space:]]*}
        val=${line#"$prop"}
        val=${val#"${val%%[![:space:]]*}"}
        [[ -n $val ]] || continue
        have[$prop]=$val
        [[ -n $first || $prop != */workspace0/last-image ]] || first=$val
    done < <(xfconf-query -c xfce4-desktop -l -v 2>/dev/null)
    # hlavni monitor (*) prvni, pak ostatni
    for mon in $(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 {p = ($2 ~ /\*/) ? 0 : 1; print p, $NF}' | sort -s -k1,1 | cut -d' ' -f2); do
        val=${have[/backdrop/screen0/monitor$mon/workspace0/last-image]-}
        [[ -n $val ]] && { printf '%s\n' "$val"; return; }
    done
    [[ -n $first ]] && printf '%s\n' "$first"
}

# Muze soubor cist i jiny uzivatel (prihlasovaci obrazovka bezi jako lightdm)? Tapety
# v domovske slozce (prava 700) ne - pak vychozi tapeta LuxOS pro aktualni rezim.
world_readable() {
    local p
    p=$(realpath -e -- "$1" 2>/dev/null) || return 1
    [[ -f $p && $(stat -c %A -- "$p") == ???????r?? ]] || return 1
    p=${p%/*}
    while [[ -n $p ]]; do
        [[ $(stat -c %A -- "$p") == ?????????[xt] ]] || return 1
        p=${p%/*}
    done
}

# Tapeta prihlasovaci obrazovky a obrazovky pri prepnuti uzivatele = tapeta plochy (luxos-greeter
# ji bere z AccountsService, BackgroundFile). Jinou tapetu nastavenou mimo LuxOS nemeni:
# prepisuje jen prazdnou, vychozi LuxOS nebo tu, kterou sem drive zapsal sam (greeter-wallpaper).
# Vypnuti: LOGIN_WALLPAPER=0 v appearance.conf.
greeter_sync() {
    local img user cur last synced="$state_dir/greeter-wallpaper"
    [[ ${LOGIN_WALLPAPER:-1} == 0 ]] && return 0
    command -v busctl >/dev/null || return 0
    img=$(desktop_wallpaper)
    [[ -n $img ]] && world_readable "$img" || img="$wall_dir/luxos-$(current).jpg"
    user=$(busctl --system call org.freedesktop.Accounts /org/freedesktop/Accounts \
        org.freedesktop.Accounts FindUserById x "$(id -u)" 2>/dev/null) || return 0
    user=${user#o \"}
    user=${user%\"}
    cur=$(busctl --system get-property org.freedesktop.Accounts "$user" \
        org.freedesktop.DisplayManager.AccountsService BackgroundFile 2>/dev/null) || return 0
    cur=${cur#s \"}
    cur=${cur%\"}
    [[ $cur == "$img" ]] && { mkdir -p "$state_dir"; printf '%s\n' "$img" >"$synced"; return 0; }
    last=$(cat "$synced" 2>/dev/null)
    if [[ -z $cur || $cur == "$last" || $cur == "$wall_dir"/luxos-@(dark|light).jpg ]]; then
        busctl --system set-property org.freedesktop.Accounts "$user" \
            org.freedesktop.DisplayManager.AccountsService BackgroundFile s "$img" 2>/dev/null || return 0
        mkdir -p "$state_dir"
        printf '%s\n' "$img" >"$synced"
    fi
}

# Barva textu horni listy: WhiteSur pocita s tmavou listou, ve svetlem rezimu ji prebarvime.
# Prepinac ploch (pager, jde pridat do listy): plugin si nastavi vlastni CSS s prioritou uzivatele
# (sede bloky), proto styl v uzivatelskem gtk.css, ne v tematu - cisla ploch, aktivni modre.
# Spravovany blok v ~/.config/gtk-3.0/gtk.css (ostatni obsah souboru zustava).
# Navratovy kod 0 = blok se zmenil (panel ho nacte az po restartu).
panel_css() {
    local mode=$1 css="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/gtk.css" fg block old
    mkdir -p "${css%/*}"
    touch "$css"
    fg='#ffffff'
    [[ $mode == light ]] && fg='#1d1d1f'
    block="/* LuxOS appearance begin */"$'\n'
    [[ $mode == light ]] &&
        block+=".xfce4-panel, .xfce4-panel label, .xfce4-panel button, .xfce4-panel image { color: $fg; }"$'\n'
    # pager v rezimu cisel (vychozi LuxOS, luxos-session): tlacitka v mrizce - jine pluginy listy mrizku nemaji
    block+=".xfce4-panel grid > button { min-width: 20px; min-height: 0; padding: 0 4px; margin: 4px 1px; border-radius: 6px; background: transparent; box-shadow: none; border: none; }"$'\n'
    block+=".xfce4-panel grid > button label { color: alpha($fg, 0.55); font-weight: 600; }"$'\n'
    block+=".xfce4-panel grid > button:hover { background: alpha($fg, 0.08); }"$'\n'
    block+=".xfce4-panel grid > button:checked { background: alpha(#3d7bff, 0.22); }"$'\n'
    block+=".xfce4-panel grid > button:checked label { color: $fg; }"$'\n'
    # miniatury (zapnute v nastaveni pageru): bez sedych bloku; ztmaveni neaktivnich ploch kresli libwnck napevno
    block+=".xfce4-panel wnck-pager { background: transparent; }"$'\n'
    block+=".xfce4-panel wnck-pager:hover { background: alpha($fg, 0.08); }"$'\n'
    block+=".xfce4-panel wnck-pager:selected { background: alpha(#3d7bff, 0.22); }"$'\n'
    block+="/* LuxOS appearance end */"
    old=$(sed -n '/\/\* LuxOS appearance begin \*\//,/\/\* LuxOS appearance end \*\//p' "$css")
    [[ $old == "$block" ]] && return 1
    sed -i '/\/\* LuxOS appearance begin \*\//,/\/\* LuxOS appearance end \*\//d' "$css"
    printf '%s\n' "$block" >>"$css"
    return 0
}

apply() {
    local mode=$1 gtk icons rgba prefer
    local alpha
    alpha=$(LC_ALL=C awk -v o="$BAR_OPACITY" 'BEGIN { printf "%.2f", o / 100 }')
    if [[ $mode == light ]]; then
        gtk=WhiteSur-Light icons=WhiteSur-light prefer=prefer-light
        rgba=(0.96 0.96 0.97 "$alpha")
    else
        gtk=WhiteSur-Dark icons=WhiteSur-dark prefer=prefer-dark
        rgba=(0.09 0.09 0.12 "$alpha")
    fi

    if command -v xfconf-query >/dev/null; then
        xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$gtk"
        xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$icons"
        xfconf-query -c xfwm4 -p /general/theme -n -t string -s "$gtk"
        xfconf-query -c xfce4-notifyd -p /theme -n -t string -s "$gtk"
        xfconf-query -c xfce4-panel -p /panels/dark-mode -n -t bool -s "$([[ $mode == dark ]] && echo true || echo false)"
        xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n \
            -t double -s "${rgba[0]}" -t double -s "${rgba[1]}" -t double -s "${rgba[2]}" -t double -s "${rgba[3]}"
    fi
    if command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface color-scheme "$prefer" 2>/dev/null
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null
        gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null
        local dock=net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/ theme
        theme=$(dock_theme "${gtk#WhiteSur-}")
        # Plank nenacte zmenene tema se stejnym nazvem - prepnout pres puvodni
        [[ $(gsettings get "$dock" theme 2>/dev/null) == "'$theme'" && $theme == LuxOS-* ]] &&
            gsettings set "$dock" theme "$gtk" 2>/dev/null
        gsettings set "$dock" theme "$theme" 2>/dev/null
    fi
    local old
    old=$(cat "$state_file" 2>/dev/null)
    panel_css "$mode" || true
    mkdir -p "$state_dir"
    echo "$mode" > "$state_file"
    # Panel nacita gtk.css jen pri startu
    if [[ $old != "$mode" ]] && pgrep -u "$USER" -x xfce4-panel >/dev/null; then
        xfce4-panel -r >/dev/null 2>&1 &
    fi
}

usage() {  # usage [SYNTAXE] - napoveda/chyba pouziti; preklady az tady (bezne volani zustava rychle)
    . /usr/lib/luxos/i18n.sh 2>/dev/null || T() { local f=$1; shift; printf -- "$f" "$@"; }
    if [[ -n ${1-} ]]; then echo "$(T "Usage:") luxos-appearance $1" >&2; exit 2; fi
    echo "$(T "Usage:") luxos-appearance [dark|light|auto|toggle|status|mode|watch|wallpaper FILE|greeter-sync|bar-opacity N|dock-opacity N]"
}

case ${1:-status} in
    # Po aktualizaci LuxOS (luxos-session pri prihlaseni): obnovit spravovany blok, panel jen pri zmene
    panel-css)  if panel_css "$(current)" && pgrep -u "$USER" -x xfce4-panel >/dev/null; then
                    xfce4-panel -r >/dev/null 2>&1 &
                fi ;;
    dark|light) set_pref APPEARANCE_AUTO 0; apply "$1"; set_wallpaper "$1" 1; greeter_sync ;;
    toggle)     set_pref APPEARANCE_AUTO 0
                m=$([[ $(current) == dark ]] && echo light || echo dark); apply "$m"; set_wallpaper "$m" 1; greeter_sync ;;
    auto)       set_pref APPEARANCE_AUTO 1; m=$(sun_mode); apply "$m"; set_wallpaper "$m" 1; greeter_sync ;;
    mode)       [[ $APPEARANCE_AUTO == 1 ]] && echo auto || current ;;
    watch)
        # Automaticky rezim: kontrola kazdych 5 minut (zmena nastaveni se nacte znovu)
        while sleep 300; do
            APPEARANCE_AUTO=0
            [[ -r $prefs ]] && . "$prefs"
            [[ $APPEARANCE_AUTO == 1 ]] || continue
            m=$(sun_mode)
            [[ $m == "$(current)" ]] || { apply "$m"; set_wallpaper "$m" 1; greeter_sync; }
        done ;;
    reapply)    set_wallpaper "$(current)" 0 ;;
    greeter-sync) greeter_sync ;;
    status)     current ;;
    wallpaper)
        [[ -r ${2-} ]] || usage "wallpaper FILE"
        for mon in $(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
            for ws in 0 1 2 3; do
                xfconf-query -c xfce4-desktop -p "/backdrop/screen0/monitor$mon/workspace$ws/last-image" -n -t string -s "$2"
                xfconf-query -c xfce4-desktop -p "/backdrop/screen0/monitor$mon/workspace$ws/image-style" -n -t int -s 5
            done
        done
        greeter_sync ;;
    bar-opacity|dock-opacity)
        v=${2-}
        [[ $1 == dock-opacity && $v == default ]] && v=
        [[ -z $v || $v =~ ^[0-9]+$ && $v -le 100 ]] || usage "$1 0-100"
        if [[ $1 == bar-opacity ]]; then BAR_OPACITY=$v; set_pref BAR_OPACITY "$v"
        else DOCK_OPACITY=$v; set_pref DOCK_OPACITY "$v"; fi
        apply "$(current)" ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
