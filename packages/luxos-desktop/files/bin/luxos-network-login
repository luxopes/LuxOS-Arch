#!/bin/bash
# LuxOS - prihlaseni do site s portalem (hotel, letiste, vlak, kavarna)
#
#   luxos-network-login [URL [IP]]   otevre prihlasovaci stranku site (spousti luxos-hub pri stavu "portal")
#
# URL a IP posila luxos-hub z luxos-portal-check (portal, ktery NetworkManager neprozna kvuli VPN DNS).
#
# Portal zachyti obycejny pozadavek HTTP a presmeruje ho na svou prihlasovaci stranku. Otevira se
# proto adresa kontroly pripojeni NetworkManageru (http://, jen text) - v siti s portalem misto ni
# prijde stranka portalu. Bezpecnost: jednorazove okno Firefoxu s prazdnym profilem v pameti
# ($XDG_RUNTIME_DIR): nevidi cookies, hesla, historii ani doplnky uzivatele, nic si nepamatuje
# a po zavreni se smaze cele (i se stazenymi soubory). Okno zavre luxos-hub, jakmile je internet.
#
# Okno bezi jen jednou: dalsi spusteni (klik v liste, Ovladaci centrum, upozorneni) jen zvedne
# otevrene okno. Pid je v $XDG_RUNTIME_DIR/luxos-network-login.pid (podle nej okno zavre luxos-hub).
# Bez parametru se adresa portalu vezme ze stavu luxos-hub ($XDG_RUNTIME_DIR/luxos-portal), jinak
# ji zjisti luxos-portal-check. Zavreni okna portal neoznaci jako vyrizeny: znovu otevrit jde vzdy.
set -u

if [[ ${1-} == -h || ${1-} == --help ]]; then
    . /usr/lib/luxos/i18n.sh 2>/dev/null || T() { local f=$1; shift; printf -- "$f" "$@"; }
    printf '%s\n\n%s luxos-network-login [URL [IP]]\n%s\n' \
        "luxos-network-login - $(T "sign in to a network with a login page (hotel, airport, train, coffee shop)")" \
        "$(T "Usage:")" "$(T "Opens the login page in a private browser window that forgets everything when closed.")"
    exit 0
fi

base=${XDG_RUNTIME_DIR:-}
if [[ -n $base && -d $base && -O $base ]]; then
    pidfile=$base/luxos-network-login.pid
else
    base=${TMPDIR:-/tmp}
    pidfile=$base/luxos-network-login-$UID.pid
fi
# Jedine okno: zamek drzi skript i prohlizec (zdedeny popisovac); uz bezici okno jen zvednout
exec 9>>"$pidfile" || exit 1
if ! flock -n 9; then
    wmctrl -x -a luxos-network-login 2>/dev/null
    exit 0
fi
printf '%s\n' "$$" > "$pidfile"

uri=$(gdbus call --system -d org.freedesktop.NetworkManager -o /org/freedesktop/NetworkManager \
        -m org.freedesktop.DBus.Properties.Get org.freedesktop.NetworkManager ConnectivityCheckUri 2>/dev/null |
      sed -n "s/^(<'\(http:\/\/[^' ]*\)'>,)\$/\1/p")
[[ -n $uri ]] || uri=http://ping.archlinux.org/nm-check.txt
force_ip=""
# Spusteno rucne (lista, Ovladaci centrum, Hledani): adresa portalu, kterou nasel luxos-hub,
# jinak ji zjistit stejne jako luxos-hub
if [[ -z ${1-} && -r ${XDG_RUNTIME_DIR:-/nonexistent}/luxos-portal ]]; then
    read -r purl pip < "$XDG_RUNTIME_DIR/luxos-portal"
    [[ ${purl-} == http://* || ${purl-} == https://* ]] && set -- "$purl" "${pip-}"
fi
if [[ -z ${1-} ]] && command -v luxos-portal-check >/dev/null; then
    read -r kind purl pip < <(luxos-portal-check 2>/dev/null)
    [[ $kind == portal && -n $purl ]] && set -- "$purl" "${pip-}"
fi
if [[ ${1-} == http://* || ${1-} == https://* ]]; then
    uri=$1
    host=${uri#*://}; host=${host%%[/:?#]*}
    # Systemove DNS adresu portalu neprelozi (Tailscale/VPN DNS za portalem): prohlizec dostane IP
    # portalu napevno - jen v tomto jednorazovem profilu
    if [[ ${2-} =~ ^[0-9]+(\.[0-9]+){3}$ ]] && ! timeout 3 getent hosts "$host" >/dev/null 2>&1; then
        force_ip=$2
    fi
fi

dir=$(mktemp -d "$base/luxos-network-login.XXXXXX") || exit 1
trap 'rm -rf "$dir"; rm -f "$pidfile"' EXIT
mkdir -m 700 "$dir/downloads"

force_pref=""
[[ -n $force_ip ]] && force_pref="user_pref(\"network.dns.forceResolve\", \"$force_ip\");"
cat > "$dir/user.js" <<P
// LuxOS - jednorazovy profil pro prihlaseni do site (luxos-network-login)
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.newtabpage.enabled", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("app.update.enabled", false);
user_pref("app.normandy.enabled", false);
user_pref("extensions.autoDisableScopes", 15);
user_pref("extensions.enabledScopes", 0);
user_pref("xpinstall.enabled", false);
user_pref("signon.rememberSignons", false);
user_pref("signon.autofillForms", false);
user_pref("extensions.formautofill.addresses.enabled", false);
user_pref("extensions.formautofill.creditCards.enabled", false);
user_pref("places.history.enabled", false);
user_pref("browser.formfill.enable", false);
user_pref("network.captive-portal-service.enabled", false);
user_pref("dom.security.https_only_mode", false);
user_pref("browser.download.useDownloadDir", true);
user_pref("browser.download.dir", "$dir/downloads");
user_pref("browser.download.folderList", 2);
user_pref("geo.enabled", false);
$force_pref
user_pref("media.navigator.enabled", false);
user_pref("dom.webnotifications.enabled", false);
P

firefox --no-remote --new-instance --profile "$dir" --class luxos-network-login --width 960 --height 720 "$uri" &
child=$!
trap 'kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; rm -rf "$dir"; rm -f "$pidfile"' EXIT
trap 'exit 143' TERM INT
wait "$child"
