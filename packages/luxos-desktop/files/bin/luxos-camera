#!/usr/bin/env python3
"""LuxOS - Kamera: fotky a videa z webkamery (ve stylu Photo Booth).

  luxos-camera                 okno s nahledem z kamery

Nahled: v4l2src -> (jpegdec) -> videoflip (zrcadleni) -> tee -> appsink, snimky kresli
cairo do Gtk.DrawingArea (gtksink je v Archu v gst-plugin-gtk, ktery tahne gst-plugins-bad-libs).
Fotky (JPEG) jdou do $(xdg-user-dir PICTURES)/Camera, videa (WebM VP8 + Opus, s x264enc MP4)
do $(xdg-user-dir VIDEOS)/Camera. Nahravani video jen prestavi pipeline s vetvi pro zapis.

Testovani bez kamery: LUXOS_CAMERA_TEST=1 (jedna testovaci kamera videotestsrc), 2 (dve),
none (zadna kamera), busy (kamera obsazena), denied (chybi opravneni).
"""
import fcntl
import glob
import json
import os
import re
import struct
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_i18n import _  # noqa: E402

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gst", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gst, Gtk  # noqa: E402

APP = "luxos-camera"
TEST = os.environ.get("LUXOS_CAMERA_TEST", "").strip().lower()
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxos/camera.json")
MAX_WIDTH = 1280            # vetsi rozliseni zbytecne zatezuje CPU (dekodovani, kresleni, kodovani)
TIMER_SECONDS = 3
VIDIOC_QUERYCAP = 0x80685600   # _IOR('V', 0, struct v4l2_capability), 104 bajtu
V4L2_CAP_VIDEO_CAPTURE = 0x00000001
V4L2_CAP_DEVICE_CAPS = 0x80000000

CSS = b"""
.preview { background-color: black; }
.bar { padding: 10px 16px; border-top: 1px solid alpha(currentColor, 0.10); }
.shutter, .shutter:hover, .shutter:active, .shutter:disabled, .thumb, .thumb:hover {
    background-image: none; background-color: transparent; border: none; box-shadow: none;
    padding: 0; min-width: 0; min-height: 0; }
.mode button { padding: 4px 14px; font-weight: 600; }
.timer { padding: 4px 10px; border-radius: 999px; }
.countdown { color: white; font-size: 140px; font-weight: 800;
             text-shadow: 0 2px 12px alpha(black, 0.6); }
.rec { background-color: alpha(black, 0.55); color: white; border-radius: 999px;
       padding: 4px 14px; margin-top: 14px; font-weight: 700; font-feature-settings: "tnum"; }
.flash { background-color: white; }
.state-title { font-size: 20px; font-weight: 800; }
.dim { opacity: 0.65; }
.code { font-family: monospace; padding: 6px 10px; border-radius: 8px;
        background-color: alpha(currentColor, 0.07); }
.primary { border-radius: 999px; padding: 6px 22px; font-weight: 700; background-image: none;
           background-color: #3d7bff; color: white; border: none; box-shadow: none; }
"""


# ---- pomocne funkce -----------------------------------------------------------------
def load_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        tmp = CONFIG + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=1)
        os.replace(tmp, CONFIG)
    except OSError:
        pass


def user_dir(kind, fallback):
    """Slozka XDG (stejna jako xdg-user-dir) + podslozka Camera."""
    base = GLib.get_user_special_dir(kind)
    home = os.path.expanduser("~")
    if not base or os.path.normpath(base) == os.path.normpath(home):
        base = os.path.join(home, fallback)
    return os.path.join(base, "Camera")


def unique_path(folder, prefix, ext):
    os.makedirs(folder, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d %H.%M.%S")
    path = os.path.join(folder, f"{prefix} {stamp}.{ext}")
    n = 2
    while os.path.exists(path):
        path = os.path.join(folder, f"{prefix} {stamp} ({n}).{ext}")
        n += 1
    return path


def has(element):
    return Gst.ElementFactory.find(element) is not None


def video_nodes():
    return sorted(glob.glob("/dev/video*"), key=lambda p: int(re.sub(r"\D", "", p) or 0))


def scan_devices():
    """Vraci (kamery, pocet uzlu bez opravneni). Kamera = {"path", "name"}."""
    if TEST in ("1", "2", "busy", "denied"):
        n = 2 if TEST == "2" else 1
        return [{"path": f"test:{i}", "name": f"Test Camera {i + 1}"} for i in range(n)], 0
    if TEST == "none":
        return [], 0
    devices, denied = [], 0
    for path in video_nodes():
        try:
            fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        except PermissionError:
            denied += 1
            continue
        except OSError:
            continue
        try:
            buf = bytearray(104)
            fcntl.ioctl(fd, VIDIOC_QUERYCAP, buf)
        except OSError:
            continue
        finally:
            os.close(fd)
        caps, dcaps = struct.unpack_from("<II", buf, 84)
        if not (dcaps if caps & V4L2_CAP_DEVICE_CAPS else caps) & V4L2_CAP_VIDEO_CAPTURE:
            continue   # metadatovy uzel stejne kamery
        name = bytes(buf[16:48]).split(b"\0")[0].decode(errors="replace").strip() or path
        name = name.split(":")[0].strip() or name   # UVC: "Integrated Camera: Integrated C"
        devices.append({"path": path, "name": name})
    seen = {}
    for d in devices:   # stejne nazvy odlisit cislem
        seen[d["name"]] = seen.get(d["name"], 0) + 1
        if seen[d["name"]] > 1:
            d["name"] = f"{d['name']} ({seen[d['name']]})"
    return devices, denied


def _fps(text):
    """Nejvyssi snimkova frekvence <= 30 z popisu struktury caps; (fps, "n/d" nebo None)."""
    m = re.search(r"framerate=\(fraction\)(\{[^}]*\}|\[[^\]]*\]|[0-9/]+)", text)
    if not m:
        return 0, None
    rates = [(int(n), int(d)) for n, d in re.findall(r"(\d+)/(\d+)", m.group(1)) if int(d)]
    if not rates:
        return 0, None
    if m.group(1).startswith("["):     # rozsah - frekvenci necht vyjedna v4l2src
        return min(max(n / d for n, d in rates), 30), None
    low = [r for r in rates if r[0] / r[1] <= 30.5]
    n, d = max(low or rates, key=lambda r: r[0] / r[1])
    return n / d, f"{n}/{d}"


def pick_caps(caps):
    """Z nabidky kamery vybere rozumny format: <= 1280 px, >= 20 fps, raw pred MJPEG."""
    best, best_score = None, None
    for i in range(caps.get_size()):
        s = caps.get_structure(i)
        name = s.get_name()
        if name not in ("video/x-raw", "image/jpeg"):
            continue
        ok_w, w = s.get_int("width")
        ok_h, h = s.get_int("height")
        if not (ok_w and ok_h):
            continue
        fps, rate = _fps(s.to_string())
        small = w <= MAX_WIDTH
        score = (small, fps >= 20, w * h if small else -w * h, name == "video/x-raw", fps)
        if best_score is None or score > best_score:
            text = f"{name},width={w},height={h}"
            if rate:
                text += f",framerate={rate}"
            fmt = s.get_string("format") if name == "video/x-raw" else None
            if fmt:
                text += f",format={fmt}"
            best, best_score = (text, name == "image/jpeg"), score
    return best


def probe_caps(path):
    """Otevre kameru (stav READY) a zjisti nabizene formaty. Vraci (caps, jpeg, chyba)."""
    src = Gst.ElementFactory.make("v4l2src", None)
    if src is None:
        return None, False, "missing"
    src.set_property("device", path)
    try:
        if src.set_state(Gst.State.READY) == Gst.StateChangeReturn.FAILURE:
            return None, False, "open"
        caps = src.get_static_pad("src").query_caps(None)
        picked = pick_caps(caps) if caps else None
    finally:
        src.set_state(Gst.State.NULL)
    if not picked:
        return None, False, None
    return picked[0], picked[1], None


def video_encoder():
    """(enkoder, muxer, pripona, audio enkoder) podle dostupnych pluginu - VP8/WebM je v good."""
    if has("x264enc") and has("mp4mux"):
        audio = next((e for e in ("avenc_aac", "voaacenc", "fdkaacenc", "opusenc") if has(e)), None)
        return ("x264enc tune=zerolatency speed-preset=veryfast bitrate=4000 key-int-max=60 ! "
                "video/x-h264,profile=high,stream-format=avc,alignment=au", "mp4mux", "mp4", audio)
    if has("vp8enc") and has("webmmux"):
        threads = max(1, min(4, (os.cpu_count() or 2) - 1))
        audio = "opusenc" if has("opusenc") else ("vorbisenc" if has("vorbisenc") else None)
        return (f"vp8enc deadline=1 cpu-used=8 threads={threads} end-usage=cbr target-bitrate=3000000 "
                "keyframe-max-dist=60", "webmmux", "webm", audio)
    return None


def audio_source():
    if TEST:
        return "audiotestsrc is-live=true wave=sine volume=0.05" if has("audiotestsrc") else None
    if has("pulsesrc"):            # pipewire-pulse
        return "pulsesrc"
    if has("pipewiresrc"):
        return "pipewiresrc"
    return None


def open_file(path):
    try:
        Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
    except GLib.Error:
        subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def label(text, cls=None, **kw):
    lbl = Gtk.Label(label=text, wrap=kw.pop("wrap", True), justify=Gtk.Justification.CENTER, **kw)
    if cls:
        for c in cls.split():
            lbl.get_style_context().add_class(c)
    return lbl


def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
    cr.arc(x + r, y + r, r, 3.1416, 4.7124)
    cr.close_path()


# ---- okno -------------------------------------------------------------------------
class CameraWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Camera"))
        self.set_default_size(860, 660)
        self.set_size_request(480, 420)
        self.set_icon_name("luxos-camera")
        self.cfg = load_config()
        self.mode = "video" if self.cfg.get("mode") == "video" else "photo"
        self.devices, self.device = [], None
        self.caps_cache = {}
        self.pipeline = None
        self.recording = None        # {"path", "start", "audio"} behem nahravani
        self.stopping = False
        self.frame = None            # (bytes, sirka, vyska) posledniho snimku nahledu
        self.frame_pending = False
        self.frame_lock = threading.Lock()
        self.countdown = 0
        self.countdown_id = None
        self.last_capture = None     # cesta k posledni fotce/videu
        self.thumb = None            # GdkPixbuf
        self.thumb_video = False
        self.nodes = None
        self.state = None

        header = Gtk.HeaderBar(show_close_button=True, title=_("Camera"))
        self.set_titlebar(header)
        self.mirror_btn = Gtk.ToggleButton(tooltip_text=_("Mirror preview"))
        self.mirror_btn.add(Gtk.Image(icon_name="object-flip-horizontal-symbolic"))
        self.mirror_btn.connect("toggled", self.mirror_toggled)
        header.pack_end(self.mirror_btn)
        self.camera_combo = Gtk.ComboBoxText(tooltip_text=_("Choose camera"))
        self.camera_combo.connect("changed", self.camera_changed)
        header.pack_end(self.camera_combo)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # Nahled + prekryvy (odpocet, nahravani, blesk)
        overlay = Gtk.Overlay()
        root.pack_start(overlay, True, True, 0)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=150)
        overlay.add(self.stack)
        self.view = Gtk.DrawingArea()
        self.view.get_style_context().add_class("preview")
        self.view.connect("draw", self.draw_preview)
        self.stack.add_named(self.view, "preview")
        page = self.build_state_page()
        self.stack.add_named(page, "state")
        self.view.show()
        page.show_all()   # Gtk.Stack prepne jen na viditelnou stranku (i pred show_all okna)

        self.count_label = label("", "countdown", halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.count_label.set_no_show_all(True)
        overlay.add_overlay(self.count_label)
        overlay.set_overlay_pass_through(self.count_label, True)
        # Gtk.Box v GTK3 nekresli CSS pozadi - indikator je jeden Gtk.Label
        self.rec_box = label("", "rec", halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        self.rec_box.set_no_show_all(True)
        overlay.add_overlay(self.rec_box)
        overlay.set_overlay_pass_through(self.rec_box, True)
        self.flash = Gtk.EventBox()
        self.flash.get_style_context().add_class("flash")
        self.flash.set_no_show_all(True)
        overlay.add_overlay(self.flash)
        overlay.set_overlay_pass_through(self.flash, True)

        # Spodni lista: posledni snimek | spoust | fotka/video + casovac
        bar = Gtk.Box(spacing=12)
        bar.get_style_context().add_class("bar")
        root.pack_start(bar, False, False, 0)

        self.thumb_btn = Gtk.Button(tooltip_text=_("Open last capture"), relief=Gtk.ReliefStyle.NONE)
        self.thumb_btn.get_style_context().add_class("thumb")
        self.thumb_area = Gtk.DrawingArea()
        self.thumb_area.set_size_request(56, 56)
        self.thumb_area.connect("draw", self.draw_thumb)
        self.thumb_btn.add(self.thumb_area)
        self.thumb_btn.connect("clicked", self.open_last)
        self.thumb_btn.set_valign(Gtk.Align.CENTER)
        bar.pack_start(self.thumb_btn, False, False, 0)

        self.shutter = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
        self.shutter.get_style_context().add_class("shutter")
        self.shutter_area = Gtk.DrawingArea()
        self.shutter_area.set_size_request(68, 68)
        self.shutter_area.connect("draw", self.draw_shutter)
        self.shutter.add(self.shutter_area)
        self.shutter.connect("clicked", self.on_shutter)
        bar.set_center_widget(self.shutter)

        right = Gtk.Box(spacing=10, valign=Gtk.Align.CENTER)
        bar.pack_end(right, False, False, 0)
        self.timer_btn = Gtk.ToggleButton(tooltip_text=_("Take the picture after 3 seconds"))
        self.timer_btn.get_style_context().add_class("timer")
        tb = Gtk.Box(spacing=4)
        tb.pack_start(Gtk.Image(icon_name="alarm-symbolic"), False, False, 0)
        tb.pack_start(Gtk.Label(label="3s"), False, False, 0)
        self.timer_btn.add(tb)
        self.timer_btn.set_active(bool(self.cfg.get("timer")))
        self.timer_btn.connect("toggled", self.timer_toggled)
        modes = Gtk.Box()
        modes.get_style_context().add_class("linked")
        modes.get_style_context().add_class("mode")
        self.photo_btn = Gtk.RadioButton(label=_("Photo"), draw_indicator=False)
        self.video_btn = Gtk.RadioButton(label=_("Video"), group=self.photo_btn, draw_indicator=False)
        (self.video_btn if self.mode == "video" else self.photo_btn).set_active(True)
        self.photo_btn.connect("toggled", self.mode_changed)
        modes.pack_start(self.photo_btn, False, False, 0)
        modes.pack_start(self.video_btn, False, False, 0)
        right.pack_start(self.timer_btn, False, False, 0)
        right.pack_start(modes, False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_close)
        self.load_last_capture()
        self.refresh_devices(start=True)
        GLib.timeout_add_seconds(2, self.watch_devices)

    # ---- stavova stranka ----
    def build_state_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                      halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, margin=30)
        self.state_icon = Gtk.Image(pixel_size=72)
        self.state_icon.get_style_context().add_class("dim")
        self.state_title = label("", "state-title")
        self.state_hint = label("", "dim", max_width_chars=56)
        self.state_code = label("", "code", selectable=True)
        self.state_code.set_no_show_all(True)
        self.state_spinner = Gtk.Spinner(width_request=32, height_request=32)
        self.state_spinner.set_no_show_all(True)
        self.retry_btn = Gtk.Button(label=_("Try Again"), halign=Gtk.Align.CENTER, margin_top=8)
        self.retry_btn.get_style_context().add_class("primary")
        self.retry_btn.set_no_show_all(True)
        self.retry_btn.connect("clicked", lambda _b: self.refresh_devices(start=True, force=True))
        for w in (self.state_icon, self.state_spinner, self.state_title, self.state_hint,
                  self.state_code, self.retry_btn):
            box.pack_start(w, False, False, 0)
        return box

    def show_state(self, state, detail=""):
        """Stavy: starting, none, busy, denied, error."""
        self.state = state
        texts = {
            "starting": ("camera-web-symbolic", _("Starting the camera…"), ""),
            "none": ("camera-disabled-symbolic", _("No camera found"),
                     _("Connect a webcam, or check that the built-in camera is turned on. Some laptops "
                       "have a camera switch, a privacy shutter or a key with a camera symbol.")),
            "busy": ("camera-web-symbolic", _("The camera is being used by another app"),
                     _("Close the other app that uses the camera (a video call, a browser tab…) "
                       "and try again.")),
            "denied": ("changes-prevent-symbolic", _("Camera access is not allowed"),
                       _("Your user account is not allowed to use the camera. Log out and log in "
                         "again; if that does not help, add yourself to the video group and restart:")),
            "error": ("dialog-warning-symbolic", _("The camera could not be started"), detail),
        }
        icon, title, hint = texts.get(state, texts["error"])
        self.state_icon.set_from_icon_name(icon, Gtk.IconSize.DIALOG)
        self.state_icon.set_visible(state != "starting")
        self.state_spinner.set_visible(state == "starting")
        if state == "starting":
            self.state_spinner.start()
        else:
            self.state_spinner.stop()
        self.state_title.set_text(title)
        self.state_hint.set_text(hint)
        self.state_hint.set_visible(bool(hint))
        self.state_code.set_text("sudo usermod -aG video $USER")
        self.state_code.set_visible(state == "denied")
        self.retry_btn.set_visible(state in ("busy", "denied", "error", "none"))
        self.stack.set_visible_child_name("state")
        self.update_controls()
        if self.retry_btn.get_visible():
            self.retry_btn.grab_focus()   # jinak by fokus dostal (a oznacil) prikaz v self.state_code

    # ---- kamery ----
    def watch_devices(self):
        """Pripojeni/odpojeni kamery: kontrola seznamu /dev/video* kazde 2 s."""
        if not TEST and not self.recording:
            nodes = video_nodes()
            if nodes != self.nodes:
                self.refresh_devices(start=self.state in ("none", "denied", "error") or
                                     (self.device and self.device["path"] not in nodes))
        return True

    def refresh_devices(self, start=False, force=False):
        self.nodes = video_nodes()
        devices, denied = scan_devices()
        old = self.device
        self.devices = devices
        self.camera_combo.handler_block_by_func(self.camera_changed)
        self.camera_combo.remove_all()
        for d in devices:
            self.camera_combo.append(d["path"], d["name"])
        wanted = old["path"] if old else self.cfg.get("device")
        self.device = next((d for d in devices if d["path"] == wanted), devices[0] if devices else None)
        if self.device:
            self.camera_combo.set_active_id(self.device["path"])
        self.camera_combo.handler_unblock_by_func(self.camera_changed)
        self.camera_combo.set_visible(len(devices) > 1)
        if not devices:
            self.stop_pipeline()
            self.show_state("denied" if denied or TEST == "denied" else "none")
            return
        if TEST == "denied":
            self.show_state("denied")
            return
        if start or force or (old and old["path"] != self.device["path"]) or not self.pipeline:
            self.start_preview()

    def camera_changed(self, combo):
        path = combo.get_active_id()
        dev = next((d for d in self.devices if d["path"] == path), None)
        if dev and dev != self.device:
            self.device = dev
            self.cfg["device"] = path
            save_config(self.cfg)
            self.start_preview()

    def mirror_default(self):
        name = (self.device or {}).get("name", "").lower()
        rear = any(w in name for w in ("rear", "back", "world"))
        return self.cfg.get("mirror", {}).get(self.device["name"], not rear) if self.device else True

    # ---- pipeline ----
    def stop_pipeline(self):
        if self.pipeline:
            bus = self.pipeline.get_bus()
            bus.remove_signal_watch()
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        with self.frame_lock:
            self.frame = None

    def start_preview(self, record=None):
        """Spusti nahled (a pri record={"path",...} i zapis videa)."""
        self.stop_pipeline()
        if not self.device:
            return
        if TEST == "busy":
            self.show_state("busy")
            return
        if not record:
            self.show_state("starting")
        self.mirror_btn.handler_block_by_func(self.mirror_toggled)
        self.mirror_btn.set_active(self.mirror_default())
        self.mirror_btn.handler_unblock_by_func(self.mirror_toggled)
        dev = self.device
        if dev["path"].startswith("test:") or dev["path"] in self.caps_cache:
            self.build_pipeline(dev, record)
            return

        def work():
            caps, jpeg, err = probe_caps(dev["path"])
            GLib.idle_add(self.probed, dev, record, caps, jpeg, err)
        threading.Thread(target=work, daemon=True).start()

    def probed(self, dev, record, caps, jpeg, err):
        if dev is not self.device:
            return False
        if err == "missing":
            self.show_state("error", _("The GStreamer plugin for cameras (gst-plugins-good) is missing."))
            return False
        if err == "open":
            if not os.access(dev["path"], os.R_OK | os.W_OK):
                self.show_state("denied")
            else:
                self.show_state("busy")
            return False
        self.caps_cache[dev["path"]] = (caps, jpeg)
        self.build_pipeline(dev, record)
        return False

    def build_pipeline(self, dev, record):
        if dev["path"].startswith("test:"):
            pattern = "smpte" if dev["path"] == "test:0" else "ball"
            src = (f"videotestsrc name=src is-live=true pattern={pattern} ! "
                   "video/x-raw,width=1280,height=720,framerate=30/1 ! ")
        else:
            caps, jpeg = self.caps_cache.get(dev["path"], (None, False))
            src = "v4l2src name=src ! " + (f"{caps} ! " if caps else "") + ("jpegdec ! " if jpeg else "")
        desc = (src + "videoconvert ! videoflip name=flip ! tee name=t "
                "t. ! queue leaky=downstream max-size-buffers=2 ! videoconvert ! video/x-raw,format=BGRx ! "
                "appsink name=view sync=false drop=true max-buffers=1 emit-signals=true ")
        if record:
            enc, mux, _ext, aenc = record["encoder"]
            desc += ("t. ! queue leaky=downstream max-size-buffers=0 max-size-bytes=0 max-size-time=3000000000 ! "
                     f"videoconvert ! {enc} ! queue ! {mux} name=mux ! filesink name=out ")
            asrc = audio_source() if record.get("audio", True) else None
            if asrc and aenc:
                desc += (f"{asrc} name=asrc ! queue max-size-time=3000000000 ! audioconvert ! "
                         f"audioresample ! {aenc} ! queue ! mux. ")
                record["audio"] = True
            else:
                record["audio"] = False
        try:
            pipe = Gst.parse_launch(desc)
        except GLib.Error as e:
            self.show_state("error", e.message)
            return
        if not dev["path"].startswith("test:"):
            pipe.get_by_name("src").set_property("device", dev["path"])
        if record:
            pipe.get_by_name("out").set_property("location", record["path"])
        Gst.util_set_object_arg(pipe.get_by_name("flip"), "method",
                                "horizontal-flip" if self.mirror_btn.get_active() else "none")
        pipe.get_by_name("view").connect("new-sample", self.on_frame)
        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self.on_bus)
        self.pipeline = pipe
        self.recording = record
        if pipe.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            pass   # podrobnosti prijdou jako chyba na sbernici
        if record:
            record["start"] = GLib.get_monotonic_time()
            self.rec_box.show()
            self.update_rec_time()
            GLib.timeout_add(500, self.update_rec_time)
        self.update_controls()

    def on_bus(self, bus, msg):
        if not self.pipeline or bus is not self.pipeline.get_bus():
            return
        t = msg.type
        if t == Gst.MessageType.ERROR:
            err, debug = msg.parse_error()
            self.on_error(msg.src, err, debug or "")
        elif t == Gst.MessageType.EOS:
            self.finish_recording()

    def on_error(self, src, err, debug):
        name = src.get_name() if src else ""
        print(f"luxos-camera: {name}: {err.message} ({debug.splitlines()[0] if debug else ''})", file=sys.stderr)
        rec = self.recording
        if rec and (name.startswith("asrc") or "asrc" in (src.get_path_string() if src else "")) \
                and rec.get("audio") and GLib.get_monotonic_time() - rec["start"] < 3_000_000:
            # Mikrofon neni k dispozici: nahrat bez zvuku
            rec["audio"] = False
            self.stop_pipeline()
            try:
                os.unlink(rec["path"])
            except OSError:
                pass
            self.start_preview(record=rec)
            return
        if rec:
            self.abort_recording()
        self.stop_pipeline()
        text = f"{err.message} {debug}".lower()
        if err.matches(Gst.ResourceError.quark(), Gst.ResourceError.BUSY) or "busy" in text:
            self.show_state("busy")
        elif "permission denied" in text:
            self.show_state("denied")
        elif self.device and not self.device["path"].startswith("test:") and not os.path.exists(self.device["path"]):
            self.refresh_devices(start=True)   # kamera odpojena
        else:
            self.show_state("error", err.message)

    def on_frame(self, sink):
        """Streamovaci vlakno: uloz posledni snimek a pozadej o prekresleni."""
        sample = sink.emit("pull-sample")
        if sample is None:
            return Gst.FlowReturn.OK
        s = sample.get_caps().get_structure(0)
        w, h = s.get_int("width")[1], s.get_int("height")[1]
        buf = sample.get_buffer()
        data = buf.extract_dup(0, buf.get_size())
        with self.frame_lock:
            self.frame = (data, w, h)
            if self.frame_pending:
                return Gst.FlowReturn.OK
            self.frame_pending = True
        GLib.idle_add(self.frame_ready)
        return Gst.FlowReturn.OK

    def frame_ready(self):
        with self.frame_lock:
            self.frame_pending = False
        if self.state != "preview" and self.pipeline:
            self.state = "preview"
            self.stack.set_visible_child_name("preview")
            self.update_controls()
        self.view.queue_draw()
        return False

    def draw_preview(self, widget, cr):
        aw, ah = widget.get_allocated_width(), widget.get_allocated_height()
        cr.set_source_rgb(0, 0, 0)
        cr.paint()
        with self.frame_lock:
            frame = self.frame
        if not frame:
            return
        data, w, h = frame
        stride = w * 4
        if len(data) < stride * h:
            return
        surf = cairo.ImageSurface.create_for_data(bytearray(data), cairo.FORMAT_RGB24, w, h, stride)
        scale = min(aw / w, ah / h)
        cr.translate((aw - w * scale) / 2, (ah - h * scale) / 2)
        cr.scale(scale, scale)
        cr.set_source_surface(surf, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD if scale < 1 else cairo.FILTER_BILINEAR)
        cr.paint()

    # ---- ovladani ----
    def live(self):
        return self.pipeline is not None and self.state == "preview"

    def update_controls(self):
        live = self.live()
        busy = bool(self.recording) or self.stopping
        self.shutter.set_sensitive((live or busy) and not self.stopping)
        self.photo_btn.set_sensitive(not busy and not self.countdown)
        self.video_btn.set_sensitive(not busy and not self.countdown)
        self.camera_combo.set_sensitive(not busy and not self.countdown)
        self.mirror_btn.set_sensitive(live and not busy)
        if self.recording:
            self.shutter.set_tooltip_text(_("Stop recording"))
        elif self.mode == "video":
            self.shutter.set_tooltip_text(_("Start recording"))
        else:
            self.shutter.set_tooltip_text(_("Take Photo"))
        self.shutter_area.queue_draw()

    def mode_changed(self, _b):
        self.mode = "photo" if self.photo_btn.get_active() else "video"
        self.cfg["mode"] = self.mode
        save_config(self.cfg)
        self.update_controls()

    def timer_toggled(self, btn):
        self.cfg["timer"] = btn.get_active()
        save_config(self.cfg)

    def mirror_toggled(self, btn):
        if self.pipeline:
            Gst.util_set_object_arg(self.pipeline.get_by_name("flip"), "method",
                                    "horizontal-flip" if btn.get_active() else "none")
        if self.device:
            self.cfg.setdefault("mirror", {})[self.device["name"]] = btn.get_active()
            save_config(self.cfg)

    def on_key(self, _w, event):
        key = event.keyval
        if key in (Gdk.KEY_space, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self.shutter.get_sensitive():
                self.on_shutter(None)
            return True
        if key == Gdk.KEY_Escape and self.countdown:
            self.cancel_countdown()
            return True
        return False

    def on_shutter(self, _b):
        if self.recording:
            self.stop_recording()
            return
        if self.countdown:
            self.cancel_countdown()
            return
        if not self.live():
            return
        if self.timer_btn.get_active():
            self.countdown = TIMER_SECONDS
            self.count_label.set_text(str(self.countdown))
            self.count_label.show()
            self.countdown_id = GLib.timeout_add(1000, self.tick)
            self.update_controls()
        else:
            self.fire()

    def tick(self):
        self.countdown -= 1
        if self.countdown > 0:
            self.count_label.set_text(str(self.countdown))
            return True
        self.countdown_id = None
        self.count_label.hide()
        self.update_controls()
        if self.live():
            self.fire()
        return False

    def cancel_countdown(self):
        if self.countdown_id:
            GLib.source_remove(self.countdown_id)
        self.countdown_id = None
        self.countdown = 0
        self.count_label.hide()
        self.update_controls()

    def fire(self):
        if self.mode == "photo":
            self.take_photo()
        else:
            self.start_recording()

    # ---- fotka ----
    def frame_pixbuf(self):
        """Posledni snimek nahledu (uz zrcadleny jako v okne) jako GdkPixbuf."""
        with self.frame_lock:
            frame = self.frame
        if not frame:
            return None
        data, w, h = frame
        if len(data) < w * 4 * h:
            return None
        surf = cairo.ImageSurface.create_for_data(bytearray(data), cairo.FORMAT_RGB24, w, h, w * 4)
        return Gdk.pixbuf_get_from_surface(surf, 0, 0, w, h)

    def take_photo(self):
        pix = self.frame_pixbuf()
        self.do_flash()
        if pix is None:
            self.toast(_("The photo could not be taken."))
            return
        folder = user_dir(GLib.UserDirectory.DIRECTORY_PICTURES, "Pictures")
        prefix = _("Photo")

        def work():
            try:
                path = unique_path(folder, prefix, "jpg")
                pix.savev(path, "jpeg", ["quality"], ["92"])
                GLib.idle_add(self.photo_done, path, pix, None)
            except (OSError, GLib.Error) as e:
                GLib.idle_add(self.photo_done, None, None, getattr(e, "strerror", None) or e.message)
        threading.Thread(target=work, daemon=True).start()

    def photo_done(self, path, pix, err):
        if err:
            self.toast(_("The photo could not be saved: %s") % err)
        else:
            self.set_thumb(path, pix, video=False)
        return False

    def do_flash(self):
        self.flash.set_opacity(1.0)
        self.flash.show()
        start = GLib.get_monotonic_time()

        def step():
            t = (GLib.get_monotonic_time() - start) / 350_000
            if t >= 1:
                self.flash.hide()
                return False
            self.flash.set_opacity(1 - t * t)
            return True
        GLib.timeout_add(16, step)

    # ---- video ----
    def start_recording(self):
        enc = video_encoder()
        if not enc:
            self.toast(_("No video encoder is installed (gst-plugins-good)."))
            return
        try:
            path = unique_path(user_dir(GLib.UserDirectory.DIRECTORY_VIDEOS, "Videos"), _("Video"), enc[2])
        except OSError as e:
            self.toast(_("The video could not be saved: %s") % e.strerror)
            return
        self.do_flash()
        self.start_preview(record={"path": path, "encoder": enc})

    def update_rec_time(self):
        if not self.recording or "start" not in self.recording:
            return False
        sec = int((GLib.get_monotonic_time() - self.recording["start"]) / 1_000_000)
        self.rec_box.set_markup(f'<span color="#ff3b30">●</span>  {sec // 60}:{sec % 60:02d}')
        return True

    def stop_recording(self):
        if not self.recording or self.stopping:
            return
        self.stopping = True
        self.update_controls()
        # Nahled videa = posledni snimek; EOS necha muxer dopsat soubor
        self.recording["thumb"] = self.frame_pixbuf()
        pipe = self.pipeline
        pipe.send_event(Gst.Event.new_eos())
        GLib.timeout_add_seconds(5, lambda: self.finish_recording()
                                if self.pipeline is pipe and self.stopping else False)

    def finish_recording(self):
        rec = self.recording
        self.stop_pipeline()
        self.recording = None
        self.stopping = False
        self.rec_box.hide()
        if rec and os.path.exists(rec["path"]) and os.path.getsize(rec["path"]) > 0:
            self.set_thumb(rec["path"], rec.get("thumb"), video=True)
        self.start_preview()
        return False

    def abort_recording(self):
        self.recording = None
        self.stopping = False
        self.rec_box.hide()

    # ---- posledni snimek ----
    def load_last_capture(self):
        files = []
        for folder in (user_dir(GLib.UserDirectory.DIRECTORY_PICTURES, "Pictures"),
                       user_dir(GLib.UserDirectory.DIRECTORY_VIDEOS, "Videos")):
            for p in glob.glob(os.path.join(glob.escape(folder), "*")):
                if p.lower().endswith((".jpg", ".jpeg", ".png", ".webm", ".mp4", ".mkv")):
                    files.append(p)
        if files:
            path = max(files, key=lambda p: os.path.getmtime(p))
            self.set_thumb(path, None, video=not path.lower().endswith((".jpg", ".jpeg", ".png")))
        else:
            self.thumb_btn.set_sensitive(False)

    def set_thumb(self, path, pix, video):
        self.last_capture = path
        self.thumb_video = video
        if pix is None and not video:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 160, 160, True)
            except GLib.Error:
                pix = None
        if pix:
            s = 112 / min(pix.get_width(), pix.get_height())
            pix = pix.scale_simple(max(1, int(pix.get_width() * s)), max(1, int(pix.get_height() * s)),
                                   GdkPixbuf.InterpType.BILINEAR)
        self.thumb = pix
        self.thumb_btn.set_sensitive(True)
        self.thumb_area.queue_draw()

    def open_last(self, _b):
        if self.last_capture and os.path.exists(self.last_capture):
            open_file(self.last_capture)

    def draw_thumb(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        fg = widget.get_style_context().get_color(widget.get_state_flags())
        rounded(cr, 1, 1, w - 2, h - 2, 10)
        cr.save()
        cr.clip_preserve()
        if self.thumb:
            tw, th = self.thumb.get_width() / 2, self.thumb.get_height() / 2
            cr.translate((w - tw) / 2, (h - th) / 2)
            cr.scale(0.5, 0.5)
            Gdk.cairo_set_source_pixbuf(cr, self.thumb, 0, 0)
            cr.paint()
        else:
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.08)
            cr.paint()
        cr.restore()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.18)
        cr.set_line_width(1)
        cr.stroke()
        if self.thumb_video and self.last_capture:
            # Znacka videa: trojuhelnik v kolecku
            cr.arc(w / 2, h / 2, 12, 0, 6.2832)
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.fill()
            cr.move_to(w / 2 - 4, h / 2 - 6)
            cr.line_to(w / 2 + 7, h / 2)
            cr.line_to(w / 2 - 4, h / 2 + 6)
            cr.close_path()
            cr.set_source_rgb(1, 1, 1)
            cr.fill()

    def draw_shutter(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 3
        fg = widget.get_style_context().get_color(widget.get_state_flags())
        alpha = 1.0 if self.shutter.get_sensitive() else 0.4
        cr.arc(cx, cy, r, 0, 6.2832)
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.85 * alpha)
        cr.set_line_width(4)
        cr.stroke()
        if self.recording:
            s = r * 0.8
            rounded(cr, cx - s / 2, cy - s / 2, s, s, 6)
            cr.set_source_rgba(1, 0.23, 0.19, alpha)
            cr.fill()
            return
        cr.arc(cx, cy, r - 6, 0, 6.2832)
        if self.mode == "video":
            cr.set_source_rgba(1, 0.23, 0.19, alpha)
            cr.fill()
        else:
            cr.set_source_rgba(1, 1, 1, alpha)
            cr.fill_preserve()
            cr.set_source_rgba(0, 0, 0, 0.15 * alpha)
            cr.set_line_width(1)
            cr.stroke()

    def toast(self, text):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.OK, text=text)
        dlg.run()
        dlg.destroy()

    def on_close(self, *_a):
        """Rozpracovane video dokoncit (EOS), jinak by soubor nesel prehrat."""
        if self.recording and self.pipeline:
            self.pipeline.send_event(Gst.Event.new_eos())
            self.pipeline.get_bus().timed_pop_filtered(5 * Gst.SECOND,
                                                       Gst.MessageType.EOS | Gst.MessageType.ERROR)
        self.stop_pipeline()
        return False


def main():
    GLib.set_prgname(APP)
    Gst.init(None)
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = CameraWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.camera_combo.set_visible(len(win.devices) > 1)
    win.shutter.grab_focus()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
