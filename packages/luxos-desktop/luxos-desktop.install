_luxos_dconf() {
    dconf update 2>/dev/null || true
    fc-cache -s >/dev/null 2>&1 || true
}
# Relace "LuxOS" misto "xfce" (i u starsich instalaci s automatickym prihlasenim)
_luxos_session() {
    rm -f /usr/share/xsessions/xfce.desktop
    sed -i 's/^autologin-session=xfce$/autologin-session=luxos/' /etc/lightdm/lightdm.conf.d/*.conf 2>/dev/null || true
}
# Prepinani rozlozeni: stare vychozi Alt+Shift (nahodne selhavalo) -> obe klavesy Shift.
# Jen presne stare vychozi a jen jednou (znacka /var/lib/luxos/keyboard-switch-migrated);
# vlastni volbu nemeni. Projevi se pri dalsim prihlaseni (novy start X).
_luxos_keyboard() {
    python3 -c 'import sys; sys.path.insert(0, "/usr/lib/luxos/python")
import luxos_keyboard as k
k.migrate_default_switch() and print("==> Keyboard layouts now switch with both Shift keys (from the next login).")' \
        2>/dev/null || true
}
# Zamek obrazovky: heslo hned po spusteni sporice. Stare vychozi bylo 1 minuta - sporic po Enteru
# pustil na plochu bez hesla. Bezicim relacim se nastavi hned (bez prihlaseni), jen uzivatelum, kteri
# si dobu sami nezvolili (v jejich xfconf neni vlastni hodnota delay).
_luxos_lock_now() {
    local bus uid user xml
    for bus in /run/user/[0-9]*/bus; do
        [[ -S $bus ]] || continue
        uid=${bus#/run/user/}; uid=${uid%/bus}
        user=$(getent passwd "$uid" | cut -d: -f1)
        [[ -n $user ]] || continue
        xml=$(getent passwd "$uid" | cut -d: -f6)/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-screensaver.xml
        if [[ -f $xml ]] && python3 - "$xml" <<'PY' 2>/dev/null; then continue; fi
import sys, xml.etree.ElementTree as ET
sa = ET.parse(sys.argv[1]).getroot().find("./property[@name='lock']/property[@name='saver-activation']/property[@name='delay']")
sys.exit(0 if sa is not None and sa.get("value") is not None else 1)
PY
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            timeout 5 xfconf-query -c xfce4-screensaver -p /lock/saver-activation/delay -n -t int -s 0 \
            >/dev/null 2>&1 || true
    done
}
# Pojistka proti fork bombe (luxos-forkguard.service, zapnuta staticky): spustit hned, bez restartu.
# Po aktualizaci restart - nova verze programu.
_luxos_forkguard() {
    [ -d /run/systemd/system ] || return 0
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl restart luxos-forkguard.service >/dev/null 2>&1 || true
}
post_install() { _luxos_dconf; _luxos_session; _luxos_keyboard; _luxos_forkguard; }
post_upgrade() { _luxos_dconf; _luxos_session; _luxos_keyboard; _luxos_lock_now; _luxos_forkguard; }
# Otisk prstu: pred odinstalaci vratit PAM sluzby do puvodni podoby (hook uz pak nepobezi)
pre_remove() { /usr/lib/luxos/luxos-fingerprint-pam remove || true; }
