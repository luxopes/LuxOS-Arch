_luxos_dconf() {
    dconf update 2>/dev/null || true
    fc-cache -s >/dev/null 2>&1 || true
}
# Relace "LuxOS" misto "xfce" (i u starsich instalaci s automatickym prihlasenim)
_luxos_session() {
    rm -f /usr/share/xsessions/xfce.desktop
    sed -i 's/^autologin-session=xfce$/autologin-session=luxos/' /etc/lightdm/lightdm.conf.d/*.conf 2>/dev/null || true
}
# Prepinani rozlozeni: stare vychozi Alt+Shift (nahodne selhavalo) -> obe klavesy Shift.
# Jen presne stare vychozi a jen jednou (znacka /var/lib/luxos/keyboard-switch-migrated);
# vlastni volbu nemeni. Projevi se pri dalsim prihlaseni (novy start X).
_luxos_keyboard() {
    python3 -c 'import sys; sys.path.insert(0, "/usr/lib/luxos/python")
import luxos_keyboard as k
k.migrate_default_switch() and print("==> Keyboard layouts now switch with both Shift keys (from the next login).")' \
        2>/dev/null || true
}
# Zamek obrazovky: heslo hned po spusteni sporice. Stare vychozi bylo 1 minuta - sporic po Enteru
# pustil na plochu bez hesla. Bezicim relacim se nastavi hned (bez prihlaseni), jen uzivatelum, kteri
# si dobu sami nezvolili (v jejich xfconf neni vlastni hodnota delay).
_luxos_lock_now() {
    local bus uid user xml
    for bus in /run/user/[0-9]*/bus; do
        [[ -S $bus ]] || continue
        uid=${bus#/run/user/}; uid=${uid%/bus}
        user=$(getent passwd "$uid" | cut -d: -f1)
        [[ -n $user ]] || continue
        xml=$(getent passwd "$uid" | cut -d: -f6)/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-screensaver.xml
        if [[ -f $xml ]] && python3 - "$xml" <<'PY' 2>/dev/null; then continue; fi
import sys, xml.etree.ElementTree as ET
sa = ET.parse(sys.argv[1]).getroot().find("./property[@name='lock']/property[@name='saver-activation']/property[@name='delay']")
sys.exit(0 if sa is not None and sa.get("value") is not None else 1)
PY
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            timeout 5 xfconf-query -c xfce4-screensaver -p /lock/saver-activation/delay -n -t int -s 0 \
            || true
    done
}
# Dock: Sporic baterie do 1.0.x vypinal zvetsovani ikon ("nekdy se nezvetsuji"). Bezicim relacim
# se puvodni hodnota vrati hned (bez prihlaseni); kde neni ulozena, nic se nemeni.
_luxos_dock_zoom() {
    local bus uid user home run=${LUXOS_SYSROOT:-}/run/user     # LUXOS_SYSROOT jen pro testy
    for bus in "$run"/[0-9]*/bus; do
        [[ -S $bus ]] || continue
        uid=${bus#"$run"/}; uid=${uid%/bus}
        user=$(getent passwd "$uid" | cut -d: -f1)
        home=$(getent passwd "$uid" | cut -d: -f6)
        [[ -n $user && -n $home ]] || continue
        grep -qs '^dock-zoom=' "$home/.config/luxos/powersaver.saved" || [[ -f $home/.config/luxos/dock-zoom ]] || continue
        runuser -u "$user" -- env -u XDG_CONFIG_HOME HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" timeout 5 luxos-powersaver restore-zoom \
            >/dev/null 2>&1 || true
    done
}
# Pojistka proti fork bombe (luxos-forkguard.service, zapnuta staticky): spustit hned, bez restartu.
# Po aktualizaci restart - nova verze programu.
_luxos_forkguard() {
    [ -d /run/systemd/system ] || return 0
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl restart luxos-forkguard.service >/dev/null 2>&1 || true
}
# Pristup k obrazovce i po zmene nazvu pocitace: bezicim relacim hned (bez odhlaseni) polozka FamilyWild
# v ~/.Xauthority - i relaci, ktere uz nazev zmenily a nove programy nespusti (overi se, ktery cookie
# X server prijima). Cookie nikdy neprochazi argumenty ani vystupem.
_luxos_xauth_now() {
    local pid uid user home env d xa proc=/proc
    for pid in $(pgrep -x xfce4-session 2>/dev/null); do
        uid=$(stat -c %u "$proc/$pid" 2>/dev/null) || continue
        [[ $uid != 0 ]] || continue
        user=$(getent passwd "$uid" | cut -d: -f1)
        home=$(getent passwd "$uid" | cut -d: -f6)
        [[ -n $user && -n $home ]] || continue
        env=$(tr '\0' '\n' <"$proc/$pid/environ" 2>/dev/null) || continue
        d=$(sed -n 's/^DISPLAY=//p' <<<"$env" | head -1)
        xa=$(sed -n 's/^XAUTHORITY=//p' <<<"$env" | head -1)
        [[ -n $d ]] || continue
        runuser -u "$user" -- env DISPLAY="$d" XAUTHORITY="${xa:-$home/.Xauthority}" HOME="$home" \
            XDG_RUNTIME_DIR="/run/user/$uid" timeout 15 /usr/lib/luxos/luxos-xauth-wildcard >/dev/null 2>&1 || true
    done
}
# Dotykova obrazovka: demon gest Touchegg hned, bez restartu (pri startu ho spusti udev pravidlo
# 70-luxos-touch.rules); bez dotykove obrazovky nic
_luxos_touch() {
    [ -d /run/systemd/system ] || return 0
    grep -qsx 'E:ID_INPUT_TOUCHSCREEN=1' /run/udev/data/c13:* || return 0
    udevadm control --reload >/dev/null 2>&1 || true
    systemctl start touchegg.service >/dev/null 2>&1 || true
}
post_install() { _luxos_dconf; _luxos_session; _luxos_keyboard; _luxos_forkguard; _luxos_touch; }
post_upgrade() { _luxos_dconf; _luxos_session; _luxos_keyboard; _luxos_lock_now; _luxos_dock_zoom; _luxos_forkguard; _luxos_xauth_now; _luxos_touch; }
# Otisk prstu: pred odinstalaci vratit PAM sluzby do puvodni podoby (hook uz pak nepobezi)
pre_remove() { /usr/lib/luxos/luxos-fingerprint-pam remove || true; }
