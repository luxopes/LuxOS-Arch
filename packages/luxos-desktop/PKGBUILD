# Maintainer: LuxOS Team
# Desktop LuxOS: XFCE upravene do podoby macOS + vybrane lehke aplikace.

pkgname=luxos-desktop
pkgver=1.1.0
pkgrel=39
pkgdesc="LuxOS macOS-like desktop (Xfce, Plank dock, Search, Launchpad) and default apps"
arch=(x86_64)
# !strip: programy v LSL (dynamicky linkovane ELF cile linux-x86_64-gnu) po strip nejdou spustit
# ("exec format error"); programy a knihovny z C se zmensi rucne v build()
options=(!debug !strip)
url="https://github.com/luxopes/LuxOS-Arch"
license=(GPL-3.0-or-later)
# lsl >= 0.10.6: prekladac lslc s moduly glib/gio/gtk/cairo/pango (cil linux-x86_64-gnu) pro programy v files/lsl;
# balik z [luxos-apps] (packages/apps/lsl), container-build.sh ho do kontejneru nainstaluje z tohoto sestaveni
makedepends=(python xfce4-settings xfce4-session libxi libxtst libxrandr libxfixes gtk3 cairo pango pkgconf 'lsl>=0.10.6')
install=luxos-desktop.install
depends=(
    # LuxOS
    luxos-branding luxos-themes luxos-shell luxos-tweaks luxos-drivers lux
    # Obrazky a ikony v procesu aplikace (gdk-pixbuf2 z [luxos] bez glycinu + zavadece SVG a WebP)
    gdk-pixbuf2 luxos-pixbuf-svg webp-pixbuf-loader
    # Graficky server a vstup
    xorg-server xorg-xrandr xorg-xinput xorg-xset xf86-input-libinput mesa
    # Xfce (jen potrebne casti)
    xfce4-session xfwm4 xfce4-panel xfdesktop xfce4-settings xfconf xfce4-notifyd
    xfce4-power-manager xfce4-screensaver xfce4-terminal ffmpeg xfce4-taskmanager
    xfce4-whiskermenu-plugin xfce4-genmon-plugin xfce4-pulseaudio-plugin xfce4-xkb-plugin
    xfce4-cpugraph-plugin  # graf vytizeni CPU (jde pridat do listy, ve vychozi liste neni)
    xorg-setxkbmap xorg-xprop libxi libxtst libxrandr
    brightnessctl luxos-i18n luxos-store luxos-account
    # Lux Guard: kontrola stazenych programu a snimky /home (i u starsich instalaci pres lux update)
    luxos-guard
    # LuxOS Care: aktualizace, zalozni jadro a prechod na jadro LuxOS (starsi instalace ho nemely)
    luxos-care
    # Zvuk s prioritou v realnem case (PipeWire bez praskani pri zatezi) a pravidla Wi-Fi podle
    # zeme (bez regulatory.db jen omezene kanaly a vykon)
    rtkit wireless-regdb
    # Snimek obrazovky: obrazek ve schrance drzi xclip i po skonceni programu
    xclip
    thunar thunar-volman thunar-archive-plugin thunar-media-tags-plugin tumbler ffmpegthumbnailer poppler-glib
    # Dock, Hledani, prihlaseni
    # rofi z [luxos]: Launchpad potrebuje -hover-no-scroll (packages/rofi)
    plank 'rofi>=2.0.0-1.1' lightdm lightdm-gtk-greeter dconf yad
    # Zvuk, sit, bluetooth, tisk
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber pavucontrol
    networkmanager network-manager-applet nm-connection-editor
    bluez bluez-utils blueman
    luxos-printing cups cups-pdf system-config-printer ipp-usb sane-airscan avahi nss-mdns
    # Integrace systemu
    polkit-gnome gnome-keyring xdg-user-dirs xdg-utils xdg-desktop-portal-gtk
    gvfs gvfs-mtp gvfs-smb gvfs-gphoto2 udisks2 upower power-profiles-daemon
    # Pisma
    inter-font noto-fonts noto-fonts-emoji ttf-liberation ttf-jetbrains-mono-nerd
    # Aplikace
    firefox mousepad ristretto evince xarchiver 7zip unzip zip celluloid python-gobject python-cairo libwnck3 upower libnotify wmctrl
    # Kamera (luxos-camera): v4l2src, jpegdec, videoflip, vp8enc/webmmux, pulsesrc (good); opusenc (base)
    gstreamer gst-plugins-base gst-plugins-good
    # Nastroje
    lshw pciutils usbutils
)
# fprintd instaluje luxos-drivers jen pri nalezene ctecce (luxos-hwdetect)
optdepends=('fprintd: log in with a fingerprint (Fingerprint settings)')

build() {
    # Prepinani nabidek horni listy jednim klikem
    gcc $CFLAGS $LDFLAGS -o luxos-menubar "$startdir/files/src/luxos-menubar.c" -lX11 -lXi -lXtst -lXrandr
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-rgba-menus.so "$startdir/files/src/luxos-rgba-menus.c" \
        $(pkg-config --cflags --libs gtk+-3.0)
    # Zamykaci obrazovka: bez prazdne informacni listy (cerny pruh dole) po probuzeni
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-lock-fix.so "$startdir/files/src/luxos-lock-fix.c" \
        $(pkg-config --cflags --libs gtk+-3.0)
    # Cerne zakryti obrazovky pri odhlaseni a vypnuti (spousti luxos-hub), s --login prechod po prihlaseni
    gcc $CFLAGS $LDFLAGS -o luxos-session-cover "$startdir/files/src/luxos-session-cover.c" -lX11 -lXfixes
    # Kontextove nabidky horni listy bez sedeho nazvu pluginu
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-panel-menus.so "$startdir/files/src/luxos-panel-menus.c" \
        $(pkg-config --cflags --libs gtk+-3.0)
    strip --strip-all luxos-menubar luxos-session-cover
    strip --strip-unneeded libluxos-rgba-menus.so libluxos-lock-fix.so libluxos-panel-menus.so

    # Casto spoustene programy horni listy v LSL (files/lsl, viz docs/perf/lsl-rewrite-plan.md):
    # hodiny kazde 3 s, baterie kazdych 20 s, nazev aplikace pri kazdem prepnuti okna, prepinace
    # po kliknuti. Cil linux-x86_64-gnu: dynamicky linkovane nad glibc a GLib/GIO (D-Bus) stroje.
    local p
    for p in luxos-clock luxos-battery luxos-netcheck luxos-cc-toggle luxos-calendar-toggle luxos-appname; do
        lslc --target linux-x86_64-gnu "$startdir/files/lsl/$p.lsl" "$p"
    done
    # Proces relace luxos-hub s okny Ovladaciho centra a Kalendare (drive tri programy v Pythonu + GTK):
    # jeden program, pod jmeny luxos-control-center a luxos-calendar jen posila signal bezicimu hubu
    lslc --target linux-x86_64-gnu "$startdir/files/lsl/luxos-hub.lsl" luxos-hub
}

package() {
    local f="$startdir/files"

    # Vychozi nastaveni v samostatnem XDG adresari (ma prednost pred /etc/xdg)
    install -dm755 "$pkgdir/etc/xdg/luxos"
    cp -r --no-preserve=ownership "$f/xdg/." "$pkgdir/etc/xdg/luxos/"
    # Kanaly xfconf sloucit s vychozimi soubory Xfce (jinak by je nahradily cele)
    python3 "$f/merge-xfconf.py" /etc/xdg/xfce4/xfconf/xfce-perchannel-xml \
        "$f/xdg/xfce4/xfconf/xfce-perchannel-xml" "$pkgdir/etc/xdg/luxos/xfce4/xfconf/xfce-perchannel-xml"

    install -Dm755 -t "$pkgdir/usr/bin" "$f"/bin/* luxos-menubar luxos-session-cover \
        luxos-clock luxos-battery luxos-netcheck luxos-cc-toggle luxos-calendar-toggle luxos-appname luxos-hub
    # Ovladaci centrum a Kalendar jsou tentyz program (chova se podle jmena); profily panelu uzivatelu
    # volaji "luxos-control-center --panel", relace "luxos-hub"
    ln -s luxos-hub "$pkgdir/usr/bin/luxos-control-center"
    ln -s luxos-hub "$pkgdir/usr/bin/luxos-calendar"
    ln -s luxos-search "$pkgdir/usr/bin/luxos-spotlight"   # starsi zkratky v xfconf
    # Sledovani aktivniho okna (bash, xprop -spy) pro "luxos-appname watch"
    install -Dm755 "$f/luxos-appname-watch" "$pkgdir/usr/lib/luxos/luxos-appname-watch"
    install -Dm644 -t "$pkgdir/usr/lib/luxos/python" "$f"/python/*.py
    # Predkompilovany bajtkod: uzivatel do /usr nezapisuje, jinak by se moduly prekladaly pri kazdem startu
    # (checked-hash: platnost podle obsahu, ne casu souboru - makepkg casy prepisuje)
    python -m compileall -q --invalidation-mode checked-hash -s "$pkgdir" -p / "$pkgdir/usr/lib/luxos/python"
    # Setric obrazovky: xfce4-screensaver spousti jen programy ze sve slozky
    install -Dm755 "$f/screensaver/luxos-screensaver" "$pkgdir/usr/lib/xfce4-screensaver/luxos"
    install -Dm644 -t "$pkgdir/usr/share/applications/screensavers" "$f"/screensaver/*.desktop
    install -Dm755 -t "$pkgdir/usr/lib/luxos/override-bin" "$f"/override-bin/*
    install -Dm644 -t "$pkgdir/usr/share/applications" "$f"/applications/*.desktop
    # Monitory i v Launchpadu (ten skryva panely Nastaveni); OnlyShowIn ji skryje v menu a Hledani
    sed -e 's/^Categories=.*/Categories=X-LuxOS-Launchpad;/' -e '/^\[Desktop Entry\]/a OnlyShowIn=X-LuxOS-Launchpad;' \
        "$f/applications/luxos-display-settings.desktop" > "$pkgdir/usr/share/applications/luxos-display-settings-launchpad.desktop"
    # Klavesnice (rozlozeni pro cely system) take v Launchpadu
    sed -e 's/^Categories=.*/Categories=X-LuxOS-Launchpad;/' -e '/^\[Desktop Entry\]/a OnlyShowIn=X-LuxOS-Launchpad;' \
        "$f/applications/luxos-keyboard.desktop" > "$pkgdir/usr/share/applications/luxos-keyboard-launchpad.desktop"
    install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" "$f"/icons/*.svg
    install -Dm644 -t "$pkgdir/usr/share/rofi/themes" "$f"/rofi/luxos-*.rasi

    # Pluginy horni listy bez nabidek (genmon, systray) bezi primo v procesu panelu - kazdy
    # externi plugin je dalsi proces (~12 MB). Panel cte <prefix>/share/xfce4/panel/plugins
    # z XDG_DATA_DIRS (viz /etc/profile.d/luxos.sh) a moduly bere z <prefix>/lib/xfce4/panel/plugins.
    # Pluginy s nabidkami zustavaji externi: luxos-menubar je rozlisuje podle X klienta.
    local pp="$pkgdir/usr/lib/luxos/panel" m
    install -Dm644 -t "$pp/share/xfce4/panel/plugins" "$f"/panel-plugins/*.desktop
    install -dm755 "$pp/lib/xfce4/panel/plugins"
    for m in genmon systray; do
        ln -s "/usr/lib/xfce4/panel/plugins/lib$m.so" "$pp/lib/xfce4/panel/plugins/lib$m.so"
    done
    install -Dm644 "$f/rofi/config.rasi" "$pkgdir/etc/rofi.rasi"   # system-wide config rofi 2.x

    # Kratke nazvy aplikaci (hook spravce baliku prepise .desktop do /var/lib/luxos/apps)
    install -Dm644 "$f/apps/rename.conf" "$pkgdir/usr/share/luxos/apps/rename.conf"
    install -Dm755 "$f/apps/luxos-apps-sync" "$pkgdir/usr/lib/luxos/luxos-apps-sync"
    install -Dm644 "$f/hooks/luxos-apps.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-apps.hook"
    # Prihlasovaci relace "LuxOS" misto "Xfce Session" (hook odstrani xfce.desktop z xfce4-session)
    install -Dm644 "$f/xsessions/luxos.desktop" "$pkgdir/usr/share/xsessions/luxos.desktop"
    install -Dm644 "$f/hooks/luxos-xsession.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-xsession.hook"

    # Otisk prstu: pam_fprintd v LightDM/sudo/polkit/zamku (hook po instalaci fprintd a aktualizacich
    # dotcenych baliku), soubor pro greeter "jen heslo" a kopie panelu pro Launchpad
    install -Dm755 "$f/fingerprint/luxos-fingerprint-pam" "$pkgdir/usr/lib/luxos/luxos-fingerprint-pam"
    install -Dm644 "$f/fingerprint/luxos-fingerprint.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-fingerprint.hook"
    install -Dm644 "$f/fingerprint/luxos-fingerprint.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/luxos-fingerprint.conf"
    sed -e 's/^Categories=.*/Categories=X-LuxOS-Launchpad;/' -e '/^\[Desktop Entry\]/a OnlyShowIn=X-LuxOS-Launchpad;' \
        "$f/applications/luxos-fingerprint.desktop" > "$pkgdir/usr/share/applications/luxos-fingerprint-launchpad.desktop"

    # Skryte technicke aplikace (prekryti pres XDG_DATA_DIRS, viz /etc/profile.d/luxos.sh)
    local a
    install -dm755 "$pkgdir/usr/share/luxos/xdg/applications"
    while read -r a; do
        [[ -n $a ]] && printf '[Desktop Entry]\nType=Application\nName=%s\nNoDisplay=true\n' "$a" \
            > "$pkgdir/usr/share/luxos/xdg/applications/$a.desktop"
    done < "$f/hide/apps"

    install -dm755 "$pkgdir/etc/skel"
    cp -r --no-preserve=ownership "$f/skel/." "$pkgdir/etc/skel/"

    install -Dm644 "$f/dconf/user-profile" "$pkgdir/etc/dconf/profile/user"
    install -Dm644 "$f/dconf/10-luxos" "$pkgdir/etc/dconf/db/local.d/10-luxos"

    install -Dm644 "$f/lightdm/50-luxos.conf" "$pkgdir/etc/lightdm/lightdm.conf.d/50-luxos.conf"
    # Prechod po prihlaseni: posledni snimek prihlaseni zakryje skladani plochy (luxos-session-cover --login)
    install -Dm755 "$f/xinit/60-luxos-login-cover.sh" "$pkgdir/etc/X11/xinit/xinitrc.d/60-luxos-login-cover.sh"
    install -Dm755 -t "$pkgdir/usr/lib/luxos/lightdm" "$f/lightdm/luxos-greeter-setup" "$f/lightdm/luxos-session-setup" \
        "$f/lightdm/luxos-greeter-wrapper"
    install -Dm755 libluxos-rgba-menus.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-rgba-menus.so"
    install -Dm755 libluxos-lock-fix.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-lock-fix.so"
    install -Dm755 libluxos-panel-menus.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-panel-menus.so"
    install -Dm644 "$f/lightdm/lightdm-gtk-greeter.conf" \
        "$pkgdir/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-luxos.conf"

    # Firefox: hardwarove dekodovani videa, uvolnovani panelu pri nedostatku pameti
    install -Dm644 "$f/firefox/luxos.js" "$pkgdir/usr/lib/firefox/defaults/pref/luxos.js"

    install -Dm644 "$f/networkmanager/30-luxos-connectivity.conf" \
        "$pkgdir/usr/lib/NetworkManager/conf.d/30-luxos-connectivity.conf"
    install -Dm644 "$f/xorg/30-luxos-touchpad.conf" "$pkgdir/etc/X11/xorg.conf.d/30-luxos-touchpad.conf"
    # Zvuk: nove pripojena sluchatka / reproduktory se hned pouziji (pipewire-pulse)
    install -Dm644 "$f/pipewire/50-luxos-switch-on-connect.conf" \
        "$pkgdir/usr/share/pipewire/pipewire-pulse.conf.d/50-luxos-switch-on-connect.conf"

    install -Dm644 "$f/fontconfig/60-luxos.conf" "$pkgdir/usr/share/fontconfig/conf.avail/60-luxos.conf"
    install -dm755 "$pkgdir/etc/fonts/conf.d"
    ln -s /usr/share/fontconfig/conf.avail/60-luxos.conf "$pkgdir/etc/fonts/conf.d/60-luxos.conf"
}
