# Maintainer: LuxOS Team
# Desktop LuxOS: XFCE upravene do podoby macOS + vybrane lehke aplikace.

pkgname=luxos-desktop
pkgver=1.1.0
pkgrel=108
pkgdesc="LuxOS macOS-like desktop (Xfce, Plank dock, Search, Launchpad) and default apps"
arch=(x86_64)
# !strip: programy v LSL (dynamicky linkovane ELF cile linux-x86_64-gnu) po strip nejdou spustit
# ("exec format error"); programy a knihovny z C se zmensi rucne v build()
options=(!debug !strip)
url="https://github.com/luxopes/LuxOS-Arch"
# Unicode-3.0: data Emoji a symbolu z emoji-test.txt a anotaci CLDR (/usr/share/luxos/emoji)
license=(GPL-3.0-or-later Unicode-3.0)
# Emoji a symboly: poradi, skupiny a odstiny pleti (Unicode Emoji 17.0 - stejna verze, jakou umi
# noto-fonts-emoji) a nazvy s klicovymi slovy v 13 jazycich (Unicode CLDR 49). Arch ma unicode-emoji,
# ale jeho unicode-cldr neobsahuje common/annotations (jen annotationsDerived), proto pevne verze
# s kontrolnimi soucty; data se generuji pri sestaveni (luxos-emoji-data), za behu se nic nestahuje.
_emoji=17.0
_cldr=49.0.0
source=("emoji-test-$_emoji.txt::https://www.unicode.org/Public/$_emoji.0/emoji/emoji-test.txt"
        "https://registry.npmjs.org/cldr-annotations-full/-/cldr-annotations-full-$_cldr.tgz"
        "https://registry.npmjs.org/cldr-annotations-derived-full/-/cldr-annotations-derived-full-$_cldr.tgz")
# oba balicky npm maji koren "package/": rozbalit kazdy zvlast v build()
noextract=("cldr-annotations-full-$_cldr.tgz" "cldr-annotations-derived-full-$_cldr.tgz")
sha256sums=('1d8a944f88d7952f7ef7c5167fef3c67995bcae24543949710231b03a201acda'
            'ce415a4898da7a4ca755437de2593863c05045fc6b1649d8da5ee05fa3bdc33b'
            'e83ab0348ec09f4b5bb27f658b9c424c9c8fbf512484b728903515b9f01c3c28')
# lsl >= 0.11.0: prekladac lslc s moduly glib/gio/gtk/cairo/pango (cil linux-x86_64-gnu) pro programy v files/lsl,
# vazby luxos_* volajici C jsou systemove bindingy (--system-bindings, nainstalovane v /usr/lib/lsl/system);
# balik z [luxos-apps] (packages/apps/lsl), container-build.sh ho do kontejneru nainstaluje z tohoto sestaveni;
# xfce4-panel + xfconf: hlavicky pro plugin luxos-bar (libxfce4panel-2.0, libxfconf-0)
# wayland + libxkbcommon: libluxos-wl (wayland-scanner, XML protokolu jsou pripnute v files/src/luxos-wl/protocol)
# pam: hlavicky pro luxos-auth (overeni zamku obrazovky na Waylandu)
makedepends=(python xfce4-settings xfce4-session xfce4-panel xfconf libxi xorgproto libxtst libxrandr libxfixes libxcomposite libxrender gtk3 cairo pango pkgconf 'lsl>=0.11.0' libwnck3 wayland libxkbcommon pam)
# hlidac tlacitek okna Firefoxu: selektory luxos/titlebar.css proti omni.ja nainstalovaneho Firefoxu
checkdepends=(python firefox unzip nodejs)
install=luxos-desktop.install
depends=(
    # LuxOS
    luxos-branding luxos-themes luxos-shell luxos-tweaks luxos-drivers lux
    # Obrazky a ikony v procesu aplikace (gdk-pixbuf2 z [luxos] bez glycinu + zavadece SVG a WebP)
    gdk-pixbuf2 luxos-pixbuf-svg webp-pixbuf-loader
    # Graficky server a vstup
    xorg-server xorg-xrandr xorg-xinput xorg-xset xf86-input-libinput mesa
    # Xfce (jen potrebne casti); xfwm4 z [luxos]: umisteni oken a Alt+` (packages/xfwm4)
    xfce4-session 'xfwm4>=4.20.0-2.1' xfce4-panel xfdesktop xfce4-settings xfconf 'xfce4-notifyd>=0.9.7-3.3'
    # plugin horni listy luxos-bar (hodiny uprostred, neprusvitna lista pod okny)
    libwnck3
    # shell na Waylandu (1.1): vrstvy kompozitoru (luxos_layer.lsl) a protokoly shellu (libluxos-wl)
    gtk-layer-shell wayland libxkbcommon
    # relace na Waylandu (luxos-wayland-session): spravce oken, portaly snimku a sdileni obrazovky; relace X11
    # z greetd startuje Xorg pres startx (luxos-x11-session)
    luxwm xdg-desktop-portal xdg-desktop-portal-wlr xorg-xinit
    # aplikace X11 na Waylandu (luxwm ho spousti az s prvni z nich) a okna aplikaci z jineho pocitace:
    # "ssh -X" mezi pocitaci s LuxOS jde pres waypipe na obou stranach (luxos-shell remote-apps.sh)
    xorg-xwayland waypipe
    xfce4-power-manager 'xfce4-screensaver>=4.20.2-1.3' ffmpeg xfce4-taskmanager
    # Terminal LuxOS misto xfce4-terminal (packages/luxos-terminal, VTE s obrazky SIXEL)
    luxos-terminal
    'xfce4-whiskermenu-plugin>=2.10.1-2.1' xfce4-genmon-plugin 'xfce4-pulseaudio-plugin>=0.5.1-1.1' xfce4-xkb-plugin
    xfce4-cpugraph-plugin  # graf vytizeni CPU (jde pridat do listy, ve vychozi liste neni)
    # xorg-xauth: luxos-xauth-wildcard (pristup k obrazovce i po zmene nazvu pocitace)
    xorg-setxkbmap xorg-xprop xorg-xauth libxi libxtst libxrandr
    # moduly v Pythonu presunute z luxos-desktop (1.1.0-102): luxos_wm_icon.py do luxos-i18n, luxos_calendar_ics.py
    # do luxos-companion, fotka uctu primo v luxos-account - aktualizace je musi stahnout spolu s nim
    brightnessctl 'luxos-i18n>=1.0.0-102' luxos-store 'luxos-account>=1.0.0-13'
    # Lux Guard: kontrola stazenych programu a snimky /home (i u starsich instalaci pres lux update)
    luxos-guard
    # LuxOS Care: aktualizace, zalozni jadro a prechod na jadro LuxOS (starsi instalace ho nemely)
    luxos-care
    # Firewall LuxOS: zapnuty po instalaci i aktualizaci starsich systemu (upozorneni v luxos-hub, Nastaveni > Firewall)
    luxos-firewall
    # Zalohy: automaticke zalohy domovske slozky na externi/sitovy disk (uzivatelsky casovac)
    luxos-backup
    # Zvuk s prioritou v realnem case (PipeWire bez praskani pri zatezi) a pravidla Wi-Fi podle
    # zeme (bez regulatory.db jen omezene kanaly a vykon)
    rtkit wireless-regdb
    # Snimek obrazovky: obrazek ve schrance drzi xclip i po skonceni programu; kurzor ve snimku (XFixes)
    xclip libxfixes libxrender
    thunar thunar-volman thunar-archive-plugin thunar-media-tags-plugin tumbler ffmpegthumbnailer poppler-glib
    # Nahledy EPUB, ODF (LibreOffice) a RAW fotek: tumbler tyto pluginy nacita vzdy a bez knihoven pri kazdem
    # startu tumblerd hlasi "Failed to load plugin"; dohromady ~5 MB (webkit2gtk-4.1 pro libgepub uz je nize)
    libgepub libgsf libopenraw
    # Dock, Hledani, prihlaseni
    # rofi z [luxos]: Launchpad potrebuje -hover-no-scroll a -custom-exit (packages/rofi)
    plank 'rofi>=2.0.0-1.2' lightdm lightdm-gtk-greeter dconf yad
    # Zvuk, sit, bluetooth, tisk
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber pavucontrol
    networkmanager network-manager-applet nm-connection-editor
    bluez bluez-utils blueman
    luxos-printing cups cups-pdf system-config-printer ipp-usb sane-airscan avahi nss-mdns
    # Integrace systemu
    polkit-gnome gnome-keyring xdg-user-dirs xdg-utils xdg-desktop-portal-gtk
    gvfs gvfs-mtp gvfs-smb gvfs-gphoto2 udisks2 upower power-profiles-daemon
    # Pisma
    inter-font noto-fonts noto-fonts-emoji ttf-liberation ttf-jetbrains-mono-nerd
    # Aplikace
    # Sprava site (luxos-router): webova sprava routeru ve WebKitGTK (uz kvuli yad), ping, vyrobci podle MAC (oui.txt)
    webkit2gtk-4.1 iputils hwdata
    # Textovy editor LuxOS misto Mousepadu (packages/luxos-text); Mousepad nahradi (replaces v luxos-text)
    luxos-text
    # Firefox bez reklam: uBlock Origin jako doplnek v adresari aplikace (zapne se sam, aktualizuje se se systemem)
    firefox-ublock-origin
    firefox ristretto evince xarchiver 7zip unzip zip celluloid libwnck3 upower libnotify wmctrl
    # Kamera (luxos-camera): v4l2src, jpegdec, videoflip, vp8enc/webmmux, pulsesrc (good); opusenc (base)
    gstreamer gst-plugins-base gst-plugins-good
    # QR kod Wi-Fi (luxos-wifi-qr, luxos-camera --scan-wifi): kresleni i cteni QR kodu pres C API zxing-cpp
    # (~2 MB + zint; zbar by tahl ImageMagick a GraphicsMagick)
    zxing-cpp
    # Pocasi (packages/luxos-weather)
    luxos-weather
    # Mapy (packages/luxos-maps)
    luxos-maps
    # Telefon s aplikaci LuxOS Companion (packages/luxos-companion): poloha pro Mapy, LuxAI, poznamky
    'luxos-companion>=1.0.0-10'
    # Nastroje
    lshw pciutils usbutils
)
# fprintd instaluje luxos-drivers jen pri nalezene ctecce (luxos-hwdetect)
optdepends=('fprintd: log in with a fingerprint (Fingerprint settings)'
            'thunderbird: default e-mail app (mailto: links open in it; installed with new systems)')

build() {
    # Prepinani nabidek horni listy jednim klikem
    gcc $CFLAGS $LDFLAGS -o luxos-menubar "$startdir/files/src/luxos-menubar.c" -lX11 -lXi -lXtst -lXrandr
    # Zamykaci obrazovka: bez prazdne informacni listy (cerny pruh dole) po probuzeni
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-lock-fix.so "$startdir/files/src/luxos-lock-fix.c" \
        $(pkg-config --cflags --libs gtk+-3.0)
    # Cerne zakryti obrazovky pri odhlaseni a vypnuti (spousti luxos-hub), s --login prechod po prihlaseni
    gcc $CFLAGS $LDFLAGS -o luxos-session-cover "$startdir/files/src/luxos-session-cover.c" \
        -lX11 -lXfixes -lXcomposite -lXrandr -lXrender -lcairo -lm -pthread
    # Kontextove nabidky horni listy bez sedeho nazvu pluginu
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-panel-menus.so "$startdir/files/src/luxos-panel-menus.c" \
        $(pkg-config --cflags --libs gtk+-3.0)
    # Nabidka plochy (xfdesktop) s polozkou "Upravit widgety..."
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-desktop-menu.so "$startdir/files/src/luxos-desktop-menu.c" \
        $(pkg-config --cflags --libs gtk+-3.0)
    # Pojistka proti fork bombe kdekoli v relaci (systemova sluzba, viz files/src/luxos-forkguard.c);
    # C: smycka bez alokaci se zamcenou pameti i pri vycerpane RAM (sd-bus z libsystemd jen pro upozorneni)
    gcc $CFLAGS $LDFLAGS -o luxos-forkguard "$startdir/files/src/luxos-forkguard.c" -lsystemd
    # Plugin horni listy (v procesu panelu): hodiny uprostred listy a neprusvitna lista pod okny
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-bar.so "$startdir/files/src/luxos-bar.c" \
        $(pkg-config --cflags --libs libxfce4panel-2.0 libwnck-3.0 libxfconf-0 gtk+-3.0) -lm
    # Plynule kolecko a setrvacnost touchpadu v aplikacich GTK 3 (xsettings Gtk/Modules, files/src/luxos-scroll.c)
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o libluxos-scroll.so "$startdir/files/src/luxos-scroll.c" \
        $(pkg-config --cflags --libs gtk+-3.0 xi x11) -lm
    # Protokoly Waylandu pro shell v LSL (luxos_wl.lsl nacita knihovnu za behu): okna, zamek, snimek,
    # schranka, virtualni klavesnice, monitory, necinnost (files/src/luxos-wl)
    make -s -C "$startdir/files/src/luxos-wl" OUT="$PWD/luxos-wl"
    # Overeni hesla a otisku pro zamek na Waylandu mimo proces zamku (PAM jen tady)
    gcc $CFLAGS $LDFLAGS -o luxos-auth "$startdir/files/src/luxos-auth.c" -lpam
    strip --strip-all luxos-menubar luxos-session-cover luxos-forkguard luxos-auth
    strip --strip-unneeded libluxos-lock-fix.so libluxos-panel-menus.so libluxos-desktop-menu.so libluxos-bar.so \
        libluxos-scroll.so luxos-wl/libluxos-wl.so.0

    # Casto spoustene programy horni listy v LSL (files/lsl, viz docs/perf/lsl-rewrite-plan.md):
    # hodiny kazde 3 s, baterie kazdych 20 s, nazev aplikace pri kazdem prepnuti okna, prepinace
    # po kliknuti. Cil linux-x86_64-gnu: dynamicky linkovane nad glibc a GLib/GIO (D-Bus) stroje.
    local p
    for p in luxos-clock luxos-battery luxos-netcheck luxos-cc-toggle luxos-calendar-toggle luxos-appname; do
        lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/$p.lsl" "$p"
    done
    # Proces relace luxos-hub s okny Ovladaciho centra a Kalendare (drive tri programy v Pythonu + GTK):
    # jeden program, pod jmeny luxos-control-center a luxos-calendar jen posila signal bezicimu hubu
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-hub.lsl" luxos-hub
    # luxos-appearance auto na Waylandu: vychod/zapad slunce bez Pythonu
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-sun.lsl" luxos-sun
    # Snimek obrazovky: lista bezi v luxos-hub (okna pripravena predem); luxos-screenshot je maly klient
    # jen s libc, bez hubu spusti samostatny proces luxos-screenshot-ui se stejnym modulem luxos_shot;
    # na Waylandu (hub tam nebezi) snima luxos-screenshot-ui pres kompozitor (luxos_shot_wl)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-screenshot.lsl" luxos-screenshot
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-screenshot-ui.lsl" luxos-screenshot-ui
    # Grafika podle rezimu napajeni: hry na samostatne grafice v rezimu Vykon (luxos-gpu run v .desktop),
    # prepisy Flatpaku a PowerMizer NVIDIA (luxos-gpu apply z luxos-hub)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-gpu.lsl" luxos-gpu
    # Emoji a symboly: okno bezi v luxos-hub, luxos-emoji je maly klient, luxos-emoji-ui samostatny
    # proces bez hubu; luxos-emoji-data jen pri sestaveni vytvori data z emoji-test.txt a CLDR
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-emoji.lsl" luxos-emoji
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-emoji-ui.lsl" luxos-emoji-ui
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-emoji-data.lsl" luxos-emoji-data
    # Widgety na plose (cas a pocasi, mesic, vytizeni, hudba); vypnute = po spusteni hned skonci
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-widgets.lsl" luxos-widgets
    # Hodiny (budik, svetovy cas, stopky, minutka); budiky hlida na pozadi (--background)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-clock-app.lsl" luxos-clock-app
    # O tomto pocitaci (drive yad: jiny vzhled, bez UTF-8 locale se neotevrelo)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-about.lsl" luxos-about
    # Uvitani po prvnim prihlaseni (drive yad: sedm tlacitek v rade roztahlo okno na Waylandu pres 1260 px)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-welcome.lsl" luxos-welcome
    # Novinky LuxOS: oznameni od vyvojaru (okno, kontrola z luxos-hub, nastroje validate/new)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-news.lsl" luxos-news
    # Dock pro relaci na Waylandu (misto Planku); /usr/bin/luxos-dock ho spusti, kdyz bezi Wayland
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-dock.lsl" luxos-dock-wayland
    # Hodnoty vzhledu desktopu na Waylandu (luxos_tokens.lsl): CSS klientu shellu a tema dekoraci luxwm (labwc)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-tokens.lsl" luxos-tokens
    # Server oznameni relace na Waylandu (nahrada xfce4-notifyd; spousti ho relace, viz luxos-notify.service)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-notify.lsl" luxos-notify
    # Horni lista relace na Waylandu (layer-shell, jedna na monitor); X11 relace dal pouziva xfce4-panel
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-bar.lsl" luxos-bar
    # Zamek obrazovky na Waylandu (ext-session-lock) a hlidac necinnosti/logind; X11 relace dal xfce4-screensaver
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-lock.lsl" luxos-lock
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-lock-session.lsl" luxos-lock-session
    # Launchpad a Hledani relace na Waylandu (misto rofi); luxos-launchpad a luxos-search ho volaji pres D-Bus
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-launchpad.lsl" luxos-launchpad-wayland
    # Tapeta a nabidka plochy relace na Waylandu (vrstva BACKGROUND na kazdem monitoru); X11 relace dal xfdesktop
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-backdrop.lsl" luxos-backdrop
    # Monitory: pomocnik (na Waylandu jediny s pravem na wlr-output-management, allowlist luxwm; na X11 xrandr
    # pro skript luxos-displays) a okno/rychla volba
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-displays.lsl" luxos-displays-wayland
    # Agent polkitu relace na Waylandu (okno s heslem pro pkexec a Nastaveni); X11 relace dal polkit-gnome
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-polkit.lsl" luxos-polkit
    # Nastaveni: jedno okno se strankami (luxos_page_*.lsl, drive samostatne programy - jejich jmena jsou odkazy
    # na luxos-settings), Co je noveho, Prohlidka (X11 i Wayland)
    for p in luxos-settings luxos-whats-new luxos-tour; do
        lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/$p.lsl" "$p"
    done
    # Aplikace drive v Pythonu (WP-15): Kalkulacka, Monitor systemu, Zpetna vazba, kontrola portalu site, Sprava site, Kamera
    for p in luxos-calculator luxos-monitor luxos-feedback luxos-portal-check luxos-router luxos-camera; do
        lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/$p.lsl" "$p"
    done
    # Automaticke prepnuti zvukoveho vystupu po pripojeni monitoru/sluchatek (spousti luxos-hub)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-audio-switch.lsl" luxos-audio-switch
    # Ostra ikona okna pro Alt+Tab na X11 (spousti luxos-appname-watch pri aktivaci okna)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-wm-icon.lsl" luxos-wm-icon
    # Razeni Launchpadu v relaci X11 (rofi) a pocty spusteni (spousti luxos-launchpad)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-launchpad-order.lsl" luxos-launchpad-order
    # Setric obrazovky pro xfce4-screensaver (drive Python): styly tapeta plochy, tapety, rucickove hodiny, hodiny,
    # polarni zare, fotky, logo; kresli do okna setrice (XSCREENSAVER_WINDOW)
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" "$startdir/files/lsl/luxos-screensaver.lsl" luxos-screensaver
    rm -rf tokens
    mkdir -p tokens
    local m
    for m in light dark; do
        ./luxos-tokens css $m >tokens/shell-$m.css
        ./luxos-tokens rc $m >tokens/rc-theme-$m.xml
    done
    ./luxos-tokens labwc tokens/LuxOS light
    ./luxos-tokens labwc tokens/LuxOS-Dark dark
    rm -rf cldr-ann cldr-der emoji-data
    mkdir -p cldr-ann cldr-der
    tar -xzf "cldr-annotations-full-$_cldr.tgz" -C cldr-ann
    tar -xzf "cldr-annotations-derived-full-$_cldr.tgz" -C cldr-der
    ./luxos-emoji-data "emoji-test-$_emoji.txt" cldr-ann/package/annotations cldr-der/package/annotationsDerived \
        emoji-data cs sk de fr es it pl pt nl sv hu uk
}

check() {
    # Firefox: luxos.cfg, titlebar.css (styl musi cilit na tlacitka teto verze Firefoxu), uvitaci stranka;
    # cast se skutecnym Firefoxem bezi jen pod xvfb-run (tady se preskoci)
    env -u DISPLAY python3 -I "$startdir/tests/test_firefox_titlebar.py"
}

package() {
    local f="$startdir/files"

    # Vychozi nastaveni v samostatnem XDG adresari (ma prednost pred /etc/xdg)
    install -dm755 "$pkgdir/etc/xdg/luxos"
    cp -r --no-preserve=ownership "$f/xdg/." "$pkgdir/etc/xdg/luxos/"
    # Kanaly xfconf sloucit s vychozimi soubory Xfce (jinak by je nahradily cele)
    python3 "$f/merge-xfconf.py" /etc/xdg/xfce4/xfconf/xfce-perchannel-xml \
        "$f/xdg/xfce4/xfconf/xfce-perchannel-xml" "$pkgdir/etc/xdg/luxos/xfce4/xfconf/xfce-perchannel-xml"

    # posta pro exo-open (MailReader v helpers.rc)
    install -Dm644 -t "$pkgdir/usr/share/xfce4/helpers" "$f"/helpers/*.desktop
    # jen soubory: __pycache__ z testu v pracovnim stromu by install zastavil
    install -Dm755 -t "$pkgdir/usr/bin" $(find "$f/bin" -maxdepth 1 -type f | sort) luxos-menubar luxos-session-cover \
        luxos-clock luxos-battery luxos-netcheck luxos-cc-toggle luxos-calendar-toggle luxos-appname luxos-hub \
        luxos-screenshot luxos-gpu luxos-widgets luxos-clock-app luxos-about luxos-welcome luxos-news \
        luxos-settings luxos-whats-new luxos-tour \
        luxos-calculator luxos-monitor luxos-feedback luxos-portal-check luxos-router luxos-camera
    install -Dm755 luxos-screenshot-ui "$pkgdir/usr/lib/luxos/luxos-screenshot-ui"
    install -Dm755 luxos-sun "$pkgdir/usr/lib/luxos/luxos-sun"
    install -Dm755 luxos-audio-switch "$pkgdir/usr/lib/luxos/luxos-audio-switch"
    install -Dm755 luxos-wm-icon "$pkgdir/usr/lib/luxos/luxos-wm-icon"
    install -Dm755 luxos-launchpad-order "$pkgdir/usr/lib/luxos/luxos-launchpad-order"
    install -Dm755 luxos-notify "$pkgdir/usr/lib/luxos/luxos-notify"
    install -Dm644 "$f/systemd-user/luxos-notify.service" "$pkgdir/usr/lib/systemd/user/luxos-notify.service"
    install -Dm755 luxos-dock-wayland "$pkgdir/usr/lib/luxos/luxos-dock"
    install -Dm755 luxos-wl/libluxos-wl.so.0 "$pkgdir/usr/lib/luxos/libluxos-wl.so.0"
    install -Dm755 luxos-bar "$pkgdir/usr/bin/luxos-bar"
    install -Dm644 "$f/systemd-user/luxos-bar.service" "$pkgdir/usr/lib/systemd/user/luxos-bar.service"
    install -Dm755 luxos-lock "$pkgdir/usr/bin/luxos-lock"
    install -Dm755 luxos-lock-session "$pkgdir/usr/lib/luxos/luxos-lock-session"
    install -Dm755 luxos-auth "$pkgdir/usr/lib/luxos/luxos-auth"
    install -Dm644 "$f/systemd-user/luxos-lock.service" "$pkgdir/usr/lib/systemd/user/luxos-lock.service"
    install -Dm644 -t "$pkgdir/usr/lib/pam.d" "$f/pam.d/luxos-lock" "$f/pam.d/luxos-lock-fingerprint"
    install -Dm755 luxos-launchpad-wayland "$pkgdir/usr/lib/luxos/luxos-launchpad"
    install -Dm644 "$f/systemd-user/luxos-launchpad.service" "$pkgdir/usr/lib/systemd/user/luxos-launchpad.service"
    install -Dm644 "$f/dbus-services/cz.luxos.Launchpad.service" "$pkgdir/usr/share/dbus-1/services/cz.luxos.Launchpad.service"
    install -Dm755 luxos-backdrop "$pkgdir/usr/bin/luxos-backdrop"
    # Stare programy nastaveni = stranky okna Nastaveni (luxos-settings vybere stranku podle jmena)
    local alias
    for alias in luxos-power luxos-lock-settings luxos-bluetooth luxos-fingerprint luxos-profile-picture luxos-wifi-qr \
        luxos-app-reset luxos-scrolling luxos-firewall-settings; do
        ln -s luxos-settings "$pkgdir/usr/bin/$alias"
    done
    ln -s ../../bin/luxos-settings "$pkgdir/usr/lib/luxos/luxos-keyboard-settings"
    install -Dm755 luxos-displays-wayland "$pkgdir/usr/lib/luxos/luxos-displays"
    ln -s ../../bin/luxos-settings "$pkgdir/usr/lib/luxos/luxos-displays-settings"
    # Monitory jmenem (X11 i Wayland)
    ln -s ../lib/luxos/luxos-displays-settings "$pkgdir/usr/bin/luxos-display-settings"
    install -Dm644 "$f/systemd-user/luxos-backdrop.service" "$pkgdir/usr/lib/systemd/user/luxos-backdrop.service"
    # Vazby LSL na C (a moduly, ktere nacitaji) pro dalsi programy: load luxos_gtk bez kopirovani zdroju
    install -Dm644 -t "$pkgdir/usr/lib/lsl/system" "$f"/lsl/luxos_{apps,gio,glib,gtk,layer,lock_sys,material,notify_sys,sni,sys,text,tokens,wl,x11}.lsl
    install -Dm755 luxos-polkit "$pkgdir/usr/lib/luxos/luxos-polkit"
    install -Dm644 "$f/systemd-user/luxos-polkit.service" "$pkgdir/usr/lib/systemd/user/luxos-polkit.service"
    # Relace na Waylandu: cil shellu, Dock a widgety jako jednotky, polozka pro greetd, portaly (bin/luxos-wayland-session)
    install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$f/systemd-user/luxos-session.target" \
        "$f/systemd-user/luxos-dock.service" "$f/systemd-user/luxos-widgets.service"
    install -Dm644 "$f/wayland-sessions/luxos.desktop" "$pkgdir/usr/share/wayland-sessions/luxos.desktop"
    install -Dm644 "$f/xdg-desktop-portal/luxos-portals.conf" "$pkgdir/usr/share/xdg-desktop-portal/luxos-portals.conf"
    # Relace X11 z greetd (LuxOS (X11)): startx s xinitrc.d misto Xsession LightDM
    install -Dm755 -t "$pkgdir/usr/lib/luxos" "$f/session/luxos-x11-session" "$f/session/luxos-xsession"
    # Znelky budiku Hodin (generovane AI - StepFun, puvod v files/sounds/clock/SOURCES.md)
    install -Dm644 -t "$pkgdir/usr/share/sounds/luxos/clock" "$f"/sounds/clock/*.oga "$f"/sounds/clock/SOURCES.md
    install -Dm755 luxos-emoji "$pkgdir/usr/bin/luxos-emoji"
    install -Dm755 luxos-emoji-ui "$pkgdir/usr/lib/luxos/luxos-emoji-ui"
    install -Dm644 -t "$pkgdir/usr/share/luxos/emoji" emoji-data/*.tsv
    install -Dm644 -t "$pkgdir/usr/share/luxos/tokens" tokens/*.css tokens/*.xml
    install -Dm644 -t "$pkgdir/usr/share/themes/LuxOS/labwc" tokens/LuxOS/*
    install -Dm644 -t "$pkgdir/usr/share/themes/LuxOS-Dark/labwc" tokens/LuxOS-Dark/*
    install -Dm644 cldr-ann/package/LICENSE "$pkgdir/usr/share/licenses/$pkgname/Unicode-CLDR-LICENSE"
    # Ovladaci centrum a Kalendar jsou tentyz program (chova se podle jmena); profily panelu uzivatelu
    # volaji "luxos-control-center --panel", relace "luxos-hub"
    ln -s luxos-hub "$pkgdir/usr/bin/luxos-control-center"
    ln -s luxos-hub "$pkgdir/usr/bin/luxos-calendar"
    ln -s luxos-search "$pkgdir/usr/bin/luxos-spotlight"   # starsi zkratky v xfconf
    # Vychozi nastaveni NOVYCH uzivatelu od spravce (/etc/luxos/new-users.conf z lux system), pri prvnim prihlaseni
    install -Dm755 "$f/session/luxos-new-user-defaults" "$pkgdir/usr/lib/luxos/luxos-new-user-defaults"
    # Pristup k obrazovce nezavisly na nazvu pocitace (FamilyWild v ~/.Xauthority) a presun starych kopii
    # programu LuxOS z ~/.local (pri prihlaseni: xinitrc.d a luxos-session)
    install -Dm755 -t "$pkgdir/usr/lib/luxos" "$f/session/luxos-xauth-wildcard" "$f/session/luxos-shadow-guard"
    # Relace na Waylandu: vzhled aplikaci (xsettings -> gsettings) misto xfsettingsd
    install -Dm755 -t "$pkgdir/usr/lib/luxos" "$f/session/luxos-wayland-settings"
    install -Dm755 "$f/xinit/10-luxos-xauth.sh" "$pkgdir/etc/X11/xinit/xinitrc.d/10-luxos-xauth.sh"
    # Sledovani aktivniho okna (bash, xprop -spy) pro "luxos-appname watch"
    install -Dm755 "$f/luxos-appname-watch" "$pkgdir/usr/lib/luxos/luxos-appname-watch"
    # Setric obrazovky: xfce4-screensaver spousti jen programy ze sve slozky
    install -Dm755 luxos-screensaver "$pkgdir/usr/lib/xfce4-screensaver/luxos"
    install -Dm644 -t "$pkgdir/usr/share/applications/screensavers" "$f"/screensaver/*.desktop
    # dlouhy popis aplikace pro Obchod LuxOS (luxos_app_catalog.py -> apps.json)
    install -Dm644 -t "$pkgdir/usr/share/metainfo" "$f"/metainfo/*.metainfo.xml
    install -Dm755 -t "$pkgdir/usr/lib/luxos/override-bin" $(find "$f/override-bin" -maxdepth 1 -type f | sort)
    install -Dm644 -t "$pkgdir/usr/share/applications" "$f"/applications/*.desktop
    # Monitory i v Launchpadu (ten skryva panely Nastaveni); OnlyShowIn ji skryje v menu a Hledani
    sed -e 's/^Categories=.*/Categories=X-LuxOS-Launchpad;/' -e '/^\[Desktop Entry\]/a OnlyShowIn=X-LuxOS-Launchpad;' \
        "$f/applications/luxos-display-settings.desktop" > "$pkgdir/usr/share/applications/luxos-display-settings-launchpad.desktop"
    # Klavesnice (rozlozeni pro cely system) take v Launchpadu
    sed -e 's/^Categories=.*/Categories=X-LuxOS-Launchpad;/' -e '/^\[Desktop Entry\]/a OnlyShowIn=X-LuxOS-Launchpad;' \
        "$f/applications/luxos-keyboard.desktop" > "$pkgdir/usr/share/applications/luxos-keyboard-launchpad.desktop"
    install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" "$f"/icons/*.svg
    install -Dm644 -t "$pkgdir/usr/share/rofi/themes" "$f"/rofi/luxos-*.rasi

    # Pluginy horni listy bez nabidek (genmon, systray) bezi primo v procesu panelu - kazdy
    # externi plugin je dalsi proces (~12 MB). Panel cte <prefix>/share/xfce4/panel/plugins
    # z XDG_DATA_DIRS (viz /etc/profile.d/luxos.sh) a moduly bere z <prefix>/lib/xfce4/panel/plugins.
    # Pluginy s nabidkami zustavaji externi: luxos-menubar je rozlisuje podle X klienta.
    local pp="$pkgdir/usr/lib/luxos/panel" m
    install -Dm644 -t "$pp/share/xfce4/panel/plugins" "$f"/panel-plugins/*.desktop
    install -dm755 "$pp/lib/xfce4/panel/plugins"
    for m in genmon systray; do
        ln -s "/usr/lib/xfce4/panel/plugins/lib$m.so" "$pp/lib/xfce4/panel/plugins/lib$m.so"
    done
    install -Dm755 libluxos-bar.so "$pp/lib/xfce4/panel/plugins/libluxos-bar.so"
    install -Dm644 "$f/rofi/config.rasi" "$pkgdir/etc/rofi.rasi"   # system-wide config rofi 2.x

    # Kratke nazvy aplikaci (hook spravce baliku prepise .desktop do /var/lib/luxos/apps)
    install -Dm644 "$f/apps/rename.conf" "$pkgdir/usr/share/luxos/apps/rename.conf"
    install -Dm755 "$f/apps/luxos-apps-sync" "$pkgdir/usr/lib/luxos/luxos-apps-sync"
    install -Dm644 "$f/hooks/luxos-apps.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-apps.hook"
    # Rezim Vykon: samostatna grafika AMD na plny vykon (root cast luxos-gpu, polkit bez hesla)
    install -Dm644 "$f/gpu/luxos-gpu-performance.service" "$pkgdir/usr/lib/systemd/system/luxos-gpu-performance.service"
    install -Dm644 "$f/gpu/50-luxos-gpu.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-luxos-gpu.rules"
    # Pojistka proti fork bombe: zapnuta staticky, po aktualizaci ji spusti luxos-desktop.install
    install -Dm755 luxos-forkguard "$pkgdir/usr/lib/luxos/luxos-forkguard"
    install -Dm644 "$f/forkguard/luxos-forkguard.service" "$pkgdir/usr/lib/systemd/system/luxos-forkguard.service"
    install -Dm644 "$f/forkguard/cz.luxos.ForkGuard.conf" "$pkgdir/usr/share/dbus-1/system.d/cz.luxos.ForkGuard.conf"
    install -dm755 "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    ln -s ../luxos-forkguard.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/luxos-forkguard.service"
    # Aplikace z Flathubu hned v Launchpadu a nabidce (lux, Obchod i flatpak install): sledovani exportu
    # Flatpaku -> odkazy v /var/lib/luxos/apps; zapnute staticky, po instalaci spusti hook
    install -Dm644 -t "$pkgdir/usr/lib/systemd/system" "$f/apps/luxos-flatpak-apps.path" \
        "$f/apps/luxos-flatpak-apps.service"
    install -dm755 "$pkgdir/usr/lib/systemd/system/paths.target.wants"
    ln -s ../luxos-flatpak-apps.path "$pkgdir/usr/lib/systemd/system/paths.target.wants/luxos-flatpak-apps.path"
    install -Dm644 "$f/hooks/luxos-flatpak-apps.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-flatpak-apps.hook"
    # Prihlasovaci relace "LuxOS" misto "Xfce Session" (hook odstrani xfce.desktop z xfce4-session)
    install -Dm644 "$f/xsessions/luxos.desktop" "$pkgdir/usr/share/xsessions/luxos.desktop"
    install -Dm644 "$f/hooks/luxos-xsession.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-xsession.hook"

    # Otisk prstu: pam_fprintd v LightDM/sudo/polkit/zamku (hook po instalaci fprintd a aktualizacich
    # dotcenych baliku), soubor pro greeter "jen heslo" a kopie panelu pro Launchpad
    install -Dm755 "$f/fingerprint/luxos-fingerprint-pam" "$pkgdir/usr/lib/luxos/luxos-fingerprint-pam"
    install -Dm644 "$f/fingerprint/luxos-fingerprint.hook" "$pkgdir/usr/share/libalpm/hooks/luxos-fingerprint.hook"
    install -Dm644 "$f/fingerprint/luxos-fingerprint.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/luxos-fingerprint.conf"
    sed -e 's/^Categories=.*/Categories=X-LuxOS-Launchpad;/' -e '/^\[Desktop Entry\]/a OnlyShowIn=X-LuxOS-Launchpad;' \
        "$f/applications/luxos-fingerprint.desktop" > "$pkgdir/usr/share/applications/luxos-fingerprint-launchpad.desktop"

    # Skryte technicke aplikace (prekryti pres XDG_DATA_DIRS, viz /etc/profile.d/luxos.sh)
    local a
    install -dm755 "$pkgdir/usr/share/luxos/xdg/applications"
    while read -r a; do
        [[ -n $a ]] && printf '[Desktop Entry]\nType=Application\nName=%s\nNoDisplay=true\n' "$a" \
            > "$pkgdir/usr/share/luxos/xdg/applications/$a.desktop"
    done < "$f/hide/apps"

    install -dm755 "$pkgdir/etc/skel"
    cp -r --no-preserve=ownership "$f/skel/." "$pkgdir/etc/skel/"

    install -Dm644 "$f/dconf/user-profile" "$pkgdir/etc/dconf/profile/user"
    install -Dm644 "$f/dconf/10-luxos" "$pkgdir/etc/dconf/db/local.d/10-luxos"

    install -Dm644 "$f/lightdm/50-luxos.conf" "$pkgdir/etc/lightdm/lightdm.conf.d/50-luxos.conf"
    # Prechod po prihlaseni: posledni snimek prihlaseni zakryje skladani plochy (luxos-session-cover --login)
    install -Dm755 "$f/xinit/60-luxos-login-cover.sh" "$pkgdir/etc/X11/xinit/xinitrc.d/60-luxos-login-cover.sh"
    # Firefox s XInput2: touchpad jako gesto posunu se setrvacnosti (MOZ_USE_XINPUT2=1 v relaci)
    install -Dm755 "$f/xinit/50-luxos-firefox-xinput2.sh" "$pkgdir/etc/X11/xinit/xinitrc.d/50-luxos-firefox-xinput2.sh"
    install -Dm755 libluxos-lock-fix.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-lock-fix.so"
    install -Dm755 libluxos-panel-menus.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-panel-menus.so"
    install -Dm755 libluxos-desktop-menu.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-desktop-menu.so"
    install -Dm755 libluxos-scroll.so "$pkgdir/usr/lib/gtk-3.0/modules/libluxos-scroll.so"
    install -Dm644 "$f/lightdm/lightdm-gtk-greeter.conf" \
        "$pkgdir/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-luxos.conf"

    # Firefox: hardwarove dekodovani videa, uvolnovani panelu pri nedostatku pameti, plynule posouvani,
    # bez telemetrie a sponzorovaneho obsahu
    install -Dm644 "$f/firefox/luxos.js" "$pkgdir/usr/lib/firefox/defaults/pref/luxos.js"
    # Firefox autoconfig (luxos.cfg): tlacitka okna jako barevna kolecka LuxOS (titlebar.css, vypnuti
    # luxos.titlebar.trafficlights) a uvitaci stranka LuxOS pri prvnim spusteni profilu v jazyce systemu
    install -Dm644 "$f/firefox/luxos-autoconfig.js" "$pkgdir/usr/lib/firefox/defaults/pref/luxos-autoconfig.js"
    install -Dm644 "$f/firefox/luxos.cfg" "$pkgdir/usr/lib/firefox/luxos.cfg"
    install -Dm644 "$f/firefox/titlebar.css" "$pkgdir/usr/lib/firefox/luxos/titlebar.css"
    install -Dm644 -t "$pkgdir/usr/lib/firefox/luxos/welcome" "$f"/firefox/welcome/{index.html,strings.js,welcome.js}

    install -Dm644 "$f/networkmanager/30-luxos-connectivity.conf" \
        "$pkgdir/usr/lib/NetworkManager/conf.d/30-luxos-connectivity.conf"
    install -Dm644 "$f/xorg/30-luxos-touchpad.conf" "$pkgdir/etc/X11/xorg.conf.d/30-luxos-touchpad.conf"
    # Dock (bamfdaemon): start jen s dostupnym X serverem (zadne "Failed to start BAMF" pri odhlaseni)
    install -Dm644 "$f/systemd-user/bamfdaemon-luxos.conf" \
        "$pkgdir/usr/lib/systemd/user/bamfdaemon.service.d/50-luxos.conf"
    # Zvuk: nove pripojena sluchatka / reproduktory se hned pouziji (pipewire-pulse)
    install -Dm644 "$f/pipewire/50-luxos-switch-on-connect.conf" \
        "$pkgdir/usr/share/pipewire/pipewire-pulse.conf.d/50-luxos-switch-on-connect.conf"

    install -Dm644 "$f/fontconfig/60-luxos.conf" "$pkgdir/usr/share/fontconfig/conf.avail/60-luxos.conf"
    install -dm755 "$pkgdir/etc/fonts/conf.d"
    ln -s /usr/share/fontconfig/conf.avail/60-luxos.conf "$pkgdir/etc/fonts/conf.d/60-luxos.conf"

    # Nazvy a popisy aplikaci (Launchpad, Hledani, nabidka) ve vsech 12 jazycich z tabulek luxos-i18n -
    # ne jen Name[cs]; rucne napsane preklady v souborech maji prednost
    local i18n
    for i18n in "$startdir/../luxos-i18n/files" "$startdir/../../luxos-i18n/files"; do
        [[ -f $i18n/desktop-i18n.py ]] && break
    done
    [[ -f $i18n/desktop-i18n.py ]] || { echo "luxos-i18n/files/desktop-i18n.py not found" >&2; return 1; }
    python "$i18n/desktop-i18n.py" "$i18n" "$pkgdir"/usr/share/applications/*.desktop \
        "$pkgdir"/usr/share/applications/screensavers/*.desktop "$pkgdir"/usr/lib/luxos/panel/share/xfce4/panel/plugins/*.desktop
}
