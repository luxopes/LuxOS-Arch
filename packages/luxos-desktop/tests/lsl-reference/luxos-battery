#!/bin/bash
# LuxOS - baterie v horni liste (plugin genmon): ikona + procenta, klik = Ovladaci centrum
. /usr/lib/luxos/i18n.sh
bats=(/sys/class/power_supply/BAT*)
bat=${bats[0]}
[[ -e $bat ]] || bat=
if [[ -z $bat ]]; then
    printf '<txt></txt>\n'
    exit 0
fi
cap=$(<"$bat/capacity") st=$(<"$bat/status")

# Automaticky Sporic baterie pri 20 % (zapina Baterie a napajeni); po pripojeni
# nabijecky ho zase vypne, ale jen kdyz ho zapnul on
auto="${XDG_CONFIG_HOME:-$HOME/.config}/luxos/powersaver-auto"
mark="${XDG_RUNTIME_DIR:-/tmp}/luxos-powersaver-auto-on"
saver="${XDG_CONFIG_HOME:-$HOME/.config}/luxos/powersaver"   # stav jako luxos-powersaver status, bez dalsiho procesu
if [[ -e $auto ]]; then
    if [[ $st == Discharging && $cap -le 20 && ! -e $mark && ! -e $saver ]]; then
        luxos-powersaver on >/dev/null
        : >"$mark"
        notify-send -i battery-caution -a LuxOS "$(T "Battery Saver is on")" \
            "$(T "Battery is at %s %%. Connect the charger." "$cap")" 2>/dev/null
    elif [[ $st != Discharging && -e $mark ]]; then
        luxos-powersaver off >/dev/null
        rm -f "$mark"
    fi
fi
level=$(( (cap + 5) / 10 * 10 ))
icon="battery-level-$level"
[[ $st == Charging ]] && icon+="-charging"
[[ $st == Full || ($st == "Not charging" && cap -ge 95) ]] && icon="battery-level-100-charged"
case $st in
    Charging) tip=$(T "Charging") ;;
    Discharging) tip=$(T "On battery") ;;
    *) tip=$(T "Fully charged") ;;
esac
# Odhad casu z aktualniho odberu (energy_* v uWh/uW, nebo charge_* v uAh/uA)
rd() { [[ -r $bat/$1 ]] && read -r "$2" <"$bat/$1"; }
now= full= rate=
rd energy_now now && rd energy_full full && rd power_now rate ||
    { rd charge_now now && rd charge_full full && rd current_now rate; }
rate=${rate#-}
if [[ -n $now && -n $full && ${rate:-0} -gt 0 ]]; then
    mins=
    if [[ $st == Discharging ]]; then
        mins=$(( now * 60 / rate ))
    elif [[ $st == Charging && $full -gt $now ]]; then
        mins=$(( (full - now) * 60 / rate ))
    fi
    if [[ -n $mins ]] && (( mins > 0 && mins < 6000 )); then
        if (( mins >= 60 )); then t="$((mins / 60)) h $((mins % 60)) min"; else t="$mins min"; fi
        if [[ $st == Discharging ]]; then tip+=" · $(T "%s remaining" "$t")"
        else tip+=" · $(T "%s until full" "$t")"; fi
    fi
fi
[[ -e $saver ]] && tip+=" · $(T "Battery Saver")"
printf '<icon>%s-symbolic</icon><txt> %s %%</txt><tool>%s %% · %s</tool><iconclick>luxos-cc-toggle</iconclick><txtclick>luxos-cc-toggle</txtclick><scroll>luxos-brightness</scroll>\n' \
    "$icon" "$cap" "$cap" "$tip"
