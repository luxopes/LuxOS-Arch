#!/usr/bin/env python3
"""Falesny xfconf-query pro testy zkratek (nikdy nesaha na skutecny xfconf).

FAKE_XFCONF_DEFAULTS = systemovy XML kanalu (vychozi hodnoty, jako /etc/xdg/luxos),
FAKE_XFCONF = JSON uzivatelskych hodnot {"/vlastnost": hodnota},
FAKE_XFCONF_LOG = zaznam volani (jeden radek JSON na volani), FAKE_XFCONF_FAIL=1 = chyba.
Reset (-r) smaze uzivatelskou hodnotu, takze se vrati vychozi - jako skutecny xfconfd.
"""
import json
import os
import sys
import xml.etree.ElementTree as ET

a = sys.argv[1:]
if os.environ.get("FAKE_XFCONF_LOG"):
    with open(os.environ["FAKE_XFCONF_LOG"], "a") as f:
        f.write(json.dumps(a) + "\n")
if os.environ.get("FAKE_XFCONF_FAIL") == "1":
    print("Failed to init libxfconf", file=sys.stderr)
    sys.exit(1)


def walk(node, prefix, out):
    for p in node.findall("property"):
        path = prefix + "/" + p.get("name")
        if p.get("type") not in (None, "empty"):
            out[path] = p.get("value", "")
        walk(p, path, out)


defaults = {}
if os.environ.get("FAKE_XFCONF_DEFAULTS"):
    walk(ET.parse(os.environ["FAKE_XFCONF_DEFAULTS"]).getroot(), "", defaults)
path = os.environ["FAKE_XFCONF"]
try:
    with open(path) as f:
        user = json.load(f)
except (OSError, ValueError):
    user = {}
prop = a[a.index("-p") + 1] if "-p" in a else None
eff = dict(defaults)
eff.update(user)
if "-l" in a:
    keys = sorted(eff)
    width = max((len(k) for k in keys), default=0) + 2
    for k in keys:
        print(k.ljust(width) + str(eff[k]) if "-v" in a else k)
    sys.exit(0)
if "-r" in a:
    for k in [k for k in user if k == prop or ("-R" in a and k.startswith(prop + "/"))]:
        del user[k]
elif "-s" in a:
    if prop not in eff and "-n" not in a:
        print(f'Property "{prop}" does not exist on channel.', file=sys.stderr)
        sys.exit(1)
    user[prop] = a[a.index("-s") + 1]
else:
    if prop not in eff:
        print(f'Property "{prop}" does not exist on channel.', file=sys.stderr)
        sys.exit(1)
    print(eff[prop])
    sys.exit(0)
with open(path, "w") as f:
    json.dump(user, f)
