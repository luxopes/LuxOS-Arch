#!/usr/bin/env python3
"""Falesny nmcli pro testy Spravy site: FAKE_NET {"device": "text device show", "wifi": "text wifi list"}."""
import json
import os
import sys

with open(os.environ["FAKE_NET"]) as f:
    net = json.load(f)
a = sys.argv[1:]
if "wifi" in a:
    sys.stdout.write(net.get("wifi", ""))
elif "show" in a:
    sys.stdout.write(net.get("device", ""))
