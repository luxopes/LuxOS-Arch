+/*
+ * LuxOS: klavesa pod Esc (nad Tabem, XKB <TLDE>) podle fyzicke polohy. V ceskem rozlozeni
+ * na ni je ";" a "`" az s AltGr - XKeysymToKeycode by pro "grave" nasel prvni klavesu s "`"
+ * na libovolne urovni (v cz <AC06>, tedy H). Zkratky s "grave" (Alt+`, Super+`) proto plati
+ * pro tuto klavesu v kazdem rozlozeni, jako Cmd+` v macOS.
+ */
+static KeyCode
+getTildeKeycode (Display *dpy)
+{
+    XkbDescPtr desc;
+    KeyCode keycode;
+    int i;
+
+    keycode = 0;
+    desc = XkbGetMap (dpy, 0, XkbUseCoreKbd);
+    if (desc == NULL)
+    {
+        return 0;
+    }
+    if (XkbGetNames (dpy, XkbKeyNamesMask, desc) == Success && desc->names && desc->names->keys)
+    {
+        for (i = desc->min_key_code; i <= desc->max_key_code; i++)
+        {
+            if (!strncmp (desc->names->keys[i].name, "TLDE", XkbKeyNameLength))
+            {
+                keycode = (KeyCode) i;
+                break;
+            }
+        }
+    }
+    XkbFreeKeyboard (desc, 0, True);
+
+    return keycode;
+}
+
 static KeyCode
 getKeycode (Display *dpy, const char *str)
 {
     GdkModifierType keysym;
+    KeyCode keycode;
 
     gtk_accelerator_parse (str, &keysym, NULL);
+    if (keysym == GDK_KEY_grave)
+    {
+        keycode = getTildeKeycode (dpy);
+        if (keycode)
+        {
+            return keycode;
+        }
+    }
     return XKeysymToKeycode (dpy, keysym);
 }
 
