+/* LuxOS: stejna aplikace = stejna trida okna (WM_CLASS) */
+static gboolean
+clientCycleSameClass (Client *c1, Client *c2)
+{
+    if (c1 == c2)
+    {
+        return TRUE;
+    }
+    return (c1->class.res_class != NULL && c2->class.res_class != NULL &&
+            !g_ascii_strcasecmp (c1->class.res_class, c2->class.res_class));
+}
+
+/* LuxOS: kazda aplikace jednou (prvni = naposledy pouzite okno, poradi zustava) */
+static GList *
+clientCycleGroupList (GList *all_list)
+{
+    GList *result, *li, *lj;
+
+    result = NULL;
+    for (li = all_list; li; li = g_list_next (li))
+    {
+        for (lj = result; lj; lj = g_list_next (lj))
+        {
+            if (clientCycleSameClass ((Client *) lj->data, (Client *) li->data))
+            {
+                break;
+            }
+        }
+        if (lj == NULL)
+        {
+            result = g_list_append (result, li->data);
+        }
+    }
+    return result;
+}
+
+/* LuxOS: jen okna stejne aplikace jako c */
+static GList *
+clientCycleAppList (GList *all_list, Client *c)
+{
+    GList *result, *li;
+
+    result = NULL;
+    for (li = all_list; li; li = g_list_next (li))
+    {
+        if (clientCycleSameClass (c, (Client *) li->data))
+        {
+            result = g_list_append (result, li->data);
+        }
+    }
+    return result;
+}
