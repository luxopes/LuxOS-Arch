 typedef struct _ClientCycleData ClientCycleData;
 struct _ClientCycleData
 {
     Tabwin *tabwin;
     WireFrame *wireframe;
     gboolean inside;
+    /* LuxOS */
+    GList *client_list;     /* seznam zobrazeny v tabwin (tabwin drzi ukazatel na tuto polozku) */
