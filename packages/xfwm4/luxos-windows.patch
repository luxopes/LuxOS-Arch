+/*
+ * LuxOS: umisteni noveho okna jako v macOS (placement_mode "luxos").
+ *  1. stred monitoru, kdyz tam okno nic neprekryva,
+ *  2. jinak volne misto bez prekryti (puvodni "smart" hledani),
+ *  3. jinak kaskada: o LUXOS_CASCADE_STEP px vpravo dolu od nejvyssiho okna stejne aplikace
+ *     (WM_CLASS); na okraji pracovni plochy pokracuje novym sloupcem nahore / vlevo.
+ * Okno nikdy neskonci presne na jinem okne (stejny levy horni roh).
+ * Dialogy, prechodna okna, okna s vlastni pozici (PPosition/USPosition) a okna obnovena
+ * z relace sem nechodi vubec (viz clientInitPosition a clientFrame).
+ */
+#define LUXOS_CASCADE_STEP 28
+
+static gboolean
+luxosSameClass (Client *c1, Client *c2)
+{
+    return (c1->class.res_class != NULL && c2->class.res_class != NULL &&
+            !g_ascii_strcasecmp (c1->class.res_class, c2->class.res_class));
+}
+
+/* okno, se kterym se pri umistovani pocita (stejna pravidla jako smartPlacement) */
+static gboolean
+luxosCountsForPlacement (Client *c, Client *c2)
+{
+    return ((c2 != c) && (c2->type != WINDOW_DESKTOP)
+            && (c->win_workspace == c2->win_workspace)
+            && FLAG_TEST (c2->xfwm_flags, XFWM_FLAG_VISIBLE));
+}
+
+/* plocha prekryti ramu okna c v pozici ramu (fx, fy) s ostatnimi okny */
+static unsigned long
+luxosOverlapAt (Client *c, int fx, int fy)
+{
+    ScreenInfo *screen_info;
+    Client *c2;
+    unsigned long total;
+    guint i;
+
+    screen_info = c->screen_info;
+    total = 0;
+    for (c2 = screen_info->clients, i = 0; i < screen_info->client_count; c2 = c2->next, i++)
+    {
+        if (!luxosCountsForPlacement (c, c2))
+        {
+            continue;
+        }
+        total += overlap (fx, fy, fx + frameExtentWidth (c), fy + frameExtentHeight (c),
+                          frameExtentX (c2), frameExtentY (c2),
+                          frameExtentX (c2) + frameExtentWidth (c2),
+                          frameExtentY (c2) + frameExtentHeight (c2));
+    }
+    return total;
+}
+
+/* na pozici ramu (fx, fy) uz je jine okno (levy horni roh blize nez pul kroku kaskady) */
+static gboolean
+luxosPositionTaken (Client *c, int fx, int fy)
+{
+    ScreenInfo *screen_info;
+    Client *c2;
+    guint i;
+
+    screen_info = c->screen_info;
+    for (c2 = screen_info->clients, i = 0; i < screen_info->client_count; c2 = c2->next, i++)
+    {
+        if (!luxosCountsForPlacement (c, c2) || (c2->type & WINDOW_TYPE_DONT_PLACE))
+        {
+            continue;
+        }
+        if (ABS (frameExtentX (c2) - fx) < LUXOS_CASCADE_STEP / 2 &&
+            ABS (frameExtentY (c2) - fy) < LUXOS_CASCADE_STEP / 2)
+        {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* nejvyssi (naposledy pouzite) normalni okno stejne aplikace na tomto monitoru a plose */
+static Client *
+luxosCascadeReference (Client *c, int full_x, int full_y, int full_w, int full_h)
+{
+    ScreenInfo *screen_info;
+    Client *c2;
+    GList *list;
+    int cx, cy;
+
+    screen_info = c->screen_info;
+    for (list = g_list_last (screen_info->windows_stack); list; list = g_list_previous (list))
+    {
+        c2 = (Client *) list->data;
+        if (!luxosCountsForPlacement (c, c2) || !(c2->type & WINDOW_NORMAL) || !luxosSameClass (c, c2))
+        {
+            continue;
+        }
+        if (FLAG_TEST (c2->flags, CLIENT_FLAG_FULLSCREEN | CLIENT_FLAG_MAXIMIZED))
+        {
+            continue;
+        }
+        cx = frameExtentX (c2) + frameExtentWidth (c2) / 2;
+        cy = frameExtentY (c2) + frameExtentHeight (c2) / 2;
+        if (cx >= full_x && cx < full_x + full_w && cy >= full_y && cy < full_y + full_h)
+        {
+            return c2;
+        }
+    }
+    return NULL;
+}
+
+static void
+luxosPlacement (Client * c, int full_x, int full_y, int full_w, int full_h)
+{
+    Client *ref;
+    int fx, fy, fw, fh, tries;
+
+    g_return_if_fail (c != NULL);
+
+    TRACE ("client \"%s\" (0x%lx)", c->name, c->window);
+
+    fw = frameExtentWidth (c);
+    fh = frameExtentHeight (c);
+
+    /* 1. stred, kdyz je volny */
+    centerPlacement (c, full_x, full_y, full_w, full_h);
+    if (luxosOverlapAt (c, frameExtentX (c), frameExtentY (c)) == 0)
+    {
+        return;
+    }
+
+    /* 2. volne misto kdekoli na monitoru */
+    if (smartPlacement (c, full_x, full_y, full_w, full_h) == 0.0f)
+    {
+        return;
+    }
+
+    /* 3. kaskada od posledniho okna stejne aplikace, jinak misto s nejmensim prekrytim */
+    ref = luxosCascadeReference (c, full_x, full_y, full_w, full_h);
+    if (ref)
+    {
+        fx = frameExtentX (ref) + LUXOS_CASCADE_STEP;
+        fy = frameExtentY (ref) + LUXOS_CASCADE_STEP;
+    }
+    else
+    {
+        fx = frameExtentX (c);
+        fy = frameExtentY (c);
+    }
+
+    for (tries = 0; tries < 64; tries++)
+    {
+        /* na okraji pracovni plochy zacit novy sloupec kaskady nahore / vlevo */
+        if (fy + fh > full_y + full_h)
+        {
+            fy = full_y;
+        }
+        if (fx + fw > full_x + full_w)
+        {
+            fx = full_x;
+        }
+        if (!luxosPositionTaken (c, fx, fy))
+        {
+            break;
+        }
+        fx += LUXOS_CASCADE_STEP;
+        fy += LUXOS_CASCADE_STEP;
+    }
+
+    c->x = MAX (fx, full_x) + frameExtentLeft (c);
+    c->y = MAX (fy, full_y) + frameExtentTop (c);
+}
