+ *            jejim naposledy pouzitym oknem; Dolu nebo ` ukaze okna vybrane aplikace, Nahoru zpet
+ *   APP      Alt+` (cycle_app_windows_key): jen okna aktualni aplikace
+ */
+typedef enum
+{
+    CYCLE_MODE_ALL,
+    CYCLE_MODE_GROUPED,
+    CYCLE_MODE_APP
+} CycleMode;
