+/* LuxOS: zobrazit v prepinaci jiny seznam oken a vybrat v nem select (nebo prvni okno) */
+static Client *
+clientCycleReplaceList (ClientCycleData *passdata, GList *list, Client *select)
+{
+    ScreenInfo *screen_info;
+    GList *selected;
+
+    if (list == NULL)
+    {
+        return NULL;
+    }
+    selected = g_list_find (list, select);
+    if (selected == NULL)
+    {
+        selected = list;
+    }
+    screen_info = ((Client *) selected->data)->screen_info;
+
+    tabwinDestroy (passdata->tabwin);
+    g_free (passdata->tabwin);
+    g_list_free (passdata->client_list);
+    passdata->client_list = list;
+    passdata->tabwin = tabwinCreate (&passdata->client_list, selected,
+                                     screen_info->params->cycle_workspaces);
+    passdata->inside = FALSE;
+
+    return (Client *) selected->data;
+}
+
+/* LuxOS: seskupeny Alt+Tab -> okna vybrane aplikace */
+static Client *
+clientCycleExpand (ClientCycleData *passdata, Client *c)
+{
+    passdata->mode = CYCLE_MODE_APP;
+    passdata->expanded = TRUE;
+    return clientCycleReplaceList (passdata, clientCycleAppList (passdata->all_list, c), c);
+}
+
+/* LuxOS: okna aplikace -> zpet na seskupeny Alt+Tab s vybranou touto aplikaci */
+static Client *
+clientCycleCollapse (ClientCycleData *passdata, Client *c)
+{
+    GList *groups, *li;
+    Client *select;
+
+    groups = clientCycleGroupList (passdata->all_list);
+    select = NULL;
+    for (li = groups; li && c; li = g_list_next (li))
+    {
+        if (clientCycleSameClass ((Client *) li->data, c))
+        {
+            select = (Client *) li->data;
+            break;
+        }
+    }
+    passdata->mode = CYCLE_MODE_GROUPED;
+    passdata->expanded = FALSE;
+    return clientCycleReplaceList (passdata, groups, select);
+}
