+/*
+ * LuxOS: posun ploch do strany pri prepnuti (jako Spaces v macOS).
+ *
+ * Plochy lezi v rade vedle sebe, kazda ve svem "slotu" sirokem jako monitor; pri prepnuti jede
+ * kamera ze slotu stare plochy do slotu nove (ease-out cubic), dalsi plocha je vpravo, predchozi
+ * vlevo (i pri skoku o vic ploch jen o jednu sirku). Posouvaji se jen okna ploch: tapeta/plocha
+ * (xfdesktop), lepkava okna, horni lista, Dock, menu a notifikace stoji. Aktualni plocha se kresli
+ * zive (okna uz jsou na svych skutecnych mistech, vstup se neblokuje, posouva se jen obraz),
+ * opustena plocha jako snimek jejich oken porizeny tesne pred skrytim. Nove prepnuti behem
+ * animace jen zmeni cil kamery (plynule navazani, zadna fronta; zpet na predchozi plochu jede
+ * kamera zpet). Kazdy monitor se posouva o svou sirku a orizne se na sebe (okno patri monitoru
+ * se svym stredem).
+ */
+
+/* Okno namapovane behem posunu ma v pixmape do prvniho prekresleni aplikaci nahodny obsah
+ * (casto prave uvolnenou pixmapu skryteho okna stejne velikosti) - kresli se, az prijde dalsi
+ * poskozeni po tom z namapovani, nejpozdeji po teto dobe. */
+#define SLIDE_NEW_WIN_WAIT_US   150000
+
+static void damage_screen (ScreenInfo *screen_info);
+
+/* Pod tuto rychlost (px za snimek) se obsah posouva o zlomky pixelu (bilinearne) - pomaly dojezd
+ * jinak skace po celych pixelech v nepravidelnych odstupech. */
+#define SLIDE_SUBPIXEL_MAX_STEP 6.0
+
+/*
+ * Krivka posunu: cubic-bezier (0.25, y1, 0.25, 1) - pro nove prepnuti y1 = 0.1 (CSS "ease", jako
+ * Spaces v macOS): mirny rozjezd, plynule zrychleni a dlouhy mekky dojezd bez zastaveni naraz.
+ * Pri novem prepnuti behem animace se y1 spocita z aktualni rychlosti (sklon na zacatku krivky je
+ * 4 * y1), takze rychlost navaze bez skoku. t v <0, 1>, vraci postup a jeho derivaci podle t.
+ */
+static gdouble
+slide_curve (gdouble y1, gdouble t, gdouble *slope)
+{
+    gdouble u, x, dx, dy, lo, hi;
+    gint i;
+
+    if (t <= 0.0)
+    {
+        *slope = 4.0 * y1;
+        return 0.0;
+    }
+    if (t >= 1.0)
+    {
+        *slope = 0.0;
+        return 1.0;
+    }
+    /* x (u) = 0.75 u (1 - u) + u^3 je rostouci (x' > 0): Newton, s pojistkou puleni */
+    lo = 0.0;
+    hi = 1.0;
+    u = t;
+    for (i = 0; i < 12; i++)
+    {
+        x = 0.75 * u * (1.0 - u) + u * u * u - t;
+        if (fabs (x) < 1e-7)
+        {
+            break;
+        }
+        if (x > 0.0)
+        {
+            hi = u;
+        }
+        else
+        {
+            lo = u;
+        }
+        dx = 0.75 - 1.5 * u + 3.0 * u * u;
+        u -= x / dx;
+        if (u <= lo || u >= hi)
+        {
+            u = (lo + hi) / 2.0;
+        }
+    }
+    dx = 0.75 - 1.5 * u + 3.0 * u * u;
+    dy = 3.0 * y1 * (1.0 - u) * (1.0 - 3.0 * u) + 3.0 * u * (2.0 - 3.0 * u) + 3.0 * u * u;
+    *slope = dy / dx;
+    return 3.0 * (1.0 - u) * (1.0 - u) * u * y1 + 3.0 * (1.0 - u) * u * u + u * u * u;
+}
+
+/* Poloha kamery (a rychlost ve slotech za us) v case animace t (us od zacatku useku). */
+static gdouble
+slide_camera (ScreenInfo *screen_info, gint64 t, gboolean *finished, gdouble *velocity)
+{
+    gdouble duration, p, slope, dist;
+
+    duration = MAX (screen_info->slide_duration, 1) * 1000.0;
+    dist = screen_info->slide_cam_to - screen_info->slide_cam_from;
+    p = slide_curve (screen_info->slide_y1, t / duration, &slope);
+    if (finished)
+    {
+        *finished = (t >= duration);
+    }
+    if (velocity)
+    {
+        *velocity = dist * slope / duration;
+    }
+    return screen_info->slide_cam_from + dist * p;
+}
+
+/*
+ * Cas animace pro dalsi snimek: o jeden interval obnovy dal (s vsync je kazde vykresleni jeden
+ * zobrazeny snimek, takze kroky mezi snimky jsou stejne). Zpozdeni proti hodinam se dohani jen
+ * z poloviny na snimek - zadrhnuti neudela dvojity skok, rozlozi se do dalsich snimku. Bez vsync muze dalsi
+ * poskozeni prekreslit tentyz snimek (krok 0).
+ */
+/* Kresli se v rytmu vsync? (GLX jen s rizenim intervalu vymeny, jinak by snimky bezely naprazdno) */
+static gboolean
+slide_vsync (ScreenInfo *screen_info)
+{
+#ifdef HAVE_EPOXY
+    if (screen_info->use_glx)
+    {
+        return (screen_info->has_mesa_swap_control || screen_info->has_ext_swap_control);
+    }
+#endif /* HAVE_EPOXY */
+    return screen_info->use_present;
+}
+
+static gint64
+slide_next_frame_time (ScreenInfo *screen_info, gint64 now)
+{
+    gint64 interval, behind, advance;
+
+    interval = MAX (screen_info->slide_interval, 1000);
+    behind = (now - screen_info->slide_start) - screen_info->slide_frame_t;
+    advance = interval + (behind - interval) / 2;
+    if ((screen_info->slide_frame_t < 3 * interval) && (behind > interval))
+    {
+        /* prvni snimky: aplikace prave prekresluji nove namapovana okna - zpozdeni se odpusti
+         * (posun se o nej protahne), aby pozdeji neposkocil */
+        screen_info->slide_start += behind - interval;
+        advance = interval;
+    }
+    /* s vsync aspon 3/4 intervalu (snimky dopredu ve fronte GPU se zobrazi po jednom), bez nej
+     * i 0; kdyz vymena bufferu neceka na vsync, drzi krok realny cas */
+    advance = CLAMP (advance, slide_vsync (screen_info) ? interval * 3 / 4 : 0, 3 * interval);
+    return screen_info->slide_frame_t + advance;
+}
+
+static void
+slide_update_monitors (ScreenInfo *screen_info)
+{
+    gint i, n;
+
+    n = myScreenGetNumMonitors (screen_info);
+    screen_info->slide_n_monitors = 0;
+    for (i = 0; i < n && screen_info->slide_n_monitors < SLIDE_MAX_MONITORS; i++)
+    {
+        GdkRectangle *r = &screen_info->slide_monitors[screen_info->slide_n_monitors];
+
+        xfwm_get_monitor_geometry (screen_info->gscr, myScreenGetMonitorIndex (screen_info, i), r, TRUE);
+        if (r->width > 0 && r->height > 0)
+        {
+            screen_info->slide_n_monitors++;
+        }
+    }
+    if (screen_info->slide_n_monitors == 0)
+    {
+        GdkRectangle *r = &screen_info->slide_monitors[0];
+
+        r->x = 0;
+        r->y = 0;
+        r->width = screen_info->width;
+        r->height = screen_info->height;
+        screen_info->slide_n_monitors = 1;
+    }
+}
+
+static GdkRectangle *
+slide_monitor_at (ScreenInfo *screen_info, gint x, gint y)
+{
+    GdkRectangle *best;
+    gint i;
+    gint64 best_dist;
+
+    best = &screen_info->slide_monitors[0];
+    best_dist = G_MAXINT64;
+    for (i = 0; i < screen_info->slide_n_monitors; i++)
+    {
+        GdkRectangle *r = &screen_info->slide_monitors[i];
+        gint64 dx, dy, dist;
+
+        if (x >= r->x && x < r->x + r->width && y >= r->y && y < r->y + r->height)
+        {
+            return r;
+        }
+        dx = (gint64) (r->x + r->width / 2) - x;
+        dy = (gint64) (r->y + r->height / 2) - y;
+        dist = dx * dx + dy * dy;
+        if (dist < best_dist)
+        {
+            best_dist = dist;
+            best = r;
+        }
+    }
+    return best;
+}
+
+static void
+slide_set_clip (Display *dpy, Picture pict, GdkRectangle *r)
+{
+    XRectangle xr;
+
+    if (r == NULL)
+    {
+        XFixesSetPictureClipRegion (dpy, pict, 0, 0, None);
+        return;
+    }
+    xr.x = r->x;
+    xr.y = r->y;
+    xr.width = r->width;
+    xr.height = r->height;
+    XRenderSetPictureClipRectangles (dpy, pict, 0, 0, &xr, 1);
+}
+
+/* Okna, ktera nepatri k zadne plose a stoji: menu/tooltipy/notifikace (bez klienta), lepkava
+ * okna, plocha, horni lista a Dock. */
+static gboolean
+slide_window_is_static (CWindow *cw)
+{
+    Client *c = cw->c;
+
+    if (c == NULL)
+    {
+        return TRUE;
+    }
+    return (FLAG_TEST (c->flags, CLIENT_FLAG_STICKY) || (c->type & (WINDOW_DESKTOP | WINDOW_DOCK)));
+}
+
+/* Posun obsahu slotu na monitoru o sirce width, kdyz je kamera na cam (px, i zlomky). */
+static gdouble
+slide_offset (gdouble slot, gdouble cam, gint width)
+{
+    return (slot - cam) * width;
+}
+
+/* Rozdeli posun na cele pixely a zbytek; zlomky jen pri pomalem posunu (jinak jsou zbytecne). */
+static gint
+slide_split (ScreenInfo *screen_info, gdouble dx, gint width, gdouble *frac)
+{
+    gint n;
+
+    if (fabs (screen_info->slide_step) * width < SLIDE_SUBPIXEL_MAX_STEP)
+    {
+        n = (gint) floor (dx);
+        *frac = dx - n;
+        if (*frac < 0.02)
+        {
+            *frac = 0.0;
+        }
+        else if (*frac > 0.98)
+        {
+            *frac = 0.0;
+            n++;
+        }
+        return n;
+    }
+    *frac = 0.0;
+    return (gint) lround (dx);
+}
+
+/* Obraz pict posunuty o frac px doprava (bilinearne), nebo bez posunu pro frac = 0. */
+static void
+slide_set_frac (Display *dpy, Picture pict, gdouble frac)
+{
+    XTransform xf = {{{ XDoubleToFixed (1.0), 0, XDoubleToFixed (-frac) },
+                      { 0, XDoubleToFixed (1.0), 0 },
+                      { 0, 0, XDoubleToFixed (1.0) }}};
+
+    XRenderSetPictureTransform (dpy, pict, &xf);
+    XRenderSetPictureFilter (dpy, pict, (frac != 0.0) ? FilterBilinear : FilterNearest, NULL, 0);
+}
+
+static void
+slide_paint_layers (ScreenInfo *screen_info, Picture dst, gdouble cam)
+{
+    Display *dpy;
+    gint i, j;
+
+    dpy = myScreenGetXDisplay (screen_info);
+    for (j = 0; j < screen_info->slide_n_layers; j++)
+    {
+        SlideLayer *layer = &screen_info->slide_layers[j];
+
+        for (i = 0; i < screen_info->slide_n_monitors; i++)
+        {
+            GdkRectangle *r = &screen_info->slide_monitors[i];
+            gdouble frac;
+            gint dx;
+
+            dx = slide_split (screen_info, slide_offset (layer->slot, cam, r->width), r->width, &frac);
+            if (ABS (dx) >= r->width)
+            {
+                continue;
+            }
+            slide_set_clip (dpy, dst, r);
+            if (frac != 0.0)
+            {
+                slide_set_frac (dpy, layer->pict, frac);
+            }
+            XRenderComposite (dpy, PictOpOver, layer->pict, None, dst,
+                              r->x - dx, r->y, 0, 0, r->x, r->y, r->width, r->height);
+            if (frac != 0.0)
+            {
+                slide_set_frac (dpy, layer->pict, 0.0);
+            }
+        }
+    }
+}
+
+static gboolean
+slide_prepare_win (CWindow *cw)
+{
+    if (cw->extents == None)
+    {
+        cw->extents = win_extents (cw);
+    }
+    if (cw->picture == None)
+    {
+        cw->picture = get_window_picture (cw);
+    }
+    if (cw->borderSize == None)
+    {
+        cw->borderSize = border_size (cw);
+    }
+    if (cw->clientSize == None)
+    {
+        cw->clientSize = client_size (cw);
+    }
+    return (cw->picture != None);
+}
+
+static gboolean
+slide_win_paintable (ScreenInfo *screen_info, CWindow *cw)
+{
+    if (!WIN_IS_VISIBLE(cw) || !WIN_IS_DAMAGED(cw) || !WIN_IS_REDIRECTED(cw))
+    {
+        return FALSE;
+    }
+    if ((cw->attr.x + cw->attr.width < 1) || (cw->attr.y + cw->attr.height < 1) ||
+        (cw->attr.x >= screen_info->width) || (cw->attr.y >= screen_info->height))
+    {
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void
+slide_paint_win (CWindow *cw, Picture dst, gint dx, gdouble frac, GdkRectangle *clip)
+{
+    ScreenInfo *screen_info;
+    Display *dpy;
+
+    XserverRegion area, border;
+    XRectangle r;
+
+    screen_info = cw->screen_info;
+    dpy = myScreenGetXDisplay (screen_info);
+
+    if (clip)
+    {
+        r.x = clip->x;
+        r.y = clip->y;
+        r.width = clip->width;
+        r.height = clip->height;
+    }
+    else
+    {
+        r.x = 0;
+        r.y = 0;
+        r.width = screen_info->width;
+        r.height = screen_info->height;
+    }
+    area = XFixesCreateRegion (dpy, &r, 1);
+    /* tvar okna (zaoblene rohy): mimo nej je v pixmape cerno - jako v paint_all () se kresli jen
+     * uvnitr tvaru, stin jen mimo nej (pod pruhlednymi okny by byl videt) */
+    border = XFixesCreateRegion (dpy, NULL, 0);
+    XFixesCopyRegion (dpy, border, cw->borderSize);
+    XFixesTranslateRegion (dpy, border, dx, 0);
+
+    if (cw->shadow)
+    {
+        XserverRegion shadow_clip;
+
+        shadow_clip = XFixesCreateRegion (dpy, NULL, 0);
+        XFixesSubtractRegion (dpy, shadow_clip, area, border);
+        XFixesSetPictureClipRegion (dpy, dst, 0, 0, shadow_clip);
+        XRenderComposite (dpy, PictOpOver, screen_info->blackPicture, cw->shadow,
+                          dst, 0, 0, 0, 0,
+                          cw->attr.x + dx + cw->shadow_dx,
+                          cw->attr.y + cw->shadow_dy,
+                          cw->shadow_width, cw->shadow_height);
+        XFixesDestroyRegion (dpy, shadow_clip);
+    }
+
+    if ((cw->opacity != NET_WM_OPAQUE) && !(cw->alphaPict))
+    {
+        cw->alphaPict = solid_picture (screen_info, FALSE,
+                                       (double) cw->opacity / NET_WM_OPAQUE,
+                                       0.0, 0.0, 0.0);
+    }
+    XFixesIntersectRegion (dpy, area, area, border);
+    XFixesSetPictureClipRegion (dpy, dst, 0, 0, area);
+    XFixesDestroyRegion (dpy, border);
+    XFixesDestroyRegion (dpy, area);
+    if (frac != 0.0)
+    {
+        slide_set_frac (dpy, cw->picture, frac);
+    }
+    /* paint_win () kresli na cw->attr.x - posun jen po dobu kresleni */
+    cw->attr.x += dx;
+    paint_win (cw, None, dst, FALSE);
+    cw->attr.x -= dx;
+    if (frac != 0.0)
+    {
+        slide_set_frac (dpy, cw->picture, 0.0);
+    }
+}
+
+/* Jeden snimek animace pres celou obrazovku do dst, kamera na cam. */
+static void
+slide_paint (ScreenInfo *screen_info, Picture dst, gdouble cam, gint64 now)
+{
+    Display *dpy;
+    GList *list;
+    gboolean layers_done;
+
+    dpy = myScreenGetXDisplay (screen_info);
+    layers_done = (screen_info->slide_n_layers == 0);
+
+    slide_set_clip (dpy, dst, NULL);
+    paint_root (screen_info, dst);
+
+    for (list = g_list_last (screen_info->cwindows); list; list = g_list_previous (list))
+    {
+        CWindow *cw = (CWindow *) list->data;
+        GdkRectangle *mon;
+        gboolean fixed;
+        gdouble frac;
+        gint dx;
+
+        if (!slide_win_paintable (screen_info, cw))
+        {
+            continue;
+        }
+        fixed = slide_window_is_static (cw) ||
+                (screen_info->slide_fixed != None && cw->id == screen_info->slide_fixed);
+        if (!fixed && (cw->c->win_workspace != screen_info->current_ws))
+        {
+            /* okno opustene plochy, ktere se prave skryva - je ve snimku */
+            continue;
+        }
+
+        /* snimky ploch patri nad plochu (xfdesktop) a okna pod normalni vrstvou */
+        if (!layers_done &&
+            !(fixed && cw->c && ((cw->c->type & WINDOW_DESKTOP) || cw->c->win_layer < WIN_LAYER_NORMAL)))
+        {
+            slide_paint_layers (screen_info, dst, cam);
+            layers_done = TRUE;
+        }
+
+        if (!fixed && cw->slide_mapped != 0)
+        {
+            if ((cw->slide_damages < 1) && (now - cw->slide_mapped < SLIDE_NEW_WIN_WAIT_US))
+            {
+                /* jeste neprekreslene okno nove plochy (stary obsah pixmapy) */
+                continue;
+            }
+            cw->slide_mapped = 0;
+        }
+
+        if (!slide_prepare_win (cw))
+        {
+            continue;
+        }
+        frac = 0.0;
+        if (fixed)
+        {
+            dx = 0;
+            mon = NULL;
+        }
+        else
+        {
+            mon = slide_monitor_at (screen_info,
+                                    cw->attr.x + cw->attr.width / 2,
+                                    cw->attr.y + cw->attr.height / 2);
+            dx = slide_split (screen_info, slide_offset (screen_info->slide_live_slot, cam, mon->width),
+                              mon->width, &frac);
+            if (ABS (dx) >= mon->width)
+            {
+                continue;
+            }
+        }
+        slide_paint_win (cw, dst, dx, frac, mon);
+    }
+
+    if (!layers_done)
+    {
+        slide_paint_layers (screen_info, dst, cam);
+    }
+    slide_set_clip (dpy, dst, NULL);
+}
+
+/* Snimek oken aktualni plochy (na jejich mistech, pruhledne pozadi); okno exclude chybi. */
+static Picture
+slide_snapshot (ScreenInfo *screen_info, Window exclude)
+{
+    DisplayInfo *display_info;
+    XRenderPictFormat *format;
+    XRenderColor clear = { 0, 0, 0, 0 };
+    Pixmap pixmap;
+    Picture pict;
+    GList *list;
+
+    display_info = screen_info->display_info;
+    format = XRenderFindStandardFormat (display_info->dpy, PictStandardARGB32);
+    if (format == NULL)
+    {
+        return None;
+    }
+    pixmap = XCreatePixmap (display_info->dpy, screen_info->output,
+                            screen_info->width, screen_info->height, 32);
+    pict = XRenderCreatePicture (display_info->dpy, pixmap, format, 0, NULL);
+    XFreePixmap (display_info->dpy, pixmap);
+    XRenderFillRectangle (display_info->dpy, PictOpSrc, pict, &clear,
+                          0, 0, screen_info->width, screen_info->height);
+
+    for (list = g_list_last (screen_info->cwindows); list; list = g_list_previous (list))
+    {
+        CWindow *cw = (CWindow *) list->data;
+
+        if (!slide_win_paintable (screen_info, cw) || slide_window_is_static (cw) ||
+            (exclude != None && cw->id == exclude) ||
+            (cw->c->win_workspace != screen_info->current_ws))
+        {
+            continue;
+        }
+        if (cw->slide_mapped != 0 && cw->slide_damages < 1)
+        {
+            /* jeste neprekreslene okno (behem predchoziho posunu) */
+            continue;
+        }
+        if (slide_prepare_win (cw))
+        {
+            slide_paint_win (cw, pict, 0, 0.0, NULL);
+        }
+    }
+    slide_set_clip (display_info->dpy, pict, NULL);
+
+    return pict;
+}
+
+static void
+slide_remove_layer (ScreenInfo *screen_info, gint idx)
+{
+    if (screen_info->slide_layers[idx].pict != None)
+    {
+        XRenderFreePicture (myScreenGetXDisplay (screen_info), screen_info->slide_layers[idx].pict);
+    }
+    screen_info->slide_n_layers--;
+    screen_info->slide_layers[idx] = screen_info->slide_layers[screen_info->slide_n_layers];
+}
+
+static void
+slide_stop (ScreenInfo *screen_info)
+{
+    GList *list;
+
+    if (screen_info->slide_timeout_id != 0)
+    {
+        g_source_remove (screen_info->slide_timeout_id);
+        screen_info->slide_timeout_id = 0;
+    }
+    while (screen_info->slide_n_layers > 0)
+    {
+        slide_remove_layer (screen_info, screen_info->slide_n_layers - 1);
+    }
+    for (list = screen_info->cwindows; list; list = g_list_next (list))
+    {
+        ((CWindow *) list->data)->slide_mapped = 0;
+    }
+    screen_info->slide_active = FALSE;
+    screen_info->slide_finished = FALSE;
+    screen_info->slide_fixed = None;
+}
+
+static gboolean
+slide_timeout_cb (gpointer data)
+{
+    ScreenInfo *screen_info = (ScreenInfo *) data;
+
+    if (!screen_info->slide_active)
+    {
+        screen_info->slide_timeout_id = 0;
+        return FALSE;
+    }
+    /* pojistka: kdyby se nekreslilo (napr. ceka se na vsync, ktery neprijde), animace skonci */
+    if (g_get_monotonic_time () - screen_info->slide_start >
+        (gint64) (screen_info->slide_duration + 1000) * 1000)
+    {
+        screen_info->slide_timeout_id = 0;
+        slide_stop (screen_info);
+        damage_screen (screen_info);
+        return FALSE;
+    }
+    /* bez vsync udava tempo snimku tento casovac; s XPresent/GLX se dalsi snimek zada po kazdem
+     * vykresleni v repair_screen () a tempo urcuje vsync */
+    damage_screen (screen_info);
+    return TRUE;
+}
+
+/* Volano z repair_screen () po vykresleni snimku. */
+static void
+slide_after_paint (ScreenInfo *screen_info)
+{
+    if (!screen_info->slide_active)
+    {
+        return;
+    }
+    if (screen_info->slide_finished)
+    {
+        slide_stop (screen_info);
+        damage_screen (screen_info);
+    }
+    else if (slide_vsync (screen_info))
+    {
+        damage_screen (screen_info);
+    }
+}
+
+static gboolean
+slide_allowed (ScreenInfo *screen_info)
+{
+    GtkSettings *settings;
+    gboolean animations;
+
+    if (!screen_info->compositor_active || !screen_info->params->workspace_slide ||
+        screen_info->params->workspace_slide_duration <= 0 ||
+        screen_info->zoomed || screen_info->wins_unredirected > 0 ||
+        screen_info->width <= 0 || screen_info->height <= 0)
+    {
+        return FALSE;
+    }
+    /* "omezit pohyb": GTK enable-animations (XSETTINGS Gtk/EnableAnimations) */
+    animations = TRUE;
+    settings = gtk_settings_get_for_screen (screen_info->gscr);
+    if (settings)
+    {
+        g_object_get (G_OBJECT (settings), "gtk-enable-animations", &animations, NULL);
+    }
+    return animations;
+}
