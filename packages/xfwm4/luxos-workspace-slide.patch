+
+void
+compositorWorkspaceSlide (ScreenInfo *screen_info, gint old_ws, gint new_ws,
+                          gboolean forward, Client *fixed)
+{
+#ifdef HAVE_COMPOSITOR
+    DisplayInfo *display_info;
+    Picture snapshot;
+    Window fixed_id;
+    gdouble cam, new_slot, lo, hi;
+    gint64 now;
+    gint i;
+
+    g_return_if_fail (screen_info != NULL);
+    TRACE ("workspace %i -> %i", old_ws, new_ws);
+
+    display_info = screen_info->display_info;
+    if (!compositorIsUsable (display_info) || (old_ws == new_ws))
+    {
+        return;
+    }
+    if (!slide_allowed (screen_info))
+    {
+        if (screen_info->slide_active)
+        {
+            slide_stop (screen_info);
+            damage_screen (screen_info);
+        }
+        return;
+    }
+
+    now = g_get_monotonic_time ();
+    if (!screen_info->slide_active)
+    {
+        slide_update_monitors (screen_info);
+        screen_info->slide_live_slot = 0.0;
+        cam = 0.0;
+    }
+    else
+    {
+        /* bezi-li uz posun, kamera pokracuje z mista, kde prave je */
+        cam = slide_camera (screen_info, now, NULL);
+    }
+    fixed_id = fixed ? fixed->frame : None;
+
+    /* snimek oken opoustene plochy (okno, ktere jde s uzivatelem na novou plochu, v nem neni) */
+    myDisplayErrorTrapPush (display_info);
+    snapshot = slide_snapshot (screen_info, fixed_id);
+    if ((myDisplayErrorTrapPop (display_info) != 0) || (snapshot == None))
+    {
+        if (snapshot != None)
+        {
+            XRenderFreePicture (display_info->dpy, snapshot);
+        }
+        if (screen_info->slide_active)
+        {
+            slide_stop (screen_info);
+            damage_screen (screen_info);
+        }
+        return;
+    }
+
+    /* nova plocha: ma-li jeste snimek (navrat behem animace), zustava v jejim slotu jako podklad
+     * pod zivymi okny, nez se prekresli; jinak vedle aktualni - dalsi vpravo, predchozi vlevo
+     * (forward: smer, kterym se prepinalo, i pri preteceni z posledni plochy na prvni) */
+    new_slot = screen_info->slide_live_slot + (forward ? 1.0 : -1.0);
+    for (i = 0; i < screen_info->slide_n_layers; i++)
+    {
+        if (screen_info->slide_layers[i].ws == new_ws)
+        {
+            new_slot = screen_info->slide_layers[i].slot;
+            break;
+        }
+    }
+    /* stara plocha jen jednou a ve slotu nove plochy zadna cizi plocha */
+    for (i = screen_info->slide_n_layers - 1; i >= 0; i--)
+    {
+        SlideLayer *layer = &screen_info->slide_layers[i];
+
+        if ((layer->ws == old_ws) ||
+            (layer->ws != new_ws && fabs (layer->slot - new_slot) < 0.5))
+        {
+            slide_remove_layer (screen_info, i);
+        }
+    }
+    /* plochy, ktere uz cestou kamery nebudou videt */
+    lo = MIN (cam, new_slot) - 1.0;
+    hi = MAX (cam, new_slot) + 1.0;
+    for (i = screen_info->slide_n_layers - 1; i >= 0; i--)
+    {
+        SlideLayer *layer = &screen_info->slide_layers[i];
+
+        if ((layer->slot <= lo || layer->slot >= hi) && layer->ws != new_ws)
+        {
+            slide_remove_layer (screen_info, i);
+        }
+    }
+    if (screen_info->slide_n_layers >= SLIDE_MAX_LAYERS)
+    {
+        slide_remove_layer (screen_info, 0);
+    }
+    i = screen_info->slide_n_layers++;
+    screen_info->slide_layers[i].ws = old_ws;
+    screen_info->slide_layers[i].slot = screen_info->slide_live_slot;
+    screen_info->slide_layers[i].pict = snapshot;
+
+    screen_info->slide_live_slot = new_slot;
+    screen_info->slide_cam_from = cam;
+    screen_info->slide_cam_to = new_slot;
+    screen_info->slide_fixed = fixed_id;
+    screen_info->slide_start = now;
+    screen_info->slide_duration = screen_info->params->workspace_slide_duration;
+    screen_info->slide_active = TRUE;
+    screen_info->slide_finished = FALSE;
+
+    if (screen_info->slide_timeout_id == 0)
+    {
+        gint rate;
+
+        /* bez vsync aspon 60 snimku za sekundu (GDK nezna-li obnovovaci frekvenci, hlasi 30 Hz) */
+        rate = MAX (xfwm_get_primary_refresh_rate (screen_info->gscr), 60);
+        screen_info->slide_timeout_id =
+            g_timeout_add_full (TIMEOUT_REPAINT_PRIORITY, MAX (1000 / rate, 4),
+                                slide_timeout_cb, screen_info, NULL);
+    }
+    damage_screen (screen_info);
+#endif /* HAVE_COMPOSITOR */
 }
 
