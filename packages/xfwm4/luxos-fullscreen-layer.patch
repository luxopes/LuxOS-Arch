+/* LuxOS: zamerene celoobrazovkove okno patri do vrstvy celoobrazovkovych oken, nad horni listu
+ * a Dock. Kdyby z ni vypadlo (aktivovalo se okno, ktere zamereni nakonec neprevzalo), vrati ho
+ * do ni klik na okno nebo jeho nova aktivace - jinak by lista zustala pres celou obrazovku. */
+static void
+luxosRestoreFullscreenLayer (Client *c)
+{
+    if (FLAG_TEST (c->flags, CLIENT_FLAG_FULLSCREEN) && (c->win_layer < WIN_LAYER_FULLSCREEN))
+    {
+        TRACE ("restoring fullscreen layer for \"%s\" (0x%lx)", c->name, c->window);
+        clientAdjustFullscreenLayer (c, TRUE);
+    }
+}
