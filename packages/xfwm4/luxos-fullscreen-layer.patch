+/* LuxOS: prevezme okno zamereni urcite (bere vstup, nebo je modalni)? Okno jen s WM_TAKE_FOCUS
+ * (input = False) o zamereni rozhoduje samo - GTK okno s accept-focus = FALSE ho odmitne. */
+gboolean
+luxosClientTakesFocus (Client * c)
+{
+    g_return_val_if_fail (c != NULL, FALSE);
+
+    return (FLAG_TEST (c->flags, CLIENT_FLAG_STATE_MODAL) || FLAG_TEST (c->wm_flags, WM_FLAG_INPUT) ||
+            !c->screen_info->params->focus_hint);
+}
