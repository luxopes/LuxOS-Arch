# Maintainer: LuxOS Team
# Lux Simple Lang - oficialni binarni vydani (staticke ELF, stdlib vedle v /usr/lib/lsl)

pkgname=lsl
pkgver=0.10.7
pkgrel=1
pkgdesc="Lux Simple Lang - self-hosted programming language and toolchain"
arch=(x86_64)
url="https://lsl.lux-ai.cz"
license=(MIT)
depends=(binutils curl)
options=(!strip !debug)
source=("https://lsl.lux-ai.cz/downloads/lsl-$pkgver-linux-x86_64.tar.gz")
sha256sums=('dfabc440ef17bfb61ab72f9d3e4d2107837159762eb092854af270dbcdb96171')

package() {
    cd "lsl-$pkgver"
    # lsl hleda standardni knihovny relativne k /proc/self/exe (../lib/lsl)
    install -Dm755 -t "$pkgdir/usr/bin" bin/lsl bin/lslc bin/luxir bin/lsl-configure bin/lsl-cuda-worker bin/lsl-test
    install -dm755 "$pkgdir/usr/lib"
    cp -r --no-preserve=ownership lib/lsl "$pkgdir/usr/lib/lsl"
    install -Dm644 -t "$pkgdir/usr/share/doc/lsl" README.md RELEASE_NOTES.md
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/lsl/LICENSE"
    install -Dm644 LICENSE-LuxIR-QBE.txt "$pkgdir/usr/share/licenses/lsl/LICENSE-LuxIR-QBE.txt"
}
