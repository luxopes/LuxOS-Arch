# Maintainer: LuxOS Team
# LuxAI - AI asistent pro LuxOS (chat a agent, ktery umi pracovat s pocitacem; Python + GTK 3)
# Zdrojovy archiv vytvori make-source.sh z pracovni kopie ~/LuxAI (aplikace nema verejny repozitar).

pkgname=luxai
pkgver=1.0.0
pkgrel=10
pkgdesc="LuxAI - AI assistant that can work with your computer (chat and agent mode)"
arch=(any)
url="https://lux-ai.cz"
license=(custom)
depends=(python python-gobject gtk3 xdotool wmctrl polkit luxos-account luxos-i18n luxos-docs)
optdepends=('libnotify: desktop notifications from the agent'
            'xdg-utils: open links and files'
            'xclip: clipboard fallback outside GTK'
            'grim: screenshots on Wayland')
install=luxai.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('b3160e0b77dc3f6178efd02e05b96f596628900ef319a596a2db1061164ba176')

package() {
    cd "$pkgname-$pkgver"
    local lib="$pkgdir/usr/lib/luxai"
    # Aplikace hleda i18n/ a data/ relativne k balicku luxai/, proto vse vedle sebe v /usr/lib/luxai
    install -dm755 "$lib"
    cp -r --no-preserve=ownership luxai i18n data "$lib/"
    chmod -R u=rwX,go=rX "$lib"
    install -dm755 "$pkgdir/usr/bin"
    cat >"$pkgdir/usr/bin/luxai" <<'SH'
#!/bin/sh
# Spoustec LuxAI (balicek luxai)
exec python3 /usr/lib/luxai/luxai/__main__.py "$@"
SH
    chmod 755 "$pkgdir/usr/bin/luxai"
    install -Dm644 data/luxai.desktop "$pkgdir/usr/share/applications/luxai.desktop"
    install -Dm644 data/luxai.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/luxai.png"
    local s
    for s in 256 128 64 48 32 24 16; do
        install -Dm644 "data/icons/luxai-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x$s/apps/luxai.png"
    done
    install -Dm644 README.md "$pkgdir/usr/share/doc/luxai/README.md"
    # Rezim spravce: pomocnik spousteny pres pkexec (luxai-root vzdy heslo, luxai-root-auto bez hesla jen
    # s pravidlem 49-luxai-root-<uzivatel>.rules, ktere zapina/vypina luxai-root-setup). Kopie, ne odkaz:
    # polkit rozlisuje akce podle cesty programu.
    install -Dm755 data/root/luxai-root "$lib/luxai-root"
    install -Dm755 data/root/luxai-root "$lib/luxai-root-auto"
    install -Dm755 data/root/luxai-root-setup "$lib/luxai-root-setup"
    install -Dm644 data/root/org.luxai.root.policy "$pkgdir/usr/share/polkit-1/actions/org.luxai.root.policy"
    rm -rf "$lib/data/root"
}
