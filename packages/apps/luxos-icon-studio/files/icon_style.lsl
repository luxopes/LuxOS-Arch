# Styl Icon Studia: jen vlastni tridy, barvy odvozene z motivu (svetly i tmavy rezim);
# tlacitka, pole a hlavicku okna kresli motiv LuxOS jako u ostatnich aplikaci.
CSS = ".icon-studio headerbar button.suggested-action { background-color: @theme_selected_bg_color; background-image: none; color: #ffffff; border-color: transparent; padding: 3px 12px; }\n.icon-studio headerbar button.suggested-action label { color: #ffffff; }\n.icon-studio .muted { opacity: 0.6; font-size: 11px; }\n.icon-studio .section-title { font-size: 12px; font-weight: 700; opacity: 0.8; }\n.icon-studio .layers-pane { background-color: alpha(currentColor, 0.035); border-right: 1px solid alpha(currentColor, 0.09); }\n.icon-studio .inspector-pane { background-color: alpha(currentColor, 0.02); border-left: 1px solid alpha(currentColor, 0.09); }\n.icon-studio .pane-title { font-size: 15px; font-weight: 700; }\n.icon-studio .pane-subtitle { opacity: 0.6; font-size: 11px; }\n.icon-studio .layer-list { background: transparent; padding: 0 8px; }\n.icon-studio button.layer-row { border: none; background: none; box-shadow: none; border-radius: 8px; padding: 6px 8px; }\n.icon-studio button.layer-row:hover { background-color: alpha(currentColor, 0.06); }\n.icon-studio button.layer-row.selected { background-color: alpha(@theme_selected_bg_color, 0.15); }\n.icon-studio button.layer-row.selected .layer-name { color: @theme_selected_bg_color; }\n.icon-studio .layer-name { font-size: 12px; font-weight: 600; }\n.icon-studio .layer-kind { opacity: 0.55; font-size: 10px; }\n.icon-studio .layer-glyph { color: @theme_selected_bg_color; background-color: alpha(currentColor, 0.05); border: 1px solid alpha(currentColor, 0.10); border-radius: 7px; min-width: 28px; min-height: 28px; font-size: 15px; }\n.icon-studio .tools { border-top: 1px solid alpha(currentColor, 0.09); padding: 4px 6px; }\n.icon-studio .field-caption { opacity: 0.6; font-size: 11px; }\n.icon-studio .property-label { opacity: 0.75; font-size: 12px; }\n.icon-studio .property-card { background-color: alpha(currentColor, 0.035); border: 1px solid alpha(currentColor, 0.08); border-radius: 10px; padding: 12px; }\n.icon-studio .inspector-scroll { background: transparent; }\n.icon-studio spinbutton entry { min-width: 38px; }\n.icon-studio .canvas-toolbar { padding: 6px 14px; border-bottom: 1px solid alpha(currentColor, 0.09); }\n.icon-studio .canvas-toolbar .workspace-title { font-weight: 600; }\n.icon-studio .canvas-bottom { padding: 4px 14px; border-top: 1px solid alpha(currentColor, 0.09); }\n.icon-studio .canvas-bottom label { opacity: 0.6; font-size: 11px; }\n.icon-studio .preview-strip { padding: 10px 16px 14px; border-top: 1px solid alpha(currentColor, 0.09); }\n.icon-studio .preview-title { font-size: 12px; font-weight: 700; opacity: 0.8; }\n.icon-studio .preview-tile { background-color: alpha(currentColor, 0.035); border: 1px solid alpha(currentColor, 0.08); border-radius: 10px; padding: 8px 14px; }\n.icon-studio .preview-caption { opacity: 0.6; font-size: 10px; }\n.icon-studio .statusbar { border-top: 1px solid alpha(currentColor, 0.09); padding: 4px 14px; }\n.icon-studio .statusbar label { opacity: 0.6; font-size: 11px; }\n"
