{
  "version": 1,
  "comment": "LuxOS Mail - sign in with the provider (OAuth2 for native apps, RFC 8252: system browser, loopback redirect, PKCE S256). Empty client_id = the provider is offered with an app password only. Register own clients (docs/proposals/mail-oauth-registration.md); never use another app's client IDs. Override: /etc/luxos/mail-oauth.json.",
  "providers": {
    "google": {
      "name": "Google",
      "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "revoke_url": "https://oauth2.googleapis.com/revoke",
      "scope": "https://mail.google.com/ openid email",
      "auth_params": {"access_type": "offline", "prompt": "consent"},
      "client_id": "",
      "client_secret": "",
      "secret_required": true,
      "redirect_host": "127.0.0.1",
      "redirect_port": 0,
      "imap": {"host": "imap.gmail.com", "port": 993, "security": "ssl"},
      "smtp": {"host": "smtp.gmail.com", "port": 465, "security": "ssl"}
    },
    "microsoft": {
      "name": "Microsoft",
      "auth_url": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "token_url": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scope": "https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send offline_access openid email",
      "auth_params": {"prompt": "select_account"},
      "client_id": "",
      "client_secret": "",
      "refresh_scope": true,
      "redirect_host": "localhost",
      "redirect_port": 0,
      "consumer_token_url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
      "sasl": "XOAUTH2",
      "imap": {"host": "outlook.office365.com", "port": 993, "security": "ssl"},
      "imap_alternates": [{"host": "imap-mail.outlook.com", "port": 993, "security": "ssl"}],
      "smtp": {"host": "smtp.office365.com", "port": 587, "security": "starttls"}
    },
    "yahoo": {
      "name": "Yahoo",
      "enabled": false,
      "auth_url": "https://api.login.yahoo.com/oauth2/request_auth",
      "token_url": "https://api.login.yahoo.com/oauth2/get_token",
      "scope": "mail-w openid email",
      "client_id": "",
      "client_secret": "",
      "secret_required": true,
      "redirect_host": "127.0.0.1",
      "redirect_port": 0,
      "imap": {"host": "imap.mail.yahoo.com", "port": 993, "security": "ssl"},
      "smtp": {"host": "smtp.mail.yahoo.com", "port": 465, "security": "ssl"}
    },
    "aol": {
      "name": "AOL",
      "enabled": false,
      "auth_url": "https://api.login.aol.com/oauth2/request_auth",
      "token_url": "https://api.login.aol.com/oauth2/get_token",
      "scope": "mail-w openid email",
      "client_id": "",
      "client_secret": "",
      "secret_required": true,
      "redirect_host": "127.0.0.1",
      "redirect_port": 0,
      "imap": {"host": "imap.aol.com", "port": 993, "security": "ssl"},
      "smtp": {"host": "smtp.aol.com", "port": 465, "security": "ssl"}
    }
  }
}
