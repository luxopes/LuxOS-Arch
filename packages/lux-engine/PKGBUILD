# Maintainer: LuxOS Team
# Upstream PKGBUILD: Levente Polyak <anthraxx[at]archlinux[dot]org>, Morten Linderud <foxboron@archlinux.org>
#
# lux-engine: jadro spravce baliku lux - libalpm a nastroje pacmanu z Arch Linuxu (libalpm pro pyalpm
# a lux, makepkg, vercmp, repo-add, hooky a konfigurace). Zdroje, kontrolni soucty, zaplaty, build()
# a check() jsou PRESNE podle Arch Linuxu: https://gitlab.archlinux.org/archlinux/packaging/packages/pacman
# tag 7.1.0.r9.g54d9411-3 (soubory 0001-*.patch, 0002-*.patch, makepkg.conf, alpm.sysusers,
# fortran.conf, rust.conf a keys/pgp/ jsou z tohoto tagu beze zmeny).
#
# Rozdily oproti Archu (jen v package(), zamerne co nejmensi):
#  - v LuxOS neni zadny prikaz pacman: pacman, pacman-key, pacman-conf a pacman-db-upgrade jsou
#    interni nastroje lux v /usr/lib/lux/alpm/bin (mimo PATH). Pouzivaji je lux, makepkg (pres
#    /etc/makepkg.conf.d/lux-engine.conf), hooky a skriptlety (dedi PATH od lux), sluzby
#    (drop-iny v /usr/lib/systemd/system/*.d/lux-engine.conf) a nastroje LuxOS (PATH si nastavi samy).
#    /usr/lib/lux/alpm/pacman je odkaz pro starsi volajici (LuxOS 0.9).
#  - bez manualovych stranek a doplnovani prikazu pacman*; doplnovani makepkg zustava
#  - klice z klicenek (archlinux-keyring, luxos-keyring) nacita hook lux-engine-keyrings: jejich
#    instalacni skripty volaji /usr/bin/pacman-key, ktery v LuxOS neni
#  - /etc/pacman.conf je konfigurace LuxOS (shodna s luxos-installer/files/pacman.conf, aby
#    nahrazeni baliku na existujicich instalacich nevytvorilo pacman.conf.pacnew)
#  - $pkgname -> $_srcname (adresar zdroju), options=(!debug) jako ostatni baliky LuxOS
#  - provides/conflicts/replaces: nahrazuje pacman i luxos-pacman (LuxOS 0.9); zavislosti "pacman"
#    a libalpm.so plati dal
#
# Aktualizace (vzdy, kdyz Arch vyda novy pacman - container-build.sh na to upozorni):
#   prevzit z noveho tagu pkgver, pkgrel, _git_tag, _git_patch_level_commit, source, sha256sums,
#   validpgpkeys, keys/pgp, soubory zaplat a konfigurace; build()/check()/package() porovnat.
#   pyalpm v Archu se sestavuje proti pacmanu z Archu (libalpm.so) - lux-engine musi drzet krok.
#   pkgrel je pkgrel Archu (tag v hlavicce); jen sestaveni LuxOS bez zmeny v Archu: X.1, X.2, ...

pkgname=lux-engine
_srcname=pacman
pkgver=7.1.0.r9.g54d9411
pkgrel=3.1
# use annotated tag and patch level commit from release branch (can be empty for no patches)
_git_tag=7.1.0
_git_patch_level_commit=54d94116164b0b2202c6061c4a59c6f3e70820d8
pkgdesc="Package engine of lux (libalpm and build tools from Arch Linux pacman)"
arch=('x86_64')
url="https://www.archlinux.org/pacman/"
license=('GPL-2.0-or-later')
depends=(
  bash
  coreutils
  curl libcurl.so
  gawk
  gettext
  glibc
  gnupg
  gpgme libgpgme.so
  grep
  libarchive libarchive.so
  openssl libcrypto.so
  pacman-mirrorlist
  systemd
  libmakepkg-dropins
)
makedepends=(
  asciidoc
  doxygen
  git
  meson
)
checkdepends=(
  fakechroot
  python
)
optdepends=(
  'base-devel: required to use makepkg'
  'perl-locale-gettext: translation support in makepkg-template'
)
provides=("pacman=${pkgver}" 'libalpm.so' "luxos-pacman=${pkgver}")
conflicts=('pacman' 'luxos-pacman')
replaces=('pacman' 'luxos-pacman')
options=(!debug)
backup=(etc/pacman.conf
        etc/makepkg.conf
        etc/makepkg.conf.d/fortran.conf
        etc/makepkg.conf.d/rust.conf)
validpgpkeys=('6645B0A8C7005E78DB1D7864F99FFE0FEAE999BD'  # Allan McRae <allan@archlinux.org>
              'B8151B117037781095514CA7BBDFFC92306B1121') # Andrew Gregory (pacman) <andrew@archlinux.org>
# Arch: jeste pacman.conf (LuxOS ma vlastni, viz package())
source=("git+https://gitlab.archlinux.org/pacman/pacman.git?signed#tag=v${_git_tag}"
        "revertme-makepkg-remove-libdepends-and-libprovides.patch::https://gitlab.archlinux.org/pacman/pacman/-/commit/354a300cd26bb1c7e6551473596be5ecced921de.patch"
        "patch-reproducible-builds.patch::https://gitlab.archlinux.org/pacman/pacman/-/commit/f4bdb77470528019aaba4d8b8f947e918c6db17d.patch"
        '0001-libalpm-invalidate-curl-data-in-child.patch'
        '0002-libalpm-use-curl-s-effective-url-without-authenticat.patch'
        makepkg.conf
        alpm.sysusers
        fortran.conf
        rust.conf)
sha256sums=('74cfd4b6d2b10c742f5a4a7cdaeffb01405ab897b11b80681a9063245113a308'
            'b3bce9d662e189e8e49013b818f255d08494a57e13fc264625f852f087d3def2'
            'de428b496a825772ef49ec5555a386a4b23ffa10b9dfd9907f0671d5c1dc2178'
            '9a734e5d75be603d58aa92e8d29a15466b3ac2af6b7d6f6728dd5c3e5ed8758d'
            '021893dd44ec23251cfc0f2b81c12d832927ea60095d4d2956d9760e8bbfaa58'
            '20497c90cbb678a9ca1a71eca66cf2a1d0c991c3e695f7b7d10fb68fc0ac4f12'
            '9c14afbc7dabee5a563202c833a043bd3b80c4522f8943c33d550641d7d1bbf1'
            '933b0b878fa611bf24b92f655040a3bcb4a1b67841d929013802abbb09b2ccf4'
            '6fe03e6ea3f69d99d59a48847a8ae97c2160fca847c7aedf7b89d05e4aa9386d')

pkgver() {
  cd "$_srcname"
  git describe --abbrev=7 --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_srcname"

  # apply patch level commits on top of annotated tag
  if [[ -n ${_git_patch_level_commit} ]]; then
    if [[ v${_git_tag} != $(git describe --tags --abbrev=0 "${_git_patch_level_commit}") ]] then
      error "patch level commit ${_git_patch_level_commit} is not a descendant of v${_git_tag}"
      exit 1
    fi
    git rebase "${_git_patch_level_commit}"
  fi

  # handle patches
  local -a patches
  patches=($(printf '%s\n' "${source[@]}" | grep '.patch'))
  patches=("${patches[@]%%::*}")
  patches=("${patches[@]##*/}")

  if (( ${#patches[@]} != 0 )); then
    for patch in "${patches[@]}"; do
      if [[ $patch =~ revertme-* ]]; then
        msg2 "Reverting patch $patch..."
        patch -RNp1 < "../$patch"
      else
        msg2 "Applying patch $patch..."
        patch -Np1 < "../$patch"
      fi
    done
  fi
}

build() {
  cd "$_srcname"

  meson --prefix=/usr \
        --buildtype=plain \
        -Ddoc=enabled \
        -Ddoxygen=enabled \
        -Dscriptlet-shell=/usr/bin/bash \
        -Dldconfig=/usr/bin/ldconfig \
        build

  meson compile -C build
}

check() {
  cd "$_srcname"

  meson test -C build
}

package() {
  cd "$_srcname"

  DESTDIR="$pkgdir" meson install -C build

  # install Arch specific stuff
  install -dm755 "$pkgdir/etc"
  # LuxOS: pacman.conf LuxOS misto Archu
  install -m644 "$startdir/pacman.conf" "$pkgdir/etc"
  install -m644 "$srcdir/makepkg.conf" "$pkgdir/etc"
  install -D -m644 "$srcdir/alpm.sysusers" "${pkgdir}"/usr/lib/sysusers.d/alpm.conf
  install -m644 "$srcdir/fortran.conf" "$pkgdir/etc/makepkg.conf.d"
  install -m644 "$srcdir/rust.conf" "$pkgdir/etc/makepkg.conf.d"

  local wantsdir="$pkgdir/usr/lib/systemd/system/sockets.target.wants"
  install -dm755 "$wantsdir"

  local unit
  for unit in dirmngr gpg-agent gpg-agent-{browser,extra,ssh} keyboxd; do
    ln -s "../${unit}@.socket" "$wantsdir/${unit}@etc-pacman.d-gnupg.socket"
  done

  # LuxOS: nastroje jadra mimo PATH (prikaz pacman v LuxOS neni, spravcem baliku je lux)
  local engine="$pkgdir/usr/lib/lux/alpm" tool
  install -dm755 "$engine/bin"
  for tool in pacman pacman-key pacman-conf pacman-db-upgrade; do
    mv "$pkgdir/usr/bin/$tool" "$engine/bin/$tool"
  done
  ln -s bin/pacman "$engine/pacman"   # cesta z LuxOS 0.9
  if compgen -G "$pkgdir/usr/bin/*pacman*" >/dev/null; then
    error "pacman command left in /usr/bin"; return 1
  fi
  install -m644 "$startdir/makepkg-lux-engine.conf" "$pkgdir/etc/makepkg.conf.d/lux-engine.conf"

  # sluzby, ktere nastroje jadra volaji jmenem (pacman-contrib, archlinux-keyring)
  for unit in archlinux-keyring-wkd-sync paccache pacman-filesdb-refresh; do
    install -Dm644 "$startdir/systemd/$unit.conf" "$pkgdir/usr/lib/systemd/system/$unit.service.d/lux-engine.conf"
  done

  # klice z klicenek (jejich instalacni skripty hledaji /usr/bin/pacman-key)
  install -Dm644 "$startdir/lux-engine-keyrings.hook" "$pkgdir/usr/share/libalpm/hooks/lux-engine-keyrings.hook"
  install -Dm755 "$startdir/lux-engine-keyrings" "$pkgdir/usr/share/libalpm/scripts/lux-engine-keyrings"

  # bez manualovych stranek a doplnovani prikazu pacman*; doplnovani makepkg zustava
  local man
  for man in man8/pacman.8 man8/pacman-key.8 man8/pacman-conf.8 man8/pacman-db-upgrade.8 man5/pacman-hooks.5; do
    rm -f "$pkgdir/usr/share/man/$man"
  done
  local bc="$pkgdir/usr/share/bash-completion/completions"
  rm "$bc/makepkg" "$bc/pacman-key"           # odkazy na soubor pacman
  mv "$bc/pacman" "$bc/makepkg"
  sed -i -e '/^complete -F _pacman pacman$/d' -e '/^complete -F _pacman_key .*pacman-key$/d' "$bc/makepkg"
  local zc="$pkgdir/usr/share/zsh/site-functions"
  mv "$zc/_pacman" "$zc/_makepkg"
  sed -i '1s/^#compdef .*/#compdef makepkg/' "$zc/_makepkg"
  if grep -q '^complete .*pacman' "$bc/makepkg" || [[ $(head -1 "$zc/_makepkg") != '#compdef makepkg' ]] ||
     compgen -G "$pkgdir/usr/share/man/man8/pacman*" >/dev/null; then
    error "pacman completion or manual page left"; return 1
  fi
}

