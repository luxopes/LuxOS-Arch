+	snprintf(regstr, PATH_MAX, "^%s\\.luxsave\\.([[:digit:]]+)$", basename);
 	if(regcomp(&reg, regstr, REG_EXTENDED | REG_NEWLINE) != 0) {
 		goto cleanup;
 	}
@@ -387,7 +387,7 @@ static void shift_pacsave(alpm_handle_t *handle, const char *file)
 
 		if(regexec(&reg, ent->d_name, 0, 0, 0) == 0) {
 			unsigned long cur_log;
-			cur_log = strtoul(ent->d_name + basename_len + strlen(".pacsave."), NULL, 10);
+			cur_log = strtoul(ent->d_name + basename_len + strlen(".luxsave."), NULL, 10);
 			if(cur_log > log_max) {
 				log_max = cur_log;
 			}
@@ -397,8 +397,8 @@ static void shift_pacsave(alpm_handle_t *handle, const char *file)
 	/* Shift pacsaves */
 	unsigned long i;
 	for(i = log_max + 1; i > 1; i--) {
