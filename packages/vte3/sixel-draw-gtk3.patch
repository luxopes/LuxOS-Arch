@@ -10212,6 +10212,27 @@
                   m_cell_width,
                   m_cell_height);
 
+#if WITH_SIXEL && VTE_GTK == 3
+        /* LuxOS: draw SIXEL images over the text rows (upstream left this as a FIXME
+         * since the drawing rework; GTK 3 only, with the cairo drawing context). */
+        if (m_images_enabled && !m_screen->row_data->image_map().empty()) {
+                auto const last_row = last_displayed_row();
+                auto cr = m_draw.cairo();
+                auto const& image_map = m_screen->row_data->image_map();
