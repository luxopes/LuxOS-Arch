[Desktop Entry]
Type=Application
Name=Terminal
Name[cs]=Terminál
Name[sk]=Terminál
Name[pl]=Terminal
Name[uk]=Термінал
Name[hu]=Terminál
Name[de]=Terminal
Name[fr]=Terminal
Name[es]=Terminal
Name[it]=Terminale
Name[pt]=Terminal
Name[nl]=Terminal
Name[sv]=Terminal
Comment=Use the command line
Comment[cs]=Příkazový řádek
Comment[sk]=Príkazový riadok
Comment[pl]=Wiersz poleceń
Comment[uk]=Командний рядок
Comment[hu]=Parancssor
Comment[de]=Befehlszeile verwenden
Comment[fr]=Utiliser la ligne de commande
Comment[es]=Usar la línea de órdenes
Comment[it]=Usa la riga di comando
Comment[pt]=Utilizar a linha de comandos
Comment[nl]=De opdrachtregel gebruiken
Comment[sv]=Använd kommandoraden
Exec=luxos-terminal
Icon=utilities-terminal
Terminal=false
StartupNotify=true
StartupWMClass=luxos-terminal
Categories=System;TerminalEmulator;GTK;
Keywords=terminal;console;shell;command line;bash;lsh;
Keywords[cs]=terminál;terminal;konzole;příkazový řádek;prikazovy radek;shell;bash;lsh;
Keywords[sk]=terminál;konzola;príkazový riadok;shell;bash;lsh;
Keywords[pl]=terminal;konsola;wiersz poleceń;shell;bash;lsh;
Keywords[uk]=термінал;консоль;командний рядок;terminal;shell;bash;lsh;
Keywords[hu]=terminál;konzol;parancssor;shell;bash;lsh;
Keywords[de]=Terminal;Konsole;Befehlszeile;Shell;bash;lsh;
Keywords[fr]=terminal;console;ligne de commande;shell;bash;lsh;
Keywords[es]=terminal;consola;línea de órdenes;shell;bash;lsh;
Keywords[it]=terminale;console;riga di comando;shell;bash;lsh;
Keywords[pt]=terminal;consola;linha de comandos;shell;bash;lsh;
Keywords[nl]=terminal;console;opdrachtregel;shell;bash;lsh;
Keywords[sv]=terminal;konsol;kommandorad;skal;bash;lsh;
Actions=new-window;
# xdg-terminal-exec (Terminal=true v jinych .desktop): prikaz za -x
X-TerminalArgExec=-x
X-TerminalArgDir=--working-directory=
X-TerminalArgTitle=--title=
X-TerminalArgHold=--hold

[Desktop Action new-window]
Name=New Window
Name[cs]=Nové okno
Name[sk]=Nové okno
Name[pl]=Nowe okno
Name[uk]=Нове вікно
Name[hu]=Új ablak
Name[de]=Neues Fenster
Name[fr]=Nouvelle fenêtre
Name[es]=Ventana nueva
Name[it]=Nuova finestra
Name[pt]=Nova janela
Name[nl]=Nieuw venster
Name[sv]=Nytt fönster
Exec=luxos-terminal --window
