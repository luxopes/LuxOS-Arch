#!/bin/sh
# Lux Guard - pomocnik v sezeni uzivatele: spusti program luxos-guard-agent (LSL, zdroj luxos-guard-agent.lsl).
# Soubor je zaroven platny Python: drivejsi pomocnik v Pythonu se po aktualizaci baliku spousti znovu jako
# "python3 /usr/bin/luxos-guard-agent" a timto prejde na novou verzi bez odhlaseni.
''''exec "${LUXOS_GUARD_AGENT_BIN:-/usr/lib/luxos-guard/luxos-guard-agent}" "$@" # '''
import os  # noqa: E402
import sys  # noqa: E402

AGENT = os.environ.get("LUXOS_GUARD_AGENT_BIN") or "/usr/lib/luxos-guard/luxos-guard-agent"
os.execv(AGENT, [AGENT] + sys.argv[1:])
