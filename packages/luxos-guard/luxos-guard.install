# Lux Guard: sluzbu a casovac snimku zapnout hned pri instalaci (i v chrootu instalatoru)
# a po aktualizaci restartovat (nova pravidla). Snimky se v live ISO nedelaji (Condition v jednotce).
# Antivirus: denni aktualizace databaze a tydenni kontrola; clamd sam nebezi (spousti ho sluzba na vyzadani)
_units="luxos-guard.service luxos-guard-snapshot.timer luxos-guard-freshclam.timer luxos-guard-virus-scan.timer"
_agent=/usr/lib/luxos-guard/luxos-guard-agent

# Pomocnik v sezeni je setgid skupina luxos-guard: sluzba podle ni pozna skutecny luxos-guard-agent
# (jiny program uzivatele si nesmi sam odpovidat na dotazy). Bezici pomocnik zmenu prav pozna a do par
# sekund prejde na nove spusteny program - bez odhlaseni.
_agent_perms() {
    systemd-sysusers luxos-guard.conf >/dev/null 2>&1 || true
    if getent group luxos-guard >/dev/null 2>&1; then
        { chgrp luxos-guard "$_agent" && chmod 2755 "$_agent"; } || true
    fi
}

post_install() {
    _agent_perms
    # shellcheck disable=SC2086  # seznam jednotek se zamerne rozdeli na slova
    systemctl enable $_units >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        # shellcheck disable=SC2086
        systemctl start $_units >/dev/null 2>&1 || true
        _first_database
    fi
}

# Bez databaze signatur antivirus nefunguje: prvni stazeni hned na pozadi (~200 MB, jinak az casovac)
_first_database() {
    ls /var/lib/clamav/*.cvd /var/lib/clamav/*.cld >/dev/null 2>&1 ||
        systemctl start --no-block luxos-guard-freshclam.service >/dev/null 2>&1 || true
}

post_upgrade() {
    _agent_perms
    # shellcheck disable=SC2086
    systemctl enable $_units >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl try-restart luxos-guard.service >/dev/null 2>&1 || true
        # shellcheck disable=SC2086
        systemctl start $_units >/dev/null 2>&1 || true
        _first_database
    fi
}

pre_remove() {
    # shellcheck disable=SC2086
    systemctl disable --now $_units >/dev/null 2>&1 || true
}
