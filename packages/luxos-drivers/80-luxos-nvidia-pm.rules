# LuxOS - automaticka sprava napajeni (runtime PM) grafiky NVIDIA a jejiho zvuku/USB-C
# Po navazani ovladace muze jadro kartu uspat; po odpojeni ovladace zustane zapnuta.
ACTION=="bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", TEST=="power/control", ATTR{power/control}="on"
# Zvuk HDMI a USB-C radic na karte: bez uspani by drzely celou kartu probuzenou
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x040300", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x0c0330|0x0c8000", TEST=="power/control", ATTR{power/control}="auto"
