# LuxOS - luxos-drivers: oprava po starsich verzich
post_upgrade() {
    # Do 1.0.0-3 instalator zapinal nvidia-suspend/resume/hibernate i pro open moduly NVIDIA.
    # Od ovladace 595 uspani resi jadro a Arch tyto sluzby pro open moduly vypina (nvidia-utils.install);
    # ponechavaji se jen pro legacy 580xx (nvidia-580xx-utils je zapina sam).
    # Primo databaze (-Q by nvidia-utils nasel i pres "provides" legacy baliku). Skriptlet muze bezet
    # jeste pod starym rozlozenim (aktualizace z LuxOS do 0.9.5: databaze se presouva az po transakci).
    if (( $(vercmp "$2" 1.0.0-4) < 0 )) && { compgen -G '/var/lib/lux/local/nvidia-utils-[0-9]*' ||
        compgen -G '/var/lib/pacman/local/nvidia-utils-[0-9]*'; } >/dev/null; then
        local s
        for s in nvidia-suspend nvidia-resume nvidia-hibernate nvidia-suspend-then-hibernate; do
            systemctl is-enabled --quiet "$s" 2>/dev/null && systemctl disable "$s" 2>/dev/null
        done
    fi
    return 0
}
