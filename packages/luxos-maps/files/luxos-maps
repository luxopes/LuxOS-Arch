    def select_place(self, place, zoom=None, fit=False):
        self.place = dict(place)
        self.map.marker = {"lat": place["lat"], "lon": place["lon"]}
        self.pl_name.set_text(place.get("name") or lm.format_coords(place["lat"], place["lon"]))
        self.pl_addr.set_text(place.get("address") or "")
        self.pl_addr.set_visible(bool(place.get("address")))
        self.pl_coords.set_text(lm.format_coords(place["lat"], place["lon"]))
        self.pl_status.set_text("")
        self.pl_departures.set_visible(lm.is_transit_place(place))
        extra = []
        for key, text in (("platforms", _("Platforms: %s")), ("opening_hours", _("Opening hours: %s")),
                          ("phone", _("Phone: %s")), ("website", _("Website: %s"))):
            v = place.get(key)
            if v:
                extra.append(text % (", ".join(v) if isinstance(v, list) else v))
        self.pl_extra.set_text("\n".join(extra))
        self.pl_extra.set_visible(bool(extra))
        self.update_place_buttons()
        self.show_page("place")
        bb = place.get("bbox")
        if fit and bb and (bb[1] - bb[0] > 0.002 or bb[3] - bb[2] > 0.002):
            self.map.fit_bbox(bb[0], bb[1], bb[2], bb[3])
        else:
            self.map.fly_to(place["lat"], place["lon"], zoom or max(self.map.zoom, 16))
        self.map.queue_draw()

