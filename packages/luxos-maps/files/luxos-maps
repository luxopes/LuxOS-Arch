    def on_search_changed(self, entry):
        if not entry.get_text().strip():
            self.map.results = []
            self.map.queue_draw()
            if self.stack.get_visible_child_name() == "results":
                self.show_page("home")

    def on_search(self, _e=None, text=None):
        text = (text if text is not None else self.search_entry.get_text()).strip()
        if len(text) < 2:
            return
        c = lm.parse_coords(text)
        if c:
            self.select_place({"name": c[2] or lm.format_coords(c[0], c[1]), "lat": c[0], "lon": c[1]}, zoom=16)
            return
        self.search_gen += 1
        gen = self.search_gen
        for row in self.res_list.get_children():
            row.destroy()
        self.res_status.set_visible(False)
        self.res_spinner.start()
        self.res_title.set_text(_("Results").upper())
        self.results_kind = "search"
        self.show_page("results")
        near = self.map.bbox() if self.map.get_mapped() else None

        def work():
            try:
                res, err = lm.search(text, LANG, near=near, cfg=self.cfg), None
            except lm.MapsError as e:
                res, err = [], str(e)
            GLib.idle_add(self.search_done, gen, res, err)
        threading.Thread(target=work, daemon=True).start()

    def search_done(self, gen, res, err):
        if gen != self.search_gen:
            return False
        self.res_spinner.stop()
        self.results = res
        self.map.results = res
        self.map.queue_draw()
        if err:
            self.res_status.set_text(_("Search failed. Check your internet connection.") + f"\n({err})")
        elif not res:
            self.res_status.set_text(_("No places found."))
        self.res_status.set_visible(bool(err) or not res)
        for p in res:
            row = Gtk.ListBoxRow()
            row.place = p
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            vb.pack_start(label(p["name"], "row-name", ellipsize=3), False, False, 0)
            if p.get("address"):
                vb.pack_start(label(p["address"], "dim small", wrap=True, max_width_chars=40), False, False, 0)
            row.add(vb)
            row.show_all()
            self.res_list.add(row)
        if len(res) == 1:
            self.select_place(res[0], fit=True)
        elif res:
            s = min(p["lat"] for p in res)
            n = max(p["lat"] for p in res)
            w = min(p["lon"] for p in res)
            e = max(p["lon"] for p in res)
            if n - s < 30 and e - w < 60:      # vysledky blizko sebe: ukazat vsechny
                self.map.fit_bbox(s, n, w, e, max_zoom=15)
        return False

