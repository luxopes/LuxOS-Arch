    def draw_compass(self, widget, cr):
        """Strelka severu podle otoceni mapy (klik: po smeru jizdy / sever nahore)."""
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        cr.translate(w / 2, h / 2)
        cr.rotate(self.map.rotation)
        c = widget.get_style_context().get_color(widget.get_state_flags())
        for sign, rgb in ((-1, (0.9, 0.23, 0.2)), (1, (c.red, c.green, c.blue))):
            cr.move_to(0, sign * 10)
            cr.line_to(4, 0)
            cr.line_to(-4, 0)
            cr.close_path()
            cr.set_source_rgb(*rgb)
            cr.fill()
        return False

    def update_compass_tip(self):
        self.nav_compass.set_tooltip_text(_("Heading Up – click for North Up") if self.cfg["nav_heading_up"]
                                          else _("North Up – click for Heading Up"))

