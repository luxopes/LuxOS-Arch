    def favorite_index(self, place):
        for i, f in enumerate(self.cfg["favorites"]):
            if lm.same_place(f, place):
                return i
        return None

    def toggle_favorite(self, place=None):
        place = place or self.place
        if not place:
            return
        idx = self.favorite_index(place)
        if idx is None:
            self.cfg["favorites"].append({k: place[k] for k in ("name", "lat", "lon", "address") if k in place})
        else:
            del self.cfg["favorites"][idx]
        lm.save_config(self.cfg)
        self.rebuild_favorites()
        self.update_place_buttons()

    def remove_favorite(self, idx):
        if 0 <= idx < len(self.cfg["favorites"]):
            del self.cfg["favorites"][idx]
            lm.save_config(self.cfg)
            self.rebuild_favorites()
            self.update_place_buttons()

