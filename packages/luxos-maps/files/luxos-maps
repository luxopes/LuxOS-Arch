class MapView(Gtk.DrawingArea):
    """Posuvna mapa: tazeni (se setrvacnosti), kolecko/touchpad = plynuly zoom k mysi, klavesy."""

    def __init__(self, tile_url, lat, lon, zoom):
        super().__init__(can_focus=True, hexpand=True, vexpand=True)
        self.mx, self.my = lm.to_world(lat, lon)
        self.zoom = zoom
        self.dark = False
        self.mem = {}                      # (z,x,y) -> surface; poradi = LRU
        self.failed = {}                   # (z,x,y) -> cas neuspechu
        self.missing_sent = None
        self.store = lm.TileStore(tile_url, self._tile_from_thread)
        self.marker = None                 # {"lat","lon"}
        self.results = []                  # vysledky hledani (male body)
        self.favorites = []
        self.me = None                     # {"lat","lon","accuracy"}
        self.route = None                  # {"mode", "legs": [{"world": [(x,y)], "color", "walk"}]}
        self.route_ends = None
        self.stops = []                    # zastavky vybraneho spojeni MHD (klik = odjezdy)
        self.step_mark = None
        self.anim = None
        self.kinetic = None
        self.drag = None
        self.samples = []
        self.on_view_changed = None
        self.on_context = None
        self.on_marker_click = None
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK
                        | Gdk.EventMask.SMOOTH_SCROLL_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("scroll-event", self.on_scroll)
        self.connect("destroy", lambda _w: self.store.stop())
        self.tick_id = None

    # ---- souradnice ----
    @property
    def scale(self):
        return lm.TILE * (2 ** self.zoom)

    def center(self):
        return lm.from_world(self.mx, self.my)

    def screen_to_world(self, sx, sy):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        return self.mx + (sx - w / 2) / self.scale, self.my + (sy - h / 2) / self.scale

    def screen_to_latlon(self, sx, sy):
        return lm.from_world(*self.screen_to_world(sx, sy))

    def world_to_screen(self, wx, wy):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        # nejblizsi kopie sveta (mapa se opakuje do stran)
        dx = wx - self.mx
        dx -= round(dx)
        return w / 2 + dx * self.scale, h / 2 + (wy - self.my) * self.scale

    def latlon_to_screen(self, lat, lon):
        return self.world_to_screen(*lm.to_world(lat, lon))

    def bbox(self):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        n, wlon = self.screen_to_latlon(0, 0)
        s, elon = self.screen_to_latlon(w, h)
        return s, n, wlon, elon

    def set_view(self, mx, my, zoom, notify=True):
        self.zoom = lm.clamp(zoom, 1, lm.MAX_ZOOM)
        self.mx = mx % 1.0
        self.my = lm.clamp(my, 0.0, 1.0)
        self.queue_draw()
        if notify and self.on_view_changed:
            self.on_view_changed()

    # ---- animace ----
    def _ensure_tick(self):
        if self.tick_id is None:
            self.tick_id = self.add_tick_callback(self._tick)

    def _tick(self, _w, clock):
        now = clock.get_frame_time() / 1e6
        busy = False
        if self.anim:
            a = self.anim
            if a["start"] is None:
                a["start"] = now
            t = min(1.0, (now - a["start"]) / a["dur"])
            k = 1 - (1 - t) ** 3            # ease-out
            z = a["z0"] + (a["z1"] - a["z0"]) * k
            if a.get("anchor"):
                ax, ay, wx, wy = a["anchor"]
                s = lm.TILE * (2 ** z)
                mx, my = wx - ax / s, wy - ay / s
            else:
                dx = a["x1"] - a["x0"]
                dx -= round(dx)
                mx, my = a["x0"] + dx * k, a["y0"] + (a["y1"] - a["y0"]) * k
            self.set_view(mx, my, z, notify=t >= 1.0)
            if t >= 1.0:
                self.anim = None
            else:
                busy = True
        if self.kinetic:
            vx, vy, last = self.kinetic
            dt = max(0.001, now - last) if last else 1 / 60
            decay = math.exp(-dt * 4.5)
            vx, vy = vx * decay, vy * decay
            self.set_view(self.mx - vx * dt / self.scale, self.my - vy * dt / self.scale, self.zoom,
                          notify=False)
            if math.hypot(vx, vy) < 20:
                self.kinetic = None
                if self.on_view_changed:
                    self.on_view_changed()
            else:
                self.kinetic = (vx, vy, now)
                busy = True
        if not busy:
            self.tick_id = None
            return False
        return True

    def zoom_at(self, sx, sy, target, duration=0.22):
        target = lm.clamp(target, 1, lm.MAX_ZOOM)
        w, h = self.get_allocated_width(), self.get_allocated_height()
        ax, ay = sx - w / 2, sy - h / 2
        wx, wy = self.screen_to_world(sx, sy)
        if duration <= 0:
            s = lm.TILE * (2 ** target)
            self.set_view(wx - ax / s, wy - ay / s, target)
            return
        self.kinetic = None
        self.anim = {"start": None, "dur": duration, "z0": self.zoom, "z1": target, "anchor": (ax, ay, wx, wy)}
        self._ensure_tick()

    def zoom_by(self, delta):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        base = self.anim["z1"] if self.anim and self.anim.get("anchor") else self.zoom
        self.zoom_at(w / 2, h / 2, round(base + delta) if abs(delta) >= 1 else base + delta)

    def fly_to(self, lat, lon, zoom=None, duration=0.45):
        x1, y1 = lm.to_world(lat, lon)
        z1 = self.zoom if zoom is None else lm.clamp(zoom, 1, lm.MAX_ZOOM)
        # daleko (vic nez ~3 obrazovky): skok, at se nestahuji dlazdice cele cesty
        far = math.hypot((x1 - self.mx) * self.scale, (y1 - self.my) * self.scale) > 3 * max(
            self.get_allocated_width(), 400)
        self.kinetic = None
        if far or duration <= 0 or not self.get_mapped():
            self.anim = None
            self.set_view(x1, y1, z1)
            return
        self.anim = {"start": None, "dur": duration, "z0": self.zoom, "z1": z1, "x0": self.mx, "y0": self.my,
                     "x1": x1, "y1": y1}
        self._ensure_tick()

    def fit_bbox(self, south, north, west, east, max_zoom=17):
        w, h = max(self.get_allocated_width(), 300), max(self.get_allocated_height(), 300)
        z = lm.zoom_for_bbox(south, north, west, east, w, h, max_zoom)
        x0, y0 = lm.to_world(north, west)
        x1, y1 = lm.to_world(south, east)
        lat, lon = lm.from_world((x0 + x1) / 2, (y0 + y1) / 2)
        self.fly_to(lat, lon, z)

    def pan_by(self, dx, dy):
        self.kinetic = None
        lat, lon = lm.from_world(self.mx + dx / self.scale, self.my + dy / self.scale)
        self.fly_to(lat, lon, duration=0.18)

    # ---- mys ----
    def on_press(self, _w, ev):
        self.grab_focus()
        if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1:
            self.zoom_at(ev.x, ev.y, round(self.zoom) + 1)
            return True
        if ev.type != Gdk.EventType.BUTTON_PRESS:
            return True
        if ev.button == 3 or (ev.button == 1 and ev.state & Gdk.ModifierType.CONTROL_MASK):
            if self.on_context:
                lat, lon = self.screen_to_latlon(ev.x, ev.y)
                self.on_context(lat, lon, ev)
            return True
        if ev.button == 1:
            self.anim = None
            self.kinetic = None
            self.drag = (ev.x, ev.y, self.mx, self.my, False)
            self.samples = [(ev.time, ev.x, ev.y)]
        return True

    def on_motion(self, _w, ev):
        if not self.drag:
            return False
        x0, y0, mx0, my0, moved = self.drag
        if not moved and math.hypot(ev.x - x0, ev.y - y0) < 4:
            return True
        if not moved:
            win = self.get_window()
            if win:
                win.set_cursor(Gdk.Cursor.new_from_name(self.get_display(), "grabbing"))
        self.drag = (x0, y0, mx0, my0, True)
        self.set_view(mx0 - (ev.x - x0) / self.scale, my0 - (ev.y - y0) / self.scale, self.zoom, notify=False)
        self.samples.append((ev.time, ev.x, ev.y))
        self.samples = self.samples[-6:]
        return True

    def on_release(self, _w, ev):
        if ev.button != 1 or not self.drag:
            return False
        moved = self.drag[4]
        self.drag = None
        win = self.get_window()
        if win:
            win.set_cursor(None)
        if not moved:
            hit = self.hit_marker(ev.x, ev.y)
            if hit is not None and self.on_marker_click:
                self.on_marker_click(hit)
            return True
        # setrvacnost podle poslednich ~80 ms pohybu
        recent = [s for s in self.samples if ev.time - s[0] <= 80]
        if len(recent) >= 2 and recent[-1][0] > recent[0][0]:
            dt = (recent[-1][0] - recent[0][0]) / 1000.0
            vx, vy = (recent[-1][1] - recent[0][1]) / dt, (recent[-1][2] - recent[0][2]) / dt
            if math.hypot(vx, vy) > 250:
                self.kinetic = (min(max(vx, -4000), 4000), min(max(vy, -4000), 4000), None)
                self._ensure_tick()
                return True
        if self.on_view_changed:
            self.on_view_changed()
        return True

    def on_scroll(self, _w, ev):
        if ev.direction == Gdk.ScrollDirection.SMOOTH:
            _ok, dx, dy = ev.get_scroll_deltas()
            if ev.get_source_device() and ev.get_source_device().get_source() == Gdk.InputSource.MOUSE \
                    and abs(dy) >= 1:
                step = -1 if dy > 0 else 1        # kolecko mysi: cely krok s animaci
                base = self.anim["z1"] if self.anim and self.anim.get("anchor") else self.zoom
                self.zoom_at(ev.x, ev.y, round(base) + step)
            else:
                self.anim = None
                self.zoom_at(ev.x, ev.y, self.zoom - dy * 0.35, duration=0)
            return True
        step = {Gdk.ScrollDirection.UP: 1, Gdk.ScrollDirection.DOWN: -1}.get(ev.direction)
        if step:
            base = self.anim["z1"] if self.anim and self.anim.get("anchor") else self.zoom
            self.zoom_at(ev.x, ev.y, round(base) + step)
        return True

    def hit_marker(self, sx, sy):
        for i, st in enumerate(self.stops):
            x, y = self.latlon_to_screen(st["lat"], st["lon"])
            if math.hypot(sx - x, sy - y) <= 10:
                return ("stop", i)
        for i, f in enumerate(self.favorites):
            x, y = self.latlon_to_screen(f["lat"], f["lon"])
            if math.hypot(sx - x, sy - y) <= 12:
                return ("favorite", i)
        if self.me:
            x, y = self.latlon_to_screen(self.me["lat"], self.me["lon"])
            if math.hypot(sx - x, sy - y) <= 12:
                return ("me", 0)
        for i, p in enumerate(self.results):
            x, y = self.latlon_to_screen(p["lat"], p["lon"])
            if math.hypot(sx - x, sy - y) <= 9:
                return ("result", i)
        return None

    # ---- dlazdice ----
    def set_dark(self, dark):
        if dark != self.dark:
            self.dark = dark
            self.mem.clear()
            self.missing_sent = None
            self.queue_draw()

    def _tile_from_thread(self, key, data):
        GLib.idle_add(self._tile_ready, key, data, priority=GLib.PRIORITY_HIGH_IDLE)

    def _tile_ready(self, key, data):
        if data is None:
            self.failed[key] = time.time()
        else:
            surf = decode_png(data)
            if surf is None:
                self.failed[key] = time.time()
            else:
                self.failed.pop(key, None)
                self.mem.pop(key, None)
                self.mem[key] = darken(surf) if self.dark else surf
                while len(self.mem) > MEM_TILES:
                    self.mem.pop(next(iter(self.mem)))
        self.queue_draw()
        return False

    def _get(self, key):
        s = self.mem.get(key)
        if s is not None:          # LRU: posunout na konec
            del self.mem[key]
            self.mem[key] = s
        return s

    def _paint_tile(self, cr, surf, x0, y0, x1, y1, sub=None):
        """Dlazdici (nebo jeji cast sub=(ox, oy, velikost)) do obdelniku na obrazovce."""
        ox, oy, size = sub or (0, 0, lm.TILE)
        cr.save()
        cr.rectangle(x0, y0, x1 - x0, y1 - y0)
        cr.clip()
        cr.translate(x0, y0)
        cr.scale((x1 - x0) / size, (y1 - y0) / size)
        cr.set_source_surface(surf, -ox, -oy)
        pat = cr.get_source()
        pat.set_extend(cairo.EXTEND_PAD)
        pat.set_filter(cairo.FILTER_BILINEAR if abs(x1 - x0 - size) > 0.5 else cairo.FILTER_FAST)
        cr.paint()
        cr.restore()

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        bg = (0.11, 0.12, 0.15) if self.dark else (0.95, 0.94, 0.91)
        cr.set_source_rgb(*bg)
        cr.paint()
        tz = int(lm.clamp(math.floor(self.zoom + 0.5), 0, lm.MAX_ZOOM))
        n = 2 ** tz
        ts = lm.TILE * (2 ** (self.zoom - tz))
        left = self.mx * self.scale - w / 2
        top = self.my * self.scale - h / 2
        ix0, ix1 = math.floor(left / ts), math.floor((left + w) / ts)
        iy0, iy1 = max(0, math.floor(top / ts)), min(n - 1, math.floor((top + h) / ts))
        missing = []
        now = time.time()
        for iy in range(iy0, iy1 + 1):
            for ix in range(ix0, ix1 + 1):
                x = ix % n
                key = (tz, x, iy)
                sx0, sy0 = round(ix * ts - left), round(iy * ts - top)
                sx1, sy1 = round((ix + 1) * ts - left), round((iy + 1) * ts - top)
                surf = self._get(key)
                if surf is not None:
                    self._paint_tile(cr, surf, sx0, sy0, sx1, sy1)
                    continue
                self._draw_fallback(cr, tz, x, iy, sx0, sy0, sx1, sy1)
                if now - self.failed.get(key, 0) > RETRY_FAILED:
                    cx, cy = (ix + 0.5) * ts - left - w / 2, (iy + 0.5) * ts - top - h / 2
                    missing.append((cx * cx + cy * cy, key))
        keys = tuple(k for _d, k in sorted(missing))
        if keys != self.missing_sent:
            self.missing_sent = keys
            self.store.want(list(keys))
        self._draw_overlays(cr, w, h)
        self._draw_scale(cr, w, h)
        return False

    def _draw_fallback(self, cr, tz, x, y, sx0, sy0, sx1, sy1):
        """Chybejici dlazdice: zvetseny vyrez z nizsiho zoomu (nebo ctvrtiny z vyssiho), jinak mrizka."""
        for d in range(1, 7):
            pz = tz - d
            if pz < 0:
                break
            parent = self.mem.get((pz, x >> d, y >> d))
            if parent is not None:
                size = lm.TILE / (2 ** d)
                ox, oy = (x - ((x >> d) << d)) * size, (y - ((y >> d) << d)) * size
                self._paint_tile(cr, parent, sx0, sy0, sx1, sy1, (ox, oy, size))
                return
        drawn = False
        if tz < lm.MAX_ZOOM:
            mx, my = (sx0 + sx1) / 2, (sy0 + sy1) / 2
            for cx in (0, 1):
                for cy in (0, 1):
                    child = self.mem.get((tz + 1, 2 * x + cx, 2 * y + cy))
                    if child is not None:
                        self._paint_tile(cr, child, (sx0, mx)[cx], (sy0, my)[cy], (mx, sx1)[cx], (my, sy1)[cy])
                        drawn = True
        if not drawn:
            cr.set_source_rgba(0.5, 0.5, 0.5, 0.12)
            cr.set_line_width(1)
            cr.rectangle(sx0 + 0.5, sy0 + 0.5, sx1 - sx0 - 1, sy1 - sy0 - 1)
            cr.stroke()

    def _screen_path(self, world):
        pts = [self.world_to_screen(x, y) for x, y in world]
        # vynechat body blize nez 1,5 px (rychlejsi kresleni dlouhych tras)
        simple = [pts[0]]
        for p in pts[1:]:
            q = simple[-1]
            if abs(p[0] - q[0]) + abs(p[1] - q[1]) >= 1.5:
                simple.append(p)
        simple.append(pts[-1])
        return simple

    def _draw_route(self, cr):
        transit = self.route["mode"] == lm.TRANSIT
        legs = [(self._screen_path(lg["world"]), lg) for lg in self.route["legs"] if len(lg["world"]) >= 2]
        cr.save()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        # nejdriv vsechny okraje, aby sousedni useky MHD zustaly ostre (jako mobilni LuxAI)
        for pts, lg in legs:
            if transit and lg["walk"]:
                continue
            cr.new_path()
            for x, y in pts:
                cr.line_to(x, y)
            cr.set_line_width(9)
            cr.set_source_rgba(*((1, 1, 1, 0.95) if transit else (0.1, 0.25, 0.65, 0.9)))
            cr.stroke()
        for pts, lg in legs:
            cr.new_path()
            for x, y in pts:
                cr.line_to(x, y)
            if lg["walk"]:
                cr.set_dash([0.1, 9])
                cr.set_line_width(6 if not transit else 5.5)
                cr.set_source_rgb(*((1, 1, 1) if not transit else (0.39, 0.45, 0.55)))
            else:
                cr.set_dash([])
                cr.set_line_width(5.5)
                cr.set_source_rgb(*lg["color"])
            cr.stroke()
        cr.restore()

    def _draw_overlays(self, cr, w, h):
        if self.route and self.route["legs"]:
            self._draw_route(cr)
        for st in self.stops:
            x, y = self.latlon_to_screen(st["lat"], st["lon"])
            if -20 < x < w + 20 and -20 < y < h + 20:
                cr.arc(x, y, 6.5, 0, 2 * math.pi)
                cr.set_source_rgb(*st["color"])
                cr.fill()
                cr.arc(x, y, 3.8, 0, 2 * math.pi)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
        if self.route_ends:
            a, b = self.route_ends
            draw_dot(cr, *self.latlon_to_screen(a["lat"], a["lon"]), (0.2, 0.7, 0.35), 6)
            if not (self.marker and lm.same_place(self.marker, b)):
                draw_pin(cr, *self.latlon_to_screen(b["lat"], b["lon"]))
        if self.step_mark:
            x, y = self.latlon_to_screen(self.step_mark["lat"], self.step_mark["lon"])
            cr.arc(x, y, 8, 0, 2 * math.pi)
            cr.set_source_rgb(1, 1, 1)
            cr.fill_preserve()
            cr.set_line_width(3)
            cr.set_source_rgb(*ACCENT)
            cr.stroke()
        for p in self.results:
            if self.marker and lm.same_place(self.marker, p):
                continue
            x, y = self.latlon_to_screen(p["lat"], p["lon"])
            if -20 < x < w + 20 and -20 < y < h + 20:
                draw_dot(cr, x, y, (0.92, 0.26, 0.24), 5.5)
        for f in self.favorites:
            if self.marker and lm.same_place(self.marker, f):
                continue          # vybrane misto ukazuje spendlik
            x, y = self.latlon_to_screen(f["lat"], f["lon"])
            if -20 < x < w + 20 and -20 < y < h + 20:
                cr.arc(x, y, 10, 0, 2 * math.pi)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
                cr.arc(x, y, 8.5, 0, 2 * math.pi)
                cr.set_source_rgb(1.0, 0.7, 0.0)
                cr.fill()
                draw_star(cr, x, y, 5.5)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
        if self.me:
            x, y = self.latlon_to_screen(self.me["lat"], self.me["lon"])
            mpp = lm.meters_per_pixel(self.me["lat"], self.zoom)
            r = self.me.get("accuracy", 0) / mpp
            if r > 12:
                cr.arc(x, y, min(r, 4 * max(w, h)), 0, 2 * math.pi)
                cr.set_source_rgba(*ACCENT, 0.13)
                cr.fill_preserve()
                cr.set_line_width(1)
                cr.set_source_rgba(*ACCENT, 0.45)
                cr.stroke()
            draw_dot(cr, x, y, ACCENT, 7)
        if self.marker:
            draw_pin(cr, *self.latlon_to_screen(self.marker["lat"], self.marker["lon"]))

    def _draw_scale(self, cr, w, h):
        lat, _lon = self.center()
        mpp = lm.meters_per_pixel(lat, self.zoom)
        if IMPERIAL:
            cands = [m * 10 ** e * 0.3048 for e in range(1, 3) for m in (1, 2, 5)] + \
                [m * 10 ** e * 1609.344 for e in range(-1, 4) for m in (1, 2, 5)]
        else:
            cands = [m * 10 ** e for e in range(0, 7) for m in (1, 2, 5)]
        fits = [v for v in cands if v <= 110 * mpp]
        if not fits:
            return
        best = max(fits)
        px = best / mpp
        txt = lm.format_distance(best, IMPERIAL)
        x, y = 12, h - 14
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(11)
        fg = (0.92, 0.92, 0.92) if self.dark else (0.15, 0.15, 0.15)
        halo = (0, 0, 0, 0.6) if self.dark else (1, 1, 1, 0.85)
        for color, width in ((halo, 4), (fg + (1,), 1.6)):
            cr.set_source_rgba(*color)
            cr.set_line_width(width)
            cr.move_to(x, y - 5)
            cr.line_to(x, y)
            cr.line_to(x + px, y)
            cr.line_to(x + px, y - 5)
            cr.stroke()
        cr.move_to(x + 2, y - 8)
        cr.text_path(txt)
        cr.set_source_rgba(*halo)
        cr.set_line_width(3)
        cr.stroke_preserve()
        cr.set_source_rgb(*fg)
        cr.fill()

    def set_route(self, res):
        self.stops = []
        if res is None:
            self.route = None
            self.route_ends = None
            self.step_mark = None
        else:
            self.route = {"mode": res["mode"], "legs": [{"world": [lm.to_world(a, b) for a, b in res["points"]],
                                                          "color": ACCENT, "walk": res["mode"] == "walk"}]}
        self.queue_draw()

    def set_transit(self, it):
        """Vybrane spojeni MHD: useky v barvach linek, pesky teckovane, zastavky prestupu."""
        self.step_mark = None
        legs, stops = [], []
        for lg in it["legs"]:
            pts = lm.leg_points(lg) or [(lg["from"]["lat"], lg["from"]["lon"]), (lg["to"]["lat"], lg["to"]["lon"])]
            legs.append({"world": [lm.to_world(a, b) for a, b in pts], "color": lm.hex_rgb(lg["color"]),
                         "walk": not lg["transit"]})
            if lg["transit"]:
                for end in (lg["from"], lg["to"]):
                    if end.get("name") and not any(lm.same_place(end, s) for s in stops):
                        stops.append(dict(end, color=lm.hex_rgb(lg["color"])))
        self.route = {"mode": lm.TRANSIT, "legs": legs}
        self.stops = stops
        self.queue_draw()


