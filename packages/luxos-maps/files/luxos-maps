def label(text="", cls=None, xalign=0.0, **kw):
    lbl = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in (cls or "").split():
        lbl.get_style_context().add_class(c)
    return lbl


def icon_button(icon, tooltip, cb=None):
    b = Gtk.Button(tooltip_text=tooltip)
    b.add(Gtk.Image(icon_name=icon))
    if cb:
        b.connect("clicked", lambda _b: cb())
    return b


def system_dark():
    s = Gtk.Settings.get_default()
    return "dark" in (s.props.gtk_theme_name or "").lower() or bool(s.props.gtk_application_prefer_dark_theme)


def default_window_size(width=1120, height=740):
    """Vychozi velikost okna, aby se i s hlavickou (~45 px) vesla do pracovni plochy monitoru
    (1280x800 i 1366x768: jinak okno presahovalo dolni okraj a atribuce OSM nebyla videt)."""
    try:
        display = Gdk.Display.get_default()
        mon = display.get_primary_monitor() or display.get_monitor(0)
        wa = mon.get_workarea()
        width = max(560, min(width, wa.width - 40))
        height = max(420, min(height, wa.height - 45 - 24))
    except (AttributeError, TypeError):
        pass
    return width, height


