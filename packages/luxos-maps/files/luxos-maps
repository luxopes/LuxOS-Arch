    def nav_route(self):
        """Trasa pro navigaci z vypocitane trasy (auto/kolo/pesky) nebo vybraneho spojeni MHD."""
        if self.cfg["mode"] == lm.TRANSIT:
            if not (self.transit_res and self.transit_res.get("itineraries")):
                return None
            it = self.transit_res["itineraries"][self.itin_idx]
            return lm.transit_nav_route(it, dest=self.route_to)
        if not self.route_res:
            return None
        return lm.NavRoute.from_osrm(self.route_res)

    def start_navigation(self):
        if self.nav:
            return
        try:
            route = self.nav_route()
        except lm.MapsError:
            route = None
        if route is None:
            return
        if not self.cfg["location_consent"]:
            if not self.ask_consent():
                return
            self.cfg["location_consent"] = True
            lm.save_config(self.cfg)
            self.consent_item.set_active(True)
        self.nav_gen += 1
        self.nav = lm.Navigator(route)       # prepocet i u MHD (mimo trasu, opacny smer, zmeskany spoj)
        self.nav_mode = route.mode
        self.nav_motion = lm.NavMotion()
        self.nav_state = self.nav_fix = self.nav_pending = None
        self.nav_spoken = set()
        self.nav_first = True
        self.nav_base_status = ""
        self.nav_prev_tracking = self.tracking
        self.tracking = True
        self.follow = True
        self.watch_phone()
        if os.environ.get("LUXOS_MAPS_GEOCLUE", "1") != "0":
            self.geoclue = GeoClueWatch(self.on_geoclue_fix)
        self.inhibit()
        self.nav_btn.hide()
        self.nav_recenter.hide()
        if route.mode == lm.TRANSIT:
            self.legs_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.nav_banner.show()
        self.nav_bottom.show()
        self.nav_update_ui({"next": self.nav.next, "step": route.steps[self.nav.next],
                            "following": None, "to_next": route.steps[self.nav.next]["along"],
                            "remaining_m": route.length, "remaining_s": route.remaining_s(0, 0),
                            "eta": time.time() + route.remaining_s(0, 0), "arrived": False, "off_route": False,
                            "located": False})
        self.nav_set_status(_("Waiting for your location…"))
        me = self.map.me
        if me and me.get("source") == "phone" and not me.get("stale") \
                and time.monotonic() - self.phone_last < lm.PHONE_FRESH_MS / 1000:
            self.nav_on_fix(me)
        gen = self.nav_gen

        def work():
            fix = lm.phone_location()
            if fix:
                GLib.idle_add(self.nav_initial_fix, gen, fix)
        if os.environ.get("LUXOS_MAPS_PHONE", "1") != "0":
            threading.Thread(target=work, daemon=True).start()
        self.nav_wait_id = GLib.timeout_add_seconds(NAV_WAIT_S, self.nav_no_location)

    def nav_initial_fix(self, gen, fix):
        if self.nav and gen == self.nav_gen and self.nav_fix is None:
            self.phone_last = time.monotonic()
            self.nav_on_fix(fix)
        return False

    def nav_no_location(self):
        self.nav_wait_id = None
        if self.nav and self.nav_fix is None:
            self.nav_set_status(_("No live location. Connect your phone with LuxOS Companion and share its "
                                  "location, or turn on the location service."))
            self.nav_sim_btn.set_visible(bool(os.environ.get("LUXOS_MAPS_SIMULATE")))
        return False

    def nav_set_status(self, text):
        """Radek stavu v pruhu (bez textu: trvaly stav, napr. simulace)."""
        text = text or self.nav_base_status
        self.nav_status.set_text(text)
        self.nav_status.set_visible(bool(text))

    def end_navigation(self):
        if not self.nav:
            return
        self.nav = None
        self.nav_gen += 1
        for attr in ("nav_timer", "nav_wait_id", "nav_sim_id"):
            sid = getattr(self, attr)
            if sid:
                GLib.source_remove(sid)
                setattr(self, attr, None)
        self.nav_stop_anim()
        self.nav_motion = None
        self.uninhibit()
        if self.geoclue:
            self.geoclue.stop()
            self.geoclue = None
        if self.tts_proc:
            self.tts_proc.force_exit()
            self.tts_proc = None
        self.map.rotation = 0.0
        self.map.nav_heading = None
        if self.map.me and self.map.me.get("source") == "simulated":
            self.map.me = None
        self.map.queue_draw()
        self.nav_banner.hide()
        self.nav_bottom.hide()
        self.nav_base_status = ""
        self.nav_set_status("")
        self.nav_sim_btn.hide()
        self.legs_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.steps_list.unselect_all()
        if not self.nav_prev_tracking:
            self.unwatch_phone()
        if self.route_res or self.transit_res:
            self.nav_btn.show()

    def on_geoclue_fix(self, fix):
        """Poloha ze sluzby GeoClue: jen kdyz telefon 15 s nic neposlal (telefon ma prednost)."""
        if not self.nav or time.monotonic() - self.phone_last < lm.PHONE_FRESH_MS / 1000:
            return
        self.nav_on_fix(fix)

    def nav_on_fix(self, fix):
        """Nova poloha behem navigace: zpracovat nejvys NAV_MAX_HZ krat za sekundu (posledni vyhrava)."""
        if not self.nav:
            return
        self.nav_pending = fix
        if self.nav_timer:
            return
        wait = self.nav_last + 1.0 / lm.NAV_MAX_HZ - time.monotonic()
        if wait > 0:
            self.nav_timer = GLib.timeout_add(int(wait * 1000) + 1, self.nav_flush)
        else:
            self.nav_flush()

    def nav_flush(self):
        self.nav_timer = None
        fix, self.nav_pending = self.nav_pending, None
        if not (fix and self.nav):
            return False
        self.nav_last = time.monotonic()
        first = self.nav_fix is None
        self.nav_fix = fix
        st = self.nav.update(fix)
        self.nav_state = st
        if first:
            self.nav_sim_btn.hide()
            self.nav_set_status("")
        self.nav_update_ui(st)
        now = time.monotonic()
        snap = st.get("snap")
        self.nav_motion.on_fix(now, fix, st["heading"], self.nav.route if snap else None,
                               st["along"] if snap else None)
        self.nav_show_position(now)
        self.nav_start_anim()
        if st["reroute"]:
            self.nav_reroute(fix, st)
        elif (st["off_route"] or st.get("missed")) and not self.nav.reroute_enabled:
            self.nav_set_status(_("You are off the route."))
        elif not (st["off_route"] or st.get("missed")):
            self.nav_set_status("")
        self.nav_speak(st)
        return False

    def nav_show_position(self, now=None):
        """Mapa za polohou: sipka ve smeru jizdy, mapa po smeru jizdy (nebo sever nahore), poloha ve spodni
        tretine. Poloha a kurz z NavMotion (plynule mezi polohami, kratky dopocet, prichyceni k trase)."""
        fix, st, mo = self.nav_fix, self.nav_state, self.nav_motion
        if not (self.nav and fix and st and mo):
            return
        lat, lon, head = mo.frame(time.monotonic() if now is None else now)
        m = self.map
        m.me = dict(fix, lat=lat, lon=lon)
        m.nav_heading = head
        m.rotation = -math.radians(head) if self.cfg["nav_heading_up"] else 0.0
        self.nav_compass.queue_draw()
        if not self.follow or m.drag:
            m.queue_draw()
            return
        zoom = NAV_ZOOM.get(self.nav_mode, 17.0) if self.nav_first else m.zoom
        self.nav_first = False
        m.anim = m.kinetic = None
        px, py = lm.to_world(lat, lon)
        ahead = m.get_allocated_height() * 0.22 if self.cfg["nav_heading_up"] else 0.0
        dx, dy = m.unrot(0.0, ahead)
        s = lm.TILE * (2 ** zoom)
        m.set_view(px - dx / s, py - dy / s, zoom, notify=False)

    # plynuly pohyb: tick callback mapy (snimkove hodiny), nejvys NAV_FPS snimku/s, jen dokud se sipka hybe
    def nav_start_anim(self):
        if self.nav_anim_id is None and self.nav_motion and self.nav_motion.active(time.monotonic()):
            self.nav_anim_id = self.map.add_tick_callback(self.nav_anim_tick)

    def nav_stop_anim(self):
        if self.nav_anim_id is not None:
            self.map.remove_tick_callback(self.nav_anim_id)
            self.nav_anim_id = None

    def nav_anim_tick(self, _widget, _clock):
        if not (self.nav and self.nav_motion):
            self.nav_anim_id = None
            return False
        now = time.monotonic()
        fix = self.nav_fix or {}
        mpp = lm.meters_per_pixel(fix.get("lat", 0.0), self.map.zoom)
        if now - self.nav_anim_last < 1.0 / self.nav_motion.fps(now, mpp) - 0.003:
            return True
        self.nav_anim_last = now
        self.nav_show_position(now)
        if not self.nav_motion.active(now):
            self.nav_anim_id = None
            return False
        return True

    def nav_follow_again(self):
        self.follow = True
        self.nav_recenter.hide()
        self.nav_show_position()

    def step_text(self, step):
        """Pokyn kroku (OSRM i MHD) a druhy radek (ulice, nastupiste, cas)."""
        typ = step.get("type")
        if typ in ("board", "alight", "walk") and self.transit_res:
            lg = self.transit_res["itineraries"][self.itin_idx]["legs"][step["leg"]]
            if typ == "board":
                what = " ".join(x for x in (_(lg["mode_name"]), lg["line"]) if x)
                if lg["headsign"]:
                    what += " → " + lg["headsign"]
                sub = [_("Departs %s") % lg["departure_time"]]
                if lg["from"].get("name"):
                    sub.insert(0, lg["from"]["name"])
                if lg["from"].get("platform"):
                    sub.append(_("Platform %s") % lg["from"]["platform"])
                return _("Take %s") % what, " · ".join(sub)
            if typ == "alight":
                return _("Get off at %s") % (lg["to"].get("name") or "?"), _("Arrives %s") % lg["arrival_time"]
            return lm.step_instruction(step, _), lm.format_duration(lg["duration_s"], _)
        if typ == "arrive":
            return lm.step_instruction(step, _), self.endpoint_text(self.route_to) if self.route_to else ""
        return lm.step_instruction(step, _), step.get("name") or ""

    def nav_update_ui(self, st):
        step = st["step"]
        if st["arrived"]:
            self.nav_icon.set_maneuver("arrive", "")
            self.nav_dist.set_text(_("You have arrived"))
            self.nav_instr.set_text(self.endpoint_text(self.route_to) if self.route_to else "")
            self.nav_street.set_text("")
            self.nav_then.hide()
            self.nav_left.set_text(_("Arrived"))
            self.nav_more.set_text(time.strftime("%H:%M"))
        else:
            instr, sub = self.step_text(step)
            self.nav_icon.set_maneuver(step["type"], step.get("modifier", ""))
            self.nav_dist.set_text(lm.format_distance(st["to_next"], IMPERIAL))
            self.nav_instr.set_text(instr)
            self.nav_street.set_text(sub)
            self.nav_street.set_visible(bool(sub))
            nxt = st.get("following")
            if nxt:
                self.nav_then_icon.set_maneuver(nxt["type"], nxt.get("modifier", ""))
                self.nav_then_lbl.set_text(_("Then: %s") % self.step_text(nxt)[0])
            self.nav_then.set_visible(bool(nxt))
            self.nav_left.set_text(lm.format_duration(st["remaining_s"], _))
            self.nav_more.set_text("%s · %s" % (lm.format_distance(st["remaining_m"], IMPERIAL),
                                                _("Arrival %s") % time.strftime("%H:%M", time.localtime(st["eta"]))))
        # aktualni krok v seznamu (MHD: usek spojeni), posunuty do viditelne casti panelu
        lst = self.legs_list if self.nav_mode == lm.TRANSIT else self.steps_list
        row = lst.get_row_at_index(step.get("leg", 0) if self.nav_mode == lm.TRANSIT else st["next"])
        if row and lst.get_selected_row() is not row:
            lst.select_row(row)
            GLib.idle_add(self.scroll_to_row, row)

    def scroll_to_row(self, row):
        sw = row.get_ancestor(Gtk.ScrolledWindow)
        content = sw.get_child().get_child() if sw and isinstance(sw.get_child(), Gtk.Viewport) else None
        pos = row.translate_coordinates(content, 0, 0) if content and row.get_mapped() else None
        if pos:
            adj, h = sw.get_vadjustment(), row.get_allocated_height()
            if pos[1] < adj.get_value() or pos[1] + h > adj.get_value() + adj.get_page_size():
                adj.set_value(max(0, pos[1] - adj.get_page_size() / 3))
        return False

    def nav_reroute(self, fix, st=None):
        """Mimo trasu, opacny smer nebo zmeskany spoj: nova trasa (auto/kolo/pesky: OSRM se smerem jizdy)
        nebo nove spojeni MHD (Transitous) z aktualni polohy. Navigator hlida nejvys 1 prepocet za 15 s
        (MHD 60 s); nova trasa nahradi starou v mape, v panelu i v pruhu navigace."""
        st = st or {}
        gen, mode, b = self.nav_gen, self.nav_mode, self.route_to
        a = {"lat": fix["lat"], "lon": fix["lon"]}
        if mode == lm.TRANSIT:
            self.nav_set_status(_("Connection missed. Finding another one…") if st.get("reason") == "missed"
                                else _("Finding a new connection…"))
            when, arrive = self.transit_query
            if not arrive:
                when = None                  # odjezd ted (puvodni "odjezd v" uz neplati)

            def transit_work():
                try:
                    res, err = lm.transit_plan(a, b, when, arrive, cfg=self.cfg), None
                except lm.MapsError as e:
                    res, err = None, str(e)
                GLib.idle_add(self.nav_transit_rerouted, gen, res, err)
            threading.Thread(target=transit_work, daemon=True).start()
            return
        self.nav_set_status(_("Rerouting…"))
        # smer jizdy pro OSRM (auto/kolo): nova trasa nezacina otocenim do protismeru
        head = st.get("heading") if mode != "walk" and (fix.get("speed") or 0) >= 2.0 else None

        def work():
            try:
                res = lm.route(a, b, mode, cfg=self.cfg, bearing=head)
            except lm.MapsError:
                res = None
            GLib.idle_add(self.nav_rerouted, gen, res)
        threading.Thread(target=work, daemon=True).start()

    def nav_rerouted(self, gen, res):
        if not self.nav or gen != self.nav_gen:
            return False
        if not res:
            self.nav.reroute_failed(time.time())
            self.nav_set_status(_("The route could not be recalculated. Check your internet connection."))
            return False
        self.route_res = res
        self.map.set_route(res)
        self.map.route_ends = (self.route_from, self.route_to)
        self.fill_steps(res)
        self.rt_time.set_text(lm.format_duration(res["duration"], _))
        self.rt_dist.set_text(lm.format_distance(res["distance"], IMPERIAL))
        self.nav.set_route(lm.NavRoute.from_osrm(res))
        self.nav_after_reroute()
        return False

    def nav_transit_rerouted(self, gen, res, err):
        """Nove spojeni MHD z aktualni polohy: nahradi spojeni v panelu, v mape i v navigaci (prvni nalezene)."""
        if not self.nav or gen != self.nav_gen:
            return False
        try:
            route = lm.transit_nav_route(res["itineraries"][0], dest=self.route_to) if res else None
        except (lm.MapsError, KeyError, IndexError):
            route = None
        if route is None:
            self.nav.reroute_failed(time.time())
            self.nav_set_status(_("No other connection found.") if err == "NoRoute" else
                                _("The route could not be recalculated. Check your internet connection."))
            return False
        self.transit_res = res
        for lst in (self.itin_list, self.legs_list):
            for row in lst.get_children():
                row.destroy()
        for i, it in enumerate(res["itineraries"]):
            self.itin_list.add(self.itinerary_row(it, i))
        self._nav_selecting = True                 # vyber radku nesmi prekreslit mapu ani posunout pohled
        self.itin_list.select_row(self.itin_list.get_row_at_index(0))
        self._nav_selecting = False
        self.show_itinerary(0, fit=False)
        self.nav.set_route(route)
        self.nav_after_reroute()
        return False

    def nav_after_reroute(self):
        self.nav_spoken = set()
        self.nav_set_status("")
        if self.nav_fix:
            self.nav_on_fix(self.nav_fix)

    # hlasove pokyny (jen s TTS a zapnutym prepinacem): daleko a tesne pred manevrem, prijezd
    def nav_speak(self, st):
        if not (TTS and self.cfg["nav_voice"] and st.get("located")):
            return
        key = (id(self.nav.route), st["next"])
        if st["arrived"]:
            if ("arrived",) not in self.nav_spoken:
                self.nav_spoken.add(("arrived",))
                self.speak(_("You have arrived"))
            return
        far, near = NAV_VOICE_M.get(self.nav_mode, (300, 40))
        instr = self.step_text(st["step"])[0]
        d = st["to_next"]
        if d <= near and key + ("near",) not in self.nav_spoken:
            self.nav_spoken |= {key + ("near",), key + ("far",)}
            self.speak(instr)
        elif near * 2 < d <= far and key + ("far",) not in self.nav_spoken:
            self.nav_spoken.add(key + ("far",))
            self.speak(_("In %s, %s") % (lm.format_distance(round(d / 50.0) * 50 if d >= 100 else d, IMPERIAL),
                                         instr))

    def speak(self, text):
        if self.tts_proc:
            self.tts_proc.force_exit()
        argv = [TTS, "-l", LANG, text] if TTS.endswith("spd-say") else [TTS, "-v", LANG, text]
        try:
            self.tts_proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_SILENCE
                                               | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.tts_proc = None

    # zhasinani obrazovky behem navigace: xfce4-screensaver (org.freedesktop.ScreenSaver)
    # a xfce4-power-manager (org.freedesktop.PowerManagement.Inhibit); po konci se vzdy uvolni
    INHIBITORS = (("org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver"),
                  ("org.freedesktop.PowerManagement", "/org/freedesktop/PowerManagement/Inhibit",
                   "org.freedesktop.PowerManagement.Inhibit"))

    def inhibit(self):
        try:
            bus = lm.session_bus("LUXOS_MAPS_INHIBIT_BUS")
        except GLib.Error:
            return
        gen = self.nav_gen
        for name, path, iface in self.INHIBITORS:
            def done(b, res, target=(name, path, iface)):
                try:
                    cookie = b.call_finish(res).unpack()[0]
                except GLib.Error:
                    return
                if self.nav and gen == self.nav_gen:
                    self.inhibit_cookies[target] = (b, cookie)
                else:          # navigace mezitim skoncila
                    self._uninhibit_one(b, target, cookie)
            bus.call(name, path, iface, "Inhibit", GLib.Variant("(ss)", (_("Maps"), _("Navigation in progress"))),
                     GLib.VariantType("(u)"), Gio.DBusCallFlags.NO_AUTO_START, 3000, None, done)

    def _uninhibit_one(self, bus, target, cookie):
        name, path, iface = target
        bus.call(name, path, iface, "UnInhibit", GLib.Variant("(u)", (cookie,)), None,
                 Gio.DBusCallFlags.NO_AUTO_START, 3000, None, None)

    def uninhibit(self):
        cookies, self.inhibit_cookies = self.inhibit_cookies, {}
        for target, (bus, cookie) in cookies.items():
            self._uninhibit_one(bus, target, cookie)
        for bus in {id(b): b for b, _c in cookies.values()}.values():
            try:
                bus.flush_sync(None)       # odeslat hned (i pri zavirani okna)
            except GLib.Error:
                pass

    # simulace jen pro testovani (LUXOS_MAPS_SIMULATE=1, cislo > 1 = zrychleni)
    def nav_simulate(self):
        if not (self.nav and os.environ.get("LUXOS_MAPS_SIMULATE")) or self.nav_sim_id:
            return
        try:
            factor = max(1.0, float(os.environ["LUXOS_MAPS_SIMULATE"]))
        except ValueError:
            factor = 1.0
        track = lm.simulate_track(self.nav.route, lm.NAV_SPEEDS.get(self.nav_mode, 10.0) * factor)
        self.nav_base_status = _("Simulated location (testing)")
        self.nav_sim_btn.hide()
        self.nav_set_status("")

        def tick():
            fix = next(track, None)
            if fix is None or not self.nav:
                self.nav_sim_id = None
                return False
            self.nav_on_fix(fix)
            return True
        self.nav_sim_id = GLib.timeout_add(1000, tick)
        tick()

    # ---- kontextova nabidka mapy ----
    def on_context(self, lat, lon, event):
        menu = Gtk.Menu()
        point = {"name": lm.format_coords(lat, lon), "lat": lat, "lon": lon}
        for text, cb in ((_("What's Here?"), lambda: self.whats_here(lat, lon)),
                         (_("Directions from Here"), lambda: (self.show_directions(False),
                                                              self.set_endpoint("from", point))),
                         (_("Directions to Here"), lambda: self.directions_to(point)),
                         (_("Departures Nearby"), lambda: self.show_departures(
                             {"name": _("Stops near this point"), "lat": lat, "lon": lon})),
                         (_("Add to Favorites"), lambda: self.whats_here(lat, lon, favorite=True)),
                         (_("Copy Coordinates"), lambda: Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(
                             lm.format_coords(lat, lon), -1))):
            item = Gtk.MenuItem(label=text)
            item.connect("activate", lambda _i, f=cb: f())
            menu.append(item)
        near = Gtk.MenuItem(label=_("Nearby"))
        near.set_submenu(self.nearby_menu(lambda: point))
        menu.insert(near, 4)
        menu.show_all()
        menu.attach_to_widget(self.map, None)
        menu.popup_at_pointer(event)
        self._menu = menu

    def whats_here(self, lat, lon, favorite=False):
        point = {"name": lm.format_coords(lat, lon), "lat": lat, "lon": lon}
        self.side_btn.set_active(True)
        self.select_place(point, zoom=self.map.zoom)
        self.pl_status.set_text(_("Searching…"))

        def work():
            try:
                p = lm.reverse(lat, lon, LANG, zoom=18 if self.map.zoom >= 15 else 14, cfg=self.cfg)
            except lm.MapsError:
                p = None
            GLib.idle_add(done, p)

        def done(p):
            if self.place and lm.same_place(self.place, point, 1e-9):
                if p:
                    named = dict(p, lat=lat, lon=lon, address=p.get("address") or "")
                    named.pop("bbox", None)
                    self.place = named
                    self.pl_name.set_text(named["name"])
                    self.pl_addr.set_text(named["address"])
                    self.pl_addr.set_visible(bool(named["address"]))
                self.pl_status.set_text("")
                if favorite and self.favorite_index(self.place) is None:
                    self.toggle_favorite()
                self.update_place_buttons()
            return False
        threading.Thread(target=work, daemon=True).start()

    def on_marker_click(self, hit):
        kind, idx = hit
        if kind == "favorite" and idx < len(self.cfg["favorites"]):
            self.side_btn.set_active(True)
            self.select_place(dict(self.cfg["favorites"][idx]), zoom=max(self.map.zoom, 15))
        elif kind == "me" and self.map.me:
            self.side_btn.set_active(True)
            self.select_place(dict(self.map.me, name=_("My Location")), zoom=self.map.zoom)
        elif kind == "stop" and idx < len(self.map.stops):
            self.show_departures(self.map.stops[idx])
        elif kind == "result" and idx < len(self.map.results):
            self.side_btn.set_active(True)
            self.select_place(dict(self.map.results[idx]), zoom=max(self.map.zoom, 16))

    # ---- ovladani na mape, atribuce, nabidka ----
    def build_osd(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.END, valign=Gtk.Align.END,
                      margin_end=12, margin_bottom=30)
        frame = Gtk.EventBox()
        frame.get_style_context().add_class("map-osd")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        inner.pack_start(icon_button("zoom-in-symbolic", _("Zoom In") + " (+)", lambda: self.map.zoom_by(1)),
                         False, False, 0)
        inner.pack_start(Gtk.Separator(), False, False, 0)
        inner.pack_start(icon_button("zoom-out-symbolic", _("Zoom Out") + " (−)", lambda: self.map.zoom_by(-1)),
                         False, False, 0)
        frame.add(inner)
        box.pack_start(frame, False, False, 0)
        return box

    def build_attribution(self):
        # OSM: atribuce vzdy viditelna, s odkazem na stranku autorskych prav
        box = Gtk.EventBox(halign=Gtk.Align.END, valign=Gtk.Align.END)
        box.get_style_context().add_class("attribution")
        lbl = Gtk.Label(margin_start=7, margin_end=7, margin_top=2, margin_bottom=2)
        lbl.set_markup('<a href="%s">%s</a>' % (lm.COPYRIGHT_URL,
                                                GLib.markup_escape_text(_("© OpenStreetMap contributors"))))
        lbl.connect("activate-link", lambda _l, uri: (self.open_uri(uri), True)[1])
        self.attribution = lbl
        box.add(lbl)
        return box

    def build_menu(self):
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=10, spacing=2)
        box.pack_start(label(_("Map Appearance"), "side-title", margin_start=6, margin_bottom=2), False, False, 0)
        group = None
        self.appearance_buttons = {}
        for key, text in (("auto", _("Automatic")), ("light", _("Light")), ("dark", _("Dark"))):
            b = Gtk.RadioButton(label=text, group=group)
            group = group or b
            b.set_active(self.cfg["appearance"] == key)
            b.connect("toggled", self.on_appearance, key)
            self.appearance_buttons[key] = b
            box.pack_start(b, False, False, 0)
        box.pack_start(Gtk.Separator(margin_top=6, margin_bottom=6), False, False, 0)
        self.consent_item = Gtk.CheckButton(label=_("Allow My Location"), active=self.cfg["location_consent"])
        self.consent_item.connect("toggled", self.on_consent_toggle)
        box.pack_start(self.consent_item, False, False, 0)
        self.suggest_item = Gtk.CheckButton(label=_("Suggestions While Typing"), active=self.cfg["suggest_online"],
                                            tooltip_text=_("Sends what you type to photon.komoot.io. When off, "
                                                           "only favorites, recent places and stops are suggested."))
        self.suggest_item.connect("toggled", self.on_suggest_toggle)
        box.pack_start(self.suggest_item, False, False, 0)
        recent = Gtk.ModelButton(text=_("Clear Recent Places"))
        recent.connect("clicked", lambda _b: self.clear_recent())
        box.pack_start(recent, False, False, 0)
        box.pack_start(Gtk.Separator(margin_top=6, margin_bottom=6), False, False, 0)
        for text, uri in ((_("Report a Map Issue"), lm.FIXTHEMAP_URL), (_("About Map Data"), lm.COPYRIGHT_URL)):
            b = Gtk.ModelButton(text=text)
            b.connect("clicked", lambda _b, u=uri: self.open_uri(u))
            box.pack_start(b, False, False, 0)
        box.show_all()
        pop.add(box)
        return pop

    def on_consent_toggle(self, b):
        if b.get_active() != self.cfg["location_consent"]:
            self.cfg["location_consent"] = b.get_active()
            if not b.get_active():
                self.end_navigation()
                self.unwatch_phone()
                self.map.me = None
                self.map.queue_draw()
            lm.save_config(self.cfg)

    def on_appearance(self, b, key):
        if b.get_active():
            self.cfg["appearance"] = key
            lm.save_config(self.cfg)
            self.apply_appearance()

    def apply_appearance(self):
        mode = self.cfg["appearance"]
        self.map.set_dark(system_dark() if mode == "auto" else mode == "dark")

    def show_page(self, name):
        self.side_btn.set_active(True)
        self.stack.set_visible_child_name(name)

    def check_offline(self):
        self.offline_rev.set_reveal_child(self.map.store.offline)
        return True

    def _prune(self):
        threading.Thread(target=lm.prune_cache, daemon=True).start()
        return False

    def on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        key = ev.keyval
        if ctrl and key in (Gdk.KEY_f, Gdk.KEY_l):
            self.search_entry.grab_focus()
            return True
        if ctrl and key in (Gdk.KEY_q, Gdk.KEY_w):
            self.close()
            return True
        if key == Gdk.KEY_Escape and not isinstance(self.get_focus(), Gtk.Entry):
            if self.nav:
                return True            # navigaci konci jen tlacitko Ukoncit (ne nahodny Esc)
            if self.stack.get_visible_child_name() == "departures":
                self.departures_back()
            elif self.stack.get_visible_child_name() == "directions":
                self.close_directions()
            elif self.place:
                self.place_back()
            return True
        if isinstance(self.get_focus(), Gtk.Entry):
            return False
        if ctrl:
            return False
        step = 120
        moves = {Gdk.KEY_Left: (-step, 0), Gdk.KEY_Right: (step, 0), Gdk.KEY_Up: (0, -step),
                 Gdk.KEY_Down: (0, step)}
        if key in moves and isinstance(self.get_focus(), (MapView, type(None))):
            self.map.pan_by(*moves[key])
            return True
        if key in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.map.zoom_by(1)
            return True
        if key in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.map.zoom_by(-1)
            return True
        return False

    def schedule_save(self):
        if self.closed:
            return                         # zavrene okno: panel se pri ruseni zmensi, nastaveni uz neukladat
        if self.save_id:
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add_seconds(3, self._save_timer)

    def _save_timer(self):
        self.save_id = None
        self.save_view()
        return False

    def save_view(self):
        # primo zavolane ulozeni zrusi cekajici casovac (jinak by pozdeji zapsal starsi nastaveni,
        # i po zavreni okna pres nastaveni jineho okna)
        if self.save_id:
            GLib.source_remove(self.save_id)
            self.save_id = None
        lat, lon = self.map.center()
        self.cfg["view"] = {"lat": round(lat, 6), "lon": round(lon, 6), "zoom": round(self.map.zoom, 2)}
        lm.save_config(self.cfg)
        return False

    def on_destroy(self, _w):
        self.closed = True
        for sb in getattr(self, "suggest", {}).values():
            sb.suggester.stop()
        self.end_navigation()
        self.unwatch_phone()
        if self.dep_timer:
            GLib.source_remove(self.dep_timer)
            self.dep_timer = None
        self.save_view()
        self.map.store.stop()

    # ---- prikazova radka a odkazy geo: ----
    def handle_args(self, args):
        args = [a for a in args if a]
        if not args:
            return
        if args[0] == "--route":
            rest = list(args[1:])
            mode = None
            if "--mode" in rest:
                i = rest.index("--mode")
                mode = rest[i + 1] if i + 1 < len(rest) else None
                del rest[i:i + 2]
            if mode in self.mode_buttons:
                self.mode_buttons[mode].set_active(True)
            self.show_directions(focus=False)
            for which, text in zip(("from", "to"), rest[:2]):
                if text.lower() in lm.HERE_WORDS:
                    self.set_endpoint_me(which)
                else:
                    (self.from_entry if which == "from" else self.to_entry).set_text(text)
                    self.on_endpoint_entry(which)
            return
        text = " ".join(args)
        geo = lm.parse_geo_uri(text)
        if geo:
            if geo["lat"] is None:
                self.search_entry.set_text(geo["query"])
                self.on_search(text=geo["query"])
            else:
                name = geo["label"] or geo["query"] or lm.format_coords(geo["lat"], geo["lon"])
                self.select_place({"name": name, "lat": geo["lat"], "lon": geo["lon"]}, zoom=geo["zoom"] or 16)
            return
        if text.startswith("-"):
            return
        self.search_entry.set_text(text)
        self.on_search(text=text)


class MapsApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        if self.win is None:
            self.win = MapsWindow(self)
            self.win.show_all()
        self.win.present()
        if args:
            # az po prvnim vykresleni (velikost mapy pro prizpusobeni pohledu)
            GLib.idle_add(lambda: (self.win.handle_args(args), False)[1])
        return 0


def main():
    GLib.set_prgname(APP)
    GLib.set_application_name(_("Maps"))
    return MapsApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
