    def on_leg(self, _lst, row):
        lg = row.leg
        if lg["transit"] and lg["from"].get("name"):
            self.show_departures(lg["from"])
        else:
            self.map.fly_to(lg["from"]["lat"], lg["from"]["lon"], max(self.map.zoom, 17))
    def compute_route(self):
        a, b = self.route_from, self.route_to
        if not (a and b):
            return
        self.end_navigation()          # jina trasa nebo zpusob dopravy: navigace po stare trase konci
        self.route_gen += 1
        gen = self.route_gen
        mode = self.cfg["mode"]
        if mode == lm.TRANSIT:
            try:
                when, arrive = self.transit_when()
            except lm.MapsError:
                self.rt_status.set_text(_("Enter the time as HH:MM."))
                return
        self.rt_spinner.start()
        self.rt_status.set_text(_("Finding route…"))
        self.map.route_ends = (a, b)
        self.map.queue_draw()
        if mode == lm.TRANSIT:
            self.transit_query = (when, arrive)

            def transit_work():
                try:
                    res, err = lm.transit_plan(a, b, when, arrive, cfg=self.cfg), None
                except lm.BusyError:
                    res, err = None, "busy"
                except lm.MapsError as e:
                    res, err = None, str(e)
                GLib.idle_add(self.transit_done, gen, res, err)
            threading.Thread(target=transit_work, daemon=True).start()
            return

        def work():
            try:
                res, err = lm.route(a, b, mode, cfg=self.cfg), None
            except lm.MapsError as e:
                res, err = None, str(e)
            GLib.idle_add(self.route_done, gen, res, err)
        threading.Thread(target=work, daemon=True).start()

    def route_done(self, gen, res, err):
        if gen != self.route_gen:
            return False
        self.rt_spinner.stop()
        self.clear_steps()
        self.clear_transit()
        self.route_res = res
        if not res:
            self.map.set_route(None)
            self.map.route_ends = (self.route_from, self.route_to)
            self.rt_time.set_text("")
            self.rt_dist.set_text("")
            self.rt_status.set_text(_("No route found between these places.") if err == "NoRoute"
                                    else _("The route could not be loaded. Check your internet connection."))
            return False
        self.rt_status.set_text("")
        self.rt_time.set_text(lm.format_duration(res["duration"], _))
        self.rt_dist.set_text(lm.format_distance(res["distance"], IMPERIAL))
        self.map.set_route(res)
        self.map.route_ends = (self.route_from, self.route_to)
        self.fill_steps(res)
        self.nav_btn.show()
        lats = [p[0] for p in res["points"]]
        lons = [p[1] for p in res["points"]]
        self.map.fit_bbox(min(lats), max(lats), min(lons), max(lons), max_zoom=17)
        return False

    def fill_steps(self, res):
        for row in self.steps_list.get_children():
            row.destroy()
        for s in res["steps"]:
            row = Gtk.ListBoxRow()
            row.step = s
            hb = Gtk.Box(spacing=10)
            hb.pack_start(TurnIcon(s["type"], s["modifier"]), False, False, 0)
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            vb.pack_start(label(lm.step_instruction(s, _), "row-name", wrap=True), False, False, 0)
            sub = " · ".join(x for x in (s["name"], lm.format_distance(s["distance"], IMPERIAL)
                                         if s["distance"] > 0 else "") if x)
            if sub:
                vb.pack_start(label(sub, "dim small", wrap=True), False, False, 0)
            hb.pack_start(vb, True, True, 0)
            row.add(hb)
            row.show_all()
            self.steps_list.add(row)

    def on_step(self, _l, row):
        s = row.step
        if self.nav:
            self.stop_follow()         # prohlizeni kroku behem navigace; Vycentrovat vrati sledovani
        self.map.step_mark = {"lat": s["lat"], "lon": s["lon"]}
        self.map.fly_to(s["lat"], s["lon"], max(self.map.zoom, 17))

