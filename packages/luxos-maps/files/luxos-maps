def darken(src):
    """Tmava dlazdice: prevracena svetlost, puvodni odstin (voda zustane modra), ztlumeni."""
    w, h = src.get_width(), src.get_height()
    out = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
    cr = cairo.Context(out)
    cr.set_source_surface(src)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_DIFFERENCE)
    cr.set_source_rgb(1, 1, 1)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_HSL_HUE)
    cr.set_source_surface(src)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_OVER)
    cr.set_source_rgba(0.13, 0.15, 0.2, 0.3)
    cr.paint()
    return out


def decode_png(data):
    try:
        return cairo.ImageSurface.create_from_png(io.BytesIO(data))
    except (cairo.Error, MemoryError, ValueError):
        pass
    try:      # jini poskytovatele mohou posilat JPEG
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pix = loader.get_pixbuf()
        surf = cairo.ImageSurface(cairo.FORMAT_RGB24, pix.get_width(), pix.get_height())
        cr = cairo.Context(surf)
        Gdk.cairo_set_source_pixbuf(cr, pix, 0, 0)
        cr.paint()
        return surf
    except (GLib.Error, TypeError):
        return None


def pin_path(cr, x, y, r=11):
    """Spendlik: spicka v (x, y)."""
    cy = y - r * 2.1
    a = math.acos(1 / 2.1)          # tecny ze spicky ke kruhu
    cr.new_path()
    cr.move_to(x, y)
    cr.arc(x, cy, r, math.pi / 2 + a, math.pi / 2 - a + 2 * math.pi)
    cr.close_path()
    return cy


def draw_pin(cr, x, y, color=(0.92, 0.26, 0.24)):
    cr.save()
    cr.set_source_rgba(0, 0, 0, 0.25)
    cr.save()
    cr.translate(x + 2, y)
    cr.scale(1, 0.35)
    cr.arc(0, 0, 6, 0, 2 * math.pi)
    cr.restore()
    cr.fill()
    cy = pin_path(cr, x, y)
    cr.set_source_rgb(*color)
    cr.fill_preserve()
    cr.set_line_width(1.5)
    cr.set_source_rgba(0, 0, 0, 0.3)
    cr.stroke()
    cr.arc(x, cy, 4.2, 0, 2 * math.pi)
    cr.set_source_rgb(1, 1, 1)
    cr.fill()
    cr.restore()


def draw_dot(cr, x, y, color, r=7):
    cr.arc(x, y, r + 2.5, 0, 2 * math.pi)
    cr.set_source_rgb(1, 1, 1)
    cr.fill()
    cr.arc(x, y, r, 0, 2 * math.pi)
    cr.set_source_rgb(*color)
    cr.fill()


def draw_star(cr, x, y, r):
    cr.new_path()
    for i in range(10):
        a = -math.pi / 2 + i * math.pi / 5
        rr = r if i % 2 == 0 else r * 0.45
        cr.line_to(x + rr * math.cos(a), y + rr * math.sin(a))
    cr.close_path()



def set_window_icons(win):
    """Ikona okna 16-256 px (Alt+Tab ukazuje ~100 px; set_icon_name posle jen male velikosti a
    xfwm4 je zvetsi rozmazane). Bez ikony v tematu SVG vedle programu."""
    theme = Gtk.IconTheme.get_default()
    svg = os.path.join(os.path.dirname(os.path.realpath(__file__)), APP + ".svg")
    pixbufs = []
    for size in (16, 24, 32, 48, 64, 128, 256):
        pb = None
        try:
            if theme.has_icon(APP):
                pb = theme.load_icon(APP, size, Gtk.IconLookupFlags.FORCE_SIZE)
            elif os.path.exists(svg):
                pb = GdkPixbuf.Pixbuf.new_from_file_at_size(svg, size, size)
        except GLib.Error:
            pb = None
        if pb:
            pixbufs.append(pb)
    if pixbufs:
        win.set_icon_list(pixbufs)
    else:
        win.set_icon_name(APP)

class TurnIcon(Gtk.DrawingArea):
    """Sipka manevru (vlastni kresba, bez ikon tretich stran)."""
    ANGLES = {"straight": 0, "slight right": 45, "right": 90, "sharp right": 135, "uturn": 180,
              "slight left": -45, "left": -90, "sharp left": -135}

    def __init__(self, typ, modifier):
        super().__init__()
        self.typ, self.mod = typ, modifier
        self.set_size_request(28, 28)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self.draw)

    def draw(self, widget, cr):
        c = widget.get_style_context().get_color(widget.get_state_flags())
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        cx, cy = w / 2, h / 2
        cr.set_line_width(2.4)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        if self.typ == "depart":
            draw_dot(cr, cx, cy, (0.2, 0.7, 0.35), 6)
            return
        if self.typ == "arrive":
            draw_pin(cr, cx, cy + 10)
            return
        cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
        if self.typ in ("roundabout", "rotary"):
            cr.arc(cx, cy + 2, 6, 0, 2 * math.pi)
            cr.stroke()
            cr.move_to(cx, cy + 14)
            cr.line_to(cx, cy + 8)
            cr.stroke()
            cr.move_to(cx + 4, cy - 2)
            cr.line_to(cx + 9, cy - 9)
            cr.stroke()
            return
        if self.mod == "uturn":
            cr.move_to(cx + 5, cy + 11)
            cr.line_to(cx + 5, cy - 2)
            cr.arc_negative(cx, cy - 2, 5, 0, math.pi)
            cr.line_to(cx - 5, cy + 6)
            cr.stroke()
            cr.move_to(cx - 9, cy + 2)
            cr.line_to(cx - 5, cy + 7)
            cr.line_to(cx - 1, cy + 2)
            cr.stroke()
            return
        ang = math.radians(self.ANGLES.get(self.mod, 0))
        cr.move_to(cx, cy + 12)
        cr.line_to(cx, cy + 1)
        ex, ey = cx + 10 * math.sin(ang), cy + 1 - 10 * math.cos(ang)
        cr.line_to(ex, ey)
        cr.stroke()
        for side in (-1, 1):
            a2 = ang + math.pi + side * 0.6
            cr.move_to(ex, ey)
            cr.line_to(ex + 6 * math.sin(a2), ey - 6 * math.cos(a2))
        cr.stroke()


class LineBadge(Gtk.DrawingArea):
    """Odznak linky v barve linky (jako mobilni LuxAI); pesi usek = sede s postavickou."""

    def __init__(self, text, color, fg="#FFFFFF", walk=False, min_width=26):
        super().__init__()
        self.bg, self.fg, self.walk = lm.hex_rgb(color), lm.hex_rgb(fg), walk
        self.layout = self.create_pango_layout("")
        self.layout.set_markup("<b>%s</b>" % GLib.markup_escape_text(text or ""), -1)
        tw, self.th = self.layout.get_pixel_size()
        self.glyph = 10 if walk else 0
        gap = 3 if walk and text else 0
        self.content = tw + self.glyph + gap
        self.set_size_request(max(min_width, self.content + 12), 21)
        self.set_valign(Gtk.Align.CENTER)
        self.set_halign(Gtk.Align.START)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        r = 5
        cr.new_path()
        cr.arc(r, r, r, math.pi, 1.5 * math.pi)
        cr.arc(w - r, r, r, 1.5 * math.pi, 2 * math.pi)
        cr.arc(w - r, h - r, r, 0, 0.5 * math.pi)
        cr.arc(r, h - r, r, 0.5 * math.pi, math.pi)
        cr.close_path()
        cr.set_source_rgb(*self.bg)
        cr.fill()
        cr.set_source_rgb(*self.fg)
        x = max(6, (w - self.content) / 2)
        if self.walk:            # postavicka chodce (vlastni kresba)
            cy = h / 2
            cr.set_line_width(1.5)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.arc(x + 5, cy - 6, 1.9, 0, 2 * math.pi)
            cr.fill()
            for a, b in (((x + 5, cy - 3.5), (x + 4.4, cy + 2)), ((x + 4.4, cy + 2), (x + 1.8, cy + 7)),
                         ((x + 4.4, cy + 2), (x + 7.4, cy + 7)), ((x + 1.6, cy - 0.5), (x + 4.9, cy - 2.8)),
                         ((x + 4.9, cy - 2.8), (x + 8.2, cy - 0.2))):
                cr.move_to(*a)
                cr.line_to(*b)
            cr.stroke()
            x += self.glyph + 3
        cr.move_to(x, (h - self.th) / 2)
        PangoCairo.show_layout(cr, self.layout)
        return False


def leg_badge(leg):
    if not leg["transit"]:
        return LineBadge(_("%d min") % max(1, round(leg["duration_s"] / 60)), "#64748B", "#FFFFFF", walk=True)
    return LineBadge(leg["line"] or _(leg["mode_name"]), leg["color"], leg["text_color"])


def delay_label(delay, realtime, cancelled):
    """Zpozdeni: '+3 min' cervene, 'On time' zelene (jen s daty v realnem case), 'Cancelled'."""
    if cancelled:
        return label(_("Cancelled"), "cancelled")
    if delay and delay > 0:
        return label("+" + _("%d min") % delay, "late")
    if delay and delay < 0:
        return label("−" + _("%d min") % -delay, "ontime")
    if realtime:
        return label(_("On time"), "ontime")
    return None


