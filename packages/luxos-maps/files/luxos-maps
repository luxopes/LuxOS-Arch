    def endpoint_text(self, p):
        return _("My Location") if p and p.get("me") else (p or {}).get("name", "")

    def set_endpoint(self, which, place):
        entry = self.from_entry if which == "from" else self.to_entry
        if which == "from":
            self.route_from = place
        else:
            self.route_to = place
        self._setting_entry = True
        entry.set_text(self.endpoint_text(place))
        self._setting_entry = False
        self.compute_route()

    def on_endpoint_edited(self, which):
        if getattr(self, "_setting_entry", False):
            return
        if which == "from":
            self.route_from = None
        else:
            self.route_to = None

    def on_endpoint_entry(self, which):
        entry = self.from_entry if which == "from" else self.to_entry
        text = entry.get_text().strip()
        if not text:
            return
        if text == _("My Location"):
            self.set_endpoint_me(which)
            return
        self.rt_status.set_text(_("Searching…"))
        self.rt_spinner.start()
        near = self.map.bbox()

        def work():
            try:
                c = lm.parse_coords(text)
                if c:
                    res = [{"name": c[2] or lm.format_coords(c[0], c[1]), "lat": c[0], "lon": c[1]}]
                else:
                    res = lm.search(text, LANG, near=near, cfg=self.cfg, limit=1)
                err = None
            except lm.MapsError as e:
                res, err = [], str(e)
            GLib.idle_add(self.endpoint_found, which, res, err)
        threading.Thread(target=work, daemon=True).start()

    def endpoint_found(self, which, res, err):
        self.rt_spinner.stop()
        if not res:
            self.rt_status.set_text(_("Search failed. Check your internet connection.") if err
                                    else _("No places found."))
            return False
        self.rt_status.set_text("")
        self.set_endpoint(which, res[0])
        return False

    def set_endpoint_me(self, which):
        if self.map.me:
            self.set_endpoint(which, dict(self.map.me, name=_("My Location"), me=True))
        else:
            self.pending_after_location = lambda: self.set_endpoint_me(which)
            self.on_locate()

    def swap_endpoints(self):
        a, b = self.route_from, self.route_to
        self._setting_entry = True
        self.from_entry.set_text(self.endpoint_text(b) if b else self.to_entry.get_text())
        self.to_entry.set_text(self.endpoint_text(a) if a else "")
        self._setting_entry = False
        self.route_from, self.route_to = b, a
        self.compute_route()

    def on_mode(self, button, key):
        if button.get_active():
            self.cfg["mode"] = key
            lm.save_config(self.cfg)
            self.update_mode_ui()
            self.compute_route()

    def update_mode_ui(self):
        transit = self.cfg["mode"] == lm.TRANSIT
        self.transit_opts.set_visible(transit)
        self.when_combo.show()
        self.when_entry.set_visible(transit and self.when_combo.get_active_id() != "now")
        self.steps_list.set_visible(not transit)
        self.itin_list.set_visible(transit)
        self.legs_title.set_visible(transit and bool(self.transit_res))
        self.legs_list.set_visible(transit)
        if transit:
            self.rt_attr.set_markup(GLib.markup_escape_text(_(
                "Public transport: Transitous (MOTIS) with open timetable data, map data © OpenStreetMap "
                "contributors.")) + ' <a href="%s">%s</a>' % (lm.TRANSITOUS_SOURCES_URL,
                                                             GLib.markup_escape_text(_("Data sources"))))
        else:
            self.rt_attr.set_text(_("Routes: FOSSGIS routing server (OSRM), data © OpenStreetMap contributors"))

    def on_when_changed(self, combo):
        now = combo.get_active_id() == "now"
        self.when_entry.set_visible(not now and self.cfg["mode"] == lm.TRANSIT)
        if now:
            self.compute_route()
        else:
            if not self.when_entry.get_text().strip():
                self.when_entry.set_text(time.strftime("%H:%M"))
            self.when_entry.grab_focus()

    def transit_when(self):
        """(cas nebo None = ted, prijezd?) z voleb panelu; neplatny cas -> MapsError."""
        kind = self.when_combo.get_active_id()
        if kind == "now":
            return None, False
        return lm.parse_user_time(self.when_entry.get_text().strip() or time.strftime("%H:%M")), kind == "arrive"

    def show_directions(self, focus=True):
        self.side_btn.set_active(True)
        self.show_page("directions")
        if not self.route_from and self.map.me:
            self.set_endpoint("from", dict(self.map.me, name=_("My Location"), me=True))
        if focus:
            (self.to_entry if self.route_from and not self.route_to else self.from_entry).grab_focus()

    def directions_to(self, place):
        if not place:
            return
        self.show_directions(focus=False)
        self.set_endpoint("to", dict(place))
        if not self.route_from:
            self.from_entry.grab_focus()

    def close_directions(self):
        self.route_gen += 1
        self.route_res = None
        self.map.set_route(None)
        self.clear_steps()
        self.clear_transit()
        self.rt_time.set_text("")
        self.rt_dist.set_text("")
        self.rt_status.set_text("")
        self.show_page("place" if self.place else "home")

    def clear_steps(self):
        for row in self.steps_list.get_children():
            row.destroy()

    def clear_transit(self):
        self.transit_res = None
        for lst in (self.itin_list, self.legs_list):
            for row in lst.get_children():
                row.destroy()
        self.legs_title.set_visible(False)

