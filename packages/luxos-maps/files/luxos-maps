    # ---- mista v okoli (Overpass) ----
    def nearby_menu(self, get_point):
        menu = Gtk.Menu()
        for key, text in NEARBY_LABELS:
            item = Gtk.MenuItem(label=_(text))
            item.connect("activate", lambda _i, k=key: (lambda p: p and self.show_nearby(p["lat"], p["lon"], k))(
                get_point()))
            menu.append(item)
        menu.show_all()
        return menu

    def show_nearby(self, lat, lon, category):
        self.search_gen += 1
        gen = self.search_gen
        for row in self.res_list.get_children():
            row.destroy()
        title = dict(NEARBY_LABELS).get(category, "Results")
        self.res_title.set_text(_(title).upper())
        self.results_kind = "nearby"
        self.res_status.set_visible(False)
        self.res_spinner.start()
        self.side_btn.set_active(True)
        self.show_page("results")
        radius = 600 if category == "public_transport" else 1500

        def work():
            try:
                res, err = lm.nearby(lat, lon, category, radius=radius, limit=30, cfg=self.cfg), None
            except lm.BusyError:
                res, err = [], "busy"
            except lm.MapsError as e:
                res, err = [], str(e)
            GLib.idle_add(self.nearby_done, gen, res, err, category, (lat, lon))
        threading.Thread(target=work, daemon=True).start()

    def nearby_done(self, gen, res, err, category, origin):
        if gen != self.search_gen:
            return False
        self.res_spinner.stop()
        label_text = _(dict(NEARBY_LABELS).get(category, "Results"))
        for p in res:
            if not p["name"]:
                p["name"] = label_text
        self.results = res
        self.map.results = res
        self.map.queue_draw()
        if err:
            self.res_status.set_text(_("The map data service (Overpass) is busy. Try again in a moment.")
                                     if err == "busy" else
                                     _("Search failed. Check your internet connection.") + f"\n({err})")
        elif not res:
            self.res_status.set_text(_("Nothing found nearby."))
        self.res_status.set_visible(bool(err) or not res)
        for p in res:
            row = Gtk.ListBoxRow()
            row.place = p
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            vb.pack_start(label(p["name"], "row-name", ellipsize=3), False, False, 0)
            sub = [lm.format_distance(p["distance_m"], IMPERIAL)]
            if p.get("platforms"):
                sub.append(_("Platforms: %s") % ", ".join(p["platforms"]))
            elif p.get("platform"):
                sub.append(_("Platform %s") % p["platform"])
            if p.get("address"):
                sub.append(p["address"])
            vb.pack_start(label(" · ".join(sub), "dim small", wrap=True, max_width_chars=40), False, False, 0)
            row.add(vb)
            row.show_all()
            self.res_list.add(row)
        if res:
            lats = [p["lat"] for p in res] + [origin[0]]
            lons = [p["lon"] for p in res] + [origin[1]]
            self.map.fit_bbox(min(lats), max(lats), min(lons), max(lons), max_zoom=17)
        return False

    # ---- moje poloha (jen po souhlasu) ----
    def on_locate(self):
        if self.locating:
            return
        if not self.cfg["location_consent"]:
            if not self.ask_consent():
                self.pending_after_location = None
                return
            self.cfg["location_consent"] = True
            lm.save_config(self.cfg)
            self.consent_item.set_active(True)
        self.locating = True
        self.loc_btn.set_sensitive(False)

        def work():
            try:
                loc, err = lm.my_location(self.cfg), None
            except lm.MapsError as e:
                loc, err = None, str(e)
            GLib.idle_add(self.located, loc, err)
        threading.Thread(target=work, daemon=True).start()

    def ask_consent(self):
        """Jednou: souhlas s pouzitim polohy (GeoClue, jinak ipinfo.io podle IP adresy)."""
        if self.cfg["location_consent"]:
            return True
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text=_("Allow Maps to use your location?"))
        dlg.format_secondary_text(_(
            "Maps uses the GPS of your phone when it is connected with LuxOS Companion and shares its "
            "location, otherwise the system location service (GeoClue) when it is available, otherwise it "
            "finds your approximate location from your internet address with the ipinfo.io service (your "
            "address is sent to that service). Maps asks only once; you can turn it off in the menu."))
        dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        dlg.add_button(_("Allow"), Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        ok = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        return ok

    def located(self, loc, err):
        self.locating = False
        self.loc_btn.set_sensitive(True)
        if not loc:
            self.pending_after_location = None
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.CLOSE, text=_("Your location could not be found."))
            dlg.format_secondary_text(_("Check your internet connection and try again.") + (f"\n({err})" if err
                                                                                             else ""))
            dlg.connect("response", lambda d, _r: d.destroy())
            dlg.show()
            return False
        self.map.me = loc
        self.tracking = True
        self.follow = True
        self.watch_phone()
        acc = loc.get("accuracy", 5000)
        zoom = 16 if acc < 200 else 14 if acc < 1500 else 11
        cb, self.pending_after_location = self.pending_after_location, None
        self.map.fly_to(loc["lat"], loc["lon"], zoom)
        if cb:
            cb()
        return False

    # ---- zive sledovani polohy z telefonu (LuxOS Companion) ----
    def watch_phone(self):
        """Po zapnuti Moje poloha: odebirat LocationChanged sluzby luxos-companion (bez jejiho spousteni)."""
        if self.phone_sub is not None or os.environ.get("LUXOS_MAPS_PHONE", "1") == "0":
            return
        try:
            self.phone_bus = lm.companion_bus()
        except GLib.Error:
            return
        self.phone_sub = self.phone_bus.signal_subscribe(
            lm.COMPANION_NAME, lm.COMPANION_NAME, "LocationChanged", lm.COMPANION_PATH, None,
            Gio.DBusSignalFlags.NONE, self.on_phone_signal)

    def unwatch_phone(self):
        self.tracking = False
        self.follow = False
        if self.phone_sub is not None and self.phone_bus is not None:
            self.phone_bus.signal_unsubscribe(self.phone_sub)
        self.phone_sub = None

    def stop_follow(self):
        self.follow = False
        if self.nav:
            self.nav_recenter.show()

    def on_phone_signal(self, _c, _sender, _path, _iface, _sig, params):
        try:
            data = params.unpack()[0]
        except (TypeError, IndexError):
            return
        self.on_phone_location(data)

    def on_phone_location(self, data):
        """Novy fix nebo zastarani polohy telefonu (jen se souhlasem a zapnutym sdilenim)."""
        if not self.tracking or not self.cfg["location_consent"]:
            return
        fix = lm.phone_fix(data) if lm.companion_sharing_enabled() else None
        if fix:
            self.phone_last = time.monotonic()
            if self.nav:
                self.nav_on_fix(fix)          # sipku posune plynule animace navigace
                return
            self.map.me = fix
            if self.follow and not self.map.drag:
                self.map.fly_to(fix["lat"], fix["lon"], None, 0.3)
            else:
                self.map.queue_draw()
        elif self.map.me and self.map.me.get("source") == "phone" and not self.map.me.get("stale"):
            self.map.me = dict(self.map.me, stale=True)
            self.map.queue_draw()
            if self.nav and not self.nav_sim_id:
                self.nav_set_status(_("Location signal lost. Waiting for your location…"))

    # ---- sirka postranniho panelu (Gtk.Paned) ----
    def side_max(self):
        w = self.paned.get_allocated_width()
        return int(lm.clamp(w - MAP_MIN_WIDTH, lm.SIDEBAR_MIN, lm.SIDEBAR_MAX)) if w > 1 else lm.SIDEBAR_MAX

    def _set_side(self, pos):
        self._side_clamping = True
        self.paned.set_position(pos)
        self._side_clamping = False

    def on_side_moved(self, paned, _p):
        pos = paned.get_position()
        if self._side_clamping or not self.side.get_visible():
            return
        top = self.side_max()
        if pos > top:
            self._set_side(top)
            pos = top
        pos = int(lm.clamp(pos, lm.SIDEBAR_MIN, lm.SIDEBAR_MAX))
        if pos != self.side_width:
            # uzivatel panel roztahl/zuzil: pamatovat (ulozi se se zobrazenim mapy)
            self.side_width = pos
            self.cfg["sidebar_width"] = pos
            self.schedule_save()

    def fit_sidebar(self):
        """Uzke okno: panel uzsi, aby mapa mela aspon MAP_MIN_WIDTH; po roztazeni okna zpet na ulozenou sirku."""
        want = min(self.side_width, self.side_max())
        if self.paned.get_position() != want:
            GLib.idle_add(lambda: (self._set_side(min(self.side_width, self.side_max())), False)[1])

