def darken(src):
    """Tmava dlazdice: prevracena svetlost, puvodni odstin (voda zustane modra), ztlumeni."""
    w, h = src.get_width(), src.get_height()
    out = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
    cr = cairo.Context(out)
    cr.set_source_surface(src)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_DIFFERENCE)
    cr.set_source_rgb(1, 1, 1)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_HSL_HUE)
    cr.set_source_surface(src)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_OVER)
    cr.set_source_rgba(0.13, 0.15, 0.2, 0.3)
    cr.paint()
    return out


def decode_png(data):
    try:
        return cairo.ImageSurface.create_from_png(io.BytesIO(data))
    except (cairo.Error, MemoryError, ValueError):
        pass
    try:      # jini poskytovatele mohou posilat JPEG
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pix = loader.get_pixbuf()
        surf = cairo.ImageSurface(cairo.FORMAT_RGB24, pix.get_width(), pix.get_height())
        cr = cairo.Context(surf)
        Gdk.cairo_set_source_pixbuf(cr, pix, 0, 0)
        cr.paint()
        return surf
    except (GLib.Error, TypeError):
        return None


def pin_path(cr, x, y, r=11):
    """Spendlik: spicka v (x, y)."""
    cy = y - r * 2.1
    a = math.acos(1 / 2.1)          # tecny ze spicky ke kruhu
    cr.new_path()
    cr.move_to(x, y)
    cr.arc(x, cy, r, math.pi / 2 + a, math.pi / 2 - a + 2 * math.pi)
    cr.close_path()
    return cy


def draw_pin(cr, x, y, color=(0.92, 0.26, 0.24)):
    cr.save()
    cr.set_source_rgba(0, 0, 0, 0.25)
    cr.save()
    cr.translate(x + 2, y)
    cr.scale(1, 0.35)
    cr.arc(0, 0, 6, 0, 2 * math.pi)
    cr.restore()
    cr.fill()
    cy = pin_path(cr, x, y)
    cr.set_source_rgb(*color)
    cr.fill_preserve()
    cr.set_line_width(1.5)
    cr.set_source_rgba(0, 0, 0, 0.3)
    cr.stroke()
    cr.arc(x, cy, 4.2, 0, 2 * math.pi)
    cr.set_source_rgb(1, 1, 1)
    cr.fill()
    cr.restore()


def draw_dot(cr, x, y, color, r=7):
    cr.arc(x, y, r + 2.5, 0, 2 * math.pi)
    cr.set_source_rgb(1, 1, 1)
    cr.fill()
    cr.arc(x, y, r, 0, 2 * math.pi)
    cr.set_source_rgb(*color)
    cr.fill()


def draw_arrow(cr, x, y, angle, r=13):
    """Sipka polohy v navigaci (spicka ve smeru angle, 0 = nahoru)."""
    cr.save()
    cr.translate(x, y)
    cr.rotate(angle)
    cr.move_to(0, -r)
    cr.line_to(r * 0.78, r * 0.85)
    cr.line_to(0, r * 0.42)
    cr.line_to(-r * 0.78, r * 0.85)
    cr.close_path()
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.set_source_rgb(1, 1, 1)
    cr.set_line_width(5)
    cr.stroke_preserve()
    cr.set_source_rgb(*ACCENT)
    cr.fill()
    cr.restore()


def draw_star(cr, x, y, r):
    cr.new_path()
    for i in range(10):
        a = -math.pi / 2 + i * math.pi / 5
        rr = r if i % 2 == 0 else r * 0.45
        cr.line_to(x + rr * math.cos(a), y + rr * math.sin(a))
    cr.close_path()



def set_window_icons(win):
    """Ikona okna 16-256 px (Alt+Tab ukazuje ~100 px; set_icon_name posle jen male velikosti a
    xfwm4 je zvetsi rozmazane). Bez ikony v tematu SVG vedle programu."""
    theme = Gtk.IconTheme.get_default()
    # zalozni soubory: vedle programu (spusteni ze zdroju) a nainstalovana ikona - tema muze odkazovat
    # na neexistujici soubor (zastarala icon-theme.cache v ~/.local/share/icons), pak by okno ikonu nemelo
    svgs = [os.path.join(os.path.dirname(os.path.realpath(__file__)), APP + ".svg"),
            "/usr/share/icons/hicolor/scalable/apps/%s.svg" % APP]
    pixbufs = []
    for size in (16, 24, 32, 48, 64, 128, 256):
        pb = None
        try:
            if theme.has_icon(APP):
                pb = theme.load_icon(APP, size, Gtk.IconLookupFlags.FORCE_SIZE)
        except GLib.Error:
            pb = None
        for svg in svgs:
            if pb:
                break
            try:
                if os.path.exists(svg):
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(svg, size, size)
            except GLib.Error:
                pb = None
        if pb:
            pixbufs.append(pb)
    if pixbufs:
        win.set_icon_list(pixbufs)
    else:
        win.set_icon_name(APP)

class TurnIcon(Gtk.DrawingArea):
    """Sipka manevru (vlastni kresba, bez ikon tretich stran)."""
    ANGLES = {"straight": 0, "slight right": 45, "right": 90, "sharp right": 135, "uturn": 180,
              "slight left": -45, "left": -90, "sharp left": -135}

    def __init__(self, typ, modifier, size=28):
        super().__init__()
        self.typ, self.mod = typ, modifier
        self.set_size_request(size, size)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self.draw)

    def set_maneuver(self, typ, modifier):
        if (typ, modifier) != (self.typ, self.mod):
            self.typ, self.mod = typ, modifier
            self.queue_draw()

    def draw(self, widget, cr):
        c = widget.get_style_context().get_color(widget.get_state_flags())
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        k = min(w, h) / 28.0            # kresba v mrizce 28x28, vetsi ikona (navigace) se jen zvetsi
        cr.translate((w - 28 * k) / 2, (h - 28 * k) / 2)
        cr.scale(k, k)
        cx, cy = 14, 14
        cr.set_line_width(2.4)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        if self.typ == "depart":
            draw_dot(cr, cx, cy, (0.2, 0.7, 0.35), 6)
            return
        if self.typ == "arrive":
            draw_pin(cr, cx, cy + 10)
            return
        cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
        if self.typ in ("board", "alight"):
            # vuz MHD (nastup), u vystupu se sipkou ven
            x0 = cx - 8 if self.typ == "board" else cx - 11
            cr.new_sub_path()
            cr.arc(x0 + 3, cy - 7, 3, math.pi, 1.5 * math.pi)
            cr.arc(x0 + 13, cy - 7, 3, 1.5 * math.pi, 0)
            cr.arc(x0 + 13, cy + 5, 3, 0, 0.5 * math.pi)
            cr.arc(x0 + 3, cy + 5, 3, 0.5 * math.pi, math.pi)
            cr.close_path()
            cr.stroke()
            cr.move_to(x0, cy - 1)
            cr.line_to(x0 + 16, cy - 1)
            cr.stroke()
            for dx in (4, 12):
                cr.arc(x0 + dx, cy + 10, 1.6, 0, 2 * math.pi)
                cr.fill()
            if self.typ == "alight":
                cr.move_to(cx + 7, cy + 2)
                cr.line_to(cx + 12, cy + 2)
                cr.move_to(cx + 9.5, cy - 0.5)
                cr.line_to(cx + 12, cy + 2)
                cr.line_to(cx + 9.5, cy + 4.5)
                cr.stroke()
            return
        if self.typ == "walk":
            cr.arc(cx + 1, cy - 9, 2.4, 0, 2 * math.pi)
            cr.fill()
            for a, b in (((cx, cy - 5), (cx - 1, cy + 3)), ((cx - 1, cy + 3), (cx - 5, cy + 11)),
                         ((cx - 1, cy + 3), (cx + 4, cy + 11)), ((cx, cy - 4), (cx - 5, cy)),
                         ((cx, cy - 4), (cx + 5, cy - 1))):
                cr.move_to(*a)
                cr.line_to(*b)
            cr.stroke()
            return
        if self.typ in ("roundabout", "rotary"):
            cr.arc(cx, cy + 2, 6, 0, 2 * math.pi)
            cr.stroke()
            cr.move_to(cx, cy + 14)
            cr.line_to(cx, cy + 8)
            cr.stroke()
            cr.move_to(cx + 4, cy - 2)
            cr.line_to(cx + 9, cy - 9)
            cr.stroke()
            return
        if self.mod == "uturn":
            cr.move_to(cx + 5, cy + 11)
            cr.line_to(cx + 5, cy - 2)
            cr.arc_negative(cx, cy - 2, 5, 0, math.pi)
            cr.line_to(cx - 5, cy + 6)
            cr.stroke()
            cr.move_to(cx - 9, cy + 2)
            cr.line_to(cx - 5, cy + 7)
            cr.line_to(cx - 1, cy + 2)
            cr.stroke()
            return
        ang = math.radians(self.ANGLES.get(self.mod, 0))
        cr.move_to(cx, cy + 12)
        cr.line_to(cx, cy + 1)
        ex, ey = cx + 10 * math.sin(ang), cy + 1 - 10 * math.cos(ang)
        cr.line_to(ex, ey)
        cr.stroke()
        for side in (-1, 1):
            a2 = ang + math.pi + side * 0.6
            cr.move_to(ex, ey)
            cr.line_to(ex + 6 * math.sin(a2), ey - 6 * math.cos(a2))
        cr.stroke()


class BadgeChip:
    """Kresba odznaku linky (barva linky, pesi usek sede s postavickou); dlouhy nazev se zkrati na max_width."""
    H = 21

    def __init__(self, widget, text, color, fg="#FFFFFF", walk=False, max_width=BADGE_MAX):
        self.text = text or ""
        self.bg, self.fg, self.walk = lm.hex_rgb(color), lm.hex_rgb(fg), walk
        self.layout = widget.create_pango_layout("")
        self.layout.set_markup("<b>%s</b>" % GLib.markup_escape_text(self.text), -1)
        tw, self.th = self.layout.get_pixel_size()
        self.glyph = 10 if walk else 0
        gap = 3 if walk and text else 0
        self.truncated = tw + self.glyph + gap + 12 > max_width
        if self.truncated:
            self.layout.set_width((max_width - 12 - self.glyph - gap) * Pango.SCALE)
            self.layout.set_ellipsize(Pango.EllipsizeMode.END)
            tw = self.layout.get_pixel_size()[0]
        self.content = tw + self.glyph + gap
        self.width = self.content + 12

    def draw(self, cr, x0, y0, w, h):
        r = 5
        cr.new_path()
        cr.arc(x0 + r, y0 + r, r, math.pi, 1.5 * math.pi)
        cr.arc(x0 + w - r, y0 + r, r, 1.5 * math.pi, 2 * math.pi)
        cr.arc(x0 + w - r, y0 + h - r, r, 0, 0.5 * math.pi)
        cr.arc(x0 + r, y0 + h - r, r, 0.5 * math.pi, math.pi)
        cr.close_path()
        cr.set_source_rgb(*self.bg)
        cr.fill()
        cr.set_source_rgb(*self.fg)
        x = x0 + max(6, (w - self.content) / 2)
        if self.walk:            # postavicka chodce (vlastni kresba)
            cy = y0 + h / 2
            cr.set_line_width(1.5)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.arc(x + 5, cy - 6, 1.9, 0, 2 * math.pi)
            cr.fill()
            for a, b in (((x + 5, cy - 3.5), (x + 4.4, cy + 2)), ((x + 4.4, cy + 2), (x + 1.8, cy + 7)),
                         ((x + 4.4, cy + 2), (x + 7.4, cy + 7)), ((x + 1.6, cy - 0.5), (x + 4.9, cy - 2.8)),
                         ((x + 4.9, cy - 2.8), (x + 8.2, cy - 0.2))):
                cr.move_to(*a)
                cr.line_to(*b)
            cr.stroke()
            x += self.glyph + 3
        cr.move_to(x, y0 + (h - self.th) / 2)
        PangoCairo.show_layout(cr, self.layout)


class LineBadge(Gtk.DrawingArea):
    """Odznak linky v barve linky (jako mobilni LuxAI); dlouhy nazev zkraceny, cely v tipu."""

    def __init__(self, text, color, fg="#FFFFFF", walk=False, min_width=26, max_width=BADGE_MAX):
        super().__init__()
        self.chip = BadgeChip(self, text, color, fg, walk, max_width)
        if self.chip.truncated:
            self.set_tooltip_text(text)
        self.set_size_request(max(min_width, self.chip.width), BadgeChip.H)
        self.set_valign(Gtk.Align.CENTER)
        self.set_halign(Gtk.Align.START)
        self.connect("draw", lambda w, cr: self.chip.draw(cr, 0, 0, w.get_allocated_width(),
                                                          w.get_allocated_height()))


def leg_chip_args(leg):
    if not leg["transit"]:
        return _("%d min") % max(1, round(leg["duration_s"] / 60)), "#64748B", "#FFFFFF", True
    return leg["line"] or _(leg["mode_name"]), leg["color"], leg["text_color"], False


def leg_badge(leg, max_width=BADGE_MAX):
    text, color, fg, walk = leg_chip_args(leg)
    return LineBadge(text, color, fg, walk=walk, max_width=max_width)


class BadgeStrip(Gtk.DrawingArea):
    """Odznaky vsech useku spojeni (1 min › Ex1 (IC 547) › ...), zalomene na dalsi radky podle sirky panelu:
    nejmensi sirka = nejsirsi odznak, takze dlouhe spojeni nikdy nerozsiri postranni panel."""
    GAP, ROW_GAP = 4, 4

    def __init__(self, legs):
        super().__init__(hexpand=True)
        self.chips = [BadgeChip(self, *leg_chip_args(lg)) for lg in legs]
        self.sep = self.create_pango_layout("›")
        self.sep_w, self.sep_h = self.sep.get_pixel_size()
        self.set_has_tooltip(True)
        self.connect("query-tooltip", self.on_tooltip)
        self.connect("draw", self.on_draw)

    def unit(self, i):
        """Sirka odznaku i vcetne nasledujiciho "›" (radek konci sipkou, nezacina ji)."""
        return self.chips[i].width + (self.GAP * 2 + self.sep_w if i + 1 < len(self.chips) else 0)

    def place(self, width):
        """[(x, y, chip)] pri dane sirce."""
        out, x, y = [], 0, 0
        for i, c in enumerate(self.chips):
            if x and x + self.unit(i) > width:
                x, y = 0, y + BadgeChip.H + self.ROW_GAP
            out.append((x, y, c))
            x += self.unit(i)
        return out

    def do_get_request_mode(self):
        return Gtk.SizeRequestMode.HEIGHT_FOR_WIDTH

    def do_get_preferred_width(self):
        units = [self.unit(i) for i in range(len(self.chips))] or [0]
        return max(units), sum(units)

    def do_get_preferred_height_for_width(self, width):
        p = self.place(width)
        h = (p[-1][1] + BadgeChip.H) if p else 0
        return h, h

    def do_get_preferred_height(self):
        return self.do_get_preferred_height_for_width(self.do_get_preferred_width()[0])

    def on_draw(self, widget, cr):
        fg = widget.get_style_context().get_color(widget.get_state_flags())
        for i, (x, y, c) in enumerate(self.place(widget.get_allocated_width())):
            c.draw(cr, x, y, c.width, BadgeChip.H)
            if i + 1 < len(self.chips):
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
                cr.move_to(x + c.width + self.GAP, y + (BadgeChip.H - self.sep_h) / 2)
                PangoCairo.show_layout(cr, self.sep)
        return False

    def on_tooltip(self, widget, x, y, _kb, tip):
        for cx, cy, c in self.place(widget.get_allocated_width()):
            if c.truncated and cx <= x < cx + c.width and cy <= y < cy + BadgeChip.H:
                tip.set_text(c.text)
                return True
        return False


def delay_label(delay, realtime, cancelled):
    """Zpozdeni: '+3 min' cervene, 'On time' zelene (jen s daty v realnem case), 'Cancelled'."""
    if cancelled:
        return label(_("Cancelled"), "cancelled")
    if delay and delay > 0:
        return label("+" + _("%d min") % delay, "late")
    if delay and delay < 0:
        return label("−" + _("%d min") % -delay, "ontime")
    if realtime:
        return label(_("On time"), "ontime")
    return None


# ---- mapa ---------------------------------------------------------------------------
class MapView(Gtk.DrawingArea):
    """Posuvna mapa: tazeni (se setrvacnosti), kolecko/touchpad = plynuly zoom k mysi, klavesy."""

    def __init__(self, tile_url, lat, lon, zoom):
        super().__init__(can_focus=True, hexpand=True, vexpand=True)
        self.mx, self.my = lm.to_world(lat, lon)
        self.zoom = zoom
        self.dark = False
        self.mem = {}                      # (z,x,y) -> surface; poradi = LRU
        self.failed = {}                   # (z,x,y) -> cas neuspechu
        self.missing_sent = None
        self.store = lm.TileStore(tile_url, self._tile_from_thread)
        self.marker = None                 # {"lat","lon"}
        self.results = []                  # vysledky hledani (male body)
        self.favorites = []
        self.me = None                     # {"lat","lon","accuracy"}
        self.route = None                  # {"mode", "legs": [{"world": [(x,y)], "color", "walk"}]}
        self.route_ends = None
        self.stops = []                    # zastavky vybraneho spojeni MHD (klik = odjezdy)
        self.step_mark = None
        self.rotation = 0.0                # rad, otoceni mapy (navigace po smeru jizdy); 0 = sever nahore
        self.nav_heading = None            # navigace: kurz sipky polohy ve stupnich (misto bodu)
        self.anim = None
        self.kinetic = None
        self.drag = None
        self.samples = []
        self.on_view_changed = None
        self.on_user_move = None           # tazeni mapy uzivatelem (konec sledovani polohy)
        self.on_context = None
        self.on_marker_click = None
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK
                        | Gdk.EventMask.SMOOTH_SCROLL_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("scroll-event", self.on_scroll)
        self.connect("destroy", lambda _w: self.store.stop())
        self.tick_id = None

    # ---- souradnice ----
    @property
    def scale(self):
        return lm.TILE * (2 ** self.zoom)

    def center(self):
        return lm.from_world(self.mx, self.my)

    def rot(self, dx, dy):
        """Posun ve svete (px od stredu, sever nahore) -> posun na obrazovce (otocena mapa)."""
        if not self.rotation:
            return dx, dy
        c, s = math.cos(self.rotation), math.sin(self.rotation)
        return dx * c - dy * s, dx * s + dy * c

    def unrot(self, dx, dy):
        """Posun na obrazovce -> posun ve svete (opak rot)."""
        if not self.rotation:
            return dx, dy
        c, s = math.cos(self.rotation), math.sin(self.rotation)
        return dx * c + dy * s, -dx * s + dy * c

    def screen_to_world(self, sx, sy):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        dx, dy = self.unrot(sx - w / 2, sy - h / 2)
        return self.mx + dx / self.scale, self.my + dy / self.scale

    def screen_to_latlon(self, sx, sy):
        return lm.from_world(*self.screen_to_world(sx, sy))

    def world_to_screen(self, wx, wy):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        # nejblizsi kopie sveta (mapa se opakuje do stran)
        dx = wx - self.mx
        dx -= round(dx)
        x, y = self.rot(dx * self.scale, (wy - self.my) * self.scale)
        return w / 2 + x, h / 2 + y

    def latlon_to_screen(self, lat, lon):
        return self.world_to_screen(*lm.to_world(lat, lon))

    def bbox(self):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        n, wlon = self.screen_to_latlon(0, 0)
        s, elon = self.screen_to_latlon(w, h)
        return s, n, wlon, elon

    def set_view(self, mx, my, zoom, notify=True):
        self.zoom = lm.clamp(zoom, 1, lm.MAX_ZOOM)
        self.mx = mx % 1.0
        self.my = lm.clamp(my, 0.0, 1.0)
        self.queue_draw()
        if notify and self.on_view_changed:
            self.on_view_changed()

    # ---- animace ----
    def _ensure_tick(self):
        if self.tick_id is None:
            self.tick_id = self.add_tick_callback(self._tick)

    def _tick(self, _w, clock):
        now = clock.get_frame_time() / 1e6
        busy = False
        if self.anim:
            a = self.anim
            if a["start"] is None:
                a["start"] = now
            t = min(1.0, (now - a["start"]) / a["dur"])
            k = 1 - (1 - t) ** 3            # ease-out
            z = a["z0"] + (a["z1"] - a["z0"]) * k
            if a.get("anchor"):
                ax, ay, wx, wy = a["anchor"]
                s = lm.TILE * (2 ** z)
                mx, my = wx - ax / s, wy - ay / s
            else:
                dx = a["x1"] - a["x0"]
                dx -= round(dx)
                mx, my = a["x0"] + dx * k, a["y0"] + (a["y1"] - a["y0"]) * k
            self.set_view(mx, my, z, notify=t >= 1.0)
            if t >= 1.0:
                self.anim = None
            else:
                busy = True
        if self.kinetic:
            vx, vy, last = self.kinetic
            dt = max(0.001, now - last) if last else 1 / 60
            decay = math.exp(-dt * 4.5)
            vx, vy = vx * decay, vy * decay
            dx, dy = self.unrot(vx * dt, vy * dt)
            self.set_view(self.mx - dx / self.scale, self.my - dy / self.scale, self.zoom, notify=False)
            if math.hypot(vx, vy) < 20:
                self.kinetic = None
                if self.on_view_changed:
                    self.on_view_changed()
            else:
                self.kinetic = (vx, vy, now)
                busy = True
        if not busy:
            self.tick_id = None
            return False
        return True

    def zoom_at(self, sx, sy, target, duration=0.22):
        target = lm.clamp(target, 1, lm.MAX_ZOOM)
        w, h = self.get_allocated_width(), self.get_allocated_height()
        ax, ay = self.unrot(sx - w / 2, sy - h / 2)
        wx, wy = self.screen_to_world(sx, sy)
        if duration <= 0:
            s = lm.TILE * (2 ** target)
            self.set_view(wx - ax / s, wy - ay / s, target)
            return
        self.kinetic = None
        self.anim = {"start": None, "dur": duration, "z0": self.zoom, "z1": target, "anchor": (ax, ay, wx, wy)}
        self._ensure_tick()

    def zoom_by(self, delta):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        base = self.anim["z1"] if self.anim and self.anim.get("anchor") else self.zoom
        self.zoom_at(w / 2, h / 2, round(base + delta) if abs(delta) >= 1 else base + delta)

    def fly_to(self, lat, lon, zoom=None, duration=0.45):
        x1, y1 = lm.to_world(lat, lon)
        z1 = self.zoom if zoom is None else lm.clamp(zoom, 1, lm.MAX_ZOOM)
        # daleko (vic nez ~3 obrazovky): skok, at se nestahuji dlazdice cele cesty
        far = math.hypot((x1 - self.mx) * self.scale, (y1 - self.my) * self.scale) > 3 * max(
            self.get_allocated_width(), 400)
        self.kinetic = None
        if far or duration <= 0 or not self.get_mapped():
            self.anim = None
            self.set_view(x1, y1, z1)
            return
        self.anim = {"start": None, "dur": duration, "z0": self.zoom, "z1": z1, "x0": self.mx, "y0": self.my,
                     "x1": x1, "y1": y1}
        self._ensure_tick()

    def fit_bbox(self, south, north, west, east, max_zoom=17):
        w, h = max(self.get_allocated_width(), 300), max(self.get_allocated_height(), 300)
        z = lm.zoom_for_bbox(south, north, west, east, w, h, max_zoom)
        x0, y0 = lm.to_world(north, west)
        x1, y1 = lm.to_world(south, east)
        lat, lon = lm.from_world((x0 + x1) / 2, (y0 + y1) / 2)
        self.fly_to(lat, lon, z)

    def pan_by(self, dx, dy):
        self.kinetic = None
        dx, dy = self.unrot(dx, dy)
        lat, lon = lm.from_world(self.mx + dx / self.scale, self.my + dy / self.scale)
        self.fly_to(lat, lon, duration=0.18)

    # ---- mys ----
    def on_press(self, _w, ev):
        self.grab_focus()
        if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1:
            self.zoom_at(ev.x, ev.y, round(self.zoom) + 1)
            return True
        if ev.type != Gdk.EventType.BUTTON_PRESS:
            return True
        if ev.button == 3 or (ev.button == 1 and ev.state & Gdk.ModifierType.CONTROL_MASK):
            if self.on_context:
                lat, lon = self.screen_to_latlon(ev.x, ev.y)
                self.on_context(lat, lon, ev)
            return True
        if ev.button == 1:
            self.anim = None
            self.kinetic = None
            self.drag = (ev.x, ev.y, self.mx, self.my, False)
            self.samples = [(ev.time, ev.x, ev.y)]
        return True

    def on_motion(self, _w, ev):
        if not self.drag:
            return False
        x0, y0, mx0, my0, moved = self.drag
        if not moved and math.hypot(ev.x - x0, ev.y - y0) < 4:
            return True
        if not moved:
            win = self.get_window()
            if win:
                win.set_cursor(Gdk.Cursor.new_from_name(self.get_display(), "grabbing"))
            if self.on_user_move:
                self.on_user_move()
        self.drag = (x0, y0, mx0, my0, True)
        dx, dy = self.unrot(ev.x - x0, ev.y - y0)
        self.set_view(mx0 - dx / self.scale, my0 - dy / self.scale, self.zoom, notify=False)
        self.samples.append((ev.time, ev.x, ev.y))
        self.samples = self.samples[-6:]
        return True

    def on_release(self, _w, ev):
        if ev.button != 1 or not self.drag:
            return False
        moved = self.drag[4]
        self.drag = None
        win = self.get_window()
        if win:
            win.set_cursor(None)
        if not moved:
            hit = self.hit_marker(ev.x, ev.y)
            if hit is not None and self.on_marker_click:
                self.on_marker_click(hit)
            return True
        # setrvacnost podle poslednich ~80 ms pohybu
        recent = [s for s in self.samples if ev.time - s[0] <= 80]
        if len(recent) >= 2 and recent[-1][0] > recent[0][0]:
            dt = (recent[-1][0] - recent[0][0]) / 1000.0
            vx, vy = (recent[-1][1] - recent[0][1]) / dt, (recent[-1][2] - recent[0][2]) / dt
            if math.hypot(vx, vy) > 250:
                self.kinetic = (min(max(vx, -4000), 4000), min(max(vy, -4000), 4000), None)
                self._ensure_tick()
                return True
        if self.on_view_changed:
            self.on_view_changed()
        return True

    def on_scroll(self, _w, ev):
        if ev.direction == Gdk.ScrollDirection.SMOOTH:
            _ok, dx, dy = ev.get_scroll_deltas()
            if ev.get_source_device() and ev.get_source_device().get_source() == Gdk.InputSource.MOUSE \
                    and abs(dy) >= 1:
                step = -1 if dy > 0 else 1        # kolecko mysi: cely krok s animaci
                base = self.anim["z1"] if self.anim and self.anim.get("anchor") else self.zoom
                self.zoom_at(ev.x, ev.y, round(base) + step)
            else:
                self.anim = None
                self.zoom_at(ev.x, ev.y, self.zoom - dy * 0.35, duration=0)
            return True
        step = {Gdk.ScrollDirection.UP: 1, Gdk.ScrollDirection.DOWN: -1}.get(ev.direction)
        if step:
            base = self.anim["z1"] if self.anim and self.anim.get("anchor") else self.zoom
            self.zoom_at(ev.x, ev.y, round(base) + step)
        return True

    def hit_marker(self, sx, sy):
        for i, st in enumerate(self.stops):
            x, y = self.latlon_to_screen(st["lat"], st["lon"])
            if math.hypot(sx - x, sy - y) <= 10:
                return ("stop", i)
        for i, f in enumerate(self.favorites):
            x, y = self.latlon_to_screen(f["lat"], f["lon"])
            if math.hypot(sx - x, sy - y) <= 12:
                return ("favorite", i)
        if self.me:
            x, y = self.latlon_to_screen(self.me["lat"], self.me["lon"])
            if math.hypot(sx - x, sy - y) <= 12:
                return ("me", 0)
        for i, p in enumerate(self.results):
            x, y = self.latlon_to_screen(p["lat"], p["lon"])
            if math.hypot(sx - x, sy - y) <= 9:
                return ("result", i)
        return None

    # ---- dlazdice ----
    def set_dark(self, dark):
        if dark != self.dark:
            self.dark = dark
            self.mem.clear()
            self.missing_sent = None
            self.queue_draw()

    def _tile_from_thread(self, key, data):
        GLib.idle_add(self._tile_ready, key, data, priority=GLib.PRIORITY_HIGH_IDLE)

    def _tile_ready(self, key, data):
        if data is None:
            self.failed[key] = time.time()
        else:
            surf = decode_png(data)
            if surf is None:
                self.failed[key] = time.time()
            else:
                self.failed.pop(key, None)
                self.mem.pop(key, None)
                self.mem[key] = darken(surf) if self.dark else surf
                while len(self.mem) > MEM_TILES:
                    self.mem.pop(next(iter(self.mem)))
        self.queue_draw()
        return False

    def _get(self, key):
        s = self.mem.get(key)
        if s is not None:          # LRU: posunout na konec
            del self.mem[key]
            self.mem[key] = s
        return s

    def _paint_tile(self, cr, surf, x0, y0, x1, y1, sub=None):
        """Dlazdici (nebo jeji cast sub=(ox, oy, velikost)) do obdelniku na obrazovce."""
        ox, oy, size = sub or (0, 0, lm.TILE)
        cr.save()
        cr.rectangle(x0, y0, x1 - x0, y1 - y0)
        cr.clip()
        cr.translate(x0, y0)
        cr.scale((x1 - x0) / size, (y1 - y0) / size)
        cr.set_source_surface(surf, -ox, -oy)
        pat = cr.get_source()
        pat.set_extend(cairo.EXTEND_PAD)
        pat.set_filter(cairo.FILTER_BILINEAR if abs(x1 - x0 - size) > 0.5 else cairo.FILTER_FAST)
        cr.paint()
        cr.restore()

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        bg = (0.11, 0.12, 0.15) if self.dark else (0.95, 0.94, 0.91)
        cr.set_source_rgb(*bg)
        cr.paint()
        tz = int(lm.clamp(math.floor(self.zoom + 0.5), 0, lm.MAX_ZOOM))
        n = 2 ** tz
        ts = lm.TILE * (2 ** (self.zoom - tz))
        left = self.mx * self.scale - w / 2
        top = self.my * self.scale - h / 2
        # otocena mapa (navigace): dlazdice pod otocenim kolem stredu, potreba ctverec s uhloprickou okna
        ew, eh = (math.hypot(w, h),) * 2 if self.rotation else (w, h)
        el, et = self.mx * self.scale - ew / 2, self.my * self.scale - eh / 2
        ix0, ix1 = math.floor(el / ts), math.floor((el + ew) / ts)
        iy0, iy1 = max(0, math.floor(et / ts)), min(n - 1, math.floor((et + eh) / ts))
        if self.rotation:
            cr.save()
            cr.translate(w / 2, h / 2)
            cr.rotate(self.rotation)
            cr.translate(-w / 2, -h / 2)
            cr.set_antialias(cairo.ANTIALIAS_NONE)       # bez svetlych spar mezi otocenymi dlazdicemi
        missing = []
        now = time.time()
        for iy in range(iy0, iy1 + 1):
            for ix in range(ix0, ix1 + 1):
                x = ix % n
                key = (tz, x, iy)
                sx0, sy0 = round(ix * ts - left), round(iy * ts - top)
                sx1, sy1 = round((ix + 1) * ts - left), round((iy + 1) * ts - top)
                surf = self._get(key)
                if surf is not None:
                    self._paint_tile(cr, surf, sx0, sy0, sx1, sy1)
                    continue
                self._draw_fallback(cr, tz, x, iy, sx0, sy0, sx1, sy1)
                if now - self.failed.get(key, 0) > RETRY_FAILED:
                    cx, cy = (ix + 0.5) * ts - left - w / 2, (iy + 0.5) * ts - top - h / 2
                    missing.append((cx * cx + cy * cy, key))
        if self.rotation:
            cr.restore()
        keys = tuple(k for _d, k in sorted(missing))
        if keys != self.missing_sent:
            self.missing_sent = keys
            self.store.want(list(keys))
        self._draw_overlays(cr, w, h)
        self._draw_scale(cr, w, h)
        return False

    def _draw_fallback(self, cr, tz, x, y, sx0, sy0, sx1, sy1):
        """Chybejici dlazdice: zvetseny vyrez z nizsiho zoomu (nebo ctvrtiny z vyssiho), jinak mrizka."""
        for d in range(1, 7):
            pz = tz - d
            if pz < 0:
                break
            parent = self.mem.get((pz, x >> d, y >> d))
            if parent is not None:
                size = lm.TILE / (2 ** d)
                ox, oy = (x - ((x >> d) << d)) * size, (y - ((y >> d) << d)) * size
                self._paint_tile(cr, parent, sx0, sy0, sx1, sy1, (ox, oy, size))
                return
        drawn = False
        if tz < lm.MAX_ZOOM:
            mx, my = (sx0 + sx1) / 2, (sy0 + sy1) / 2
            for cx in (0, 1):
                for cy in (0, 1):
                    child = self.mem.get((tz + 1, 2 * x + cx, 2 * y + cy))
                    if child is not None:
                        self._paint_tile(cr, child, (sx0, mx)[cx], (sy0, my)[cy], (mx, sx1)[cx], (my, sy1)[cy])
                        drawn = True
        if not drawn:
            cr.set_source_rgba(0.5, 0.5, 0.5, 0.12)
            cr.set_line_width(1)
            cr.rectangle(sx0 + 0.5, sy0 + 0.5, sx1 - sx0 - 1, sy1 - sy0 - 1)
            cr.stroke()

    def _screen_path(self, world):
        pts = [self.world_to_screen(x, y) for x, y in world]
        # vynechat body blize nez 1,5 px (rychlejsi kresleni dlouhych tras)
        simple = [pts[0]]
        for p in pts[1:]:
            q = simple[-1]
            if abs(p[0] - q[0]) + abs(p[1] - q[1]) >= 1.5:
                simple.append(p)
        simple.append(pts[-1])
        return simple

    def _draw_route(self, cr):
        transit = self.route["mode"] == lm.TRANSIT
        legs = [(self._screen_path(lg["world"]), lg) for lg in self.route["legs"] if len(lg["world"]) >= 2]
        cr.save()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        # nejdriv vsechny okraje, aby sousedni useky MHD zustaly ostre (jako mobilni LuxAI)
        for pts, lg in legs:
            if transit and lg["walk"]:
                continue
            cr.new_path()
            for x, y in pts:
                cr.line_to(x, y)
            cr.set_line_width(9)
            cr.set_source_rgba(*((1, 1, 1, 0.95) if transit else (0.1, 0.25, 0.65, 0.9)))
            cr.stroke()
        for pts, lg in legs:
            cr.new_path()
            for x, y in pts:
                cr.line_to(x, y)
            if lg["walk"]:
                cr.set_dash([0.1, 9])
                cr.set_line_width(6 if not transit else 5.5)
                cr.set_source_rgb(*((1, 1, 1) if not transit else (0.39, 0.45, 0.55)))
            else:
                cr.set_dash([])
                cr.set_line_width(5.5)
                cr.set_source_rgb(*lg["color"])
            cr.stroke()
        cr.restore()

    def _draw_overlays(self, cr, w, h):
        if self.route and self.route["legs"]:
            self._draw_route(cr)
        for st in self.stops:
            x, y = self.latlon_to_screen(st["lat"], st["lon"])
            if -20 < x < w + 20 and -20 < y < h + 20:
                cr.arc(x, y, 6.5, 0, 2 * math.pi)
                cr.set_source_rgb(*st["color"])
                cr.fill()
                cr.arc(x, y, 3.8, 0, 2 * math.pi)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
        if self.route_ends:
            a, b = self.route_ends
            draw_dot(cr, *self.latlon_to_screen(a["lat"], a["lon"]), (0.2, 0.7, 0.35), 6)
            if not (self.marker and lm.same_place(self.marker, b)):
                draw_pin(cr, *self.latlon_to_screen(b["lat"], b["lon"]))
        if self.step_mark:
            x, y = self.latlon_to_screen(self.step_mark["lat"], self.step_mark["lon"])
            cr.arc(x, y, 8, 0, 2 * math.pi)
            cr.set_source_rgb(1, 1, 1)
            cr.fill_preserve()
            cr.set_line_width(3)
            cr.set_source_rgb(*ACCENT)
            cr.stroke()
        for p in self.results:
            if self.marker and lm.same_place(self.marker, p):
                continue
            x, y = self.latlon_to_screen(p["lat"], p["lon"])
            if -20 < x < w + 20 and -20 < y < h + 20:
                draw_dot(cr, x, y, (0.92, 0.26, 0.24), 5.5)
        for f in self.favorites:
            if self.marker and lm.same_place(self.marker, f):
                continue          # vybrane misto ukazuje spendlik
            x, y = self.latlon_to_screen(f["lat"], f["lon"])
            if -20 < x < w + 20 and -20 < y < h + 20:
                cr.arc(x, y, 10, 0, 2 * math.pi)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
                cr.arc(x, y, 8.5, 0, 2 * math.pi)
                cr.set_source_rgb(1.0, 0.7, 0.0)
                cr.fill()
                draw_star(cr, x, y, 5.5)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
        if self.me:
            x, y = self.latlon_to_screen(self.me["lat"], self.me["lon"])
            mpp = lm.meters_per_pixel(self.me["lat"], self.zoom)
            r = self.me.get("accuracy", 0) / mpp
            if self.me.get("stale"):
                # poloha z telefonu zastarala (odpojeni, vypnute GPS, 15 s bez fixu): sedy bod bez kruhu
                draw_dot(cr, x, y, (0.55, 0.57, 0.62), 7)
                r = 0
            elif r > 12:
                cr.arc(x, y, min(r, 4 * max(w, h)), 0, 2 * math.pi)
                cr.set_source_rgba(*ACCENT, 0.13)
                cr.fill_preserve()
                cr.set_line_width(1)
                cr.set_source_rgba(*ACCENT, 0.45)
                cr.stroke()
            if not self.me.get("stale"):
                if self.nav_heading is not None:
                    draw_arrow(cr, x, y, math.radians(self.nav_heading) + self.rotation)
                else:
                    draw_dot(cr, x, y, ACCENT, 7)
        if self.marker:
            draw_pin(cr, *self.latlon_to_screen(self.marker["lat"], self.marker["lon"]))

    def _draw_scale(self, cr, w, h):
        lat, _lon = self.center()
        mpp = lm.meters_per_pixel(lat, self.zoom)
        if IMPERIAL:
            cands = [m * 10 ** e * 0.3048 for e in range(1, 3) for m in (1, 2, 5)] + \
                [m * 10 ** e * 1609.344 for e in range(-1, 4) for m in (1, 2, 5)]
        else:
            cands = [m * 10 ** e for e in range(0, 7) for m in (1, 2, 5)]
        fits = [v for v in cands if v <= 110 * mpp]
        if not fits:
            return
        best = max(fits)
        px = best / mpp
        txt = lm.format_distance(best, IMPERIAL)
        x, y = 12, h - 14
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(11)
        fg = (0.92, 0.92, 0.92) if self.dark else (0.15, 0.15, 0.15)
        halo = (0, 0, 0, 0.6) if self.dark else (1, 1, 1, 0.85)
        for color, width in ((halo, 4), (fg + (1,), 1.6)):
            cr.set_source_rgba(*color)
            cr.set_line_width(width)
            cr.move_to(x, y - 5)
            cr.line_to(x, y)
            cr.line_to(x + px, y)
            cr.line_to(x + px, y - 5)
            cr.stroke()
        cr.move_to(x + 2, y - 8)
        cr.text_path(txt)
        cr.set_source_rgba(*halo)
        cr.set_line_width(3)
        cr.stroke_preserve()
        cr.set_source_rgb(*fg)
        cr.fill()

    def set_route(self, res):
        self.stops = []
        if res is None:
            self.route = None
            self.route_ends = None
            self.step_mark = None
        else:
            self.route = {"mode": res["mode"], "legs": [{"world": [lm.to_world(a, b) for a, b in res["points"]],
                                                          "color": ACCENT, "walk": res["mode"] == "walk"}]}
        self.queue_draw()

    def set_transit(self, it):
        """Vybrane spojeni MHD: useky v barvach linek, pesky teckovane, zastavky prestupu."""
        self.step_mark = None
        legs, stops = [], []
        for lg in it["legs"]:
            pts = lm.leg_points(lg) or [(lg["from"]["lat"], lg["from"]["lon"]), (lg["to"]["lat"], lg["to"]["lon"])]
            legs.append({"world": [lm.to_world(a, b) for a, b in pts], "color": lm.hex_rgb(lg["color"]),
                         "walk": not lg["transit"]})
            if lg["transit"]:
                for end in (lg["from"], lg["to"]):
                    if end.get("name") and not any(lm.same_place(end, s) for s in stops):
                        stops.append(dict(end, color=lm.hex_rgb(lg["color"])))
        self.route = {"mode": lm.TRANSIT, "legs": legs}
        self.stops = stops
        self.queue_draw()


class GeoClueWatch:
    """Zive polohy ze systemove sluzby GeoClue (signal LocationUpdated) pro navigaci bez telefonu.
    Pripojeni ve vlakne (GetClient ceka na agenta GeoClue), signaly a cteni polohy asynchronne."""
    NAME = "org.freedesktop.GeoClue2"
    CLIENT = "org.freedesktop.GeoClue2.Client"

    def __init__(self, callback):
        self.callback = callback
        self.bus = self.client = self.sub = None
        self.stopped = False
        threading.Thread(target=self._setup, daemon=True).start()

    def _setup(self):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            client = bus.call_sync(self.NAME, "/org/freedesktop/GeoClue2/Manager", "org.freedesktop.GeoClue2.Manager",
                                   "GetClient", None, None, Gio.DBusCallFlags.NONE, 2500, None).unpack()[0]
            for prop, val in (("DesktopId", GLib.Variant("s", APP)), ("RequestedAccuracyLevel", GLib.Variant("u", 8)),
                              ("DistanceThreshold", GLib.Variant("u", 0)), ("TimeThreshold", GLib.Variant("u", 0))):
                bus.call_sync(self.NAME, client, "org.freedesktop.DBus.Properties", "Set",
                              GLib.Variant("(ssv)", (self.CLIENT, prop, val)), None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return                       # GeoClue chybi nebo aplikaci odmitl
        GLib.idle_add(self._start, bus, client)

    def _start(self, bus, client):
        self.bus, self.client = bus, client
        if self.stopped:
            self._stop_client()
            return False
        self.sub = bus.signal_subscribe(self.NAME, self.CLIENT, "LocationUpdated", client, None,
                                        Gio.DBusSignalFlags.NONE, self._on_updated)
        bus.call(self.NAME, client, self.CLIENT, "Start", None, None, Gio.DBusCallFlags.NONE, 5000, None, None)
        return False

    def _on_updated(self, bus, _sender, _path, _iface, _sig, params):
        new = params.unpack()[1]
        if self.stopped or not new or new == "/":
            return

        def got(b, res):
            try:
                p = b.call_finish(res).unpack()[0]
            except GLib.Error:
                return
            if self.stopped or not all(k in p for k in ("Latitude", "Longitude")):
                return
            fix = {"lat": p["Latitude"], "lon": p["Longitude"], "accuracy": max(1.0, p.get("Accuracy", 50.0)),
                   "source": "geoclue", "name": ""}
            if p.get("Speed", -1) >= 0:
                fix["speed"] = p["Speed"]
            if p.get("Heading", -1) >= 0:
                fix["bearing"] = p["Heading"]
            self.callback(fix)
        bus.call(self.NAME, new, "org.freedesktop.DBus.Properties", "GetAll",
                 GLib.Variant("(s)", ("org.freedesktop.GeoClue2.Location",)), GLib.VariantType("(a{sv})"),
                 Gio.DBusCallFlags.NONE, 2000, None, got)

    def _stop_client(self):
        if self.bus and self.client:
            self.bus.call(self.NAME, self.client, self.CLIENT, "Stop", None, None, Gio.DBusCallFlags.NONE, 2000,
                          None, None)

    def stop(self):
        self.stopped = True
        if self.bus and self.sub is not None:
            self.bus.signal_unsubscribe(self.sub)
            self.sub = None
        self._stop_client()


