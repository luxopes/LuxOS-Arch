    def on_itinerary(self, _lst, row):
        if row is None or not self.transit_res or getattr(self, "_nav_selecting", False):
            return
        if self.nav and row.idx != self.itin_idx:
            self.end_navigation()          # jine spojeni: navigace po starem konci
        self.show_itinerary(row.idx)

    def show_itinerary(self, idx, fit=True):
        it = self.transit_res["itineraries"][idx]
        self.itin_idx = idx
        self.rt_time.set_text(lm.format_duration(it["duration_s"], _))
        self.rt_dist.set_text("%s – %s" % (it["departure_time"], it["arrival_time"]))
        self.map.set_transit(it)
        self.map.route_ends = (self.route_from, self.route_to)
        if not self.nav:
            self.nav_btn.show()
        for row in self.legs_list.get_children():
            row.destroy()
        for lg in it["legs"]:
            self.legs_list.add(self.leg_row(lg))
        self.legs_title.set_visible(True)
        if not fit:
            return
        lats = [p["lat"] for p in (self.route_from, self.route_to)]
        lons = [p["lon"] for p in (self.route_from, self.route_to)]
        for lg in it["legs"]:
            for la, lo in lm.leg_points(lg) or [(lg["from"]["lat"], lg["from"]["lon"])]:
                lats.append(la)
                lons.append(lo)
        self.map.fit_bbox(min(lats), max(lats), min(lons), max(lons), max_zoom=17)

