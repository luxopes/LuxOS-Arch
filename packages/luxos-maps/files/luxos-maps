    def favorite_index(self, place):
        for i, f in enumerate(self.cfg["favorites"]):
            if lm.same_place(f, place):
                return i
        return None

    def toggle_favorite(self, place=None):
        place = place or self.place
        if not place:
            return
        idx = self.favorite_index(place)
        if idx is None:
            self.cfg["favorites"].append({k: place[k] for k in ("name", "lat", "lon", "address") if k in place})
        else:
            del self.cfg["favorites"][idx]
        lm.save_config(self.cfg)
        self.rebuild_favorites()
        self.update_place_buttons()

    def remove_favorite(self, idx):
        if 0 <= idx < len(self.cfg["favorites"]):
            del self.cfg["favorites"][idx]
            lm.save_config(self.cfg)
            self.rebuild_favorites()
            self.update_place_buttons()

    # ---- naseptavani: mistni zdroje a vyber ----
    def local_suggestions(self, query):
        items = [dict(f, source="favorite") for f in self.cfg["favorites"]]
        items += [dict(r, source="recent") for r in self.cfg["recent"]]
        stops = list(self.map.stops) + [p for p in self.map.results if lm.is_transit_place(p)]
        if self.dep_stop:
            stops.append(self.dep_stop)
        items += [dict(s, source="stop", kind="stop") for s in stops]
        items += [dict(p, source="result") for p in self.results]
        return lm.suggest_local(query, items, self.map.center())

    def me_suggestion(self):
        """Moje poloha jako prvni navrh v polich trasy (jen se souhlasem s polohou)."""
        if not self.cfg["location_consent"]:
            return None
        lat, lon = (self.map.me["lat"], self.map.me["lon"]) if self.map.me else self.map.center()
        return {"name": _("My Location"), "lat": lat, "lon": lon, "me": True}

    def remember(self, place):
        lm.add_recent(self.cfg, place)
        lm.save_config(self.cfg)

    def suggestion_picked(self, which, place):
        place = {k: v for k, v in place.items() if k not in ("source", "distance", "color")}
        if place.get("me"):
            if which != "search":
                self.set_endpoint_me(which)
            return
        self.remember(place)
        if which == "search":
            self._setting_entry = True
            self.search_entry.set_text(place["name"])
            self.search_entry.set_position(-1)
            self._setting_entry = False
            self.results = [place]
            self.map.results = [place]
            self.select_place(place, fit=True)
        else:
            self.rt_status.set_text("")
            self.set_endpoint(which, place)

    def clear_recent(self):
        self.cfg["recent"] = []
        lm.save_config(self.cfg)

    def on_suggest_toggle(self, b):
        if b.get_active() != self.cfg["suggest_online"]:
            self.cfg["suggest_online"] = b.get_active()
            lm.save_config(self.cfg)
            if not b.get_active():
                for sb in self.suggest.values():
                    sb.suggester.cancel()

