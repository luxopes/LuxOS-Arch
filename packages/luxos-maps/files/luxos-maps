    def show_departures(self, stop):
        """Tabule odjezdu: stop = {"name", "lat", "lon", "stop_id"?} (zastavka spojeni, misto nebo bod)."""
        if not stop:
            return
        cur = self.stack.get_visible_child_name()
        if cur != "departures":
            self.dep_prev = cur
        self.dep_stop = {k: stop[k] for k in ("name", "lat", "lon", "stop_id") if k in stop}
        self.dep_name.set_text(stop.get("name") or lm.format_coords(stop["lat"], stop["lon"]))
        self.side_btn.set_active(True)
        self.show_page("departures")
        if not self.map.route:
            self.map.marker = {"lat": stop["lat"], "lon": stop["lon"]}
            self.map.fly_to(stop["lat"], stop["lon"], max(self.map.zoom, 16))
        self.map.queue_draw()
        for row in self.dep_list.get_children():
            row.destroy()
        self.load_departures()
        if self.dep_timer is None:
            self.dep_timer = GLib.timeout_add_seconds(DEPARTURES_REFRESH, self._departures_tick)

    def _departures_tick(self):
        if self.stack.get_visible_child_name() != "departures" or not self.dep_stop:
            self.dep_timer = None
            return False
        self.load_departures()
        return True

    def departures_back(self):
        self.dep_gen += 1
        self.dep_stop = None
        prev = self.dep_prev if self.dep_prev in ("home", "results", "place", "directions") else "home"
        if prev == "place" and not self.place:
            prev = "home"
        if not self.map.route and not self.place:
            self.map.marker = None
            self.map.queue_draw()
        self.show_page(prev)

    def load_departures(self, force=False):
        stop = self.dep_stop
        if not stop:
            return
        self.dep_gen += 1
        gen = self.dep_gen
        arrivals = self.dep_kind["arrivals"].get_active()
        self.dep_title.set_text((_("Arrivals") if arrivals else _("Departures")).upper())
        self.dep_spinner.start()

        def work():
            try:
                res = lm.timetable(stop["lat"], stop["lon"], arrivals=arrivals, radius=300, limit=DEPARTURES_SHOWN,
                                   stop_id=stop.get("stop_id"), lang=LANG, cfg=self.cfg,
                                   max_age=15 if force else None)
                err = None
            except lm.BusyError:
                res, err = None, "busy"
            except lm.MapsError as e:
                res, err = None, str(e)
            GLib.idle_add(self.departures_done, gen, res, err, arrivals)
        threading.Thread(target=work, daemon=True).start()

    def departures_done(self, gen, res, err, arrivals):
        if gen != self.dep_gen:
            return False
        self.dep_spinner.stop()
        if err:
            # stara tabule zustava, jen upozorneni
            self.dep_status.set_text(_("The public transport service is busy. Try again in a moment.") if err == "busy"
                                     else _("Departures could not be loaded. Check your internet connection."))
            self.dep_status.set_visible(True)
            return False
        for row in self.dep_list.get_children():
            row.destroy()
        rows = res["stop_times"]
        self.dep_status.set_text("" if rows else (_("No arrivals found.") if arrivals else _("No departures found.")))
        self.dep_status.set_visible(not rows)
        many = len(res["stops"]) > 1
        for st in rows:
            self.dep_list.add(self.departure_row(st, many, arrivals))
        self.dep_rows = rows
        self.dep_updated.set_text(_("Updated %s") % time.strftime("%H:%M"))
        return False

    def departure_row(self, st, many, arrivals):
        row = Gtk.ListBoxRow()
        row.stop_time = st
        hb = Gtk.Box(spacing=10)
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        tl = label(st["time"] or "", "dep-time")
        tl.set_size_request(48, -1)
        tb.pack_start(tl, False, False, 0)
        if st["delay_min"] and st["scheduled_time"]:
            sl = label("", "dim small")
            sl.set_markup("<s>%s</s>" % GLib.markup_escape_text(st["scheduled_time"]))
            tb.pack_start(sl, False, False, 0)
        hb.pack_start(tb, False, False, 0)
        hb.pack_start(LineBadge(st["line"], st["color"], st["text_color"], min_width=38), False, False, 0)
        vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        dest = st["origin"] if arrivals else st["headsign"]
        head = label("", "row-name", ellipsize=3)
        text = GLib.markup_escape_text((_("from %s") % dest if arrivals else dest) if dest else _(st["mode_name"]))
        head.set_markup("<s>%s</s>" % text if st["cancelled"] else text)
        vb.pack_start(head, False, False, 0)
        sub = []
        if st["platform"]:
            p = _("Platform %s") % st["platform"]
            if st.get("scheduled_platform"):
                p += " " + _("(changed from %s)") % st["scheduled_platform"]
            sub.append(p)
        if many and st["stop"]:
            sub.append(st["stop"])
        if sub:
            vb.pack_start(label(" · ".join(sub), "dim small", ellipsize=3), False, False, 0)
