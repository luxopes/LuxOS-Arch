#!/usr/bin/env python3
"""LuxOS - Trezor: sifrovana slozka /safe/<uzivatel> odemykana vlastnim heslem.

Data lezi zasifrovana (gocryptfs: AES-256-GCM, scrypt) v /safe/.vaults/<uzivatel>.
Po odemceni je obsah videt v /safe/<uzivatel> jen pro vlastnika (FUSE bez
allow_other: ani root do pripojeneho obsahu nevstoupi beznymi prostredky).
Zamceny Trezor je zastupna slozka jen pro cteni (tmpfs se spoustecem "Odemknout Trezor",
pripojuje luxos-safe-helper pod rootem): nic se do ni neulozi a podkladovy adresar na disku
je root:root 0000 a nemenny, takze nesifrovana data na disk nedopadnou.
Zamyka se rucne, po necinnosti, pri zamceni obrazovky, uspani a odhlaseni. Otevrene soubory
zamceni brani (zadne line odpojeni); okno i upozorneni rekne, ktere aplikace je drzi.

  luxos-safe               okno Trezoru
  luxos-safe unlock        dialog s heslem (--open pak otevre slozku)
  luxos-safe lock          zamknout (--force: chvili zkouset znovu, pri neuspechu upozorneni;
                           --logout: pri odhlaseni ukoncit aplikace s otevrenymi soubory)
  luxos-safe status        locked | unlocked | none
  luxos-safe --watch       hlidac (spousti relace): zamkne pri zamceni obrazovky a uspani
  luxos-safe --trust-launcher  oznaci spoustec "Odemknout Trezor" v zamcene slozce za duveryhodny (luxos-hub)
"""
import datetime
import getpass
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, "/usr/lib/luxos/python")
try:
    from luxos_i18n import _
except ImportError:
    def _(text):
        return text

USER = getpass.getuser()
VAULT = f"/safe/.vaults/{USER}"
MOUNT = f"/safe/{USER}"
HELPER = "/usr/lib/luxos/luxos-safe-helper"
RECOVERED = f"/safe/.recovered/{USER}"      # nesifrovane soubory ze stare slozky (helper)
HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxos/safe.json")
LAUNCHER = "Unlock Safe.desktop"
PLACEHOLDER = "luxos-safe-locked"           # zdroj zastupneho tmpfs (luxos-safe-helper)
WRONG_PASSWORD = 12      # navratovy kod gocryptfs pro spatne heslo
MOUNTINFO = "/proc/self/mountinfo"
LOCK_RETRY = 4           # pokusy o zamceni (po 0,5 s) pri automatickem zamykani
recovered_now = []       # slozky v domovske slozce presunute pri poslednim odemceni


# ---- stav a nastaveni -------------------------------------------------------------
def _unescape(s):
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 3 < len(s) and s[i + 1:i + 4].isdigit():
            out.append(chr(int(s[i + 1:i + 4], 8)))
            i += 4
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


def mounts():
    """Pripojeni na MOUNT v poradi (posledni je navrchu): [(fstype, source)]."""
    res = []
    try:
        with open(MOUNTINFO) as f:
            for line in f:
                left, _sep, right = line.partition(" - ")
                fields, rfields = left.split(), right.split()
                if len(fields) >= 5 and len(rfields) >= 2 and _unescape(fields[4]) == MOUNT:
                    res.append((rfields[0], _unescape(rfields[1])))
    except OSError:
        pass
    return res


def is_unlocked(ms=None):
    ms = mounts() if ms is None else ms
    return bool(ms) and ms[-1][0] == "fuse.gocryptfs"


def protected(ms=None):
    """Zamcena slozka je zastupny tmpfs jen pro cteni (ne zapisovatelny adresar na disku)."""
    ms = mounts() if ms is None else ms
    return ("tmpfs", PLACEHOLDER) in ms


def state():
    if is_unlocked():
        return "unlocked"
    if os.path.exists(os.path.join(VAULT, "gocryptfs.conf")):
        return "locked"
    return "none"


def settings():
    data = {"idle_minutes": 15, "lock_on_screen_lock": True}
    try:
        with open(CONF) as f:
            data.update(json.load(f))
    except (OSError, ValueError):
        pass
    return data


def save_settings(data):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(data, f, indent=1)


def run_pw(args, password_lines):
    """gocryptfs s heslem na stdin (nikdy v argumentech ani prostredi)."""
    # Chyby do docasneho souboru, ne do roury: proces gocryptfs by ji drzel otevrenou
    # a subprocess by cekal az do timeoutu
    with tempfile.TemporaryFile("w+") as err:
        try:
            r = subprocess.run(args, input="".join(p + "\n" for p in password_lines), text=True,
                               stdout=subprocess.DEVNULL, stderr=err, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            return -1, str(e)
        err.seek(0)
        return r.returncode, err.read().strip()[-300:]


# ---- operace ------------------------------------------------------------------------
def notify(title, body, urgency="normal"):
    try:
        subprocess.Popen(["notify-send", "-a", _("Safe"), "-i", "luxos-safe", "-u", urgency, title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def run_helper(cmd):
    """pkexec luxos-safe-helper create|protect; vraci None nebo chybu."""
    try:
        r = subprocess.run(["pkexec", HELPER, cmd], capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    return None if r.returncode == 0 else (r.stderr.strip()[-300:] or f"exit {r.returncode}")


def trust_launcher():
    """Spoustec "Odemknout Trezor" v zamcene slozce: Thunar spousti jen duveryhodne spoustece
    (kontrolni soucet v metadatech gvfs; soubor patri uzivateli, ale je nemenny)."""
    path = os.path.join(MOUNT, LAUNCHER)
    try:
        with open(path, "rb") as f:
            digest = hashlib.sha256(f.read()).hexdigest()
        subprocess.run(["gio", "set", "-t", "string", path, "metadata::xfce-exe-checksum", digest],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


def create(password):
    if not os.path.isdir(VAULT) or not protected():
        if run_helper("create") or not protected():
            return _("Could not create the Safe folder.")
    if os.listdir(VAULT):
        return _("The Safe already exists.")
    rc, err = run_pw(["gocryptfs", "-init", "-q", "-passfile", "/dev/stdin", VAULT], [password])
    if rc != 0:
        return _("Could not create the Safe (%s).") % err
    add_bookmark()
    return unlock(password)


def add_bookmark():
    """Zalozka Trezor v postrannim panelu Souboru."""
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "gtk-3.0/bookmarks")
    line = f"file://{MOUNT} {_('Safe')}\n"
    try:
        with open(path) as f:
            if any(l.startswith(f"file://{MOUNT} ") for l in f):
                return
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        f.write(line)


def unlock(password):
    del recovered_now[:]
    if state() == "unlocked":
        return None
    if not protected():
        # Starsi instalace: zapisovatelna slozka na disku -> nejdriv ochrana (a presun
        # nesifrovanych souboru). Bez ochrany neodemykat: po zamceni by se dalo zase psat na disk.
        err = run_helper("protect")
        if err or not protected():
            return _("Could not protect the locked Safe folder (%s).") % (err or "placeholder")
    trust_launcher()
    idle = int(settings().get("idle_minutes") or 0)
    args = ["gocryptfs", "-q", "-passfile", "/dev/stdin", "-nosyslog"]
    if idle:
        args += ["-i", f"{idle}m"]       # automaticke zamceni po necinnosti (jen bez otevrenych souboru)
    # -nonempty: zastupna slozka obsahuje spoustec "Odemknout Trezor" (po odemceni skryty)
    rc, err = run_pw(args + ["-nonempty", VAULT, MOUNT], [password])
    if rc == WRONG_PASSWORD:
        return _("Wrong password.")
    if rc != 0:
        return _("Could not unlock the Safe (%s).") % err
    recovered_now.extend(recover_plaintext())
    return None


# ---- nesifrovane soubory ze starsi verze ---------------------------------------------------
def recover_plaintext():
    """Soubory, ktere se ve starsich verzich ulozily do zamcene slozky (nesifrovane), presunul
    helper do /safe/.recovered/<user>/<cas>. Ted je presunout do ~/Safe-unencrypted-recovered-<datum>
    (0700) a dat vedet. Nic se nemaze, jen presouva."""
    moved = []
    try:
        stamps = sorted(os.listdir(RECOVERED))
    except OSError:
        return moved
    for stamp in stamps:
        src = os.path.join(RECOVERED, stamp)
        if os.path.islink(src) or not os.path.isdir(src):
            continue
        entries = sorted(os.listdir(src))
        if not entries:
            try:
                os.rmdir(src)
            except OSError:
                pass
            continue
        base = os.path.join(HOME, "Safe-unencrypted-recovered-" + datetime.date.today().isoformat())
        dest, n = base, 1
        while os.path.lexists(dest):
            n += 1
            dest = f"{base}-{n}"
        os.mkdir(dest, 0o700)
        os.chmod(dest, 0o700)
        failed = False
        for e in entries:
            try:
                shutil.move(os.path.join(src, e), os.path.join(dest, e))
            except OSError:
                failed = True
        if not failed:
            try:
                os.rmdir(src)
            except OSError:
                pass
        moved.append(dest)
    if moved:
        notify(_("Unencrypted files found"),
               _("Files saved in %s while the Safe was locked were not encrypted. They were moved to %s.")
               % (MOUNT, ", ".join(moved)), "critical")
    return moved


def import_recovered(path):
    """Presunout zachranene soubory do odemceneho Trezoru (zasifrovat), nesifrovanou kopii smazat."""
    if not is_unlocked():
        return _("The Safe is locked")
    target = os.path.join(MOUNT, os.path.basename(path))
    n = 1
    while os.path.lexists(target):
        n += 1
        target = os.path.join(MOUNT, f"{os.path.basename(path)}-{n}")
    try:
        os.mkdir(target, 0o700)
        for e in sorted(os.listdir(path)):
            # Jiny souborovy system: shutil.move zkopiruje a az potom smaze original
            shutil.move(os.path.join(path, e), os.path.join(target, e))
        os.rmdir(path)
    except OSError as e:
        return _("Could not import the files (%s).") % e
    return None


# ---- zamykani ------------------------------------------------------------------------
def _unmount(lazy=False):
    r = subprocess.run(["fusermount3", "-uz" if lazy else "-u", MOUNT], capture_output=True, text=True)
    return r.returncode == 0 or not is_unlocked()


def _gocryptfs_pids():
    """Procesy gocryptfs obsluhujici prave tento Trezor."""
    pids = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        if argv and os.path.basename(argv[0]) == b"gocryptfs" and MOUNT.encode() in argv \
                and VAULT.encode() in argv:
            pids.append(int(pid))
    return pids


def holders():
    """Procesy s otevrenymi soubory (nebo pracovnim adresarem) v Trezoru: [(pid, nazev)]."""
    skip = {os.getpid(), *_gocryptfs_pids()}
    pids = set()
    try:
        r = subprocess.run(["fuser", "-m", MOUNT], capture_output=True, text=True, timeout=10)
        pids = {int(t) for t in "".join(c if c.isdigit() else " " for c in r.stdout).split()}
    except (OSError, subprocess.TimeoutExpired):
        # Bez psmisc: projit /proc primo (jen vlastni procesy, jine do Trezoru stejne nemohou)
        prefix = MOUNT.rstrip("/") + "/"
        for pid in filter(str.isdigit, os.listdir("/proc")):
            links = []
            for sub in ("cwd", "root"):
                links.append(f"/proc/{pid}/{sub}")
            try:
                links += [f"/proc/{pid}/fd/{fd}" for fd in os.listdir(f"/proc/{pid}/fd")]
            except OSError:
                continue
            for link in links:
                try:
                    t = os.readlink(link)
                except OSError:
                    continue
                if t == MOUNT or t.startswith(prefix):
                    pids.add(int(pid))
                    break
    res = []
    for pid in sorted(pids - skip):
        try:
            with open(f"/proc/{pid}/comm") as f:
                res.append((pid, f.read().strip()))
        except OSError:
            res.append((pid, str(pid)))
    return res


def busy_message(procs):
    names = sorted({n for _p, n in procs})
    if not names:
        return _("Some files in the Safe are still open. Close them and try again.")
    return _("These apps keep files in the Safe open: %s. Close them and try again.") % ", ".join(names)


def lock(mode="manual"):
    """manual: jeden pokus, pri otevrenych souborech chyba s nazvy aplikaci.
    auto (zamceni obrazovky, uspani): chvili zkouset znovu, pak upozorneni - Trezor zustane odemceny.
    logout: aplikace s otevrenymi soubory ukoncit (SIGTERM), nakonec ukoncit gocryptfs.
    Line odpojeni (umount -l) se zivym gocryptfs nikdy: otevrene soubory by dal sly cist a zapisovat."""
    if not is_unlocked():
        return None
    if _unmount():
        trust_launcher()
        return None
    if mode in ("auto", "logout"):
        for _i in range(LOCK_RETRY):
            time.sleep(0.5)
            if _unmount():
                return None
    procs = holders()
    if mode == "logout":
        for pid, _n in procs:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        for _i in range(6):
            time.sleep(0.5)
            if _unmount():
                return None
        # Posledni moznost: bez gocryptfs (a klice v jeho pameti) uz obsah nikdo neprecte;
        # odpojit pak lze i "line" - mrtve pripojeni uz nic neobslouzi.
        for pid in _gocryptfs_pids():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        time.sleep(0.5)
        if _unmount() or _unmount(lazy=True):
            return None
    msg = busy_message(procs)
    if mode == "auto":
        notify(_("The Safe could not be locked"), msg, "critical")
    return msg


def change_password(old, new):
    rc, err = run_pw(["gocryptfs", "-passwd", "-q", VAULT], [old, new])
    if rc == WRONG_PASSWORD:
        return _("Wrong password.")
    return None if rc == 0 else _("Could not change the password (%s).") % err


def open_folder():
    subprocess.Popen(["xdg-open", MOUNT], start_new_session=True)


# ---- hlidac relace ----------------------------------------------------------------------
def take_sleep_inhibitor(system):
    """Zpozdeni uspani (logind "delay"), dokud se Trezor nezamkne. Vraci fd nebo None."""
    from gi.repository import Gio, GLib
    try:
        res, fds = system.call_with_unix_fd_list_sync(
            "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "Inhibit",
            GLib.Variant("(ssss)", ("sleep", _("Safe"), "Lock the Safe before sleep", "delay")),
            GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None)
        return fds.get(res.unpack()[0])
    except Exception:  # noqa: BLE001 - bez logind se jen nezpozdi uspani
        return None


def subscribe():
    """Zamykani pri zamceni obrazovky a pred uspanim (pouziva i luxos-hub). Zamyka se ve vlakne,
    aby cekani na zavreni souboru neblokovalo hlavni smycku."""
    from gi.repository import Gio

    inhibitor = {"fd": None}

    def in_thread(fn):
        threading.Thread(target=fn, daemon=True).start()

    def on_lock(*_a):
        if settings().get("lock_on_screen_lock", True):
            in_thread(lambda: lock("auto"))

    def on_saver(_c, _s, _p, _i, _sig, params):
        if params.unpack()[0]:
            on_lock()

    def release():
        fd, inhibitor["fd"] = inhibitor["fd"], None
        if fd is not None:
            os.close(fd)

    def on_sleep(_c, _s, _p, _i, _sig, params):
        if params.unpack()[0]:
            def go():
                try:
                    lock("auto")      # pred uspanim vzdy
                finally:
                    release()         # uspani pokracuje
            in_thread(go)
        else:
            release()
            inhibitor["fd"] = take_sleep_inhibitor(system)

    session = Gio.bus_get_sync(Gio.BusType.SESSION)
    session.signal_subscribe(None, "org.xfce.ScreenSaver", "ActiveChanged", None, None, 0, on_saver)
    system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    system.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                            "/org/freedesktop/login1", None, 0, on_sleep)
    inhibitor["fd"] = take_sleep_inhibitor(system)
    if state() == "locked":
        in_thread(trust_launcher)


def watch():
    from gi.repository import GLib

    subscribe()
    loop = GLib.MainLoop()

    def on_term():
        lock("logout")              # konec relace / odhlaseni
        loop.quit()
        return False
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, on_term)
    loop.run()


# ---- GUI ----------------------------------------------------------------------------
def gui(mode):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    css = Gtk.CssProvider()
    css.load_from_data(b"""
        .safe-title { font-size: 20px; font-weight: 800; }
        .dim { opacity: 0.65; }
        .error { color: #ff453a; }
        .primary { border-radius: 999px; padding: 6px 20px; font-weight: 700; background-image: none;
                   background-color: #3d7bff; color: white; border: none; box-shadow: none; }
        entry { border-radius: 10px; padding: 6px 10px; min-height: 30px; }
        .group { border-radius: 12px; border: 1px solid alpha(currentColor, 0.12); padding: 4px 14px;
                 background-color: alpha(currentColor, 0.04); }
    """)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    GLib.set_prgname("luxos-safe")
    GLib.set_application_name(_("Safe"))

    win = Gtk.Window(title=_("Safe"))
    win.set_icon_name("luxos-safe")
    win.set_resizable(False)
    win.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=_("Safe")))
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=28, margin_top=10)
    box.set_size_request(380, -1)
    win.add(box)
    result = {"ok": False}

    def clear():
        for c in box.get_children():
            box.remove(c)

    def header(title, text):
        box.pack_start(Gtk.Image.new_from_icon_name("luxos-safe", Gtk.IconSize.DIALOG), False, False, 4)
        t = Gtk.Label(label=title)
        t.get_style_context().add_class("safe-title")
        box.pack_start(t, False, False, 0)
        d = Gtk.Label(label=text, wrap=True, max_width_chars=44, justify=Gtk.Justification.CENTER)
        d.get_style_context().add_class("dim")
        box.pack_start(d, False, False, 0)

    def entry(placeholder):
        e = Gtk.Entry(visibility=False, placeholder_text=placeholder, input_purpose=Gtk.InputPurpose.PASSWORD)
        box.pack_start(e, False, False, 0)
        return e

    def error_label():
        lab = Gtk.Label(wrap=True, max_width_chars=44)
        lab.get_style_context().add_class("error")
        box.pack_start(lab, False, False, 0)
        return lab

    def button(label, cb, primary=True):
        b = Gtk.Button(label=label)
        if primary:
            b.get_style_context().add_class("primary")
        b.connect("clicked", lambda _b: cb())
        box.pack_start(b, False, False, 0)
        return b

    def show():
        clear()
        st = state()
        if st == "none":
            page_create()
        elif st == "locked":
            page_unlock()
        else:
            page_unlocked()
        box.show_all()

    def page_create():
        header(_("Create your Safe"),
               _("Files in the Safe are encrypted and open only with its own password - "
                 "not even an administrator can read them while the Safe is locked."))
        p1 = entry(_("New Safe password"))
        p2 = entry(_("Password again"))
        err = error_label()

        def go():
            a, b = p1.get_text(), p2.get_text()
            if len(a) < 8:
                err.set_text(_("Use at least 8 characters."))
            elif a != b:
                err.set_text(_("Passwords do not match."))
            else:
                msg = create(a)
                if msg:
                    err.set_text(msg)
                else:
                    offer_import()
                    open_folder()
                    show()
        p2.connect("activate", lambda _e: go())
        button(_("Create Safe"), go)
        warn = Gtk.Label(label=_("If you forget this password, the files cannot be recovered."),
                         wrap=True, max_width_chars=44)
        warn.get_style_context().add_class("dim")
        box.pack_start(warn, False, False, 0)

    def page_unlock():
        header(_("The Safe is locked"), _("Enter the Safe password to open %s.") % MOUNT)
        pw = entry(_("Password"))
        err = error_label()

        def go():
            msg = unlock(pw.get_text())
            pw.set_text("")
            if msg:
                err.set_text(msg)
                return
            result["ok"] = True
            offer_import()
            if mode in ("unlock", "open"):
                if mode == "open":
                    open_folder()
                win.destroy()
            else:
                open_folder()
                show()
        pw.connect("activate", lambda _e: go())
        button(_("Unlock"), go)
        GLib.idle_add(pw.grab_focus)

    def page_unlocked():
        header(_("The Safe is unlocked"), _("Your files are available in %s.") % MOUNT)
        button(_("Open Safe"), open_folder, primary=False)
        err = error_label()

        def do_lock():
            msg = lock()
            if msg:
                err.set_text(msg)
            else:
                show()
        button(_("Lock Now"), do_lock)

        conf = settings()
        group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        group.get_style_context().add_class("group")
        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label=_("Lock automatically after inactivity"), xalign=0), True, True, 0)
        combo = Gtk.ComboBoxText()
        for m, lab in ((5, _("5 minutes")), (15, _("15 minutes")), (60, _("1 hour")), (0, _("Never"))):
            combo.append(str(m), lab)
        combo.set_active_id(str(conf.get("idle_minutes", 15)))
        combo.connect("changed", lambda c: save_settings({**settings(), "idle_minutes": int(c.get_active_id())}))
        row.pack_end(combo, False, False, 0)
        group.pack_start(row, False, False, 4)
        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label=_("Lock when the screen locks"), xalign=0), True, True, 0)
        sw = Gtk.Switch(active=conf.get("lock_on_screen_lock", True))
        sw.connect("notify::active", lambda s, _p: save_settings({**settings(), "lock_on_screen_lock": s.get_active()}))
        row.pack_end(sw, False, False, 0)
        group.pack_start(row, False, False, 4)
        box.pack_start(group, False, False, 6)
        hint = Gtk.Label(label=_("The Safe always locks when the computer goes to sleep or you log out."),
                         wrap=True, max_width_chars=44)
        hint.get_style_context().add_class("dim")
        box.pack_start(hint, False, False, 0)

        chg = Gtk.Button(label=_("Change Password…"))
        chg.get_style_context().add_class("flat")
        chg.connect("clicked", lambda _b: change_dialog())
        box.pack_start(chg, False, False, 0)

    def offer_import():
        """Po odemceni: nesifrovane soubory ze stare zamcene slozky nabidnout k presunu do Trezoru."""
        for path in list(recovered_now):
            dlg = Gtk.MessageDialog(transient_for=win, modal=True, message_type=Gtk.MessageType.WARNING,
                                    text=_("Unencrypted files found"))
            dlg.format_secondary_text(
                (_("Files saved in %s while the Safe was locked were not encrypted. They were moved to %s.")
                 % (MOUNT, path)) + "\n\n" +
                _("Import them into the Safe? The unencrypted copies will then be deleted."))
            dlg.add_buttons(_("Keep in Home Folder"), Gtk.ResponseType.CANCEL,
                            _("Import into Safe"), Gtk.ResponseType.OK)
            dlg.set_default_response(Gtk.ResponseType.OK)
            answer = dlg.run()
            dlg.destroy()
            if answer == Gtk.ResponseType.OK:
                msg = import_recovered(path)
                notify(_("Safe"), msg or _("The files were imported into the Safe."))
            recovered_now.remove(path)

    def change_dialog():
        dlg = Gtk.Dialog(title=_("Change Password"), transient_for=win, modal=True)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("Change"), Gtk.ResponseType.OK)
        area = dlg.get_content_area()
        area.set_spacing(8)
        area.set_border_width(14)
        old = Gtk.Entry(visibility=False, placeholder_text=_("Current password"))
        new = Gtk.Entry(visibility=False, placeholder_text=_("New Safe password"))
        new2 = Gtk.Entry(visibility=False, placeholder_text=_("Password again"))
        err = Gtk.Label()
        err.get_style_context().add_class("error")
        for w in (old, new, new2, err):
            area.pack_start(w, False, False, 0)
        dlg.show_all()
        while dlg.run() == Gtk.ResponseType.OK:
            if len(new.get_text()) < 8:
                err.set_text(_("Use at least 8 characters."))
            elif new.get_text() != new2.get_text():
                err.set_text(_("Passwords do not match."))
            else:
                msg = change_password(old.get_text(), new.get_text())
                if not msg:
                    break
                err.set_text(msg)
        dlg.destroy()

    shown = {"state": None}

    def poll():
        # Zamceni zvenku (necinnost, zamceni obrazovky) - okno prepnout na aktualni stav
        st = state()
        if shown["state"] not in (None, st) and box.get_mapped():
            show()
        shown["state"] = st
        return True

    show()
    GLib.timeout_add_seconds(2, poll)
    win.show_all()
    Gtk.main()
    return 0 if (mode not in ("unlock", "open") or result["ok"]) else 1


USAGE = (
    ("luxos-safe", "Safe window"),
    ("luxos-safe unlock [--open]", "ask for the password (--open: then open the folder)"),
    ("luxos-safe lock [--force] [--logout]", "lock the Safe (--force: keep trying; --logout: close apps with open files)"),
    ("luxos-safe status", "print the state: locked, unlocked or none"),
    ("luxos-safe --watch", "lock when the screen locks or the computer sleeps (started by the session)"),
    ("luxos-safe --trust-launcher", "trust the Unlock Safe launcher in the locked folder (started by the session)"),
)


def usage(file=None):
    print("luxos-safe - " + _("encrypted folder /safe/<user> unlocked with its own password") + "\n", file=file)
    for cmd, desc in USAGE:
        print(f"  {cmd:38}{_(desc)}", file=file)


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"], ["help"]):
        usage()
        return 0
    if not args:
        return gui("main")
    cmd = args[0]
    if cmd == "status":
        print(state())
        return 0
    if cmd == "lock":
        msg = lock("logout" if "--logout" in args else "auto" if "--force" in args else "manual")
        if msg:
            print(msg, file=sys.stderr)
            return 1
        return 0
    if cmd == "unlock":
        if state() == "unlocked":
            if "--open" in args:
                open_folder()
            return 0
        if state() == "none":
            return gui("main")
        return gui("open" if "--open" in args else "unlock")
    if cmd == "--watch":
        watch()
        return 0
    if cmd == "--trust-launcher":
        trust_launcher()          # luxos-hub (LSL) po prihlaseni se zamcenym Trezorem
        return 0
    usage(sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
