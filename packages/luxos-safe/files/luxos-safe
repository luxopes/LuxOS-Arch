        def go():
            msg = unlock(pw.get_text())
            pw.set_text("")
            if msg:
                err.set_text(msg)
                return
            result["ok"] = True
            offer_import()
            if mode in ("unlock", "open"):
                if mode == "open":
                    open_folder()
                win.destroy()
            else:
                open_folder()
                show()
        pw.connect("activate", lambda _e: go())
        button(_("Unlock"), go)
        forgot = Gtk.Button(label=_("Forgot Password…"))
        forgot.get_style_context().add_class("flat")
        forgot.connect("clicked", lambda _b: reset_dialog())
