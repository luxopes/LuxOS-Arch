#!/usr/bin/env python3
"""LuxOS - Trezor: sifrovana slozka /safe/<uzivatel> odemykana vlastnim heslem.

Data lezi zasifrovana (gocryptfs: AES-256-GCM, scrypt) v /safe/.vaults/<uzivatel>.
Po odemceni je obsah videt v /safe/<uzivatel> jen pro vlastnika (FUSE bez
allow_other: ani root do pripojeneho obsahu nevstoupi beznymi prostredky).
Zamceny Trezor je zastupna slozka jen pro cteni (tmpfs se spoustecem "Odemknout Trezor",
pripojuje luxos-safe-helper pod rootem): nic se do ni neulozi a podkladovy adresar na disku
je root:root 0000 a nemenny, takze nesifrovana data na disk nedopadnou.
Zamyka se rucne, po necinnosti, pri zamceni obrazovky, uspani a odhlaseni. Otevrene soubory
zamceni brani (zadne line odpojeni); okno i upozorneni rekne, ktere aplikace je drzi.

  luxos-safe               okno Trezoru
  luxos-safe unlock        dialog s heslem (--open pak otevre slozku)
  luxos-safe lock          zamknout (--force: chvili zkouset znovu, pri neuspechu upozorneni;
                           --logout: pri odhlaseni ukoncit aplikace s otevrenymi soubory)
  luxos-safe status        locked | unlocked | none
  luxos-safe check         kontrola ochrany (scrypt, volby pripojeni, ptrace, core dumpy, swap)
  luxos-safe --watch       hlidac (spousti relace): zamkne pri zamceni obrazovky a uspani
  luxos-safe --trust-launcher  oznaci spoustec "Odemknout Trezor" v zamcene slozce za duveryhodny (luxos-hub)
"""
import datetime
import getpass
import hashlib
import json
import math
import os
import resource
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, "/usr/lib/luxos/python")
try:
    from luxos_i18n import _
except ImportError:
    def _(text):
        return text

USER = getpass.getuser()
VAULT = f"/safe/.vaults/{USER}"
MOUNT = f"/safe/{USER}"
HELPER = "/usr/lib/luxos/luxos-safe-helper"
RECOVERED = f"/safe/.recovered/{USER}"      # nesifrovane soubory ze stare slozky (helper)
HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "luxos/safe.json")
LAUNCHER = "Unlock Safe.desktop"
PLACEHOLDER = "luxos-safe-locked"           # zdroj zastupneho tmpfs (luxos-safe-helper)
CONF_FILE = os.path.join(VAULT, "gocryptfs.conf")
WRONG_PASSWORD = 12      # navratovy kod gocryptfs pro spatne heslo
XRAY_WRONG_PASSWORD = 8  # gocryptfs-xray -dumpmasterkey: spatne heslo
# scrypt logN pro nove Trezory, zmenu hesla a "Zesilit ochranu": 2^18 = 256 MiB pameti a ~0,7 s
# na odemceni (Ryzen 5 5500U; vychozi gocryptfs 16 = 0,18 s). Utocnik s ukradenym diskem plati
# za kazdy pokus stejne - 4x drazsi nez vychozi.
SCRYPT_LOGN = 18
MIN_PASSWORD = 12        # nova hesla (stara hesla dal odemykaji)
# Volby pripojeni: zadne setuid, zarizeni ani spustitelne soubory v Trezoru
MOUNT_OPTS = ["-nosuid", "-nodev", "-noexec"]
MOUNTINFO = "/proc/self/mountinfo"
LOCK_RETRY = 4           # pokusy o zamceni (po 0,5 s) pri automatickem zamykani
recovered_now = []       # slozky v domovske slozce presunute pri poslednim odemceni


# ---- stav a nastaveni -------------------------------------------------------------
def _unescape(s):
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 3 < len(s) and s[i + 1:i + 4].isdigit():
            out.append(chr(int(s[i + 1:i + 4], 8)))
            i += 4
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


def mounts():
    """Pripojeni na MOUNT v poradi (posledni je navrchu): [(fstype, source)]."""
    res = []
    try:
        with open(MOUNTINFO) as f:
            for line in f:
                left, _sep, right = line.partition(" - ")
                fields, rfields = left.split(), right.split()
                if len(fields) >= 5 and len(rfields) >= 2 and _unescape(fields[4]) == MOUNT:
                    res.append((rfields[0], _unescape(rfields[1])))
    except OSError:
        pass
    return res


def is_unlocked(ms=None):
    ms = mounts() if ms is None else ms
    return bool(ms) and ms[-1][0] == "fuse.gocryptfs"


def protected(ms=None):
    """Zamcena slozka je zastupny tmpfs jen pro cteni (ne zapisovatelny adresar na disku)."""
    ms = mounts() if ms is None else ms
    return ("tmpfs", PLACEHOLDER) in ms


def state():
    if is_unlocked():
        return "unlocked"
    if os.path.exists(os.path.join(VAULT, "gocryptfs.conf")):
        return "locked"
    return "none"


def settings():
    data = {"idle_minutes": 15, "lock_on_screen_lock": True}
    try:
        with open(CONF) as f:
            data.update(json.load(f))
    except (OSError, ValueError):
        pass
    return data


def save_settings(data):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(data, f, indent=1)


def no_core_dumps():
    """Pred spustenim gocryptfs: zadne core dumpy (pamet s klicem by skoncila na disku).
    Limit se dedi i na proces na pozadi; systemd-coredump nulovy limit respektuje."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))


def run_pw(args, password_lines):
    """gocryptfs s heslem na stdin (nikdy v argumentech ani prostredi)."""
    rc, err, _out = run_pw_out(args, password_lines, capture=False)
    return rc, err


def run_pw_out(args, password_lines, capture=True):
    """Jako run_pw, navic vraci standardni vystup (gocryptfs-xray -dumpmasterkey)."""
    # Chyby do docasneho souboru, ne do roury: proces gocryptfs by ji drzel otevrenou
    # a subprocess by cekal az do timeoutu
    with tempfile.TemporaryFile("w+") as err:
        try:
            r = subprocess.run(args, input="".join(p + "\n" for p in password_lines), text=True,
                               stdout=subprocess.PIPE if capture else subprocess.DEVNULL, stderr=err,
                               timeout=120, preexec_fn=no_core_dumps)
        except (OSError, subprocess.TimeoutExpired) as e:
            return -1, str(e), ""
        err.seek(0)
        return r.returncode, err.read().strip()[-300:], (r.stdout or "") if capture else ""


# ---- operace ------------------------------------------------------------------------
def notify(title, body, urgency="normal"):
    try:
        subprocess.Popen(["notify-send", "-a", _("Safe"), "-i", "luxos-safe", "-u", urgency, title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


CANCELLED = "cancelled"


def run_helper(cmd):
    """pkexec luxos-safe-helper create|protect; vraci None nebo chybu."""
    try:
        r = subprocess.run(["pkexec", HELPER, cmd], capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    if r.returncode == 126:     # pkexec: dialog hesla zavren / zrusen
        return CANCELLED
    return None if r.returncode == 0 else (r.stderr.strip()[-300:] or f"exit {r.returncode}")


def trust_launcher():
    """Spoustec "Odemknout Trezor" v zamcene slozce: Thunar spousti jen duveryhodne spoustece
    (kontrolni soucet v metadatech gvfs; soubor patri uzivateli, ale je nemenny)."""
    path = os.path.join(MOUNT, LAUNCHER)
    try:
        with open(path, "rb") as f:
            digest = hashlib.sha256(f.read()).hexdigest()
        subprocess.run(["gio", "set", "-t", "string", path, "metadata::xfce-exe-checksum", digest],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


def create(password):
    if not os.path.isdir(VAULT) or not protected():
        err = run_helper("create")
        if err == CANCELLED:
            return _("Authorization was cancelled. Nothing was changed.")
        if err or not protected():
            return _("Could not create the Safe folder.")
    if os.listdir(VAULT):
        return _("The Safe already exists.")
    rc, err = run_pw(["gocryptfs", "-init", "-q", "-scryptn", str(SCRYPT_LOGN), "-passfile", "/dev/stdin", VAULT],
                     [password])
    if rc != 0:
        return _("Could not create the Safe (%s).") % err
    add_bookmark()
    return unlock(password)


def add_bookmark():
    """Zalozka Trezor v postrannim panelu Souboru."""
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "gtk-3.0/bookmarks")
    line = f"file://{MOUNT} {_('Safe')}\n"
    try:
        with open(path) as f:
            if any(l.startswith(f"file://{MOUNT} ") for l in f):
                return
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        f.write(line)


def unlock(password):
    del recovered_now[:]
    if state() == "unlocked":
        return None
    if not protected():
        # Starsi instalace: zapisovatelna slozka na disku -> nejdriv ochrana (a presun
        # nesifrovanych souboru). Bez ochrany neodemykat: po zamceni by se dalo zase psat na disk.
        err = run_helper("protect")
        if err == CANCELLED:
            return _("Authorization was cancelled. Nothing was changed.")
        if err or not protected():
            return _("Could not protect the locked Safe folder (%s).") % (err or "placeholder")
    trust_launcher()
    idle = int(settings().get("idle_minutes") or 0)
    args = ["gocryptfs", "-q", "-passfile", "/dev/stdin", "-nosyslog"] + MOUNT_OPTS
    if idle:
        args += ["-i", f"{idle}m"]       # automaticke zamceni po necinnosti (jen bez otevrenych souboru)
    # -nonempty: zastupna slozka obsahuje spoustec "Odemknout Trezor" (po odemceni skryty)
    rc, err = run_pw(args + ["-nonempty", VAULT, MOUNT], [password])
    if rc == WRONG_PASSWORD:
        return _("Wrong password.")
    if rc != 0:
        return _("Could not unlock the Safe (%s).") % err
    recovered_now.extend(recover_plaintext())
    return None


# ---- nesifrovane soubory ze starsi verze ---------------------------------------------------
def recover_plaintext():
    """Soubory, ktere se ve starsich verzich ulozily do zamcene slozky (nesifrovane), presunul
    helper do /safe/.recovered/<user>/<cas>. Ted je presunout do ~/Safe-unencrypted-recovered-<datum>
    (0700) a dat vedet. Nic se nemaze, jen presouva."""
    moved = []
    try:
        stamps = sorted(os.listdir(RECOVERED))
    except OSError:
        return moved
    for stamp in stamps:
        src = os.path.join(RECOVERED, stamp)
        if os.path.islink(src) or not os.path.isdir(src):
            continue
        entries = sorted(os.listdir(src))
        if not entries:
            try:
                os.rmdir(src)
            except OSError:
                pass
            continue
        base = os.path.join(HOME, "Safe-unencrypted-recovered-" + datetime.date.today().isoformat())
        dest, n = base, 1
        while os.path.lexists(dest):
            n += 1
            dest = f"{base}-{n}"
        os.mkdir(dest, 0o700)
        os.chmod(dest, 0o700)
        failed = False
        for e in entries:
            try:
                shutil.move(os.path.join(src, e), os.path.join(dest, e))
            except OSError:
                failed = True
        if not failed:
            try:
                os.rmdir(src)
            except OSError:
                pass
        moved.append(dest)
    if moved:
        notify(_("Unencrypted files found"),
               _("Files saved in %s while the Safe was locked were not encrypted. They were moved to %s.")
               % (MOUNT, ", ".join(moved)), "critical")
    return moved


def import_recovered(path):
    """Presunout zachranene soubory do odemceneho Trezoru (zasifrovat), nesifrovanou kopii smazat."""
    if not is_unlocked():
        return _("The Safe is locked")
    target = os.path.join(MOUNT, os.path.basename(path))
    n = 1
    while os.path.lexists(target):
        n += 1
        target = os.path.join(MOUNT, f"{os.path.basename(path)}-{n}")
    try:
        os.mkdir(target, 0o700)
        for e in sorted(os.listdir(path)):
            # Jiny souborovy system: shutil.move zkopiruje a az potom smaze original
            shutil.move(os.path.join(path, e), os.path.join(target, e))
        os.rmdir(path)
    except OSError as e:
        return _("Could not import the files (%s).") % e
    return None


# ---- zamykani ------------------------------------------------------------------------
def _unmount(lazy=False):
    r = subprocess.run(["fusermount3", "-uz" if lazy else "-u", MOUNT], capture_output=True, text=True)
    return r.returncode == 0 or not is_unlocked()


def _gocryptfs_pids():
    """Procesy gocryptfs obsluhujici prave tento Trezor."""
    pids = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        if argv and os.path.basename(argv[0]) == b"gocryptfs" and MOUNT.encode() in argv \
                and VAULT.encode() in argv:
            pids.append(int(pid))
    return pids


def holders():
    """Procesy s otevrenymi soubory (nebo pracovnim adresarem) v Trezoru: [(pid, nazev)]."""
    skip = {os.getpid(), *_gocryptfs_pids()}
    pids = set()
    try:
        r = subprocess.run(["fuser", "-m", MOUNT], capture_output=True, text=True, timeout=10)
        pids = {int(t) for t in "".join(c if c.isdigit() else " " for c in r.stdout).split()}
    except (OSError, subprocess.TimeoutExpired):
        # Bez psmisc: projit /proc primo (jen vlastni procesy, jine do Trezoru stejne nemohou)
        prefix = MOUNT.rstrip("/") + "/"
        for pid in filter(str.isdigit, os.listdir("/proc")):
            links = []
            for sub in ("cwd", "root"):
                links.append(f"/proc/{pid}/{sub}")
            try:
                links += [f"/proc/{pid}/fd/{fd}" for fd in os.listdir(f"/proc/{pid}/fd")]
            except OSError:
                continue
            for link in links:
                try:
                    t = os.readlink(link)
                except OSError:
                    continue
                if t == MOUNT or t.startswith(prefix):
                    pids.add(int(pid))
                    break
    res = []
    for pid in sorted(pids - skip):
        try:
            with open(f"/proc/{pid}/comm") as f:
                res.append((pid, f.read().strip()))
        except OSError:
            res.append((pid, str(pid)))
    return res


def gnupg_homes(root=None, depth=2):
    """Slozky GnuPG v Trezoru (napr. /safe/<user>/gnupg, /safe/<user>/luxos-signing)."""
    root = root or MOUNT
    res = []
    try:
        entries = sorted(os.scandir(root), key=lambda e: e.name)
    except OSError:
        return res
    names = {e.name for e in entries}
    if "private-keys-v1.d" in names or "pubring.kbx" in names or "secring.gpg" in names:
        res.append(root)
    if depth > 0:
        for e in entries:
            if e.is_dir(follow_symlinks=False) and not e.name.startswith(".") and e.name != "private-keys-v1.d":
                res += gnupg_homes(e.path, depth - 1)
    return res


def stop_gpg_agents():
    """Pred zamcenim ukoncit gpg-agent slozek GnuPG v Trezoru: v pameti drzi odemcene soukrome
    klice (cache hesla) i po zamceni. Agent bez spusteni nic nedela."""
    for home in gnupg_homes():
        try:
            subprocess.run(["gpgconf", "--homedir", home, "--kill", "gpg-agent"], capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass


def busy_message(procs):
    names = sorted({n for _p, n in procs})
    if not names:
        return _("Some files in the Safe are still open. Close them and try again.")
    return _("These apps keep files in the Safe open: %s. Close them and try again.") % ", ".join(names)


def lock(mode="manual"):
    """manual: jeden pokus, pri otevrenych souborech chyba s nazvy aplikaci.
    auto (zamceni obrazovky, uspani): chvili zkouset znovu, pak upozorneni - Trezor zustane odemceny.
    logout: aplikace s otevrenymi soubory ukoncit (SIGTERM), nakonec ukoncit gocryptfs.
    Line odpojeni (umount -l) se zivym gocryptfs nikdy: otevrene soubory by dal sly cist a zapisovat."""
    if not is_unlocked():
        return None
    stop_gpg_agents()
    if _unmount():
        trust_launcher()
        return None
    if mode in ("auto", "logout"):
        for _i in range(LOCK_RETRY):
            time.sleep(0.5)
            if _unmount():
                return None
    procs = holders()
    if mode == "logout":
        for pid, _n in procs:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        for _i in range(6):
            time.sleep(0.5)
            if _unmount():
                return None
        # Posledni moznost: bez gocryptfs (a klice v jeho pameti) uz obsah nikdo neprecte;
        # odpojit pak lze i "line" - mrtve pripojeni uz nic neobslouzi.
        for pid in _gocryptfs_pids():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        time.sleep(0.5)
        if _unmount() or _unmount(lazy=True):
            return None
    msg = busy_message(procs)
    if mode == "auto":
        notify(_("The Safe could not be locked"), msg, "critical")
    return msg


def vault_logn(conf=None):
    """scrypt logN Trezoru z gocryptfs.conf (None = neznamy, napr. FIDO2)."""
    try:
        with open(conf or CONF_FILE) as f:
            n = int(json.load(f)["ScryptObject"]["N"])
        return n.bit_length() - 1 if n > 0 else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def target_logn():
    """Nikdy nesnizovat: rucne silnejsi Trezor zustane silnejsi."""
    return max(vault_logn() or 0, SCRYPT_LOGN)


def can_upgrade():
    n = vault_logn()
    return n is not None and n < SCRYPT_LOGN


def change_password(old, new):
    # Pri zmene hesla zaroven silnejsi scrypt (transparentni, stare heslo prestane platit)
    rc, err = run_pw(["gocryptfs", "-passwd", "-q", "-scryptn", str(target_logn()), VAULT], [old, new])
    if rc == WRONG_PASSWORD:
        return _("Wrong password.")
    return None if rc == 0 else _("Could not change the password (%s).") % err


def upgrade_protection(password):
    """Stejne heslo, novy obal klice se silnejsim scrypt (gocryptfs -passwd -scryptn)."""
    return change_password(password, password)


# ---- heslo: pravidla a sila -----------------------------------------------------------
# Mala vestavena ukazka nejcastejsich hesel a slov, ze kterych se hesla skladaji (ne slovnik):
# heslo, ktere je po odebrani cislic a znaku jen takove slovo (i opakovane), se odmita.
COMMON_WORDS = frozenset("""
password passwort passwd pass heslo haslo jelszo parola contrasena contrasenya motdepasse wachtwoord
losenord senha salasana parool geslo lozinka parolja qwerty qwertz azerty asdf asdfgh asdfghjkl zxcvbn
qwertyuiop letmein welcome admin administrator root login user guest test default changeme secret
tajne tajny iloveyou loveyou love monkey dragon master sunshine princess football baseball soccer
superman batman starwars pokemon shadow michael jordan hello freedom whatever trustno trustnoone
trezor safe vault luxos linux ubuntu windows apple google facebook abc abcd abcdef abcdefgh
miluji milujute laska kocka pejsek ahoj nazdar heslicko praha brno sparta slavia
""".split())
SEQUENCES = ("abcdefghijklmnopqrstuvwxyz", "qwertyuiopasdfghjklzxcvbnm", "qwertzuiopasdfghjklyxcvbnm",
             "azertyuiopqsdfghjklmwxcvbn", "1234567890", "0987654321", "zyxwvutsrqponmlkjihgfedcba",
             "mnbvcxzlkjhgfdsapoiuytrewq")
LEET = str.maketrans("@4310$5!7|", "aaeiosssil")


def _core_words(pw):
    """Pismena hesla bez cislic a znaku, mala: bez prevodu a s prevedenym "leet" uvnitr slova
    (p@ssw0rd2024! -> password; cislice a znaky na okrajich se jen odriznou)."""
    low = pw.lower()
    start, end = 0, len(low)
    while start < end and not low[start].isalpha():
        start += 1
    while end > start and not low[end - 1].isalpha():
        end -= 1
    plain = "".join(c for c in low if c.isalpha())
    leet = "".join(c for c in low[start:end].translate(LEET) if c.isalpha())
    return {plain, leet}


def _is_repeat_of_common(word):
    if not word:
        return False
    if word in COMMON_WORDS:
        return True
    for n in range(2, len(word) // 2 + 1):
        if len(word) % n == 0 and word[:n] * (len(word) // n) == word and word[:n] in COMMON_WORDS:
            return True
    return False


def _is_predictable(pw):
    low = pw.lower()
    if len(set(low)) < 5:
        return True
    # Vetsina sousednich znaku jde po sobe (1234..., abcd..., aaaa...)
    steps = sum(1 for a, b in zip(low, low[1:]) if abs(ord(a) - ord(b)) <= 1)
    if steps >= 0.75 * (len(low) - 1):
        return True
    # Rada klavesnice nebo abecedy (i dokola)
    return any(low in seq * 3 for seq in SEQUENCES)


def password_problem(pw, user=None):
    """Proc nove heslo nestaci (text pro uzivatele), nebo None. Zadne blokovani pokusu:
    hrubou silu brzdi scrypt (kazdy pokus ~0,7 s a 256 MiB) a delka hesla."""
    if len(pw) < MIN_PASSWORD:
        return _("Use at least 12 characters.")
    if _is_predictable(pw):
        return _("This password is too predictable. Avoid repeated characters and sequences like 1234 or abcd.")
    user = (USER if user is None else user).lower()
    if any(_is_repeat_of_common(w) or (len(user) >= 3 and w in (user, user * 2)) for w in _core_words(pw)):
        return _("This password is too common. Choose something less predictable, for example a few unrelated words.")
    return None


def password_strength(pw, user=None):
    """0 = nelze pouzit, 1 slabe, 2 prijatelne, 3 dobre, 4 silne (odhad entropie)."""
    if not pw or password_problem(pw, user):
        return 0
    pool = 0
    if any(c.islower() for c in pw):
        pool += 26
    if any(c.isupper() for c in pw):
        pool += 26
    if any(c.isdigit() for c in pw):
        pool += 10
    if any(not c.isalnum() and c.isascii() for c in pw):
        pool += 33
    if any(not c.isascii() for c in pw):
        pool += 100
    # Opakovane znaky nepridavaji tolik jako nove
    bits = math.log2(max(pool, 2)) * min(len(pw), 2 * len(set(pw)))
    return 1 if bits < 50 else 2 if bits < 70 else 3 if bits < 90 else 4


def strength_label(level):
