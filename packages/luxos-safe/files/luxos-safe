# ---- klic pro obnovu ----------------------------------------------------------------------
def format_master_key(hexkey):
    """64 hex znaku -> 8 skupin po 8 oddelenych pomlckou (format gocryptfs -masterkey)."""
    return "-".join(hexkey[i:i + 8] for i in range(0, 64, 8))


def normalize_recovery_key(text):
    """Klic opsany z papiru: mezery, pomlcky, velka pismena nevadi. None = neplatny."""
    k = "".join(c for c in text.lower() if c not in " -\t\r\n")
    if len(k) != 64 or any(c not in "0123456789abcdef" for c in k):
        return None
    return k


def master_key(password):
    """(klic, chyba) - hlavni klic Trezoru odemceny heslem (gocryptfs-xray -dumpmasterkey).
    Klic se nikam neuklada, jen se zobrazi."""
    rc, err, out = run_pw_out(["gocryptfs-xray", "-dumpmasterkey", CONF_FILE], [password])
    if rc in (XRAY_WRONG_PASSWORD, WRONG_PASSWORD):
        return None, _("Wrong password.")
    k = normalize_recovery_key(out.strip())
    if rc != 0 or not k:
        return None, _("Could not read the recovery key (%s).") % (err or rc)
    return format_master_key(k), None


def verify_master_key(key):
    """Spravny klic? Pripojit sifrovana data jen pro cteni do soukrome docasne slozky a zkusit
    rozsifrovat nazvy a obsah. Spatny klic nazvy nerozsifruje (vypis je prazdny) a cteni souboru
    selze (AES-GCM overuje kazdy blok). Prazdny Trezor overit nejde - neni co ztratit."""
    try:
        # Bez konfigurace a diriv; dlouhe nazvy (gocryptfs.longname.*) jsou sifrovana data
        cipher = [n for n in os.listdir(VAULT) if n != "gocryptfs.diriv" and not n.startswith("gocryptfs.conf")]
    except OSError:
        return False
    if not cipher:
        return True
    mnt = tempfile.mkdtemp(prefix="luxos-safe-verify-", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
    try:
        rc, _err = run_pw(["gocryptfs", "-q", "-ro", "-nosyslog", "-masterkey=stdin"] + MOUNT_OPTS + [VAULT, mnt],
                          [format_master_key(key)])
        if rc != 0:
            return False
        try:
            names = os.listdir(mnt)
            for n in names:
                p = os.path.join(mnt, n)
                if os.path.isfile(p) and not os.path.islink(p) and os.path.getsize(p) > 0:
                    with open(p, "rb") as f:
                        f.read(1)
                    break
            return bool(names)
        except OSError:
            return False
        finally:
            subprocess.run(["fusermount3", "-u", mnt], capture_output=True)
    finally:
        try:
            os.rmdir(mnt)
        except OSError:
            pass


def reset_password(recovery_key, new):
    """Zapomenute heslo: novy obal klice z klice pro obnovu (gocryptfs -passwd -masterkey=stdin)."""
    if is_unlocked():
        return _("Lock the Safe first.")
    key = normalize_recovery_key(recovery_key)
    if not key:
        return _("This is not a valid recovery key. It has 64 characters 0-9 and a-f.")
    if not verify_master_key(key):
        return _("This recovery key does not open this Safe.")
    bak = CONF_FILE + ".bak"
    # gocryptfs pri -masterkey uklada stary gocryptfs.conf jako .bak a existujici .bak neprepise
    stale = None
    if os.path.lexists(bak):
        stale = bak + ".old"
        os.replace(bak, stale)
    rc, err = run_pw(["gocryptfs", "-passwd", "-q", "-scryptn", str(target_logn()), "-masterkey=stdin", VAULT],
                     [format_master_key(key), new])
    if rc != 0:
        if stale:
            os.replace(stale, bak)
        return _("Could not change the password (%s).") % err
    # Stary obal klice (zapomenute nebo prozrazene heslo) nenechavat
    for p in (bak, stale):
        if p:
            try:
                os.unlink(p)
            except OSError:
                pass
    return None


# ---- kontrola ochrany -------------------------------------------------------------------
def _read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def _block_encrypted(name, sysfs="/sys", depth=0):
    """Blokove zarizeni (dm-0, nvme0n1p3 ...) je sifrovane (dm-crypt) nebo jen v RAM (zram)?"""
    if name.startswith("zram"):
        return True
    if depth > 8:
        return False
    if _read(f"{sysfs}/class/block/{name}/dm/uuid").startswith("CRYPT-"):
        return True
    try:
        slaves = os.listdir(f"{sysfs}/class/block/{name}/slaves")
    except OSError:
        slaves = []
    return bool(slaves) and all(_block_encrypted(s, sysfs, depth + 1) for s in slaves)


def swap_report(swaps="/proc/swaps", sysfs="/sys"):
    """[(zarizeni, sifrovane)] - nesifrovany swap muze na disk ulozit i pamet s klicem Trezoru."""
    res = []
    for line in _read(swaps).splitlines()[1:]:
        parts = line.split()
        if not parts:
            continue
        dev = _unescape(parts[0])
        try:
            if len(parts) > 1 and parts[1] == "file":
                st = os.stat(dev)
                name = os.path.basename(os.path.realpath(
                    f"{sysfs}/dev/block/{os.major(st.st_dev)}:{os.minor(st.st_dev)}"))
            else:
                name = os.path.basename(os.path.realpath(dev))
        except OSError:
            res.append((dev, False))
            continue
        res.append((dev, _block_encrypted(name, sysfs)))
    return res


def mount_options():
    """Volby pripojeni odemceneho Trezoru (set) nebo None."""
    last = None
    try:
        with open(MOUNTINFO) as f:
            for line in f:
                left, _sep, right = line.partition(" - ")
                fields = left.split()
                if len(fields) >= 6 and _unescape(fields[4]) == MOUNT and right.startswith("fuse.gocryptfs "):
                    last = set(fields[5].split(","))
    except OSError:
        pass
    return last


def core_limit(pid):
    for line in _read(f"/proc/{pid}/limits").splitlines():
        if line.startswith("Max core file size"):
            return line.split()[4]
    return None


def check():
    """[(ok, text)] - stav ochrany Trezoru pro "luxos-safe check"."""
    st = state()
    if st == "none":
        return [(True, _("No Safe has been created yet."))]
    res = []
    n = vault_logn()
    if n is None:
        res.append((False, _("Could not read the key protection settings (%s).") % CONF_FILE))
    elif n < SCRYPT_LOGN:
        res.append((False, _("Password protection: scrypt 2^%d, weaker than the recommended 2^%d. Use Upgrade Protection in the Safe window.") % (n, SCRYPT_LOGN)))
    else:
        res.append((True, _("Password protection: scrypt 2^%d.") % n))
    if st == "unlocked":
        opts = mount_options() or set()
        missing = [o for o in ("nosuid", "nodev", "noexec") if o not in opts]
        if missing:
            res.append((False, _("Mounted without %s: lock the Safe and unlock it again.") % ", ".join(missing)))
        else:
            res.append((True, _("Mounted with nosuid, nodev and noexec.")))
        limits = {core_limit(p) for p in _gocryptfs_pids()}
        if limits and limits <= {"0"}:
            res.append((True, _("Core dumps of the Safe process are disabled.")))
        else:
            res.append((False, _("Core dumps of the Safe process are allowed: lock the Safe and unlock it again.")))
    else:
        res.append((True, _("The Safe is locked: its contents are stored only encrypted.")))
    scope = _read("/proc/sys/kernel/yama/ptrace_scope")
    if scope.isdigit() and int(scope) >= 2:
        res.append((True, _("Other programs cannot read the memory of the Safe process (ptrace_scope %s).") % scope))
    else:
        res.append((False, _("Programs of your account can read the memory of the Safe process (ptrace_scope %s).") % (scope or "?")))
    for dev, enc in swap_report():
        if enc:
            res.append((True, _("Swap %s is encrypted or in memory only.") % dev))
        else:
            res.append((False, _("Swap %s is not encrypted: memory with keys could be written to the disk.") % dev))
    return res


def open_folder():
    subprocess.Popen(["xdg-open", MOUNT], start_new_session=True)


# ---- hlidac relace ----------------------------------------------------------------------
def take_sleep_inhibitor(system):
    """Zpozdeni uspani (logind "delay"), dokud se Trezor nezamkne. Vraci fd nebo None."""
    from gi.repository import Gio, GLib
    try:
        res, fds = system.call_with_unix_fd_list_sync(
            "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "Inhibit",
            GLib.Variant("(ssss)", ("sleep", _("Safe"), "Lock the Safe before sleep", "delay")),
            GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None)
        return fds.get(res.unpack()[0])
    except Exception:  # noqa: BLE001 - bez logind se jen nezpozdi uspani
        return None


def subscribe():
    """Zamykani pri zamceni obrazovky a pred uspanim (pouziva i luxos-hub). Zamyka se ve vlakne,
    aby cekani na zavreni souboru neblokovalo hlavni smycku."""
    from gi.repository import Gio

    inhibitor = {"fd": None}

    def in_thread(fn):
        threading.Thread(target=fn, daemon=True).start()

    def on_lock(*_a):
        if settings().get("lock_on_screen_lock", True):
            in_thread(lambda: lock("auto"))

    def on_saver(_c, _s, _p, _i, _sig, params):
        if params.unpack()[0]:
            on_lock()

    def release():
        fd, inhibitor["fd"] = inhibitor["fd"], None
        if fd is not None:
            os.close(fd)

    def on_sleep(_c, _s, _p, _i, _sig, params):
        if params.unpack()[0]:
            def go():
                try:
                    lock("auto")      # pred uspanim vzdy
                finally:
                    release()         # uspani pokracuje
            in_thread(go)
        else:
            release()
            inhibitor["fd"] = take_sleep_inhibitor(system)

    session = Gio.bus_get_sync(Gio.BusType.SESSION)
    session.signal_subscribe(None, "org.xfce.ScreenSaver", "ActiveChanged", None, None, 0, on_saver)
    system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    system.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                            "/org/freedesktop/login1", None, 0, on_sleep)
    inhibitor["fd"] = take_sleep_inhibitor(system)
    if state() == "locked":
        in_thread(trust_launcher)


def watch():
    from gi.repository import GLib

    subscribe()
    loop = GLib.MainLoop()

    def on_term():
        lock("logout")              # konec relace / odhlaseni
        loop.quit()
        return False
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, on_term)
    loop.run()


