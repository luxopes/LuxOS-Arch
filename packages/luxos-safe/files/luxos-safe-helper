#!/usr/bin/env python3
"""LuxOS - Trezor: privilegovana cast. Pripravi a chrani adresare Trezoru.

  /safe                       root:root 0755
  /safe/.vaults               root:root 0711   (sifrovana data, nelze vypsat)
  /safe/.vaults/<user>        user      0700   (gocryptfs: sifrovane soubory)
  /safe/<user>                root:root 0000 + chattr +i   (podkladovy adresar, nikdy se do nej nezapisuje)
    └ zastupny tmpfs          user 0700, jen spoustec "Odemknout Trezor" (nemenny), nic dalsiho
      └ gocryptfs (FUSE)      odemceny obsah, pripojuje uzivatel nad zastupny tmpfs
  /safe/.recovered/<user>     user      0700   (nesifrovane soubory nalezene ve stare slozce)

Zamceny Trezor = zastupny tmpfs bez volnych inodu: nic do nej nejde ulozit ani v nem nic precist
(krome spoustece), na disk se nesifrovane nezapise nic. fusermount3 vyzaduje pravo zapisu do
pripojneho bodu, proto je zastupny adresar uzivatelsky; nove soubory brani limit nr_inodes.

  pkexec luxos-safe-helper create    adresare a ochrana pro volajiciho uzivatele (PKEXEC_UID)
  pkexec luxos-safe-helper protect   jen ochrana pro volajiciho uzivatele (starsi instalace)
  luxos-safe-helper guard            (root, pri startu a aktualizaci) ochrana vsech Trezoru
"""
import datetime
import errno
import fcntl
import os
import pwd
import stat
import struct
import subprocess
import sys

ROOT = "/safe"
I18N = "/usr/share/luxos/i18n"
PLACEHOLDER = "luxos-safe-locked"        # zdroj (source) zastupneho tmpfs v /proc/self/mountinfo
LAUNCHER = "Unlock Safe.desktop"
LAUNCHER_NAME = "Unlock Safe"
LAUNCHER_COMMENT = "The Safe is locked. Files cannot be saved here until you unlock it."
# Spoustec, ktery do pripojneho bodu ukladaly verze do 1.0.0-3 (neni to data uzivatele)
LEGACY_LAUNCHER = ("[Desktop Entry]\nType=Application\nName=Unlock Safe\nName[cs]=Odemknout Trezor\n"
                   "Exec=luxos-safe unlock --open\nIcon=luxos-safe\nTerminal=false\n").encode()
LANGS = ("cs", "sk", "pl", "uk", "hu", "de", "fr", "es", "it", "pt", "nl", "sv")

FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x00000010
O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


class SafeError(Exception):
    pass


def log(msg):
    print(f"luxos-safe-helper: {msg}", file=sys.stderr, flush=True)


# ---- pripojeni ----------------------------------------------------------------------------
def _unescape(s):
    """Cesty v mountinfo maji mezery a podobne jako \\040."""
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 3 < len(s) and s[i + 1:i + 4].isdigit():
            out.append(chr(int(s[i + 1:i + 4], 8)))
            i += 4
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


def mounts_at(path, mountinfo="/proc/self/mountinfo"):
    """Pripojeni presne na `path` v poradi pripojeni (posledni je navrchu): [(fstype, source)]."""
    path = os.path.abspath(path)
    res = []
    try:
        with open(mountinfo) as f:
            for line in f:
                left, _sep, right = line.partition(" - ")
                fields, rfields = left.split(), right.split()
                if len(fields) >= 5 and len(rfields) >= 2 and _unescape(fields[4]) == path:
                    res.append((rfields[0], _unescape(rfields[1])))
    except OSError:
        pass
    return res


def is_placeholder(m):
    return m == ("tmpfs", PLACEHOLDER)


# ---- priznaky souboru -----------------------------------------------------------------------
def get_flags(fd):
    return struct.unpack("i", fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("i", 0)))[0]


def set_immutable(fd, on):
    """chattr +i / -i pres popisovac (bez cesty). Vraci False, kdyz to fs nebo jadro neumi."""
    try:
        flags = get_flags(fd)
        new = (flags | FS_IMMUTABLE_FL) if on else (flags & ~FS_IMMUTABLE_FL)
        if new != flags:
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("i", new))
        return True
    except OSError as e:
        if e.errno in (errno.ENOTTY, errno.EOPNOTSUPP, errno.EINVAL, errno.EPERM, errno.ENOSYS):
            return False
        raise


def is_immutable(fd):
    try:
        return bool(get_flags(fd) & FS_IMMUTABLE_FL)
    except OSError:
        return False


# ---- spoustec v zamcene slozce ------------------------------------------------------------
def translations(text):
    res = {}
    for lang in LANGS:
        try:
            with open(os.path.join(I18N, f"{lang}.tsv"), encoding="utf-8") as f:
                for line in f:
                    k, sep, v = line.rstrip("\n").partition("\t")
                    if sep and k == text and v and not line.startswith("#"):
                        res[lang] = v
                        break
        except OSError:
            pass
    return res


def launcher_text():
    """Obsah spoustece je pro vsechny stejny (vsechny jazyky), kontrolni soucet Thunaru tak plati porad."""
    lines = ["[Desktop Entry]", "Type=Application", f"Name={LAUNCHER_NAME}"]
    lines += [f"Name[{k}]={v}" for k, v in translations(LAUNCHER_NAME).items()]
    lines.append(f"Comment={LAUNCHER_COMMENT}")
    lines += [f"Comment[{k}]={v}" for k, v in translations(LAUNCHER_COMMENT).items()]
    lines += ["Exec=luxos-safe unlock --open", "Icon=luxos-safe", "Terminal=false", ""]
    return "\n".join(lines).encode()


# ---- ochrana jednoho Trezoru ----------------------------------------------------------------
def stage_entries(dfd, entries, name, uid, gid):
    """Presune nesifrovane soubory ze stare slozky do /safe/.recovered/<user>/<cas> (vlastni je uzivatel).

    Jen rename v ramci jednoho fs pres popisovace: nic se nekopiruje, nesleduji se symlinky,
    nic se nemaze. Vraci cestu ke slozce."""
    base = f"{ROOT}/.recovered"
    try:
        os.mkdir(base, 0o711)
    except FileExistsError:
        pass
    bfd = os.open(base, O_DIR)
    try:
        st = os.fstat(bfd)
        if st.st_uid != 0:
            raise SafeError(f"{base} is not owned by root")
        os.fchmod(bfd, 0o711)
        try:
            os.mkdir(name, 0o700, dir_fd=bfd)
        except FileExistsError:
            pass
        ufd = os.open(name, O_DIR, dir_fd=bfd)
    finally:
        os.close(bfd)
    try:
        os.fchown(ufd, uid, gid)
        os.fchmod(ufd, 0o700)
        stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H%M%S")
        for n in range(100):
            sub = stamp if n == 0 else f"{stamp}-{n}"
            try:
                os.mkdir(sub, 0o700, dir_fd=ufd)
                break
            except FileExistsError:
                continue
        else:
            raise SafeError("cannot create a recovery folder")
        sfd = os.open(sub, O_DIR, dir_fd=ufd)
    finally:
        os.close(ufd)
    try:
        os.fchown(sfd, uid, gid)
        os.fchmod(sfd, 0o700)
        for e in entries:
            os.rename(e, e, src_dir_fd=dfd, dst_dir_fd=sfd)
    finally:
        os.close(sfd)
    return f"{base}/{name}/{sub}"


def is_legacy_launcher(dfd, entry):
    try:
        fd = os.open(entry, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size != len(LEGACY_LAUNCHER):
            return False
        return os.read(fd, len(LEGACY_LAUNCHER) + 1) == LEGACY_LAUNCHER
    finally:
        os.close(fd)


def seal_underlying(path, name, uid, gid):
    """Podkladovy adresar: root:root 0000 a nemenny. Stara data presune (nikdy nesmaze).

    Vraci cestu se zachranenymi soubory nebo None."""
    try:
        os.mkdir(path, 0o000)
    except FileExistsError:
        pass
    fd = os.open(path, O_DIR)
    recovered = None
    try:
        st = os.fstat(fd)
        entries = os.listdir(fd)
        if st.st_uid == 0 and stat.S_IMODE(st.st_mode) == 0 and not entries and is_immutable(fd):
            return None
        set_immutable(fd, False)
        # Nejdriv odebrat uzivateli pravo zapisu, pak teprve presouvat (nic noveho uz nevznikne)
        os.fchown(fd, 0, 0)
        os.fchmod(fd, 0o700)
        entries = os.listdir(fd)
        if LAUNCHER in entries and is_legacy_launcher(fd, LAUNCHER):
            os.unlink(LAUNCHER, dir_fd=fd)
            entries.remove(LAUNCHER)
        if entries:
            try:
                recovered = stage_entries(fd, entries, name, uid, gid)
            except (OSError, SafeError) as e:
                # Bez ztraty dat: vratit slozku uzivateli, Trezor zustane nechraneny a ohlasi chybu
                os.fchown(fd, uid, gid)
                os.fchmod(fd, 0o700)
                raise SafeError(f"cannot move unencrypted files out of {path}: {e}") from e
        os.fchmod(fd, 0o000)
        if not set_immutable(fd, True):
            log(f"{path}: immutable flag not supported, relying on root:root 0000")
    finally:
        os.close(fd)
    return recovered


def run(args):
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0:
        raise SafeError(f"{' '.join(args)}: {r.stderr.strip()[-300:]}")


def mount_placeholder(path, uid, gid):
    """Zastupny tmpfs: jen nemenny spoustec, limit inodu nedovoli zalozit nic dalsiho.

    Pripravuje se pod rootem (0700 root) a uzivateli se preda az hotovy - zadne zavody."""
    run(["mount", "-t", "tmpfs", "-o", "mode=0700,uid=0,gid=0,nr_inodes=2,size=64k,nosuid,nodev",
         PLACEHOLDER, path])
    try:
        rfd = os.open(path, O_DIR)
        try:
            fd = os.open(LAUNCHER, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o500, dir_fd=rfd)
            try:
                os.write(fd, launcher_text())
                # Vlastnik uzivatel: Thunar (gvfs) ulozi kontrolni soucet duveryhodneho spoustece
                # jen u vlastnich souboru. Nemenny priznak brani zmene, smazani i prejmenovani.
                os.fchown(fd, uid, gid)
                os.fchmod(fd, 0o500)
                ok = set_immutable(fd, True)
            finally:
                os.close(fd)
            if not ok:
                # Jadro bez chattr na tmpfs: spoustec by sel smazat a misto nej ulozit soubor.
                # Radeji prazdna slozka bez jedineho volneho inodu.
                log(f"{path}: tmpfs without immutable files, placeholder without launcher")
                os.unlink(LAUNCHER, dir_fd=rfd)
                run(["mount", "-o", "remount,nr_inodes=1", path])
            os.fchown(rfd, uid, gid)
            os.fchmod(rfd, 0o700)
        finally:
            os.close(rfd)
    except BaseException:
        subprocess.run(["umount", path], capture_output=True)
        raise


def protect_user(name, uid, gid):
    """Vraci (stav, zachranene) - stav: protected | sealed | busy."""
    path = f"{ROOT}/{name}"
    # Nejdriv pripojeni: do odemceneho Trezoru (FUSE bez allow_other) nevstoupi ani root
    mounts = mounts_at(path)
    if any(is_placeholder(m) for m in mounts):
        return "protected", None
    if mounts:
        # Stara instalace s prave odemcenym Trezorem: ochrana az po zamceni (pri dalsim odemceni)
        return "busy", None
    try:
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode):
            raise SafeError(f"{path} is not a directory")
    except FileNotFoundError:
        pass
    recovered = seal_underlying(path, name, uid, gid)
    mount_placeholder(path, uid, gid)
    return "sealed", recovered


def ensure_dir(path, uid, gid, mode):
    """Vytvori adresar; existujici overi (zadne symlinky, spravny vlastnik)."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        os.mkdir(path, mode)
        st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode):
        raise SafeError(f"{path} is not a directory")
    os.chown(path, uid, gid, follow_symlinks=False)
    os.chmod(path, mode)


def valid_user(user):
    return user.pw_uid >= 1000 and user.pw_name.replace("-", "").replace("_", "").replace(".", "").isalnum() \
        and not user.pw_name.startswith(".")


def guard():
    """Vsechny Trezory (pri startu pred prihlasenim a po aktualizaci balicku)."""
    if not os.path.isdir(ROOT):
        return 0
    names = set()
    for d in (ROOT, f"{ROOT}/.vaults"):
        try:
            names.update(n for n in os.listdir(d) if not n.startswith("."))
        except OSError:
            pass
    rc = 0
    for n in sorted(names):
        try:
            user = pwd.getpwnam(n)
        except KeyError:
            continue
        if not valid_user(user):
            continue
        try:
            state, rec = protect_user(user.pw_name, user.pw_uid, user.pw_gid)
            log(f"{n}: {state}" + (f", unencrypted files moved to {rec}" if rec else ""))
        except (OSError, SafeError) as e:
            log(f"{n}: {e}")
            rc = 1
    return rc


def main():
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ("create", "protect", "guard"):
        sys.exit("usage: pkexec luxos-safe-helper create|protect  |  luxos-safe-helper guard")
    if sys.argv[1] == "guard":
        if "PKEXEC_UID" in os.environ:
            sys.exit("luxos-safe-helper: guard is not available through pkexec")
        return guard()
    try:
        uid = int(os.environ["PKEXEC_UID"])
    except (KeyError, ValueError):
        sys.exit("luxos-safe-helper: run through pkexec")
    user = pwd.getpwuid(uid)
    if not valid_user(user):
        sys.exit("luxos-safe-helper: refusing this user")
    try:
        if sys.argv[1] == "create":
            ensure_dir(ROOT, 0, 0, 0o755)
            ensure_dir(f"{ROOT}/.vaults", 0, 0, 0o711)
            ensure_dir(f"{ROOT}/.vaults/{user.pw_name}", uid, user.pw_gid, 0o700)
        state, rec = protect_user(user.pw_name, uid, user.pw_gid)
    except (OSError, SafeError) as e:
        sys.exit(f"luxos-safe-helper: {e}")
    if state == "busy":
        sys.exit("luxos-safe-helper: the Safe is mounted, lock it first")
    if rec:
        print(rec)
    return 0


if __name__ == "__main__":
    sys.exit(main())
