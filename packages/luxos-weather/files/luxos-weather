    def show_state(self, icon, title, hint="", button=None, action=None, busy=False):
        self.state_icon.set_from_icon_name(icon, Gtk.IconSize.DIALOG)
        self.state_icon.set_visible(not busy)
        self.state_spinner.set_visible(busy)
        if busy:
            self.state_spinner.start()
        else:
            self.state_spinner.stop()
        self.state_title.set_text(title)
        self.state_hint.set_text(hint)
        self.state_hint.set_visible(bool(hint))
        self.state_btn.set_visible(bool(button))
        if button:
            self.state_btn.set_label(button)
        self.state_action = action
        self.stack.set_visible_child_name("state")

    def on_state_button(self, _b):
        if self.state_action:
            self.state_action()

    # ---- prvni spusteni: mesto podle casoveho pasma ----
    def first_run(self):
        self.set_sky(None)
        self.show_state("find-location-symbolic", _("Finding your city…"), busy=True)

        def work():
            try:
                loc = lw.timezone_city(LANG)
            except lw.WeatherError:
                loc = None
            GLib.idle_add(self.first_run_done, loc)
        threading.Thread(target=work, daemon=True).start()

    def first_run_done(self, loc):
        if loc and not self.cfg["locations"]:
            self.add_location(loc)
        elif not self.cfg["locations"]:
            self.show_state("find-location-symbolic", _("Add a city"),
                            _("Search for a city with the + button to see its weather."),
                            _("Add a City…"), lambda: self.add_btn.set_active(True))
        return False

    # ---- vyhledavani mist ----
    def build_search(self):
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10)
        box.set_size_request(320, -1)
        self.search_entry = Gtk.SearchEntry(placeholder_text=_("Search for a city"))
        self.search_entry.connect("search-changed", self.on_search_changed)
        self.search_entry.connect("activate", self.on_search_activate)
        box.pack_start(self.search_entry, False, False, 0)
        here = Gtk.ModelButton(text=_("Use My Approximate Location…"))
        here.connect("clicked", self.on_ip_location)
        box.pack_start(here, False, False, 0)
        self.search_status = label("", "dim", xalign=0, wrap=True)
        self.search_status.set_no_show_all(True)
        box.pack_start(self.search_status, False, False, 0)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, max_content_height=320,
                                    propagate_natural_height=True)
        self.search_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, activate_on_single_click=True)
        self.search_list.connect("row-activated", self.on_search_pick)
        scroll.add(self.search_list)
        box.pack_start(scroll, True, True, 0)
        box.show_all()
        pop.add(box)
        pop.connect("closed", lambda _p: self.search_entry.set_text(""))
        return pop

    def set_search_status(self, text):
        self.search_status.set_text(text)
        self.search_status.set_visible(bool(text))

    def on_search_changed(self, entry):
        if self.search_id:
            GLib.source_remove(self.search_id)
        self.search_id = GLib.timeout_add(450, self.run_search)

    def on_search_activate(self, _e):
        row = self.search_list.get_row_at_index(0)
        if row is not None:
            self.on_search_pick(self.search_list, row)

    def run_search(self):
        self.search_id = None
        text = self.search_entry.get_text().strip()
        self.search_gen += 1
        gen = self.search_gen
        for row in self.search_list.get_children():
            row.destroy()
        if len(text) < 2:
            self.set_search_status("")
            return False
        self.set_search_status(_("Searching…"))

        def work():
            try:
                res, err = lw.search(text, LANG), None
            except lw.WeatherError as e:
                res, err = [], str(e)
            GLib.idle_add(self.search_done, gen, res, err)
        threading.Thread(target=work, daemon=True).start()
        return False

    def search_done(self, gen, places, err):
        if gen != self.search_gen:
            return False
        for row in self.search_list.get_children():
            row.destroy()
        if err:
            self.set_search_status(_("Search failed. Check your internet connection."))
            return False
        self.set_search_status("" if places else _("No city found."))
        for p in places:
            row = Gtk.ListBoxRow()
            row.place = p
            b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=6)
            b.pack_start(label(p["name"], "side-name", xalign=0), False, False, 0)
            sub = place_title(p)
            if sub:
                b.pack_start(label(sub, "side-sub", xalign=0, ellipsize=Pango.EllipsizeMode.END), False, False, 0)
            row.add(b)
            self.search_list.add(row)
        self.search_list.show_all()
        return False

    def on_search_pick(self, _lb, row):
        place = getattr(row, "place", None)
        if place:
            self.add_btn.get_popover().popdown()
            self.add_location(place)

    def on_ip_location(self, _b):
        self.add_btn.get_popover().popdown()
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text=_("Use your approximate location?"))
        dlg.format_secondary_text(_("Weather will ask the ipinfo.io service where your internet "
                                    "address is. Your address is sent to that service; the location "
                                    "is only approximate (usually your city or provider)."))
        dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        dlg.add_button(_("Use Location"), Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.CANCEL)
        resp = dlg.run()
        dlg.destroy()
        if resp != Gtk.ResponseType.OK:
            return
        self.show_state("find-location-symbolic", _("Finding your location…"), busy=True)

        def work():
            try:
                loc, err = lw.ip_location(), None
            except lw.WeatherError as e:
                loc, err = None, str(e)
            GLib.idle_add(self.ip_done, loc, err)
        threading.Thread(target=work, daemon=True).start()

    def ip_done(self, loc, err):
        if loc:
            self.add_location(loc)
        else:
            self.show_state("dialog-warning-symbolic", _("Your location could not be found"),
                            _("Search for your city with the + button instead."))
        return False

    # ---- mista ----
    def add_location(self, place):
        locs = self.cfg["locations"]
        for i, l in enumerate(locs):
            if lw.same_place(l, place):
                self.select(i)
                return
        before = self.units()
        keep = ("name", "lat", "lon", "admin", "country", "country_code", "tz")
        locs.append({k: place[k] for k in keep if k in place})
        self.cfg["selected"] = len(locs) - 1
        lw.save_config(self.cfg)
        self.rebuild_list()
        self.refresh(len(locs) - 1)
        self.units_changed(before)

    def remove_location(self, index):
        locs = self.cfg["locations"]
        if not 0 <= index < len(locs):
            return
        before = self.units()
        del locs[index]
        self.results = {i - (i > index): r for i, r in self.results.items() if i != index}
        self.cfg["selected"] = min(self.cfg["selected"], max(0, len(locs) - 1))
        lw.save_config(self.cfg)
        self.rebuild_list()
        if not locs:
            self.set_sky(None)
            self.show_state("find-location-symbolic", _("Add a city"),
                            _("Search for a city with the + button to see its weather."),
                            _("Add a City…"), lambda: self.add_btn.set_active(True))
        self.units_changed(before)

    def select(self, index):
        row = self.listbox.get_row_at_index(index)
        if row is not None:
            self.listbox.select_row(row)

    def rebuild_list(self):
        for row in self.listbox.get_children():
            row.destroy()
        for i, loc in enumerate(self.cfg["locations"]):
            row = Gtk.ListBoxRow()
            row.index = i
            box = Gtk.Box(spacing=8)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            col.pack_start(label(loc["name"], "side-name", xalign=0, ellipsize=Pango.EllipsizeMode.END),
                           False, False, 0)
            row.sub = label("", "side-sub", xalign=0, ellipsize=Pango.EllipsizeMode.END)
            col.pack_start(row.sub, False, False, 0)
            box.pack_start(col, True, True, 0)
            row.temp = label("", "side-temp", xalign=1)
            box.pack_end(row.temp, False, False, 0)
            row.add(box)
            self.listbox.add(row)
            self.update_row(i)
        self.listbox.show_all()
        if self.cfg["locations"]:
            self.select(self.cfg["selected"])
        self.refresh_btn.set_sensitive(bool(self.cfg["locations"]))

    def update_row(self, index):
        row = self.listbox.get_row_at_index(index)
        res = self.results.get(index)
        if row is None:
            return
        if res and res.get("data"):
            cur = res["data"]["current"]
            row.temp.set_text(deg(cur["temp"]))
            row.sub.set_text(_(lw.condition(cur["code"])))
        else:
            row.temp.set_text("")
            row.sub.set_text(_("Loading…") if index in self.loading else "")

    def on_row_selected(self, _lb, row):
        if row is None:
            return
        self.cfg["selected"] = row.index
        lw.save_config(self.cfg)
        self.show_detail(row.index)
        res = self.results.get(row.index)
        if not res or res.get("stale"):
            self.refresh(row.index)

    def on_list_button(self, _lb, event):
        if event.button != 3:
            return False
        row = self.listbox.get_row_at_y(int(event.y))
        if row is None:
            return False
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label=_("Remove “%s”") % self.cfg["locations"][row.index]["name"])
        item.connect("activate", lambda _i, i=row.index: self.remove_location(i))
        menu.append(item)
        menu.show_all()
        menu.attach_to_widget(self.listbox, None)
        menu.popup_at_pointer(event)
        return True

    # ---- nabidka ----
    def build_menu(self):
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=10)
        box.pack_start(label(_("Units"), "card-title", xalign=0), False, False, 4)
        group = None
        current = self.cfg["units"]
        self.unit_buttons = {}
        for key, text in (("auto", _("Automatic (%s)") % lw.unit_labels(self.detected_units())["temp"]),
                          ("metric", _("Celsius (°C, km/h)")), ("imperial", _("Fahrenheit (°F, mph)"))):
            b = Gtk.RadioButton(label=text, group=group)
            group = group or b
            b.set_active(key == current)
            b.connect("toggled", self.on_units, key)
            box.pack_start(b, False, False, 0)
            self.unit_buttons[key] = b
        box.pack_start(Gtk.Separator(margin_top=6, margin_bottom=6), False, False, 0)
        self.animate_btn = Gtk.CheckButton(label=_("Animated Background"), active=self.cfg["animate"])
        self.animate_btn.connect("toggled", self.on_animate)
        box.pack_start(self.animate_btn, False, False, 0)
        box.pack_start(Gtk.Separator(margin_top=6, margin_bottom=6), False, False, 0)
        rm = Gtk.ModelButton(text=_("Remove Location"))
        rm.connect("clicked", lambda _b: self.remove_location(self.cfg["selected"]))
        box.pack_start(rm, False, False, 0)
        box.pack_start(label(_("Weather data: Open-Meteo.com (CC BY 4.0)"), "dim", xalign=0,
                             margin_top=6), False, False, 0)
        box.show_all()
        pop.add(box)
        return pop

    def on_units(self, button, key):
        if not button.get_active() or self.cfg["units"] == key:
            return
        self.set_units(key)

    def set_units(self, key):
        """Ulozi volbu jednotek (nabidka i dotaz pri prvnim otevreni) a nacte data v nich."""
        before = self.units()
        self.cfg["units"] = key
        self.cfg["units_asked"] = True
        lw.save_config(self.cfg)
        self.units_banner.set_reveal_child(False)
        button = self.unit_buttons.get(key)
        if button is not None and not button.get_active():
            button.set_active(True)          # on_units uz nic nezmeni (stejna hodnota)
        if self.units() != before:
            self.results = {}
            self.refresh_all()

    def on_animate(self, button):
        self.cfg["animate"] = button.get_active()
        lw.save_config(self.cfg)
        self.sky_area.update()
        self.sky_area.queue_draw()

    def detected_units(self):
        return lw.resolve_units("auto", places=self.cfg["locations"])

    def units(self):
        return lw.resolve_units(self.cfg["units"], places=self.cfg["locations"])

    def units_changed(self, before):
        """Automaticke jednotky zavisi i na prvnim miste: po pridani/odebrani mista znovu nacist."""
        auto = self.unit_buttons.get("auto")
        if auto is not None:
            auto.set_label(_("Automatic (%s)") % lw.unit_labels(self.detected_units())["temp"])
        if self.units() != before:
            self.results = {}
            self.refresh_all()

    # ---- dotaz na jednotky pri prvnim otevreni (nenapadny pruh, neblokuje) ----
    def build_units_banner(self):
        self.units_banner = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN)
        box = Gtk.Box(spacing=10, margin_start=18, margin_end=18, margin_top=12)
        box.get_style_context().add_class("units-banner")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_start=14, margin_top=8,
                       margin_bottom=8)
        text.pack_start(label(_("Which unit do you prefer?"), "banner-title", xalign=0), False, False, 0)
        self.units_hint = label("", "dim", xalign=0, wrap=True)
        text.pack_start(self.units_hint, False, False, 0)
        box.pack_start(text, True, True, 0)
        self.units_choice = {}
        for key, text_ in (("metric", _("Celsius (°C)")), ("imperial", _("Fahrenheit (°F)"))):
            b = Gtk.Button(label=text_, valign=Gtk.Align.CENTER)
            b.connect("clicked", lambda _b, k=key: self.set_units(k))
            box.pack_start(b, False, False, 0)
            self.units_choice[key] = b
        close = Gtk.Button(valign=Gtk.Align.CENTER, margin_end=8, tooltip_text=_("Keep Automatic"))
        close.add(Gtk.Image(icon_name="window-close-symbolic"))
        close.get_style_context().add_class("flat-close")
        close.connect("clicked", lambda _b: self.dismiss_units_banner())
        box.pack_start(close, False, False, 0)
        self.units_banner.add(box)
        return self.units_banner

    def show_units_banner(self):
        """Jen jednou: dokud uzivatel nevybere jednotky ani pruh nezavre. Predvybrane jsou zjistene."""
        if self.cfg.get("units_asked"):
            return
        units = self.units()
        for key, b in self.units_choice.items():
            ctx = b.get_style_context()
            (ctx.add_class if key == units else ctx.remove_class)("primary")
        self.units_hint.set_text(_("We picked %s for your region. You can change it any time in ⋯ › Units.")
                                 % lw.unit_labels(units)["temp"])
        self.units_banner.set_reveal_child(True)

    def dismiss_units_banner(self):
        """Zavrit bez volby: zustanou automaticke jednotky, uz se neptame."""
        self.cfg["units_asked"] = True
        lw.save_config(self.cfg)
        self.units_banner.set_reveal_child(False)

    # ---- data ----
    def refresh_all(self):
        """Nejdriv data z mezipameti (okamzite, i bez site), pak zastarala stahnout."""
        units = self.units()
        for i, loc in enumerate(self.cfg["locations"]):
            if i not in self.results:
                cached = lw.cached_forecast(loc, units)
                if cached:
                    self.results[i] = cached
            self.update_row(i)
        if self.cfg["locations"]:
            self.show_detail(self.cfg["selected"])
        for i in range(len(self.cfg["locations"])):
            res = self.results.get(i)
            if not res or res.get("stale"):
                self.refresh(i)

    def refresh_selected(self, force=False):
        if self.cfg["locations"]:
            self.refresh(self.cfg["selected"], force=force)

    def refresh(self, index, force=False):
        if index in self.loading or not 0 <= index < len(self.cfg["locations"]):
            return
        loc = dict(self.cfg["locations"][index])
        units = self.units()
        self.loading.add(index)
        self.update_row(index)
        if index == self.cfg["selected"] and index not in self.results:
            self.set_sky(None)
            self.show_state("weather-overcast-symbolic", _("Loading the forecast…"), busy=True)

        def work():
            res = lw.forecast(loc, units, force=force)
            GLib.idle_add(self.refreshed, index, loc, units, res)
        threading.Thread(target=work, daemon=True).start()

    def refreshed(self, index, loc, units, res):
        self.loading.discard(index)
        locs = self.cfg["locations"]
        if index >= len(locs) or not lw.same_place(locs[index], loc) or units != self.units():
            return False      # misto mezitim odebrane nebo zmenene jednotky
        old = self.results.get(index)
        if res.get("data") is None and old and old.get("data"):
            old = dict(old, stale=True, error=res.get("error"))
            res = old
        self.results[index] = res
        self.update_row(index)
        if index == self.cfg["selected"]:
            self.show_detail(index)
            lw.write_summary(loc, res, units)
        return False

    def periodic(self):
        for i, res in list(self.results.items()):
            if res.get("data") and time.time() - res.get("fetched", 0) >= lw.TTL and i < len(self.cfg["locations"]):
                self.refresh(i)
        return True

    # ---- detail ----
    def set_sky(self, scene):
        """Scena pozadi (lw.scene_for) nebo None (nacitani, chyba: neutralni obloha)."""
        self.scene = scene
        self.sky_class = f"sky-{scene['name'] if scene else 'none'}"
        self.sky_area.set_scene(scene)

    def current_scene(self):
        res = self.results.get(self.cfg["selected"]) if self.cfg["locations"] else None
        if res and res.get("data") and self.stack.get_visible_child_name() == "detail":
            return lw.scene_for(res["data"])
        return None

    def update_scene(self):
        """Zmena vzhledu (svetly/tmavy): stejna scena v jinych barvach."""
        self.sky_area.sky.dark = None
        self.set_sky(self.current_scene())

    def periodic_scene(self):
        """Denni doba (usvit, den, soumrak, noc) se meni i bez novych dat."""
        scene = self.current_scene()
        if scene and (not self.scene or scene["name"] != self.scene["name"]):
            self.set_sky(scene)
        return True

    def show_detail(self, index):
        if not 0 <= index < len(self.cfg["locations"]):
            return
        loc = self.cfg["locations"][index]
        res = self.results.get(index)
        if not res or not res.get("data"):
            self.set_sky(None)
            if index in self.loading or not res:
                self.show_state("weather-overcast-symbolic", _("Loading the forecast…"), busy=True)
            else:
                self.show_state("network-offline-symbolic", _("The forecast could not be loaded"),
                                _("Check your internet connection and try again."), _("Try Again"),
                                lambda: self.refresh(index, force=True))
            return
        data, units = res["data"], self.units()
        self.set_sky(lw.scene_for(data))
        old = self.detail_scroller.get_child()   # Gtk.Viewport kolem predchozi stranky
        if old is not None:
            old.destroy()
        self.detail = self.build_detail(loc, res, units)
        self.detail_scroller.add(self.detail)
        self.detail.show_all()
        self.stack.set_visible_child_name("detail")
        self.show_units_banner()

    def build_detail(self, loc, res, units):
        data = res["data"]
        cur, today = data["current"], data["daily"][0]
        lab = lw.unit_labels(units)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=22)
        page.set_size_request(380, -1)

        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0, halign=Gtk.Align.CENTER)
        head.pack_start(label(loc["name"], "place"), False, False, 0)
        head.pack_start(label(deg(cur["temp"]), "big-temp"), False, False, 0)
        head.pack_start(label(_(lw.condition(cur["code"])), "cond"), False, False, 0)
        head.pack_start(label(_("H: %s  L: %s") % (deg(today["max"]), deg(today["min"])), "hilo"), False, False, 2)
        fetched = time.strftime("%H:%M", time.localtime(res["fetched"])) if res.get("fetched") else "–"
        offline = bool(res.get("stale") and res.get("error"))
        if offline:
            pill = Gtk.EventBox(halign=Gtk.Align.CENTER, margin_top=8)
            pill.get_style_context().add_class("card")
            pill.add(label(_("Offline – showing the forecast from %s") % fetched, "offline",
                           margin_start=12, margin_end=12, margin_top=4, margin_bottom=4))
            head.pack_start(pill, False, False, 0)
        page.pack_start(head, False, False, 4)

        # 24 hodin
        hours = Gtk.Box(spacing=4)
        for i, h in enumerate(data["hourly"]):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            col.set_size_request(52, -1)
            col.pack_start(label(_("Now") if i == 0 else hour_label(h["time"], units), "hour-time"), False, False, 0)
            col.pack_start(weather_image(lw.icon_name(h["code"], h["is_day"]), 32), False, False, 0)
            pop = label(f"{round(h['pop'])} %" if h["pop"] and h["pop"] >= 20 else " ", "pop")
            col.pack_start(pop, False, False, 0)
            col.pack_start(label(deg(h["temp"]), "hour-temp"), False, False, 0)
            hours.pack_start(col, False, False, 0)
        hscroll = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True)
        hscroll.add(hours)
        page.pack_start(card(_("Hourly forecast"), hscroll), False, False, 0)

        # 7 dni
        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        wlo = min(d["min"] for d in data["daily"])
        whi = max(d["max"] for d in data["daily"])
        for i, d in enumerate(data["daily"]):
            grid.attach(label(day_label(d["date"], i), "day-name", xalign=0, width_chars=7), 0, i, 1, 1)
            grid.attach(weather_image(lw.icon_name(d["code"], True), 28), 1, i, 1, 1)
            grid.attach(label(f"{round(d['pop'])} %" if d["pop"] and d["pop"] >= 20 else "", "pop",
                              width_chars=5), 2, i, 1, 1)
            grid.attach(label(deg(d["min"]), "day-min", xalign=1, width_chars=4), 3, i, 1, 1)
            bar = RangeBar(d["min"], d["max"], wlo, whi, units == "metric")
            bar.set_hexpand(True)
            grid.attach(bar, 4, i, 1, 1)
            grid.attach(label(deg(d["max"]), "day-max", xalign=0, width_chars=4), 5, i, 1, 1)
        page.pack_start(card(_("7-day forecast"), grid), False, False, 0)

        # Podrobnosti
        tiles = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, column_spacing=10,
                            row_spacing=10, min_children_per_line=2, max_children_per_line=4)

        def tile(title, value, sub=""):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.pack_start(label(value, "tile-value", xalign=0), False, False, 0)
            if sub:
                box.pack_start(label(sub, "tile-sub", xalign=0, wrap=True), False, False, 0)
            tiles.add(card(title, box))
        tile(_("Feels like"), deg(cur["feels"]))
        if cur["humidity"] is not None:
            tile(_("Humidity"), f"{round(cur['humidity'])} %")
        if cur["wind"] is not None:
            tile(_("Wind"), f"{round(cur['wind'])} {lab['wind']}", _(lw.compass(cur["wind_dir"])))
        if today["precip"] is not None:
            amount = f"{today['precip']:.1f}" if units == "metric" else f"{today['precip']:.2f}"
            tile(_("Precipitation"), f"{amount} {lab['precip']}", _("Today"))
        if today["uv"] is not None:
            tile(_("UV index"), str(round(today["uv"])), uv_text(round(today["uv"])))
        if cur["pressure"] is not None:
            tile(_("Pressure"), f"{round(cur['pressure'])} hPa")
        if today["sunrise"]:
            tile(_("Sunrise"), clock_label(today["sunrise"], units),
                 _("Sunset: %s") % clock_label(today["sunset"], units))
        page.pack_start(tiles, False, False, 0)

        # Stav dat (bez site je upozorneni nahore)
        page.pack_start(label(_("Updated at %s · Open-Meteo.com") % fetched, "footer", wrap=True), False, False, 0)
        return page


def main():
    GLib.set_prgname(APP)
    GLib.set_application_name(_("Weather"))
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = WeatherWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
