_PIX = {}


def weather_image(name, size):
    """Ikona pocasi ze SVG (ostra i pri HiDPI: Cairo surface s meritkem okna)."""
    scale = max(1, Gdk.Screen.get_default().get_monitor_scale_factor(0) if Gdk.Screen.get_default() else 1)
    key = (name, size, scale)
    pix = _PIX.get(key)
    if pix is None:
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_size(os.path.join(ICONS, name + ".svg"),
                                                         size * scale, size * scale)
        except GLib.Error:
            pix = False
        _PIX[key] = pix
    if not pix:
        return Gtk.Image(icon_name="weather-overcast-symbolic", pixel_size=size)
    surf = Gdk.cairo_surface_create_from_pixbuf(pix, scale, None)
    return Gtk.Image.new_from_surface(surf)


def label(text="", cls=None, xalign=0.5, **kw):
    lbl = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in (cls or "").split():
        lbl.get_style_context().add_class(c)
    return lbl


