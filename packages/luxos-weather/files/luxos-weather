def deg(value):
    return "–" if value is None else f"{round(value)}°"


def parse_local(text):
    """'2026-10-26T14:00' (mistni cas mista) -> GLib.DateTime bez pasma (jen k formatovani)."""
    try:
        date, _sep, clock = text.partition("T")
        y, m, d = (int(x) for x in date.split("-"))
        hh, mm = (int(x) for x in (clock or "00:00").split(":")[:2])
        return GLib.DateTime.new_utc(y, m, d, hh, mm, 0)
    except (ValueError, TypeError):
        return None


def hour_label(text, units):
    dt = parse_local(text)
    if dt is None:
        return text[11:13]
    return dt.format("%l %p").strip() if units == "imperial" else dt.format("%H")


def clock_label(text, units):
    dt = parse_local(text)
    if dt is None:
        return ""
    return dt.format("%l:%M %p").strip() if units == "imperial" else dt.format("%H:%M")


def day_label(text, index):
    if index == 0:
        return _("Today")
    dt = parse_local(text + "T12:00")
    if dt is None:
        return text
    # zkratky dnu z prekladu LuxOS (Kalendar), nezavisle na nainstalovanych locale
    return _(WEEKDAYS[dt.get_day_of_week() - 1]).capitalize()


def uv_text(uv):
    if uv is None:
        return ""
    if uv < 3:
        return _("Low")
    if uv < 6:
        return _("Moderate")
    if uv < 8:
        return _("High")
    if uv < 11:
        return _("Very High")
    return _("Extreme")


def place_title(loc):
    parts = [loc.get("admin") or "", loc.get("country") or ""]
    return ", ".join(p for p in parts if p and p != loc["name"])


class RangeBar(Gtk.DrawingArea):
    """Pruh rozsahu teplot dne v ramci celeho tydne (jako v aplikacich pocasi v telefonu)."""

    def __init__(self, lo, hi, week_lo, week_hi, metric):
        super().__init__()
        self.set_size_request(110, 6)
        self.set_valign(Gtk.Align.CENTER)
        self.vals = (lo, hi, week_lo, week_hi, metric)
        self.connect("draw", self.draw)

    @staticmethod
    def color(t, metric):
        c = t if metric else (t - 32) / 1.8
        stops = [(-10, (0.45, 0.65, 1.0)), (5, (0.3, 0.8, 0.95)), (15, (0.45, 0.85, 0.35)),
                 (22, (1.0, 0.78, 0.15)), (30, (1.0, 0.45, 0.15))]
        if c <= stops[0][0]:
            return stops[0][1]
        for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
            if c <= t1:
                k = (c - t0) / (t1 - t0)
                return tuple(a + (b - a) * k for a, b in zip(c0, c1))
        return stops[-1][1]

    def draw(self, widget, cr):
        import cairo
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        lo, hi, wlo, whi, metric = self.vals
        r = h / 2

        def pill(x0, x1):
            cr.new_sub_path()
            cr.arc(x0 + r, r, r, 1.5708, 4.7124)
            cr.arc(max(x0 + r, x1 - r), r, r, -1.5708, 1.5708)
            cr.close_path()
        cr.set_source_rgba(0, 0, 0, 0.16)
        pill(0, w)
        cr.fill()
        span = max(0.1, whi - wlo)
        x0 = (lo - wlo) / span * (w - 2 * r)
        x1 = (hi - wlo) / span * (w - 2 * r) + 2 * r
        grad = cairo.LinearGradient(x0, 0, x1, 0)
        grad.add_color_stop_rgb(0, *self.color(lo, metric))
        grad.add_color_stop_rgb(1, *self.color(hi, metric))
        cr.set_source(grad)
        pill(x0, x1)
        cr.fill()


def system_dark():
    s = Gtk.Settings.get_default()
    return "dark" in (s.props.gtk_theme_name or "").lower() or bool(s.props.gtk_application_prefer_dark_theme)


def powersaver_on():
    return os.path.exists(POWERSAVER)


class SkyArea(Gtk.DrawingArea):
    """Pozadi okna: kreslena scena pocasi (luxos_weather_sky). Casovac snimku bezi, jen kdyz je
    na co se divat a scena se hybe: okno je zobrazene a aktivni (ne minimalizovane, ne na pozadi),
    animace GTK nejsou vypnute (Omezit pohyb), Uspora baterie je vypnuta a volba Animovane pozadi
    v nabidce je zapnuta. Jinak zustane staticky snimek."""

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.sky = lsky.Sky()
        self.timer = None
        self.last = 0.0
        self.iconified = False
        self.force_active = None        # testy: True/False misto skutecneho stavu okna (None)
        self.frames = 0
        self.connect("draw", self.on_draw)
        self.connect("map", lambda *_a: self.update())
        self.connect("unmap", lambda *_a: self.update())
        win.connect("notify::is-active", lambda *_a: self.update())
        win.connect("window-state-event", self.on_state)
        settings = Gtk.Settings.get_default()
        settings.connect("notify::gtk-enable-animations", lambda *_a: self.update())
        settings.connect("notify::gtk-theme-name", lambda *_a: self.win.update_scene())
        settings.connect("notify::gtk-application-prefer-dark-theme", lambda *_a: self.win.update_scene())
        # Uspora baterie: priznak ~/.config/luxos/powersaver (inotify, zadne dotazovani)
        try:
            self.saver_mon = Gio.File.new_for_path(POWERSAVER).monitor_file(Gio.FileMonitorFlags.NONE, None)
            self.saver_mon.connect("changed", lambda *_a: self.update())
        except GLib.Error:
            self.saver_mon = None

    def on_state(self, _w, event):
        self.iconified = bool(event.new_window_state & (Gdk.WindowState.ICONIFIED | Gdk.WindowState.WITHDRAWN))
        self.update()
        return False

    def motion_allowed(self):
        return (self.win.cfg.get("animate", True) and Gtk.Settings.get_default().props.gtk_enable_animations
                and not powersaver_on())

    def visible(self):
        active = self.win.is_active() if self.force_active is None else self.force_active
        return self.get_mapped() and not self.iconified and active

    def set_scene(self, scene):
        # prolnuti jen kdyz se na nej nekdo diva (jinak by zustal stary snimek)
        if self.sky.set_scene(scene, system_dark(), fade=self.visible() and self.motion_allowed()):
            self.queue_draw()
        self.update()

    def running(self):
        return self.visible() and self.sky.fps() > 0

    def update(self):
        """Spusti, zmeni nebo zastavi casovac snimku podle stavu okna a sceny."""
        self.sky.set_motion(self.motion_allowed())
        if not self.visible() and self.sky.finish_fade():
            self.queue_draw()                    # at po pauze nezustane napul prolnuta stara scena
        fps = self.sky.fps() if self.running() else 0
        if self.timer and getattr(self, "timer_fps", 0) != fps:
            GLib.source_remove(self.timer)
            self.timer = None
        if fps and not self.timer:
            self.timer_fps = fps
            self.last = time.monotonic()
            self.timer = GLib.timeout_add(max(16, int(1000 / fps)), self.tick)
        return False

    def tick(self):
        now = time.monotonic()
        self.sky.advance(now - self.last)
        self.last = now
        self.queue_draw()
        if not self.running() or self.sky.fps() != self.timer_fps:
            self.timer = None
            GLib.idle_add(self.update)
            return False
        return True

    def on_draw(self, widget, cr):
        self.frames += 1
        self.sky.draw(cr, widget.get_allocated_width(), widget.get_allocated_height(),
                      widget.get_scale_factor())
        return False


