#!/bin/bash
# LuxOS - /usr/bin/pacman: kompatibilni vrstva. Spravcem baliku LuxOS je lux.
#
# Skutecny pacman z Arch Linuxu je /usr/lib/lux/alpm/pacman (balik luxos-pacman).
# Beze zmeny ho dostane:
#   - kazdy volajici bez terminalu (skripty, hooky, sluzby, roury, presmerovany vystup),
#   - makepkg, pacstrap, lux a AUR pomocnici (i pres sudo/unshare - hleda se v predcich procesu),
#   - LUX_ALLOW_PACMAN=1 pacman ... (pod sudo: sudo LUX_ALLOW_PACMAN=1 pacman ...),
#   - trvale pro cely system: soubor /etc/lux/allow-pacman.
# Clovek v terminalu misto toho uvidi odpovidajici prikaz lux (navratovy kod 1).
REAL=/usr/lib/lux/alpm/pacman
ALLOW_FILE=/etc/lux/allow-pacman
# Predci, kteri pacman potrebuji (jmeno procesu, u skriptu i jmeno skriptu)
TOOLS=" makepkg pacstrap lux yay paru pikaur trizen aura pamac "

# Spusteno nastrojem ze seznamu TOOLS? (/proc/<pid>/stat: "pid (jmeno) stav ppid ...")
#   /proc/self (ne $PPID): pacstrap a arch-chroot spousti pacman v novem PID namespace (unshare),
#   kde getppid() vraci 0; /proc hostitele ukazuje skutecne predky.
called_by_tool() {
    local pid stat comm i a
    local -a f argv
    IFS= read -r stat 2>/dev/null </proc/self/stat || return 1
    f=(${stat##*\) })
    pid=${f[1]-}
    for ((i = 0; i < 32; i++)); do
        [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)) || return 1
        IFS= read -r stat 2>/dev/null <"/proc/$pid/stat" || return 1
        comm=${stat#*\(}; comm=${comm%\) *}
        [[ $TOOLS == *" $comm "* ]] && return 0
        # skript spusteny interpretem (bash /usr/bin/makepkg): jmeno skriptu je az v argumentech
        argv=()
        mapfile -d '' -t argv 2>/dev/null <"/proc/$pid/cmdline"
        if [[ ${argv[0]##*/} =~ ^(bash|sh|dash|zsh|lsh|env)$ ]]; then
            for a in "${argv[@]:1}"; do
                [[ $a == -* ]] && continue
                [[ $TOOLS == *" ${a##*/} "* ]] && return 0
                break
            done
        fi
        f=(${stat##*\) })
        pid=${f[1]-}
    done
    return 1
}

# LUX_PACMAN_HINT=1: jen napoveda (lux -Syu apod.), nikdy skutecny pacman
if [[ ${LUX_PACMAN_HINT-} != 1 ]] && { [[ ${LUX_ALLOW_PACMAN-} == 1 || ! -t 0 || ! -t 1 || -e $ALLOW_FILE ]] || called_by_tool; }; then
    exec "$REAL" "$@"
fi

# ---- clovek v terminalu: misto pacmanu prikaz lux ------------------------------------------
[[ -r /usr/lib/luxos/i18n.sh ]] && . /usr/lib/luxos/i18n.sh
declare -F T >/dev/null || T() { local f=$1; shift; printf -- "$f" "$@"; }

if [[ ! -x $REAL ]]; then
    printf '%s\n' "$(T "The package manager core is missing (%s). Repair it with: %s" "$REAL" "lux reinstall luxos-pacman")" >&2
    exit 127
fi

# Argumenty pacmanu -> operace (S/R/Q/U/F/D/T/V), pismena voleb a cile
op="" flags="" targets=()
parse_args() {
    local a c j
    while (($#)); do
        a=$1; shift
        case $a in
            --) targets+=("$@"); return ;;
            --sync) op=S ;;
            --remove) op=R ;;
            --query) op=Q ;;
            --upgrade) op=U ;;
            --files) op=F ;;
            --database) op=D ;;
            --deptest) op=T ;;
            --version) op=V ;;
            --help) flags+=h ;;
            --sysupgrade|--upgrades) flags+=u ;;
            --refresh) flags+=y ;;
            --search|--recursive) flags+=s ;;
            --info) flags+=i ;;
            --list) flags+=l ;;
            --owns) flags+=o ;;
            --clean|--cascade) flags+=c ;;
            --groups) flags+=g ;;
            --deps) flags+=d ;;
            --unrequired) flags+=t ;;
            --explicit) flags+=e ;;
            --foreign) flags+=m ;;
            --*=*) ;;
            # volby s hodnotou v dalsim argumentu
            --config|--root|--dbpath|--cachedir|--gpgdir|--hookdir|--logfile|--arch|--color|--sysroot|\
            --ignore|--ignoregroup|--overwrite|--assume-installed|--print-format|--assumeinstalled)
                shift ;;
            --*) ;;
            -?*)
                for ((j = 1; j < ${#a}; j++)); do
                    c=${a:j:1}
                    case $c in
                        [SRQUFDTV]) op=$c ;;
                        [br])   # -b DBPATH, -r ROOT: zbytek slova nebo dalsi argument je hodnota
                            ((j == ${#a} - 1)) && shift
                            break ;;
                        *) flags+=$c ;;
                    esac
                done ;;
            *) targets+=("$a") ;;
        esac
    done
}

has() { [[ $flags == *"$1"* ]]; }
q() { local out="" a; for a in "$@"; do printf -v a '%q' "$a"; out+=" $a"; done; printf '%s' "${out# }"; }

# Odpovidajici prikazy lux (kazdy na radek); prazdne = obecna napoveda
lux_equivalent() {
    local t=${targets[0]-}
    case $op in
        S)
            if has c; then echo "lux clean"
            elif has s; then echo "lux search${t:+ $(q "${targets[@]}")}"
            elif has i; then [[ -n $t ]] && echo "lux info $(q "$t")"
            elif has u; then echo "lux update"; ((${#targets[@]})) && echo "lux install $(q "${targets[@]}")"
            elif has l || has g || has w; then :
            elif ((${#targets[@]})); then echo "lux install $(q "${targets[@]}")"
            elif has y; then echo "lux update"
            fi ;;
        U) ((${#targets[@]})) && echo "lux install $(q "${targets[@]}")" ;;
        R) ((${#targets[@]})) && echo "lux remove $(q "${targets[@]}")" ;;
        Q)
            if has o; then ((${#targets[@]})) && echo "lux owns $(q "${targets[@]}")"
            elif has l; then [[ -n $t ]] && echo "lux files $(q "$t")"
            elif has i; then if [[ -n $t ]]; then echo "lux info $(q "$t")"; else echo "lux list"; fi
            elif has s; then echo "lux list${t:+ $(q "$t")}"
            elif has u; then echo "lux list --upgradable"
            elif has d && has t; then echo "lux list --orphans"; echo "lux autoremove"
            elif has m; then echo "lux list --aur"
            elif has e; then echo "lux list --explicit"
            elif has k; then echo "lux doctor"
            elif [[ -n $t ]]; then echo "lux info $(q "$t")"
            else echo "lux list"
            fi ;;
        V) echo "lux --version" ;;
    esac
}

parse_args "$@"
mapfile -t suggest < <(lux_equivalent)

if [[ -t 2 && -z ${NO_COLOR-} ]]; then
    B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' C=$'\e[38;2;167;123;255m'
else
    B="" D="" R="" C=""
fi
sudo=""
((EUID == 0)) && [[ -n ${SUDO_USER-} ]] && sudo="sudo "
orig="${sudo}pacman${1+ $(q "$@")}"

{
    printf '%s✦%s %s\n' "$C" "$R" "$(T "LuxOS uses lux to manage software.")"
    for s in "${suggest[@]}"; do
        printf '  %s%s%s  →  %s%s%s\n' "$D" "$orig" "$R" "$B" "$s" "$R"
        orig=$(printf '%*s' "${#orig}" "")
    done
    printf '  %s\n' "$(T "All lux commands: %s" "${B}lux --help${R}")"
    printf '  %s%s%s\n' "$D" "$(T "Experts can still run pacman directly: %s" "${sudo}LUX_ALLOW_PACMAN=1 pacman${1+ $(q "$@")}")" "$R"
} >&2
exit 1
