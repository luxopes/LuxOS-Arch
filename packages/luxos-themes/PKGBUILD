# Maintainer: LuxOS Team
# macOS-like vzhled: WhiteSur GTK/xfwm4/Plank, ikony a kurzory (vinceliuice, MIT/GPL).
# Commity jsou pevne pripnute kvuli reprodukovatelnosti sestaveni.

pkgname=luxos-themes
pkgver=2025.12.27
pkgrel=8
pkgdesc="LuxOS macOS-like themes (WhiteSur GTK, xfwm4, Plank, icons and cursors)"
arch=(any)
url="https://github.com/vinceliuice"
license=(MIT GPL-3.0-or-later)
depends=(gtk3 gnome-themes-extra hicolor-icon-theme luxos-branding)
makedepends=(git)
options=(!strip !debug)
_gtk=d5782652d412137e26fb8ff55b55a5572e4c6995
_icons=73d8040da51a9ed74e47c7366e7e9ff437601a5c
_cursors=e190baf618ed95ee217d2fd45589bd309b37672b
source=("WhiteSur-gtk-theme::git+https://github.com/vinceliuice/WhiteSur-gtk-theme.git#commit=$_gtk"
        "WhiteSur-icon-theme::git+https://github.com/vinceliuice/WhiteSur-icon-theme.git#commit=$_icons"
        "WhiteSur-cursors::git+https://github.com/vinceliuice/WhiteSur-cursors.git#commit=$_cursors")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    local themes="$pkgdir/usr/share/themes"
    local icons="$pkgdir/usr/share/icons"
    install -dm755 "$themes" "$icons" "$pkgdir/usr/share/plank/themes"

    # GTK 2/3/4 + xfwm4 + Plank (predpripravene release archivy)
    for v in Dark Light; do
        tar -xJf "$srcdir/WhiteSur-gtk-theme/release/WhiteSur-$v.tar.xz" -C "$themes"
        # GNOME Shell a Cinnamon casti LuxOS nepotrebuje
        rm -rf "$themes/WhiteSur-$v"/{gnome-shell,cinnamon}
        # Vlastni upravy LuxOS (nabidky ve stylu macOS)
        install -m644 "$startdir/files/luxos-gtk3.css" "$themes/WhiteSur-$v/gtk-3.0/luxos.css"
        local css
        for css in "$themes/WhiteSur-$v"/gtk-3.0/gtk{,-dark}.css; do
            [[ -e $css ]] && printf '\n@import url("luxos.css");\n' >>"$css"
        done
        ln -s "../../themes/WhiteSur-$v/plank" "$pkgdir/usr/share/plank/themes/WhiteSur-$v"
        # Oznameni (xfce4-notifyd, tema = tema GTK, nastavuje luxos-appearance)
        install -Dm644 "$startdir/files/notify/$v.css" "$themes/WhiteSur-$v/xfce-notify-4.0/gtk.css"
    done

    # Ikony: WhiteSur, WhiteSur-light, WhiteSur-dark
    # -a: prekreslene alternativy misto napodobenin ikon Applu (Finder, App Store, Nastaveni...)
    # install.sh vola gtk-update-icon-cache; cache vytvori hook spravce baliku az na cilovem systemu
    mkdir -p "$srcdir/stub"
    printf '#!/bin/sh\nexit 0\n' > "$srcdir/stub/gtk-update-icon-cache"
    chmod +x "$srcdir/stub/gtk-update-icon-cache"
    cd "$srcdir/WhiteSur-icon-theme"
    PATH="$srcdir/stub:$PATH" ./install.sh -d "$icons" -n WhiteSur -t default -a >/dev/null
    rm -f "$icons"/WhiteSur*/icon-theme.cache
    # preferences/32 obsahuje zjednodusene ikony se stejnymi nazvy jako aplikace; v docku
    # by se v klidu ukazovaly ony a pri zvetseni macOS verze z apps/scalable
    local f
    for f in "$icons"/WhiteSur/apps/scalable/*; do
        rm -f "$icons"/WhiteSur/preferences{,@2x}/32/"${f##*/}"
    done
    # Logo Applu (start-here*) nahradit logem LuxOS
    while IFS= read -r -d '' f; do
        rm -f "$f"
        if [[ $f == *symbolic* ]]; then
            ln -s /usr/share/luxos/logo/luxos-logo-symbolic.svg "$f"
        else
            ln -s /usr/share/luxos/logo/luxos-logo.svg "$f"
        fi
    done < <(find "$icons" -name 'start-here*.svg' -print0)
    # Vlastni ikony LuxOS (luxos-branding) pro zakladni aplikace a kategorie nabidky
    local name target
    for name in org.xfce.thunar:luxos-files org.xfce.settings.manager:luxos-settings \
                org.xfce.mousepad:luxos-notes org.xfce.ristretto:luxos-image-viewer \
                io.github.celluloid_player.Celluloid:luxos-videos org.xfce.webbrowser:luxos-web-browser \
                applications-internet:luxos-internet applications-system:luxos-system \
                applications-accessories:luxos-accessories applications-other:luxos-all-apps; do
        target=${name#*:} name=${name%%:*}
        find "$icons"/WhiteSur* \( -name "$name.svg" -o -name "$name.png" \) -delete
        ln -s "/usr/share/icons/hicolor/256x256/apps/$target.png" "$icons/WhiteSur/apps/scalable/$name.png"
    done

    # Kurzory
    cp -a "$srcdir/WhiteSur-cursors/dist" "$icons/WhiteSur-cursors"

    install -Dm644 "$srcdir/WhiteSur-gtk-theme/COPYING" "$pkgdir/usr/share/licenses/$pkgname/WhiteSur-gtk-theme.COPYING"
    install -Dm644 "$srcdir/WhiteSur-icon-theme/COPYING" "$pkgdir/usr/share/licenses/$pkgname/WhiteSur-icon-theme.COPYING"
    install -Dm644 "$srcdir/WhiteSur-cursors/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/WhiteSur-cursors.LICENSE"
}
