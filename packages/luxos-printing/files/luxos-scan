    def show_state(self, state, details=""):
        texts = {
            "looking": ("scanner", _("Looking for scanners…"), ""),
            "none": ("scanner", _("No scanner found"),
                     _("Turn the scanner on and connect it with a USB cable or to the same Wi‑Fi network "
                       "as this computer. It appears here by itself as soon as LuxOS finds it.")),
            "missing": ("dialog-warning-symbolic", _("Scanning support is not installed"),
                        _("Install the luxos-printing package from the Store.")),
            "error": ("dialog-warning-symbolic", _("Scanners could not be found"),
                      _("Something went wrong while looking for scanners. Try again in a moment.")),
        }
        icon, title, hint = texts.get(state, texts["error"])
        self.st_icon.set_from_icon_name(icon, Gtk.IconSize.DIALOG)
        self.st_icon.set_pixel_size(72)
        looking = state == "looking"
        self.st_spin.set_visible(looking)
        (self.st_spin.start if looking else self.st_spin.stop)()
        self.st_title.set_text(title)
        self.st_hint.set_text(hint)
        self.st_hint.set_visible(bool(hint))
        self.st_retry.set_visible(not looking)
        self.st_details_lab.set_text(details or "")
        self.st_details.set_visible(bool(details))
        self.stack.set_visible_child_name("state")
        self.dev_combo.hide()
        if state == "none" and not self.rescan_id:
            self.rescan_id = GLib.timeout_add_seconds(RESCAN_SECONDS, self.auto_rescan)

    def auto_rescan(self):
        """Bez skeneru se kazdych par sekund hleda znovu (bez prepnuti na "Hledam…")."""
        if self.stack.get_visible_child_name() != "state" or self.devices:
            self.rescan_id = 0
            return False
        if self.rescanning:
            return True
        self.rescanning = True

        def done(res):
            self.rescanning = False
            if self.rescan_id and isinstance(res, list) and res:
                self.apply_devices(res)
        in_thread(ls.list_devices, done)
        return True

