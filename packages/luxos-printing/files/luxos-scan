    def segmented(self, parent, items, active, cb):
        box = cls(Gtk.Box(homogeneous=True), "linked", "seg")
        btns, first = {}, None
        for key, text in items:
            b = Gtk.RadioButton(label=text, group=first, draw_indicator=False)
            first = first or b
            btns[key] = b
            box.pack_start(b, True, True, 0)
        btns.get(active, first).set_active(True)
        for b in btns.values():
            b.connect("toggled", lambda b: b.get_active() and cb(b))
        parent.pack_start(box, False, False, 0)
        return btns

    # ---- skenery ----
    def find_devices(self):
        self.show_state("looking")
        in_thread(ls.list_devices, self.apply_devices)

    def apply_devices(self, res):
        if isinstance(res, OSError):
            self.show_state("missing", str(res))
            return
        if isinstance(res, Exception):
            self.show_state("error", str(res))
            return
        if self.rescan_id:
            GLib.source_remove(self.rescan_id)
            self.rescan_id = 0
        devs = list(res)
        if self.want_device and not any(d["id"] == self.want_device for d in devs):
            # zarizeni z Tiskaren a skeneru, ktere se ted v seznamu neukazalo - zkusit primo
            devs.insert(0, {"id": self.want_device, "name": _("Scanner"), "type": "", "conn": ""})
        self.devices = devs
        if not devs:
            self.show_state("none")
            return
        self.dev_combo.handler_block(self.dev_handler)
        self.dev_combo.remove_all()
        for d in devs:
            self.dev_combo.append(d["id"], d["name"])
        want = self.want_device or self.cfg.get("device")
        pick = next((d for d in devs if d["id"] == want), devs[0])
        self.dev_combo.set_active_id(pick["id"])
        self.dev_combo.handler_unblock(self.dev_handler)
        self.dev_combo.set_visible(len(devs) > 1)
        self.stack.set_visible_child_name("main")
        self.select_device(pick)

    def on_device_changed(self, combo):
        d = next((d for d in self.devices if d["id"] == combo.get_active_id()), None)
        if d and not self.scan:
            self.select_device(d)

    def select_device(self, dev):
        self.dev = dev
        self.opts = {}
        self.dev_title.set_text(dev["name"])
        self.dev_sub.set_text(conn_text(dev))
        self.hide_problem()
        self.msg.set_text(_("Getting the scanner ready…"))
        self.probing = True
        self.update_ui()
        did = dev["id"]

        def done(res):
            if not self.dev or self.dev["id"] != did:
                return
            self.probing = False
            if isinstance(res, ls.ScanError):
                self.opts = {}
                self.show_problem(res.kind, res.details)
                self.msg.set_text("")
            elif isinstance(res, Exception):
                self.opts = {}
                self.show_problem("unknown", str(res))
                self.msg.set_text("")
            else:
                self.opts = res
                self.msg.set_text(_("Place the document on the scanner and click Scan."))
            self.fill_sources()
            self.update_ui()
        in_thread(lambda: ls.probe_options(did), done)

    def fill_sources(self):
        self.source.remove_all()
        srcs = ls.sources(self.opts)
        for value, kind in srcs:
            self.source.append(value, source_text(value, kind))
        cur = (self.opts.get("source") or ([], None))[1]
        if srcs:
            self.source.set_active_id(cur if cur in [v for v, _k in srcs] else srcs[0][0])
        self.src_title.set_visible(bool(srcs))
        self.source.set_visible(bool(srcs))

    # ---- volby ----
    def kind(self):
        return "photo" if self.kind_btns["photo"].get_active() else "document"

    def color(self):
        return self.color_btns["color"].get_active()

    def source_kind(self):
        v = self.source.get_active_id() if self.source.get_visible() else None
        return v, (ls.source_kind(v) if v else None)

    def on_option(self, _w):
        self.remember()
        self.update_ui()

    def remember(self):
        self.cfg.update(kind=self.kind(), color="color" if self.color() else "bw", format=self.fmt.get_active_id())
        if self.dev:
            self.cfg["device"] = self.dev["id"]
        save_config(self.cfg)

    # ---- skenovani ----
    def start_scan(self):
        if not self.dev or self.scan or self.probing:
            return
        src, skind = self.source_kind()
        args, dpi, whiten = ls.scan_settings(self.opts, self.kind(), self.color(), src)
        batch = skind in ("adf", "duplex")
        scan = ls.Scan(self.dev["id"], args, self.tmp, batch=batch, start=self.counter)
        self.scan = scan
        self.hide_problem()
        self.saved.hide()
        self.progress.set_fraction(0)
        self.msg.set_text(_("Scanning…"))
        self.update_ui()
        pulse = [GLib.timeout_add(250, self.pulse)]

        def progress(f):
            GLib.idle_add(lambda: self.set_progress(f) and False)

        def work():
            files = scan.run(progress)
            return [dict(path=f, dpi=dpi, **dict(zip(("preview", "thumb"), load_page(f, whiten))))
                    for f in files]

        def done(res):
            GLib.source_remove(pulse[0])
            self.scan = None
            self.progress.set_fraction(0)
            if isinstance(res, ls.ScanError):
                self.msg.set_text("")
                if res.kind == "cancelled":
                    self.msg.set_text(_("Scanning was cancelled."))
                else:
                    self.show_problem(res.kind, res.details)
            elif isinstance(res, Exception):
                self.msg.set_text("")
                self.show_problem("unknown", str(res))
            else:
                self.counter = max([self.counter] + [int(os.path.basename(p["path"])[5:8]) + 1 for p in res])
                self.pages.extend(res)
                self.sel = len(self.pages) - 1
                self.dirty = True
                self.saved_files = []
                self.rebuild_strip()
                self.show_count()
            self.update_ui()
        in_thread(work, done)

    def pulse(self):
        # Nektere skenery (eSCL) hlasi prubeh az na konci - do te doby pulzovani
        if self.progress.get_fraction() == 0:
            self.progress.pulse()
        return True

    def set_progress(self, f):
        if f > 0:
            self.progress.set_fraction(f)
        return False

    def cancel_scan(self):
        scan = self.scan
        if not scan:
            return
        scan.cancel()
        self.msg.set_text(_("Cancelling…"))
        self.cancel_btn.set_sensitive(False)
        # Backend, ktery na SIGTERM nereaguje, se po 8 s ukonci natvrdo
        GLib.timeout_add_seconds(8, lambda: scan.kill() and False)

    # ---- problem ----
    def show_problem(self, kind, details=""):
        title, hint = ls.error_message(kind)
        self.problem_title.set_text(_(title))
        self.problem_hint.set_text(_(hint) if hint else "")
        self.problem_hint.set_visible(bool(hint))
        self.problem_details_lab.set_text(details or "")
        self.problem_details.set_expanded(False)
        self.problem_details.set_visible(bool(details))
        self.problem.show()

    def hide_problem(self):
        self.problem.hide()

    # ---- stranky ----
    def rebuild_strip(self):
        for c in self.strip.get_children():
            if c is not self.strip_hint:
                self.strip.remove(c)
        for i, p in enumerate(self.pages):
            b = cls(Gtk.Button(relief=Gtk.ReliefStyle.NONE), "page-btn")
            if i == self.sel:
                cls(b, "selected")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            img = Gtk.Image.new_from_pixbuf(p["thumb"])
            img.set_size_request(THUMB_W, THUMB_H)
            box.pack_start(img, False, False, 0)
            box.pack_start(cls(Gtk.Label(label=str(i + 1)), "page-num"), False, False, 0)
            b.add(box)
            b.set_tooltip_text(_("Page %d") % (i + 1))
            b.connect("clicked", lambda _b, n=i: self.select_page(n))
            self.strip.pack_start(b, False, False, 0)
        self.strip.show_all()
        self.strip_hint.set_visible(not self.pages)
        self.area.queue_draw()
        self.update_ui()

    def select_page(self, n):
        self.sel = n
        self.rebuild_strip()

    def move_page(self, d):
        i, j = self.sel, self.sel + d
        if 0 <= i < len(self.pages) and 0 <= j < len(self.pages):
            self.pages[i], self.pages[j] = self.pages[j], self.pages[i]
            self.sel = j
            self.dirty = True
            self.rebuild_strip()

    def remove_page(self, n):
        if not 0 <= n < len(self.pages):
            return
        p = self.pages.pop(n)
        try:
            os.unlink(p["path"])
        except OSError:
            pass
        self.sel = min(n, len(self.pages) - 1)
        self.dirty = bool(self.pages)
        self.rebuild_strip()
        self.show_count()

    def show_count(self):
        n = len(self.pages)
        if not n:
            self.msg.set_text(_("Place the document on the scanner and click Scan."))
        else:
            self.msg.set_text(_("1 page scanned.") if n == 1 else _("%d pages scanned.") % n)

    def clear_pages(self):
        for p in self.pages:
            try:
                os.unlink(p["path"])
            except OSError:
                pass
        self.pages, self.sel, self.dirty, self.saved_files = [], -1, False, []
        self.saved.hide()
        self.rebuild_strip()
        self.show_count()

    # ---- stav tlacitek ----
    def update_ui(self):
        scanning = self.scan is not None
        idle = not scanning and not self.saving
        has = bool(self.pages)
        self.scan_btn.set_visible(not scanning)
        self.cancel_btn.set_visible(scanning)
        self.cancel_btn.set_sensitive(True)
        self.progress.set_visible(scanning)
        self.scan_btn.set_sensitive(bool(self.dev) and idle and not self.probing)
        _src, skind = self.source_kind()
        if skind in ("adf", "duplex"):
            self.scan_btn.set_label(_("Scan More Pages") if has else _("Scan All Pages"))
        else:
            self.scan_btn.set_label(_("Scan Another Page") if has else _("Scan"))
        for w in list(self.kind_btns.values()) + list(self.color_btns.values()) + [self.source]:
            w.set_sensitive(idle)
        self.dev_combo.set_sensitive(idle)
        self.save_btn.set_sensitive(has and idle)
        self.print_btn.set_sensitive(has and idle)
        self.fmt.set_sensitive(has and idle)
        self.left_btn.set_sensitive(idle and self.sel > 0)
        self.right_btn.set_sensitive(idle and 0 <= self.sel < len(self.pages) - 1)
        self.del_btn.set_sensitive(idle and 0 <= self.sel < len(self.pages))
        k = self.kind()
        dpi = ls.scan_settings(self.opts, k, self.color())[1]
        self.settings_hint.set_text((_("For letters, forms and receipts.") if k == "document"
                                     else _("For photos and pictures, in more detail.")) + f" {dpi} dpi")

    # ---- nahled ----
    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        pb = self.pages[self.sel]["preview"] if 0 <= self.sel < len(self.pages) else None
        ratio = pb.get_width() / pb.get_height() if pb else 210 / 297
        ph = H - 48
        pw = ph * ratio
        if pw > W - 48:
            pw = W - 48
            ph = pw / ratio
        if pw < 10 or ph < 10:
            return
        x, y = (W - pw) / 2, (H - ph) / 2
        for i, a in enumerate((0.05, 0.05, 0.06)):
            cr.set_source_rgba(0, 0, 0, a)
            cr.rectangle(x - i, y + 2 + i, pw + 2 * i, ph + i)
            cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.rectangle(x, y, pw, ph)
        cr.fill()
        if pb:
            s = pb.scale_simple(max(1, int(pw)), max(1, int(ph)), GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, s, x, y)
            cr.paint()
            return
        text = _("Place the document face down on the scanner glass, then click Scan.")
        layout = w.create_pango_layout(text)
        layout.set_width(int(max(40, min(pw - 40, 240)) * Pango.SCALE))
        layout.set_wrap(Pango.WrapMode.WORD)
        layout.set_alignment(Pango.Alignment.CENTER)
        tw, th = layout.get_pixel_size()
        cr.set_source_rgba(0, 0, 0, 0.42)
        cr.move_to((W - tw) / 2, (H - th) / 2)
        PangoCairo.show_layout(cr, layout)

    # ---- ulozeni, tisk ----
    def save(self):
        if not self.pages or self.saving:
            return
        fmt = self.fmt.get_active_id() or "pdf"
        folder = ls.documents_dir(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS),
                                  GLib.get_home_dir())
        base = ls.base_name(_("Scan %s"))
        pages = [dict(path=p["path"], dpi=p["dpi"]) for p in self.pages]
        photo = self.kind() == "photo"
        self.hide_problem()
        self.saving = True
        self.msg.set_text(_("Saving…"))
        self.update_ui()

        def done(res):
            self.saving = False
            if isinstance(res, Exception):
                self.msg.set_text("")
                kind = "memory" if isinstance(res, OSError) and res.errno == 28 else None
                if kind:
                    self.show_problem(kind, str(res))
                else:
                    self.problem_title.set_text(_("The scan could not be saved"))
                    self.problem_hint.set_text(_("Check that there is enough free space in your Documents folder."))
                    self.problem_hint.show()
                    self.problem_details_lab.set_text(str(res))
                    self.problem_details.show()
                    self.problem.show()
            else:
                self.saved_files = res
                self.dirty = False
                where = os.path.basename(folder) or folder
                if len(res) == 1:
                    self.saved_lab.set_text(_("Saved “%s” in %s") % (os.path.basename(res[0]), where))
                else:
                    self.saved_lab.set_text(_("Saved %d pictures in %s") % (len(res), where))
                self.saved.show_all()
                self.msg.set_text("")
            self.update_ui()
        in_thread(lambda: save_pages(pages, fmt, folder, base, photo), done)

    def print_pages(self):
        if not self.pages:
            return
        pages = [dict(path=p["path"], dpi=p["dpi"]) for p in self.pages]
        op = Gtk.PrintOperation(n_pages=len(pages), unit=Gtk.Unit.POINTS, embed_page_setup=True)
        op.set_job_name(ls.base_name(_("Scan %s")))

        def draw(_op, ctx, n):
            p = pages[n]
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(p["path"])
            except GLib.Error:
                return
            cr = ctx.get_cairo_context()
            iw, ih = pb.get_width() * 72 / p["dpi"], pb.get_height() * 72 / p["dpi"]
            cw, ch = ctx.get_width(), ctx.get_height()
            s = min(cw / iw, ch / ih, 1.0)        # zmensit, aby se veslo; nezvetsovat
            cr.translate((cw - iw * s) / 2, (ch - ih * s) / 2)
            cr.scale(s * 72 / p["dpi"], s * 72 / p["dpi"])
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
        op.connect("draw-page", draw)
        try:
            op.run(Gtk.PrintOperationAction.PRINT_DIALOG, self)
        except GLib.Error as e:
            self.problem_title.set_text(_("The scan could not be printed"))
            self.problem_hint.hide()
            self.problem_details_lab.set_text(e.message)
            self.problem_details.show()
            self.problem.show()

    def open_path(self, path):
        try:
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(path), None)
        except GLib.Error:
            subprocess.Popen(["xdg-open", path], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def show_in_files(self, path):
        """Soubor oznaceny ve Spravci souboru (org.freedesktop.FileManager1), jinak jen slozka."""
        def done(bus, res):
            try:
                bus.call_finish(res)
            except GLib.Error:
                self.open_path(os.path.dirname(path))
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
            bus.call("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                     "org.freedesktop.FileManager1", "ShowItems",
                     GLib.Variant("(ass)", ([GLib.filename_to_uri(path)], "")), None, 0, 5000, None, done)
        except GLib.Error:
            self.open_path(os.path.dirname(path))

    # ---- klavesy, zavreni ----
    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape and self.scan:
            self.cancel_scan()
            return True
        if ev.keyval == Gdk.KEY_Delete and self.pages and not self.scan and not self.saving:
            self.remove_page(self.sel)
            return True
        return False

    def on_close(self, *_a):
        if self.dirty and self.pages:
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                    buttons=Gtk.ButtonsType.NONE,
                                    text=_("Close without saving the scanned pages?"))
            dlg.format_secondary_text(_("The pages you scanned have not been saved yet."))
            dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
            cls(dlg.add_button(_("Close Without Saving"), Gtk.ResponseType.CLOSE), "destructive-action")
            r = dlg.run()
            dlg.destroy()
            if r != Gtk.ResponseType.CLOSE:
                return True
        if self.scan:
            self.scan.cancel()
            proc = self.scan.proc
            if proc:
                try:
                    proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    self.scan.kill()
        shutil.rmtree(self.tmp, ignore_errors=True)
        return False


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__.strip())
        return 0
    dev = None
    if "--device" in sys.argv:
        i = sys.argv.index("--device")
        dev = sys.argv[i + 1] if i + 1 < len(sys.argv) else None
    GLib.set_prgname(APP)
    GLib.set_application_name(_("Scanner"))
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = ScanWindow(dev)
    win.connect("destroy", Gtk.main_quit)
    win.show()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
