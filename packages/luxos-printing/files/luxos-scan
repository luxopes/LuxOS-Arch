def cls(widget, *names):
    for n in names:
        widget.get_style_context().add_class(n)
    return widget


def label(text="", *classes, **kw):
    kw.setdefault("xalign", 0)
    kw.setdefault("wrap", True)
    return cls(Gtk.Label(label=text, **kw), *classes)


def section(text):
    return label(text.upper(), "section-title")


def in_thread(work, done):
    """work() ve vlakne, done(vysledek nebo vyjimka) v hlavnim vlakne."""
    def wrap():
        try:
            res = work()
        except Exception as e:  # noqa: BLE001 - chyba se ukaze uzivateli
            res = e
        GLib.idle_add(lambda: done(res) and False)
    threading.Thread(target=wrap, daemon=True).start()


def load_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            d = json.load(f)
            return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".tmp", "w", encoding="utf-8") as f:
            json.dump(cfg, f)
        os.replace(CONFIG + ".tmp", CONFIG)
    except OSError:
        pass


def clean_old_cache():
    """Stranky ze spadlych/zabitych relaci starsi nez den pryc."""
    try:
        for n in os.listdir(CACHE):
            p = os.path.join(CACHE, n)
            if os.path.isdir(p) and time.time() - os.path.getmtime(p) > 86400:
                shutil.rmtree(p, ignore_errors=True)
    except OSError:
        pass


def conn_text(dev):
    return {"network": _("Network"), "usb": _("USB")}.get(dev.get("conn"), "")


def source_text(value, kind):
    return {"flatbed": _("Glass (flatbed)"), "adf": _("Document feeder"),
            "duplex": _("Document feeder, both sides")}.get(kind, value)


def load_page(path, whiten):
    """Ve vlakne: uprava cernobileho dokumentu, nahled a miniatura (GdkPixbuf funguje i mimo hlavni vlakno)."""
    if whiten:
        try:
            ls.whiten(path)
        except OSError:
            pass
    preview = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, PREVIEW_MAX, PREVIEW_MAX, True)
    thumb = preview.scale_simple(*fit(preview.get_width(), preview.get_height(), THUMB_W, THUMB_H),
                                 GdkPixbuf.InterpType.BILINEAR)
    return preview, thumb


def fit(w, h, mw, mh):
    s = min(mw / w, mh / h)
    return max(1, int(w * s)), max(1, int(h * s))


def save_pages(pages, fmt, folder, base, photo):
    """Ulozi stranky: jedno PDF, nebo JPEG/PNG po strankach. Vrati seznam souboru."""
    os.makedirs(folder, exist_ok=True)
    quality = "92" if photo else "85"
    if fmt == "pdf":
        data = []
        for p in pages:
            pb = GdkPixbuf.Pixbuf.new_from_file(p["path"])
            ok, buf = pb.save_to_bufferv("jpeg", ["quality"], [quality])
            del pb
            data.append((bytes(buf), p["dpi"]))
        return [ls.write_pdf(ls.unique_path(folder, base, "pdf"), data, title=base)]
    ext = "jpg" if fmt == "jpeg" else "png"
    out = []
    for p, dest in zip(pages, ls.image_paths(folder, base, ext, len(pages))):
        pb = GdkPixbuf.Pixbuf.new_from_file(p["path"])
        keys, vals = (["quality"], [quality]) if fmt == "jpeg" else ([], [])
        tmp = dest + ".part"
        try:
            pb.savev(tmp, fmt, keys + ["x-dpi", "y-dpi"], vals + [str(p["dpi"])] * 2)
        except GLib.Error:
            pb.savev(tmp, fmt, keys, vals)        # starsi gdk-pixbuf bez x-dpi
        os.replace(tmp, dest)
        out.append(dest)
    return out


