class LevelBar(Gtk.DrawingArea):
    def __init__(self, level, color):
        super().__init__()
        self.level, self.color = level, Gdk.RGBA()
        self.color.parse(color)
        self.set_size_request(150, 8)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self.on_draw)

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        fg = self.get_style_context().get_color(Gtk.StateFlags.NORMAL)

        def pill(width):
            r = h / 2
            cr.new_sub_path()
            cr.arc(r, r, r, 1.5708, 4.7124)
            cr.arc(max(width - r, r), r, r, 4.7124, 1.5708)
            cr.close_path()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.12)
        pill(w)
        cr.fill()
        if self.level > 0:
            c = self.color
            dark_theme = fg.red + fg.green + fg.blue > 1.5
            if dark_theme and c.red + c.green + c.blue < 0.6:
                # cerny toner v tmavem rezimu: svetle sedy, jinak by splynul s pozadim
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.8)
            else:
                cr.set_source_rgba(c.red, c.green, c.blue, 1)
            # bila/svetla barva by na svetlem pozadi nebyla videt - obrys
            pill(max(h, w * self.level / 100))
            cr.fill_preserve()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.25)
            cr.set_line_width(1)
            cr.stroke()


