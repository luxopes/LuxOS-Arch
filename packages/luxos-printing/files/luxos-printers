            r.pack_start(t, True, True, 0)
            if d["queue"]:
                r.pack_end(cls(Gtk.Label(label=_("Added")), "dev-sub"), False, False, 0)
            elif not d["supported"]:
                r.pack_end(cls(Gtk.Label(label=_("Not supported")), "dev-sub"), False, False, 0)
            else:
                b = cls(Gtk.Button(label=_("Add"), valign=Gtk.Align.CENTER), "suggested-action")
                b.connect("clicked", self.add, d)
                r.pack_end(b, False, False, 0)
            self.list.add(r)
        self.list.show_all()

    def add(self, b, d):
        b.set_sensitive(False)
        b.set_label(_("Adding…"))

        def done(rc, out, err):
            try:
                res = json.loads(out)
            except ValueError:
                res = {}
            q = res.get("queue")
            if rc == 0 and q:
                self.win.select_key = "p:" + q
                self.win.refresh()
                self.destroy()
            elif res.get("needs") == "aurdriver" and res.get("package"):
                b.set_label(_("Add"))
                b.set_sensitive(True)
                self.win.install_aur_driver(d["name"], res["package"])
            else:
                b.set_label(_("Add"))
                b.set_sensitive(True)
                self.win.error(_("The printer could not be added"),
                               _("Make sure it is turned on and try again.") + ("\n\n" + err if err else ""))
        run_helper(["add", d["key"]], done)


