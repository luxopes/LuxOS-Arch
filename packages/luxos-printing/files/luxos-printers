            js = {3: _("Waiting"), 4: _("On hold"), 5: _("Printing…"), 6: _("Stopped")}.get(j.get("job-state"), "")
            who = j.get("job-originating-user-name") or ""
            t.pack_start(cls(Gtk.Label(label=" · ".join(x for x in (js, who) if x), xalign=0), "dev-sub"),
                         False, False, 0)
            r.pack_start(t, True, True, 0)
            b = Gtk.Button(label=_("Cancel"), valign=Gtk.Align.CENTER)
            b.connect("clicked", lambda _b, i=jid: self.win.cancel_job(i))
            r.pack_end(b, False, False, 0)
            self.jobs.add(r)
        self.show_all()
        self.cancel_all.set_visible(len(jobs) > 1)
