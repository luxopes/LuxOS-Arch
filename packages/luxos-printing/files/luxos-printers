    # -- zarizeni a volby
    def set_device(self, dev):
        if self.dev and dev["id"] == self.dev["id"]:
            return
        self.dev = dev
        self.title.set_text(dev["name"])
        self.sub.set_text(dev["kind"])
        self.opts = {}
        self.preview = None
        self.area.queue_draw()
        self.msg.set_text(_("Checking the scanner…"))
        self.src_title.hide()
        self.source.hide()
        self.busy_ui(True, False)
        did = dev["id"]

        def work():
            r = subprocess.run(["scanimage", "-d", did, "-A"], capture_output=True, text=True, timeout=60)
            return lp.parse_scan_options(r.stdout)

        def done(res):
            self.busy_ui(False)
            if not self.dev or self.dev["id"] != did:
                return
            if isinstance(res, Exception):
                self.msg.set_text(_("The scanner does not respond. Make sure it is turned on."))
                return
            self.opts = res
            self.msg.set_text(_("Place the document on the scanner and click Scan."))
            self.source.remove_all()
            for s in (res.get("source") or ([], None))[0]:
                self.source.append(s, _(s) if s in ("Flatbed", "ADF", "ADF Duplex") else s)
            cur = (res.get("source") or ([], None))[1]
            if cur:
                self.source.set_active_id(cur)
            many = len((res.get("source") or ([], None))[0]) > 1
            self.src_title.set_visible(many)
            self.source.set_visible(many)
            # bez barevneho rezimu (cernobily skener) jen Seda/Dokument
            modes = (res.get("mode") or ([], None))[0]
            self.mode_btns["color"].set_sensitive(not modes or bool(lp.pick_mode(modes, "color")))
        in_thread(work, done)

    def on_mode(self, b):
        if b.get_active():
            self.quality.set_active_id("300")
            self.fmt.set_active_id("pdf")

    def mode_key(self):
        return next(k for k, b in self.mode_btns.items() if b.get_active())

    def scan_args(self, preview):
        a = ["-d", self.dev["id"]]
        modes = (self.opts.get("mode") or ([], None))[0]
        kind = "color" if self.mode_key() == "color" or preview and self.mode_key() != "gray" else "gray"
        m = lp.pick_mode(modes, kind) or lp.pick_mode(modes, "gray")
        if m:
            a += ["--mode", m]
        res = self.opts.get("resolution")
        want = 75 if preview else int(self.quality.get_active_id() or 300)
        dpi = lp.nearest_resolution(res[0] if res else None, want)
        if res:
            a += ["--resolution", str(dpi)]
        src = self.source.get_active_id()
        if src and self.source.get_visible():
            a += ["--source", src]
        return a, dpi

    # -- skenovani
    def busy_ui(self, on, show_progress=True):
        self.busy = on
        self.progress.set_visible(on and show_progress)
        self.progress.set_fraction(0)
        self.cancel_btn.set_visible(on and show_progress)
        self.scan_btn.set_visible(not (on and show_progress))
        self.prev_btn.set_visible(not (on and show_progress))
        self.update_buttons()

    def update_buttons(self):
        ok = bool(self.dev) and not self.busy
        self.scan_btn.set_sensitive(ok)
        self.prev_btn.set_sensitive(ok)
        self.save_btn.set_sensitive(bool(self.pages) and not self.busy)
        self.fmt.set_sensitive(bool(self.pages))

    def scan(self, preview=False):
        if not self.dev or self.busy:
            return
        args, dpi = self.scan_args(preview)
        out = os.path.join(self.tmp, "preview.pnm" if preview else f"page-{len(os.listdir(self.tmp)):03d}.pnm")
        doc = self.mode_key() == "document" and not preview
        self.busy_ui(True)
        self.msg.set_text(_("Scanning…"))
        self.saved.hide()

        def progress(f):
            self.progress.set_fraction(f)
            return False

        def done(ok, err):
            if ok and doc:
                try:
                    document_filter(out)
                except (OSError, AttributeError, IndexError):
                    pass
            self.busy_ui(False)
            if not ok:
                if self.scanner.cancelled:
                    self.msg.set_text(_("Scanning was cancelled."))
                else:
                    self.msg.set_text(_("Scanning failed: %s") % (err or _("the scanner does not respond")))
                return False
            try:
                self.preview = GdkPixbuf.Pixbuf.new_from_file(out)
            except GLib.Error as e:
                self.msg.set_text(_("Scanning failed: %s") % e.message)
                return False
            self.area.queue_draw()
            if preview:
                self.msg.set_text(_("This is a preview. Click Scan when the document looks right."))
            else:
                self.add_page(out, dpi)
                self.msg.set_text(_("Page %d scanned. Scan another page or save.") % len(self.pages))
            return False
        self.scanner.run(args, out, progress, done)

    def add_page(self, path, dpi):
        self.pages.append((path, dpi))
        self.rebuild_strip()

    def rebuild_strip(self):
        for c in self.strip.get_children():
            if c is not self.strip_hint:
                self.strip.remove(c)
        self.strip_hint.set_visible(not self.pages)
        for i, (path, _dpi) in enumerate(self.pages):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            ov = Gtk.Overlay()
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 70, 86, True)
                img = cls(Gtk.Image.new_from_pixbuf(pb), "thumb")
            except GLib.Error:
                img = Gtk.Image.new_from_icon_name("image-missing", Gtk.IconSize.DIALOG)
            ov.add(img)
            x = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.MENU)
            x.set_tooltip_text(_("Remove page"))
            x.set_halign(Gtk.Align.END)
            x.set_valign(Gtk.Align.START)
            x.connect("clicked", lambda _b, n=i: self.remove_page(n))
            ov.add_overlay(x)
            box.pack_start(ov, False, False, 0)
            box.pack_start(cls(Gtk.Label(label=_("Page %d") % (i + 1)), "dev-sub"), False, False, 0)
            self.strip.pack_start(box, False, False, 0)
        self.strip.show_all()
        self.strip_hint.set_visible(not self.pages)
        self.update_buttons()

    def remove_page(self, n):
        path = self.pages.pop(n)[0]
        try:
            os.unlink(path)
        except OSError:
            pass
        self.rebuild_strip()

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        # list A4 (nebo pomer nahledu) uprostred
        ratio = (self.preview.get_width() / self.preview.get_height()) if self.preview else 210 / 297
        ph = H - 16
        pw = ph * ratio
        if pw > W - 16:
            pw = W - 16
            ph = pw / ratio
        x, y = (W - pw) / 2, (H - ph) / 2
        cr.set_source_rgba(0, 0, 0, 0.18)
        cr.rectangle(x + 2, y + 3, pw, ph)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.rectangle(x, y, pw, ph)
        cr.fill()
        if self.preview:
            pb = self.preview.scale_simple(max(1, int(pw)), max(1, int(ph)), GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, pb, x, y)
            cr.paint()
        else:
            layout = w.create_pango_layout(_("Click Preview to see the document here"))
            layout.set_width(int(min(pw - 40, 220) * Pango.SCALE))
            layout.set_wrap(Pango.WrapMode.WORD)
            layout.set_alignment(Pango.Alignment.CENTER)
            tw, th = layout.get_pixel_size()
            cr.set_source_rgba(0, 0, 0, 0.4)
            cr.move_to((W - tw) / 2, (H - th) / 2)
            PangoCairo.show_layout(cr, layout)

    # -- ulozeni
    def target(self, fmt):
        kind = GLib.UserDirectory.DIRECTORY_DOCUMENTS if fmt == "pdf" else GLib.UserDirectory.DIRECTORY_PICTURES
        d = GLib.get_user_special_dir(kind) or os.path.join(GLib.get_home_dir(),
                                                            "Documents" if fmt == "pdf" else "Pictures")
        os.makedirs(d, exist_ok=True)
        base = _("Scan") + " " + datetime.datetime.now().strftime("%Y-%m-%d %H.%M.%S")
        return d, base

    def on_save(self, _b):
        fmt = self.fmt.get_active_id()
        pages = list(self.pages)
        d, base = self.target(fmt)
        self.busy_ui(True, False)
        self.msg.set_text(_("Saving…"))

        def work():
            return save_pages(pages, fmt, d, base)

        def done(res):
            self.busy_ui(False)
            if isinstance(res, Exception):
                self.msg.set_text(_("Could not save the scan: %s") % res)
                return
            self.saved_files = res
            folder = os.path.basename(d)
            if len(res) == 1:
                self.saved_lab.set_text(_("Saved “%s” in %s") % (os.path.basename(res[0]), folder))
            else:
                self.saved_lab.set_text(_("Saved %d pictures in %s") % (len(res), folder))
            self.saved.set_no_show_all(False)
            self.saved.show_all()
            for path, _dpi in self.pages:
                try:
                    os.unlink(path)
                except OSError:
                    pass
            self.pages = []
            self.rebuild_strip()
            self.msg.set_text(_("Place the next document on the scanner and click Scan."))
        in_thread(work, done)

    def open_path(self, path):
        try:
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(path), None)
        except GLib.Error:
            subprocess.Popen(["xdg-open", path], start_new_session=True)

    def show_in_folder(self, path):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
            bus.call_sync("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                          "org.freedesktop.FileManager1", "ShowItems",
                          GLib.Variant("(ass)", ([GLib.filename_to_uri(path)], "")), None, 0, 3000, None)
        except GLib.Error:
            self.open_path(os.path.dirname(path))


def save_pages(pages, fmt, folder, base):
    """Ulozi stranky (pnm) jako jedno PDF nebo JPEG po strankach, vrati seznam souboru."""
    def unique(name, ext):
        p = os.path.join(folder, f"{name}.{ext}")
        i = 2
        while os.path.exists(p):
            p = os.path.join(folder, f"{name} ({i}).{ext}")
            i += 1
        return p

    if fmt == "jpeg":
        out = []
        for i, (path, dpi) in enumerate(pages):
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
            name = base if len(pages) == 1 else f"{base} - {i + 1}"
            dest = unique(name, "jpg")
            pb.savev(dest, "jpeg", ["quality", "x-dpi", "y-dpi"], ["90", str(dpi), str(dpi)])
            out.append(dest)
        return out
    dest = unique(base, "pdf")
    tmp = dest + ".part"
    surf = None
    try:
        for path, dpi in pages:
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
            w_pt, h_pt = pb.get_width() * 72 / dpi, pb.get_height() * 72 / dpi
            if surf is None:
                surf = cairo.PDFSurface(tmp, w_pt, h_pt)
                surf.set_metadata(cairo.PDFMetadata.TITLE, base)
                surf.set_metadata(cairo.PDFMetadata.CREATOR, "LuxOS Printers & Scanners")
                cr = cairo.Context(surf)
            else:
                surf.set_size(w_pt, h_pt)
            ok, jpeg = pb.save_to_bufferv("jpeg", ["quality"], ["85"])
            img = cairo.ImageSurface(cairo.FORMAT_RGB24, pb.get_width(), pb.get_height())
            c2 = cairo.Context(img)
            Gdk.cairo_set_source_pixbuf(c2, pb, 0, 0)
            c2.paint()
            del c2
            # stranka v PDF jako JPEG (male soubory), ne jako nekomprimovany obrazek
            img.set_mime_data(cairo.MIME_TYPE_JPEG, bytes(jpeg))
            cr.save()
            cr.scale(72 / dpi, 72 / dpi)
            cr.set_source_surface(img, 0, 0)
            cr.paint()
            cr.restore()
            cr.show_page()
            del img
        surf.finish()
        os.replace(tmp, dest)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    return [dest]


def list_scanners():
    """[{id, name, kind}] ze `scanimage -L`; stejny skener pres vic backendu jen jednou."""
    r = subprocess.run(["scanimage", "-f", "%d\t%v\t%m\t%t%n"], capture_output=True, text=True, timeout=90)
    best = {}
    for line in r.stdout.splitlines():
        f = line.split("\t")
        if len(f) < 4:
            continue
        dev, vendor, model, typ = f[:4]
        if lp.is_camera(dev, typ):
            continue                    # kamera notebooku (v4l) neni skener
        name = model if model.lower().startswith(vendor.lower()) else f"{vendor} {model}".strip()
        name = lp.friendly_name(name)
        prio = 0 if dev.startswith("airscan:e") else 2 if dev.startswith("airscan:w") else 1
        conn = _("Network") if dev.startswith("airscan:") else _("USB") if "usb" in dev.lower() or \
            "libusb" in dev else ""
        if dev.startswith("airscan:") and ("localhost" in dev.lower() or "usb" in name.lower()):
            conn = _("USB")
        kind = " · ".join(x for x in (_(typ.strip().capitalize()) if typ else "", conn) if x)
        k = name.lower()
        if k not in best or prio < best[k][0]:
            best[k] = (prio, {"id": dev, "name": name, "kind": kind})
    return [v[1] for v in sorted(best.values(), key=lambda v: v[1]["name"].lower())]


