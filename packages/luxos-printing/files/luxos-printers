        for c in self.jobs.get_children():
            self.jobs.remove(c)
        self.job_ids = []
        for j in jobs:
            jid = j.get("job-id")
            self.job_ids.append(jid)
            r = Gtk.Box(spacing=12)
            r.pack_start(Gtk.Image.new_from_icon_name("text-x-generic", Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
