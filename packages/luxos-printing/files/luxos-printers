    def show_printer(self, name, data, live):
        p = data["printers"][name]
        jobs = [j for j in data["jobs"].values() if (j.get("job-printer-uri") or "").rstrip("/").endswith("/" + name)]
        jobs.sort(key=lambda j: j.get("job-id", 0))
        mk = []
        if live and live.get("printer-supply"):
            mk = lp.parse_printer_supply(live["printer-supply"], live.get("printer-supply-description") or [])
        if not mk and live and live.get("marker-levels"):
            mk = markers_of(live)
        if not mk:
            mk = markers_of(data["markers"].get(name, {}))
        status, state = printer_status(p, live, jobs)
        sig = (name, repr(sorted(p.items())), repr(jobs), repr(mk), status, data["default"])
        if sig == self.sig:
            return
        self.sig = sig
        if self.name != name:
            self.note.set_text("")
        self.name = name
        self.title.set_text(p.get("printer-info") or name)
        uri = p.get("device-uri") or ""
        conn = _("USB") if (p.get("printer-location") == "USB" or uri.startswith("usb:")) else _("Network")
        model = p.get("printer-make-and-model") or ""
        self.model.set_text(" · ".join(x for x in (model, conn) if x))
        self.dot.set_state(state)
        self.status.set_text(status)
        self.resume_btn.set_visible(p.get("printer-state") == 5 or not p.get("printer-is-accepting-jobs", True))
        self.default_sw.handler_block(self.default_h)
        self.default_sw.set_active(data["default"] == name)
        self.default_sw.set_sensitive(data["default"] != name)
        self.default_sw.handler_unblock(self.default_h)

