class Scanner:
    """Jedno skenovani pres scanimage ve vlakne; prubeh a vysledek v hlavnim vlakne."""

    def __init__(self):
        self.proc = None
        self.cancelled = False

    def run(self, args, out, progress, done):
        self.cancelled = False

        def work():
            cmd = ["scanimage", *args, "--format=pnm", "-p", "-o", out]
            try:
                self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            except OSError as e:
                GLib.idle_add(done, False, str(e))
                return
            buf, err = b"", b""
            while True:
                ch = self.proc.stderr.read(64)
                if not ch:
                    break
                buf = (buf + ch)[-256:]
                err = (err + ch)[-2048:]
                m = re.findall(rb"Progress: ([\d.]+)%", buf)
                if m:
                    GLib.idle_add(progress, float(m[-1]) / 100)
            rc = self.proc.wait()
            self.proc = None
            lines = re.sub(r"Progress: [\d.]+%\s*", "", err.decode(errors="replace")).strip().splitlines()
            ok = rc == 0 and os.path.exists(out) and os.path.getsize(out) > 0 and not self.cancelled
            # "scanimage: sane_read: Document feeder jammed" -> "Document feeder jammed"
            msg = re.sub(r"^scanimage: (sane_\w+: )?", "", lines[-1]) if lines else ""
            GLib.idle_add(done, ok, "" if self.cancelled else msg)
        threading.Thread(target=work, daemon=True).start()

    def cancel(self):
        self.cancelled = True
        if self.proc:
            self.proc.terminate()


def read_pnm(path):
    """(hlavicka, data) PNM P5/P6 ze scanimage (8 bit)."""
    with open(path, "rb") as f:
        raw = f.read()
    tokens, pos = [], 0
    while len(tokens) < 4:
        m = re.compile(rb"\s*(#[^\n]*\n\s*)*(\S+)").match(raw, pos)
        tokens.append(m.group(2))
        pos = m.end()
    return raw[:pos + 1], raw[pos + 1:], tokens


def document_filter(path):
    """Rezim Dokument: bile pozadi, syte cerne pismo (prosta krivka urovni, rychle pres bytes.translate)."""
    head, data, tokens = read_pnm(path)
    if tokens[3] != b"255":
        return
    lo, hi = 60, 205
    table = bytes(0 if v <= lo else 255 if v >= hi else int((v - lo) * 255 / (hi - lo)) for v in range(256))
    with open(path, "wb") as f:
        f.write(head + data.translate(table))


