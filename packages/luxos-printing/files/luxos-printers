class Cups:
    """Cteni stavu z CUPS (pycups). Bezi ve vlakne, kazde vlakno ma vlastni spojeni."""

    def snapshot(self):
        if cups is None:
            raise RuntimeError(_("Printing support is not installed."))
        c = cups.Connection()
        printers = c.getPrinters()
        try:
            default = c.getDefault()
        except cups.IPPError:
            default = None
        jobs = c.getJobs(which_jobs="not-completed", requested_attributes=[
            "job-id", "job-name", "job-printer-uri", "job-state", "job-originating-user-name",
            "job-media-sheets-completed", "time-at-creation"])
        for jid, j in jobs.items():
            j["job-id"] = jid           # pycups vraci ID jako klic, ne jako atribut
        markers = {}
        for name in printers:
            try:
                a = c.getPrinterAttributes(name, requested_attributes=[
                    "marker-names", "marker-levels", "marker-colors", "marker-types"])
                markers[name] = a
            except cups.IPPError:
                pass
        # Nazvy uloh: CUPS je pres neovereny IPP dotaz skryva, lpq je ukaze aspon u vlastnich uloh
        try:
            r = subprocess.run(["lpq", "-a"], capture_output=True, text=True, timeout=10,
                               env=dict(os.environ, LC_ALL="C"))
            for line in r.stdout.splitlines():
                m = re.match(r"^\S+\s+(\S+)\s+(\d+)\s+(.*?)\s+\d+ bytes$", line)
                if m and int(m.group(2)) in jobs and m.group(3) != "unknown":
                    jobs[int(m.group(2))].setdefault("job-name", m.group(3))
                    jobs[int(m.group(2))].setdefault("job-originating-user-name", m.group(1))
        except (OSError, subprocess.TimeoutExpired):
            pass
        return {"printers": printers, "default": default, "jobs": jobs, "markers": markers}

    @staticmethod
    def live(printers):
        """Primo z tiskaren v siti/USB (ipp-usb): je zapnuta? naplne a stav. Jen pro fronty dnssd://."""
        res = {}
        wanted = {n: lp.uri_service_name(p.get("device-uri")) for n, p in printers.items()}
        wanted = {n: s for n, s in wanted.items() if s}
        if not wanted:
            return res
        text = ""
        procs = [subprocess.Popen(["avahi-browse", "-t", "-r", "-p", "-k", t], stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, text=True) for t in lp.PRINTER_TYPES]
        for p in procs:
            try:
                text += p.communicate(timeout=12)[0]
            except subprocess.TimeoutExpired:
                p.kill()
        fd, test = tempfile.mkstemp(suffix=".test")
        with os.fdopen(fd, "w") as f:
            f.write(lp.IPPTOOL_TEST)
        found = {}
        for g in lp.group_printers(lp.parse_avahi(text)).values():
            found[g["name"]] = g
        for name, svc in wanted.items():
            g = found.get(svc)
            if not g:
                res[name] = {"online": False}
                continue
            info = {"online": True}
            for stype, addr, port, rp in g["addrs"]:
                if addr.lower().startswith("fe80:"):
                    continue            # link-local IPv6 by potreboval rozhrani
                host = f"[{addr}]" if ":" in addr else addr
                scheme = "ipps" if stype == "_ipps._tcp" else "ipp"
                try:
                    r = subprocess.run(["ipptool", "-T", "5", "-tv", f"{scheme}://{host}:{port}/{rp}", test],
                                       capture_output=True, text=True, timeout=15)
                except (OSError, subprocess.TimeoutExpired):
                    continue
                a = lp.parse_ipptool(r.stdout)
                if a:
                    info.update(a)
                    break
            res[name] = info
        os.unlink(test)
        return res


def markers_of(attrs):
    """[(nazev, procento, barva)] jen se znamou urovni."""
    names = attrs.get("marker-names") or []
    levels = attrs.get("marker-levels") or []
    colors = attrs.get("marker-colors") or []
    if isinstance(names, str):
        names, levels, colors = [names], [levels], [colors]
    out = []
    for i, n in enumerate(names):
        lv = levels[i] if i < len(levels) else -1
        if not isinstance(lv, int) or lv < 0:
            continue
        col = (colors[i] if i < len(colors) else "") or "#888888"
        m = re.match(r"#[0-9A-Fa-f]{6}", col)
        out.append((n, min(lv, 100), m.group(0) if m else "#888888"))
    return out


def printer_status(p, live, jobs):
    """(text, trida) - trida: ok | busy | warn | err."""
    reasons = list(p.get("printer-state-reasons") or [])
    if live:
        lr = live.get("printer-state-reasons") or []
        reasons += [lr] if isinstance(lr, str) else list(lr)
    text, serious = lp.reason_text(reasons)
    if live is not None and not live.get("online"):
        return _("Offline – make sure the printer is turned on"), "warn"
    if p.get("printer-state") == 5:
        return (_(text) if text else _("Paused")), "err"
    if text:
        return _(text), ("err" if serious else "warn")
    if p.get("printer-state") == 4:
        return _("Printing…"), "busy"
    if jobs:
        return (_("1 document waiting") if len(jobs) == 1 else _("%d documents waiting") % len(jobs)), "busy"
    return _("Ready"), "ok"


