def esc(s):
    return GLib.markup_escape_text(s or "")


def run_helper(args, done):
    """Pomocnik s pravy roota (pkexec; polkit povoli aktivnimu uzivateli bez hesla). done(rc, out, err)."""
    cmd = [HELPER, *args] if os.geteuid() == 0 else ["pkexec", HELPER, *args]

    def work():
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
            res = (r.returncode, r.stdout, r.stderr.strip())
        except (OSError, subprocess.TimeoutExpired) as e:
            res = (1, "", str(e))
        GLib.idle_add(lambda: done(*res) and False)
    threading.Thread(target=work, daemon=True).start()


def in_thread(work, done):
    """work() ve vlakne, done(vysledek) v hlavnim vlakne."""
    def wrap():
        try:
            res = work()
        except Exception as e:  # noqa: BLE001 - chyba se ukaze uzivateli
            res = e
        GLib.idle_add(lambda: done(res) and False)
    threading.Thread(target=wrap, daemon=True).start()


