class Window(Gtk.Window):
    def __init__(self, select_scanner=False, open_add=False):
        super().__init__(title=_("Printers & Scanners"))
        self.set_default_size(900, 620)
        self.set_icon_name("luxos-printers")
        hb = Gtk.HeaderBar(show_close_button=True, title=_("Printers & Scanners"))
        self.set_titlebar(hb)
        if have("system-config-printer"):
            adv = Gtk.Button(label=_("Advanced…"))
            adv.set_tooltip_text(_("Advanced printer settings for experts"))
            adv.connect("clicked", lambda _b: self.advanced())
            hb.pack_end(adv)

        root = Gtk.Box()
        self.add(root)
        side = cls(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "sidebar")
        side.set_size_request(250, -1)
        root.pack_start(side, False, False, 0)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        self.side = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.side.set_header_func(self.header_func)
        self.side.connect("row-selected", self.on_select)
        sc.add(self.side)
        side.pack_start(sc, True, True, 0)
        tb = Gtk.Box(spacing=4, margin=8)
        add = cls(Gtk.Button.new_from_icon_name("list-add-symbolic", Gtk.IconSize.BUTTON), "toolbar-btn")
        add.set_tooltip_text(_("Add Printer"))
        add.connect("clicked", lambda _b: self.add_printer())
        self.minus = cls(Gtk.Button.new_from_icon_name("list-remove-symbolic", Gtk.IconSize.BUTTON), "toolbar-btn")
        self.minus.set_tooltip_text(_("Remove Printer"))
        self.minus.connect("clicked", lambda _b: self.remove_printer(self.selected_printer()))
        tb.pack_start(add, False, False, 0)
        tb.pack_start(self.minus, False, False, 0)
        side.pack_end(tb, False, False, 0)
        side.pack_end(Gtk.Separator(), False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        root.pack_start(self.stack, True, True, 0)
        empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, valign=Gtk.Align.CENTER, margin=40)
        empty.pack_start(Gtk.Image.new_from_icon_name("printer", Gtk.IconSize.DIALOG), False, False, 0)
        empty.pack_start(cls(Gtk.Label(label=_("No printers yet")), "empty-title"), False, False, 0)
        empty.pack_start(cls(Gtk.Label(label=_("Turn on your printer and connect it to the same Wi‑Fi network or "
                                               "with a USB cable. LuxOS sets it up automatically – no drivers, "
                                               "no questions."), wrap=True, justify=Gtk.Justification.CENTER,
                                     max_width_chars=48), "hint"), False, False, 0)
        b = Gtk.Button(label=_("Add Printer…"), halign=Gtk.Align.CENTER, margin_top=8)
        b.connect("clicked", lambda _b: self.add_printer())
        empty.pack_start(b, False, False, 0)
        self.stack.add_named(empty, "empty")
        self.ppage = PrinterPage(self)
        self.stack.add_named(self.ppage, "printer")
        self.spage = ScannerPage(self)
        self.stack.add_named(self.spage, "scanner")

        self.data = None
        self.live = {}
        self.scanners = None
        self.side_sig = None
        self.select_key = None
        self.want_scanner = select_scanner
        self.refreshing = False
        self.cups_error = None
        self.refresh()
        self.refresh_live()
        self.refresh_scanners()
        GLib.timeout_add_seconds(2, self.tick)
        GLib.timeout_add_seconds(30, self.refresh_live)
        if open_add:
            GLib.idle_add(lambda: self.add_printer() and False)

    # -- data
    def tick(self):
        if self.get_window() and self.is_visible():
            self.refresh()
        return True

    def refresh(self):
        if self.refreshing:
            return
        self.refreshing = True

        def done(res):
            self.refreshing = False
            if isinstance(res, Exception):
                self.cups_error = str(res)
                self.data = {"printers": {}, "default": None, "jobs": {}, "markers": {}}
            else:
                self.cups_error = None
                self.data = res
            self.update()
        in_thread(Cups().snapshot, done)

    def refresh_live(self):
        if not self.data or cups is None:
            GLib.timeout_add_seconds(2, lambda: self.refresh_live() and False)
            return True
        printers = dict(self.data["printers"])

        def done(res):
            if not isinstance(res, Exception):
                self.live = res
                self.ppage.sig = None
                self.update()
        in_thread(lambda: Cups.live(printers), done)
        return True

    def refresh_scanners(self):
        def done(res):
            self.scanners = [] if isinstance(res, Exception) else res
            if self.want_scanner and self.scanners:
                self.select_key = "s:" + self.scanners[0]["id"]
                self.want_scanner = False
            self.update()
        in_thread(list_scanners, done)

    # -- postranni panel
    def header_func(self, row, before):
        kind = row.key[:1]
        if before is None or before.key[:1] != kind:
            title = {"p": _("Printers"), "s": _("Scanners")}.get(kind)
            row.set_header(cls(Gtk.Label(label=title.upper(), xalign=0), "side-title") if title else None)
        else:
            row.set_header(None)

    def update(self):
        if self.data is None:
            return
        rows = []
        for name, p in sorted(self.data["printers"].items(), key=lambda x: (x[1].get("printer-info") or x[0]).lower()):
            jobs = [j for j in self.data["jobs"].values()
                    if (j.get("job-printer-uri") or "").rstrip("/").endswith("/" + name)]
            text, state = printer_status(p, self.live.get(name), jobs)
            if self.data["default"] == name:
                text = _("Default") + " · " + text
            rows.append(("p:" + name, "printer", p.get("printer-info") or name, text, state))
        if self.scanners is None:
            rows.append(("s:?", "scanner", _("Looking for scanners…"), "", None))
        elif not self.scanners:
            rows.append(("s:-", "scanner", _("No scanners found"), _("Turn the scanner on"), None))
        for s in self.scanners or ():
            rows.append(("s:" + s["id"], "scanner", s["name"], s["kind"], None))
        sel = self.side.get_selected_row()
        cur = self.select_key or (sel.key if sel else None)
        if rows != self.side_sig:
            self.side_sig = rows
            for c in self.side.get_children():
                self.side.remove(c)
            for key, icon, name, sub, state in rows:
                r = SideRow(key, icon, name, sub, state)
                if key in ("s:?", "s:-"):
                    r.set_selectable(False)
                    r.set_activatable(False)
                elif key.startswith("s:") and have("luxos-scan"):
                    # Skenovani v samostatne jednoduche aplikaci Skener (luxos-scan)
                    b = cls(Gtk.Button(label=_("Scan…"), valign=Gtk.Align.CENTER), "toolbar-btn")
                    b.set_tooltip_text(_("Open in the Scanner app"))
                    b.connect("clicked", lambda _b, d=key[2:]: self.open_scan_app(d))
                    r.get_child().pack_end(b, False, False, 0)
                self.side.add(r)
            self.side.show_all()
        keys = [r[0] for r in rows if r[0] not in ("s:?", "s:-")]
        if cur not in keys:
            d = "p:" + (self.data["default"] or "")
            cur = d if d in keys else keys[0] if keys and keys[0].startswith("p:") else None
        self.select_key = None
        if cur:
            for r in self.side.get_children():
                if r.key == cur and self.side.get_selected_row() is not r:
                    self.side.select_row(r)
        self.show_selected()

    def selected_printer(self):
        r = self.side.get_selected_row()
        return r.key[2:] if r and r.key.startswith("p:") else None

    def on_select(self, _lb, _row):
        self.show_selected()

    def show_selected(self):
        r = self.side.get_selected_row()
        self.minus.set_sensitive(bool(r and r.key.startswith("p:")))
        if r and r.key.startswith("p:") and self.data and r.key[2:] in self.data["printers"]:
            name = r.key[2:]
            self.ppage.show_printer(name, self.data, self.live.get(name))
            self.stack.set_visible_child_name("printer")
        elif r and r.key.startswith("s:") and self.scanners:
            dev = next((s for s in self.scanners if "s:" + s["id"] == r.key), None)
            if dev:
                self.spage.set_device(dev)
                self.stack.set_visible_child_name("scanner")
        else:
            self.stack.set_visible_child_name("empty")

    # -- akce
    def after_admin(self, rc, err):
        if rc != 0 and rc != 126:   # 126: uzivatel zavrel dotaz na heslo
            self.error(_("The change could not be made"), err or "")
        self.ppage.sig = None
        self.refresh()

    def cancel_job(self, jid):
        def work():
            cups.Connection().cancelJob(jid)

        def done(res):
            if isinstance(res, Exception):
                # cizi uloha - zrusi pomocnik s pravy roota
                run_helper(["cancel", str(jid)], lambda rc, o, e: self.after_admin(rc, e))
            else:
                self.refresh()
        in_thread(work, done)

    def remove_printer(self, name):
        if not name or not self.data or name not in self.data["printers"]:
            return
        label = self.data["printers"][name].get("printer-info") or name
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text=_("Remove “%s”?") % label)
        dlg.format_secondary_text(_("Apps will no longer print to it. You can add it again later with the + button."))
        dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        cls(dlg.add_button(_("Remove"), Gtk.ResponseType.OK), "destructive-action")
        ok = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        if ok:
            run_helper(["remove", name], lambda rc, o, e: self.after_admin(rc, e))

    def add_printer(self):
        AddDialog(self)

    def open_scan_app(self, dev):
        try:
            subprocess.Popen(["luxos-scan", "--device", dev], start_new_session=True)
        except OSError as e:
            self.error(_("Could not open the Scanner app"), str(e))

    def advanced(self):
        try:
            subprocess.Popen(["system-config-printer"], start_new_session=True)
        except OSError as e:
            self.error(_("Could not open advanced settings"), str(e))

    def install_aur_driver(self, name, pkg):
        """Ovladac jen z AUR (napr. Samsung): po potvrzeni ho lux sestavi v Terminalu, pak sync."""
        if not re.fullmatch(r"[a-z0-9][a-z0-9._+-]*", pkg):
            return
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE,
                                text=_("Printer “%s” needs a driver from the manufacturer") % name)
        dlg.format_secondary_text(_("Click Install Driver. LuxOS downloads and builds it (this takes a few "
                                    "minutes and asks for your password), then sets up the printer."))
        dlg.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        dlg.add_button(_("Install Driver"), Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        r = dlg.run()
        dlg.destroy()
        if r != Gtk.ResponseType.OK:
            return
        subprocess.Popen(["xfce4-terminal", "--title=" + _("Install Driver"), "-x", "bash", "-c",
                          'lux install "$1" && pkexec /usr/lib/luxos/printing/luxos-printing-helper sync; '
                          'echo; echo "$2"; read -r', "_", pkg, _("Done. You can close this window.")],
                         start_new_session=True)

    def error(self, title, text):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                buttons=Gtk.ButtonsType.CLOSE, text=title)
        dlg.format_secondary_text(text)
        dlg.run()
        dlg.destroy()


def main():
    GLib.set_prgname(APP_ID)
    GLib.set_application_name(_("Printers & Scanners"))
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Window(select_scanner="--scanner" in sys.argv, open_add="--add" in sys.argv)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
