    def on_test(self, _b):
        name = self.name
        self.note.set_text(_("Sending a test page…"))

        def work():
            c = cups.Connection()
            return c.printTestPage(name)

        def done(res):
            if isinstance(res, Exception):
                self.note.set_text(_("The test page could not be sent: %s") % res)
            else:
                self.note.set_text(_("The test page is on its way."))
            self.win.refresh()
        in_thread(work, done)

    def on_resume(self, _b):
        run_helper(["resume", self.name], lambda rc, o, e: self.win.after_admin(rc, e))


