<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LuxOS</vendor>
  <action id="org.luxos.printing.manage">
    <description>Manage printers</description>
    <description xml:lang="cs">Správa tiskáren</description>
    <message>Authentication is required to manage printers</message>
    <message xml:lang="cs">Ke správě tiskáren je potřeba ověření</message>
    <icon_name>printer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/luxos/printing/luxos-printing-helper</annotate>
  </action>
</policyconfig>
