#!/usr/bin/env python3
"""LuxOS - prida mdns_minimal do radku hosts v /etc/nsswitch.conf (adresy *.local tiskaren a skeneru).

Meni jen radek hosts, jen kdyz tam mdns jeste neni; zbytek souboru, prava a vlastnik zustanou.
Spousti luxos-printing.install a pacman hook (po aktualizaci baliku filesystem).
"""
import os
import sys
import tempfile

sys.path.insert(0, "/usr/lib/luxos/python")
from luxos_printing import nsswitch_add_mdns  # noqa: E402

path = sys.argv[1] if len(sys.argv) > 1 else "/etc/nsswitch.conf"
try:
    with open(path) as f:
        text = f.read()
except OSError as e:
    sys.exit(f"luxos-nsswitch-mdns: {e}")
new = nsswitch_add_mdns(text)
if new is None:
    sys.exit(0)
st = os.stat(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".nsswitch.")
with os.fdopen(fd, "w") as f:
    f.write(new)
os.chmod(tmp, st.st_mode & 0o7777)
try:
    os.chown(tmp, st.st_uid, st.st_gid)
except OSError:
    pass
os.replace(tmp, path)
print("luxos-printing: mdns_minimal added to " + path)
