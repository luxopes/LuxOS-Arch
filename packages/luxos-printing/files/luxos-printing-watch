#!/bin/bash
# LuxOS - hlidani tiskaren a skeneru v siti i na USB (ipp-usb se ohlasuje na lo) bez dotazovani:
# avahi-browse hlasi nove sluzby, po kratke pauze (davka udalosti) probehne luxos-printing-helper sync.
# Hlida jen _ipp (povinne u IPP Everywhere/AirPrint) a _uscan (eSCL); sync pak projde i _ipps/_uscans.
# Pameti zabere jen bash a dva male procesy avahi-browse (v C).
set -u
helper=/usr/lib/luxos/printing/luxos-printing-helper
trap 'kill 0' EXIT
while IFS= read -r line; do
    [[ $line == +* ]] || continue
    # dalsi hlaseni behem 3 s patri ke stejne udalosti (IPv4/IPv6, vic rozhrani)
    while IFS= read -r -t 3 _more; do :; done
    "$helper" sync || true
done < <(avahi-browse -p -k _ipp._tcp & avahi-browse -p -k _uscan._tcp & wait)
# avahi-browse skoncil (restart avahi-daemon) - systemd sluzbu spusti znovu
exit 1
