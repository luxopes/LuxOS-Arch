+// LuxOS: preklad z luxos-i18n (/usr/share/luxos/i18n/<jazyk>.tsv: anglicky<TAB>prelozeny;
+// LUXOS_I18N_DIR pro testy)
+static const gchar* luxos_tr(const gchar* text)
+{
+	static GHashTable* table = nullptr;
+	if (!table)
+	{
+		table = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+		const gchar* dir = g_getenv("LUXOS_I18N_DIR");
+		for (const gchar* const* lang = g_get_language_names(); *lang; ++lang)
+		{
+			gchar* path = g_strdup_printf("%s/%s.tsv", (dir && *dir) ? dir : "/usr/share/luxos/i18n", *lang);
+			gchar* data = nullptr;
+			const bool found = !strchr(*lang, '.') && g_file_get_contents(path, &data, nullptr, nullptr);
+			g_free(path);
+			if (!found)
+			{
+				continue;
+			}
+			gchar** lines = g_strsplit(data, "\n", -1);
+			for (gchar** line = lines; *line; ++line)
+			{
+				gchar* tab = strchr(*line, '\t');
+				if (**line != '#' && tab && tab[1])
+				{
+					g_hash_table_replace(table, g_strndup(*line, tab - *line), g_strdup(tab + 1));
+				}
+			}
+			g_strfreev(lines);
+			g_free(data);
+			break;
+		}
+	}
+	const gchar* translated = static_cast<const gchar*>(g_hash_table_lookup(table, text));
+	return translated ? translated : text;
+}
