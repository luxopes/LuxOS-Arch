--- a/panel-plugin/applications-page.cpp
+++ b/panel-plugin/applications-page.cpp
@@ -35,8 +35,12 @@ ApplicationsPage::ApplicationsPage(Window* window) :
 	Page(window, "applications-other", _("All Applications")),
 	m_garcon_menu(nullptr),
 	m_garcon_settings_menu(nullptr),
+	m_load_cancellable(nullptr),
+	m_load_running(false),
 	m_status(LoadStatus::Invalid)
 {
+	g_mutex_init(&m_load_mutex);
+	g_cond_init(&m_load_cond);
 	garcon_set_environment_xdg(GARCON_ENVIRONMENT_XFCE);
 
 	const decltype(m_categories.size()) index = 0;
@@ -51,7 +55,28 @@ ApplicationsPage::ApplicationsPage(Window* window) :
 
 ApplicationsPage::~ApplicationsPage()
 {
+	// Wait for a running load thread: it uses the menu that clear() frees, and its
+	// completion callback must not touch this page any more
+	if (m_load_cancellable)
+	{
+		g_cancellable_cancel(m_load_cancellable);
+	}
+	g_mutex_lock(&m_load_mutex);
+	while (m_load_running)
+	{
+		g_cond_wait(&m_load_cond, &m_load_mutex);
+	}
+	g_mutex_unlock(&m_load_mutex);
+	if (m_load_cancellable)
+	{
+		g_object_unref(m_load_cancellable);
+		m_load_cancellable = nullptr;
+	}
+
 	clear();
+
+	g_cond_clear(&m_load_cond);
+	g_mutex_clear(&m_load_mutex);
 }
 
