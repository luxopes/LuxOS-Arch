 	// Load contents in thread if possible
-	GTask* task = g_task_new(nullptr, nullptr,
-		+[](GObject*, GAsyncResult*, gpointer user_data)
+	if (m_load_cancellable)
+	{
+		g_object_unref(m_load_cancellable);
+	}
+	m_load_cancellable = g_cancellable_new();
+	g_mutex_lock(&m_load_mutex);
+	m_load_running = true;
+	g_mutex_unlock(&m_load_mutex);
+
+	GTask* task = g_task_new(nullptr, m_load_cancellable,
+		+[](GObject*, GAsyncResult* result, gpointer user_data)
 		{
+			// Page already destroyed (cancelled in the destructor)
+			if (g_cancellable_is_cancelled(g_task_get_cancellable(G_TASK(result))))
+			{
+				return;
+			}
 			static_cast<ApplicationsPage*>(user_data)->load_contents();
 		},
 		this);
@@ -179,7 +218,13 @@ bool ApplicationsPage::load()
 	g_task_run_in_thread(task,
 		+[](GTask* thread_task, gpointer, gpointer task_data, GCancellable*)
 		{
-			static_cast<ApplicationsPage*>(task_data)->load_garcon_menu();
+			ApplicationsPage* page = static_cast<ApplicationsPage*>(task_data);
+			page->load_garcon_menu();
+			// After this the destructor may free the page
+			g_mutex_lock(&page->m_load_mutex);
+			page->m_load_running = false;
+			g_cond_broadcast(&page->m_load_cond);
+			g_mutex_unlock(&page->m_load_mutex);
 			g_task_return_boolean(thread_task, true);
 		});
 	g_object_unref(task);
