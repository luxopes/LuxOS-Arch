# ---- konfigurace -------------------------------------------------------------------------
def load_config():
    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read(CONF, encoding="utf-8")
    except (OSError, configparser.Error) as e:
        log("config:", e)
    g = cp["greeter"] if cp.has_section("greeter") else {}

    def flag(key, default):
        v = str(g.get(key, "")).strip().lower()
        return default if v in ("", "auto") else v in ("1", "true", "yes", "on")

    h24 = flag("clock-24h", LANG != "en")
    try:
        idle = max(5, int(g.get("idle-timeout", 30)))
    except ValueError:
        idle = 30
    date_fmt = str(g.get("date-format", "")).strip() or ("%A %-d. %B" if LANG == "cs" else "%A, %B %-d")
    return {
        "background": str(g.get("background", "")).strip() or DEFAULT_BG,
        "user-background": flag("user-background", True),
        "clock": str(g.get("clock-format", "")).strip() or ("%-H:%M" if h24 else "%-I:%M"),
        "date": date_fmt,
        "idle": idle,
        "font": str(g.get("font", "")).strip() or "Inter",
        "cursor-theme": str(g.get("cursor-theme", "")).strip() or "WhiteSur-cursors",
        "battery": flag("show-battery", True),
        "network": flag("show-network", True),
    }


