class User:
    def __init__(self, name, real_name, image=None, background=None, session=None, logged_in=False):
        self.name = name                # None = rucne zadane jmeno, "*guest" = host
        self.real_name = real_name or name or ""
        self.image = image
        self.background = background
        self.session = session
        self.logged_in = logged_in


class LightDMBackend:
    """Tenka vrstva nad LightDM.Greeter (stejny postup jako lightdm-gtk-greeter)."""

    def __init__(self, ui):
        gi.require_version("LightDM", "1")
        from gi.repository import LightDM
        self.L = LightDM
        self.ui = ui
        self.g = LightDM.Greeter()
        self.g.connect("show-prompt", self._prompt)
        self.g.connect("show-message", self._message)
        self.g.connect("authentication-complete", lambda _g: ui.on_complete())
        try:
            self.g.connect_to_daemon_sync()
        except AttributeError:
            self.g.connect_sync()
        self.userlist = LightDM.UserList.get_instance()

    def _prompt(self, _g, text, ptype):
        self.ui.on_prompt(text, ptype == self.L.PromptType.SECRET)

    def _message(self, _g, text, mtype):
        self.ui.on_message(text, mtype == self.L.MessageType.ERROR)

    # informace
    def users(self):
        out = []
        if not self.g.get_hide_users_hint():
            for u in self.userlist.get_users():
                out.append(User(u.get_name(), u.get_display_name(), u.get_image(), u.get_background(),
                                u.get_session(), u.get_logged_in()))
        if not out or self.g.get_show_manual_login_hint():
            out.append(User(None, _("Other…")))
        if self.g.get_has_guest_account_hint():
            out.append(User("*guest", _("Guest")))
        return out

    def select_hint(self):
        if self.g.get_select_guest_hint():
            return "*guest"
        return self.g.get_select_user_hint()

    def lock_hint(self):
        return self.g.get_lock_hint()

    def sessions(self):
        # LuxOS bezi jen na X11 (lista, dock, kompozitor) - Wayland relace Xfce nenabizet;
        # jedina relace Xfce se v nabidce jmenuje LuxOS
        out = [(s.get_key(), s.get_name()) for s in self.L.get_sessions()
               if (s.get_session_type() or "x") == "x"]
        return [(k, "LuxOS" if k == "xfce" else n) for k, n in out] or out

    def default_session(self):
        return self.g.get_default_session_hint()

    def can(self, what):
        return {"suspend": self.L.get_can_suspend, "restart": self.L.get_can_restart,
                "shutdown": self.L.get_can_shutdown}[what]()

    def power(self, what):
        {"suspend": self.L.suspend, "restart": self.L.restart, "shutdown": self.L.shutdown}[what]()

    # autentizace
    def authenticate(self, user):
        if self.g.get_in_authentication():
            self.g.cancel_authentication()
        if user.name == "*guest":
            self.g.authenticate_as_guest()
        else:
            self.g.authenticate(user.name)  # None = PAM se zepta na jmeno

    def respond(self, text):
        self.g.respond(text)

    def cancel(self):
        if self.g.get_in_authentication():
            self.g.cancel_authentication()

    def is_authenticated(self):
        return self.g.get_is_authenticated()

    def auth_user(self):
        return self.g.get_authentication_user()

    def start_session(self, key):
        self.g.start_session_sync(key)


class DemoBackend:
    """Napodobeni LightDM pro testy (heslo "luxos"); nic nespousti ani nevypina."""

    def __init__(self, ui, n_users=1, n_sessions=1, lock=False):
        self.ui = ui
        self.n_users, self.n_sessions, self.lock = n_users, n_sessions, lock
        self.state = None           # None | "prompt" | "wait" | "done"
        self.user = None
        self.ok = False

    def users(self):
        demo = [User("anna", "Anna Nováková"), User("petr", "Petr Svoboda"), User("eva", "Eva Dvořáková"),
                User("jan", "Jan Černý")]
        img = os.environ.get("LUXOS_GREETER_DEMO_AVATAR")
        if img:
            demo[0].image = img
        return demo[:max(1, self.n_users)]

    def select_hint(self):
        return "anna" if self.lock else None

    def lock_hint(self):
        return self.lock

    def sessions(self):
        return [("xfce", "Xfce Session"), ("openbox", "Openbox"), ("i3", "i3")][:max(1, self.n_sessions)]

    def default_session(self):
        return "xfce"

    def can(self, _what):
        return True

    def power(self, what):
        log("demo: power", what)

    def authenticate(self, user):
        self.user, self.ok, self.state = user, False, "prompt"

        def prompt():
            if self.state == "prompt":
                self.ui.on_prompt("Password: ", True)
            return False
        GLib.timeout_add(30, prompt)

    def respond(self, text):
        if self.state != "prompt":
            return
        self.state = "wait"

        def done():
            if self.state == "wait":
                self.ok = text == "luxos"
                self.state = "done"
                self.ui.on_complete()
            return False
        GLib.timeout_add(400, done)

    def cancel(self):
        self.state = None

    def is_authenticated(self):
        return self.ok

    def auth_user(self):
        return self.user.name if self.user else None

    def start_session(self, key):
        log("demo: start session", key, "for", self.auth_user())
        GLib.timeout_add(800, lambda: Gtk.main_quit() or False)


# ---- klavesnice (rozlozeni ze systemu, prepinani skupin XKB) -----------------------------
class XkbState(ctypes.Structure):
    _fields_ = [("group", ctypes.c_ubyte), ("locked_group", ctypes.c_ubyte), ("base_group", ctypes.c_ushort),
                ("latched_group", ctypes.c_ushort), ("mods", ctypes.c_ubyte), ("base_mods", ctypes.c_ubyte),
                ("latched_mods", ctypes.c_ubyte), ("locked_mods", ctypes.c_ubyte), ("compat_state", ctypes.c_short),
                ("grab_mods", ctypes.c_ubyte), ("compat_grab_mods", ctypes.c_ubyte), ("lookup_mods", ctypes.c_ubyte),
                ("compat_lookup_mods", ctypes.c_ubyte), ("ptr_buttons", ctypes.c_ushort)]


class Keyboard:
    USE_CORE_KBD = 0x0100

    def __init__(self):
        self.layouts, self.options = self._read_conf()
        self.x = self.dpy = None
        try:
            self.x = ctypes.CDLL("libX11.so.6")
            self.x.XOpenDisplay.restype = ctypes.c_void_p
            self.x.XOpenDisplay.argtypes = [ctypes.c_char_p]
            self.x.XkbGetState.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(XkbState)]
            self.x.XkbLockGroup.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint]
            self.x.XFlush.argtypes = [ctypes.c_void_p]
            self.dpy = self.x.XOpenDisplay(None)
            # inicializace rozsireni XKB v tomto spojeni (jinak XkbGetState/XkbLockGroup nic nedelaji)
            i = [ctypes.c_int() for _ in range(5)]
            maj, mnr = ctypes.c_int(1), ctypes.c_int(0)
            if self.dpy and not self.x.XkbQueryExtension(ctypes.c_void_p(self.dpy), *[ctypes.byref(v) for v in i[:3]],
                                                         ctypes.byref(maj), ctypes.byref(mnr)):
                log("xkb: extension not available")
        except (OSError, AttributeError) as e:
            log("xkb:", e)

    @staticmethod
    def _read_conf():
        vals = {}
        try:
            with open(KEYBOARD_CONF, encoding="utf-8") as f:
                for line in f:
                    p = line.strip().split(None, 2)
                    if len(p) == 3 and p[0] == "Option":
                        vals[p[1].strip('"')] = p[2].strip().strip('"')
        except OSError:
            pass
        lay = [s.strip() for s in vals.get("XkbLayout", "").split(",")]
        var = [s.strip() for s in vals.get("XkbVariant", "").split(",")]
        layouts = [(lay[i], var[i] if i < len(var) else "") for i in range(len(lay)) if lay[i]]
        return layouts or [("us", "")], vals.get("XkbOptions", "")

    @property
    def x_handles_toggle(self):
        """Rozlozeni prepina samo X (XkbOptions grp:...), my jen ukazujeme stav."""
        return "grp:" in self.options

    def group(self):
        if not self.dpy:
            return 0
        st = XkbState()
        if self.x.XkbGetState(self.dpy, self.USE_CORE_KBD, ctypes.byref(st)) != 0:
            return 0
        return st.group % max(1, len(self.layouts))

    def label(self, i=None):
        i = self.group() if i is None else i
        lay, var = self.layouts[min(i, len(self.layouts) - 1)]
        dup = sum(1 for l, _v in self.layouts if l == lay) > 1
        return lay.upper() + (" " + var if dup and var else "")

    def next(self):
        if not self.dpy or len(self.layouts) < 2:
            return
        self.x.XkbLockGroup(self.dpy, self.USE_CORE_KBD, (self.group() + 1) % len(self.layouts))
        self.x.XFlush(self.dpy)


# ---- stav systemu (baterie, sit) ---------------------------------------------------------
def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return default


def battery_state():
    base = "/sys/class/power_supply"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return None
    for n in names:
        d = os.path.join(base, n)
        if read(d + "/type") == "Battery" and read(d + "/scope", "System") != "Device":
            try:
                return int(read(d + "/capacity", "-1")), read(d + "/status") == "Charging"
            except ValueError:
                return None
    return None


def network_state():
    base = "/sys/class/net"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return None
    kind = None
    for n in names:
        if n == "lo" or read(f"{base}/{n}/operstate") != "up":
            continue
        if os.path.isdir(f"{base}/{n}/wireless") or os.path.exists(f"{base}/{n}/phy80211"):
            return "wifi"
        if os.path.exists(f"{base}/{n}/device"):
            kind = "wired"
    return kind


# ---- kreslici pomucky --------------------------------------------------------------------
def rounded(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()


def ease(t):
    return 4 * t * t * t if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2


def box_blur(surf, radius=2, passes=3, saturate=1.25):
    """Rozmaze malou ImageSurface (RGB24) na miste; kanaly zpracuje samostatne."""
    w, h, stride = surf.get_width(), surf.get_height(), surf.get_stride()
    surf.flush()
    data = surf.get_data()
    ch = [[0.0] * (w * h) for _ in range(3)]
    for y in range(h):
        row = y * stride
        for x in range(w):
            o = row + 4 * x
            for c in range(3):
                ch[c][y * w + x] = data[o + c]

    def blur_line(src, dst, start, step, n):
        win = 2 * radius + 1
        acc = src[start] * (radius + 1)
        for i in range(radius):
            acc += src[start + min(i, n - 1) * step]
        for i in range(n):
            acc += src[start + min(i + radius, n - 1) * step] - src[start + max(i - radius - 1, 0) * step]
            dst[start + i * step] = acc / win

    for c in range(3):
        a = ch[c]
        b = [0.0] * (w * h)
        for _p in range(passes):
            for y in range(h):
                blur_line(a, b, y * w, 1, w)
            for x in range(w):
                blur_line(b, a, x, w, h)
    for y in range(h):
        row = y * stride
        for x in range(w):
            i = y * w + x
            bl, g, r = ch[0][i], ch[1][i], ch[2][i]
            lum = 0.0722 * bl + 0.7152 * g + 0.2126 * r
            o = row + 4 * x
            data[o] = max(0, min(255, int(lum + (bl - lum) * saturate)))
            data[o + 1] = max(0, min(255, int(lum + (g - lum) * saturate)))
            data[o + 2] = max(0, min(255, int(lum + (r - lum) * saturate)))
    surf.mark_dirty()


def load_pixbuf(path, size=None):
    if not path or not os.path.isfile(path) or not os.access(path, os.R_OK):
        return None
    try:
        if size:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        return GdkPixbuf.Pixbuf.new_from_file(path)
    except GLib.Error as e:
        log("image:", path, e.message)
        return None


def text_layout(cr, text, px, weight=Pango.Weight.NORMAL, family="Inter"):
    lay = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription()
    fd.set_family(f"{family},Inter,Cantarell,Noto Sans,sans-serif")
    fd.set_weight(weight)
    fd.set_absolute_size(px * Pango.SCALE)
    lay.set_font_description(fd)
    lay.set_text(text, -1)
    return lay


# ---- ikony (vlastni kresby, zadne cizi assety) -------------------------------------------
def icon_sleep(cr, cx, cy, s):
    # pulmesic: kruh bez posunuteho kruhu (jen uvnitr velkeho kruhu)
    r = s * 0.40
    cr.save()
    cr.new_path()
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.clip()
    cr.new_path()
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.new_sub_path()
    cr.arc(cx + r * 0.55, cy - r * 0.45, r * 0.82, 0, 2 * math.pi)
    cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
    cr.fill()
    cr.restore()


def icon_restart(cr, cx, cy, s):
    r = s * 0.36
    cr.set_line_width(max(1.4, s * 0.085))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.new_path()
    a0, a1 = -math.pi / 2 + 0.25, -math.pi / 2 + 2 * math.pi - 0.75
    cr.arc(cx, cy, r, a0, a1)
    cr.stroke()
    # sipka na konci oblouku (ve smeru hodinovych rucicek)
    ex, ey = cx + r * math.cos(a1), cy + r * math.sin(a1)
    tx, ty = -math.sin(a1), math.cos(a1)          # tecna
    nx, ny = math.cos(a1), math.sin(a1)           # normala
    k = s * 0.2
    cr.move_to(ex + tx * k * 0.9, ey + ty * k * 0.9)
    cr.line_to(ex + nx * k * 0.75 - tx * k * 0.25, ey + ny * k * 0.75 - ty * k * 0.25)
    cr.line_to(ex - nx * k * 0.75 - tx * k * 0.25, ey - ny * k * 0.75 - ty * k * 0.25)
    cr.close_path()
    cr.fill()


def icon_power(cr, cx, cy, s):
    r = s * 0.36
    cr.set_line_width(max(1.4, s * 0.085))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.new_path()
    cr.arc(cx, cy + s * 0.03, r, -math.pi / 2 + 0.62, -math.pi / 2 - 0.62 + 2 * math.pi)
    cr.stroke()
    cr.move_to(cx, cy - s * 0.45)
    cr.line_to(cx, cy - s * 0.05)
    cr.stroke()


def icon_session(cr, cx, cy, s):
    q = s * 0.3
    g = s * 0.08
    for dx in (-1, 1):
        for dy in (-1, 1):
            rounded(cr, cx + (g / 2 if dx > 0 else -g / 2 - q), cy + (g / 2 if dy > 0 else -g / 2 - q), q, q, q * 0.25)
    cr.fill()


def icon_arrow(cr, cx, cy, s):
    cr.set_line_width(max(1.5, s * 0.11))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.move_to(cx - s * 0.3, cy)
    cr.line_to(cx + s * 0.3, cy)
    cr.move_to(cx + s * 0.05, cy - s * 0.25)
    cr.line_to(cx + s * 0.3, cy)
    cr.line_to(cx + s * 0.05, cy + s * 0.25)
    cr.stroke()


def icon_person(cr, cx, cy, s):
    cr.arc(cx, cy - s * 0.16, s * 0.17, 0, 2 * math.pi)
    cr.fill()
    cr.save()
    cr.translate(cx, cy + s * 0.34)
    cr.scale(s * 0.32, s * 0.27)
    cr.arc(0, 0, 1, math.pi, 2 * math.pi)
    cr.restore()
    cr.close_path()
    cr.fill()


def icon_wifi(cr, x, y, s):
    cx, cy = x + s / 2, y + s * 0.86
    cr.set_line_width(max(1.3, s * 0.11))
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    for r in (0.3, 0.55, 0.8):
        cr.new_path()
        cr.arc(cx, cy, s * r * 0.85, -math.pi * 0.75, -math.pi * 0.25)
        cr.stroke()
    cr.arc(cx, cy, s * 0.08, 0, 2 * math.pi)
    cr.fill()


def icon_wired(cr, x, y, s):
    b = s * 0.26
    rounded(cr, x + s / 2 - b / 2, y + s * 0.08, b, b, b * 0.2)
    rounded(cr, x + s * 0.08, y + s * 0.66, b, b, b * 0.2)
    rounded(cr, x + s * 0.92 - b, y + s * 0.66, b, b, b * 0.2)
    cr.fill()
    cr.set_line_width(max(1.2, s * 0.08))
    cr.move_to(x + s / 2, y + s * 0.08 + b)
    cr.line_to(x + s / 2, y + s * 0.52)
    cr.move_to(x + s * 0.08 + b / 2, y + s * 0.66)
    cr.line_to(x + s * 0.08 + b / 2, y + s * 0.52)
    cr.line_to(x + s * 0.92 - b / 2, y + s * 0.52)
    cr.line_to(x + s * 0.92 - b / 2, y + s * 0.66)
    cr.stroke()


def icon_battery(cr, x, y, h, level, charging):
    w = h * 2.05
    lw = max(1.0, h * 0.09)
    cr.set_line_width(lw)
    cr.set_source_rgba(1, 1, 1, 0.55)
    rounded(cr, x + lw / 2, y + lw / 2, w - h * 0.22 - lw, h - lw, h * 0.26)
    cr.stroke()
    rounded(cr, x + w - h * 0.2, y + h * 0.33, h * 0.14, h * 0.34, h * 0.06)
    cr.fill()
    inner = w - h * 0.22 - lw * 2 - h * 0.16
    frac = max(0.0, min(1.0, level / 100.0))
    if level <= 15 and not charging:
        cr.set_source_rgba(1.0, 0.36, 0.33, 1)
    else:
        cr.set_source_rgba(1, 1, 1, 0.95)
    rounded(cr, x + lw + h * 0.08, y + lw + h * 0.08, max(h * 0.12, inner * frac), h - 2 * lw - h * 0.16, h * 0.14)
    cr.fill()
    if charging:
        cx, cy = x + (w - h * 0.22) / 2, y + h / 2
        cr.set_source_rgba(0, 0, 0, 0.75)
        cr.move_to(cx + h * 0.08, cy - h * 0.42)
        cr.line_to(cx - h * 0.2, cy + h * 0.06)
        cr.line_to(cx - h * 0.01, cy + h * 0.06)
        cr.line_to(cx - h * 0.08, cy + h * 0.42)
        cr.line_to(cx + h * 0.2, cy - h * 0.06)
        cr.line_to(cx + h * 0.01, cy - h * 0.06)
        cr.close_path()
        cr.fill()


# ---- hlavni okno -------------------------------------------------------------------------
class Greeter(Gtk.Window):
