    # -- geometrie a styl podle velikosti obrazovky --
    def relayout(self):
        disp = Gdk.Display.get_default()
        root = Gdk.get_default_root_window()
        self.W, self.H = root.get_width(), root.get_height()
        mons = [disp.get_monitor(i) for i in range(disp.get_n_monitors())] or []
        self.monitors = [m.get_geometry() for m in mons] or [Gdk.Rectangle()]
        if not mons:
            self.monitors[0].x = self.monitors[0].y = 0
            self.monitors[0].width, self.monitors[0].height = self.W, self.H
        prim = disp.get_primary_monitor() or (mons[0] if mons else None)
        self.mon = prim.get_geometry() if prim else self.monitors[0]
        mx, my, mw, mh = self.mon.x, self.mon.y, self.mon.width, self.mon.height
        self.u = u = max(0.55, mh / 1080.0)
        self.move(0, 0)
        self.set_default_size(self.W, self.H)
        self.resize(self.W, self.H)
        self.set_size_request(self.W, self.H)

        def px(v, lo=0):
            return max(lo, round(v * u))
        self.sz = {
            "avatar": px(104, 64), "pw_w": px(250, 180), "pw_h": px(36, 28), "round": px(44, 34),
            "status": px(16, 12), "pad": px(18, 10), "pw_pad": px(16, 11), "pw_font": px(15, 12),
        }
        self.status.set_margin_top(my + self.sz["pad"])
        self.status.set_margin_end(self.W - (mx + mw) + self.sz["pad"])
        self.status.set_spacing(px(14, 8))
        self.login.set_margin_start(mx)
        self.login.set_margin_end(self.W - (mx + mw))
        self.login.set_margin_bottom(self.H - (my + mh) + px(150, 110))
        self.login.set_spacing(px(14, 9))
        self.users_box.set_spacing(px(34, 20))
        for b in self.user_buttons:
            b.avatar.set_size_request(self.sz["avatar"] + px(8, 6), self.sz["avatar"] + px(8, 6))
            b.get_child().set_spacing(px(8, 5))
        self.pw.set_size_request(self.sz["pw_w"], self.sz["pw_h"])
        self.go_area.set_size_request(self.sz["pw_h"], self.sz["pw_h"])
        self.hint.set_size_request(-1, px(22, 16))
        self.power.set_margin_bottom(self.H - (my + mh) + px(42, 26))
        self.power.set_spacing(px(40, 26))
        for b in self.power_buttons:
            b.area.set_size_request(self.sz["round"] + px(8, 6), self.sz["round"] + px(8, 6))
            b.get_child().set_spacing(px(5, 3))
        self.net_icon.set_size_request(self.sz["status"] + 4, self.sz["status"] + 4)
        self.bat_icon.set_size_request(round(self.sz["status"] * 2.05) + 2, self.sz["status"] + 4)

        f = self.cfg["font"]
        css = f"""
        * {{ font-family: "{f}", "Inter", "Cantarell", sans-serif; }}
        window {{ background-color: transparent; }}
        label {{ color: white; text-shadow: 0 1px {px(3, 2)}px rgba(0,0,0,0.45); }}
