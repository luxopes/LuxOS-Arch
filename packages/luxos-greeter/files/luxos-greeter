    # -- stav mezi spustenimi (domov uzivatele lightdm, ne domovy uzivatelu) --
    def _state_path(self):
        return os.path.join(GLib.get_user_cache_dir(), "luxos-greeter", "state")

    def _load_state(self):
        out = {}
        for line in read(self._state_path()).splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
        return out

    def _save_state(self):
        if self.demo:
            return
        try:
            p = self._state_path()
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w", encoding="utf-8") as f:
                f.write(f"last-user={self.user.name or ''}\nlast-session={self.session or ''}\n")
        except OSError as e:
            log("state:", e)

    def _session_for(self, user, last=None):
        keys = [k for k, _n in self.sessions]
        for k in (user.session, last, self.backend.default_session(), "xfce"):
            if k and k in keys:
                return k
        return keys[0] if keys else None

