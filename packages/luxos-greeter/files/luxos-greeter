def system_locale():
    """LightDM spousti greeter bez LANG: jazyk vzit ze systemoveho nastaveni (/etc/locale.conf)."""
    if os.environ.get("LANG", "C") not in ("", "C", "POSIX", "C.UTF-8"):
        return
    for path in ("/etc/locale.conf", "/etc/default/locale"):
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        for line in lines:
            k, _sep, v = line.partition("=")
            k, v = k.strip(), v.strip().strip("\"'")
            if k in ("LANG", "LC_TIME", "LC_MESSAGES") and v:
                os.environ[k] = v
        return


