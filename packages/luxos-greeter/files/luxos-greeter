                      min-height: 0; min-width: 0; -gtk-icon-shadow: none; text-shadow: none; }}
        button.lux:hover, button.lux:active, button.lux:checked {{ background: none; box-shadow: none; }}
        button.pill {{ padding: {px(3, 2)}px {px(10, 7)}px; }}
