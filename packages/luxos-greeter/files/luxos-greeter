    # -- tapeta + rozmazana kopie pro matne panely --
    def background_path(self):
        if self.cfg["user-background"] and self.user and self.user.background:
            p = self.user.background
            if os.path.isfile(p) and os.access(p, os.R_OK):
                return p
        return self.cfg["background"]

    def build_backgrounds(self):
        if not self.get_realized():
            self.realize()
            # bez pozadi X okna: pred prvnim vykreslenim zadne cerne okno (plynuly prechod ze splashe)
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                self.get_window().set_background_pattern(None)
        path = self.background_path()
        if getattr(self, "_bg_key", None) == (path, self.W, self.H, str([(m.x, m.y, m.width, m.height) for m in self.monitors])):
            return
        self._bg_key = (path, self.W, self.H, str([(m.x, m.y, m.width, m.height) for m in self.monitors]))
        t0 = time.monotonic()
        pb = load_pixbuf(path) or load_pixbuf(DEFAULT_BG)
        win = self.get_window()
        surf = win.create_similar_surface(cairo.CONTENT_COLOR, self.W, self.H)
        cr = cairo.Context(surf)
        for m in self.monitors:
            cr.save()
            cr.rectangle(m.x, m.y, m.width, m.height)
            cr.clip()
            if pb:
                pw, ph = pb.get_width(), pb.get_height()
                sc = max(m.width / pw, m.height / ph)
                tw, th = max(1, round(pw * sc)), max(1, round(ph * sc))
                scaled = pb.scale_simple(tw, th, GdkPixbuf.InterpType.BILINEAR)
                Gdk.cairo_set_source_pixbuf(cr, scaled, m.x + (m.width - tw) / 2, m.y + (m.height - th) / 2)
                cr.paint()
            else:  # nahradni prechod v barvach LuxOS
                g = cairo.LinearGradient(m.x, m.y, m.x + m.width, m.y + m.height)
                g.add_color_stop_rgb(0, 0.10, 0.11, 0.25)
                g.add_color_stop_rgb(0.6, 0.27, 0.20, 0.52)
                g.add_color_stop_rgb(1, 0.55, 0.36, 0.78)
                cr.set_source(g)
                cr.paint()
            cr.restore()
        self.bg_surf = surf
        # rozmazani: zmensit na ~64 px vysky, rozmazat, zvetsit bilinearne
        sh = 64
        sw = max(8, round(self.W * sh / self.H))
        small = cairo.ImageSurface(cairo.FORMAT_RGB24, sw, sh)
        c2 = cairo.Context(small)
        c2.scale(sw / self.W, sh / self.H)
        c2.set_source_surface(surf, 0, 0)
        c2.get_source().set_filter(cairo.FILTER_GOOD)
        c2.paint()
        box_blur(small, radius=2, passes=3)
        blur = win.create_similar_surface(cairo.CONTENT_COLOR, self.W, self.H)
        c3 = cairo.Context(blur)
        c3.scale(self.W / sw, self.H / sh)
        c3.set_source_surface(small, 0, 0)
        c3.get_source().set_filter(cairo.FILTER_BILINEAR)
        c3.get_source().set_extend(cairo.EXTEND_PAD)
        c3.paint()
        self.blur_surf = blur
        log(f"background {path} {self.W}x{self.H} ready in {time.monotonic() - t0:.2f}s")

    # -- kresleni --
    def draw_bg(self, _w, cr):
        if self.bg_surf:
            cr.set_source_surface(self.bg_surf, 0, 0)
            cr.paint()
        e = ease(self.t)
        # jemne ztmaveni pri prihlaseni
        cr.set_source_rgba(0, 0, 0, 0.10 + 0.14 * e)
        cr.paint()
        m = self.mon
        u = self.u
        now = time.localtime()
        try:
            clock = time.strftime(self.cfg["clock"], now)
            date = time.strftime(self.cfg["date"], now)
        except ValueError:
            clock, date = time.strftime("%H:%M", now), time.strftime("%x", now)
        cx = m.x + m.width / 2
        y0 = m.y + m.height * 0.105 - e * m.height * 0.045
        alpha = 1.0 - 0.12 * e
        f = self.cfg["font"]
        dl = text_layout(cr, date, 27 * u, Pango.Weight.SEMIBOLD, f)
        _ink, logi = dl.get_pixel_extents()
        self.shadow_text(cr, dl, cx - logi.width / 2, y0, alpha * 0.92, 2 * u)
        cl = text_layout(cr, clock, 180 * u, Pango.Weight.ULTRALIGHT, f)
        ink, _logi = cl.get_pixel_extents()
        # horni okraj cislic tesne pod datum
        cy = y0 + logi.height + 14 * u - ink.y
        self.shadow_text(cr, cl, cx - ink.x - ink.width / 2, cy, alpha, 4 * u)
        return False

    def shadow_text(self, cr, lay, x, y, alpha, blur):
        # mekky stin: nekolik posunutych kopii s malou pruhlednosti
        for dx, dy in ((0, 1), (0, 2), (-1, 1.5), (1, 1.5), (0, 3)):
            cr.move_to(x + dx * blur * 0.35, y + dy * blur * 0.45)
            cr.set_source_rgba(0, 0, 0, 0.055 * alpha)
            PangoCairo.show_layout(cr, lay)
        cr.move_to(x, y)
        cr.set_source_rgba(1, 1, 1, alpha)
        PangoCairo.show_layout(cr, lay)

    def frost(self, widget, cr, x, y, w, h, r, tint, border=0.18):
        """Matny panel: vyrez rozmazane tapety pod widgetem + svetly zavoj + jemny okraj."""
        ox, oy = widget.translate_coordinates(self, 0, 0) or (0, 0)
        cr.save()
        rounded(cr, x, y, w, h, r)
        cr.clip()
        if self.blur_surf:
            cr.set_source_surface(self.blur_surf, -ox, -oy)
            cr.paint()
        cr.set_source_rgba(1, 1, 1, tint)
        cr.paint()
        cr.restore()
        rounded(cr, x + 0.5, y + 0.5, w - 1, h - 1, r)
        cr.set_source_rgba(1, 1, 1, border)
        cr.set_line_width(1)
        cr.stroke()

    def draw_frost_widget(self, w, cr, radius_frac, tint):
        a = w.get_allocation()
        hover = w.get_state_flags() & Gtk.StateFlags.PRELIGHT
        self.frost(w, cr, 0, 0, a.width, a.height, a.height * radius_frac, tint + (0.06 if hover else 0))
        if w.has_visible_focus():
            self.focus_ring(cr, 0, 0, a.width, a.height, a.height * radius_frac)
        return False

    def set_placeholder(self, text):
        self.placeholder = text
        self.pw.queue_draw()

    def draw_pw(self, w, cr):
        """Pole pro heslo: matny ovál + vlastni zastupny text (GTK 3 ho u aktivniho pole skryva)."""
        self.draw_frost_widget(w, cr, 0.5, 0.20)
        if self.placeholder and not self.entry.get_text():
            ex, ey = self.entry.translate_coordinates(w, 0, 0) or (0, 0)
            ea = self.entry.get_allocation()
            lay = text_layout(cr, self.placeholder, self.sz["pw_font"], Pango.Weight.NORMAL, self.cfg["font"])
            lay.set_width((ea.width - self.sz["pw_pad"] - 4) * Pango.SCALE)
            lay.set_ellipsize(Pango.EllipsizeMode.END)
            _i, lg = lay.get_pixel_extents()
            cr.new_path()
            cr.move_to(ex + self.sz["pw_pad"] + 2, ey + (ea.height - lg.height) / 2)
            cr.set_source_rgba(1, 1, 1, 0.62 if self.entry.get_sensitive() else 0.35)
            PangoCairo.show_layout(cr, lay)
        return False

    def focus_ring(self, cr, x, y, w, h, r):
        rounded(cr, x + 1, y + 1, w - 2, h - 2, r)
        cr.set_source_rgba(1, 1, 1, 0.75)
        cr.set_line_width(2)
        cr.stroke()

    def draw_round(self, area, cr, btn, icon):
        a = area.get_allocation()
        d = self.sz["round"]
        x, y = (a.width - d) / 2, (a.height - d) / 2
        fl = btn.get_state_flags()
        tint = 0.16 + (0.10 if fl & Gtk.StateFlags.PRELIGHT else 0) + (0.12 if fl & Gtk.StateFlags.ACTIVE else 0)
        self.frost(area, cr, x, y, d, d, d / 2, tint)
        if btn.has_visible_focus():
            cr.new_path()
            cr.arc(a.width / 2, a.height / 2, d / 2 + 2.5, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.8)
            cr.set_line_width(2)
            cr.stroke()
        cr.set_source_rgba(1, 1, 1, 0.95)
        icon(cr, a.width / 2, a.height / 2, d * 0.46)
        return False

    def draw_go(self, area, cr):
        a = area.get_allocation()
        d = a.height - max(8, round(self.sz["pw_h"] * 0.26))
        cx, cy = a.width / 2 - 2, a.height / 2
        has = bool(self.entry.get_text()) or self.ready
        hover = self.go.get_state_flags() & Gtk.StateFlags.PRELIGHT
        cr.arc(cx, cy, d / 2, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, (0.30 if has else 0.12) + (0.1 if hover else 0))
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 0.95 if has else 0.55)
        icon_arrow(cr, cx, cy, d * 0.62)
        if self.go.has_visible_focus():
            cr.new_path()
            cr.arc(cx, cy, d / 2 + 2, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.8)
            cr.set_line_width(1.5)
            cr.stroke()
        return False

    def draw_avatar(self, area, cr, user, btn):
        a = area.get_allocation()
        d = self.sz["avatar"]
        cx, cy = a.width / 2, a.height / 2
        selected = user is self.user
        multi = len(self.users) > 1
        if multi and not selected:
            d = round(d * 0.8)
        # obrazek z AccountsService (lightdm nema pristup do domovu uzivatelu)
        key = (user.name, d)
        cache = self.__dict__.setdefault("_avatars", {})
        if key not in cache:
            pb = None
            for p in (user.image, os.path.join(ACCOUNTS_ICONS, user.name) if user.name else None):
                pb = load_pixbuf(p)
                if pb:
                    break
            if pb:
                pw, ph = pb.get_width(), pb.get_height()
                sc = max(d / pw, d / ph)
                pb = pb.scale_simple(max(1, round(pw * sc)), max(1, round(ph * sc)), GdkPixbuf.InterpType.HYPER)
            cache[key] = pb
        pb = cache[key]
        # stin
        cr.arc(cx, cy + d * 0.03, d / 2 + 1, 0, 2 * math.pi)
        cr.set_source_rgba(0, 0, 0, 0.18)
        cr.fill()
        cr.save()
        cr.arc(cx, cy, d / 2, 0, 2 * math.pi)
        cr.clip()
        if pb:
            Gdk.cairo_set_source_pixbuf(cr, pb, cx - pb.get_width() / 2, cy - pb.get_height() / 2)
            cr.paint()
        elif user.name is None or user.name == "*guest":
            self.frost(area, cr, cx - d / 2, cy - d / 2, d, d, d / 2, 0.22, 0)
            cr.set_source_rgba(1, 1, 1, 0.9)
            icon_person(cr, cx, cy, d * 0.62)
        else:
            g = cairo.LinearGradient(cx - d / 2, cy - d / 2, cx + d / 2, cy + d / 2)
            g.add_color_stop_rgb(0, 0.30, 0.52, 1.0)   # modra
            g.add_color_stop_rgb(1, 0.66, 0.42, 0.98)  # fialova
            cr.set_source(g)
            cr.paint()
            initial = (user.real_name or user.name or "?").strip()[:1].upper() or "?"
            lay = text_layout(cr, initial, d * 0.44, Pango.Weight.MEDIUM, self.cfg["font"])
            ink, _l = lay.get_pixel_extents()
            cr.move_to(cx - ink.x - ink.width / 2, cy - ink.y - ink.height / 2)
            cr.set_source_rgba(1, 1, 1, 0.97)
            PangoCairo.show_layout(cr, lay)
        cr.restore()
        hover = btn.get_state_flags() & Gtk.StateFlags.PRELIGHT
        cr.new_path()
        cr.arc(cx, cy, d / 2 - 0.5, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.55 if (hover and multi) else 0.22)
        cr.set_line_width(1.5 if hover else 1)
        cr.stroke()
        if btn.has_visible_focus():
            cr.new_path()
            cr.arc(cx, cy, d / 2 + 3, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.85)
            cr.set_line_width(2)
            cr.stroke()
        return False

    def draw_battery(self, area, cr):
        if self._battery is None:
            return False
        a = area.get_allocation()
        h = self.sz["status"] * 0.78
        icon_battery(cr, 1, (a.height - h) / 2, h, *self._battery)
        return False

    def draw_net(self, area, cr):
        if not self._network:
            return False
        a = area.get_allocation()
        s = self.sz["status"]
        cr.set_source_rgba(1, 1, 1, 0.95)
        (icon_wifi if self._network == "wifi" else icon_wired)(cr, (a.width - s) / 2, (a.height - s) / 2, s)
        return False

    # -- periodicke aktualizace --
    def tick(self):
        now = time.localtime()
        if now.tm_min != self.last_minute:
            self.last_minute = now.tm_min
            self.bg.queue_draw()
        if self.target > 0 and not self.awaiting_result() and \
                time.monotonic() - self.last_input > self.cfg["idle"]:
            self.set_active(False)
        return True

    def update_status(self):
        self._battery = battery_state() if self.cfg["battery"] else None
        self._network = network_state() if self.cfg["network"] else None
        self.bat_icon.set_visible(self._battery is not None)
        self.bat_label.set_visible(self._battery is not None)
        if self._battery is not None:
            self.bat_label.set_text(f"{self._battery[0]} %" if LANG == "cs" else f"{self._battery[0]}%")
        self.net_icon.set_visible(bool(self._network))
        self.bat_icon.queue_draw()
        self.net_icon.queue_draw()
        self.update_keyboard()
        return True

    def update_keyboard(self):
        self.kbd_btn.get_child().set_text(self.kbd.label())
        debug("layout", self.kbd.label())
        self.kbd_btn.set_visible(True)
        self.update_caps()

    def update_caps(self):
        km = Gdk.Keymap.get_for_display(Gdk.Display.get_default())
        caps = km.get_caps_lock_state()
        if caps and not self.error_shown and not self.hint.get_text():
            self.show_hint(_("Caps Lock is on"), False, caps=True)
        elif not caps and getattr(self, "_caps_hint", False):
            self.show_hint("", False)

    def switch_layout(self):
        self.kbd.next()
        GLib.timeout_add(60, lambda: self.update_keyboard() or False)
        if self.target > 0:
            self.entry.grab_focus_without_selecting()

    # -- prechody klid <-> prihlaseni --
    def set_login_visible(self, on):
        for w in (self.login, self.power):
            w.set_visible(on)

    def debug_geometry(self):
        for name, w in [("user-" + str(b.user.name), b) for b in self.user_buttons] + \
                [("power-" + b.key, b) for b in self.power_buttons] + [("entry", self.entry), ("layout", self.kbd_btn)]:
            if w.get_mapped():
                x, y = w.translate_coordinates(self, 0, 0)
                a = w.get_allocation()
                debug("geom", name, x + a.width // 2, y + a.height // 2)
        return False

    def set_active(self, on):
        target = 1.0 if on else 0.0
        if target == self.target:
            return
        debug("state", "login" if on else "idle")
        self.target = target
        self.touch()
        if on:
            self.set_login_visible(True)
            self.apply_t()
            self.start_auth()
            self.entry.grab_focus_without_selecting()
        else:
            self.backend.cancel()
            self.awaiting = self.ready = False
            self.pending = None
            self.entry.set_text("")
            self.show_hint("", False)
            self.set_focus(None)
        self.anim_from = (self.t, GLib.get_monotonic_time())
        if not self.anim_id:
            self.anim_id = GLib.timeout_add(16, self.animate)

    def animate(self):
        t0, start = self.anim_from
        dur = 380000.0 if self.target > t0 else 520000.0
        p = min(1.0, (GLib.get_monotonic_time() - start) / dur)
        self.t = t0 + (self.target - t0) * p
        self.apply_t()
        if p >= 1.0:
            self.anim_id = 0
            if self.target == 0:
                self.set_login_visible(False)
            elif DEBUG:
                GLib.idle_add(self.debug_geometry)
            return False
        return True

    def apply_t(self):
        e = ease(self.t)
        self.login.set_opacity(e)
        self.power.set_opacity(e)
        # obsah prijizdi lehce zdola
        off = round((1 - e) * 24 * self.u)
        self.login.set_margin_bottom(self.H - (self.mon.y + self.mon.height) + round(150 * self.u) - off)
        self.bg.queue_draw()

    def touch(self):
        self.last_input = time.monotonic()

    def awaiting_result(self):
        return not self.awaiting and self.prompted and self.backend_in_auth()

    def backend_in_auth(self):
        try:
            return self.backend.g.get_in_authentication()
        except AttributeError:
            return getattr(self.backend, "state", None) == "wait"

    # -- vstup --
    def on_key(self, _w, ev):
        self.touch()
        name = Gdk.keyval_name(ev.keyval) or ""
        if name == "Caps_Lock":
            GLib.timeout_add(50, lambda: self.update_caps() or False)
        if name in ("ISO_Next_Group", "ISO_Prev_Group"):
            GLib.timeout_add(50, lambda: self.update_keyboard() or False)
        # Ctrl/Super+Mezernik prepina rozlozeni vzdy (jako v macOS), i kdyz Alt+Shift obstarava X
        if name == "space" and len(self.kbd.layouts) > 1 and ev.state & (
                Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
            self.switch_layout()
            return True
        # Alt+Shift, pokud prepinani neobstarava samo X
        if not self.kbd.x_handles_toggle and len(self.kbd.layouts) > 1 and (
                (name.startswith("Shift") and ev.state & Gdk.ModifierType.MOD1_MASK)
                or (name.startswith("Alt") and ev.state & Gdk.ModifierType.SHIFT_MASK)):
            self.switch_layout()
            return True
        if self.target == 0:
            if name in self.MODIFIERS:
                return False
            printable = Gdk.keyval_to_unicode(ev.keyval) >= 32 and not (
                ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK))
            self.set_active(True)
            # prvni znak rovnou do pole s heslem
            return not printable
        if name == "Escape":
            self.set_active(False)
            return True
        focus = self.get_focus()
        if focus is not self.entry and Gdk.keyval_to_unicode(ev.keyval) >= 32 and not (
                ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK)):
            self.entry.grab_focus_without_selecting()
        return False

    def on_button(self, _w, ev):
        self.touch()
        if self.target == 0 and ev.type == Gdk.EventType.BUTTON_PRESS:
            self.set_active(True)
            return True
        return False

    def on_motion(self, _w, _ev):
        # Pohyb mysi jen prodlouzi necinnost; prihlaseni ukaze az klik nebo klavesa (jako macOS)
        self.touch()
        return False

    def on_entry_changed(self, _e):
        self.touch()
        self.go_area.queue_draw()
        self.pw.queue_draw()
        if self.error_shown and self.entry.get_text():
            self.show_hint("", False)

    def on_user_clicked(self, _b, user):
        self.touch()
        if user is self.user:
            self.entry.grab_focus_without_selecting()
            return
        self.user = user
        debug("user", user.name)
        self.session = self._session_for(user, self.session)
        self.update_users()
        self.update_session_button()
        self.entry.set_text("")
        self.show_hint("", False)
        if self.cfg["user-background"] and self.background_path() != self._bg_key[0]:
            self.build_backgrounds()
            self.queue_draw()
        self.start_auth()
        self.entry.grab_focus_without_selecting()

    def update_users(self):
        multi = len(self.users) > 1
        for b in self.user_buttons:
            sel = b.user is self.user
            b.name_label.set_opacity(1.0 if sel or not multi else 0.7)
            b.avatar.set_opacity(1.0 if sel or not multi else 0.75)
            b.avatar.queue_draw()

    def session_name(self):
        return dict(self.sessions).get(self.session, self.session or "")

    def update_session_button(self):
        if self.session_btn:
            self.session_btn.label.set_text(self.session_name())

    def next_session(self):
        keys = [k for k, _n in self.sessions]
        i = keys.index(self.session) if self.session in keys else -1
        self.session = keys[(i + 1) % len(keys)]
        debug("session", self.session)
        self.update_session_button()
        self.touch()

    def do_power(self, what):
        self.touch()
        try:
            self.backend.power(what)
        except GLib.Error as e:
            log("power", what, e.message)
            self.show_hint(_("This action is not available right now."), True)

    # -- autentizace (postup jako lightdm-gtk-greeter) --
    def start_auth(self):
        self.awaiting = self.prompted = self.ready = False
        self.pending = None
        self.entry.set_editable(True)
        self.entry.set_sensitive(True)
        if self.user.name is None:
            self.entry.set_visibility(True)
            self.set_placeholder(_("Username"))
        try:
            self.backend.authenticate(self.user)
        except GLib.Error as e:
            log("authenticate:", e.message)
            self.show_hint(e.message, True)

    def on_prompt(self, text, secret):
        debug("prompt", repr(text), "secret" if secret else "visible")
        self.prompted = self.awaiting = True
        self.entry.set_sensitive(True)
        self.entry.set_editable(True)
        self.entry.set_visibility(not secret)
        t = (text or "").strip().rstrip(":").strip()
        if secret and (not t or t.lower() == "password"):
            ph = _("Enter Password")
        elif not secret and t.lower() in ("login", "username", "user name"):
            ph = _("Username")
        else:
            ph = t
        self.set_placeholder(ph)
        if self.target > 0:
            self.entry.grab_focus_without_selecting()
        if self.pending is not None:
            p, self.pending = self.pending, None
            self.respond(p)
        return False

    def on_message(self, text, is_error):
        self.show_hint(text, is_error)
        if is_error:
            self.error_shown = True

    def on_complete(self):
        self.awaiting = False
        debug("complete", "idle" if self.target == 0 else self.backend.is_authenticated())
        if self.target == 0:
            return                  # zrusena autentizace po navratu na hodiny
        if self.backend.is_authenticated():
            if self.prompted:
                self.launch()
            else:
                # overeno bez hesla (napr. ucet bez hesla): potvrdit Enterem nebo sipkou
                self.ready = True
                self.entry.set_text("")
                self.entry.set_editable(False)
                self.set_placeholder(_("Log In"))
                self.go_area.queue_draw()
            return
        if not self.error_shown:
            self.show_hint(_("Incorrect password. Try again."), True)
        self.error_shown = True
        self.shake()
        self.entry.set_text("")
        # novy pokus pro stejneho uzivatele
        self.start_auth_keep_hint()

    def start_auth_keep_hint(self):
        hint, err = self.hint.get_text(), self.error_shown
        self.start_auth()
        self.show_hint(hint, err)

    def launch(self):
        debug("start session", self.session, "user", self.user.name)
        self._save_state()
        try:
            self.backend.start_session(self.session)
        except GLib.Error as e:
            log("start session:", e.message)
            self.show_hint(_("Could not start the session."), True)
            self.shake()
            self.start_auth_keep_hint()

    def submit(self):
        self.touch()
        if self.target == 0:
            self.set_active(True)
            return
        if self.ready:
            self.launch()
            return
        text = self.entry.get_text()
        if not self.awaiting:
            if self.prompted and self.backend_in_auth():
                return              # odpoved odeslana, ceka se na vysledek
            # vyzva jeste neprisla: odpoved si podrzet a poslat s ni
            if not self.backend_in_auth():
                self.start_auth_keep_hint()
            self.pending = text
            self.entry.set_text("")
            return
        self.respond(text)

    def respond(self, text):
        self.awaiting = False
        self.entry.set_text("")
        self.entry.set_sensitive(False)
        self.show_hint("", False)
        try:
            self.backend.respond(text)
        except GLib.Error as e:
            log("respond:", e.message)

    def show_hint(self, text, error, caps=False):
        self._caps_hint = caps and bool(text)
        if not error:
            self.error_shown = False
        self.hint.set_text(text or "")
        ctx = self.hint.get_style_context()
        (ctx.add_class if error else ctx.remove_class)("error")

    def shake(self):
        if self.shake_id:
            GLib.source_remove(self.shake_id)
        start = GLib.get_monotonic_time()
        base = 0

        def step():
            p = (GLib.get_monotonic_time() - start) / 480000.0
            if p >= 1:
                self.pw.set_margin_start(base)
                self.pw.set_margin_end(base)
                self.shake_id = 0
                return False
            dx = round(math.sin(p * math.pi * 8) * (1 - p) * 16 * self.u)
            # posun doprava = vetsi levy okraj; Gtk.Align.CENTER drzi stred
            self.pw.set_margin_start(max(0, 2 * dx))
            self.pw.set_margin_end(max(0, -2 * dx))
            return True
        self.shake_id = GLib.timeout_add(16, step)


def main():
    ap = argparse.ArgumentParser(description="LuxOS LightDM greeter")
    ap.add_argument("--demo", action="store_true", help="run without LightDM (password: luxos)")
    ap.add_argument("--users", type=int, default=1, help="demo: number of users")
    ap.add_argument("--sessions", type=int, default=1, help="demo: number of sessions")
    ap.add_argument("--lock", action="store_true", help="demo: behave like a lock screen")
    args = ap.parse_args()
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    cfg = load_config()
    settings = Gtk.Settings.get_default()
    settings.set_property("gtk-application-prefer-dark-theme", True)
    settings.set_property("gtk-cursor-theme-name", cfg["cursor-theme"])
    settings.set_property("gtk-font-name", f"{cfg['font']} 11")
    disp = Gdk.Display.get_default()
    if disp is None:
        log("no X display")
        return 1
    root = Gdk.get_default_root_window()
    root.set_cursor(Gdk.Cursor.new_from_name(disp, "default") or Gdk.Cursor.new_for_display(disp, Gdk.CursorType.LEFT_PTR))
    win = Greeter(args)
    win.present()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
