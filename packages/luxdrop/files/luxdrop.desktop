[Desktop Entry]
Type=Application
Name=LuxDrop
GenericName=Send files nearby
GenericName[cs]=Posílání souborů v okolí
Comment=Securely send files and folders to nearby LuxOS computers and LocalSend apps
Comment[cs]=Bezpečné posílání souborů a složek na počítače LuxOS a do aplikace LocalSend v okolí
Exec=luxdrop %F
Icon=luxdrop
Terminal=false
Categories=Network;FileTransfer;GTK;
Keywords=share;send;transfer;nearby;LocalSend;sdílet;poslat;přenos;
MimeType=application/octet-stream;inode/directory;
StartupNotify=true
StartupWMClass=luxdrop
