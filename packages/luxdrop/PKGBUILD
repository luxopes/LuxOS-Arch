# Maintainer: LuxOS Team
# LuxDrop - bezpecne posilani souboru mezi pocitaci LuxOS v mistni siti
# (TLS 1.3, pripnute klice, overovaci kod, mDNS pres Avahi) a s aplikaci LocalSend
# (protokol v2: HTTPS + mTLS, multicast 224.0.0.167:53317). Protokol: files/PROTOCOL.md
# Soubory jineho pocitace (luxdrop connect / share): SFTP (OpenSSH sftp-server v bubblewrap, jen
# sdilene slozky) tunelovane pres TLS 1.3 s overenim LuxDrop; u klienta sshfs (FUSE) - bez sshd.

pkgname=luxdrop
pkgver=1.0.0
pkgrel=4
pkgdesc="LuxOS LuxDrop - securely send files to nearby LuxOS computers and LocalSend apps"
arch=(any)
url="https://lsl.lux-ai.cz/luxos/"
license=(GPL-3.0-or-later)
depends=(python python-gobject gtk3 python-cairo python-cryptography python-pyopenssl avahi nss-mdns luxos-i18n
         xdg-utils
         # Soubory jineho pocitace: sftp-server (openssh), sandbox (bubblewrap), pripojeni (sshfs + fuse3),
         # rozdelene okno Souboru (xdotool: F3 + Alt+Home v novem okne Thunaru)
         openssh bubblewrap sshfs xdotool)
makedepends=(python-cryptography)  # jen pro check()
optdepends=('thunar: "Send To > LuxDrop" in the file manager'
            'xfce4-notifyd: accept dialogs of the background receiver')

check() {
    # Jednotkove testy (ramce, SAS vektory, cesty, SHA-256); integracni testy jsou v tests/
    cd "$startdir"
    if ! python3 -c "import cryptography" 2>/dev/null; then
        echo "python-cryptography is not installed - skipping unit tests" >&2
        return 0
    fi
    LUXDROP_LIB="$startdir/files/lib" python3 -m unittest -q tests/test_unit.py tests/test_localsend_unit.py \
        tests/test_remote_unit.py
}

package() {
    local f="$startdir/files"
    install -Dm755 "$f/luxdrop" "$pkgdir/usr/bin/luxdrop"
    install -Dm644 -t "$pkgdir/usr/lib/luxdrop/luxdrop" "$f"/lib/luxdrop/*.py
    python3 -m compileall -q -d /usr/lib/luxdrop "$pkgdir/usr/lib/luxdrop"
    install -Dm644 "$f/luxdrop.desktop" "$pkgdir/usr/share/applications/luxdrop.desktop"
    install -Dm644 "$f/luxdrop.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/luxdrop.svg"
    install -Dm644 "$f/luxdrop-receiver.service" "$pkgdir/usr/lib/systemd/user/luxdrop-receiver.service"
    # Sdilene slozky pro jine pocitace (vypnuto, zapina "luxdrop share on" / Nastaveni) a Pripojit k pocitaci
    install -Dm644 "$f/luxdrop-files.service" "$pkgdir/usr/lib/systemd/user/luxdrop-files.service"
    install -Dm644 "$f/luxdrop-connect.desktop" "$pkgdir/usr/share/applications/luxdrop-connect.desktop"
    # Thunar: "Odeslat do > LuxDrop" (bez zasahu do uca.xml)
    install -Dm644 "$f/thunar/luxdrop-sendto.desktop" "$pkgdir/usr/share/Thunar/sendto/luxdrop.desktop"
    # Vlastni akce Thunaru - nutno vlozit do uca.xml dodavaneho LuxOS (viz komentar v souboru)
    install -Dm644 "$f/thunar/uca-luxdrop.xml" "$pkgdir/usr/share/luxdrop/thunar-uca-luxdrop.xml"
    install -Dm644 "$f/PROTOCOL.md" "$pkgdir/usr/share/doc/luxdrop/PROTOCOL.md"
    # Firewall (LuxOS zadny nedodava): definice sluzby pro firewalld a profil pro ufw - nic samy neotviraji
    install -Dm644 "$f/firewall/luxdrop-firewalld.xml" "$pkgdir/usr/lib/firewalld/services/luxdrop.xml"
    install -Dm644 "$f/firewall/luxdrop-ufw" "$pkgdir/etc/ufw/applications.d/luxdrop"
}
