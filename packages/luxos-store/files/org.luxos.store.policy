<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LuxOS</vendor>
  <action id="org.luxos.store.manage">
    <description>Install, remove and update apps</description>
    <description xml:lang="cs">Instalace, odebrání a aktualizace aplikací</description>
    <message>Authentication is required to install, remove or update apps</message>
    <message xml:lang="cs">Instalace, odebrání nebo aktualizace aplikací vyžaduje ověření</message>
    <icon_name>luxos-store</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/luxos/luxos-store-helper</annotate>
  </action>
</policyconfig>
