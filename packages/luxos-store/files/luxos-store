class AppCard(Gtk.EventBox):
    def __init__(self, store, app):
        super().__init__()
        self.store, self.app = store, app
        box = Gtk.Box(spacing=12)
        box.get_style_context().add_class("card")
        box.set_size_request(300, -1)
        self.image = Gtk.Image()
        self.image.set_size_request(ICON_SIZE, ICON_SIZE)
        box.pack_start(self.image, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, spacing=2)
        name = Gtk.Label(label=app.name, xalign=0, ellipsize=Pango.EllipsizeMode.END)
        name.get_style_context().add_class("card-name")
        text.pack_start(name, False, False, 0)
        if app.is_luxos:
            badge = Gtk.Label(label="✦ LuxOS", xalign=0)
            badge.get_style_context().add_class("badge")
            text.pack_start(badge, False, False, 0)
        sub = Gtk.Label(label=app.summary, xalign=0, wrap=True, lines=2,
                        ellipsize=Pango.EllipsizeMode.END, max_width_chars=30)
        sub.get_style_context().add_class("card-sub")
        text.pack_start(sub, False, False, 0)
        box.pack_start(text, True, True, 0)
        self.button = Gtk.Button(valign=Gtk.Align.CENTER, can_focus=False)
        self.button.get_style_context().add_class("get")
        self.button.connect("clicked", lambda _b: store.primary_action(app))
        box.pack_end(self.button, False, False, 0)
        self.add(box)
        self.connect("button-release-event", self.on_click)
        self.update()
        GLib.idle_add(self.load_icon)

    def load_icon(self):
        pix = self.app.icon_pixbuf(ICON_SIZE)
        if pix:
            self.image.set_from_pixbuf(pix)
        return False

    def on_click(self, _w, ev):
        if ev.button == 1:
            self.store.show_detail(self.app)

    def update(self):
        busy = self.store.busy.get(self.app.pkg)
        if busy:
            self.button.set_label(busy)
            self.button.set_sensitive(False)
        else:
            self.button.set_sensitive(True)
            self.button.set_label(_("Open") if self.app.pkg in self.store.catalog.installed else _("Get"))


