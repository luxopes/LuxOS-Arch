            ver = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            ver.set_markup("%s  →  <b>%s</b>" % (GLib.markup_escape_text(old), GLib.markup_escape_text(new))
                           if old or new else "")
            ver.get_style_context().add_class("upd-ver")
            text.pack_start(ver, False, False, 0)
            box.pack_start(text, True, True, 0)
            stack = Gtk.Stack()
            state = Gtk.Image()
            state.set_pixel_size(16)
            sp = Gtk.Spinner()
            stack.add_named(state, "icon")
            stack.add_named(sp, "spin")
            box.pack_end(stack, False, False, 0)
            row.add(box)
            row.show_all()
            stack.set_no_show_all(True)
            stack.hide()
            self.rows[name] = (stack, state, sp)
            self.listbox.add(row)
        n = len(self.order)
        self.list_title.set_text(_("%d updates") % n if n != 1 else _("1 update"))
        self.list_title.set_visible(bool(n))
        self.listbox.set_visible(bool(n))

    def set_state(self, name, state):
        if name not in self.rows:
            return
        stack, img, sp = self.rows[name]
        stack.show()
        stack.show_all()
        if state == "busy":
            sp.start()
            stack.set_visible_child_name("spin")
        else:
            sp.stop()
            icon, css = self.STATES[state]
            img.set_from_icon_name(icon, Gtk.IconSize.MENU)
            ctx = img.get_style_context()
            for c in ("upd-ok", "upd-err", "upd-pending"):
                ctx.remove_class(c)
            ctx.add_class(css)
            stack.set_visible_child_name("icon")

    # ---- prubeh aktualizace ----
    def start(self):
        self.running = True
        self.logbuf.set_text("")
        self.summary(None, None, _("Updating your computer…"),
                     _("You can keep working. Some apps may need to be restarted afterwards."), spin=True)
        self.set_buttons()
        self.step.set_text(_("Preparing…"))
        self.bar.set_fraction(0)
        self.pct.set_text("0 %")
        self.prog_box.show()
        self.expander.show()
        for name in self.rows:
            self.set_state(name, "pending")

    def progress(self, frac, text):
        frac = max(0.0, min(1.0, frac))
        self.bar.set_fraction(frac)
        self.pct.set_text("%d %%" % round(frac * 100))
        if text:
            self.step.set_text(text)

    def package(self, name):
        """Prave se instaluje balicek name: predchozi je hotovy."""
        if name == self.current:
            return
        if self.current:
            self.set_state(self.current, "done")
        self.current = name
        self.set_state(name, "busy")

    def log(self, line):
        end = self.logbuf.get_end_iter()
        self.logbuf.insert(end, line + "\n")
        if self.expander.get_expanded():
            self.log_view.scroll_to_iter(self.logbuf.get_end_iter(), 0, False, 0, 1)

    def finish(self, ok, message="", cancelled=False):
        self.running = False
        self.finished = True
        self.prog_box.hide()
        n = len(self.rows)
        if ok:
            for name in self.rows:
                self.set_state(name, "done")
            reboot = any(REBOOT_PKGS.match(nm) for nm in self.rows)
            self.summary("emblem-ok-symbolic", "upd-ok", _("Your computer is up to date"),
                         (_("%d packages were updated.") % n if n else _("All updates were installed.")) +
                         ("  " + _("Restart your computer to finish the update.") if reboot else ""))
            self.list_title.set_text(_("Updated"))
        else:
            for name in self.rows:
                stack, img, sp = self.rows[name]
                if name == self.current:
                    self.set_state(name, "failed")
                elif sp.get_property("active"):
                    self.set_state(name, "pending")
            if self.current is None and not cancelled:
                for name in self.rows:
                    self.set_state(name, "pending")
            if cancelled:
                self.summary("dialog-information-symbolic", "upd-blue", _("The update was cancelled"),
                             _("Nothing was changed."))
            else:
                self.summary("dialog-error-symbolic", "upd-err", _("The update could not be finished"),
                             message or _("unknown error"))
                self.expander.set_expanded(True)
        retry = Gtk.Button(label=_("Check for Updates"))
        retry.connect("clicked", lambda _b: self.store.show_page("updates", "check"))
        self.set_buttons(retry)


