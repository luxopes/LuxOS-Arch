    def find(self, text):
        t = text.lower()
        scored = []
        for a in self.catalog.apps.values():
            name = a.name.lower()
            if t in name or t in a.pkg:
                scored.append((0 if name.startswith(t) else 1, a))
            elif t in a.summary.lower():
                scored.append((2, a))
        scored.sort(key=lambda s: (s[0], not s[1].is_luxos, s[1].name.lower()))
        return [a for _s, a in scored[:120]]

