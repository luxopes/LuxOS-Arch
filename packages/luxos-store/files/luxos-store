        self.scroll.add(page)
        self.scroll.get_vadjustment().set_value(0)
        self.back.set_visible(bool(self.history))
        self.scroll.show_all()

    def show_page(self, key, arg=None):
        self.current = (key, arg)
        apps = self.catalog.apps
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        if key == "discover":
            box.pack_start(self.hero(), False, False, 0)
            lux = sorted((a for a in apps.values() if a.is_luxos), key=lambda a: a.name.lower())
            if lux:
                box.pack_start(self.section(_("From LuxOS")), False, False, 0)
                box.pack_start(self.grid(lux), False, False, 0)
            popular = [apps[p] for p in POPULAR if p in apps]
            box.pack_start(self.section(_("Popular apps")), False, False, 0)
            box.pack_start(self.grid(popular), False, False, 0)
        elif key == "luxos":
            box.pack_start(self.title(_("LuxOS Apps")), False, False, 0)
            box.pack_start(self.dim(_("Apps made for LuxOS, signed by the LuxOS team.")), False, False, 0)
            box.pack_start(self.grid(sorted((a for a in apps.values() if a.is_luxos), key=lambda a: a.name.lower())),
                           False, False, 0)
        elif key == "installed":
            self.catalog.refresh_installed()
            box.pack_start(self.title(_("Installed")), False, False, 0)
            inst = [a for a in apps.values() if a.pkg in self.catalog.installed]
            box.pack_start(self.grid(sorted(inst, key=lambda a: a.name.lower())), False, False, 0)
        elif key == "updates":
            box.pack_start(self.updates_page(), False, False, 0)
        elif key == "search":
            box.pack_start(self.title(_("Results for “%s”") % arg), False, False, 0)
            box.pack_start(self.grid(self.find(arg)), False, False, 0)
        else:
            for ckey, label, cats, _icon in CATEGORIES:
                if ckey == key:
                    box.pack_start(self.title(_(label)), False, False, 0)
                    found = [a for a in apps.values() if any(c in cats for c in a.categories)]
                    found.sort(key=lambda a: (a.pkg not in POPULAR, a.name.lower()))
                    box.pack_start(self.grid(found), False, False, 0)
        self.set_content(box)

    def find(self, text):
        t = text.lower()
        scored = []
        for a in self.catalog.apps.values():
            name = a.name.lower()
            if t in name or t in a.pkg:
                scored.append((0 if name.startswith(t) else 1, a))
            elif t in a.summary.lower():
                scored.append((2, a))
        scored.sort(key=lambda s: (s[0], not s[1].is_luxos, s[1].name.lower()))
        return [a for _s, a in scored[:120]]

    def on_search(self, entry):
        text = entry.get_text().strip()
        if len(text) >= 2:
            self.show_page("search", text)
        elif not text and self.current[0] == "search":
            self.show_page("discover")

