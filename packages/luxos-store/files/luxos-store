        box.pack_start(info, False, False, 0)

        def show_result():
            ups = self.catalog.updates
            info.set_text(_("Everything is up to date.") if not ups else
                          _("%d updates available: %s") % (len(ups), ", ".join(ups[:30]) + (" …" if len(ups) > 30 else "")))
            check.set_sensitive(True)

        def do_check(_b=None):
            check.set_sensitive(False)
            info.set_text(_("Checking for updates…"))
            threading.Thread(target=lambda: (self.catalog.check_updates(), GLib.idle_add(show_result)),
                             daemon=True).start()

        check.connect("clicked", do_check)
        update.connect("clicked", lambda _b: self.run_helper("upgrade", [], _("Updating system…")))
        if os.path.exists(DATASAVER):
            info.set_text(_("Data Saver is on - updates are not checked automatically."))
        else:
            do_check()
        return box

    # ---- detail aplikace ----
