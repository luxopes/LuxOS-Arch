        self.current = ("detail", app)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        top = Gtk.Box(spacing=18)
        img = Gtk.Image()
        pix = app.icon_pixbuf(112)
        if pix:
            img.set_from_pixbuf(pix)
        top.pack_start(img, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        name = Gtk.Label(label=app.name, xalign=0)
        name.get_style_context().add_class("detail-name")
        text.pack_start(name, False, False, 0)
        text.pack_start(self.dim(app.summary), False, False, 0)
        src = Gtk.Label(label=app.source_label(), xalign=0)
        src.get_style_context().add_class("badge")
        text.pack_start(src, False, False, 0)
        top.pack_start(text, True, True, 0)
        actions = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER)
        installed = app.pkg in self.catalog.installed
        main = Gtk.Button(label=_("Open") if installed else _("Get"))
        main.get_style_context().add_class("get")
        main.get_style_context().add_class("primary")
        main.connect("clicked", lambda _b: self.primary_action(app))
        actions.pack_start(main, False, False, 0)
        if installed:
            rm = Gtk.Button(label=_("Remove"))
            rm.connect("clicked", lambda _b: self.confirm_remove(app))
            actions.pack_start(rm, False, False, 0)
        top.pack_end(actions, False, False, 0)
        box.pack_start(top, False, False, 0)

        facts = Gtk.Box(spacing=28)
        for label, value in ((_("Version"), app.version),
                             (_("Size"), GLib.format_size(app.size) if app.size else "-"),
                             (_("Package"), app.pkg)):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            col.pack_start(self.dim(label), False, False, 0)
            col.pack_start(Gtk.Label(label=value, xalign=0, selectable=True), False, False, 0)
            facts.pack_start(col, False, False, 0)
        box.pack_start(facts, False, False, 0)
        desc = description_text(app.component) if app.component else app.description
        if desc:
            box.pack_start(self.section(_("About")), False, False, 0)
            box.pack_start(Gtk.Label(label=desc, xalign=0, wrap=True, selectable=True, max_width_chars=90),
                           False, False, 0)
        if app.component and app.component.get_url(AppStream.UrlKind.HOMEPAGE):
            url = app.component.get_url(AppStream.UrlKind.HOMEPAGE)
            link = Gtk.LinkButton(uri=url, label=_("Website"), halign=Gtk.Align.START)
            box.pack_start(link, False, False, 0)
        self.set_content(box)

    # ---- akce ----
    def primary_action(self, app):
        if app.pkg in self.catalog.installed:
            try:
                info = Gio.DesktopAppInfo.new(app.desktop_id())
            except TypeError:
                info = None
            if info:
                info.launch([], None)
            else:
                self.flash(_("%s is installed, but has no window to open.") % app.name)
        elif app.is_lux_format:
            self.run_helper("lux-install", [app.pkg], _("Installing %s…") % app.name, app)
        else:
            self.run_helper("install", [app.pkg], _("Installing %s…") % app.name, app)

    def confirm_remove(self, app):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.OK_CANCEL, text=_("Remove %s?") % app.name)
        dlg.format_secondary_text(_("The app will be removed from this computer. Your files stay untouched."))
        if dlg.run() == Gtk.ResponseType.OK:
            self.run_helper("lux-remove" if app.is_lux_format else "remove", [app.pkg],
                            _("Removing %s…") % app.name, app)
        dlg.destroy()

    def flash(self, text):
        self.status.set_text(text)
        self.status_bar.show()

    def run_helper(self, action, pkgs, message, app=None):
        """Operace pres pkexec s prubehem (stahovani 0-50 %, instalace 50-100 %). lux posila radky
        "@@PHASE/@@PROGRESS/@@ERROR" (/usr/share/doc/lux/lux.md), zalozni pacman svuj bezny vystup."""
        if app:
            self.busy[app.pkg] = "0 %"
            for c in self.cards:
                if c.app is app:
                    c.update()
        self.flash(message)
        self.progress.set_fraction(0)
        self.progress.show()
        prog = {"total": 0, "down": 0, "inst": 0, "err": "", "net": False, "machine": False}
        errors = {"network": _("The internet connection is too slow or unavailable. Try it again later."),
                  "locked": _("Another app is installing software right now. Try it again in a moment."),
                  "disk": _("Not enough free disk space."),
                  "keyring": _("A package signature could not be verified. Run in Terminal: lux fix"),
                  "conflict": _("The app conflicts with files of another package."),
                  "pkgconflict": _("The app conflicts with an installed package."),
                  "deps": _("Some required packages are not available."),
                  "notfound": _("The app is no longer available in the repository.")}

        def parse_machine(line):
            parts = line[2:].split(" ", 3)
            kind = parts[0]
            if kind == "PLAN" and len(parts) > 2 and parts[2].isdigit():
                prog["total"] = int(parts[2])
            elif kind == "PROGRESS" and len(parts) > 2 and parts[2].isdigit():
                pct = int(parts[2]) / 100
                phase = parts[1]
                detail = parts[3] if len(parts) > 3 else ""
                if phase == "download":
                    GLib.idle_add(show, 0.45 * pct, _("Downloading…"))
                elif phase == "verify":
                    GLib.idle_add(show, 0.45 + 0.05 * pct, _("Checking…"))
                elif phase in ("install", "remove"):
                    name = detail.split(" ", 1)[-1] if detail else ""
                    verb = _("Removing %s…") if phase == "remove" else _("Installing %s…")
                    GLib.idle_add(show, 0.5 + 0.48 * pct, verb % name if name else None)
                elif phase == "hooks":
                    GLib.idle_add(show, 0.98 + 0.02 * pct, _("Finishing…"))
            elif kind == "ERROR" and len(parts) > 1:
                prog["err"] = errors.get(parts[1]) or (line.split(" ", 2)[2] if line.count(" ") >= 2 else "")
                prog["net"] = parts[1] == "network"
            elif kind == "RETRY":
                GLib.idle_add(show, self.progress.get_fraction(),
                              _("Download failed, trying again (attempt %s)…") % parts[-1])

        def show(frac, text):
            self.progress.set_fraction(max(0.0, min(1.0, frac)))
            if text:
                self.status.set_text(text)
            if app:
                self.busy[app.pkg] = "%d %%" % round(frac * 100)
                for c in self.cards:
                    if c.app is app:
                        c.update()
            return False

        def parse(line):
            if line.startswith("@@"):
                prog["machine"] = True
                parse_machine(line)
                return
            if prog["machine"]:
                if line.startswith("error:") and not prog["err"]:
                    prog["err"] = line[6:].strip()
                return
            total = prog["total"] or 1
            m = re.match(r"^Packages? \((\d+)\)", line)
            if m:
                prog["total"] = int(m.group(1))
                return
            if line.endswith("downloading...") or line.endswith(" is up to date"):
                prog["down"] += 1
                GLib.idle_add(show, 0.5 * prog["down"] / total,
                              _("Downloading %d of %d…") % (min(prog["down"], total), total))
                return
            # bez terminalu pacman pise "installing jmeno..." (s terminalem "(1/3) installing jmeno")
            m = re.match(r"^(?:\(\s*\d+/\d+\) )?(installing|upgrading|reinstalling|removing|downgrading) (\S+?)(?:\.\.\.)?$",
                         line)
            if m:
                prog["inst"] += 1
                verb = {"removing": _("Removing %s…")}.get(m.group(1), _("Installing %s…"))
                GLib.idle_add(show, 0.5 + 0.5 * (prog["inst"] - 1) / total, verb % m.group(2))
                return
            if "failed retrieving file" in line or "too many errors from" in line:
                if not prog["net"]:
                    prog["net"] = True
                    GLib.idle_add(show, self.progress.get_fraction(),
                                  _("The connection is slow, trying another server…"))
                return
            if line.startswith("@@RETRY"):
                GLib.idle_add(show, self.progress.get_fraction(),
                              _("Download failed, trying again (attempt %s)…") % line.split()[-1])
                return
            if line.startswith("error:"):
                prog["err"] = line[6:].strip()

        def work():
            try:
                p = subprocess.Popen(["pkexec", HELPER, action, *pkgs], stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, bufsize=1)
            except OSError as e:
                GLib.idle_add(done, 1, str(e))
                return
            for line in p.stdout:
                parse(line.strip())
            GLib.idle_add(done, p.wait(), prog["err"])

        def done(rc, err):
            self.progress.hide()
            if app:
                self.busy.pop(app.pkg, None)
            self.catalog.refresh_installed()
            if rc == 0:
                self.flash(_("Done."))
                GLib.timeout_add_seconds(4, lambda: self.status_bar.hide() or False)
            elif rc in (126, 127):
                self.flash(_("Cancelled."))
            elif prog["net"]:
                self.flash(_("The internet connection is too slow or unavailable. Try it again later."))
            else:
                self.flash(_("Failed: %s") % (err or _("unknown error")))
            for c in self.cards:
                c.update()
            if self.current[0] == "detail":
                cur = self.current[1]
                if self.history:
                    self.history.pop()
                self.show_detail(cur)
            return False

        threading.Thread(target=work, daemon=True).start()


def main():
    GLib.set_prgname("luxos-store")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Store()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    if len(sys.argv) > 1:
        win.search.set_text(sys.argv[1])
    Gtk.main()


if __name__ == "__main__":
    main()
