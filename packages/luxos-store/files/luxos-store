class App:
    """Aplikace v obchode (z AppStream nebo z repozitare LuxOS)."""

    def __init__(self, pkg, name, summary, repo, version="", size=0, component=None, description="",
                 icon_file=None, categories=None):
        self.pkg, self.name, self.summary, self.repo = pkg, name, summary, repo
        self.version, self.size, self.component, self.description = version, size, component, description
        self.icon_file = icon_file
        self.categories = component.get_categories() if component else (categories or [])

    @property
    def is_luxos(self):
        return self.repo.startswith("luxos") or self.repo == "lux"

    @property
    def is_lux_format(self):
        return self.repo == "lux"

    def source_label(self):
        if self.is_lux_format:
            return "LuxOS · " + _("LuxOS package (.lux)")
        return "LuxOS" if self.is_luxos else f"Arch Linux · {self.repo}"

    def desktop_id(self):
        if self.component:
            lc = self.component.get_launchable(AppStream.LaunchableKind.DESKTOP_ID)
            if lc and lc.get_entries():
                return lc.get_entries()[0]
        return f"{self.pkg}.desktop"

    def icon_pixbuf(self, size):
        theme = Gtk.IconTheme.get_default()
        if self.icon_file:
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_size(self.icon_file, size, size)
            except GLib.Error:
                pass
        if self.component:
            best = None
            for ic in self.component.get_icons():
                kind = ic.get_kind()
                if kind == AppStream.IconKind.STOCK and theme.has_icon(ic.get_name()):
                    try:
                        return theme.load_icon(ic.get_name(), size, Gtk.IconLookupFlags.FORCE_SIZE)
                    except GLib.Error:
                        pass
                if ic.get_filename() and (best is None or abs(ic.get_width() - size) < abs(best.get_width() - size)):
                    best = ic
            if best:
                try:
                    return GdkPixbuf.Pixbuf.new_from_file_at_size(best.get_filename(), size, size)
                except GLib.Error:
                    pass
        fallback = "luxos-app" if self.is_luxos else "application-x-executable"
        for name in (self.pkg, fallback, "application-x-executable"):
            if theme.has_icon(name):
                try:
                    return theme.load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
                except GLib.Error:
                    continue
        return None


def run(*cmd, timeout=60):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def description_text(component):
    """Popis AppStream (zjednodusene HTML) -> prosty text s odstavci."""
    raw = component.get_description() or ""
    raw = re.sub(r"<li>", "• ", raw)
    raw = re.sub(r"</(p|li)>", "\n", raw)
    raw = re.sub(r"<[^>]+>", "", raw)
    return unescape(re.sub(r"\n{3,}", "\n\n", raw)).strip()


class Catalog:
    """Vsechny aplikace a stav nainstalovanych balicku."""

    def __init__(self):
        self.apps = {}
        self.installed = set()
        self.updates = []
        self.update_info = {}
        self.pending_icons = []

    def load(self):
        sync = {}
        # repo, nazev, verze, velikost po instalaci, popis (lux_alpm list --sync); bez pyalpm aspon
        # nazvy a verze z lux-engine -Sl
        out = run(LUX_ALPM, "--color=never", "list", "--sync", timeout=120)
        if not out.strip():
            out = "\n".join("\t".join(ln.split()[:3] + ["0", ""]) for ln in run(ENGINE, "-Sl", timeout=120).splitlines()
                            if len(ln.split()) >= 3)
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) == 5 and parts[1] not in sync:
                sync[parts[1]] = parts
        self.refresh_installed()
        pool = AppStream.Pool()
        try:
            pool.load()
            box = pool.get_components_by_kind(AppStream.ComponentKind.DESKTOP_APP)
            comps = box.as_array()
        except GLib.Error:
            comps = []
        apps = {}
        for c in comps:
            pkg = c.get_pkgname()
            if not pkg or pkg not in sync or pkg in apps:
                continue
            repo, _n, ver, size, _d = sync[pkg]
            apps[pkg] = App(pkg, c.get_name() or pkg, c.get_summary() or "", repo, ver, int(size or 0), c)
        # Aplikace LuxOS (repozitar [luxos-apps]) - bez AppStream, z popisu balicku
        for pkg, (repo, _n, ver, size, desc) in sync.items():
            if repo == "luxos-apps" and pkg not in apps:
                # Popis "Nazev - shrnuti" (napr. "LSL IDE - development environment ...")
                name, sep, summary = desc.partition(" - ")
                if not sep:
                    name, summary = pkg, desc
                apps[pkg] = App(pkg, name, summary, repo, ver, int(size or 0), description=desc,
                                icon_file=self.repo_icon(pkg))
            elif repo == "luxos-apps":
                apps[pkg].repo = repo
        self.load_lux(apps)
        self.apps = apps

    def repo_icon(self, pkg):
        """Ikona aplikace z repozitare LuxOS z mezipameti; chybejici se stahne az po zobrazeni katalogu."""
        for ext in ("svg", "png"):
            path = os.path.join(ICON_CACHE, f"{pkg}.{ext}")
            if os.path.exists(path) and os.path.getsize(path):
                return path
        self.pending_icons.append((pkg, [(f"{APPS_ICON_URL}/{pkg}.{ext}", os.path.join(ICON_CACHE, f"{pkg}.{ext}"))
                                         for ext in ("svg", "png")]))
        return None

    def fetch_icons(self):
        """Stazeni chybejicich ikon na pozadi (pomala sit nesmi zdrzet zobrazeni obchodu)."""
        changed = False
        os.makedirs(ICON_CACHE, exist_ok=True)
        pending, self.pending_icons = self.pending_icons, []
        for pkg, candidates in pending:
            for url, path in candidates:
                run("curl", "-fsSL", "--max-time", "6", "-o", path, url, timeout=8)
                if os.path.exists(path) and os.path.getsize(path):
                    if pkg in self.apps:
                        self.apps[pkg].icon_file = path
                        changed = True
                    break
                if os.path.exists(path):
                    os.unlink(path)
        return changed

    def refresh_installed(self):
        self.installed = set(run(ENGINE, "-Qq").split())
        try:
            self.installed |= {f[:-5] for f in os.listdir(LUX_DB) if f.endswith(".json")}
        except OSError:
            pass

    def load_lux(self, apps):
        """Balicky ve vlastnim formatu LuxOS (overeny index z lux __index)."""
        try:
            index = json.loads(run("lux", "__index", timeout=15) or "{}")
        except ValueError:
            return
        os.makedirs(ICON_CACHE, exist_ok=True)
        for p in index.get("packages", []):
            name = p.get("name")
            if not name or name in apps:
                continue
            icon = None
            if p.get("icon"):
                icon = os.path.join(ICON_CACHE, p["icon"])
                if not os.path.exists(icon):
                    self.pending_icons.append((name, [(f"{LUX_INDEX_URL}/{p['icon']}", icon)]))
                    icon = None
            apps[name] = App(name, p.get("title") or name, p.get("summary", ""), "lux",
                             f"{p.get('version', '')}-{p.get('release', 1)}", int(p.get("size", 0)),
                             description=p.get("description", ""), icon_file=icon, categories=p.get("categories"))

    def check_updates(self):
        """True = kontrola probehla (lux check-updates do docasne kopie databazi: 0 = jsou aktualizace,
        2 = nejsou, jinak chyba/sit)."""
        try:
            r = subprocess.run([LUX_ALPM, "--color=never", "check-updates"], capture_output=True, text=True,
                               timeout=180, env=ENGINE_ENV)
        except (OSError, subprocess.TimeoutExpired):
            self.update_error = None
            return False
        if r.returncode not in (0, 2):
            # prvni radek hlasky lux ("✗ ..."), uz prelozeny; jinak obecny text
            lines = [ln.strip().lstrip("✗").strip() for ln in (r.stderr or "").splitlines() if ln.strip()]
            self.update_error = lines[0] if lines else None
            return False
        # "nazev stara -> nova"
        self.update_info = {}
        for line in r.stdout.splitlines():
            parts = line.split()
            if parts:
                self.update_info[parts[0]] = (parts[1] if len(parts) > 1 else "",
                                              parts[3] if len(parts) > 3 else "")
        self.updates = list(self.update_info)
        return True


