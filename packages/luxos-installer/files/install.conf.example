# LuxOS - priklad konfigurace pro bezobsluznou instalaci
#   sudo luxos-install --config install.conf --yes
#   ... | sudo luxos-install --config - --yes --progress   (konfigurace ze stdin, hesla nejdou na disk)
LOCALE=cs_CZ.UTF-8
XKB_LAYOUT=cz          # vice rozlozeni oddelenych carkou, prvni = vychozi (max. 4), napr. cz,us
XKB_VARIANT=           # varianty ve stejnem poradi, napr. qwerty, (= cz qwerty + us)
#XKB_OPTIONS=grp:shifts_toggle      # prepinani rozlozeni; prazdne = jen klikem na vlajku v horni liste.
                       # Bez XKB_OPTIONS se k jedinemu rozlozeni jinemu nez us prida us (obe klavesy Shift).
TIMEZONE=Europe/Prague
DISK=/dev/vda          # disk pro instalaci; "manual" = pouzit oddily uz pripojene v /mnt
DISK_MODE=erase        # erase = CELY DISK BUDE SMAZAN
                       # freespace = vedle jinych systemu do nejvetsi volne oblasti (min. 20 GB,
                       #             jen GPT + UEFI, sdileny EFI oddil s min. 250 MB volneho mista)
                       # partition = do EXISTUJICIHO oddilu ROOT_PART (TEN SE SMAZE), ostatni oddily zustanou
                       #             (jen UEFI, sdileny EFI oddil s min. 250 MB volneho mista; swap = zram)
                       # manual = oddily pripojene v /mnt (stejne jako DISK=manual)
                       # layout = rucni rozdeleni podle LAYOUT nize (LVM, LUKS2, samostatne oddily)
BOOTLOADER=auto        # auto = systemd-boot (UEFI) / GRUB (BIOS); none = bez zavadece (jadro v /boot)
ROOT_PART=             # DISK_MODE=partition: oddil pro LuxOS (min. 20 GB, nepripojeny), napr. /dev/nvme0n1p4;
                       #   DISK lze vynechat (doplni se podle oddilu)
HOME_PART=             # DISK_MODE=partition, nepovinne: existujici oddil jako /home BEZ formatovani
                       #   (ext4, btrfs, xfs, f2fs; btrfs se subvolumem @home se pripoji jako @home)
ENCRYPT=0              # 1 = LUKS2, vyzaduje LUKS_PASS
LUKS_PASS=
WIPE=none              # bezpecne smazani mista pro LuxOS pred formatovanim (po rozdeleni disku, pred LUKS/mkfs):
                       # none = ne (rychle); zero = smazat - SSD/NVMe rychlym prikazem disku (blkdiscard --secure
                       #   nebo -z), pokud ho disk umi, jinak prepsat nulami (dd, setri procesor);
                       # overwrite = vzdy prepsat nulami (dd). Muze trvat dlouho (HDD ~130 MB/s, 1 TB ~ 2 h).
                       # Maze jen oddily LuxOS (nove, formatovane, sifrovane), nikdy jine oddily ani sdileny EFI.
                       # Doporuceno se sifrovanim (ENCRYPT=1). S DISK_MODE=manual neni k dispozici.
USERNAME=lux
FULLNAME="Lux User"
PASSWORD=luxos
HOSTNAME_SEL=luxos
AUTOLOGIN=0
CARE_MODE=carefree     # carefree = automaticke aktualizace na pozadi, zalozni jadro, samoopravy (LuxAI Flash)
                       # classic = bez automatickych aktualizaci a oprav (pro IT profesionaly), jen upozorneni
# Nepovinne: sablony softwaru (aplikace navic), vice oddelenych carkou; prazdne/none = jen zaklad
#   everyday, programming, creative, gaming, security  (seznamy v /usr/share/luxos/installer/templates)
TEMPLATES=
# Nepovinne: jazyk vystupu instalatoru (napr. cs_CZ.UTF-8)
UI_LANG=
# Nepovinne: prihlaseni k uctu LuxAI (AI v LuxAI, Lux Code, LSL IDE)
LUXAI_EMAIL=
LUXAI_PASSWORD=
# ... nebo uz prihlaseny ucet jako JSON (obsah ~/.config/luxai/account.json, pouziva GUI)
LUXAI_ACCOUNT=

# --- Rucni rozdeleni disku: DISK_MODE=layout -----------------------------------------
# LAYOUT (nebo LAYOUT_FILE=/cesta) popisuje oddily radek po radku: "druh klic=hodnota ...".
# Nic se nezmeni pred potvrzenim souhrnu (--yes = potvrzeno); souhrn vypise, co se smaze.
# Kontrola bez zmen:  luxos-install --check-layout layout.conf
#
#   disk   dev=/dev/vda table=new|keep          new = CELY DISK SE SMAZE, nova GPT; keep = zachovat oddily
#   part   id=ID disk=/dev/vda size=1G|rest [type=esp|bios|linux|swap|lvm|luks|boot] [name=TEXT]
#   use    id=ID dev=/dev/sda2 [resize=100G]    existujici oddil/zarizeni; resize jen ext4, btrfs, NTFS
#   delete dev=/dev/sda3                        smazat existujici oddil
#   luks   id=ID on=ID name=MAPPER [keep=1]     LUKS2 na oddilu nebo LV; keep=1 = existujici, jen odemknout
#   vg     id=ID name=VG pvs=ID[,ID] [keep=1]   skupina LVM na oddilech/LUKS; keep=1 = existujici
#   lv     id=ID vg=ID name=LV size=40G|rest [keep=1]
#   fs     on=ID mount=/home type=btrfs|ext4|xfs|f2fs|vfat [format=1|0] [label=X] [subvol=@home]
#   swap   on=ID [format=1|0]                   bez swapu staci zram (LuxOS ho ma vzdy)
#
# Velikosti: K/M/G/T (binarni jako sgdisk/lvcreate), rest = zbytek disku/skupiny (jen jeden).
# Pravidla: / se vzdy formatuje; UEFI potrebuje EFI oddil (vfat, min. 300 MB) v /boot nebo /efi
# (/efi = sdileny ESP, jadro se kopiruje do EFI/LuxOS); BIOS potrebuje oddil type=bios (1M)
# a nesifrovany /boot, pokud je / sifrovany (GRUB). Samostatne /usr ani /boot/efi nejsou podporovane.
# Hesla: LUKS_PASS (spolecne) nebo LUKS_PASS_<ID velkymi pismeny> pro jednotlive svazky.
# Pri startu: svazky pod / odemkne initramfs (rd.luks.name, jedno heslo); ostatni (/home, swap…)
# odemkne klic v /etc/cryptsetup-keys.d na sifrovanem / - bez dalsiho dotazu. Je-li / nesifrovany,
# sifrovany swap dostane nahodny klic pri kazdem startu a ostatni svazky se zeptaji na heslo.
#
# Priklad: sifrovane LVM (LVM na LUKS) s /, /home a swapem na celem disku (UEFI)
#DISK_MODE=layout
#LUKS_PASS=tajne-heslo
#LAYOUT='
#disk dev=/dev/vda table=new
#part id=esp  disk=/dev/vda size=1G type=esp
#part id=crypt disk=/dev/vda size=rest
#luks id=cryptlvm on=crypt name=cryptlvm
#vg   id=vg name=luxos pvs=cryptlvm
#lv   id=root vg=vg name=root size=40G
#lv   id=swap vg=vg name=swap size=4G
#lv   id=home vg=vg name=home size=rest
#fs   on=esp  mount=/boot type=vfat
#fs   on=root mount=/ type=btrfs
#fs   on=home mount=/home type=btrfs
#swap on=swap
#'
#
# Priklad: LUKS na LVM (kazdy LV vlastni LUKS) a zachovany EFI oddil s Windows
#LAYOUT='
#use  id=win_esp dev=/dev/nvme0n1p1
#part id=pv disk=/dev/nvme0n1 size=rest type=lvm
#vg   id=vg name=luxos pvs=pv
#lv   id=lroot vg=vg name=root size=50G
#lv   id=lhome vg=vg name=home size=rest
#luks id=croot on=lroot name=root
#luks id=chome on=lhome name=home
#fs   on=win_esp mount=/efi type=vfat format=0
#fs   on=croot mount=/ type=btrfs
#fs   on=chome mount=/home type=ext4
#'
