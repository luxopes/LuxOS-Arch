def run_helper(args, data=None, timeout=600):
    """luxos-oem jako root (sudo -n); vraci (navratovy kod, stdout)."""
    try:
        r = subprocess.run(HELPER + args, input=data, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, f"@@ERROR {e}\n"


