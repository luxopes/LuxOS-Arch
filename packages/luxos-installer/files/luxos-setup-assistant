def load_installer():
    """Modul instalatoru (stranky Installer) - nainstalovany, jinak vedle skriptu (testy)."""
    path = os.environ.get("LUXOS_INSTALL_GUI") or next(
        (p for p in ("/usr/bin/luxos-install-gui", os.path.join(HERE, "luxos-install-gui")) if os.path.exists(p)),
        "/usr/bin/luxos-install-gui")
    loader = SourceFileLoader("luxos_install_gui", path)
    mod = module_from_spec(spec_from_loader("luxos_install_gui", loader))
    loader.exec_module(mod)
    return mod


