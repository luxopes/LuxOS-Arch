class GreeterLogin:
    """LightDM: overit nove heslo a spustit relaci (stejny postup jako luxos-greeter)."""

    def __init__(self):
        gi = gui.gi
        gi.require_version("LightDM", "1")
        from gi.repository import LightDM
        self.L = LightDM
        self.g = LightDM.Greeter()
        self.password, self.done, self.language = "", None, None
        self.g.connect("show-prompt", self._prompt)
        self.g.connect("authentication-complete", self._complete)
        try:
            self.g.connect_to_daemon_sync()
        except AttributeError:
            self.g.connect_sync()

    def _prompt(self, _g, _text, ptype):
        if ptype == self.L.PromptType.SECRET:
            self.g.respond(self.password)

    def _complete(self, _g):
        cb, self.done = self.done, None
        if not self.g.get_is_authenticated():
            cb and cb(False)
            return
        # Jazyk zvoleny v Pruvodci: LightDM bezi od startu s puvodnim jazykem (en_US) a relaci
        # by ho predal - prvni prihlaseni by bylo anglicky, i kdyz system uz je cesky
        if self.language:
            try:
                self.g.set_language(self.language)
            except Exception:  # noqa: BLE001 - starsi LightDM: relace jen v puvodnim jazyce
                pass
        for key in (SESSION, None):
            try:
                self.g.start_session_sync(key)
                cb and cb(True)
                return
            except Exception:  # noqa: BLE001 - zkusit vychozi relaci
                continue
        cb and cb(False)

    def login(self, user, password, done, language=None):
        self.password, self.done, self.language = password, done, language
        if self.g.get_in_authentication():
            self.g.cancel_authentication()
        self.g.authenticate(user)

    def power(self, what):
        {"restart": self.L.restart, "shutdown": self.L.shutdown}[what]()


class DemoLogin:
    """Bez LightDM (--demo, testy): nic se nespousti ani nevypina."""

    def __init__(self):
        self.calls = []

    def login(self, user, _password, done, language=None):
        self.calls.append(("login", user, language))
        print(f"DEMO: login {user}", flush=True)
        GLib.idle_add(lambda: done(os.environ.get("LUXOS_SETUP_DEMO_LOGIN_FAIL") != "1") and False)

    def power(self, what):
        self.calls.append((what,))
        print(f"DEMO: {what}", flush=True)


