class SealDialog(Gtk.Window):
    def __init__(self, reminder=False):
        super().__init__(title=_("Seal for Customer"))
        self.set_default_size(560, -1)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("luxos-installer")
        hb = Gtk.HeaderBar(show_close_button=True, title=_("Seal for Customer"))
        self.set_titlebar(hb)
        self.connect("delete-event", lambda *_a: Gtk.main_quit())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=24)
        self.add(box)
        t = Gtk.Label(label=_("Ready to hand over this computer?"), xalign=0, wrap=True)
        t.get_style_context().add_class("title")
        box.pack_start(t, False, False, 0)
        intro = _("This computer was prepared for another person. Install apps and test the hardware, then "
                  "seal it. The computer shuts down; at the next start the owner creates their account.")
        box.pack_start(gui.Installer.hint(intro), False, False, 0)
        for line in (_("Logs, caches and command history are removed."),
                     _("The temporary account oem is deleted at the next start."),
                     _("New SSH keys and a new machine ID are created at the next start.")):
            box.pack_start(gui.Installer.hint("•  " + line), False, False, 0)
        self.keep_wifi = Gtk.CheckButton(label=_("Keep saved Wi-Fi networks (their passwords stay on the computer)"))
        box.pack_start(self.keep_wifi, False, False, 4)
        self.msg = gui.Installer.hint("", "error")
        box.pack_start(self.msg, False, False, 0)
        row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        later = Gtk.Button(label=_("Not Now") if reminder else _("Cancel"))
        later.connect("clicked", lambda _b: Gtk.main_quit())
        self.seal_btn = Gtk.Button(label=_("Seal and Shut Down"))
        self.seal_btn.get_style_context().add_class("primary")
        self.seal_btn.connect("clicked", self.seal)
        row.pack_start(later, False, False, 0)
        row.pack_start(self.seal_btn, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.show_all()

    def command(self):
        cmd = ["pkexec", "/usr/bin/luxos-oem", "seal", "--yes", "--poweroff"]
        if self.keep_wifi.get_active():
            cmd.append("--keep-wifi")
        return cmd

    def seal(self, _b):
        self.seal_btn.set_sensitive(False)
        cmd = self.command()
        if os.environ.get("LUXOS_SETUP_DEMO") == "1":
            print("DEMO: " + " ".join(cmd), flush=True)
            Gtk.main_quit()
            return

        def done(r, _err):
            if r is None or r.returncode != 0:
                gui.say(self.msg, (r.stdout.strip().splitlines() or [""])[-1] if r else _("Sealing failed."))
                self.seal_btn.set_sensitive(True)
        gui.run_async(lambda: subprocess.run(cmd, capture_output=True, text=True), done)


def apply_css():
    for data in (gui.CSS, CSS):
        provider = Gtk.CssProvider()
        provider.load_from_data(data)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def main():
    ap = argparse.ArgumentParser(description="LuxOS setup assistant (first start after OEM preinstallation)")
    ap.add_argument("--demo", action="store_true", help="run in a window without LightDM and without changes")
    ap.add_argument("--seal-dialog", action="store_true", help="window 'Seal for Customer' (account oem)")
    ap.add_argument("--reminder", action="store_true", help="with --seal-dialog: shown after login")
    args = ap.parse_args()
    GLib.set_prgname("luxos-setup-assistant")
    if Gdk.Display.get_default() is None:
        print("luxos-setup-assistant: no display", file=sys.stderr)
        return 1
    apply_css()
    if args.seal_dialog:
        if args.reminder and not os.path.exists("/etc/luxos/oem.conf"):
            return 0
        SealDialog(args.reminder)
        Gtk.main()
        return 0
    if args.demo:
        os.environ["LUXOS_SETUP_DEMO"] = "1"
        login = DemoLogin()
    else:
        login = GreeterLogin()
        root = Gdk.get_default_root_window()
        disp = Gdk.Display.get_default()
        root.set_cursor(Gdk.Cursor.new_from_name(disp, "default"))
    _rc, out = run_helper(["status"], timeout=30)
    status = oem.parse_status(out)
    win = SetupAssistant(login, status, windowed=args.demo)
    win.present()
    Gtk.main()
    return 0 if win.result == "ok" else 1


if __name__ == "__main__":
    sys.exit(main())
