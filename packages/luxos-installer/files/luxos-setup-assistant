                # firemni sit se nepovedla: ucet je hotovy, prihlaseni az po precteni
                warn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=6)
                warn.get_style_context().add_class("warn")
                lab = Gtk.Label(label=self.finish_warn, xalign=0, wrap=True, max_width_chars=70)
                lab.get_style_context().add_class("warn-text")
                warn.pack_start(lab, False, False, 0)
                page.pack_start(warn, False, False, 0)
                b = Gtk.Button(label=_("Sign In"), halign=Gtk.Align.CENTER)
                b.get_style_context().add_class("primary")
                b.connect("clicked", lambda _b: self.sign_in())
                self.signin_btn = b
                page.pack_start(b, False, False, 8)
                return
            self.finish_label = Gtk.Label(label=self.finish_text or _("Signing in…"), wrap=True)
            self.finish_label.get_style_context().add_class("subtitle")
            page.pack_start(self.finish_label, False, False, 0)
            if self.finish_text:   # prihlaseni selhalo: ucet je hotovy, staci restart
                b = Gtk.Button(label=_("Restart"), halign=Gtk.Align.CENTER)
                b.get_style_context().add_class("primary")
                b.connect("clicked", lambda _b: self.login_backend.power("restart"))
                page.pack_start(b, False, False, 8)
            return
        self.heading(page, _("Setting up your computer"), _("This takes a moment. Please do not turn off the computer."))
        self.finish_label = Gtk.Label(label=self.finish_text, xalign=0, wrap=True)
        page.pack_start(self.finish_label, False, False, 0)
        self.finish_bar = Gtk.ProgressBar()
        page.pack_start(self.finish_bar, False, False, 0)
        if self.finish_error:
            err = Gtk.Label(label=self.finish_error, xalign=0, wrap=True, selectable=True)
            err.get_style_context().add_class("error")
            page.pack_start(err, False, False, 0)
            page.pack_start(self.hint(_("Nothing is lost: go back to change something or try again.")), False, False, 0)
        self.valid = lambda: not self.finishing

    # ---- dokonceni ----
    def start_finish(self):
        try:
            data = oem.finish_input(self.s, self.xkb_values(), self.luks_pending, self.photo or "")
        except ValueError:
            self.finish_error = _("Some of your entries contain unsupported characters.")
            self.render()
            return
        self.finishing, self.finish_error, self.finish_text = True, "", _("Starting…")
        self.save()
        self.render()
        self.pulse = GLib.timeout_add(120, lambda: (self.finishing and self.finish_bar.pulse()) or self.finishing)

        def work():
            try:
                p = subprocess.Popen(HELPER + ["finish"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, bufsize=1)
            except OSError as e:
                GLib.idle_add(self.finished, 1, str(e))
                return
            try:
                p.stdin.write(data)
                p.stdin.close()
            except OSError:
                pass
            err = ""
            warn = []
            done = False
            for line in p.stdout:
                kind = oem.parse_line(line.rstrip("\n"))
                if kind[0] == "step":
                    GLib.idle_add(self.finish_step, kind[1])
                elif kind[0] == "error":
                    err = err or kind[1]
                elif kind[0] == "warn":
                    warn.append(kind[1])
                elif kind[0] == "done":
                    done = True
            rc = p.wait()
            self.finish_warn = "\n".join(warn)
            GLib.idle_add(self.finished, 0 if rc == 0 and done else (rc or 1), err)
        threading.Thread(target=work, daemon=True).start()

    def finish_step(self, text):
        self.finish_text = text
        if self.current() == "finish" and getattr(self, "finish_label", None):
            self.finish_label.set_text(text)
        return False

    def finished(self, rc, err):
        self.finishing = False
        if rc != 0:
            self.finish_error = err or _("Setup could not be finished (exit code %s).") % rc
            self.render()
            return False
        self.result, self.finish_text = "ok", ""
        # heslo spravce domeny uz neni potreba (luxos-oem ho jen predal lux-domain)
        self.s["domain_pw"] = ""
        if self.photo_dir:
            shutil.rmtree(self.photo_dir, ignore_errors=True)
        self.render()
        if not self.finish_warn:
            self.sign_in()
        return False

    def sign_in(self):
        self.finish_warn = ""
        self.render()
        self.login_backend.login(self.s["username"], self.s["pw1"], self.logged_in, self.s.get("locale"))

    def logged_in(self, ok):
        if ok:
            Gtk.main_quit()
            return
        self.finish_text = _("Your account is ready. Restart the computer and sign in with your new password.")
        self.render()


