def system_locale():
    """LightDM spousti greeter bez LANG: jazyk ze systemoveho nastaveni (/etc/locale.conf)."""
    if os.environ.get("LANG", "C") not in ("", "C", "POSIX", "C.UTF-8"):
        return
    try:
        with open("/etc/locale.conf", encoding="utf-8") as f:
            for line in f:
                k, _sep, v = line.partition("=")
                if k.strip() == "LANG" and v.strip():
                    os.environ["LANG"] = v.strip().strip("\"'")
    except OSError:
        pass


