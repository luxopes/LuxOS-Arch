    # ---- pozadi ----
    def check_online(self):
        gui.run_async(gui.have_internet, self.online_checked)

    def online_checked(self, ok, _err):
        was = self.online
        self.online = bool(ok)
        if self.online and not self.tz_asked:
            self.tz_asked = True
            gui.run_async(self.detect_timezone, self.tz_detected)
        if was != self.online and self.current() in ("network", "luxai"):
            self.render()

    # ---- navigace ----
    def render_sidebar(self):
        for c in self.dots.get_children():
            self.dots.remove(c)
        for i, _key in enumerate(self.steps):
            d = Gtk.Box(valign=Gtk.Align.CENTER)
            ctx = d.get_style_context()
            ctx.add_class("setup-dot")
            if i == self.idx:
                ctx.add_class("current")
            elif i < self.idx:
                ctx.add_class("done")
            self.dots.pack_start(d, False, False, 0)
        self.dots.show_all()

    def render(self):
        if self.header is not None:
            self.header.set_title(_("Set Up LuxOS"))
        self.render_sidebar()
        child = self.scroll.get_child()
        if child:
            self.scroll.remove(child)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=28, margin_top=26)
        self.valid = lambda: True
        self.why = lambda: ""
        self.extra_action = None
        getattr(self, "page_" + self.current())(page)
        self.scroll.add(page)
        self.scroll.get_vadjustment().set_value(0)
        self.scroll.show_all()
        self.update_nav()

    def update_nav(self):
        key = self.current()
        self.btn_back.set_label(_("Back"))
        self.btn_back.set_visible(self.idx > 0 and not self.finishing and self.result != "ok")
        labels = {"luxai": _("Continue") if self.s["luxai"] else _("Skip"),
                  "network": _("Continue") if self.online else _("Skip"),
                  "care": _("Finish Setup")}
        self.btn_next.set_label(labels.get(key, _("Continue")))
        if key == "finish":
            self.btn_next.set_label(_("Try Again"))
            self.btn_next.set_visible(bool(self.finish_error) and not self.finishing)
        else:
            self.btn_next.set_visible(True)
        self.btn_extra.set_visible(self.extra_action is not None)
        self.btn_next.set_sensitive(bool(self.valid()))
        self.nav_hint.set_text("" if self.btn_next.get_sensitive() else self.why())

    def go_next(self):
        key = self.current()
        if key == "finish":
            if self.finish_error and not self.finishing:
                self.start_finish()
            return
        if not self.valid():
            return
        self.idx += 1
        self.save()
        self.render()
        if self.current() == "finish":
            self.start_finish()

    def go_back(self):
        if self.finishing or self.idx == 0 or self.result == "ok":
            return
        self.idx -= 1
        self.finish_error = ""
        self.save()
        self.render()

    def save(self):
        """Rozpracovane volby (bez hesel) pro pripad vypadku proudu."""
        try:
            oem.save_progress(dict(self.s, step=self.current()))
        except OSError:
            pass

    def on_delete(self, *_a):
        if not self.windowed or self.finishing:
            return True   # celou obrazovku nelze zavrit (zpet: tlacitko Zpet)
        Gtk.main_quit()
        return False

