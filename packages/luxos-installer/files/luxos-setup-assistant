    def show_avatar(self):
        pix = None
        if self.photo:
            from gi.repository import GdkPixbuf
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(self.photo, 64, 64, True)
            except GLib.Error:
                pix = None
        if pix is not None:
            self.avatar.set_from_pixbuf(pix)
        else:
            self.avatar.set_from_icon_name("avatar-default-symbolic", Gtk.IconSize.DIALOG)
            self.avatar.set_pixel_size(64)

    def choose_photo(self):
        dlg = Gtk.FileChooserDialog(title=_("Choose Photo…"), transient_for=self, modal=True,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("Choose"), Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name(_("Pictures"))
        flt.add_pixbuf_formats()
        dlg.add_filter(flt)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        for d in ("/usr/share/luxos/avatars", pictures):
            if d and os.path.isdir(d):
                dlg.set_current_folder(d)
                break
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        if path:
            self.set_photo(path)

    def set_photo(self, path):
        """Zmensit na 256 px PNG (luxos-oem prijme jen PNG do 5 MB); None = bez fotky."""
        if path is None:
            self.photo = None
        else:
            from gi.repository import GdkPixbuf
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 256, 256, True)
            except GLib.Error:
                self.nav_hint.set_text(_("This picture cannot be used."))
                return
            if not self.photo_dir:
                self.photo_dir = tempfile.mkdtemp(prefix="luxos-setup-")
            out = os.path.join(self.photo_dir, "photo.png")
            try:
                pix.savev(out, "png", [], [])
            except GLib.Error:
                self.nav_hint.set_text(_("This picture cannot be used."))
                return
            os.chmod(out, 0o644)
            os.chmod(self.photo_dir, 0o755)
            self.photo = out
        if getattr(self, "photo_remove", None) is not None:
            self.photo_remove.set_sensitive(self.photo is not None)
        if getattr(self, "avatar", None) is not None:
            self.show_avatar()

