#!/bin/bash
# LuxOS - instalator
#
# Interaktivne:   sudo luxos-install
# Bez obsluhy:    sudo luxos-install --config /cesta/install.conf [--yes] [--progress]
#                 ... | sudo luxos-install --config - --yes --progress   (konfigurace ze stdin)
# Disky (GUI):    sudo luxos-install --probe /dev/DISK   (volne misto a ESP, radky KLIC=hodnota)
#                 sudo luxos-install --scan               (disky, oddily, LUKS, LVM jako JSON; jen cte)
#                 luxos-install --check-layout SOUBOR     (kontrola LAYOUT bez zmen; - = stdin)
#
# Konfiguracni soubor (bash promenne) - viz /usr/share/luxos/installer/install.conf.example
# --progress: strojove radky "@@STEP n celkem text", "@@PCT 0-100", "@@STATUS text", "@@NET B/s stazeno celkem", "@@NET END", "@@ERROR text", "@@DONE"
#             rucni rozdeleni (DISK_MODE=layout) navic "@@ERASE text" (co se smaze, pred souhrnem) a "@@WARN text"
set -Eeuo pipefail

LOG=/var/log/luxos-install.log
TARGET=/mnt
SHARE=/usr/share/luxos/installer
# pacman (pacstrap, arch-chroot) spousti instalator, ne clovek: kompatibilni vrstva /usr/bin/pacman
# (luxos-pacman) ho pusti beze zmeny i tehdy, kdyz instalace bezi v terminalu
export LUX_ALLOW_PACMAN=1
. /usr/lib/luxos/i18n.sh
ui_lang() { export LANG=$1; . /usr/lib/luxos/i18n.sh; }   # jazyk pruvodce podle volby
# Rucni rozdeleni disku (DISK_MODE=layout): parser, kontrola a provedeni LAYOUT
. "$SHARE/layout.sh"

CONFIG=""
ASSUME_YES=0
PROGRESS=0
PROBE=""
SCAN=0
CHECK_LAYOUT=""
for a in "$@"; do [[ $a == --check-layout ]] && CHECK_LAYOUT=1; done
((EUID == 0 || CHECK_LAYOUT == 1)) || exec sudo "$0" "$@"
while (($#)); do
    case $1 in
        --config)   CONFIG=$2; shift ;;
        --yes)      ASSUME_YES=1 ;;
        --progress) PROGRESS=1 ;;
        --probe)    PROBE=$2; shift ;;
        --scan)     SCAN=1 ;;
        --check-layout) CHECK_LAYOUT=$2; shift ;;
        -h|--help) sed -n '2,13p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

# Konfigurace ze stdin (hesla se nezapisuji na disk); stdin pak uz nic necte
CONFIG_DATA=""
if [[ $CONFIG == - ]]; then
    CONFIG_DATA=$(cat)
    exec </dev/null
fi

# --- Vystup -----------------------------------------------------------------
ACCENT="#a77bff"
STEP_N=0
STEP_TOTAL=0
progress() { ((PROGRESS)) && printf '@@%s\n' "$*"; return 0; }   # radek pro graficky instalator
title() { gum style --foreground "$ACCENT" --bold --margin "1 0 0 0" "✦ $*"; }
info()  { gum style --foreground 250 "  $*"; }
step()  {
    STEP_N=$((STEP_N + 1))
    progress "STEP $STEP_N $STEP_TOTAL $*"
    printf '\n\e[1;38;2;167;123;255m==>\e[0m \e[1m%s\e[0m\n' "$*"; printf '\n==> %s\n' "$*" >>"$LOG"
}
fail()  { progress "ERROR $*"; printf '✗ %s\n' "$*" >>"$LOG" 2>/dev/null || true; gum style --foreground 203 --bold "✗ $*" >&2; exit 1; }
run()   { printf '+ %s\n' "$*" >>"$LOG"; "$@" >>"$LOG" 2>&1; }
if ((PROGRESS)); then
    # Vystup cte GUI (roura, ne terminal): bez gum a barev
    title() { printf '\n✦ %s\n' "$*"; }
    info()  { printf '  %s\n' "$*"; }
    step()  {
        STEP_N=$((STEP_N + 1))
        progress "STEP $STEP_N $STEP_TOTAL $*"
        printf '\n==> %s\n' "$*" | tee -a "$LOG"
    }
    fail()  { progress "ERROR $*"; printf '✗ %s\n' "$*" | tee -a "$LOG" >&2; exit 1; }
fi

on_error() {
    local rc=$? line=$1
    echo >&2
    progress "ERROR $(T "Installation failed (line %s, exit code %s)." "$line" "$rc")"
    if ((PROGRESS)); then
        T "Installation failed (line %s, exit code %s)." "$line" "$rc" >&2; echo >&2
    else
        gum style --border rounded --border-foreground 203 --padding "1 2" --foreground 203 \
            "$(T "Installation failed (line %s, exit code %s)." "$line" "$rc")" "" \
            "$(T "Details are in %s. Last lines:" "$LOG")" >&2 || true
        tail -n 15 "$LOG" >&2 || true
    fi
    exit "$rc"
}
trap 'on_error $LINENO' ERR

# --- Kontroly prostredi -----------------------------------------------------
preflight() {
    command -v gum >/dev/null || { echo "gum is missing" >&2; exit 1; }
    : >"$LOG"
    if [[ -d /sys/firmware/efi/efivars ]]; then BOOTMODE=uefi; else BOOTMODE=bios; fi
    [[ -d /run/archiso ]] || info "$(T "Warning: not running from the LuxOS live system.")"
}

have_internet() { curl -fsI --max-time 6 https://geo.mirror.pkgbuild.com/ >/dev/null 2>&1; }

ensure_internet() {
    until have_internet; do
        title "$(T "No internet connection")"
        info "$(T "LuxOS downloads the newest packages during installation.")"
        info "$(T "Connect with the network icon in the top bar, or use the text tool.")"
        local c
        c=$(gum choose "$(T "Try again")" "$(T "Open network setup (nmtui)")" "$(T "Quit")") || exit 1
        case $c in
            "$(T "Open network setup (nmtui)")") nmtui || true ;;
            "$(T "Quit")") exit 1 ;;
        esac
    done
}

# --- Volby ------------------------------------------------------------------
LANGS=(
    # Anglicky nazev za teckou: hledani funguje i bez diakritiky ("czech", "cest")
    "English (US)|en_US.UTF-8" "Čeština · Czech, Cestina|cs_CZ.UTF-8" "Slovenčina · Slovak, Slovencina|sk_SK.UTF-8"
    "Deutsch · German|de_DE.UTF-8" "Polski · Polish|pl_PL.UTF-8" "Français · French|fr_FR.UTF-8"
    "Español · Spanish|es_ES.UTF-8" "Italiano · Italian|it_IT.UTF-8" "Português (Brasil) · Portuguese|pt_BR.UTF-8"
    "Nederlands · Dutch|nl_NL.UTF-8" "Magyar · Hungarian|hu_HU.UTF-8" "Svenska · Swedish|sv_SE.UTF-8"
    "Українська · Ukrainian|uk_UA.UTF-8" "English (UK)|en_GB.UTF-8"
)
KEYMAPS=(
    "English (US)|us|" "Czech|cz|" "Czech (QWERTY)|cz|qwerty" "Slovak|sk|" "Slovak (QWERTY)|sk|qwerty"
    "German|de|" "English (UK)|gb|" "French|fr|" "Spanish|es|" "Italian|it|" "Polish|pl|"
    "Hungarian|hu|" "Ukrainian|ua|" "Portuguese|pt|" "Portuguese (Brazil)|br|" "Swedish|se|"
)

pick_from() {  # pick_from "Nadpis" polozka... -> vybrany radek "label|..."
    local header=$1; shift
    local labels=() sel i
    for i in "$@"; do labels+=("$(T "${i%%|*}")"); done
    sel=$(printf '%s\n' "${labels[@]}" "$(T "Other…")" | gum filter --header "$header" --height 14 --placeholder "$(T "Type to search")") || exit 1
    for i in "$@"; do [[ $(T "${i%%|*}") == "$sel" ]] && { echo "$i"; return; }; done
    echo "Other…"   # pevny klic (nezavisly na jazyku pruvodce)
}

# Prevod rozlozeni X11 na konzolove podle tabulky systemd
x11_to_console() {
    local layout=$1 variant=${2:--} map=/usr/share/systemd/kbd-model-map km
    km=$(awk -v l="$layout" -v v="$variant" '$1 !~ /^#/ && $2 == l && $4 == v {print $1; exit}' "$map" 2>/dev/null)
    [[ -z $km ]] && km=$(awk -v l="$layout" '$1 !~ /^#/ && $2 == l {print $1; exit}' "$map" 2>/dev/null)
    echo "${km:-us}"
}

valid_user() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ && $1 != root ]]; }
valid_host() { [[ $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; }

iso_disk() {
    local src
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
    [[ -n $src ]] && lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

list_disks() {
    local iso; iso=$(iso_disk)
    lsblk -dnpbo NAME,SIZE,TYPE,RO,MODEL | while read -r name size type ro model; do
        [[ $type == disk && $ro == 0 ]] || continue
        [[ $name == /dev/zram* || $name == /dev/loop* ]] && continue
        [[ -n $iso && $name == "/dev/$iso" ]] && continue
        ((size >= 20 * 1000 * 1000 * 1000)) || continue
        printf '%s|%s  %s  %s\n' "$name" "$name" "$(numfmt --to=si --suffix=B "$size")" "${model:-disk}"
    done
}

interactive() {
    clear
    gum style --border rounded --border-foreground "$ACCENT" --padding "1 4" --margin "1 2" --align center \
        "$(gum style --foreground "$ACCENT" --bold '✦  LuxOS')" "" \
        "Welcome! This will install LuxOS on your computer." "Vítejte! Tento průvodce nainstaluje LuxOS do počítače."

    # Jazyk (zaroven jazyk pruvodce)
    title "Language · Jazyk"
    local sel
    sel=$(pick_from "Choose the system language · Vyberte jazyk systému" "${LANGS[@]}")
    if [[ $sel == "Other…" ]]; then
        LOCALE=$(grep -oE '^[a-zA-Z_@]+\.UTF-8' /usr/share/i18n/SUPPORTED | sort -u |
                 gum filter --header "$(T "Choose locale")" --height 14) || exit 1
    else
        LOCALE=${sel##*|}
    fi
    ui_lang "$LOCALE"
    info "$(T "Language: %s" "$LOCALE")"
    info "$(T "The installation takes about 10 minutes.")"

    ensure_internet

    # Klavesnice
    title "$(T "Keyboard")"
    # Rozlozeni pro zemi zvoleneho jazyka nahoru (cs_CZ -> cz)
    local country=${LOCALE:3:2} first=() rest=() k
    for k in "${KEYMAPS[@]}"; do
        IFS='|' read -r _ l _ <<<"$k"
        if [[ $l == "${country,,}" ]]; then first+=("$k"); else rest+=("$k"); fi
    done
    sel=$(pick_from "$(T "Choose your keyboard layout")" "${first[@]}" "${rest[@]}")
    if [[ $sel == "Other…" ]]; then
        XKB_LAYOUT=$(localectl list-x11-keymap-layouts | gum filter --header "$(T "Layout")" --height 14) || exit 1
        XKB_VARIANT=$( (echo "(default)"; localectl list-x11-keymap-variants "$XKB_LAYOUT" 2>/dev/null) |
                       gum filter --header "$(T "Variant")" --height 14) || exit 1
        [[ $XKB_VARIANT == "(default)" ]] && XKB_VARIANT=""
    else
        IFS='|' read -r _ XKB_LAYOUT XKB_VARIANT <<<"$sel"
    fi
    # Okamzite pouzit i v live systemu
    if [[ -n ${SUDO_USER-} && -n ${DISPLAY-} ]]; then
        sudo -u "$SUDO_USER" DISPLAY="$DISPLAY" setxkbmap "$XKB_LAYOUT" ${XKB_VARIANT:+-variant "$XKB_VARIANT"} 2>/dev/null || true
    fi
    info "$(T "Keyboard: %s" "$XKB_LAYOUT${XKB_VARIANT:+ ($XKB_VARIANT)}")"

    # Casove pasmo
    title "$(T "Time zone")"
    local detected
    detected=$(curl -fs --max-time 5 'http://ip-api.com/line/?fields=timezone' 2>/dev/null || true)
    if [[ -n $detected && -e /usr/share/zoneinfo/$detected ]] && \
       gum confirm "$(T "Use detected time zone %s?" "$detected")"; then
        TIMEZONE=$detected
    else
        TIMEZONE=$(timedatectl list-timezones | gum filter --header "$(T "Choose time zone")" --height 14) || exit 1
    fi
    info "$(T "Time zone: %s" "$TIMEZONE")"

    # Disk
    title "$(T "Disk")"
    local disks
    mapfile -t disks < <(list_disks)
    local opts=() d
    for d in "${disks[@]}"; do opts+=("${d#*|}"); done
    local advanced
    advanced=$(T "Advanced: use partitions already mounted at %s" "$TARGET")
    local layout_opt
    layout_opt=$(T "Advanced: manual partitioning from a layout file (LVM, encryption)")
    opts+=("$layout_opt" "$advanced")
    sel=$(gum choose --header "$(T "Where should LuxOS be installed?")" "${opts[@]}") || exit 1
    if [[ $sel == "$layout_opt" ]]; then
        DISK=layout DISK_MODE=layout ENCRYPT=0
        ask_layout
    elif [[ $sel == "$advanced" ]]; then
        DISK=manual
        mountpoint -q "$TARGET" || fail "$(T "Nothing is mounted at %s. Mount root (and /boot) first." "$TARGET")"
        ENCRYPT=0
    else
        DISK=${sel%% *}
        info "$(T "All data on %s will be erased." "$DISK")"
        ENCRYPT=0
        if gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" "$(T "Encrypt the disk? (you will enter a password at every start)")"; then
            ENCRYPT=1
            LUKS_PASS=$(ask_password "$(T "Disk encryption password")")
        fi
    fi

    # Uzivatel
    title "$(T "Your account")"
    FULLNAME=$(gum input --header "$(T "Full name")" --placeholder "$(T "Jane Doe")") || exit 1
    local suggested
    suggested=$(iconv -f utf-8 -t ascii//TRANSLIT <<<"${FULLNAME%% *}" 2>/dev/null | tr -cd 'A-Za-z0-9' | tr 'A-Z' 'a-z')
    while :; do
        USERNAME=$(gum input --header "$(T "User name (lowercase)")" --value "${suggested:-user}") || exit 1
        valid_user "$USERNAME" && break
        info "$(T "Use lowercase letters, numbers, - and _ (max 32 characters).")"
    done
    PASSWORD=$(ask_password "$(T "Password")")
    while :; do
        HOSTNAME_SEL=$(gum input --header "$(T "Computer name")" --value "${USERNAME}-luxos") || exit 1
        valid_host "$HOSTNAME_SEL" && break
        info "$(T "Use letters, numbers and - (no spaces).")"
    done
    AUTOLOGIN=0
    gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" "$(T "Log in automatically without a password?")" && AUTOLOGIN=1
    ask_care
    ask_templates
    ask_luxai
    return 0
}

# Udrzba systemu: carefree (automaticke aktualizace a opravy) nebo classic (spravuje uzivatel)
care_text() {
    if [[ $1 == classic ]]; then T "Classic - you manage the system yourself"
    else T "Carefree - automatic updates and repairs"; fi
}

ask_care() {
    title "$(T "Maintenance")"
    info "$(T "Carefree: updates install automatically in the background (not on metered networks, with Data Saver or on low battery), a previous kernel is kept to fall back on and LuxOS repairs itself.")"
    info "$(T "Classic (for IT professionals): no automatic updates or repairs, standard Arch behaviour; you only get notified about available updates.")"
    local carefree classic sel
    carefree="$(T "Carefree (recommended)")"
    classic="$(T "Classic (for IT professionals)")"
    sel=$(gum choose --header "$(T "How should LuxOS be maintained?")" "$carefree" "$classic") || exit 1
    if [[ $sel == "$classic" ]]; then CARE_MODE=classic; else CARE_MODE=carefree; fi
    info "$(care_text "$CARE_MODE")"
}

# Sablony softwaru: aplikace predinstalovane navic k zakladnimu systemu (vice najednou)
ask_templates() {
    title "$(T "Software")"
    info "$(T "Choose apps to preinstall (Space selects, Enter confirms). Select nothing for only the essentials.")"
    local -a ids=() labels=() sel
    local id l
    while IFS= read -r id; do
        ids+=("$id")
        labels+=("$(T "$(tpl_field "$id" name)") - $(tpl_field "$id" apps)")
    done < <(tpl_all)
    ((${#ids[@]})) || { TEMPLATES=""; return 0; }
    mapfile -t sel < <(printf '%s\n' "${labels[@]}" |
        gum choose --no-limit --height 10 --header "$(T "What will you use LuxOS for?")" || true)
    TEMPLATES=""
    for l in "${sel[@]}"; do
        for id in "${!labels[@]}"; do
            [[ ${labels[id]} == "$l" ]] && TEMPLATES+="${TEMPLATES:+,}${ids[id]}"
        done
    done
    parse_templates
    info "$(templates_text)"
}

# Ucet LuxAI (nepovinny): prihlaseni hned pri instalaci, token se ulozi novemu uzivateli
LUXAI_ACCOUNT=""      # JSON ulozeneho uctu (bez hesla), zapise ho configure_system
ask_luxai() {
    title "$(T "LuxAI account")"
    info "$(T "Optional: AI in LuxAI, Lux Code and LSL IDE uses your LuxAI account.")"
    gum confirm --default=false --affirmative "$(T "Sign in")" --negative "$(T "Skip")" \
        "$(T "Sign in to your LuxAI account now?")" || return 0
    local email pw
    while :; do
        email=$(gum input --header "$(T "E-mail")" --value "${email:-}") || return 0
        [[ -n $email ]] || return 0
        pw=$(gum input --password --header "$(T "Password")") || return 0
        if luxai_login "$email" "$pw"; then
            info "$(T "Signed in as %s" "$email")"
            return 0
        fi
        info "$LUXAI_ERROR"
        gum confirm --affirmative "$(T "Try again")" --negative "$(T "Skip")" "$(T "Sign-in failed. Try again?")" || return 0
    done
}

luxai_login() {  # luxai_login EMAIL HESLO -> LUXAI_ACCOUNT, pri chybe LUXAI_ERROR (bez podshellu!)
    local out
    out=$(LUXAI_EMAIL=$1 LUXAI_PASSWORD=$2 python3 - <<'PY'
import json, os, sys, tempfile
sys.path.insert(0, "/usr/lib/luxos/python")
import luxai_account as acc
tmp = tempfile.mkdtemp()
try:
    r = acc.request("POST", "/api/auth/password/login",
                    {"email": os.environ["LUXAI_EMAIL"], "password": os.environ["LUXAI_PASSWORD"]})
    if not r.get("sessionToken"):
        raise acc.AccountError("no_token")
    path = os.path.join(tmp, "a.json")
    print(json.dumps(acc.save(r["sessionToken"], r.get("user") or {}, path=path)))
    os.unlink(path)
except acc.AccountError as e:
    print("ERR " + e.code)
    sys.exit(1)
finally:
    os.rmdir(tmp)
PY
) || { case $out in
        "ERR invalid_credentials") LUXAI_ERROR=$(T "Wrong e-mail or password.") ;;
        "ERR email_unverified") LUXAI_ERROR=$(T "The e-mail address is not verified yet.") ;;
        "ERR network") LUXAI_ERROR=$(T "LuxAI is not reachable. Check the internet connection.") ;;
        *) LUXAI_ERROR=$(T "Sign-in failed (%s)." "${out#ERR }") ;;
    esac; return 1; }
    LUXAI_ACCOUNT=$out
}

ask_password() {
    local p1 p2
    while :; do
        p1=$(gum input --password --header "$1") || exit 1
        [[ ${#p1} -ge 1 ]] || { info "$(T "Password cannot be empty.")" >&2; continue; }
        p2=$(gum input --password --header "$(T "%s (again)" "$1")") || exit 1
        [[ $p1 == "$p2" ]] && break
        info "$(T "Passwords do not match, try again.")" >&2
    done
    printf '%s' "$p1"
}

summary() {
    local disk_text boot_text
    case $DISK_MODE in
        manual)    disk_text=$(T "mounted at %s" "$TARGET") ;;
        freespace) disk_text=$(T "%s  (free space, other systems are kept)" "$DISK") ;;
        layout)    disk_text=$(T "manual partitioning") ;;
        *)         disk_text=$(T "%s  (will be ERASED)" "$DISK") ;;
    esac
    local enc=$ENCRYPT
    [[ $DISK_MODE == layout && -n $(ly_ids luks) ]] && enc=1
    boot_text=${BOOTMODE^^}
    [[ $BOOTLOADER == none ]] && boot_text+=" ($(T "no boot loader"))"
    local -a lines=(
        "$(printf '%-13s%s' "$(T "Language")" "$LOCALE")"
        "$(printf '%-13s%s' "$(T "Keyboard")" "$XKB_LAYOUT${XKB_VARIANT:+ ($XKB_VARIANT)}")"
        "$(printf '%-13s%s' "$(T "Time zone")" "$TIMEZONE")"
        "$(printf '%-13s%s' "$(T "Disk")" "$disk_text")"
        "$(printf '%-13s%s' "$(T "Encryption")" "$([[ $enc == 1 ]] && T "yes" || T "no")")"
        "$(printf '%-13s%s' "$(T "User")" "$FULLNAME ($USERNAME)")"
        "$(printf '%-13s%s' "$(T "Computer")" "$HOSTNAME_SEL")"
        "$(printf '%-13s%s' "$(T "Boot mode")" "$boot_text")"
        "$(printf '%-13s%s' "$(T "Maintenance")" "$(care_text "$CARE_MODE")")"
        "$(printf '%-13s%s' "$(T "Software")" "$(templates_text)")"
        "$(printf '%-13s%s' "LuxAI" "$([[ -n $LUXAI_ACCOUNT ]] && T "signed in" || T "not signed in")")"
    )
    if [[ $DISK_MODE == layout ]]; then
        # Rozlozeni a seznam toho, co se smaze (nic se zatim nemeni)
        local l
        lines+=("" "$(T "Partitions:")")
        while IFS= read -r l; do lines+=("  $l"); done < <(layout_text)
        mapfile -t LY_DESTROY < <(layout_destroy_list)
        if ((${#LY_DESTROY[@]})); then
            lines+=("" "$(T "Will be erased or changed:")")
            for l in "${LY_DESTROY[@]}"; do lines+=("  ! $l"); progress "ERASE $l"; done
        fi
    fi
    if ((PROGRESS)); then
        printf '  %s\n' "${lines[@]}"
    else
        title "$(T "Summary")"
        gum style --border rounded --border-foreground 240 --padding "1 2" "${lines[@]}"
    fi
    ((ASSUME_YES)) && return 0
    gum confirm --default=false --affirmative "$(T "Install")" --negative "$(T "Cancel")" "$(T "Install LuxOS now?")" || exit 1
}

# --- Instalace --------------------------------------------------------------
part_path() {  # part_path /dev/disk N
    local p
    p=$(lsblk -lnpo NAME,PARTN "$1" | awk -v n="$2" '$2 == n {print $1}')
    if [[ -z $p ]]; then   # bez udev: jmeno podle konvence jadra (sda1, nvme0n1p1)
        if [[ $1 == *[0-9] ]]; then p=$1p$2; else p=$1$2; fi
        [[ -b $p ]] || p=""
    fi
    printf '%s\n' "$p"
}

# --- Volne misto vedle jinych systemu (DISK_MODE=freespace) ----------------
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MIN_FREE=$((20 * 1000 * 1000 * 1000))     # nejmensi volna oblast pro LuxOS
MIN_ESP_FREE=$((250 * 1000 * 1000))       # jadro + initramfs na sdilenem ESP

disk_sector_size() {  # logicka velikost sektoru podle sgdisk (funguje i pro obraz disku)
    sgdisk -p "$1" 2>/dev/null | sed -nE 's/^Sector size \(logical[^)]*\): ([0-9]+).*/\1/p' | head -1
}

free_region() {  # free_region DISK -> "ZACATEK KONEC BAJTU" nejvetsi volne oblasti (sektory, zarovnany zacatek)
    local start end ss
    start=$(sgdisk -f "$1" 2>/dev/null) || return 0
    end=$(sgdisk -E "$1" 2>/dev/null) || return 0
    ss=$(disk_sector_size "$1")
    [[ $start =~ ^[0-9]+$ && $end =~ ^[0-9]+$ && $ss =~ ^[0-9]+$ ]] || return 0
    ((end > start)) || return 0
    echo "$start $end $(((end - start + 1) * ss))"
}

free_partnum() {  # prvni nepouzite cislo oddilu v GPT
    local used n
    used=" $(sgdisk -p "$1" | awk '$1 ~ /^[0-9]+$/ && NF >= 6 {printf "%s ", $1}')"
    for ((n = 1; n <= 128; n++)); do
        [[ $used == *" $n "* ]] || { echo "$n"; return 0; }
    done
    return 1
}

esp_systems() {  # esp_systems ADRESAR_ESP -> "Windows,kali" podle adresaru v EFI/
    local d n out=()
    for d in "$1"/[Ee][Ff][Ii]/*/; do
        [[ -d $d ]] || continue
        n=$(basename "$d")
        case ${n,,} in
            boot|systemd|linux|luxos|tools) ;;
            microsoft) out+=(Windows) ;;
            *) out+=("$n") ;;
        esac
    done
    local IFS=,
    echo "${out[*]}"
}

esp_info() {  # esp_info ODDIL -> ESP_FREE, ESP_SYSTEMS, ESP_LOADER (pripoji jen pro cteni)
    local esp=$1 mnt tmp=""
    mnt=$(findmnt -nro TARGET --source "$esp" 2>/dev/null | head -1 || true)
    if [[ -z $mnt ]]; then
        tmp=$(mktemp -d /run/luxos-esp.XXXXXX)
        if ! mount -t vfat -o ro "$esp" "$tmp" 2>/dev/null; then rmdir "$tmp"; return 1; fi
        mnt=$tmp
    fi
    ESP_FREE=$(df -B1 --output=avail "$mnt" | tail -1 | tr -d ' ')
    ESP_SYSTEMS=$(esp_systems "$mnt")
    ESP_LOADER=0
    [[ -e $mnt/loader/loader.conf ]] && ESP_LOADER=1
    if [[ -n $tmp ]]; then umount "$tmp"; rmdir "$tmp"; fi
    return 0
}

check_freespace() {  # check_freespace DISK -> FS_ERR (prazdne = lze instalovat), FS_START/FS_END/FS_BYTES, ESP_*
    local disk=$1 region
    FS_ERR="" FS_START=0 FS_END=0 FS_BYTES=0 ESP_PART="" ESP_FREE=0 ESP_SYSTEMS="" ESP_LOADER=0
    if [[ $(blkid -p -o value -s PTTYPE "$disk" 2>/dev/null) != gpt ]]; then
        FS_ERR=not_gpt
        return 0
    fi
    # Poskozenou GPT by sgdisk pri zapisu "opravil" - radeji odmitnout
    if [[ $(sgdisk -v "$disk" 2>/dev/null) != *"No problems found"* ]]; then
        FS_ERR=gpt_problems
        return 0
    fi
    region=$(free_region "$disk")
    [[ -n $region ]] && read -r FS_START FS_END FS_BYTES <<<"$region"
    ESP_PART=$(lsblk -lnpo NAME,PARTTYPE "$disk" 2>/dev/null | awk -v g="$ESP_GUID" 'tolower($2) == g {print $1; exit}')
    if [[ -z $ESP_PART ]]; then   # bez udev databaze lsblk typ oddilu nezna - podle sgdisk
        local n
        n=$(sgdisk -p "$disk" 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && toupper($6) == "EF00" {print $1; exit}')
        [[ -n $n ]] && ESP_PART=$(part_path "$disk" "$n")
    fi
    if [[ -n $ESP_PART ]] && ! esp_info "$ESP_PART"; then
        FS_ERR=esp_mount
    fi
    if ((FS_BYTES < MIN_FREE)); then
        FS_ERR=no_space
    elif [[ $BOOTLOADER == none ]]; then
        FS_ERR=""   # bez zavadece se ESP nepouziva
    elif [[ $BOOTMODE != uefi ]]; then
        FS_ERR=bios
    elif [[ -z $ESP_PART ]]; then
        FS_ERR=no_esp
    elif [[ -z $FS_ERR ]] && ((ESP_FREE < MIN_ESP_FREE)); then
        FS_ERR=esp_small
    fi
    return 0
}

probe() {  # --probe DISK: jen cte, vystup KLIC=hodnota pro GUI
    local disk=$1
    [[ -b $disk ]] || { echo "FREESPACE_ERR=not_block"; exit 1; }
    if [[ -d /sys/firmware/efi/efivars ]]; then BOOTMODE=uefi; else BOOTMODE=bios; fi
    BOOTLOADER=auto
    check_freespace "$disk"
    printf 'BOOTMODE=%s\nPTTYPE=%s\nFREE_BYTES=%s\nESP=%s\nESP_FREE=%s\nESP_LOADER=%s\nSYSTEMS=%s\nFREESPACE_ERR=%s\n' \
        "$BOOTMODE" "$(blkid -p -o value -s PTTYPE "$disk" 2>/dev/null || true)" "$FS_BYTES" "$ESP_PART" \
        "$ESP_FREE" "$ESP_LOADER" "$ESP_SYSTEMS" "$FS_ERR"
}

freespace_error() {  # citelna zprava k FS_ERR
    case $1 in
        bios)         T "Installing alongside other systems needs a computer started in UEFI mode." ;;
        not_gpt)      T "Disk %s does not use a GPT partition table." "$DISK" ;;
        gpt_problems) T "The partition table on %s has problems. Check it first (sgdisk -v)." "$DISK" ;;
        no_space)     T "Disk %s has no free space of at least 20 GB." "$DISK" ;;
        no_esp)       T "No EFI system partition found on %s." "$DISK" ;;
        esp_mount)    T "The EFI system partition %s could not be read." "$ESP_PART" ;;
        esp_small)    T "The EFI system partition %s has less than 250 MB free." "$ESP_PART" ;;
        *)            printf '%s' "$1" ;;
    esac
}

# Sifrovani (volitelne) a btrfs se subvolumy na korenovem oddilu, pripojeni do $TARGET
encrypt_root() {
    ROOTDEV=$1
    if ((ENCRYPT)); then
        step "$(T "Encrypting the disk")"
        printf '%s' "$LUKS_PASS" | run cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$1"
        printf '%s' "$LUKS_PASS" | run cryptsetup open --allow-discards --perf-no_read_workqueue \
            --perf-no_write_workqueue --persistent --key-file - "$1" cryptroot
        LUKS_UUID=$(blkid -s UUID -o value "$1")
        ROOTDEV=/dev/mapper/cryptroot
    fi
}

mount_root() {
    run mkfs.btrfs -f -L LuxOS "$ROOTDEV"
    local mntopts=noatime,compress=zstd:1 sv
    run mount "$ROOTDEV" "$TARGET"
    for sv in @ @home @log @cache; do run btrfs subvolume create "$TARGET/$sv"; done
    run umount "$TARGET"
    run mount -o "$mntopts,subvol=@" "$ROOTDEV" "$TARGET"
    mkdir -p "$TARGET"/{boot,home,var/log,var/cache}
    run mount -o "$mntopts,subvol=@home"  "$ROOTDEV" "$TARGET/home"
    run mount -o "$mntopts,subvol=@log"   "$ROOTDEV" "$TARGET/var/log"
    run mount -o "$mntopts,subvol=@cache" "$ROOTDEV" "$TARGET/var/cache"
}

prepare_disk() {
    step "$(T "Preparing disk %s" "$DISK")"
    swapoff -a 2>/dev/null || true
    umount -R "$TARGET" 2>/dev/null || true
    [[ -e /dev/mapper/cryptroot ]] && cryptsetup close cryptroot 2>/dev/null || true

    run wipefs -af "$DISK"
    run sgdisk --zap-all "$DISK"
    if [[ $BOOTMODE == uefi ]]; then
        run sgdisk -n1:0:+1G -t1:ef00 -c1:EFI -n2:0:0 -t2:8304 -c2:LuxOS "$DISK"
    else
        run sgdisk -n1:0:+1M -t1:ef02 -c1:BIOS -n2:0:+1G -t2:8300 -c2:boot -n3:0:0 -t3:8304 -c3:LuxOS "$DISK"
    fi
    run partprobe "$DISK" || true
    run udevadm settle

    local rootpart
    if [[ $BOOTMODE == uefi ]]; then
        BOOTPART=$(part_path "$DISK" 1); rootpart=$(part_path "$DISK" 2)
    else
        BOOTPART=$(part_path "$DISK" 2); rootpart=$(part_path "$DISK" 3)
    fi
    [[ -b $BOOTPART && -b $rootpart ]] || fail "$(T "Partitions were not created correctly")"

    encrypt_root "$rootpart"

    step "$(T "Creating file systems")"
    if [[ $BOOTMODE == uefi ]]; then run mkfs.fat -F32 -n EFI "$BOOTPART"
    else run mkfs.ext4 -F -L boot "$BOOTPART"; fi
    mount_root
    if [[ $BOOTMODE == uefi ]]; then run mount -o fmask=0077,dmask=0077 "$BOOTPART" "$TARGET/boot"
    else run mount "$BOOTPART" "$TARGET/boot"; fi
}

# Novy oddil jen v nejvetsi volne oblasti; existujici oddily ani ESP se neformatuji
prepare_freespace() {
    step "$(T "Preparing disk %s" "$DISK")"
    umount -R "$TARGET" 2>/dev/null || true
    [[ -e /dev/mapper/cryptroot ]] && cryptsetup close cryptroot 2>/dev/null || true

    check_freespace "$DISK"
    [[ -z $FS_ERR ]] || fail "$(freespace_error "$FS_ERR")"
    local num before after rootpart i
    num=$(free_partnum "$DISK") || fail "$(T "The partition table on %s is full." "$DISK")"
    before=$(sgdisk -p "$DISK" | awk '$1 ~ /^[0-9]+$/ && NF >= 6')
    info "$(T "New partition %s: %s GB of free space" "$num" "$((FS_BYTES / 1000000000))")"
    run sgdisk -n"$num:$FS_START:$FS_END" -t"$num:8304" -c"$num:LuxOS" "$DISK"
    # Kontrola: ostatni oddily musi zustat beze zmeny
    after=$(sgdisk -p "$DISK" | awk -v n="$num" '$1 ~ /^[0-9]+$/ && NF >= 6 && $1 != n')
    [[ $before == "$after" ]] || fail "$(T "Unexpected change of existing partitions on %s - stopping." "$DISK")"

    # Ostatni oddily mohou byt pouzivane - kernelu ohlasit jen novy oddil
    run partprobe "$DISK" || true
    run udevadm settle || true
    for i in 1 2 3 4 5; do
        rootpart=$(part_path "$DISK" "$num")
        [[ -b $rootpart ]] && break
        run partx -a --nr "$num" "$DISK" || true
        run udevadm settle || true
        sleep 1
    done
    [[ -b $rootpart ]] || fail "$(T "Partitions were not created correctly")"
    BOOTPART=$ESP_PART

    encrypt_root "$rootpart"

    step "$(T "Creating file systems")"
    mount_root
    # Sdileny ESP jako /efi; jadro LuxOS zustava v /boot na btrfs a kopiruje se na ESP
    if [[ $BOOTLOADER != none ]]; then
        mkdir -p "$TARGET/efi"
        run mount -o fmask=0077,dmask=0077 "$ESP_PART" "$TARGET/efi"
    fi
}

# --- Sit: rychle mirrory, prubeh stahovani, srozumitelne chyby --------------
MIRRORLIST=/etc/pacman.d/mirrorlist

tz_country() {  # tz_country Europe/Prague -> CZ
    awk -v tz="$1" '$1 !~ /^#/ && $3 == tz {print $1; exit}' /usr/share/zoneinfo/zone.tab 2>/dev/null || true
}

# Nejrychlejsi mirrory v zemi podle casoveho pasma (reflector, kratke timeouty); puvodni seznam
# zustava za nimi jako zaloha. Live system ho pouzije pro pacstrap, configure_system ho kopiruje do cile.
rank_mirrors() {
    local orig=$MIRRORLIST.luxos-orig cc tmp n
    [[ -e $orig ]] || cp "$MIRRORLIST" "$orig" 2>/dev/null || return 0
    command -v reflector >/dev/null || { echo "rank_mirrors: reflector is not installed" >>"$LOG"; return 0; }
    cc=$(tz_country "${TIMEZONE:-}")
    [[ -n $cc ]] || { echo "rank_mirrors: no country for time zone ${TIMEZONE:-}" >>"$LOG"; return 0; }
    progress "STATUS $(T "Looking for the fastest download servers…")"
    info "$(T "Looking for the fastest download servers…")"
    tmp=$(mktemp)
    printf '+ reflector --country %s\n' "$cc" >>"$LOG"
    if timeout 45 reflector --country "$cc" --protocol https --latest 12 --sort rate --number 8 \
            --connection-timeout 3 --download-timeout 5 --threads 4 --save "$tmp" >>"$LOG" 2>&1; then
        n=$(grep -c '^Server *=' "$tmp" || true)
    else
        n=0
    fi
    if ((n >= 2)); then
        {
            echo "# LuxOS: fastest mirrors for $cc (reflector), then the default list as a fallback"
            grep '^Server *=' "$tmp"
            echo
            grep '^Server *=' "$orig" | grep -vxF -f <(grep '^Server *=' "$tmp") || true
        } >"$MIRRORLIST.new"
        mv -f "$MIRRORLIST.new" "$MIRRORLIST"
        info "$(T "Using %s fast download servers near you." "$n")"
    else
        cp -f "$orig" "$MIRRORLIST"
        info "$(T "Using the default download servers.")"
    fi
    progress "STATUS "
    rm -f "$tmp"
}

pac_friendly() {  # surovy radek pacmanu -> srozumitelna veta (prazdny vystup = radek beze zmeny)
    local l=$1 host why
    if [[ $l =~ ^error:\ failed\ retrieving\ file\ \'[^\']*\'\ from\ ([^\ ]+)\ :\ (.*)$ ]]; then
        host=${BASH_REMATCH[1]} why=${BASH_REMATCH[2]}
        case ${why,,} in
            *"too slow"*) T "The server %s is slow, trying another one…" "$host" ;;
            *"timed out"*|*"connect"*|*"resolve"*|*"reset"*|*"refused"*|*"unreachable"*|*"ssl"*)
                T "The server %s is not responding, trying another one…" "$host" ;;
            *) T "Downloading from %s failed, trying another one…" "$host" ;;
        esac
    elif [[ $l =~ ^warning:\ too\ many\ errors\ from\ ([^\ ,]+) ]]; then
        T "The server %s has too many problems, skipping it." "${BASH_REMATCH[1]}"
    elif [[ $l == "error: failed to retrieve some files" || $l == "warning: failed to retrieve some files" ]]; then
        T "Some files could not be downloaded."
    elif [[ $l == "error: failed to commit transaction (failed to retrieve some files)" ]]; then
        T "Downloading the packages did not finish."
    elif [[ $l == "error: failed to synchronize all databases"* ]]; then
        T "The package lists could not be downloaded."
    fi
    return 0
}

human_bytes() { numfmt --to=si --suffix=B --format=%.1f "$1" 2>/dev/null || echo "$1 B"; }

# Prubeh stahovani: velikost cache v cili (pacstrap stahuje do $TARGET/var/cache/pacman/pkg)
# kazde ~2 s -> "@@NET B/s stazeno celkem"; v TUI kazdych 15 s radek s rychlosti
net_sample() {
    ((net == 1)) || return 0
    local now cur d r
    now=${EPOCHREALTIME//[.,]/}
    ((now - net_t >= 1900000)) || return 0
    cur=$(du -sb "$cache" 2>/dev/null | cut -f1 || true)
    d=$((${cur:-0} - base))
    ((d > dl_total)) && d=$dl_total
    r=0
    ((d > got)) && r=$(((d - got) * 1000000 / (now - net_t)))
    ((d > got)) && got=$d
    rate=$(((rate * 6 + r * 4) / 10))
    net_t=$now
    progress "NET $rate $got $dl_total"
    pac_pct
    if ((!PROGRESS && now - tui_t >= 15000000)); then
        tui_t=$now
        local left=""
        ((rate > 0)) && left=" · $(T "about %s min left" "$(((dl_total - got) / rate / 60 + 1))")"
        info "$(T "Downloaded %s of %s" "$(human_bytes "$got")" "$(human_bytes "$dl_total")") · $(human_bytes "$rate")/s$left"
        ((rate < 150000)) && info "$(T "Your internet connection is very slow - the installation will take longer. It has not stopped.")"
    fi
    return 0
}

pac_pct() {  # @@PCT: stahovani 0-40 % (podle bajtu, jinak podle poctu), instalace 40-100 %
    ((total)) || return 0
    local dlp
    if ((net == 2)); then dlp=40
    elif ((net == 1 && dl_total > 0)); then dlp=$((got * 40 / dl_total))
    else dlp=$((dl * 40 / total)); fi
    pct=$((dlp + inst * 60 / total))
    ((pct > 100)) && pct=100
    if ((pct > last)); then progress "PCT $pct"; last=$pct; fi
    return 0
}

net_end() {
    ((net == 1)) || return 0
    net=2
    progress "NET $rate $dl_total $dl_total"
    progress "NET END"
}

# Vystup pacstrapu: surove do logu, na stdout (GUI Podrobnosti / terminal) srozumitelne vety misto chyb site
pac_filter() {
    local line part="" rc eof=0 friendly last_friendly=""
    local total=0 dl=0 inst=0 pct last=-1
    local net=0 dl_total=0 base=0 got=0 rate=0 net_t=0 tui_t=0 cache="$TARGET/var/cache/pacman/pkg"
    while ((!eof)); do
        if IFS= read -r -t 2 line; then
            line=$part$line part=""
        else
            rc=$?
            if ((rc > 128)); then   # nic neprislo - jen zmerit stahovani
                part+=$line
                net_sample
                continue
            fi
            eof=1
            line=$part$line part=""
            [[ -n $line ]] || break
        fi
        printf '%s\n' "$line" >>"$LOG"
        friendly=$(pac_friendly "$line")
        if [[ -n $friendly ]]; then
            if [[ $friendly != "$last_friendly" ]]; then
                printf '%s\n' "$friendly"
                progress "STATUS $friendly"
                last_friendly=$friendly
            fi
        else
            printf '%s\n' "$line"
        fi
        if [[ $line =~ ^Packages?\ \(([0-9]+)\) ]]; then
            total=${BASH_REMATCH[1]} dl=0 inst=0
        elif [[ $line =~ ^Total\ Download\ Size:\ +([0-9.]+)\ +([KMG]?i?B) ]]; then
            dl_total=$(awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[2]}" 'BEGIN {
                m = u == "KiB" ? 1024 : u == "MiB" ? 1048576 : u == "GiB" ? 1073741824 : 1; printf "%.0f", n * m }')
            base=$(du -sb "$cache" 2>/dev/null | cut -f1 || true)
            base=${base:-0} got=0 rate=0 net=1
            net_t=${EPOCHREALTIME//[.,]/} tui_t=$net_t
            ((dl_total > 0)) && progress "NET 0 0 $dl_total" || net=0
        elif ((total)) && [[ $line == *' downloading...' ]]; then
            dl=$((dl + 1))
        elif [[ $line =~ ^(\([\ 0-9/]+\)\ )?(checking\ keyring|checking\ keys|checking\ package\ integrity|loading\ package\ files|checking\ for\ file\ conflicts|installing\ |upgrading\ |reinstalling\ |::\ Processing\ package\ changes) ]]; then
            net_end
            [[ $line =~ ^(installing|upgrading|reinstalling)\  ]] && ((total)) && inst=$((inst + 1))
        fi
        net_sample
        pac_pct
    done
    ((net == 1)) && progress "NET END"
    return 0
}

# Po nepovedenem pokusu: zamek databaze, nedokoncena stahovani a gpg-agent z predchoziho behu
pac_cleanup() {
    gpgconf --homedir "$TARGET/etc/pacman.d/gnupg" --kill all >/dev/null 2>&1 || true
    rm -f "$TARGET/var/lib/pacman/db.lck"
    find "$TARGET/var/cache/pacman/pkg" "$TARGET/var/lib/pacman/sync" -name '*.part' -delete 2>/dev/null || true
    find "$TARGET/var/cache/pacman/pkg" -mindepth 1 -maxdepth 1 -type d -name 'download-*' \
        -exec rm -rf {} + 2>/dev/null || true
    return 0
}

wait_internet() {  # pri vypadku pripojeni pockat (max. ~10 min), pak to zkusit tak jako tak
    local i
    for ((i = 0; i < 60; i++)); do
        have_internet && return 0
        if ((i == 0)); then
            progress "STATUS $(T "Waiting for the internet connection…")"
            info "$(T "Waiting for the internet connection…")"
        fi
        sleep 10
    done
    return 0
}

install_packages() {
    step "$(T "Detecting hardware")"
    local -a pkgs hw
    mapfile -t pkgs < <(grep -vE '^\s*(#|$)' "$SHARE/packages")
    if [[ $BOOTLOADER != none ]]; then
        if [[ $BOOTMODE == uefi ]]; then pkgs+=(efibootmgr); else pkgs+=(grub); fi
    fi
    [[ $DISK_MODE == layout ]] && mapfile -t -O "${#pkgs[@]}" pkgs < <(layout_packages)
    mapfile -t hw < <(luxos-hwdetect --packages --kernel linux-zen)
    luxos-hwdetect --report | sed 's/^/  /'
    pkgs+=("${hw[@]}")
    # NVIDIA do initramfs jen bez integrovane grafiky (u hybridni jen zpomaluje start)
    NVIDIA_EARLY=0
    if [[ " ${hw[*]} " == *" nvidia-open-dkms "* && " ${hw[*]} " != *" nvidia-prime "* ]]; then NVIDIA_EARLY=1; fi

    step "$(T "Installing packages (this is the longest step)")"
    rank_mirrors
    local attempt retry_conf=/run/luxos-pacman-retry.conf
    local -a conf=()
    for attempt in 1 2 3; do
        # anglicky vystup pacmanu kvuli rozpoznani prubehu a chyb
        if LC_ALL=C.UTF-8 pacstrap "${conf[@]}" -K "$TARGET" --needed "${pkgs[@]}" 2>&1 | pac_filter; then
            progress "STATUS "
            return 0
        fi
        ((attempt < 3)) || break
        progress "STATUS $(T "Download failed (attempt %s), retrying…" "$attempt")"
        info "$(T "Download failed (attempt %s), retrying…" "$attempt")"
        pac_cleanup
        sleep $((attempt * 5))
        wait_internet
        # Dalsi pokus s mene soubeznymi stahovanimi: pomale linky pak nespadnou pod limit pacmanu
        sed -E 's/^#?[[:space:]]*ParallelDownloads.*/ParallelDownloads = 3/' /etc/pacman.conf >"$retry_conf"
        conf=(-C "$retry_conf")
    done
    fail "$(T "Packages could not be installed. Check the internet connection.")"
}

configure_system() {
    step "$(T "Configuring the system")"
    # zram swap live systemu nepatri do fstab (instalovany system ma vlastni zram-generator)
    swapoff /dev/zram* 2>/dev/null || true
    genfstab -U "$TARGET" | sed 's/,subvolid=[0-9]*//' | grep -v zram >"$TARGET/root/fstab.new"
    # Vedle jinych systemu: aktivni swap patri jim (LuxOS ma zram)
    [[ $DISK_MODE == @(freespace|layout) ]] && sed -i '/[[:space:]]swap[[:space:]]/d' "$TARGET/root/fstab.new"
    # Rucni rozdeleni: swap z LAYOUT (pri instalaci se nezapina, genfstab ho nevidi)
    [[ $DISK_MODE == layout ]] && layout_fstab_swap >>"$TARGET/root/fstab.new"
    cat "$TARGET/root/fstab.new" >>"$TARGET/etc/fstab"
    rm -f "$TARGET/root/fstab.new"
    # crypttab (+ crypttab.initramfs a klice pro dalsi svazky) pred mkinitcpio v setup-chroot
    local enc_hook=$ENCRYPT lvm_hook=0
    if [[ $DISK_MODE == layout ]]; then
        layout_write_crypt
        local hooks
        hooks=$(layout_hooks)
        enc_hook=${hooks#ENCRYPT_HOOK=}; enc_hook=${enc_hook%% *}
        lvm_hook=${hooks##*LVM_HOOK=}
    fi

    # pacman: repozitare LuxOS ze serveru (podepsane), Arch ze stejnych mirroru jako live system
    install -m644 /usr/share/luxos/installer/pacman.conf "$TARGET/etc/pacman.conf"
    install -m644 /etc/pacman.d/mirrorlist "$TARGET/etc/pacman.d/mirrorlist"

    local console_km
    console_km=$(x11_to_console "$XKB_LAYOUT" "$XKB_VARIANT")
    local -a hw_svcs
    mapfile -t hw_svcs < <(luxos-hwdetect --services)

    local cmdline="rw quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=auto vt.global_cursor_default=0 nowatchdog zswap.enabled=0"
    local root_uuid
    root_uuid=$(blkid -s UUID -o value "$ROOTDEV")
    local rootspec="root=UUID=$root_uuid rootflags=subvol=@"
    ((ENCRYPT)) && rootspec="rd.luks.name=$LUKS_UUID=cryptroot rd.luks.options=discard root=/dev/mapper/cryptroot rootflags=subvol=@"
    [[ $DISK_MODE == manual ]] && rootspec="root=UUID=$root_uuid$(findmnt -no OPTIONS "$TARGET" | grep -o 'subvol=[^,]*' | sed 's/^/ rootflags=/' | head -1)"
    [[ $DISK_MODE == layout ]] && rootspec=$(layout_cmdline)
    # EFI oddil: /boot (jadro primo na ESP) nebo /efi (sdileny, jadro se kopiruje do EFI/LuxOS/<id>)
    local esp_mount=/boot esp_keep=0 chroot_disk=$DISK
    [[ $DISK_MODE == freespace ]] && esp_mount=/efi esp_keep=1
    if [[ $DISK_MODE == layout ]]; then
        esp_mount=${ESP_MOUNT:-/boot} esp_keep=${ESP_KEEP:-0}
        chroot_disk=${GRUB_DISK:-$DISK}
    fi

    install -Dm600 /dev/stdin "$TARGET/root/luxos-setup.env" <<ENV
LOCALE=$(printf %q "$LOCALE")
XKB_LAYOUT=$(printf %q "$XKB_LAYOUT")
XKB_VARIANT=$(printf %q "$XKB_VARIANT")
CONSOLE_KEYMAP=$(printf %q "$console_km")
TIMEZONE=$(printf %q "$TIMEZONE")
HOSTNAME_SEL=$(printf %q "$HOSTNAME_SEL")
USERNAME=$(printf %q "$USERNAME")
FULLNAME=$(printf %q "$FULLNAME")
AUTOLOGIN=$AUTOLOGIN
ENCRYPT=$ENCRYPT
ENCRYPT_HOOK=$enc_hook
LVM_HOOK=$lvm_hook
ESP_MOUNT=$esp_mount
ESP_KEEP=$esp_keep
BOOTMODE=$BOOTMODE
BOOTLOADER=$(printf %q "$BOOTLOADER")
DISK_MODE=$(printf %q "$DISK_MODE")
ESP_ID=$(printf %q "${root_uuid:0:8}")
NVIDIA_EARLY=${NVIDIA_EARLY:-0}
DISK=$(printf %q "$chroot_disk")
CMDLINE=$(printf %q "$rootspec $cmdline")
HW_SERVICES=$(printf %q "${hw_svcs[*]}")
ENV
    # Rezim udrzby pro luxos-care
    install -Dm644 /dev/stdin "$TARGET/etc/luxos/care.conf" <<<"MODE=$CARE_MODE"
    install -m700 "$SHARE/setup-chroot.sh" "$TARGET/root/luxos-setup.sh"
    arch-chroot "$TARGET" /root/luxos-setup.sh 2>&1 | tee -a "$LOG"
    printf '%s:%s\n' "$USERNAME" "$PASSWORD" | arch-chroot "$TARGET" chpasswd
    # Ucet LuxAI do ~/.config/luxai/account.json noveho uzivatele (0700/0600)
    if [[ -n $LUXAI_ACCOUNT ]]; then
        local home="$TARGET/home/$USERNAME"
        install -d -m700 "$home/.config" "$home/.config/luxai"
        (umask 077; printf '%s\n' "$LUXAI_ACCOUNT" >"$home/.config/luxai/account.json")
        arch-chroot "$TARGET" chown -R "$USERNAME:" "/home/$USERNAME/.config"
    fi
    rm -f "$TARGET/root/luxos-setup.sh" "$TARGET/root/luxos-setup.env"

    # bootctl v chrootu nezapisuje EFI promenne - polozku "LuxOS" vytvorit z live systemu
    if [[ $BOOTLOADER != none && $BOOTMODE == uefi ]] && command -v efibootmgr >/dev/null; then
        if [[ $DISK_MODE == erase ]]; then
            efibootmgr -q -B -L LuxOS >/dev/null 2>&1 || true
            run efibootmgr --create --disk "$DISK" --part 1 --label LuxOS \
                --loader '\EFI\systemd\systemd-bootx64.efi' --unicode || info "$(T "Could not add UEFI boot entry (fallback loader will be used)")"
        elif [[ $DISK_MODE == freespace ]]; then
            shared_esp_entry
        elif [[ $DISK_MODE == layout && -n ${ESP_PART-} ]]; then
            if ((ESP_KEEP)); then
                DISK=$(ly_parent_disk "$ESP_PART") shared_esp_entry
            else
                efibootmgr -q -B -L LuxOS >/dev/null 2>&1 || true
                run efibootmgr --create --disk "$(ly_parent_disk "$ESP_PART")" --part "$(ly_partnum "$ESP_PART")" \
                    --label LuxOS --loader '\EFI\systemd\systemd-bootx64.efi' --unicode ||
                    info "$(T "Could not add UEFI boot entry (fallback loader will be used)")"
            fi
        fi
    fi
}

# --- Sablony softwaru (TEMPLATES) -------------------------------------------
# Kazda sablona je soubor $SHARE/templates/<id>.list (popis @klic hodnota + baliky, viz everyday.list).
# Instaluji se az po zakladnim systemu; chyba sablony instalaci nikdy nezastavi (jen varovani).
TEMPLATE_DIR=$SHARE/templates
TEMPLATE_IDS=()

tpl_field() {  # tpl_field ID KLIC -> hodnota "@KLIC hodnota" (prvni vyskyt)
    sed -nE "s/^@$2[[:space:]]+//p" "$TEMPLATE_DIR/$1.list" 2>/dev/null | head -1 | sed 's/[[:space:]]*$//'
}

tpl_all() {  # vsechny dostupne sablony podle @order
    local f
    for f in "$TEMPLATE_DIR"/*.list; do
        [[ -r $f ]] || continue
        f=${f##*/}
        printf '%s %s\n' "$(tpl_field "${f%.list}" order)" "${f%.list}"
    done | sort -n | cut -d' ' -f2
}

parse_templates() {  # TEMPLATES="a,b c" -> TEMPLATE_IDS (nezname se preskoci s varovanim)
    local -a list=()
    local t
    TEMPLATE_IDS=()
    IFS=', ' read -ra list <<<"${TEMPLATES-}"
    for t in "${list[@]}"; do
        [[ -z $t || $t == none ]] && continue
        if [[ $t =~ ^[a-z0-9_-]+$ && -r $TEMPLATE_DIR/$t.list ]]; then
            [[ " ${TEMPLATE_IDS[*]} " == *" $t "* ]] || TEMPLATE_IDS+=("$t")
        else
            info "$(T "Unknown software template %s - skipped." "$t")"
        fi
    done
    TEMPLATES=$(IFS=,; echo "${TEMPLATE_IDS[*]}")
}

templates_text() {  # citelny seznam zvolenych sablon
    ((${#TEMPLATE_IDS[@]})) || { T "Only the essentials"; return 0; }
    local id out=()
    for id in "${TEMPLATE_IDS[@]}"; do out+=("$(T "$(tpl_field "$id" name)")"); done
    local IFS=,
    printf '%s' "${out[*]}" | sed 's/,/, /g'
}

lang_candidates() {  # lang_candidates ODDELOVAC -> jazykove pripony baliku (cs_CZ -> "cs-cz", "cs")
    local l=${LOCALE%%.*} ll cc
    l=${l%%@*}
    ll=${l%%_*} cc=${l#*_}
    [[ $l == *_* ]] && printf '%s\n' "${ll,,}$1${cc,,}"
    printf '%s\n' "${ll,,}"
}

tpl_resolve() {  # tpl_resolve ID -> baliky sablony (podminky a jazyk vyhodnoceny; $avail, $installed)
    local line name cond neg any p c
    while read -r line; do
        line=${line%%#*}
        [[ -z ${line// /} || $line == @* ]] && continue
        read -r name cond _ <<<"$line"
        if [[ -n $cond ]]; then
            neg=0; [[ $cond == '?!'* ]] && neg=1
            cond=${cond#\?}; cond=${cond#!}
            any=0
            for p in ${cond//,/ }; do
                grep -qxF -- "$p" <<<"$installed" && any=1
            done
            ((any != neg)) || continue
        fi
        if [[ $name == *%lang%* || $name == *%lang_%* ]]; then
            # jazykovy balicek: prvni existujici varianta, jinak tise vynechat
            local sep=-
            [[ $name == *%lang_%* ]] && sep=_
            for c in $(lang_candidates "$sep"); do
                p=${name//%lang_%/$c}; p=${p//%lang%/$c}
                if grep -qxF -- "$p" <<<"$avail"; then printf '%s\n' "$p"; break; fi
            done
            continue
        fi
        if grep -qxF -- "$name" <<<"$avail"; then
            printf '%s\n' "$name"
        else
            info "$(T "Package %s is not available - skipped." "$name")" >&2
            printf '%s\n' "$name" >>"$TPL_MISSING"
        fi
    done <"$TEMPLATE_DIR/$1.list"
}

chroot_pacman() {  # pacman v cili (skutecny z luxos-pacman), anglicky vystup kvuli pac_filter
    local pac=pacman
    [[ -x $TARGET/usr/lib/lux/alpm/pacman ]] && pac=/usr/lib/lux/alpm/pacman
    LC_ALL=C.UTF-8 arch-chroot "$TARGET" "$pac" "$@"
}

install_templates() {
    ((${#TEMPLATE_IDS[@]})) || return 0
    step "$(T "Installing additional software")"
    info "$(templates_text)"
    local id attempt ok=0 avail installed g
    local -a pkgs=() failed=() groups=()
    TPL_MISSING=$(mktemp)

    # Steam apod.: repozitar multilib (zustane zapnuty kvuli aktualizacim)
    for id in "${TEMPLATE_IDS[@]}"; do
        if [[ $(tpl_field "$id" repo) == multilib ]] && ! grep -q '^\[multilib\]' "$TARGET/etc/pacman.conf"; then
            printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >>"$TARGET/etc/pacman.conf"
            info "$(T "Enabled the multilib repository.")"
        fi
    done

    for attempt in 1 2 3; do
        if chroot_pacman -Sy --noconfirm >>"$LOG" 2>&1; then ok=1; break; fi
        pac_cleanup
        sleep $((attempt * 5))
        wait_internet
    done
    if ((!ok)); then
        progress "STATUS $(T "Additional software was skipped. You can install it later in the LuxOS Store.")"
        info "$(T "The package lists could not be downloaded.") $(T "Additional software was skipped. You can install it later in the LuxOS Store.")"
        rm -f "$TPL_MISSING"
        return 0
    fi
    avail=$(chroot_pacman -Slq 2>>"$LOG" | sort -u) || avail=""
    installed=$(chroot_pacman -Qq 2>>"$LOG") || installed=""

    for id in "${TEMPLATE_IDS[@]}"; do
        mapfile -t -O "${#pkgs[@]}" pkgs < <(tpl_resolve "$id")
        for g in $(tpl_field "$id" groups); do groups+=("$g"); done
    done
    mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | awk 'NF && !seen[$0]++')
    mapfile -t failed <"$TPL_MISSING"
    rm -f "$TPL_MISSING"

    if ((${#pkgs[@]})); then
        ok=0
        for attempt in 1 2 3; do
            # -Su: databaze jsou cerstve (-Sy), bez castecne aktualizace
            if chroot_pacman -Su --needed --noconfirm "${pkgs[@]}" 2>&1 | pac_filter; then ok=1; break; fi
            ((attempt < 3)) || break
            progress "STATUS $(T "Download failed (attempt %s), retrying…" "$attempt")"
            info "$(T "Download failed (attempt %s), retrying…" "$attempt")"
            pac_cleanup
            sleep $((attempt * 5))
            wait_internet
        done
        if ((!ok)); then
            # Spolecna transakce selhala (napr. konflikt): po jednom, chybny balik jen preskocit
            progress "STATUS $(T "Installing the apps one by one…")"
            info "$(T "Installing the apps one by one…")"
            local i=0 p
            for p in "${pkgs[@]}"; do
                i=$((i + 1))
                progress "PCT $((i * 100 / ${#pkgs[@]}))"
                pac_cleanup
                chroot_pacman -S --needed --noconfirm "$p" >>"$LOG" 2>&1 || failed+=("$p")
            done
        fi
    fi
    progress "STATUS "

    # Skupiny (napr. wireshark: zachytavani bez roota)
    for g in "${groups[@]}"; do
        if arch-chroot "$TARGET" getent group "$g" >/dev/null 2>&1; then
            run arch-chroot "$TARGET" gpasswd -a "$USERNAME" "$g" || true
        fi
    done
    install -Dm644 /dev/stdin "$TARGET/etc/luxos/templates.conf" <<<"TEMPLATES=$TEMPLATES" || true

    if ((${#failed[@]})); then
        local IFS=' '
        progress "STATUS $(T "Some apps could not be installed: %s. You can install them later in the LuxOS Store." "${failed[*]}")"
        info "$(T "Some apps could not be installed: %s. You can install them later in the LuxOS Store." "${failed[*]}")"
    fi
    return 0
}

# Sdileny ESP: polozku UEFI pridat jen pokud tam systemd-boot jeste nema vlastni; menu musi byt videt
shared_esp_entry() {
    local partn partuuid entries timeout
    partn=$(lsblk -no PARTN "$ESP_PART" | tr -d ' ')
    partuuid=$(lsblk -no PARTUUID "$ESP_PART" | tr -d ' ')
    entries=$(efibootmgr -v 2>/dev/null || true)
    if [[ -n $partuuid ]] && awk -v u="${partuuid,,}" 'index(tolower($0), u) && index(tolower($0), "systemd-bootx64.efi") {f = 1} END {exit !f}' <<<"$entries"; then
        info "$(T "systemd-boot on %s is already in the UEFI boot menu." "$ESP_PART")"
    else
        run efibootmgr --create --disk "$DISK" --part "$partn" --label LuxOS \
            --loader '\EFI\systemd\systemd-bootx64.efi' --unicode || info "$(T "Could not add UEFI boot entry (fallback loader will be used)")"
    fi
    # Cizi loader.conf se neprepisuje; skryte menu zviditelnit promennou EFI (LoaderConfigTimeout)
    timeout=$(awk '$1 == "timeout" {print $2}' "$TARGET${ESP_MOUNT:-/efi}/loader/loader.conf" 2>/dev/null | tail -1 || true)
    if [[ -z $timeout || $timeout == 0 || $timeout == menu-hidden ]]; then
        run bootctl set-timeout 3 || info "$(T "Could not show the boot menu; hold Space while starting to see it.")"
    fi
}

finish() {
    step "$(T "Finishing")"
    cp "$LOG" "$TARGET/var/log/luxos-install.log" 2>/dev/null || true
    sync
    # gpg-agent spusteny pacstrapem (-K) by drzel $TARGET pripojeny
    gpgconf --homedir "$TARGET/etc/pacman.d/gnupg" --kill all >/dev/null 2>&1 || true
    local i
    for i in 1 2 3 4 5; do   # agent konci asynchronne
        mountpoint -q "$TARGET" || break
        umount -R "$TARGET" 2>/dev/null && break
        sleep 1
    done
    ((ENCRYPT)) && cryptsetup close cryptroot 2>/dev/null || true
    [[ $DISK_MODE == layout ]] && layout_teardown
    if ((PROGRESS)); then
        info "$(T "LuxOS is installed")"
        progress "DONE"
        return 0
    fi
    echo
    gum style --border rounded --border-foreground "$ACCENT" --padding "1 4" --margin "1 2" --align center \
        "$(gum style --foreground "$ACCENT" --bold "✦  $(T "LuxOS is installed")")" "" \
        "$(T "Remove the installation media and restart your computer.")"
    ((ASSUME_YES)) && return 0
    if gum confirm --affirmative "$(T "Restart")" --negative "$(T "Later")" "$(T "Restart now?")"; then systemctl reboot; fi
}

# --- Rucni rozdeleni (DISK_MODE=layout) ----------------------------------------
load_layout() {  # LAYOUT / LAYOUT_FILE -> L (kontrola konfigurace i zarizeni; nic nemeni)
    local text=${LAYOUT-}
    if [[ -z $text && -n ${LAYOUT_FILE-} ]]; then
        [[ -r $LAYOUT_FILE ]] || fail "$(T "Cannot read %s" "$LAYOUT_FILE")"
        text=$(<"$LAYOUT_FILE")
    fi
    [[ -n $text ]] || fail "$(T "DISK_MODE=layout needs LAYOUT or LAYOUT_FILE")"
    layout_parse "$text"
    layout_validate
    ((${#LY_ERR[@]})) || layout_check_devices
    report_layout
}

report_layout() {  # chyby -> konec se seznamem, varovani jen vypsat
    local e msg
    for e in "${LY_WARN[@]}"; do
        msg=$(ly_error_text "$e")
        progress "WARN $msg"
        info "$(T "Warning: %s" "$msg")"
    done
    ((${#LY_ERR[@]})) || return 0
    for e in "${LY_ERR[@]}"; do
        msg=$(ly_error_text "$e")
        printf '✗ %s\n' "$msg" >&2
        printf '✗ %s\n' "$msg" >>"$LOG" 2>/dev/null || true
    done
    fail "$(ly_error_text "${LY_ERR[0]}")"
}

check_layout_cmd() {  # --check-layout SOUBOR: jen kontrola (bez roota jen konfigurace)
    local text
    if [[ $1 == - ]]; then text=$(cat); else text=$(<"$1"); fi
    if [[ -d /sys/firmware/efi/efivars ]]; then BOOTMODE=${BOOTMODE:-uefi}; else BOOTMODE=${BOOTMODE:-bios}; fi
    BOOTLOADER=${BOOTLOADER:-auto}
    layout_parse "$text"
    layout_validate
    ((EUID == 0 && ${#LY_ERR[@]} == 0)) && layout_check_devices
    local e rc=0
    for e in "${LY_WARN[@]}"; do printf 'WARN %s\t%s\n' "${e%%|*}" "$(ly_error_text "$e")"; done
    for e in "${LY_ERR[@]}"; do printf 'ERROR %s\t%s\n' "${e%%|*}" "$(ly_error_text "$e")"; rc=1; done
    ((rc)) || { layout_text; layout_destroy_list | sed 's/^/ERASE /'; }
    return "$rc"
}

ask_layout() {  # TUI: rozlozeni ze souboru (vytvori ho napr. GUI nebo podle install.conf.example)
    local f
    f=$(gum input --header "$(T "Path to the partition layout file (LAYOUT format)")" --value "/root/layout.conf") || exit 1
    LAYOUT_FILE=$f LAYOUT=""
    [[ -r $f ]] || fail "$(T "Cannot read %s" "$f")"
    layout_parse "$(<"$f")"
    if [[ -n $(ly_ids luks) ]]; then
        LUKS_PASS=$(ask_password "$(T "Disk encryption password")")
    fi
}

main() {
    if [[ -n $PROBE ]]; then
        probe "$PROBE"
        return 0
    fi
    if ((SCAN)); then
        exec python3 -I /usr/lib/luxos/python/luxos_layout.py --scan
    fi
    if [[ -n $CHECK_LAYOUT ]]; then
        check_layout_cmd "$CHECK_LAYOUT"
        return
    fi
    preflight
    DISK_MODE=${DISK_MODE:-}
    BOOTLOADER=${BOOTLOADER:-auto}
    CARE_MODE=${CARE_MODE:-}
    if [[ -n $CONFIG ]]; then
        if [[ $CONFIG == - ]]; then
            eval "$CONFIG_DATA"
            CONFIG_DATA=""
        else
            # shellcheck disable=SC1090
            . "$CONFIG"
        fi
        [[ -n ${UI_LANG-} ]] && ui_lang "$UI_LANG"
        : "${LOCALE:=en_US.UTF-8}" "${XKB_LAYOUT:=us}" "${XKB_VARIANT:=}" "${TIMEZONE:=UTC}"
        : "${ENCRYPT:=0}" "${AUTOLOGIN:=0}" "${HOSTNAME_SEL:=luxos}" "${FULLNAME:=$USERNAME}"
        : "${BOOTLOADER:=auto}" "${LUXAI_ACCOUNT:=}" "${TEMPLATES:=}"
        [[ ${DISK_MODE-} == manual && -z ${DISK-} ]] && DISK=manual   # pripojeno v /mnt, disk neni potreba
        [[ ${DISK_MODE-} == layout && -z ${DISK-} ]] && DISK=layout   # disky jsou v LAYOUT
        [[ -n ${DISK-}&& -n ${USERNAME-} && -n ${PASSWORD-} ]] || fail "$(T "Config needs DISK, USERNAME and PASSWORD")"
        valid_user "$USERNAME" || fail "$(T "Invalid USERNAME")"
        valid_host "$HOSTNAME_SEL" || fail "$(T "Invalid HOSTNAME_SEL")"
        ((ENCRYPT)) && [[ -z ${LUKS_PASS-} ]] && fail "$(T "ENCRYPT=1 needs LUKS_PASS")"
        have_internet || fail "$(T "No internet connection")"
        # Ucet LuxAI uz prihlaseny v GUI (JSON bez hesla), jinak LUXAI_EMAIL + LUXAI_PASSWORD
        if [[ -n $LUXAI_ACCOUNT ]] && ! python3 -c 'import json, sys; assert json.load(sys.stdin)["sessionToken"]' \
                <<<"$LUXAI_ACCOUNT" 2>/dev/null; then
            info "$(T "LuxAI sign-in failed - continuing without it.")"
            LUXAI_ACCOUNT=""
        fi
        if [[ -z $LUXAI_ACCOUNT && -n ${LUXAI_EMAIL-} && -n ${LUXAI_PASSWORD-} ]]; then
            luxai_login "$LUXAI_EMAIL" "$LUXAI_PASSWORD" || info "$(T "LuxAI sign-in failed - continuing without it.") ($LUXAI_ERROR)"
        fi
    else
        interactive
    fi
    # Rezim disku: erase (cely disk), freespace (vedle jinych systemu), manual (pripojeno v $TARGET)
    [[ $DISK == manual ]] && DISK_MODE=manual
    : "${DISK_MODE:=erase}"
    case $DISK_MODE in
        erase|freespace) ;;
        manual) DISK=manual ;;
        layout) ENCRYPT=0; load_layout ;;   # sifrovani popisuje LAYOUT (luks)
        *) fail "$(T "Invalid DISK_MODE (use erase, freespace, layout or manual)")" ;;
    esac
    [[ $BOOTLOADER == auto || $BOOTLOADER == none ]] || fail "$(T "Invalid BOOTLOADER (use auto or none)")"
    : "${CARE_MODE:=carefree}"
    [[ $CARE_MODE == carefree || $CARE_MODE == classic ]] || fail "$(T "Invalid CARE_MODE (use carefree or classic)")"
    [[ -n $CONFIG ]] && parse_templates
    if [[ $DISK_MODE == manual ]]; then STEP_TOTAL=4
    elif [[ $DISK_MODE == layout ]]; then STEP_TOTAL=$(($(layout_steps) + 4))
    else STEP_TOTAL=$((6 + ENCRYPT)); fi
    ((${#TEMPLATE_IDS[@]})) && STEP_TOTAL=$((STEP_TOTAL + 1))
    summary
    case $DISK_MODE in
        erase) prepare_disk ;;
        freespace) prepare_freespace ;;
        layout) layout_apply ;;
        manual)
            ROOTDEV=$(findmnt -no SOURCE "$TARGET" | sed 's/\[.*\]//')
            BOOTPART=$(findmnt -no SOURCE "$TARGET/boot" 2>/dev/null || true)
            [[ $BOOTMODE == bios ]] && DISK=$(lsblk -no PKNAME "$ROOTDEV" | head -1 | sed 's|^|/dev/|')
            ;;
    esac
    install_packages
    configure_system
    install_templates
    finish
}

main "$@"
