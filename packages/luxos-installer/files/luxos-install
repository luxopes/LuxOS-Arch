# Sablony softwaru: aplikace predinstalovane navic k zakladnimu systemu (vice najednou)
ask_templates() {
    title "$(T "Software")"
    info "$(T "Choose apps to preinstall (Space selects, Enter confirms). Select nothing for only the essentials.")"
    local -a ids=() labels=() sel
    local id l
    while IFS= read -r id; do
        ids+=("$id")
        labels+=("$(T "$(tpl_field "$id" name)") - $(tpl_field "$id" apps)")
    done < <(tpl_all)
    ((${#ids[@]})) || { TEMPLATES=""; return 0; }
    mapfile -t sel < <(printf '%s\n' "${labels[@]}" |
        gum choose --no-limit --height 10 --header "$(T "What will you use LuxOS for?")" || true)
    TEMPLATES=""
    for l in "${sel[@]}"; do
        for id in "${!labels[@]}"; do
            [[ ${labels[id]} == "$l" ]] && TEMPLATES+="${TEMPLATES:+,}${ids[id]}"
        done
    done
    parse_templates
    info "$(templates_text)"
}

# Ucet LuxAI (nepovinny): prihlaseni hned pri instalaci, token se ulozi novemu uzivateli
LUXAI_ACCOUNT=""      # JSON ulozeneho uctu (bez hesla), zapise ho configure_system
ask_luxai() {
    title "$(T "LuxAI account")"
    info "$(T "Optional: AI in LuxAI, Lux Code and LSL IDE uses your LuxAI account.")"
    local how email="" pw pw2 name
    local o_pw o_code o_new o_skip
    o_pw=$(T "Sign in with a password") o_code=$(T "Sign in with a code from e-mail")
    o_new=$(T "Create a new account") o_skip=$(T "Skip")
    while :; do
        how=$(gum choose --header "$(T "Sign in to your LuxAI account now?")" "$o_pw" "$o_code" "$o_new" "$o_skip") \
            || return 0
        case $how in
            "$o_pw")
                email=$(gum input --header "$(T "E-mail")" --value "$email") || continue
                [[ -n $email ]] || continue
                pw=$(gum input --password --header "$(T "Password")") || continue
                if luxai_login "$email" "$pw"; then
                    info "$(T "Signed in as %s" "$email")"
                    return 0
                fi
                info "$LUXAI_ERROR" ;;
            "$o_code")
                email=$(gum input --header "$(T "E-mail")" --value "$email") || continue
                [[ -n $email ]] || continue
                if ! luxai_call code_request "$email"; then
                    info "$LUXAI_ERROR"
                    continue
                fi
                luxai_code_step code_request "$email" "" "" && return 0 ;;
            "$o_new")
                name=$(gum input --header "$(T "Your name")" --value "${name:-${FULLNAME-}}" --char-limit 80) || continue
                email=$(gum input --header "$(T "E-mail")" --value "$email") || continue
                while :; do
                    pw=$(gum input --password --header "$(T "Password (at least %d characters)" 12)") || continue 2
                    if ((${#pw} < 12 || ${#pw} > 128)); then
                        info "$(T "The password must have at least 12 characters.")"
                        continue
                    fi
                    pw2=$(gum input --password --header "$(T "Confirm password")") || continue 2
                    [[ $pw == "$pw2" ]] && break
                    info "$(T "Passwords do not match.")"
                done
                luxai_terms || continue
                if ! luxai_call register "$email" "$pw" "$name"; then
                    info "$LUXAI_ERROR"
                    continue
                fi
                luxai_code_step register "$email" "$pw" "$name" && return 0 ;;
            *) return 0 ;;
        esac
    done
}

luxai_terms() {  # souhlas s podminkami LuxAI (lze si je precist primo v terminalu)
    local o_read o_yes o_no c
    o_read=$(T "Read the terms") o_yes=$(T "I agree to the LuxAI Terms") o_no=$(T "Cancel")
    while :; do
        c=$(gum choose --header "$(T "LuxAI Terms of Use")" "$o_yes" "$o_read" "$o_no") || return 1
        case $c in
            "$o_yes") return 0 ;;
            "$o_read")
                if luxai_call terms; then
                    printf '%s\n' "$LUXAI_OUT" | gum pager
                else
                    info "$LUXAI_ERROR"
                fi ;;
            *) return 1 ;;
        esac
    done
}

luxai_code_step() {  # luxai_code_step AKCE_PRO_NOVY_KOD EMAIL HESLO JMENO -> LUXAI_ACCOUNT
    local again=$1 email=$2 code
    info "$(T "We sent a code to %s." "$email") $(T "The code is valid for 10 minutes. Check also the spam folder.")"
    while :; do
        code=$(gum input --header "$(T "Enter the 6-digit code (leave empty to send a new one)")" \
            --placeholder 000000 --char-limit 6) || return 1
        code=${code//[^0-9]/}
        if [[ -z $code ]]; then
            if luxai_call "$again" "$email" "$3" "$4"; then
                info "$(T "We sent a new code.")"
            else
                info "$LUXAI_ERROR"
            fi
            continue
        fi
        if luxai_call verify "$email" "$code"; then
            LUXAI_ACCOUNT=$LUXAI_OUT
            info "$(T "Signed in as %s" "$email")"
            return 0
        fi
        info "$LUXAI_ERROR"
        [[ $LUXAI_CODE == rate ]] && return 1
    done
}

luxai_login() {  # luxai_login EMAIL HESLO -> LUXAI_ACCOUNT, pri chybe LUXAI_ERROR (bez podshellu!)
    luxai_call password "$1" "$2" || return 1
    LUXAI_ACCOUNT=$LUXAI_OUT
}

# luxai_call AKCE [EMAIL] [HESLO|KOD] [JMENO] -> LUXAI_OUT; pri chybe LUXAI_CODE + LUXAI_ERROR (prelozena hlaska)
#   password EMAIL HESLO | verify EMAIL KOD: JSON uctu (bez hesla, nic se neuklada na disk)
#   code_request EMAIL | register EMAIL HESLO JMENO: posle kod e-mailem | terms: text podminek
luxai_call() {
    local out
    LUXAI_OUT="" LUXAI_CODE="" LUXAI_ERROR=""
    out=$(LUXAI_ACTION=$1 LUXAI_EMAIL=${2-} LUXAI_SECRET=${3-} LUXAI_NAME=${4-} python3 - <<'PY'
import json, os, sys
sys.path.insert(0, "/usr/lib/luxos/python")
import luxai_account as acc
from luxos_i18n import _
a, email, secret, name = (os.environ.get(k, "") for k in ("LUXAI_ACTION", "LUXAI_EMAIL", "LUXAI_SECRET", "LUXAI_NAME"))
try:
    if a == "password":
        print(json.dumps(acc.password_session(email, secret), ensure_ascii=False))
    elif a == "verify":
        print(json.dumps(acc.verify_code(email, secret), ensure_ascii=False))
    elif a == "code_request":
        acc.request_code(email.strip().lower())
        print("OK")
    elif a == "register":
        acc.register_start(email, secret, name)
        print("OK")
    elif a == "terms":
        print(acc.fetch_terms())
    else:
        raise acc.AccountError("usage")
except acc.AccountError as e:
    print("ERR %s\t%s" % (e.code, acc.error_text(e, _).replace("\n", " ")))
    sys.exit(1)
PY
) || {
        LUXAI_CODE=${out%%$'\t'*}
        LUXAI_CODE=${LUXAI_CODE#ERR }
        LUXAI_ERROR=${out#*$'\t'}
        [[ $out == ERR* ]] || { LUXAI_CODE=error; LUXAI_ERROR=$(T "Sign-in failed (%s)." error); }
        return 1
    }
    LUXAI_OUT=$out
}

ask_password() {
    local p1 p2
    while :; do
        p1=$(gum input --password --header "$1") || exit 1
        [[ ${#p1} -ge 1 ]] || { info "$(T "Password cannot be empty.")" >&2; continue; }
        p2=$(gum input --password --header "$(T "%s (again)" "$1")") || exit 1
        [[ $p1 == "$p2" ]] && break
        info "$(T "Passwords do not match, try again.")" >&2
    done
    printf '%s' "$p1"
}

summary() {
    local disk_text boot_text
    case $DISK_MODE in
        manual)    disk_text=$(T "mounted at %s" "$TARGET") ;;
        freespace) disk_text=$(T "%s  (free space, other systems are kept)" "$DISK") ;;
        layout)    disk_text=$(T "manual partitioning") ;;
        partition) disk_text=$(T "partition %s  (will be ERASED, other partitions are kept)" "$ROOT_PART") ;;
        *)         disk_text=$(T "%s  (will be ERASED)" "$DISK") ;;
    esac
    local enc=$ENCRYPT
    uses_layout && [[ -n $(ly_ids luks) ]] && enc=1
    boot_text=${BOOTMODE^^}
    [[ $BOOTLOADER == none ]] && boot_text+=" ($(T "no boot loader"))"
    local -a lines=(
        "$(printf '%-13s%s' "$(T "Language")" "$LOCALE")"
        "$(printf '%-13s%s' "$(T "Keyboard")" "$(xkb_text)")"
        "$(printf '%-13s%s' "$(T "Time zone")" "$TIMEZONE")"
        "$(printf '%-13s%s' "$(T "Disk")" "$disk_text")"
        "$(printf '%-13s%s' "$(T "Encryption")" "$([[ $enc == 1 ]] && T "yes" || T "no")")"
        "$(printf '%-13s%s' "$(T "Erase first")" "$(wipe_text)")"
        "$(printf '%-13s%s' "$(T "User")" "$( ((${OEM:-0})) && oem_user_text || echo "$FULLNAME ($USERNAME)")")"
        "$(printf '%-13s%s' "$(T "Computer")" "$HOSTNAME_SEL")"
        "$(printf '%-13s%s' "$(T "Boot mode")" "$boot_text")"
        "$(printf '%-13s%s' "$(T "Maintenance")" "$(care_text "$CARE_MODE")")"
        "$(printf '%-13s%s' "$(T "Software")" "$(templates_text)")"
        "$(printf '%-13s%s' "LuxAI" "$([[ -n $LUXAI_ACCOUNT ]] && T "signed in" || T "not signed in")")"
    )
    [[ -n ${DOMAIN-} ]] && lines+=("$(printf '%-13s%s' "$(T "Organization")" "$(domain_text)")")
    if [[ $DISK_MODE == layout ]]; then
        # Rozlozeni a seznam toho, co se smaze (nic se zatim nemeni)
        local l
        lines+=("" "$(T "Partitions:")")
        while IFS= read -r l; do lines+=("  $l"); done < <(layout_text)
        mapfile -t LY_DESTROY < <(layout_destroy_list)
        if ((${#LY_DESTROY[@]})); then
            lines+=("" "$(T "Will be erased or changed:")")
            for l in "${LY_DESTROY[@]}"; do lines+=("  ! $l"); progress "ERASE $l"; done
        fi
    elif [[ $DISK_MODE == partition ]]; then
        local l
        while IFS= read -r l; do
            lines+=("$l")
            case $l in
                "  !! "*) progress "WARN ${l#  !! }" ;;
                "  ! "*)  progress "ERASE ${l#  ! }" ;;
            esac
        done < <(part_summary)
    fi
    if ((PROGRESS)); then
        printf '  %s\n' "${lines[@]}"
    else
        title "$(T "Summary")"
        gum style --border rounded --border-foreground 240 --padding "1 2" "${lines[@]}"
    fi
    ((ASSUME_YES)) && return 0
    gum confirm --default=false --affirmative "$(T "Install")" --negative "$(T "Cancel")" "$(T "Install LuxOS now?")" || exit 1
}

# --- Instalace --------------------------------------------------------------
part_path() {  # part_path /dev/disk N
    local p
    p=$(lsblk -lnpo NAME,PARTN "$1" | awk -v n="$2" '$2 == n {print $1}')
    if [[ -z $p ]]; then   # bez udev: jmeno podle konvence jadra (sda1, nvme0n1p1)
        if [[ $1 == *[0-9] ]]; then p=$1p$2; else p=$1$2; fi
        [[ -b $p ]] || p=""
    fi
    printf '%s\n' "$p"
}

# --- Volne misto vedle jinych systemu (DISK_MODE=freespace) ----------------
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MIN_FREE=$((20 * 1000 * 1000 * 1000))     # nejmensi volna oblast pro LuxOS
MIN_ESP_FREE=$((250 * 1000 * 1000))       # jadro + initramfs na sdilenem ESP

disk_sector_size() {  # logicka velikost sektoru podle sgdisk (funguje i pro obraz disku)
    sgdisk -p "$1" 2>/dev/null | sed -nE 's/^Sector size \(logical[^)]*\): ([0-9]+).*/\1/p' | head -1
}

free_region() {  # free_region DISK -> "ZACATEK KONEC BAJTU" nejvetsi volne oblasti (sektory, zarovnany zacatek)
    local start end ss
    start=$(sgdisk -f "$1" 2>/dev/null) || return 0
    end=$(sgdisk -E "$1" 2>/dev/null) || return 0
    ss=$(disk_sector_size "$1")
    [[ $start =~ ^[0-9]+$ && $end =~ ^[0-9]+$ && $ss =~ ^[0-9]+$ ]] || return 0
    ((end > start)) || return 0
    echo "$start $end $(((end - start + 1) * ss))"
}

free_partnum() {  # prvni nepouzite cislo oddilu v GPT
    local used n
    used=" $(sgdisk -p "$1" | awk '$1 ~ /^[0-9]+$/ && NF >= 6 {printf "%s ", $1}')"
    for ((n = 1; n <= 128; n++)); do
        [[ $used == *" $n "* ]] || { echo "$n"; return 0; }
    done
    return 1
}

esp_systems() {  # esp_systems ADRESAR_ESP -> "Windows,kali" podle adresaru v EFI/
    local d n out=()
    for d in "$1"/[Ee][Ff][Ii]/*/; do
        [[ -d $d ]] || continue
        n=$(basename "$d")
        case ${n,,} in
            boot|systemd|linux|luxos|tools) ;;
            microsoft) out+=(Windows) ;;
            *) out+=("$n") ;;
        esac
    done
    local IFS=,
    echo "${out[*]}"
}

esp_info() {  # esp_info ODDIL -> ESP_FREE, ESP_SYSTEMS, ESP_LOADER (pripoji jen pro cteni)
    local esp=$1 mnt tmp=""
    mnt=$(findmnt -nro TARGET --source "$esp" 2>/dev/null | head -1 || true)
    if [[ -z $mnt ]]; then
        tmp=$(mktemp -d /run/luxos-esp.XXXXXX)
        if ! mount -t vfat -o ro "$esp" "$tmp" 2>/dev/null; then rmdir "$tmp"; return 1; fi
        mnt=$tmp
    fi
    ESP_FREE=$(df -B1 --output=avail "$mnt" | tail -1 | tr -d ' ')
    ESP_SYSTEMS=$(esp_systems "$mnt")
    ESP_LOADER=0
    [[ -e $mnt/loader/loader.conf ]] && ESP_LOADER=1
    if [[ -n $tmp ]]; then umount "$tmp"; rmdir "$tmp"; fi
    return 0
}

check_freespace() {  # check_freespace DISK -> FS_ERR (prazdne = lze instalovat), FS_START/FS_END/FS_BYTES, ESP_*
    local disk=$1 region
    FS_ERR="" FS_START=0 FS_END=0 FS_BYTES=0 ESP_PART="" ESP_FREE=0 ESP_SYSTEMS="" ESP_LOADER=0
    if [[ $(blkid -p -o value -s PTTYPE "$disk" 2>/dev/null) != gpt ]]; then
        FS_ERR=not_gpt
        return 0
    fi
    # Poskozenou GPT by sgdisk pri zapisu "opravil" - radeji odmitnout
    if [[ $(sgdisk -v "$disk" 2>/dev/null) != *"No problems found"* ]]; then
        FS_ERR=gpt_problems
        return 0
    fi
    region=$(free_region "$disk")
    [[ -n $region ]] && read -r FS_START FS_END FS_BYTES <<<"$region"
    ESP_PART=$(lsblk -lnpo NAME,PARTTYPE "$disk" 2>/dev/null | awk -v g="$ESP_GUID" 'tolower($2) == g {print $1; exit}')
    if [[ -z $ESP_PART ]]; then   # bez udev databaze lsblk typ oddilu nezna - podle sgdisk
        local n
        n=$(sgdisk -p "$disk" 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && toupper($6) == "EF00" {print $1; exit}')
        [[ -n $n ]] && ESP_PART=$(part_path "$disk" "$n")
    fi
    if [[ -n $ESP_PART ]] && ! esp_info "$ESP_PART"; then
        FS_ERR=esp_mount
    fi
    if ((FS_BYTES < MIN_FREE)); then
        FS_ERR=no_space
    elif [[ $BOOTLOADER == none ]]; then
        FS_ERR=""   # bez zavadece se ESP nepouziva
    elif [[ $BOOTMODE != uefi ]]; then
        FS_ERR=bios
    elif [[ -z $ESP_PART ]]; then
        FS_ERR=no_esp
    elif [[ -z $FS_ERR ]] && ((ESP_FREE < MIN_ESP_FREE)); then
        FS_ERR=esp_small
    fi
    return 0
}

probe() {  # --probe DISK: jen cte, vystup KLIC=hodnota pro GUI
    local disk=$1
    [[ -b $disk ]] || { echo "FREESPACE_ERR=not_block"; exit 1; }
    if [[ -d /sys/firmware/efi/efivars ]]; then BOOTMODE=uefi; else BOOTMODE=bios; fi
    BOOTLOADER=auto
    check_freespace "$disk"
    printf 'BOOTMODE=%s\nPTTYPE=%s\nFREE_BYTES=%s\nESP=%s\nESP_FREE=%s\nESP_LOADER=%s\nSYSTEMS=%s\nFREESPACE_ERR=%s\n' \
        "$BOOTMODE" "$(blkid -p -o value -s PTTYPE "$disk" 2>/dev/null || true)" "$FS_BYTES" "$ESP_PART" \
        "$ESP_FREE" "$ESP_LOADER" "$ESP_SYSTEMS" "$FS_ERR"
    # Existujici oddily pro DISK_MODE=partition (PART_BOOT_ERR, PART_ESP, PART=...)
    part_probe "$disk"
}

freespace_error() {  # citelna zprava k FS_ERR
    case $1 in
        bios)         T "Installing alongside other systems needs a computer started in UEFI mode." ;;
        not_gpt)      T "Disk %s does not use a GPT partition table." "$DISK" ;;
        gpt_problems) T "The partition table on %s has problems. Check it first (sgdisk -v)." "$DISK" ;;
        no_space)     T "Disk %s has no free space of at least 20 GB." "$DISK" ;;
        no_esp)       T "No EFI system partition found on %s." "$DISK" ;;
        esp_mount)    T "The EFI system partition %s could not be read." "$ESP_PART" ;;
        esp_small)    T "The EFI system partition %s has less than 250 MB free." "$ESP_PART" ;;
        *)            printf '%s' "$1" ;;
    esac
}

# --- Existujici oddil (DISK_MODE=partition) --------------------------------------
# LuxOS se nainstaluje do jednoho vybraneho oddilu (naformatuje se jako btrfs, volitelne LUKS2).
# Ostatni oddily zustanou beze zmeny, EFI oddil se sdili bez formatovani (jako freespace),
# volitelne se jiny existujici oddil pripoji jako /home bez formatovani.
# Konfigurace: ROOT_PART=/dev/sda3 [HOME_PART=/dev/sda4]; provedeni obstara layout.sh (vlastni LAYOUT).
MIN_PART=$MIN_FREE                       # nejmensi oddil pro LuxOS (stejne jako volne misto)
PART_HOME_FS=" ext4 btrfs xfs f2fs "     # FS, ktere lze bez formatovani pouzit jako /home
PART_FIELDS="dev size fstype label root_err home_err content name"   # sloupce radku PART= (--probe)

uses_layout() { [[ $DISK_MODE == @(layout|partition) ]]; }   # disky pripravuje layout.sh

part_disks() {  # disky, na kterych lze hledat oddily (bez instalacniho media, zram, loop, jen pro cteni)
    local iso
    iso=$(iso_disk)
    lsblk -dnpo NAME,TYPE,RO 2>/dev/null |
        awk -v iso="/dev/$iso" '$2 == "disk" && $3 == 0 && $1 !~ /^\/dev\/(zram|loop)/ && $1 != iso {print $1}'
}

part_list() {  # part_list DISK -> oddily disku v poradi
    lsblk -lnpo NAME,TYPE "$1" 2>/dev/null | awk '$2 == "part" {print $1}'
}

part_blkid() {  # part_blkid DEV -> PB_TYPE, PB_LABEL, PB_PTYPE (typ oddilu GUID / 0xNN), PB_SCHEME (cte primo z disku)
    local line k v
    PB_TYPE="" PB_LABEL="" PB_PTYPE="" PB_SCHEME=""
    while IFS= read -r line; do
        k=${line%%=*} v=${line#*=}
        case $k in
            TYPE) PB_TYPE=$v ;;
            LABEL) PB_LABEL=$v ;;
            PART_ENTRY_TYPE) PB_PTYPE=${v,,} ;;
            PART_ENTRY_SCHEME) PB_SCHEME=$v ;;
        esac
    done < <(blkid -p -o export "$1" 2>/dev/null || true)
    # bez zaznamu z blkid (napr. prazdny oddil): typ oddilu podle udev
    [[ -n $PB_PTYPE ]] || PB_PTYPE=$(lsblk -dno PARTTYPE "$1" 2>/dev/null | tr -d ' ' | tr 'A-Z' 'a-z')
    PB_LABEL=${PB_LABEL//[$'\t\n']/ }
    return 0
}

part_holders() {  # neco nad oddilem (device mapper, RAID) - i bez pripojeni
    compgen -G "/sys/class/block/${1##*/}/holders/*" >/dev/null
}

part_check() {  # part_check DEV -> PC_ROOT_ERR / PC_HOME_ERR (prazdne = lze pouzit pro / / pro /home), PC_SIZE, PC_TYPE, PC_LABEL
    local dev=$1 err="" iso
    PC_ROOT_ERR="" PC_HOME_ERR="" PC_SIZE=0 PC_TYPE="" PC_LABEL=""
    if ! ly_isblk "$dev"; then
        PC_ROOT_ERR=not_found PC_HOME_ERR=not_found
        return 0
    fi
    part_blkid "$dev"
    PC_TYPE=$PB_TYPE PC_LABEL=$PB_LABEL
    PC_SIZE=$(blockdev --getsize64 "$dev" 2>/dev/null || echo 0)
    iso=$(iso_disk)
    if [[ $(lsblk -dno TYPE "$dev" 2>/dev/null | tr -d ' ') != part && -z $PB_SCHEME ]]; then err=not_part
    elif [[ -n $iso && $(ly_parent_disk "$dev") == "/dev/$iso" ]]; then err=iso
    elif ly_busy "$dev" || part_holders "$dev"; then err=busy
    else
        case $PB_PTYPE in
            "$ESP_GUID"|0xef) err=esp ;;
            0x5|0xf|0x85) err=extended ;;
            # Microsoft reserved, Windows recovery, BIOS boot
            e3c9e316-0b5c-4db8-817d-f92df00215ae|de94bba4-06d1-4d40-a16a-bfd50179d6ac|21686148-6449-6e6f-744e-656564454649|0x27) err=system ;;
        esac
    fi
    if [[ -z $err ]]; then
        case $PB_TYPE in
            LVM2_member) err=lvm ;;
            crypto_LUKS) err=luks ;;
            *_raid_member|zfs_member) err=raid ;;
        esac
    fi
    PC_ROOT_ERR=$err PC_HOME_ERR=$err
    if [[ -z $err ]]; then
        ((PC_SIZE >= MIN_PART)) || PC_ROOT_ERR=small
        [[ $PART_HOME_FS == *" $PC_TYPE "* ]] || PC_HOME_ERR=home_fs
    fi
    return 0
}

part_peek_dir() {  # part_peek_dir ADRESAR -> PP_CONTENT (windows|os|data|empty_fs), PP_NAME, PP_SUBVOL (pripojeny FS)
    local d=$1 f
    if compgen -G "$d/[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/[Ss][Yy][Ss][Tt][Ee][Mm]32" >/dev/null; then
        PP_CONTENT=windows PP_NAME=Windows
    else
        # Linux: os-release primo nebo v obvyklem subvolumu btrfs
        for f in "$d"/etc/os-release "$d"/usr/lib/os-release "$d"/@/etc/os-release "$d"/@/usr/lib/os-release \
                 "$d"/@rootfs/etc/os-release "$d"/root/etc/os-release; do
            [[ -f $f ]] || continue
            PP_CONTENT=os
            PP_NAME=$(sed -nE 's/^PRETTY_NAME=["'\'']?([^"'\'']*)["'\'']?[[:space:]]*$/\1/p' "$f" | head -1 | tr -d '\t' | cut -c1-48)
            [[ -n $PP_NAME ]] || PP_NAME=Linux
            break
        done
    fi
    [[ -d $d/@home ]] && PP_SUBVOL=@home
    [[ -n $PP_CONTENT ]] && return 0
    if [[ -n $(find "$d" -mindepth 1 -maxdepth 1 ! -name lost+found ! -name '$RECYCLE.BIN' \
               ! -name 'System Volume Information' -print -quit 2>/dev/null) ]]; then
        PP_CONTENT=data
    else
        PP_CONTENT=empty_fs
    fi
    return 0
}

part_peek() {  # part_peek DEV FSTYPE -> PP_CONTENT, PP_NAME, PP_SUBVOL (pripoji jen pro cteni, bez prehrani zurnalu)
    local dev=$1 t=$2 mnt tmp="" opts
    PP_CONTENT="" PP_NAME="" PP_SUBVOL=""
    case $t in
        "") PP_CONTENT=empty; return 0 ;;
        BitLocker) PP_CONTENT=bitlocker PP_NAME=Windows; return 0 ;;
        apfs|hfsplus|hfs) PP_CONTENT=macos PP_NAME=macOS; return 0 ;;
        swap) PP_CONTENT=swap; return 0 ;;
        ntfs) opts="-t ntfs3 -o ro" ;;
        ext2|ext3|ext4) opts="-t $t -o ro,noload" ;;
        btrfs) opts="-t btrfs -o ro,rescue=nologreplay" ;;
        xfs|f2fs) opts="-t $t -o ro,norecovery" ;;
        vfat|exfat) opts="-t $t -o ro" ;;
        *) PP_CONTENT=unknown; return 0 ;;
    esac
    mnt=$(findmnt -nro TARGET --source "$dev" 2>/dev/null | head -1 || true)
    if [[ -z $mnt ]]; then
        tmp=$(mktemp -d /run/luxos-peek.XXXXXX 2>/dev/null) || { PP_CONTENT=unknown; return 0; }
        # shellcheck disable=SC2086
        if ! timeout 30 mount $opts "$dev" "$tmp" >/dev/null 2>&1; then
            rmdir "$tmp"
            PP_CONTENT=unknown
            return 0
        fi
        mnt=$tmp
    fi
    part_peek_dir "$mnt"
    if [[ -n $tmp ]]; then
        umount "$tmp" 2>/dev/null || umount -l "$tmp" 2>/dev/null || true
        rmdir "$tmp" 2>/dev/null || true
    fi
    return 0
}

part_other_os() { [[ $1 == @(windows|os|macos|bitlocker) ]]; }   # obsah = jiny operacni system

part_reason() {  # kratky duvod, proc oddil nelze pouzit
    case $1 in
        not_found) T "does not exist" ;;
        not_part)  T "not a partition" ;;
        iso)       T "installation medium" ;;
        busy)      T "in use (mounted)" ;;
        esp)       T "EFI system partition" ;;
        extended)  T "extended partition" ;;
        system)    T "system partition (reserved or recovery)" ;;
        lvm)       T "part of LVM" ;;
        luks)      T "encrypted (LUKS)" ;;
        raid)      T "part of RAID or a storage pool" ;;
        small)     T "smaller than 20 GB" ;;
        home_fs)   T "no Linux file system for /home" ;;
        same)      T "already chosen for LuxOS" ;;
        *)         printf '%s' "$1" ;;
    esac
}

part_content_text() {  # part_content_text OBSAH JMENO -> popis obsahu oddilu
    case $1 in
        windows|os|macos) T "Operating system: %s" "$2" ;;
        bitlocker) T "Encrypted with BitLocker (Windows)" ;;
        data)      T "Files (no operating system found)" ;;
        empty_fs)  T "Empty file system" ;;
        empty)     T "Empty (no file system)" ;;
        swap)      T "Swap space" ;;
        *)         T "Contents could not be checked" ;;
    esac
}

part_desc() {  # part_desc DEV VELIKOST FS POPISEK -> "/dev/sda3  120.0GB  ntfs  "Data""
    printf '%s  %s  %s%s' "$1" "$(human_bytes "$2")" "${3:-?}" "${4:+  \"$4\"}"
}

part_find_esp() {  # part_find_esp DISK -> EFI oddil na stejnem disku, jinak na jinem
    local d p
    for d in "$1" $(part_disks); do
        for p in $(part_list "$d"); do
            part_blkid "$p"
            [[ $PB_PTYPE == "$ESP_GUID" || $PB_PTYPE == 0xef ]] && { echo "$p"; return 0; }
        done
    done
    return 0
}

part_boot_check() {  # part_boot_check DISK -> PART_BOOT_ERR (prazdne = lze), PART_ESP, ESP_FREE, ESP_SYSTEMS
    PART_BOOT_ERR="" PART_ESP="" ESP_FREE=0 ESP_SYSTEMS="" ESP_LOADER=0
    [[ $BOOTLOADER == none ]] && return 0   # bez zavadece se ESP nepouziva
    if [[ $BOOTMODE != uefi ]]; then PART_BOOT_ERR=bios; return 0; fi
    PART_ESP=$(part_find_esp "$1")
    if [[ -z $PART_ESP ]]; then PART_BOOT_ERR=no_esp
    elif ! esp_info "$PART_ESP"; then PART_BOOT_ERR=esp_mount
    elif ((ESP_FREE < MIN_ESP_FREE)); then PART_BOOT_ERR=esp_small
    fi
    return 0
}

part_boot_error() {  # citelna zprava k PART_BOOT_ERR
    case $1 in
        bios)      T "Installing into an existing partition needs a computer started in UEFI mode." ;;
        no_esp)    T "No EFI system partition found. Installing into an existing partition shares it with the other systems; use Erase disk or Manual partitioning instead." ;;
        esp_mount) T "The EFI system partition %s could not be read." "$PART_ESP" ;;
        esp_small) T "The EFI system partition %s has less than 250 MB free." "$PART_ESP" ;;
        *)         printf '%s' "$1" ;;
    esac
}

part_probe() {  # part_probe DISK: radky pro GUI (PART_BOOT_ERR, PART_ESP, PART=sloupce PART_FIELDS oddelene TAB)
    local p
    part_boot_check "$1"
    printf 'PART_BOOT_ERR=%s\nPART_ESP=%s\n' "$PART_BOOT_ERR" "$PART_ESP"
    for p in $(part_list "$1"); do
        part_check "$p"
        PP_CONTENT="" PP_NAME=""
        # obsah jen u oddilu, ktere lze vybrat (pripojeni jen pro cteni)
        [[ -z $PC_ROOT_ERR || -z $PC_HOME_ERR ]] && part_peek "$p" "$PC_TYPE"
        printf 'PART=%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$PC_SIZE" "$PC_TYPE" "$PC_LABEL" \
            "$PC_ROOT_ERR" "$PC_HOME_ERR" "$PP_CONTENT" "$PP_NAME"
    done
}

part_layout() {  # ROOT_PART, ENCRYPT, PART_ESP, HOME_PART, HOME_FS, HOME_SUBVOL -> LAYOUT (format layout.sh)
    local on=root
    echo "use id=root dev=$ROOT_PART"
    if ((ENCRYPT)); then
        echo "luks id=croot on=root name=cryptroot"
        on=croot
    fi
    echo "fs on=$on mount=/ type=btrfs"
    if [[ -n $PART_ESP ]]; then
        echo "use id=esp dev=$PART_ESP"
        echo "fs on=esp mount=/efi type=vfat format=0"
    fi
    if [[ -n ${HOME_PART-} ]]; then
        echo "use id=home dev=$HOME_PART"
        echo "fs on=home mount=/home type=$HOME_FS format=0${HOME_SUBVOL:+ subvol=$HOME_SUBVOL}"
    fi
}

part_setup() {  # DISK_MODE=partition: kontrola vyberu, LAYOUT a kontrola layout.sh (nic nemeni)
    [[ -n ${ROOT_PART-} ]] || fail "$(T "DISK_MODE=partition needs ROOT_PART")"
    part_check "$ROOT_PART"
    [[ -z $PC_ROOT_ERR ]] || fail "$(T "%s cannot be used for LuxOS: %s" "$ROOT_PART" "$(part_reason "$PC_ROOT_ERR")")"
    PART_SIZE=$PC_SIZE PART_FSTYPE=$PC_TYPE PART_LABEL=$PC_LABEL
    part_peek "$ROOT_PART" "$PC_TYPE"
    PART_CONTENT=$PP_CONTENT PART_OSNAME=$PP_NAME
    DISK=$(ly_parent_disk "$ROOT_PART")
    HOME_PART=${HOME_PART-} HOME_FS="" HOME_SUBVOL=""
    if [[ -n $HOME_PART ]]; then
        [[ $HOME_PART != "$ROOT_PART" ]] ||
            fail "$(T "%s cannot be used as /home: %s" "$HOME_PART" "$(part_reason same)")"
        part_check "$HOME_PART"
        [[ -z $PC_HOME_ERR ]] || fail "$(T "%s cannot be used as /home: %s" "$HOME_PART" "$(part_reason "$PC_HOME_ERR")")"
        HOME_FS=$PC_TYPE
        # btrfs jineho systemu: domovske adresare v subvolumu @home
        if [[ $HOME_FS == btrfs ]]; then
            part_peek "$HOME_PART" btrfs
            HOME_SUBVOL=$PP_SUBVOL
        fi
    fi
    part_boot_check "$DISK"
    [[ -z $PART_BOOT_ERR ]] || fail "$(part_boot_error "$PART_BOOT_ERR")"
    # Sifrovani popisuje LAYOUT (luks), stejne jako v rezimu layout
    LAYOUT=$(part_layout)
    PART_ENCRYPT=$ENCRYPT
    ENCRYPT=0
    layout_parse "$LAYOUT"
    layout_validate
    ((${#LY_ERR[@]})) || layout_check_devices
    report_layout
}

part_set_type() {  # typ vybraneho oddilu -> Linux (Windows by jinak nabizel "naformatovat" neznamy datovy oddil)
    local disk n code before after
    disk=$(ly_parent_disk "$ROOT_PART")
    n=$(ly_partnum "$ROOT_PART")
    part_blkid "$ROOT_PART"
    case $PB_SCHEME in
        gpt)
            # Poskozenou GPT by sgdisk pri zapisu "opravil" - typ pak radeji nemenit
            if [[ $(sgdisk -v "$disk" 2>/dev/null) != *"No problems found"* ]]; then
                info "$(T "Could not set the partition type of %s; LuxOS works anyway." "$ROOT_PART")"
                return 0
            fi
            code=8304
            ((${PART_ENCRYPT:-0})) && code=8309
            before=$(sgdisk -p "$disk" | awk -v n="$n" '$1 ~ /^[0-9]+$/ && NF >= 6 && $1 != n')
            run sgdisk -t "$n:$code" "$disk" ||
                { info "$(T "Could not set the partition type of %s; LuxOS works anyway." "$ROOT_PART")"; return 0; }
            # Kontrola: ostatni oddily musi zustat beze zmeny
            after=$(sgdisk -p "$disk" | awk -v n="$n" '$1 ~ /^[0-9]+$/ && NF >= 6 && $1 != n')
            [[ $before == "$after" ]] || fail "$(T "Unexpected change of existing partitions on %s - stopping." "$disk")"
            run partx -u --nr "$n" "$disk" || true ;;
        dos)
            run sfdisk --part-type "$disk" "$n" 83 ||
                info "$(T "Could not set the partition type of %s; LuxOS works anyway." "$ROOT_PART")" ;;
    esac
    return 0
}

part_summary() {  # radky souhrnu: co se smaze ("  ! ...") a varovani ("  !! ...")
    local l what
    echo ""
    T "Partitions:"; echo
    while IFS= read -r l; do echo "  $l"; done < <(layout_text)
    echo ""
    T "Will be erased or changed:"; echo
    what=$(part_content_text "$PART_CONTENT" "$PART_OSNAME")
    l=$(T "ERASE partition %s: %s" "$(part_desc "$ROOT_PART" "$PART_SIZE" "$PART_FSTYPE" "$PART_LABEL")" "$what")
    echo "  ! $l"
    l=$(T "All other partitions are kept unchanged.")
    echo "  $l"
    if part_other_os "$PART_CONTENT"; then
        l=$(T "WARNING: %s contains %s. It will be deleted and will no longer start." "$ROOT_PART" "$PART_OSNAME")
        echo "  !! $l"
    elif [[ $PART_CONTENT == unknown ]]; then
        l=$(T "WARNING: the contents of %s could not be checked. Make sure it holds nothing you need." "$ROOT_PART")
        echo "  !! $l"
    fi
    return 0
}

ask_partition() {  # TUI: oddil pro LuxOS (vsechny disky) a volitelne zachovany /home
    local d p desc sel items=() homes=() unavail=() keep_none
    info "$(T "Looking for partitions…")"
    for d in $(part_disks); do
        for p in $(part_list "$d"); do
            part_check "$p"
            desc=$(part_desc "$p" "$PC_SIZE" "$PC_TYPE" "$PC_LABEL")
            if [[ -n $PC_ROOT_ERR && -n $PC_HOME_ERR ]]; then
                unavail+=("$desc  ($(part_reason "$PC_ROOT_ERR"))")
                continue
            fi
            part_peek "$p" "$PC_TYPE"
            desc+="  - $(part_content_text "$PP_CONTENT" "$PP_NAME")"
            if [[ -z $PC_ROOT_ERR ]]; then items+=("$desc"); else unavail+=("$desc  ($(part_reason "$PC_ROOT_ERR"))"); fi
            [[ -z $PC_HOME_ERR ]] && homes+=("$desc")
        done
    done
    if ((${#unavail[@]})); then
        info "$(T "Partitions that cannot be used:")"
        for d in "${unavail[@]}"; do info "  $d"; done
    fi
    ((${#items[@]})) || fail "$(T "No partition can be used for LuxOS (at least 20 GB, not in use, not a system partition).")"
    sel=$(gum choose --header "$(T "Which partition should LuxOS replace? Everything on it will be erased.")" "${items[@]}") || exit 1
    ROOT_PART=${sel%% *}
    DISK=$(ly_parent_disk "$ROOT_PART")
    part_boot_check "$DISK"
    [[ -z $PART_BOOT_ERR ]] || fail "$(part_boot_error "$PART_BOOT_ERR")"
    info "$(T "All data on %s will be erased. Other partitions are kept." "$ROOT_PART")"
    HOME_PART=""
    local -a hopts=()
    for d in "${homes[@]}"; do [[ ${d%% *} == "$ROOT_PART" ]] || hopts+=("$d"); done
    if ((${#hopts[@]})); then
        keep_none=$(T "No - keep /home on the LuxOS partition")
        sel=$(gum choose --header "$(T "Use an existing partition as /home (its files are kept)?")" "$keep_none" "${hopts[@]}") || exit 1
        [[ $sel == "$keep_none" ]] || HOME_PART=${sel%% *}
    fi
    return 0
}

# Sifrovani (volitelne) a btrfs se subvolumy na korenovem oddilu, pripojeni do $TARGET
encrypt_root() {
    ROOTDEV=$1
    if ((ENCRYPT)); then
        step "$(T "Encrypting the disk")"
        printf '%s' "$LUKS_PASS" | run cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$1"
        printf '%s' "$LUKS_PASS" | run cryptsetup open --allow-discards --perf-no_read_workqueue \
            --perf-no_write_workqueue --persistent --key-file - "$1" cryptroot
        LUKS_UUID=$(blkid -s UUID -o value "$1")
        ROOTDEV=/dev/mapper/cryptroot
    fi
}

mount_root() {
    run mkfs.btrfs -f -L LuxOS "$ROOTDEV"
    local mntopts=noatime,compress=zstd:1 sv
    run mount "$ROOTDEV" "$TARGET"
    for sv in @ @home @log @cache; do run btrfs subvolume create "$TARGET/$sv"; done
    run umount "$TARGET"
    run mount -o "$mntopts,subvol=@" "$ROOTDEV" "$TARGET"
    mkdir -p "$TARGET"/{boot,home,var/log,var/cache}
    run mount -o "$mntopts,subvol=@home"  "$ROOTDEV" "$TARGET/home"
    run mount -o "$mntopts,subvol=@log"   "$ROOTDEV" "$TARGET/var/log"
    run mount -o "$mntopts,subvol=@cache" "$ROOTDEV" "$TARGET/var/cache"
}

prepare_disk() {
    step "$(T "Preparing disk %s" "$DISK")"
    swapoff -a 2>/dev/null || true
    umount -R "$TARGET" 2>/dev/null || true
    [[ -e /dev/mapper/cryptroot ]] && cryptsetup close cryptroot 2>/dev/null || true

    run wipefs -af "$DISK"
    run sgdisk --zap-all "$DISK"
    if [[ $BOOTMODE == uefi ]]; then
        run sgdisk -n1:0:+1G -t1:ef00 -c1:EFI -n2:0:0 -t2:8304 -c2:LuxOS "$DISK"
    else
        run sgdisk -n1:0:+1M -t1:ef02 -c1:BIOS -n2:0:+1G -t2:8300 -c2:boot -n3:0:0 -t3:8304 -c3:LuxOS "$DISK"
    fi
    run partprobe "$DISK" || true
    run udevadm settle

    local rootpart
    if [[ $BOOTMODE == uefi ]]; then
        BOOTPART=$(part_path "$DISK" 1); rootpart=$(part_path "$DISK" 2)
    else
        BOOTPART=$(part_path "$DISK" 2); rootpart=$(part_path "$DISK" 3)
    fi
    [[ -b $BOOTPART && -b $rootpart ]] || fail "$(T "Partitions were not created correctly")"

    # Volitelne smazani: jen nove oddily LuxOS, po rozdeleni a pred LUKS/mkfs
    if wipe_enabled; then
        step "$(T "Erasing the space for LuxOS")"
        wipe_devices "$BOOTPART" "$rootpart"
    fi
    encrypt_root "$rootpart"

    step "$(T "Creating file systems")"
    if [[ $BOOTMODE == uefi ]]; then run mkfs.fat -F32 -n EFI "$BOOTPART"
    else run mkfs.ext4 -F -L boot "$BOOTPART"; fi
    mount_root
    if [[ $BOOTMODE == uefi ]]; then run mount -o fmask=0077,dmask=0077 "$BOOTPART" "$TARGET/boot"
    else run mount "$BOOTPART" "$TARGET/boot"; fi
}

# Novy oddil jen v nejvetsi volne oblasti; existujici oddily ani ESP se neformatuji
prepare_freespace() {
    step "$(T "Preparing disk %s" "$DISK")"
    umount -R "$TARGET" 2>/dev/null || true
    [[ -e /dev/mapper/cryptroot ]] && cryptsetup close cryptroot 2>/dev/null || true

    check_freespace "$DISK"
    [[ -z $FS_ERR ]] || fail "$(freespace_error "$FS_ERR")"
    local num before after rootpart i
    num=$(free_partnum "$DISK") || fail "$(T "The partition table on %s is full." "$DISK")"
    before=$(sgdisk -p "$DISK" | awk '$1 ~ /^[0-9]+$/ && NF >= 6')
    info "$(T "New partition %s: %s GB of free space" "$num" "$((FS_BYTES / 1000000000))")"
    run sgdisk -n"$num:$FS_START:$FS_END" -t"$num:8304" -c"$num:LuxOS" "$DISK"
    # Kontrola: ostatni oddily musi zustat beze zmeny
    after=$(sgdisk -p "$DISK" | awk -v n="$num" '$1 ~ /^[0-9]+$/ && NF >= 6 && $1 != n')
    [[ $before == "$after" ]] || fail "$(T "Unexpected change of existing partitions on %s - stopping." "$DISK")"

    # Ostatni oddily mohou byt pouzivane - kernelu ohlasit jen novy oddil
    run partprobe "$DISK" || true
    run udevadm settle || true
    for i in 1 2 3 4 5; do
        rootpart=$(part_path "$DISK" "$num")
        [[ -b $rootpart ]] && break
        run partx -a --nr "$num" "$DISK" || true
        run udevadm settle || true
        sleep 1
    done
    [[ -b $rootpart ]] || fail "$(T "Partitions were not created correctly")"
    BOOTPART=$ESP_PART

    # Volitelne smazani: jen novy oddil (sdileny ESP a ostatni oddily ne)
    if wipe_enabled; then
        step "$(T "Erasing the space for LuxOS")"
        wipe_devices "$rootpart"
    fi
    encrypt_root "$rootpart"

    step "$(T "Creating file systems")"
    mount_root
    # Sdileny ESP jako /efi; jadro LuxOS zustava v /boot na btrfs a kopiruje se na ESP
    if [[ $BOOTLOADER != none ]]; then
        mkdir -p "$TARGET/efi"
        run mount -o fmask=0077,dmask=0077 "$ESP_PART" "$TARGET/efi"
    fi
}

# --- Sit: rychle mirrory, prubeh stahovani, srozumitelne chyby --------------
MIRRORLIST=/etc/lux/mirrorlist   # format lux: jedna adresa na radek

tz_country() {  # tz_country Europe/Prague -> CZ
    awk -v tz="$1" '$1 !~ /^#/ && $3 == tz {print $1; exit}' /usr/share/zoneinfo/zone.tab 2>/dev/null || true
}

# Nejrychlejsi mirrory v zemi podle casoveho pasma (reflector, kratke timeouty); puvodni seznam
# zustava za nimi jako zaloha. Live system ho pouzije pro pacstrap, configure_system ho kopiruje do cile.
# reflector pise radky "Server = ..."; lux-config mirrors-import je prevede do formatu lux.
mirror_urls() { grep -oE '^[[:space:]]*(Server[[:space:]]*=[[:space:]]*)?(https?|ftp|file)://[^[:space:]#]+' "$1" | sed -E 's/^[[:space:]]*(Server[[:space:]]*=[[:space:]]*)?//'; }
rank_mirrors() {
    local orig=$MIRRORLIST.luxos-orig cc tmp n
    [[ -e $orig ]] || cp "$MIRRORLIST" "$orig" 2>/dev/null || return 0
    command -v reflector >/dev/null || { echo "rank_mirrors: reflector is not installed" >>"$LOG"; return 0; }
    cc=$(tz_country "${TIMEZONE:-}")
    [[ -n $cc ]] || { echo "rank_mirrors: no country for time zone ${TIMEZONE:-}" >>"$LOG"; return 0; }
    progress "STATUS $(T "Looking for the fastest download servers…")"
    info "$(T "Looking for the fastest download servers…")"
    tmp=$(mktemp)
    printf '+ reflector --country %s\n' "$cc" >>"$LOG"
    if timeout 45 reflector --country "$cc" --protocol https --latest 12 --sort rate --number 8 \
            --connection-timeout 3 --download-timeout 5 --threads 4 --save "$tmp" >>"$LOG" 2>&1; then
        n=$(mirror_urls "$tmp" | wc -l)
    else
        n=0
    fi
    if ((n >= 2)) && {
            echo "# fastest mirrors for $cc (reflector), then the default list as a fallback"
            mirror_urls "$tmp"
            mirror_urls "$orig" | grep -vxF -f <(mirror_urls "$tmp") || true
        } >"$tmp.all" && "$LUX_CONFIG_TOOL" mirrors-import "$tmp.all" --output "$MIRRORLIST" >>"$LOG" 2>&1; then
        info "$(T "Using %s fast download servers near you." "$n")"
    else
        cp -f "$orig" "$MIRRORLIST"
        info "$(T "Using the default download servers.")"
    fi
    progress "STATUS "
    rm -f "$tmp" "$tmp.all"
}

pac_friendly() {  # surovy radek jadra -> srozumitelna veta (prazdny vystup = radek beze zmeny)
    local l=$1 host why
    if [[ $l =~ ^error:\ failed\ retrieving\ file\ \'[^\']*\'\ from\ ([^\ ]+)\ :\ (.*)$ ]]; then
        host=${BASH_REMATCH[1]} why=${BASH_REMATCH[2]}
        case ${why,,} in
            *"too slow"*) T "The server %s is slow, trying another one…" "$host" ;;
            *"timed out"*|*"connect"*|*"resolve"*|*"reset"*|*"refused"*|*"unreachable"*|*"ssl"*)
                T "The server %s is not responding, trying another one…" "$host" ;;
            *) T "Downloading from %s failed, trying another one…" "$host" ;;
        esac
    elif [[ $l =~ ^warning:\ too\ many\ errors\ from\ ([^\ ,]+) ]]; then
        T "The server %s has too many problems, skipping it." "${BASH_REMATCH[1]}"
    elif [[ $l == "error: failed to retrieve some files" || $l == "warning: failed to retrieve some files" ]]; then
        T "Some files could not be downloaded."
    elif [[ $l == "error: failed to commit transaction (failed to retrieve some files)" ]]; then
        T "Downloading the packages did not finish."
    elif [[ $l == "error: failed to synchronize all databases"* ]]; then
        T "The package lists could not be downloaded."
    fi
    return 0
}

human_bytes() { numfmt --to=si --suffix=B --format=%.1f "$1" 2>/dev/null || echo "$1 B"; }

# Prubeh stahovani: velikost cache v cili - pacstrap stahuje do $TARGET/var/cache/pacman/pkg (cesta
# z arch-install-scripts; po hooku lux-engine-migrate odkaz na var/cache/lux/pkg), jadro v cili do
# /var/cache/lux/pkg (PAC_CACHE). "/." za cestou: du projde i odkaz. Kazde ~2 s -> "@@NET B/s stazeno celkem"; v TUI kazdych 15 s radek s rychlosti
net_sample() {
    ((net == 1)) || return 0
    local now cur d r
    now=${EPOCHREALTIME//[.,]/}
    ((now - net_t >= 1900000)) || return 0
    cur=$(du -sb "$cache/." 2>/dev/null | cut -f1 || true)
    d=$((${cur:-0} - base))
    ((d > dl_total)) && d=$dl_total
    r=0
    ((d > got)) && r=$(((d - got) * 1000000 / (now - net_t)))
    ((d > got)) && got=$d
    rate=$(((rate * 6 + r * 4) / 10))
    net_t=$now
    progress "NET $rate $got $dl_total"
    pac_pct
    if ((!PROGRESS && now - tui_t >= 15000000)); then
        tui_t=$now
        local left=""
        ((rate > 0)) && left=" · $(T "about %s min left" "$(((dl_total - got) / rate / 60 + 1))")"
        info "$(T "Downloaded %s of %s" "$(human_bytes "$got")" "$(human_bytes "$dl_total")") · $(human_bytes "$rate")/s$left"
        ((rate < 150000)) && info "$(T "Your internet connection is very slow - the installation will take longer. It has not stopped.")"
    fi
    return 0
}

pac_pct() {  # @@PCT: stahovani 0-40 % (podle bajtu, jinak podle poctu), instalace 40-100 %
    ((total)) || return 0
    local dlp
    if ((net == 2)); then dlp=40
    elif ((net == 1 && dl_total > 0)); then dlp=$((got * 40 / dl_total))
    else dlp=$((dl * 40 / total)); fi
    pct=$((dlp + inst * 60 / total))
    ((pct > 100)) && pct=100
    if ((pct > last)); then progress "PCT $pct"; last=$pct; fi
    return 0
}

net_end() {
    ((net == 1)) || return 0
    net=2
    progress "NET $rate $dl_total $dl_total"
    progress "NET END"
}

# Vystup pacstrapu a jadra: surove do logu, na stdout (GUI Podrobnosti / terminal) srozumitelne vety misto chyb site
pac_filter() {
    local line part="" rc eof=0 friendly last_friendly=""
    local total=0 dl=0 inst=0 pct last=-1
    local net=0 dl_total=0 base=0 got=0 rate=0 net_t=0 tui_t=0 cache=${PAC_CACHE:-$TARGET/var/cache/lux/pkg}
    while ((!eof)); do
        if IFS= read -r -t 2 line; then
            line=$part$line part=""
        else
            rc=$?
            if ((rc > 128)); then   # nic neprislo - jen zmerit stahovani
                part+=$line
                net_sample
                continue
            fi
            eof=1
            line=$part$line part=""
            [[ -n $line ]] || break
        fi
        printf '%s\n' "$line" >>"$LOG"
        friendly=$(pac_friendly "$line")
        if [[ -n $friendly ]]; then
            if [[ $friendly != "$last_friendly" ]]; then
                printf '%s\n' "$friendly"
                progress "STATUS $friendly"
                last_friendly=$friendly
            fi
        else
            printf '%s\n' "$line"
        fi
        if [[ $line =~ ^Packages?\ \(([0-9]+)\) ]]; then
            total=${BASH_REMATCH[1]} dl=0 inst=0
        elif [[ $line =~ ^Total\ Download\ Size:\ +([0-9.]+)\ +([KMG]?i?B) ]]; then
            dl_total=$(awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[2]}" 'BEGIN {
                m = u == "KiB" ? 1024 : u == "MiB" ? 1048576 : u == "GiB" ? 1073741824 : 1; printf "%.0f", n * m }')
            base=$(du -sb "$cache/." 2>/dev/null | cut -f1 || true)
            base=${base:-0} got=0 rate=0 net=1
            net_t=${EPOCHREALTIME//[.,]/} tui_t=$net_t
            ((dl_total > 0)) && progress "NET 0 0 $dl_total" || net=0
        elif ((total)) && [[ $line == *' downloading...' ]]; then
            dl=$((dl + 1))
        elif [[ $line =~ ^(\([\ 0-9/]+\)\ )?(checking\ keyring|checking\ keys|checking\ package\ integrity|loading\ package\ files|checking\ for\ file\ conflicts|installing\ |upgrading\ |reinstalling\ |::\ Processing\ package\ changes) ]]; then
            net_end
            [[ $line =~ ^(installing|upgrading|reinstalling)\  ]] && ((total)) && inst=$((inst + 1))
        fi
        net_sample
        pac_pct
    done
    ((net == 1)) && progress "NET END"
    return 0
}

# Po nepovedenem pokusu: zamek databaze, nedokoncena stahovani a gpg-agent z predchoziho behu
# (stare cesty z pacstrapu i nove z jadra v cili; po migraci jsou stare odkazy - "/." projde odkaz)
pac_cleanup() {
    local d
    for d in "$TARGET/etc/pacman.d/gnupg" "$TARGET/etc/lux/keyring"; do
        [[ -d $d ]] && { gpgconf --homedir "$d" --kill all >/dev/null 2>&1 || true; }
    done
    rm -f "$TARGET/var/lib/pacman/db.lck" "$TARGET/var/lib/lux/db.lck"
    for d in "$TARGET/var/cache/pacman/pkg" "$TARGET/var/cache/lux/pkg" "$TARGET/var/lib/pacman/sync" "$TARGET/var/lib/lux/sync"; do
        [[ -d $d ]] || continue
        find "$d/." -maxdepth 1 -name '*.part' -delete 2>/dev/null || true
        find "$d/." -mindepth 1 -maxdepth 1 -type d -name 'download-*' -exec rm -rf {} + 2>/dev/null || true
    done
    return 0
}

# pacstrap vola pacman, pacman-key a pacman-conf jmenem: docasny adresar s odkazy na nastroje jadra
# (spousteci skript jadra pozna nastroj podle cile odkazu). V systemu zadny soubor pacman neni.
ENGINE_SHIM=
engine_shim() {
    [[ -n $ENGINE_SHIM && -d $ENGINE_SHIM ]] && return 0
    ENGINE_SHIM=$(mktemp -d /run/luxos-install-engine.XXXXXX)
    local n
    for n in "" -key -conf; do ln -s "/usr/lib/lux/alpm/bin/lux-engine$n" "$ENGINE_SHIM/pacman$n"; done
}

wait_internet() {  # pri vypadku pripojeni pockat (max. ~10 min), pak to zkusit tak jako tak
    local i
    for ((i = 0; i < 60; i++)); do
        have_internet && return 0
        if ((i == 0)); then
            progress "STATUS $(T "Waiting for the internet connection…")"
            info "$(T "Waiting for the internet connection…")"
        fi
        sleep 10
    done
    return 0
}

install_packages() {
    step "$(T "Detecting hardware")"
    local -a pkgs hw
    mapfile -t pkgs < <(grep -vE '^\s*(#|$)' "$SHARE/packages")
    if [[ $BOOTLOADER != none ]]; then
        if [[ $BOOTMODE == uefi ]]; then pkgs+=(efibootmgr); else pkgs+=(grub); fi
    fi
    uses_layout && mapfile -t -O "${#pkgs[@]}" pkgs < <(layout_packages)
    # OEM: Pruvodce nastavenim a luxos-oem (balik instalatoru)
    ((${OEM:-0})) && pkgs+=(luxos-installer)
    # Firemni sit: SSSD, Kerberos, realmd/adcli (pripojeni v domain_join)
    [[ -n ${DOMAIN-} && " ${pkgs[*]} " != *" luxos-domain "* ]] && pkgs+=(luxos-domain)
    mapfile -t hw < <(luxos-hwdetect --packages --kernel linux-luxos)
    luxos-hwdetect --report | sed 's/^/  /'
    # Legacy ovladace NVIDIA (nvidia-580xx-*, nvidia-470xx-*: [luxos], ~0,5 GB) v ISO nejsou;
    # nainstaluji se po zakladnim systemu z online [luxos] (install_online_drivers).
    # nvidia-prime s nimi: jinak by si pacstrap pritahl nvidia-utils z [extra] a ten s nimi koliduje.
    HW_ONLINE=()
    local p
    for p in "${hw[@]}"; do [[ $p == *nvidia-[0-9]*xx* ]] && HW_ONLINE+=("$p"); done
    for p in "${hw[@]}"; do
        if [[ $p == *nvidia-[0-9]*xx* ]] || { ((${#HW_ONLINE[@]})) && [[ $p == nvidia-prime ]]; }; then
            [[ $p == nvidia-prime ]] && HW_ONLINE+=("$p")
            continue
        fi
        pkgs+=("$p")
    done
    # NVIDIA do initramfs jen bez integrovane grafiky (u hybridni jen zpomaluje start)
    NVIDIA_EARLY=0
    if [[ " ${hw[*]} " =~ \ nvidia-(open|[0-9]+xx)-dkms\  && " ${hw[*]} " != *" nvidia-prime "* ]]; then NVIDIA_EARLY=1; fi

    step "$(T "Installing packages (this is the longest step)")"
    rank_mirrors
    local attempt retry_conf=/run/luxos-install-retry.conf engine_conf
    # konfigurace jadra live systemu (z /etc/lux/lux.conf; repozitare LuxOS z ISO)
    engine_conf=$("$LUX_CONFIG_TOOL" ensure --quiet) || fail "$(T "The package manager configuration of the live system is broken.")"
    local -a conf=(-C "$engine_conf")
    engine_shim
    local log_from missing
    for attempt in 1 2 3 4 5; do
        log_from=$(($(wc -l <"$LOG" 2>/dev/null || echo 0) + 1))
        # anglicky vystup jadra kvuli rozpoznani prubehu a chyb; -M: seznam zrcadel kopiruje configure_system
        if LC_ALL=C.UTF-8 PATH="$ENGINE_SHIM:$PATH" \
                pacstrap "${conf[@]}" -K -M "$TARGET" --needed "${pkgs[@]}" 2>&1 | PAC_CACHE="$TARGET/var/cache/pacman/pkg" pac_filter; then
            progress "STATUS "
            install_online_drivers
            return 0
        fi
        # Chybejici balik v repozitari neni vypadek site: opakovani nepomuze a hlaska o internetu by lhala
        missing=$(tail -n +"$log_from" "$LOG" 2>/dev/null | sed -n 's/^error: target not found: //p' | sort -u | paste -sd ' ')
        if [[ -n $missing ]]; then
            fail "$(T "The installation medium is missing packages: %s. Download the current LuxOS ISO." "$missing")"
            return 1
        fi
        ((attempt < 5)) || break
        progress "STATUS $(T "Download failed (attempt %s), retrying…" "$attempt")"
        info "$(T "Download failed (attempt %s), retrying…" "$attempt")"
        pac_cleanup
        sleep $((attempt * 5))
        wait_internet
        # Dalsi pokus s mene soubeznymi stahovanimi: pomale linky pak nespadnou pod limit jadra
        sed -E 's/^#?[[:space:]]*ParallelDownloads.*/ParallelDownloads = 3/' "$engine_conf" >"$retry_conf"
        conf=(-C "$retry_conf")
    done
    fail "$(T "Packages could not be installed. Check the internet connection.")"
}

# Legacy ovladace NVIDIA z online [luxos] (v ISO nejsou). Chyba instalaci nezastavi:
# zustane ovladac nouveau z jadra a po prvnim prihlaseni se ovladac nabidne v aplikaci Ovladace.
# /etc/lux/lux.conf (shodna s lux-engine, tedy bez .luxnew) a serazena zrcadla live systemu
install_engine_config() {
    install -Dm644 "$SHARE/lux.conf" "$TARGET/etc/lux/lux.conf"
    install -Dm644 "$MIRRORLIST" "$TARGET/etc/lux/mirrorlist"
}

install_online_drivers() {
    ((${#HW_ONLINE[@]})) || return 0
    progress "STATUS $(T "Downloading the NVIDIA driver…")"
    info "$(T "Downloading the NVIDIA driver…")"
    # Repozitare LuxOS ze serveru (configure_system pak lux.conf zapise znovu, stejny obsah)
    install_engine_config
    local attempt
    for attempt in 1 2 3 4 5; do
        # -Syy: vzdy znovu stahnout online databaze [luxos] (pacstrap pouzil mistni z ISO; ta muze byt
        # novejsi nez server a If-Modified-Since by nechal starou databazi s novym podpisem)
        if chroot_engine -Syy --needed --noconfirm "${HW_ONLINE[@]}" 2>&1 | pac_filter; then
            progress "STATUS "
            return 0
        fi
        ((attempt < 5)) || break
        pac_cleanup
        sleep $((attempt * 5))
        wait_internet
    done
    progress "STATUS "
    NVIDIA_EARLY=0
    info "$(T "The NVIDIA driver could not be installed. The open-source driver is used for now; install it later in Drivers.")"
}

configure_system() {
    step "$(T "Configuring the system")"
    # zram swap live systemu nepatri do fstab (instalovany system ma vlastni zram-generator)
    swapoff /dev/zram* 2>/dev/null || true
    # EFI oddil (vfat) vzdy s kontrolou pri startu (pass 2): po tvrdem vypnuti zustane priznak
    # "dirty" a systemd-fsck ho tise opravi (fsck.fat -a); genfstab da 0, kdyz live nema fsck.vfat
    genfstab -U "$TARGET" | sed 's/,subvolid=[0-9]*//' | grep -v zram |
        awk '$1 !~ /^#/ && $3 == "vfat" && $NF == "0" { sub(/0[[:space:]]*$/, "2") } { print }' >"$TARGET/root/fstab.new"
    # Vedle jinych systemu: aktivni swap patri jim (LuxOS ma zram)
    [[ $DISK_MODE == @(freespace|layout|partition) ]] && sed -i '/[[:space:]]swap[[:space:]]/d' "$TARGET/root/fstab.new"
    # Rucni rozdeleni: swap z LAYOUT (pri instalaci se nezapina, genfstab ho nevidi)
    uses_layout && layout_fstab_swap >>"$TARGET/root/fstab.new"
    cat "$TARGET/root/fstab.new" >>"$TARGET/etc/fstab"
    rm -f "$TARGET/root/fstab.new"
    # crypttab (+ crypttab.initramfs a klice pro dalsi svazky) pred mkinitcpio v setup-chroot
    local enc_hook=$ENCRYPT lvm_hook=0
    if uses_layout; then
        layout_write_crypt
        local hooks
        hooks=$(layout_hooks)
        enc_hook=${hooks#ENCRYPT_HOOK=}; enc_hook=${enc_hook%% *}
        lvm_hook=${hooks##*LVM_HOOK=}
    fi

    # lux: repozitare LuxOS ze serveru (podepsane), Arch ze stejnych mirroru jako live system
    install_engine_config

    # OEM: vsechny jazyky LuxOS predem (majitel si jazyk vybere v Pruvodci nastavenim)
    local oem_locales=""
    ((${OEM:-0})) && oem_locales=$(printf '%s ' "${LANGS[@]##*|}")
    local console_km
    console_km=$(x11_to_console "$XKB_LAYOUT" "$XKB_VARIANT")
    local -a hw_svcs
    mapfile -t hw_svcs < <(luxos-hwdetect --services)

    local cmdline="rw quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=auto vt.global_cursor_default=0 nowatchdog zswap.enabled=0"
    local root_uuid
    root_uuid=$(blkid -s UUID -o value "$ROOTDEV")
    local rootspec="root=UUID=$root_uuid rootflags=subvol=@"
    ((ENCRYPT)) && rootspec="rd.luks.name=$LUKS_UUID=cryptroot rd.luks.options=discard root=/dev/mapper/cryptroot rootflags=subvol=@"
    [[ $DISK_MODE == manual ]] && rootspec="root=UUID=$root_uuid$(findmnt -no OPTIONS "$TARGET" | grep -o 'subvol=[^,]*' | sed 's/^/ rootflags=/' | head -1)"
    uses_layout && rootspec=$(layout_cmdline)
    # EFI oddil: /boot (jadro primo na ESP) nebo /efi (sdileny, jadro se kopiruje do EFI/LuxOS/<id>)
    local esp_mount=/boot esp_keep=0 chroot_disk=$DISK
    [[ $DISK_MODE == freespace ]] && esp_mount=/efi esp_keep=1
    if uses_layout; then
        esp_mount=${ESP_MOUNT:-/boot} esp_keep=${ESP_KEEP:-0}
        chroot_disk=${GRUB_DISK:-$DISK}
    fi

    install -Dm600 /dev/stdin "$TARGET/root/luxos-setup.env" <<ENV
LOCALE=$(printf %q "$LOCALE")
XKB_LAYOUT=$(printf %q "$XKB_LAYOUT")
XKB_VARIANT=$(printf %q "$XKB_VARIANT")
XKB_OPTIONS=$(printf %q "${XKB_OPTIONS-}")
CONSOLE_KEYMAP=$(printf %q "$console_km")
TIMEZONE=$(printf %q "$TIMEZONE")
HOSTNAME_SEL=$(printf %q "$HOSTNAME_SEL")
USERNAME=$(printf %q "$USERNAME")
FULLNAME=$(printf %q "$FULLNAME")
AUTOLOGIN=$AUTOLOGIN
ENCRYPT=$ENCRYPT
ENCRYPT_HOOK=$enc_hook
LVM_HOOK=$lvm_hook
ESP_MOUNT=$esp_mount
ESP_KEEP=$esp_keep
BOOTMODE=$BOOTMODE
BOOTLOADER=$(printf %q "$BOOTLOADER")
DISK_MODE=$(printf %q "$DISK_MODE")
ESP_ID=$(printf %q "${root_uuid:0:8}")
NVIDIA_EARLY=${NVIDIA_EARLY:-0}
DISK=$(printf %q "$chroot_disk")
CMDLINE=$(printf %q "$rootspec $cmdline")
HW_SERVICES=$(printf %q "${hw_svcs[*]}")
OEM=${OEM:-0}
OEM_LOCALES=$(printf %q "$oem_locales")
ENV
    # Rezim udrzby pro luxos-care; ochrana systemu (/usr jen pro cteni) od prvniho startu
    printf "MODE=%s\nKERNEL=linux-luxos\nPROTECT=%s\n" "$CARE_MODE" "$( ((${PROTECT:-1})) && echo yes || echo no)" |
        install -Dm644 /dev/stdin "$TARGET/etc/luxos/care.conf"
    install -m700 "$SHARE/setup-chroot.sh" "$TARGET/root/luxos-setup.sh"
    ((${OEM:-0})) && oem_prepare_target
    arch-chroot "$TARGET" /root/luxos-setup.sh 2>&1 | tee -a "$LOG"
    # OEM zapeceteny hned: zadny ucet (zalozi ho majitel v Pruvodci nastavenim)
    [[ -n ${USERNAME-} ]] && printf '%s:%s\n' "$USERNAME" "$PASSWORD" | arch-chroot "$TARGET" chpasswd
    # Ucet LuxAI do ~/.config/luxai/account.json noveho uzivatele (0700/0600)
    if [[ -n $LUXAI_ACCOUNT && -n ${USERNAME-} ]]; then
        local home="$TARGET/home/$USERNAME"
        install -d -m700 "$home/.config" "$home/.config/luxai"
        (umask 077; printf '%s\n' "$LUXAI_ACCOUNT" >"$home/.config/luxai/account.json")
        arch-chroot "$TARGET" chown -R "$USERNAME:" "/home/$USERNAME/.config"
    fi
    rm -f "$TARGET/root/luxos-setup.sh" "$TARGET/root/luxos-setup.env"
    domain_join
    ((${OEM:-0})) && oem_finish_target

    # bootctl v chrootu nezapisuje EFI promenne - polozku "LuxOS" vytvorit z live systemu
    if [[ $BOOTLOADER != none && $BOOTMODE == uefi ]] && command -v efibootmgr >/dev/null; then
        if [[ $DISK_MODE == erase ]]; then
            efibootmgr -q -B -L LuxOS >/dev/null 2>&1 || true
            run efibootmgr --create --disk "$DISK" --part 1 --label LuxOS \
                --loader '\EFI\systemd\systemd-bootx64.efi' --unicode || info "$(T "Could not add UEFI boot entry (fallback loader will be used)")"
            uefi_luxos_first "${ESP_PART-}"
        elif [[ $DISK_MODE == freespace ]]; then
            shared_esp_entry
        elif uses_layout && [[ -n ${ESP_PART-} ]]; then
            if ((ESP_KEEP)); then
                DISK=$(ly_parent_disk "$ESP_PART") shared_esp_entry
            else
                efibootmgr -q -B -L LuxOS >/dev/null 2>&1 || true
                run efibootmgr --create --disk "$(ly_parent_disk "$ESP_PART")" --part "$(ly_partnum "$ESP_PART")" \
                    --label LuxOS --loader '\EFI\systemd\systemd-bootx64.efi' --unicode ||
                    info "$(T "Could not add UEFI boot entry (fallback loader will be used)")"
                uefi_luxos_first "$ESP_PART"
            fi
        fi
    fi
}

# --- Sablony softwaru (TEMPLATES) -------------------------------------------
# Kazda sablona je soubor $SHARE/templates/<id>.list (popis @klic hodnota + baliky, viz everyday.list).
# Instaluji se az po zakladnim systemu; chyba sablony instalaci nikdy nezastavi (jen varovani).
TEMPLATE_DIR=$SHARE/templates
TEMPLATE_IDS=()

tpl_field() {  # tpl_field ID KLIC -> hodnota "@KLIC hodnota" (prvni vyskyt)
    sed -nE "s/^@$2[[:space:]]+//p" "$TEMPLATE_DIR/$1.list" 2>/dev/null | head -1 | sed 's/[[:space:]]*$//'
}

tpl_all() {  # vsechny dostupne sablony podle @order
    local f
    for f in "$TEMPLATE_DIR"/*.list; do
        [[ -r $f ]] || continue
        f=${f##*/}
        printf '%s %s\n' "$(tpl_field "${f%.list}" order)" "${f%.list}"
    done | sort -n | cut -d' ' -f2
}

parse_templates() {  # TEMPLATES="a,b c" -> TEMPLATE_IDS (nezname se preskoci s varovanim)
    local -a list=()
    local t
    TEMPLATE_IDS=()
    IFS=', ' read -ra list <<<"${TEMPLATES-}"
    for t in "${list[@]}"; do
        [[ -z $t || $t == none ]] && continue
        if [[ $t =~ ^[a-z0-9_-]+$ && -r $TEMPLATE_DIR/$t.list ]]; then
            [[ " ${TEMPLATE_IDS[*]} " == *" $t "* ]] || TEMPLATE_IDS+=("$t")
        else
            info "$(T "Unknown software template %s - skipped." "$t")"
        fi
    done
    TEMPLATES=$(IFS=,; echo "${TEMPLATE_IDS[*]}")
}

templates_text() {  # citelny seznam zvolenych sablon
    ((${#TEMPLATE_IDS[@]})) || { T "Only the essentials"; return 0; }
    local id out=()
    for id in "${TEMPLATE_IDS[@]}"; do out+=("$(T "$(tpl_field "$id" name)")"); done
    local IFS=,
    printf '%s' "${out[*]}" | sed 's/,/, /g'
}

lang_candidates() {  # lang_candidates ODDELOVAC -> jazykove pripony baliku (cs_CZ -> "cs-cz", "cs")
    local l=${LOCALE%%.*} ll cc
    l=${l%%@*}
    ll=${l%%_*} cc=${l#*_}
    [[ $l == *_* ]] && printf '%s\n' "${ll,,}$1${cc,,}"
    printf '%s\n' "${ll,,}"
}

tpl_resolve() {  # tpl_resolve ID -> baliky sablony (podminky a jazyk vyhodnoceny; $avail, $installed)
    local line name cond neg any p c
    while read -r line; do
        line=${line%%#*}
        [[ -z ${line// /} || $line == @* ]] && continue
        read -r name cond _ <<<"$line"
        if [[ -n $cond ]]; then
            neg=0; [[ $cond == '?!'* ]] && neg=1
            cond=${cond#\?}; cond=${cond#!}
            any=0
            for p in ${cond//,/ }; do
                grep -qxF -- "$p" <<<"$installed" && any=1
            done
            ((any != neg)) || continue
        fi
        if [[ $name == *%lang%* || $name == *%lang_%* ]]; then
            # jazykovy balicek: prvni existujici varianta, jinak tise vynechat
            local sep=-
            [[ $name == *%lang_%* ]] && sep=_
            for c in $(lang_candidates "$sep"); do
                p=${name//%lang_%/$c}; p=${p//%lang%/$c}
                if grep -qxF -- "$p" <<<"$avail"; then printf '%s\n' "$p"; break; fi
            done
            continue
        fi
        if grep -qxF -- "$name" <<<"$avail"; then
            printf '%s\n' "$name"
        else
            info "$(T "Package %s is not available - skipped." "$name")" >&2
            printf '%s\n' "$name" >>"$TPL_MISSING"
        fi
    done <"$TEMPLATE_DIR/$1.list"
}

chroot_engine() {  # jadro lux v cili (lux-engine), anglicky vystup kvuli pac_filter
    LC_ALL=C.UTF-8 arch-chroot "$TARGET" /usr/lib/lux/alpm/bin/lux-engine "$@"
}

install_templates() {
    ((${#TEMPLATE_IDS[@]})) || return 0
    step "$(T "Installing additional software")"
    info "$(templates_text)"
    local id attempt ok=0 avail installed g
    local -a pkgs=() failed=() groups=()
    TPL_MISSING=$(mktemp)

    # Steam apod.: repozitar multilib (zustane zapnuty kvuli aktualizacim)
    for id in "${TEMPLATE_IDS[@]}"; do
        if [[ $(tpl_field "$id" repo) == multilib ]] && ! arch-chroot "$TARGET" "$LUX_CONFIG_TOOL" has-repo multilib >/dev/null 2>&1; then
            # v chrootu: cesta /etc/lux/mirrorlist v lux.conf je cesta cile
            if arch-chroot "$TARGET" "$LUX_CONFIG_TOOL" enable-repo multilib >>"$LOG" 2>&1; then
                info "$(T "Enabled the multilib repository.")"
            fi
        fi
    done

    for attempt in 1 2 3 4 5; do
        if chroot_engine -Syy --noconfirm >>"$LOG" 2>&1; then ok=1; break; fi
        pac_cleanup
        sleep $((attempt * 5))
        wait_internet
    done
    if ((!ok)); then
        progress "STATUS $(T "Additional software was skipped. You can install it later in the LuxOS Store.")"
        info "$(T "The package lists could not be downloaded.") $(T "Additional software was skipped. You can install it later in the LuxOS Store.")"
        rm -f "$TPL_MISSING"
        return 0
    fi
    avail=$(chroot_engine -Slq 2>>"$LOG" | sort -u) || avail=""
    installed=$(chroot_engine -Qq 2>>"$LOG") || installed=""

    for id in "${TEMPLATE_IDS[@]}"; do
        mapfile -t -O "${#pkgs[@]}" pkgs < <(tpl_resolve "$id")
        for g in $(tpl_field "$id" groups); do groups+=("$g"); done
    done
    mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | awk 'NF && !seen[$0]++')
    mapfile -t failed <"$TPL_MISSING"
    rm -f "$TPL_MISSING"

    if ((${#pkgs[@]})); then
        ok=0
        for attempt in 1 2 3 4 5; do
            # -Su: databaze jsou cerstve (-Sy), bez castecne aktualizace
            if chroot_engine -Su --needed --noconfirm "${pkgs[@]}" 2>&1 | pac_filter; then ok=1; break; fi
            ((attempt < 5)) || break
            progress "STATUS $(T "Download failed (attempt %s), retrying…" "$attempt")"
            info "$(T "Download failed (attempt %s), retrying…" "$attempt")"
            pac_cleanup
            sleep $((attempt * 5))
            wait_internet
        done
        if ((!ok)); then
            # Spolecna transakce selhala (napr. konflikt): po jednom, chybny balik jen preskocit
            progress "STATUS $(T "Installing the apps one by one…")"
            info "$(T "Installing the apps one by one…")"
            local i=0 p
            for p in "${pkgs[@]}"; do
                i=$((i + 1))
                progress "PCT $((i * 100 / ${#pkgs[@]}))"
                pac_cleanup
                chroot_engine -S --needed --noconfirm "$p" >>"$LOG" 2>&1 || failed+=("$p")
            done
        fi
    fi
    progress "STATUS "

    # Skupiny (napr. wireshark: zachytavani bez roota)
    for g in "${groups[@]}"; do
        if arch-chroot "$TARGET" getent group "$g" >/dev/null 2>&1; then
            run arch-chroot "$TARGET" gpasswd -a "$USERNAME" "$g" || true
        fi
    done
    install -Dm644 /dev/stdin "$TARGET/etc/luxos/templates.conf" <<<"TEMPLATES=$TEMPLATES" || true

    if ((${#failed[@]})); then
        local IFS=' '
        progress "STATUS $(T "Some apps could not be installed: %s. You can install them later in the LuxOS Store." "${failed[*]}")"
        info "$(T "Some apps could not be installed: %s. You can install them later in the LuxOS Store." "${failed[*]}")"
    fi
    return 0
}

# Polozka LuxOS (systemd-boot na nasem ESP) na prvni misto BootOrder; poradi ostatnich zustava.
# efibootmgr --create ji sice dava dopredu, ale "uz existujici" polozka nebo firmware (Acer: zalozni
# \EFI\Boot\grubx64.efi jineho systemu) ji nechaji az za USB - pak by se misto nabidky spustil jiny system.
uefi_luxos_first() {  # uefi_luxos_first [ESP_ODDIL]
    local esp=${1-} partuuid="" out order num first rest="" n
    [[ -n $esp ]] && partuuid=$(lsblk -no PARTUUID "$esp" 2>/dev/null | tr -d ' ')
    out=$(efibootmgr -v 2>/dev/null) || return 0
    order=$(sed -n 's/^BootOrder: *//p' <<<"$out" | head -n1)
    [[ -n $order ]] || return 0
    num=$(awk -v u="${partuuid,,}" '
        /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ {
            id = substr($1, 5, 4); low = tolower($0)
            ours = index(low, "systemd-bootx64.efi") && (u == "" || index(low, u))
            if (ours && $0 ~ /[* ]LuxOS([ \t]|$)/) { print id; exit }
            if (ours && first == "") first = id
        }
        END { if (first != "") print first }' <<<"$out" | head -n1)
    [[ -n $num ]] || return 0
    first=${order%%,*}
    [[ ${first^^} == "${num^^}" ]] && return 0
    for n in ${order//,/ }; do [[ ${n^^} == "${num^^}" ]] || rest+=",$n"; done
    run efibootmgr -q -o "$num$rest" || info "$(T "Could not put LuxOS first in the UEFI boot order; choose it in the boot menu (F12).")"
}

# Sdileny ESP: polozku UEFI pridat jen pokud tam systemd-boot jeste nema vlastni; menu musi byt videt
shared_esp_entry() {
    local partn partuuid entries timeout
    partn=$(lsblk -no PARTN "$ESP_PART" | tr -d ' ')
    partuuid=$(lsblk -no PARTUUID "$ESP_PART" | tr -d ' ')
    entries=$(efibootmgr -v 2>/dev/null || true)
    if [[ -n $partuuid ]] && awk -v u="${partuuid,,}" 'index(tolower($0), u) && index(tolower($0), "systemd-bootx64.efi") {f = 1} END {exit !f}' <<<"$entries"; then
        info "$(T "systemd-boot on %s is already in the UEFI boot menu." "$ESP_PART")"
    else
        run efibootmgr --create --disk "$DISK" --part "$partn" --label LuxOS \
            --loader '\EFI\systemd\systemd-bootx64.efi' --unicode || info "$(T "Could not add UEFI boot entry (fallback loader will be used)")"
    fi
    uefi_luxos_first "$ESP_PART"
    # Cizi loader.conf se neprepisuje; skryte menu zviditelnit promennou EFI (LoaderConfigTimeout)
    timeout=$(awk '$1 == "timeout" {print $2}' "$TARGET${ESP_MOUNT:-/efi}/loader/loader.conf" 2>/dev/null | tail -1 || true)
    if [[ -z $timeout || $timeout == 0 || $timeout == menu-hidden ]]; then
        run bootctl set-timeout 3 || info "$(T "Could not show the boot menu; hold Space while starting to see it.")"
    fi
}

# Cely system v jednom souboru (/etc/luxos/system.lsl) ze hotove instalace: s tim se snadno opravuje
# (lux system diff / fix). Bez hesel (ani Wi-Fi). OEM: az po Pruvodci nastavenim (ucet majitele, jazyk),
# vytvori ho luxos-oem finish. Chyba instalaci nezastavi.
write_system_config() {
    ((${OEM:-0})) && return 0
    [[ -x $TARGET/usr/lib/lux/lux_system.py ]] || return 0
    progress "STATUS $(T "Writing the system configuration (/etc/luxos/system.lsl)…")"
    if ! arch-chroot "$TARGET" /usr/lib/lux/lux_system.py init --auto >>"$LOG" 2>&1 ||
            [[ ! -e $TARGET/etc/luxos/system.lsl ]]; then
        info "$(T "The system configuration file was not written; create it later with: sudo lux system init")"
    fi
    progress "STATUS "
}

finish() {
    step "$(T "Finishing")"
    # Pozustatky z pacstrapu (databaze v /var/lib/pacman ap.) presunul hook lux-engine-migrate; odkazy
    # na stara mista uz nic nepotrebuje - nainstalovany system je ma mit ciste (jinak je uklidi lux
    # po prvnim restartu)
    # gpg-agent spusteny pacstrapem (-K) by drzel $TARGET pripojeny; ukoncit pred uklidem - agent je
    # svazany s cestou, se kterou byl spusten (stara cesta je do uklidu odkaz na /etc/lux/keyring)
    local d
    for d in "$TARGET/etc/pacman.d/gnupg" "$TARGET/etc/lux/keyring"; do
        [[ -d $d ]] && { gpgconf --homedir "$d" --kill all >/dev/null 2>&1 || true; }
    done
    # procesy zivého systemu (Obchod...) s cilovou instalaci nesouvisi
    arch-chroot "$TARGET" "$LUX_MIGRATE" finish --now --ignore-processes >>"$LOG" 2>&1 || true
    [[ -n $ENGINE_SHIM ]] && rm -rf "$ENGINE_SHIM"
    cp "$LOG" "$TARGET/var/log/luxos-install.log" 2>/dev/null || true
    sync
    local i
    for i in 1 2 3 4 5; do   # agent konci asynchronne
        mountpoint -q "$TARGET" || break
        umount -R "$TARGET" 2>/dev/null && break
        sleep 1
    done
    ((ENCRYPT)) && cryptsetup close cryptroot 2>/dev/null || true
    uses_layout && layout_teardown
    if ((PROGRESS)); then
        info "$(T "LuxOS is installed")"
        [[ -n $DOMAIN_NOTICE ]] && info "$DOMAIN_NOTICE"
        progress "DONE"
        return 0
    fi
    echo
    gum style --border rounded --border-foreground "$ACCENT" --padding "1 4" --margin "1 2" --align center \
        "$(gum style --foreground "$ACCENT" --bold "✦  $(T "LuxOS is installed")")" "" \
        "$(T "Remove the installation media and restart your computer.")"
    [[ -n $DOMAIN_NOTICE ]] && gum style --foreground 214 "  ! $DOMAIN_NOTICE"
    ((ASSUME_YES)) && return 0
    if gum confirm --affirmative "$(T "Restart")" --negative "$(T "Later")" "$(T "Restart now?")"; then systemctl reboot; fi
}

# --- Rucni rozdeleni (DISK_MODE=layout) ----------------------------------------
load_layout() {  # LAYOUT / LAYOUT_FILE -> L (kontrola konfigurace i zarizeni; nic nemeni)
    local text=${LAYOUT-}
    if [[ -z $text && -n ${LAYOUT_FILE-} ]]; then
        [[ -r $LAYOUT_FILE ]] || fail "$(T "Cannot read %s" "$LAYOUT_FILE")"
        text=$(<"$LAYOUT_FILE")
    fi
    [[ -n $text ]] || fail "$(T "DISK_MODE=layout needs LAYOUT or LAYOUT_FILE")"
    layout_parse "$text"
    layout_validate
    ((${#LY_ERR[@]})) || layout_check_devices
    report_layout
}

report_layout() {  # chyby -> konec se seznamem, varovani jen vypsat
    local e msg
    for e in "${LY_WARN[@]}"; do
        msg=$(ly_error_text "$e")
        progress "WARN $msg"
        info "$(T "Warning: %s" "$msg")"
    done
    ((${#LY_ERR[@]})) || return 0
    for e in "${LY_ERR[@]}"; do
        msg=$(ly_error_text "$e")
        printf '✗ %s\n' "$msg" >&2
        printf '✗ %s\n' "$msg" >>"$LOG" 2>/dev/null || true
    done
    fail "$(ly_error_text "${LY_ERR[0]}")"
}

check_layout_cmd() {  # --check-layout SOUBOR: jen kontrola (bez roota jen konfigurace)
    local text
    if [[ $1 == - ]]; then text=$(cat); else text=$(<"$1"); fi
    if [[ -d /sys/firmware/efi/efivars ]]; then BOOTMODE=${BOOTMODE:-uefi}; else BOOTMODE=${BOOTMODE:-bios}; fi
    BOOTLOADER=${BOOTLOADER:-auto}
    layout_parse "$text"
    layout_validate
    ((EUID == 0 && ${#LY_ERR[@]} == 0)) && layout_check_devices
    local e rc=0
    for e in "${LY_WARN[@]}"; do printf 'WARN %s\t%s\n' "${e%%|*}" "$(ly_error_text "$e")"; done
    for e in "${LY_ERR[@]}"; do printf 'ERROR %s\t%s\n' "${e%%|*}" "$(ly_error_text "$e")"; rc=1; done
    ((rc)) || { layout_text; layout_destroy_list | sed 's/^/ERASE /'; }
    return "$rc"
}

ask_layout() {  # TUI: rozlozeni ze souboru (vytvori ho napr. GUI nebo podle install.conf.example)
    local f
    f=$(gum input --header "$(T "Path to the partition layout file (LAYOUT format)")" --value "/root/layout.conf") || exit 1
    LAYOUT_FILE=$f LAYOUT=""
    [[ -r $f ]] || fail "$(T "Cannot read %s" "$f")"
    layout_parse "$(<"$f")"
    if [[ -n $(ly_ids luks) ]]; then
        LUKS_PASS=$(ask_password "$(T "Disk encryption password")")
    fi
}

check_wipe() {  # WIPE z konfigurace / TUI
    : "${WIPE:=none}"
    wipe_valid || fail "$(T "Invalid WIPE (use none, zero or overwrite)")"
    if wipe_enabled && [[ $DISK_MODE == manual ]]; then
        fail "$(T "WIPE is not available with partitions already mounted at %s (DISK_MODE=manual)." "$TARGET")"
    fi
    return 0
}

main() {
    if [[ -n $PROBE ]]; then
        probe "$PROBE"
        return 0
    fi
    if ((SCAN)); then
        exec python3 -I /usr/lib/luxos/python/luxos_layout.py --scan
    fi
    if [[ -n $CHECK_LAYOUT ]]; then
        check_layout_cmd "$CHECK_LAYOUT"
        return
    fi
    preflight
    DISK_MODE=${DISK_MODE:-}
    BOOTLOADER=${BOOTLOADER:-auto}
    CARE_MODE=${CARE_MODE:-}
    if [[ -n $CONFIG ]]; then
        if [[ $CONFIG == - ]]; then
            eval "$CONFIG_DATA"
            CONFIG_DATA=""
        else
            # shellcheck disable=SC1090
            . "$CONFIG"
        fi
        [[ -n ${UI_LANG-} ]] && ui_lang "$UI_LANG"
        : "${LOCALE:=en_US.UTF-8}" "${XKB_LAYOUT:=us}" "${XKB_VARIANT:=}" "${TIMEZONE:=UTC}"
        : "${ENCRYPT:=0}" "${AUTOLOGIN:=0}" "${HOSTNAME_SEL:=luxos}" "${FULLNAME:=${USERNAME-}}"
        : "${BOOTLOADER:=auto}" "${LUXAI_ACCOUNT:=}" "${TEMPLATES:=}" "${WIPE:=none}" "${WIPE_CANCEL_FILE:=}"
        xkb_normalize   # seznam rozlozeni a prepinani (viz xkb_normalize)
        [[ ${DISK_MODE-} == manual && -z ${DISK-} ]] && DISK=manual   # pripojeno v /mnt, disk neni potreba
        [[ ${DISK_MODE-} == layout && -z ${DISK-} ]] && DISK=layout   # disky jsou v LAYOUT
        # existujici oddil: disk podle oddilu
        [[ ${DISK_MODE-} == partition && -z ${DISK-} && -n ${ROOT_PART-} ]] && DISK=$(ly_parent_disk "$ROOT_PART")
        oem_config   # OEM=1: bez osobniho uctu (USERNAME/PASSWORD jen pro docasny ucet oem)
        [[ -n ${DISK-} ]] && { ((${OEM:-0})) || [[ -n ${USERNAME-} && -n ${PASSWORD-} ]]; } ||
            fail "$(T "Config needs DISK, USERNAME and PASSWORD")"
        [[ -z $USERNAME ]] || valid_user "$USERNAME" || fail "$(T "Invalid USERNAME")"
        valid_host "$HOSTNAME_SEL" || fail "$(T "Invalid HOSTNAME_SEL")"
        ((ENCRYPT)) && [[ -z ${LUKS_PASS-} ]] && fail "$(T "ENCRYPT=1 needs LUKS_PASS")"
        domain_config   # DOMAIN=: pripojeni k domene Active Directory (nepovinne)
        have_internet || fail "$(T "No internet connection")"
        # Ucet LuxAI uz prihlaseny v GUI (JSON bez hesla), jinak LUXAI_EMAIL + LUXAI_PASSWORD
        if [[ -n $LUXAI_ACCOUNT ]] && ! python3 -c 'import json, sys; assert json.load(sys.stdin)["sessionToken"]' \
                <<<"$LUXAI_ACCOUNT" 2>/dev/null; then
            info "$(T "LuxAI sign-in failed - continuing without it.")"
            LUXAI_ACCOUNT=""
        fi
        if [[ -z $LUXAI_ACCOUNT && -n ${LUXAI_EMAIL-} && -n ${LUXAI_PASSWORD-} ]]; then
            luxai_login "$LUXAI_EMAIL" "$LUXAI_PASSWORD" || info "$(T "LuxAI sign-in failed - continuing without it.") ($LUXAI_ERROR)"
        fi
    else
        interactive
        domain_config
        oem_luks_key   # OEM se sifrovanim: docasny klic disku
    fi
    # Rezim disku: erase (cely disk), freespace (vedle jinych systemu), partition (existujici oddil),
    # layout (rucni rozdeleni), manual (pripojeno v $TARGET)
    [[ $DISK == manual ]] && DISK_MODE=manual
    : "${DISK_MODE:=erase}"
    case $DISK_MODE in
        erase|freespace) ;;
        manual) DISK=manual ;;
        layout) ENCRYPT=0; load_layout; oem_check_mode ;;   # sifrovani popisuje LAYOUT (luks)
        partition) part_setup ;;            # sestavi LAYOUT (ENCRYPT -> luks)
        *) fail "$(T "Invalid DISK_MODE (use erase, freespace, partition, layout or manual)")" ;;
    esac
    [[ $BOOTLOADER == auto || $BOOTLOADER == none ]] || fail "$(T "Invalid BOOTLOADER (use auto or none)")"
    [[ -z $CONFIG ]] && ask_wipe   # TUI: az po priprave rezimu (velikost mazane oblasti)
    check_wipe
    : "${CARE_MODE:=carefree}"
    [[ $CARE_MODE == carefree || $CARE_MODE == classic ]] || fail "$(T "Invalid CARE_MODE (use carefree or classic)")"
    : "${PROTECT:=1}"
    [[ $PROTECT == @(0|1) ]] || fail "$(T "Invalid PROTECT (use 0 or 1)")"
    [[ -n $CONFIG ]] && parse_templates
    if [[ $DISK_MODE == manual ]]; then STEP_TOTAL=4
    elif uses_layout; then STEP_TOTAL=$(($(layout_steps) + 4))
    else STEP_TOTAL=$((6 + ENCRYPT)); wipe_enabled && STEP_TOTAL=$((STEP_TOTAL + 1)); fi
    ((${#TEMPLATE_IDS[@]})) && STEP_TOTAL=$((STEP_TOTAL + 1))
    summary
    case $DISK_MODE in
        erase) prepare_disk ;;
        freespace) prepare_freespace ;;
        layout) layout_apply ;;
        partition)
            # Mezi souhrnem a instalaci se mohl oddil zacit pouzivat - znovu overit
            part_check "$ROOT_PART"
            [[ -z $PC_ROOT_ERR ]] || fail "$(T "%s cannot be used for LuxOS: %s" "$ROOT_PART" "$(part_reason "$PC_ROOT_ERR")")"
            part_set_type
            layout_apply ;;
        manual)
            ROOTDEV=$(findmnt -no SOURCE "$TARGET" | sed 's/\[.*\]//')
            BOOTPART=$(findmnt -no SOURCE "$TARGET/boot" 2>/dev/null || true)
            [[ $BOOTMODE == bios ]] && DISK=$(lsblk -no PKNAME "$ROOTDEV" | head -1 | sed 's|^|/dev/|')
            ;;
    esac
    install_packages
    configure_system
    install_templates
    write_system_config
    finish
}

main "$@"
