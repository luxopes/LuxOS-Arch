#!/bin/bash
# LuxOS - instalator
#
# Interaktivne:   sudo luxos-install
# Bez obsluhy:    sudo luxos-install --config /cesta/install.conf [--yes] [--progress]
#                 ... | sudo luxos-install --config - --yes --progress   (konfigurace ze stdin)
# Disky (GUI):    sudo luxos-install --probe /dev/DISK   (volne misto, ESP a oddily pro DISK_MODE=partition; KLIC=hodnota)
#                 sudo luxos-install --scan               (disky, oddily, LUKS, LVM jako JSON; jen cte)
#                 luxos-install --check-layout SOUBOR     (kontrola LAYOUT bez zmen; - = stdin)
#
# Konfiguracni soubor (bash promenne) - viz /usr/share/luxos/installer/install.conf.example
# --progress: strojove radky "@@STEP n celkem text", "@@PCT 0-100", "@@STATUS text", "@@NET B/s stazeno celkem", "@@NET END", "@@ERROR text", "@@DONE"
#             rucni rozdeleni a existujici oddil (DISK_MODE=layout, partition) navic "@@ERASE text"
#             (co se smaze, pred souhrnem) a "@@WARN text"
#             bezpecne smazani (WIPE=zero|overwrite): "@@WIPE START" / "@@WIPE END" (GUI ukaze "Preskocit"),
#             prubeh v @@PCT a @@STATUS; preskoceni = soubor WIPE_CANCEL_FILE (z GUI) nebo Ctrl+C
set -Eeuo pipefail

LOG=/var/log/luxos-install.log
TARGET=/mnt
SHARE=/usr/share/luxos/installer
# Nastroje jadra lux (lux-engine, lux-engine-key, lux-engine-conf) jsou mimo PATH. sudo/pkexec PATH
# nastavi po svem, proto az tady. pacstrap (arch-install-scripts) je vola jmeny z Archu - dostane je
# jen on, z docasneho adresare (engine_shim).
export PATH="/usr/lib/lux/alpm/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/bin}"
LUX_CONFIG_TOOL=/usr/lib/lux/lux-config
LUX_MIGRATE=/usr/share/libalpm/scripts/lux-engine-migrate
. /usr/lib/luxos/i18n.sh
ui_lang() { export LANG=$1; . /usr/lib/luxos/i18n.sh; }   # jazyk pruvodce podle volby
usage() {
    printf '%s\n\n%s\n' "luxos-install - $(T "LuxOS installer")" "$(T "Usage:")"
    printf '  %s\n      %s\n' \
        "sudo luxos-install" "$(T "interactive installation")" \
        "sudo luxos-install --config FILE|- [--yes] [--progress]" \
        "$(T "unattended installation (example: /usr/share/luxos/installer/install.conf.example)")" \
        "sudo luxos-install --probe /dev/DISK" "$(T "free space and partitions of a disk (KEY=value)")" \
        "sudo luxos-install --scan" "$(T "disks, partitions, LUKS and LVM as JSON (read-only)")" \
        "luxos-install --check-layout FILE|-" "$(T "check a LAYOUT without changing anything")"
}
for a in "$@"; do [[ $a == -h || $a == --help ]] && { usage; exit 0; }; done     # napoveda bez sudo
# Rucni rozdeleni disku (DISK_MODE=layout): parser, kontrola a provedeni LAYOUT
. "$SHARE/layout.sh"
# Bezpecne smazani mista pro LuxOS pred formatovanim (WIPE=zero|overwrite)
. "$SHARE/wipe.sh"

CONFIG=""
ASSUME_YES=0
PROGRESS=0
PROBE=""
SCAN=0
CHECK_LAYOUT=""
for a in "$@"; do
    [[ $a == --check-layout ]] && CHECK_LAYOUT=1
done
((EUID == 0 || CHECK_LAYOUT == 1)) || exec sudo "$0" "$@"
while (($#)); do
    case $1 in
        --config)   CONFIG=$2; shift ;;
        --yes)      ASSUME_YES=1 ;;
        --progress) PROGRESS=1 ;;
        --probe)    PROBE=$2; shift ;;
        --scan)     SCAN=1 ;;
        --check-layout) CHECK_LAYOUT=$2; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "$(T "Unknown option: %s" "$1")" >&2; exit 2 ;;
    esac
    shift
done

# Konfigurace ze stdin (hesla se nezapisuji na disk); stdin pak uz nic necte
CONFIG_DATA=""
if [[ $CONFIG == - ]]; then
    CONFIG_DATA=$(cat)
    exec </dev/null
fi

# --- Vystup -----------------------------------------------------------------
ACCENT="#a77bff"
STEP_N=0
STEP_TOTAL=0
progress() { ((PROGRESS)) && printf '@@%s\n' "$*"; return 0; }   # radek pro graficky instalator
title() { gum style --foreground "$ACCENT" --bold --margin "1 0 0 0" "✦ $*"; }
info()  { gum style --foreground 250 "  $*"; }
step()  {
    STEP_N=$((STEP_N + 1))
    progress "STEP $STEP_N $STEP_TOTAL $*"
    printf '\n\e[1;38;2;167;123;255m==>\e[0m \e[1m%s\e[0m\n' "$*"; printf '\n==> %s\n' "$*" >>"$LOG"
}
fail()  { progress "ERROR $*"; printf '✗ %s\n' "$*" >>"$LOG" 2>/dev/null || true; gum style --foreground 203 --bold "✗ $*" >&2; exit 1; }
run()   { printf '+ %s\n' "$*" >>"$LOG"; "$@" >>"$LOG" 2>&1; }
if ((PROGRESS)); then
    # Vystup cte GUI (roura, ne terminal): bez gum a barev
    title() { printf '\n✦ %s\n' "$*"; }
    info()  { printf '  %s\n' "$*"; }
    step()  {
        STEP_N=$((STEP_N + 1))
        progress "STEP $STEP_N $STEP_TOTAL $*"
        printf '\n==> %s\n' "$*" | tee -a "$LOG"
    }
    fail()  { progress "ERROR $*"; printf '✗ %s\n' "$*" | tee -a "$LOG" >&2; exit 1; }
fi

on_error() {
    local rc=$? line=$1
    echo >&2
    progress "ERROR $(T "Installation failed (line %s, exit code %s)." "$line" "$rc")"
    if ((PROGRESS)); then
        T "Installation failed (line %s, exit code %s)." "$line" "$rc" >&2; echo >&2
    else
        gum style --border rounded --border-foreground 203 --padding "1 2" --foreground 203 \
            "$(T "Installation failed (line %s, exit code %s)." "$line" "$rc")" "" \
            "$(T "Details are in %s. Last lines:" "$LOG")" >&2 || true
        tail -n 15 "$LOG" >&2 || true
    fi
    exit "$rc"
}
trap 'on_error $LINENO' ERR

# --- Kontroly prostredi -----------------------------------------------------
preflight() {
    command -v gum >/dev/null || { echo "gum is missing" >&2; exit 1; }
    : >"$LOG"
    if [[ -d /sys/firmware/efi/efivars ]]; then BOOTMODE=uefi; else BOOTMODE=bios; fi
    [[ -d /run/archiso ]] || info "$(T "Warning: not running from the LuxOS live system.")"
}

have_internet() { curl -fsI --max-time 6 https://geo.mirror.pkgbuild.com/ >/dev/null 2>&1; }

ensure_internet() {
    until have_internet; do
        title "$(T "No internet connection")"
        info "$(T "LuxOS downloads the newest packages during installation.")"
        info "$(T "Connect with the network icon in the top bar, or use the text tool.")"
        local c
        c=$(gum choose "$(T "Try again")" "$(T "Open network setup (nmtui)")" "$(T "Quit")") || exit 1
        case $c in
            "$(T "Open network setup (nmtui)")") nmtui || true ;;
            "$(T "Quit")") exit 1 ;;
        esac
    done
}

# --- Volby ------------------------------------------------------------------
LANGS=(
    # Anglicky nazev za teckou: hledani funguje i bez diakritiky ("czech", "cest")
    "English (US)|en_US.UTF-8" "Čeština · Czech, Cestina|cs_CZ.UTF-8" "Slovenčina · Slovak, Slovencina|sk_SK.UTF-8"
    "Deutsch · German|de_DE.UTF-8" "Polski · Polish|pl_PL.UTF-8" "Français · French|fr_FR.UTF-8"
    "Español · Spanish|es_ES.UTF-8" "Italiano · Italian|it_IT.UTF-8" "Português (Brasil) · Portuguese|pt_BR.UTF-8"
    "Nederlands · Dutch|nl_NL.UTF-8" "Magyar · Hungarian|hu_HU.UTF-8" "Svenska · Swedish|sv_SE.UTF-8"
    "Українська · Ukrainian|uk_UA.UTF-8" "English (UK)|en_GB.UTF-8"
)
KEYMAPS=(
    "English (US)|us|" "Czech|cz|" "Czech (QWERTY)|cz|qwerty" "Slovak|sk|" "Slovak (QWERTY)|sk|qwerty"
    "German|de|" "English (UK)|gb|" "French|fr|" "Spanish|es|" "Italian|it|" "Polish|pl|"
    "Hungarian|hu|" "Ukrainian|ua|" "Portuguese|pt|" "Portuguese (Brazil)|br|" "Swedish|se|"
)

pick_from() {  # pick_from "Nadpis" polozka... -> vybrany radek "label|..."
    local header=$1; shift
    local labels=() sel i
    for i in "$@"; do labels+=("$(T "${i%%|*}")"); done
    sel=$(printf '%s\n' "${labels[@]}" "$(T "Other…")" | gum filter --header "$header" --height 14 --placeholder "$(T "Type to search")") || exit 1
    for i in "$@"; do [[ $(T "${i%%|*}") == "$sel" ]] && { echo "$i"; return; }; done
    echo "Other…"   # pevny klic (nezavisly na jazyku pruvodce)
}

# Prevod rozlozeni X11 na konzolove podle tabulky systemd (jako systemd-localed): cely seznam
# ("cz,us" -> cz-us-qwertz), pak prvni rozlozeni s variantou, pak prvni rozlozeni s cimkoli
x11_to_console() {
    local layout=$1 variant=${2-} map=${KBD_MODEL_MAP:-/usr/share/systemd/kbd-model-map} km
    [[ -z ${variant//,/} ]] && variant=-
    km=$(awk -v l="$layout" -v v="$variant" -v l1="${layout%%,*}" -v v1="${2%%,*}" '
        $1 ~ /^#/ || NF < 5 { next }
        { split($2, a, ","); split($4, b, ","); fv = (b[1] == "-") ? "" : b[1] }
        $2 == l && $4 == v { print $1; found = 1; exit }
        !e && a[1] == l1 && fv == v1 { e = $1 }
        !f && a[1] == l1 { f = $1 }
        END { if (!found) print (e != "" ? e : f) }' "$map" 2>/dev/null)
    echo "${km:-us}"
}

# Rozlozeni klavesnice: XKB_LAYOUT a XKB_VARIANT jsou seznamy oddelene carkou (prvni = vychozi,
# nejvyse 4 - vic XKB neumi), XKB_OPTIONS prepinani (napr. grp:shifts_toggle; prazdne = jen
# klikem na vlajku v horni liste). Bez XKB_OPTIONS (starsi konfigurace) se k jinemu rozlozeni nez
# US pridava US s vychozim prepinanim (obe klavesy Shift). Vysledek se zapise zpet do promennych.
XKB_SWITCH_DEFAULT=grp:shifts_toggle
xkb_normalize() {
    local -a lays vars
    local -A seen=()
    local i l v out_l=() out_v=()
    IFS=, read -ra lays <<<"${XKB_LAYOUT-}"
    IFS=, read -ra vars <<<"${XKB_VARIANT-}"
    for i in "${!lays[@]}"; do
        l=${lays[i]// /} v=${vars[i]-}
        v=${v// /}
        [[ -z $l ]] && continue
        [[ $l =~ ^[a-z][a-z0-9_-]{0,31}$ && $v =~ ^[A-Za-z0-9_-]{0,48}$ ]] ||
            fail "$(T "Invalid keyboard layout: %s" "$l${v:+ ($v)}")"
        [[ -n ${seen["$l:$v"]-} ]] && continue
        seen["$l:$v"]=1
        out_l+=("$l") out_v+=("$v")
    done
    ((${#out_l[@]})) || out_l=(us) out_v=("")
    if [[ -z ${XKB_OPTIONS+x} ]]; then
        if ((${#out_l[@]} == 1)) && [[ ${out_l[0]} != us ]]; then out_l+=(us) out_v+=(""); fi
        XKB_OPTIONS=""
        ((${#out_l[@]} > 1)) && XKB_OPTIONS=$XKB_SWITCH_DEFAULT
    fi
    ((${#out_l[@]} <= 4)) || fail "$(T "At most %d keyboard layouts are possible." 4)"
    [[ $XKB_OPTIONS =~ ^([A-Za-z0-9_]+:[A-Za-z0-9_]+(,[A-Za-z0-9_]+:[A-Za-z0-9_]+)*)?$ ]] ||
        fail "$(T "Invalid XKB_OPTIONS: %s" "$XKB_OPTIONS")"
    XKB_LAYOUT=$(IFS=,; echo "${out_l[*]}")
    XKB_VARIANT=$(IFS=,; echo "${out_v[*]}")
}

# "cz (qwerty), us" pro souhrn
xkb_text() {
    local -a lays vars
    local i out=()
    IFS=, read -ra lays <<<"$XKB_LAYOUT"
    IFS=, read -ra vars <<<"$XKB_VARIANT"
    for i in "${!lays[@]}"; do out+=("${lays[i]}${vars[i]:+ (${vars[i]})}"); done
    local IFS=,
    echo "${out[*]}" | sed 's/,/, /g'
}

# Rozlozeni hned i v live systemu (pruvodce bezi v terminalu graficke relace)
xkb_live() {
    [[ -n ${SUDO_USER-} && -n ${DISPLAY-} ]] || return 0
    sudo -u "$SUDO_USER" DISPLAY="$DISPLAY" setxkbmap -layout "$XKB_LAYOUT" -variant "$XKB_VARIANT" \
        -option "" ${XKB_OPTIONS:+-option "$XKB_OPTIONS"} 2>/dev/null || true
}

# Krok Klavesnice: vychozi rozlozeni + dalsi (US predvybrane, Enter = potvrdit)
ask_keyboard() {
    title "$(T "Keyboard")"
    # Rozlozeni pro zemi zvoleneho jazyka nahoru (cs_CZ -> cz)
    local country=${LOCALE:3:2} first=() rest=() k sel n l v
    for k in "${KEYMAPS[@]}"; do
        IFS='|' read -r _ l _ <<<"$k"
        if [[ $l == "${country,,}" ]]; then first+=("$k"); else rest+=("$k"); fi
    done
    sel=$(pick_from "$(T "Choose your keyboard layout")" "${first[@]}" "${rest[@]}")
    if [[ $sel == "Other…" ]]; then
        XKB_LAYOUT=$(localectl list-x11-keymap-layouts | gum filter --header "$(T "Layout")" --height 14) || exit 1
        XKB_VARIANT=$( (echo "(default)"; localectl list-x11-keymap-variants "$XKB_LAYOUT" 2>/dev/null) |
                       gum filter --header "$(T "Variant")" --height 14) || exit 1
        [[ $XKB_VARIANT == "(default)" ]] && XKB_VARIANT=""
    else
        IFS='|' read -r _ XKB_LAYOUT XKB_VARIANT <<<"$sel"
    fi
    # Dalsi rozlozeni: prvni polozka = jen vychozi; US predvybrane (psani hesel a kodu)
    local only labels=() pre="" extra
    only=$(T "Only %s" "$(T "${sel%%|*}")")
    [[ $sel == "Other…" ]] && only=$(T "Only %s" "$XKB_LAYOUT${XKB_VARIANT:+ ($XKB_VARIANT)}")
    for k in "${KEYMAPS[@]}"; do
        IFS='|' read -r n l v <<<"$k"
        [[ $l == "$XKB_LAYOUT" && $v == "$XKB_VARIANT" ]] && continue
        labels+=("$(T "$n")")
        [[ $XKB_LAYOUT != us && $l == us && -z $v ]] && pre=$(T "$n")
    done
    extra=$(printf '%s\n' "$only" "${labels[@]}" "$(T "Other…")" |
            gum choose --limit 3 ${pre:+--selected "$pre"} --height 14 \
                --header "$(T "More layouts? Space selects, Enter confirms (switch with both Shift keys)")") || exit 1
    local lays=$XKB_LAYOUT vars=$XKB_VARIANT line
    while IFS= read -r line; do
        [[ -z $line || $line == "$only" ]] && continue
        if [[ $line == "$(T "Other…")" ]]; then
            l=$(localectl list-x11-keymap-layouts | gum filter --header "$(T "Layout")" --height 14) || continue
            v=$( (echo "(default)"; localectl list-x11-keymap-variants "$l" 2>/dev/null) |
                 gum filter --header "$(T "Variant")" --height 14) || v="(default)"
            [[ $v == "(default)" ]] && v=""
        else
            for k in "${KEYMAPS[@]}"; do
                IFS='|' read -r n l v <<<"$k"
                [[ $(T "$n") == "$line" ]] && break
            done
        fi
        lays+=",$l" vars+=",$v"
    done <<<"$extra"
    XKB_LAYOUT=$lays XKB_VARIANT=$vars
    XKB_OPTIONS=""
    [[ $XKB_LAYOUT == *,* ]] && XKB_OPTIONS=$XKB_SWITCH_DEFAULT
    xkb_normalize
    xkb_live
    info "$(T "Keyboard: %s" "$(xkb_text)")"
}

valid_user() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ && $1 != root ]]; }
valid_host() { [[ $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; }

iso_disk() {
    local src
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
    [[ -n $src ]] && lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

list_disks() {
    local iso; iso=$(iso_disk)
    lsblk -dnpbo NAME,SIZE,TYPE,RO,MODEL | while read -r name size type ro model; do
        [[ $type == disk && $ro == 0 ]] || continue
        [[ $name == /dev/zram* || $name == /dev/loop* ]] && continue
        [[ -n $iso && $name == "/dev/$iso" ]] && continue
        ((size >= 20 * 1000 * 1000 * 1000)) || continue
        printf '%s|%s  %s  %s\n' "$name" "$name" "$(numfmt --to=si --suffix=B "$size")" "${model:-disk}"
    done
}

interactive() {
    clear
    gum style --border rounded --border-foreground "$ACCENT" --padding "1 4" --margin "1 2" --align center \
        "$(gum style --foreground "$ACCENT" --bold '✦  LuxOS')" "" \
        "Welcome! This will install LuxOS on your computer." "Vítejte! Tento průvodce nainstaluje LuxOS do počítače."

    # Jazyk (zaroven jazyk pruvodce)
    title "Language · Jazyk"
    local sel
    sel=$(pick_from "Choose the system language · Vyberte jazyk systému" "${LANGS[@]}")
    if [[ $sel == "Other…" ]]; then
        LOCALE=$(grep -oE '^[a-zA-Z_@]+\.UTF-8' /usr/share/i18n/SUPPORTED | sort -u |
                 gum filter --header "$(T "Choose locale")" --height 14) || exit 1
    else
        LOCALE=${sel##*|}
    fi
    ui_lang "$LOCALE"
    info "$(T "Language: %s" "$LOCALE")"
    info "$(T "The installation takes about 10 minutes.")"

    ensure_internet

    ask_oem
    ask_keyboard

    # Casove pasmo
    title "$(T "Time zone")"
    local detected
    detected=$(curl -fs --max-time 5 'http://ip-api.com/line/?fields=timezone' 2>/dev/null || true)
    if [[ -n $detected && -e /usr/share/zoneinfo/$detected ]] && \
       gum confirm "$(T "Use detected time zone %s?" "$detected")"; then
        TIMEZONE=$detected
    else
        TIMEZONE=$(timedatectl list-timezones | gum filter --header "$(T "Choose time zone")" --height 14) || exit 1
    fi
    info "$(T "Time zone: %s" "$TIMEZONE")"

    # Disk
    title "$(T "Disk")"
    local disks
    mapfile -t disks < <(list_disks)
    local opts=() d
    for d in "${disks[@]}"; do opts+=("${d#*|}"); done
    local advanced
    advanced=$(T "Advanced: use partitions already mounted at %s" "$TARGET")
    local layout_opt part_opt
    part_opt=$(T "Install into an existing partition (other partitions are kept)")
    layout_opt=$(T "Advanced: manual partitioning from a layout file (LVM, encryption)")
    opts+=("$part_opt" "$layout_opt" "$advanced")
    sel=$(gum choose --header "$(T "Where should LuxOS be installed?")" "${opts[@]}") || exit 1
    if [[ $sel == "$layout_opt" ]]; then
        DISK=layout DISK_MODE=layout ENCRYPT=0
        ask_layout
    elif [[ $sel == "$part_opt" ]]; then
        DISK_MODE=partition ENCRYPT=0
        ask_partition
        if gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" "$(T "Encrypt LuxOS? (you will enter a password at every start)")"; then
            ENCRYPT=1
            ask_luks_pass
        fi
    elif [[ $sel == "$advanced" ]]; then
        DISK=manual
        mountpoint -q "$TARGET" || fail "$(T "Nothing is mounted at %s. Mount root (and /boot) first." "$TARGET")"
        ENCRYPT=0
    else
        DISK=${sel%% *}
        info "$(T "All data on %s will be erased." "$DISK")"
        ENCRYPT=0
        if gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" "$(T "Encrypt the disk? (you will enter a password at every start)")"; then
            ENCRYPT=1
            ask_luks_pass
        fi
    fi

    if ((${OEM:-0})); then
        ask_oem_account
        ask_care
        ask_templates
        return 0
    fi
    # Uzivatel
    title "$(T "Your account")"
    FULLNAME=$(gum input --header "$(T "Full name")" --placeholder "$(T "Jane Doe")") || exit 1
    local suggested
    suggested=$(iconv -f utf-8 -t ascii//TRANSLIT <<<"${FULLNAME%% *}" 2>/dev/null | tr -cd 'A-Za-z0-9' | tr 'A-Z' 'a-z')
    while :; do
        USERNAME=$(gum input --header "$(T "User name (lowercase)")" --value "${suggested:-user}") || exit 1
        valid_user "$USERNAME" && break
        info "$(T "Use lowercase letters, numbers, - and _ (max 32 characters).")"
    done
    PASSWORD=$(ask_password "$(T "Password")")
    while :; do
        HOSTNAME_SEL=$(gum input --header "$(T "Computer name")" --value "${USERNAME}-luxos") || exit 1
        valid_host "$HOSTNAME_SEL" && break
        info "$(T "Use letters, numbers and - (no spaces).")"
    done
    AUTOLOGIN=0
    gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" "$(T "Log in automatically without a password?")" && AUTOLOGIN=1
    ask_domain
    ask_care
    ask_templates
    ask_luxai
    return 0
}

# --- Firemni sit: pripojeni k domene Active Directory (DOMAIN=, balik luxos-domain) ----------------
# DOMAIN_PASSWORD (heslo spravce domeny) se pouzije jen jednou: stdin "lux-domain join --password-stdin"
# v chrootu. Nezapisuje se do cile, do zaznamu ani do argumentu procesu. Neuspech instalaci nezastavi.
DOMAIN_NOTICE=""
valid_domain() { [[ ${#1} -le 253 && $1 =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]]; }
no_newline() { [[ $1 != *$'\n'* && $1 != *$'\r'* ]]; }

domain_config() {  # kontrola DOMAIN, DOMAIN_USER, DOMAIN_PASSWORD, OU (alias DOMAIN_OU), DOMAIN_ADMINS
    DOMAIN=${DOMAIN-} DOMAIN_USER=${DOMAIN_USER-} DOMAIN_PASSWORD=${DOMAIN_PASSWORD-} DOMAIN_ADMINS=${DOMAIN_ADMINS-}
    OU=${OU:-${DOMAIN_OU-}}
    DOMAIN=${DOMAIN,,}
    if [[ -z $DOMAIN ]]; then
        DOMAIN_USER="" DOMAIN_PASSWORD="" OU="" DOMAIN_ADMINS=""
        return 0
    fi
    valid_domain "$DOMAIN" || fail "$(T "Invalid DOMAIN (e.g. firma.local)")"
    [[ -n $DOMAIN_USER ]] || fail "$(T "DOMAIN needs DOMAIN_USER (a domain administrator)")"
    [[ -n $DOMAIN_PASSWORD ]] || fail "$(T "DOMAIN needs DOMAIN_PASSWORD")"
    no_newline "$DOMAIN_USER" && no_newline "$DOMAIN_PASSWORD" && no_newline "$OU" && no_newline "$DOMAIN_ADMINS" ||
        fail "$(T "Invalid DOMAIN_USER, DOMAIN_PASSWORD, OU or DOMAIN_ADMINS")"
    return 0
}

domain_text() {  # radek souhrnu
    if [[ -n ${DOMAIN-} ]]; then T "domain %s (administrator %s)" "$DOMAIN" "$DOMAIN_USER"
    else T "no (personal computer)"; fi
}

domain_discover_text() {  # domain_discover_text DOMENA -> citelny vysledek "lux-domain discover"; 1 = nenalezeno
    local out res realm n msg
    command -v lux-domain >/dev/null || return 0     # v live systemu chybi: pripojeni az v cili
    out=$(lux-domain discover "$1" --json 2>/dev/null || true)
    res=$(python3 -c '
import json, sys
try:
    d = json.loads(sys.argv[1])
except ValueError:
    d = {}
if not isinstance(d, dict):
    d = {}
msg = " ".join(str(d.get("message") or "").split())
print("\x1f".join(("ok" if d.get("ok") else "fail", d.get("realm") or d.get("domain") or "",
                 str(len(d.get("controllers") or [])), msg)))' "$out")
    IFS=$'\x1f' read -r res realm n msg <<<"$res"
    if [[ $res == ok ]]; then
        T "Found: Active Directory %s (domain controllers: %s)" "$realm" "$n"
        return 0
    fi
    printf '%s' "${msg:-$(T "The domain was not found.")}"
    return 1
}

ask_domain() {  # TUI: komu pocitac patri (osobni / organizace s domenou Windows)
    DOMAIN="" DOMAIN_USER="" DOMAIN_PASSWORD="" OU="" DOMAIN_ADMINS=""
    title "$(T "Organization network")"
    local me org sel msg
    me=$(T "Me (personal computer)")
    org=$(T "An organization (Windows domain)")
    sel=$(gum choose --header "$(T "Who does this computer belong to?")" "$me" "$org") || return 0
    [[ $sel == "$org" ]] || return 0
    while :; do
        DOMAIN=$(gum input --header "$(T "Domain (e.g. firma.local)")" --value "$DOMAIN") || { DOMAIN=""; return 0; }
        DOMAIN=${DOMAIN,,}; DOMAIN=${DOMAIN// /}
        [[ -z $DOMAIN ]] && return 0
        if ! valid_domain "$DOMAIN"; then
            info "$(T "This is not a valid domain name (e.g. firma.local).")"
            continue
        fi
        if msg=$(domain_discover_text "$DOMAIN"); then
            [[ -n $msg ]] && info "$msg"
            break
        fi
        info "$msg"
        gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" \
            "$(T "Use this domain anyway? (it is joined at the end of the installation)")" && break
    done
    while [[ -z $DOMAIN_USER ]]; do
        DOMAIN_USER=$(gum input --header "$(T "Domain administrator (allowed to add computers)")" \
            --placeholder "administrator") || { DOMAIN=""; return 0; }
    done
    while [[ -z $DOMAIN_PASSWORD ]]; do
        DOMAIN_PASSWORD=$(gum input --password --header "$(T "Password of %s (used once, never saved)" "$DOMAIN_USER")") ||
            { DOMAIN="" DOMAIN_USER=""; return 0; }
    done
    OU=$(gum input --header "$(T "Organizational unit for the computer (optional, Enter = default)")" \
        --placeholder "OU=Computers,DC=firma,DC=local") || OU=""
    return 0
}

domain_join() {  # po setup-chroot: pripojeni cile k domene (lux-domain v chrootu, heslo na stdin)
    [[ -n ${DOMAIN-} ]] || return 0
    local -a args=(lux-domain join "$DOMAIN" -U "$DOMAIN_USER")
    [[ -n ${OU-} ]] && args+=(--ou "$OU")
    [[ -n ${DOMAIN_ADMINS-} ]] && args+=(--admins "$DOMAIN_ADMINS")
    args+=(--password-stdin --yes --no-snapshot --offline-install --progress)
    info "$(T "Joining the organization network %s…" "$DOMAIN")"
    progress "STATUS $(T "Joining the organization network %s…" "$DOMAIN")"
    printf '+ arch-chroot %s %s\n' "$TARGET" "${args[*]}" >>"$LOG"
    local line text err="" ok=0
    # printf je vestaveny prikaz: heslo neni v argumentech zadneho procesu, jen v rource na stdin
    while IFS= read -r line; do
        case $line in
            "@@STEP "*)
                read -r _ _ _ text <<<"$line"
                printf '  %s\n' "$text" >>"$LOG"
                progress "STATUS $text" ;;
            "@@ERROR "*) err=${line#@@ERROR }; [[ $err == *" "* ]] && err=${err#* }; err=${err%.} ;;
            "@@DONE") ok=1 ;;
            "@@"*) ;;
            *) printf '%s\n' "$line" >>"$LOG" ;;
        esac
    done < <(printf '%s\n' "$DOMAIN_PASSWORD" | arch-chroot "$TARGET" "${args[@]}" 2>&1 || true)
    DOMAIN_PASSWORD=""
    if ((ok)); then
        info "$(T "The computer joined the domain %s." "$DOMAIN")"
        progress "STATUS "
        return 0
    fi
    DOMAIN_NOTICE=$(T "The computer could not join the domain %s: %s. Join it later in Settings > Organization Network." \
        "$DOMAIN" "${err:-$(T "unknown error")}")
    printf '! %s\n' "$DOMAIN_NOTICE" >>"$LOG"
    info "$DOMAIN_NOTICE"
    progress "NOTICE $DOMAIN_NOTICE"
    return 0
}

# --- OEM: priprava pro jineho cloveka (ucet si zalozi majitel v Pruvodci nastavenim) --------------
# OEM=1: bez osobniho uctu a LuxAI. OEM_SEAL=1 (vychozi) = zapeceteno hned, prvni start otevre Pruvodce
# nastavenim; OEM_SEAL=0 = docasny ucet oem (heslo PASSWORD) pro instalaci aplikaci a zkouseni hardwaru,
# pak "luxos-oem seal". Sifrovani: docasny nahodny klic v initramfs (start bez hesla), heslo disku
# zvoli majitel v Pruvodci (luxos-oem finish). LUKS_PASS se v OEM nezadava.
OEM=${OEM:-0}
OEM_SEAL=${OEM_SEAL:-1}
OEM_USER=oem
OEM_LUKS_NAME=cryptroot

ask_oem() {
    title "$(T "Who will use this computer?")"
    local me other sel
    me=$(T "Me - set up my account now")
    other=$(T "Prepare for another person (OEM)")
    sel=$(gum choose --header "$(T "Who will use this computer?")" "$me" "$other") || exit 1
    OEM=0
    [[ $sel == "$other" ]] && OEM=1
    ((${OEM:-0})) && info "$(T "The owner creates their account in the setup assistant at the first start.")"
    return 0
}

ask_luks_pass() {  # heslo disku; v OEM ho zvoli majitel (docasny klic)
    if ((${OEM:-0})); then
        LUKS_PASS=""
        info "$(T "The owner chooses the disk password in the setup assistant.")"
    else
        LUKS_PASS=$(ask_password "$(T "Disk encryption password")")
    fi
}

ask_oem_account() {
    title "$(T "Prepare for another person (OEM)")"
    info "$(T "At the first start the owner chooses language, keyboard, Wi-Fi and creates their account.")"
    OEM_SEAL=1 USERNAME="" PASSWORD="" FULLNAME="" AUTOLOGIN=0 HOSTNAME_SEL=luxos
    if gum confirm --default=false --affirmative "$(T "Yes")" --negative "$(T "No")" \
            "$(T "Prepare the computer first (temporary account oem, then Seal for Customer)?")"; then
        OEM_SEAL=0 USERNAME=$OEM_USER FULLNAME="OEM"
        PASSWORD=$(ask_password "$(T "Password for the temporary account oem")")
    fi
    return 0
}

oem_config() {  # OEM=1 z konfigurace: kontrola a doplneni (pred kontrolou USERNAME/PASSWORD)
    [[ $OEM == @(0|1) ]] || fail "$(T "Invalid OEM (use 0 or 1)")"
    ((${OEM:-0})) || return 0
    [[ $OEM_SEAL == @(0|1) ]] || fail "$(T "Invalid OEM_SEAL (use 1 or 0)")"
    LUXAI_ACCOUNT="" LUXAI_EMAIL="" LUXAI_PASSWORD=""
    if ((${OEM_SEAL:-1})); then
        USERNAME="" PASSWORD="" AUTOLOGIN=0
    else
        USERNAME=$OEM_USER
        [[ -n ${PASSWORD-} ]] || fail "$(T "OEM_SEAL=0 needs PASSWORD (temporary account oem)")"
        FULLNAME="OEM"
    fi
    oem_luks_key
}

oem_luks_key() {  # docasny klic disku (majitel ho v Pruvodci nahradi svym heslem)
    if ((${OEM:-0} && ENCRYPT)) && [[ -z ${LUKS_PASS-} ]]; then
        LUKS_PASS=$(head -c 96 /dev/urandom | base64 -w0 | tr -d '/+=' | head -c 64)
    fi
    return 0
}

oem_check_mode() {  # sifrovani v OEM jen jako jeden svazek / (cryptroot), ne rucni LAYOUT s LUKS
    ((${OEM:-0})) || return 0
    if [[ $DISK_MODE == layout && -n $(ly_ids luks) ]]; then
        fail "$(T "Preparing for another person (OEM) does not support encryption in manual partitioning. Use Encrypt LuxOS instead.")"
    fi
    return 0
}

oem_user_text() {
    if ((${OEM_SEAL:-1})); then T "the owner creates it at the first start (OEM)"
    else T "the owner creates it at the first start (OEM); until sealing: temporary account %s" "$OEM_USER"; fi
}

oem_prepare_target() {  # pred setup-chroot (mkinitcpio): stav OEM, docasny klic disku do initramfs
    local user="" luks=""
    ((${OEM_SEAL:-1})) || user=$OEM_USER
    ((ENCRYPT)) && luks=$OEM_LUKS_NAME
    install -Dm644 /dev/stdin "$TARGET/etc/luxos/oem.conf" <<C
# LuxOS - pocitac pripraveny pro jineho cloveka (luxos-oem)
OEM=1
OEM_USER=$user
LUKS_NAME=$luks
C
    if ((ENCRYPT)); then
        install -d -m700 "$TARGET/etc/cryptsetup-keys.d"
        (umask 077; printf '%s' "$LUKS_PASS" >"$TARGET/etc/cryptsetup-keys.d/$OEM_LUKS_NAME.key")
        chmod 0400 "$TARGET/etc/cryptsetup-keys.d/$OEM_LUKS_NAME.key"
        install -Dm644 /dev/stdin "$TARGET/etc/mkinitcpio.conf.d/luxos-oem.conf" <<C
# LuxOS - OEM: docasny klic disku v initramfs (start bez hesla); odstrani luxos-oem finish
FILES+=(/etc/cryptsetup-keys.d/$OEM_LUKS_NAME.key)
C
    fi
    return 0
}

oem_finish_target() {  # po setup-chroot: zapecetit hned, nebo spoustec "Zapecetit" pro ucet oem
    if ((${OEM_SEAL:-1})); then
        arch-chroot "$TARGET" /usr/bin/luxos-oem seal --chroot --yes >>"$LOG" 2>&1 ||
            fail "$(T "Could not seal the system for the owner.")"
        return 0
    fi
    local home="$TARGET/home/$OEM_USER" src=/usr/share/applications/luxos-oem-seal.desktop
    [[ -e $TARGET$src ]] && src=$TARGET$src
    if [[ -e $src ]]; then
        sed '/^NoDisplay=/d' "$src" | install -Dm755 /dev/stdin "$home/Desktop/luxos-oem-seal.desktop"
    fi
    # po prihlaseni okno s pripominkou a tlacitkem Zapecetit (samo nic nezapecetuje)
    if [[ -e $src ]]; then
        sed 's/^Exec=.*/Exec=luxos-setup-assistant --seal-dialog --reminder/' "$src" |
            install -Dm644 /dev/stdin "$home/.config/autostart/luxos-oem-seal.desktop"
    fi
    arch-chroot "$TARGET" chown -R "$OEM_USER:" "/home/$OEM_USER" >>"$LOG" 2>&1 || true
}

# Bezpecne smazani (WIPE): nabidka v TUI po vyberu disku
wipe_area_bytes() {  # velikost mazane oblasti podle rezimu (pro odhad casu)
    case $DISK_MODE in
        erase)     wipe_size "$DISK" ;;
        freespace) [[ -n ${FS_BYTES-} ]] || check_freespace "$DISK" >/dev/null 2>&1 || true; echo "${FS_BYTES:-0}" ;;
        partition) wipe_size "$ROOT_PART" ;;
        layout)    ly_capacity; layout_wipe_bytes ;;
        *)         echo 0 ;;
    esac
}

wipe_text() {  # citelny popis volby WIPE pro souhrn
    case ${WIPE:-none} in
        none) T "no" ;;
        *) T "yes, %s (%s)" "$(human_bytes "$(wipe_area_bytes)")" "$(wipe_estimate_text "$(wipe_area_bytes)" "$(wipe_disk_hint)")" ;;
    esac
}

wipe_disk_hint() {  # disk pro odhad rychlosti (rucni rozdeleni: prvni disk s novym/formatovanym oddilem)
    local id
    case $DISK_MODE in
        partition) ly_parent_disk "$ROOT_PART" ;;
        layout)
            for id in $(layout_wipe_ids); do
                [[ ${L[$id.kind]} == part ]] && { echo "${L[$id.disk]}"; return; }
                [[ ${L[$id.kind]} == use ]] && { ly_parent_disk "${L[$id.dev]}"; return; }
            done
            echo /dev/null ;;
        *) echo "$DISK" ;;
    esac
}

ask_wipe() {
    WIPE=none
    [[ $DISK_MODE == manual ]] && return 0
    local bytes
    bytes=$(wipe_area_bytes)
    ((bytes > 0)) || return 0
    title "$(T "Erase securely")"
    info "$(T "Optionally overwrite the space for LuxOS first, so old files there cannot be recovered. Other partitions are not touched.")"
    info "$(T "Area: %s. This can take long: %s (SSD and NVMe drives with a fast erase command finish much sooner)." "$(human_bytes "$bytes")" "$(wipe_estimate_text "$bytes" "$(wipe_disk_hint)")")"
    ((ENCRYPT)) || [[ -n $(ly_ids luks 2>/dev/null) ]] &&
        info "$(T "Recommended with encryption: nothing unencrypted from before stays on the disk.")"
    info "$(T "You can skip the rest of the erasing with Ctrl+C; the installation then continues.")"
    if gum confirm --default=false --affirmative "$(T "Erase first")" --negative "$(T "No")"             "$(T "Securely erase the space for LuxOS first (slow)?")"; then
        WIPE=zero
    fi
    return 0
}

# Udrzba systemu: carefree (automaticke aktualizace a opravy) nebo classic (spravuje uzivatel)
