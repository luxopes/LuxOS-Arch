    def load_layout(self, then=None):
        """Scan disku (jen cte): FAKE vzorek, jako root pres backend --scan, jinak lsblk bez LVM."""
        def work():
            if FAKE:
                return lay.fake_scan("bios" if os.environ.get("LUXOS_INSTALL_FAKE_BIOS") == "1" else "uefi")
            if self.root:
                out = cmd_out("sudo", "-n", BACKEND, "--scan", timeout=90)
                try:
                    return json.loads(out)
                except ValueError:
                    pass
            return lay.scan_system(minsizes=False)

        def done(scan, _err):
            scan = scan or {"bootmode": "uefi", "disks": [], "vgs": []}
            if self.layout is None:
                self.layout = lay.Layout(scan)
                self.layout.passphrase = self.s["luks1"]
                preset = os.environ.get("LUXOS_INSTALL_FAKE_PRESET") if FAKE else None
                if preset:
                    self.s["luks1"] = self.s["luks2"] = self.layout.passphrase = "luxos"
                    self.s["preset_disk"] = "/dev/sdb"
                    self.layout.preset("/dev/sdb", preset, ram=8 * lay.GiB)
            else:
                self.layout.merge_scan(scan)
            if then:
                then()
            if self.current() in ("partitions", "summary"):
                self.render()
        run_async(work, done)

