    def background_checks(self):
        run_async(lambda: (have_internet(), sudo_ok()), self.checked)
        run_async(self.detect_timezone, self.tz_detected)

    def checked(self, res, _err):
        self.online, self.root = res if res else (False, False)
        if not self.online and "network" not in self.steps:
            self.steps.insert(1, "network")
            if self.idx >= 1:
                self.idx += 1
        self.render_sidebar()
        self.load_disks()

    def load_disks(self):
        def work():
            disks = list_disks()
            for d in disks:
                d["probe"] = probe_disk(d, self.root)
            return disks

        def done(disks, _err):
            self.disks = disks or []
            if self.s["disk"] is None and self.disks:
                self.s["disk"] = self.disks[0]["path"]
            if self.current() == "disk":
                self.render()
        run_async(work, done)

    @staticmethod
    def detect_timezone():
        if FAKE:
            return "Europe/Prague"
        try:
            with urllib.request.urlopen("http://ip-api.com/line/?fields=timezone", timeout=5) as r:
                tz = r.read().decode().strip()
            if tz and os.path.exists("/usr/share/zoneinfo/" + tz):
                return tz
        except Exception:  # noqa: BLE001
            pass
        return cmd_out("timedatectl", "show", "-p", "Timezone", "--value").strip()

    def tz_detected(self, tz, _err):
        if tz and self.s["timezone"] == "UTC":
            self.s["timezone"] = self.s["tz_detected"] = tz
            if self.current() == "timezone":
                self.render()

