            subprocess.run(["sudo", "-n", "systemctl", "reboot"], capture_output=True)

    # ---- beh backendu ----
    def build_config(self):
        s, q = self.s, shlex.quote
        layout, variant, options = self.xkb_values()
        values = {
            "LOCALE": s["locale"], "UI_LANG": s["locale"], "XKB_LAYOUT": layout, "XKB_VARIANT": variant,
            "XKB_OPTIONS": options,
            "TIMEZONE": s["timezone"], "DISK": s["disk"], "DISK_MODE": s["mode"], "BOOTLOADER": "auto",
            "ENCRYPT": "1" if s["encrypt"] else "0", "LUKS_PASS": s["luks1"] if s["encrypt"] else "",
            "USERNAME": s["username"], "FULLNAME": s["fullname"].strip(), "PASSWORD": s["pw1"],
            "HOSTNAME_SEL": s["hostname"], "AUTOLOGIN": "1" if s["autologin"] else "0", "CARE_MODE": s["care"],
            "LUXAI_ACCOUNT": json.dumps(s["luxai"], ensure_ascii=False) if s["luxai"] else "",
            "TEMPLATES": ",".join(s["templates"]),
            "WIPE": "zero" if s["wipe"] else "none", "WIPE_CANCEL_FILE": self.wipe_cancel_file(),
        }
        if s["mode"] == "manual" and self.layout is not None:
            values.update(self.layout.config_values())
        if s["mode"] == "partition":
            values.update({"ROOT_PART": s.get("part") or "", "HOME_PART": s.get("home_part") or ""})
        return "".join(f"{k}={q(v)}\n" for k, v in values.items())

    # Kdo umi zabranit setrici/zamceni a uspani (Xfce: org.xfce.ScreenSaver, xfce4-power-manager)
    INHIBITORS = (("org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver"),
                  ("org.xfce.ScreenSaver", "/org/xfce/ScreenSaver", "org.xfce.ScreenSaver"),
                  ("org.freedesktop.PowerManagement", "/org/freedesktop/PowerManagement/Inhibit",
                   "org.freedesktop.PowerManagement.Inhibit"))

    def inhibit_idle(self, on):
        """Behem instalace bez setrice obrazovky, zamceni a uspani."""
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        except GLib.Error:
            return
        if on:
            self.inhibit_cookies = []
            for name, path, iface in self.INHIBITORS:
                try:
                    r = bus.call_sync(name, path, iface, "Inhibit",
                                      GLib.Variant("(ss)", ("luxos-install-gui", _("Installing LuxOS"))),
                                      GLib.VariantType("(u)"), Gio.DBusCallFlags.NO_AUTO_START, 3000, None)
                    self.inhibit_cookies.append((name, path, iface, r.unpack()[0]))
                except GLib.Error:
                    continue
        else:
            for name, path, iface, cookie in getattr(self, "inhibit_cookies", []):
                try:
                    bus.call_sync(name, path, iface, "UnInhibit", GLib.Variant("(u)", (cookie,)),
                                  None, 0, 3000, None)
                except GLib.Error:
                    pass
            self.inhibit_cookies = []

    def wipe_cancel_file(self):
        """Soubor, kterym GUI rekne backendu (root) "preskocit mazani" - v adresari jen pro tohoto uzivatele."""
        if not self.s["wipe"]:
            return ""
        if not getattr(self, "wipe_dir", None):
            self.wipe_dir = tempfile.mkdtemp(prefix="luxos-install-")
        return os.path.join(self.wipe_dir, "skip-wipe")

    def skip_wipe(self):
        path = self.wipe_cancel_file()
        if not path:
            return
        try:
            open(path, "w").close()
        except OSError:
            return
        self.wipe_btn.set_sensitive(False)
        self.wipe_label.set_text(_("Skipping the rest of the erasing…"))

    def start_install(self):
        self.installing = True
        self.wiping = False
        est = self.wipe_estimate()[1] if self.s["wipe"] else 0
        # vaha kroku mazani v pruhu: podle odhadu (baliky ~ 70 pri ~10 min)
        self.wipe_weight = min(max(est / 600 * 70, 4), 300) if self.s["wipe"] else 0
        self.inhibit_idle(True)
        self.lines, self.buf = [], b""
        self.step_n, self.step_total, self.shown, self.target = 0, 1, 0.0, (0.0, 0.0)
        self.real, self.goal = 0.0, 0.0   # skutecny prubeh a cil animace pruhu
        self.net = None                   # {"rate", "got", "total", "avg", "idle", "slow"} behem stahovani
        self.status_until = 0.0
        self.error_text, self.done_flag = "", False
        if FAKE:
            cmd = ["bash", "-c", FAKE_BACKEND]
        elif self.root:
            cmd = ["sudo", "-n", BACKEND, "--config", "-", "--yes", "--progress"]
        else:
            cmd = ["pkexec", BACKEND, "--config", "-", "--yes", "--progress"]
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, bufsize=0)
        except OSError as e:
            self.finished(1, str(e))
            return
        try:
            self.proc.stdin.write(self.build_config().encode())
            self.proc.stdin.close()
        except OSError:
            pass
        fd = self.proc.stdout.fileno()
        GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_output)
        GLib.timeout_add(100, self.tick)
        GLib.timeout_add_seconds(9, self.next_slide)

    def on_output(self, fd, cond):
        data = b""
        if cond & GLib.IO_IN:
            try:
                data = os.read(fd, 65536)
            except OSError:
                data = b""
        if data:
            self.buf += data
            *lines, self.buf = re.split(rb"[\r\n]", self.buf)
            for raw in lines:
                self.handle_line(raw.decode("utf-8", "replace"))
            return True
        if self.buf:
            self.handle_line(self.buf.decode("utf-8", "replace"))
            self.buf = b""
        proc = self.proc
        run_async(proc.wait, lambda rc, _e: self.finished(rc if rc is not None else 1))
        return False

    def step_range(self):
        total = max(self.step_total, 1)
        # Vahy kroku: na konci HW, baliky, konfigurace, [sablony softwaru,] dokonceni (poradi v luxos-install)
        tail = [1, 55, 18, 25, 1] if self.s["templates"] else [1, 70, 22, 1]
        w = [2] * (total - len(tail)) + tail if total >= len(tail) else [1] * total
        if getattr(self, "wipe_weight", 0) and total > len(tail) + 1:
            w[1] = self.wipe_weight      # krok 2 = mazani (hned po rozdeleni disku)
        s = float(sum(w))
        n = min(max(self.step_n, 1), total)
        return sum(w[:n - 1]) / s, sum(w[:n]) / s

    def handle_line(self, line):
        if line.startswith("@@STEP "):
            parts = line.split(" ", 3)
            try:
                self.step_n, self.step_total = int(parts[1]), int(parts[2])
            except (IndexError, ValueError):
                return
            self.target = self.step_range()
            self.real = max(self.real, self.target[0])
            self.step_label.set_text(parts[3] if len(parts) > 3 else "")
            self.show_status("")
        elif line.startswith("@@PCT "):
            try:
                pct = min(max(int(line.split()[1]), 0), 100)
            except (IndexError, ValueError):
                return
            a, b = self.target
            self.real = max(self.real, a + (b - a) * pct / 100)
        elif line.startswith("@@NET"):
            self.on_net(line.split()[1:])
        elif line.startswith("@@WIPE"):
            self.wiping = line.split()[1:2] == ["START"]
            self.wipe_box.set_visible(self.wiping)
        elif line.startswith("@@STATUS"):
            text = line[9:].strip()
            self.show_status(text, hold=12, force=not text)
        elif line.startswith("@@ERROR "):
            self.error_text = self.error_text or line[8:]
        elif line == "@@DONE":
            self.done_flag = True
        else:
            self.lines.append(line)
            if len(self.lines) > 20000:
                del self.lines[:5000]
            self.log_buf.insert(self.log_buf.get_end_iter(), line + "\n")
            if self.log_buf.get_line_count() > 3000:
                self.log_buf.delete(self.log_buf.get_start_iter(), self.log_buf.get_iter_at_line(1000))
            self.log_view.scroll_mark_onscreen(self.log_end)

    def show_status(self, text, hold=0, force=False):
        """Hlaska pod pruhem; s hold zustane aspon tolik sekund (neprepise ji hned dalsi radek)."""
        now = time.monotonic()
        if not text and not force and now < self.status_until:
            return
        self.status_until = now + hold if text else 0.0
        say(self.status_label, text)

    def on_net(self, args):
        """@@NET B/s stazeno celkem | @@NET END"""
        if args[:1] == ["END"] or len(args) < 3:
            self.net = None
            self.net_spin.stop()
            self.net_row.hide()
            self.warn_box.hide()
            return
        try:
            rate, got, total = (max(int(x), 0) for x in args[:3])
        except ValueError:
            return
        n = self.net
        if n is None or got < n["got"] or total != n["total"]:
            # novy pokus nebo zacatek stahovani
            n = self.net = {"rate": 0, "got": got, "total": total, "avg": float(rate), "idle": 0, "slow": 0}
        n["idle"] = 0 if got > n["got"] else n["idle"] + 1   # vzorky (~2 s) bez novych dat
        n["rate"], n["got"] = rate, got
        n["avg"] = n["avg"] * 0.8 + rate * 0.2              # klidnejsi odhad pro zbyvajici cas
        left = max(total - got, 0)
        eta = left / n["avg"] if n["avg"] > 1000 else None
        slow = rate < 150_000 or (eta is not None and eta > 25 * 60)
        n["slow"] = n["slow"] + 1 if slow else 0
        parts = [_("Downloading %s of %s") % (size_text(got), size_text(total))]
        if n["idle"] >= 3:
            parts.append(_("waiting for data"))
        else:
            parts.append(_("%s/s") % size_text(rate))
            if eta is not None:
                parts.append(eta_text(eta))
        self.net_label.set_text(" · ".join(parts))
        self.net_row.show()
        self.net_spin.start()
        if n["idle"] >= 10:          # ~20 s bez dat
            self.warn(_("The connection is not responding right now"),
                      _("The installation has not stopped. LuxOS keeps trying other servers and continues "
                        "as soon as data arrives again."))
        elif n["slow"] >= 5:         # ~10 s pomale
            self.warn(_("Your internet connection is very slow"),
                      _("The installation will take longer. It has not stopped."))
        elif n["idle"] == 0 and n["slow"] == 0:
            self.warn_box.hide()

    def warn(self, title, text):
        self.warn_title.set_text(title)
        self.warn_text.set_text(text)
        self.warn_box.show()
        self.install_sub.set_text(_("The time depends on your internet connection. You can keep using the computer."))

    def tick(self):
        if not self.installing:
            return False
        a, b = self.target
        # Kroky bez prubehu: cil se pomalu blizi konci kroku, aby pruh nestal; pri stahovani
        # nejvys o 2 % nad skutecny stav (pruh nema predbihat data)
        cap = b if self.net is None and not self.wiping else min(b, self.real + 0.02)
        if cap > self.goal:
            self.goal += (cap - self.goal) * 0.0008
        self.goal = max(self.goal, self.real)
        if self.goal > self.shown + 0.0002:
            self.shown = min(self.goal, self.shown + max((self.goal - self.shown) * 0.15, 0.0002))
            self.update_bar()
        return True

    def update_bar(self):
        self.bar.set_fraction(min(self.shown, 1.0))
        self.pct_label.set_text(f"{int(self.shown * 100)} %")

    def next_slide(self):
        if not self.installing:
            return False
        cur = int(self.slide_stack.get_visible_child_name() or 0)
        self.slide_stack.set_visible_child_name(str((cur + 1) % len(SLIDES)))
        return True

    def finished(self, rc, extra=""):
        self.installing = False
        self.wiping = False
        if getattr(self, "wipe_dir", None):
            shutil.rmtree(self.wipe_dir, ignore_errors=True)
            self.wipe_dir = None
        self.inhibit_idle(False)
        if rc == 0 and self.done_flag:
            self.result = ("ok",)
        else:
            text = self.error_text or extra or _("The installer stopped with exit code %s.") % rc
            self.result = ("fail", text)
        self.idx = self.steps.index("done")
        self.render()


def eta_text(sec):
    """Zbyvajici cas stahovani: "about 12 min left"."""
    if sec < 60:
        return _("less than a minute left")
    m = int(sec / 60 + 0.5)
    if m < 60:
        return _("about %s left") % (_("%s min") % m)
    return _("about %s left") % (_("%s h %s min") % (m // 60, m % 60))


def wipe_time_text(sec):
    """Odhad doby mazani: "about 25 min"."""
    if sec < 60:
        return _("under a minute")
    m = int(sec / 60 + 0.5)
    if m < 60:
        return _("about %s") % (_("%s min") % m)
    return _("about %s") % (_("%s h %s min") % (m // 60, m % 60))


def wifi_list():
    """[(ssid, sila, zabezpecena)] z nmcli, bez duplicit."""
    if FAKE:
        return [("LuxLab", 82, True), ("Kavarna U Lipy", 54, False), ("Home-5G", 31, True)]
    out = cmd_out("nmcli", "-t", "-e", "yes", "-f", "SIGNAL,SECURITY,SSID", "device", "wifi", "list",
                  "--rescan", "yes", timeout=30)
    best = {}
    for line in out.splitlines():
        f = re.split(r"(?<!\\):", line, maxsplit=2)
        if len(f) < 3:
            continue
        ssid = f[2].replace("\\:", ":").replace("\\\\", "\\")
        if not ssid:
            continue
        try:
            sig = int(f[0])
        except ValueError:
            sig = 0
        if ssid not in best or sig > best[ssid][1]:
            best[ssid] = (ssid, sig, f[1] not in ("", "--"))
    return sorted(best.values(), key=lambda n: -n[1])


def open_url(url):
