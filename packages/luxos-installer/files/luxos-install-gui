                      "fstype": "vfat", "format": fmt.get_active() if existing_data else True}
        dlg.destroy()
        # Zapis do modelu
        if node is None:
            if kind == "lv":
                name = name_text or self.lv_name(newuse)
                taken = {n.name for n in L.of("lv") if n.vg == vg}
                if not name_text and name in taken:
                    # existujici skupina jineho systemu (napr. Debian ma svazek "root")
                    base = "luxos" if newuse and newuse.get("mount") == "/" else name
                    name, i = base, 2
                    while name in taken:
                        name, i = f"{base}{i}", i + 1
                node = L.add_lv(vg, name, size, is_rest)
            else:
                node = L.add_part(disk, size, is_rest)
        else:
            if size_spin is not None:
                node.size, node.rest = size, is_rest
            if name_editable:
                node.name = name_text or node.name
        if node.kind == "part" and not node.existing:
            node.ptype = k if k in ("esp", "bios") else ""
        if resize_spin is not None:
            want = int(resize_spin.get_value() * lay.GiB) // lay.MiB * lay.MiB
