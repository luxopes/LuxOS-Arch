    def part_info(self, dev):
        """Radek PART= z --probe pro oddil (ze vsech disku) nebo None."""
        for d in self.disks or []:
            for p in (d.get("probe") or {}).get("PARTS", []):
                if p["dev"] == dev:
                    return p
        return None

    def home_candidates(self):
        """Oddily, ktere lze bez formatovani pripojit jako /home (vsechny disky, mimo vybrany /)."""
        return [p for d in self.disks or [] for p in (d.get("probe") or {}).get("PARTS", [])
                if not p.get("home_err") and p["dev"] != self.s.get("part")]

    def partition_problem(self):
        """Proc nelze pokracovat v rezimu partition (prazdne = lze)."""
        probe = (self.selected_disk() or {}).get("probe") or {}
        boot = probe.get("PART_BOOT_ERR", "no_root")
        if boot:
            return _(PART_BOOT_WHY.get(boot, boot))
        p = self.part_info(self.s.get("part"))
        if not p or p.get("root_err") or p["dev"] not in [x["dev"] for x in probe.get("PARTS", [])]:
            return _("Choose a partition for LuxOS.")
        if self.s.get("home_part") and self.s["home_part"] not in [h["dev"] for h in self.home_candidates()]:
            return _("Choose a partition for LuxOS.")
        return ""

