        add(_("User name"), user, user_msg)
        pw_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.password_pair(pw_box, "pw1", "pw2", _("Password"), _("Confirm password"))
        add(_("Password"), pw_box)
        add(_("Computer name"), host, host_msg)
