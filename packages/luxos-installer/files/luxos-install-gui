        want_enc = enc.get_active() and k in ("fs", "swap", "none")
        cur = L.luks_on(node.id)
        if cur is not None and cur.existing:
            L.set_use(cur.id, newuse)
        else:
            if want_enc and cur is None:
                cur = L.encrypt(node.id)
            elif not want_enc and cur is not None:
                L.encrypt(node.id, False)
                cur = None
            target = cur if cur is not None else node
            L.set_use(target.id, newuse)
            if target is not node:
                node.use = None
            if cur is not None:
                cur.passphrase = own_pass.get_text() if not L.same_pass else ""
        self.layout_sel = node.id
        self.layout_changed()

    @staticmethod
    def lv_name(use):
        if not use:
            return "data"
        if use["type"] == "swap":
            return "swap"
        return {"/": "root"}.get(use["mount"], re.sub(r"[^a-z0-9]", "", use["mount"].rsplit("/", 1)[-1]) or "data")

    def space_after(self, node):
        """Volne misto hned za existujicim oddilem (pro zvetseni)."""
        end = node.start * 512 + node.size
        for start, length in self.layout.regions(node.disk):
            if abs(start - end) < lay.MiB:
                return length
        return 0

