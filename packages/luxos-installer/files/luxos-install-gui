def iso_disk():
    src = cmd_out("findmnt", "-no", "SOURCE", "/run/archiso/bootmnt").strip()
    return cmd_out("lsblk", "-no", "PKNAME", src).strip().split("\n")[0] if src else ""


def sys_start(name):
    try:
        with open(f"/sys/class/block/{name}/start") as f:
            return int(f.read())
    except (OSError, ValueError):
        return 0


def list_disks():
    """Disky vhodne pro instalaci (stejna pravidla jako list_disks v TUI) vcetne oddilu."""
    if FAKE:
        return fake_disks()
    raw = cmd_out("lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,TYPE,RO,MODEL,TRAN,FSTYPE,LABEL,PARTLABEL,PARTTYPE")
    try:
        devices = json.loads(raw or "{}").get("blockdevices", [])
    except ValueError:
        devices = []
    iso = iso_disk()
    disks = []
    for d in devices:
        ro = d.get("ro") in (True, "1", 1)
        if d.get("type") != "disk" or ro or d["name"].startswith(("zram", "loop")) or d["name"] == iso:
            continue
        if int(d.get("size") or 0) < MIN_DISK:
            continue
        parts = []
        for p in d.get("children") or []:
            if p.get("type") != "part":
                continue
            parts.append({"name": p["name"], "size": int(p.get("size") or 0), "start": sys_start(p["name"]),
                          "fstype": p.get("fstype") or "", "label": p.get("label") or p.get("partlabel") or "",
                          "parttype": (p.get("parttype") or "").lower()})
        parts.sort(key=lambda p: p["start"])
        disks.append({"path": d.get("path") or "/dev/" + d["name"], "name": d["name"], "size": int(d["size"]),
                      "model": (d.get("model") or "").strip(), "tran": d.get("tran") or "", "parts": parts,
                      "probe": None})
    return disks


def probe_disk(disk, root):
    """Volne misto a ESP (luxos-install --probe bezi jako root, jen cte)."""
    if FAKE or disk.get("probe") is not None:
        return disk.get("probe") or {}
    if not root:
        return {"FREESPACE_ERR": "no_root"}
    out = cmd_out("sudo", "-n", BACKEND, "--probe", disk["path"], timeout=40)
    info = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    return info or {"FREESPACE_ERR": "no_root"}


def part_kind(p):
    kind = PART_KINDS.get(p["parttype"])
    if kind:
        return _(kind)
    fs = p["fstype"]
    if fs == "ntfs":
        return "Windows (NTFS)"
    if fs in ("ext4", "ext3", "btrfs", "xfs", "f2fs"):
        return f"Linux ({fs})"
    if fs == "swap":
        return _("Swap")
    if fs == "crypto_LUKS":
        return _("Encrypted (LUKS)")
    if fs in ("vfat", "exfat"):
        return fs.upper() if fs == "vfat" else "exFAT"
    return fs or _("Unknown")


def disk_title(d):
    return f"{d['model'] or _('Disk')} · {size_text(d['size'])}"


