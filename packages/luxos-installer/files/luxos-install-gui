COLORS = [(0.62, 0.40, 1.0), (0.19, 0.78, 0.55), (1.0, 0.62, 0.04), (1.0, 0.36, 0.55),
          (0.35, 0.78, 0.98), (0.95, 0.80, 0.25), (0.62, 0.62, 0.68)]
LUXOS_COLOR = (0.24, 0.48, 1.0)   # novy oddil LuxOS


class DiskBar(Gtk.DrawingArea):
    """Vodorovny pruh: oddily barevne, volne misto prazdne, novy oddil LuxOS zvyrazneny."""

    def __init__(self, disk, luxos=None):
        super().__init__()
        self.disk, self.luxos = disk, luxos  # luxos: None | "erase" | bajty volneho mista
        self.set_size_request(-1, 26)
        self.connect("draw", self.on_draw)

    def segments(self):
        size = self.disk["size"]
        if self.luxos == "erase":
            return [(size, "luxos")]
        segs, pos = [], 2048 * 512
        for i, p in enumerate(self.disk["parts"]):
            start = p["start"] * 512 if p["start"] else pos
            if start - pos > 64 * 1000 ** 2:
                segs.append((start - pos, "free"))
            segs.append((p["size"], i))
            pos = start + p["size"]
        if size - pos > 64 * 1000 ** 2:
            segs.append((size - pos, "free"))
        if isinstance(self.luxos, int):
            # nejvetsi volnou oblast nahradit LuxOS
            frees = [k for k, s in enumerate(segs) if s[1] == "free"]
            if frees:
                k = max(frees, key=lambda k: segs[k][0])
                segs[k] = (segs[k][0], "luxos")
        return segs

    def on_draw(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        fg = widget.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        segs = self.segments()
        total = sum(s for s, _k in segs) or 1
        r = 7
        cr.new_sub_path()
        cr.arc(r, r, r, 3.1416, 1.5 * 3.1416)
        cr.arc(w - r, r, r, 1.5 * 3.1416, 0)
        cr.arc(w - r, h - r, r, 0, 0.5 * 3.1416)
        cr.arc(r, h - r, r, 0.5 * 3.1416, 3.1416)
        cr.close_path()
        cr.clip()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.08)
        cr.paint()
        x = 0.0
        for s, kind in segs:
            sw = max(3.0, w * s / total)
            if kind == "free":
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.06)
            elif kind == "luxos":
                cr.set_source_rgba(*LUXOS_COLOR, 1)
            else:
                cr.set_source_rgba(*COLORS[kind % len(COLORS)], 0.9)
            cr.rectangle(x, 0, sw, h)
            cr.fill()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.25)
            cr.rectangle(x + sw - 1, 0, 1, h)
            cr.fill()
            x += sw
        return False


