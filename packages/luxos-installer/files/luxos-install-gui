    def summary_layout(self, page):
        """Rucni rozdeleni v souhrnu: pripojeni a vyslovny seznam toho, co se smaze."""
        L = self.layout
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("card")
        t = Gtk.Label(label=_("Partitions"), xalign=0)
        t.get_style_context().add_class("card-title")
        box.pack_start(t, False, False, 0)
        grid = Gtk.Grid(column_spacing=18, row_spacing=3)
        users = sorted(L.users(), key=lambda n: (n.use["type"] != "fs", n.use.get("mount", "")))
        for i, n in enumerate(users):
            chain = []
            for a in reversed(L.ancestors(n)):
                if a.kind == "part":
                    chain.append(a.dev if a.existing else f"{a.disk} ({_('new')})")
                elif a.kind == "luks":
                    chain.append(_("LUKS2") + " " + L.luks_names().get(a.id, ""))
                elif a.kind == "lv":
                    chain.append(_("LVM") + " " + L.label(a))
            u = n.use
            cells = [self.use_text(u), u.get("fstype", "swap") if u["type"] == "fs" else "swap",
                     size_bin(L.size_of(n)), " › ".join(chain),
                     _("format") if u.get("format", True) else _("keep data")]
            for j, c in enumerate(cells):
                lab = Gtk.Label(label=c, xalign=0, ellipsize=3 if j == 3 else 0)
                if j == 3:
                    lab.set_hexpand(True)
                grid.attach(lab, j, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        page.pack_start(box, False, False, 0)
        destroy = L.destroy_list()
        if destroy:
            warn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            warn.get_style_context().add_class("warn")
            wt = Gtk.Label(label=_("Will be erased or changed when you click Install:"), xalign=0)
            wt.get_style_context().add_class("warn-title")
            warn.pack_start(wt, False, False, 0)
            for text, args in destroy:
                lab = Gtk.Label(label="•  " + _(text) % args, xalign=0, wrap=True)
                lab.get_style_context().add_class("danger-text")
                warn.pack_start(lab, False, False, 0)
            chk = Gtk.CheckButton(label=_("I understand that the data listed above will be lost."),
                                  active=self.s["layout_ok"])
            chk.connect("toggled", lambda c: (self.s.__setitem__("layout_ok", c.get_active()), self.update_nav()))
            warn.pack_start(chk, False, False, 4)
            page.pack_start(warn, False, False, 0)
            self.valid = lambda: self.s["layout_ok"]
            self.why = lambda: _("Confirm that the listed data will be erased.")

