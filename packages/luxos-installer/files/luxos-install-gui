    def unlock(self, n, base, passphrase):
        L = self.layout
        if FAKE:
            if passphrase != "luxos":
                return False
            L.unlock_fake(n.id)
            L.nodes[n.id].passphrase = passphrase
            self.layout_changed()
            return True
        name = "luxos-unlock-" + re.sub(r"[^a-z0-9]", "", base.dev.rsplit("/", 1)[-1])
        try:
            r = subprocess.run(["sudo", "-n", "cryptsetup", "open", "--key-file", "-", base.dev, name],
                               input=passphrase.encode(), capture_output=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            return False
        if r.returncode != 0:
            return False
        nid = n.id

        def after():
            if nid in self.layout.nodes:
                self.layout.nodes[nid].passphrase = passphrase
        cmd_out("udevadm", "settle", timeout=20)
        self.load_layout(then=after)
        return True

