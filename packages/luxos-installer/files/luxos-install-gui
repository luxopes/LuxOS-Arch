    def current(self):
        return self.steps[self.idx]

    STEP_NAMES = {"welcome": "Introduction", "network": "Network", "keyboard": "Keyboard", "timezone": "Time Zone",
                  "disk": "Destination", "partitions": "Partitions", "account": "Account", "care": "Maintenance", "software": "Software", "luxai": "LuxAI", "summary": "Summary",
                  "install": "Installation", "done": "Finish"}

    def render_sidebar(self):
        for c in self.sidebar.get_children():
            self.sidebar.remove(c)
        brand = Gtk.Box(spacing=10, margin=20, margin_bottom=18)
        brand.pack_start(logo_image(40), False, False, 0)
        name = Gtk.Label(label="LuxOS", xalign=0)
        name.get_style_context().add_class("brand")
        brand.pack_start(name, False, False, 0)
        self.sidebar.pack_start(brand, False, False, 0)
        for i, key in enumerate(self.steps):
            row = Gtk.Box(spacing=10, margin_start=12, margin_end=12)
            ctx = row.get_style_context()
            ctx.add_class("step")
            ctx.add_class("current" if i == self.idx else "done" if i < self.idx else "todo")
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.get_style_context().add_class("step-dot")
            row.pack_start(dot, False, False, 0)
            row.pack_start(Gtk.Label(label=_(self.STEP_NAMES[key]), xalign=0), True, True, 0)
            self.sidebar.pack_start(row, False, False, 0)
        self.sidebar.show_all()

    def render(self):
        self.header.set_title(_("Install LuxOS"))
        self.render_sidebar()
        child = self.scroll.get_child()
        if child:
            self.scroll.remove(child)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=28, margin_top=22)
        self.valid = lambda: True
        self.why = lambda: ""
        self.extra_action = None
        getattr(self, "page_" + self.current())(page)
        self.scroll.add(page)
        self.scroll.get_vadjustment().set_value(0)
        self.scroll.show_all()
        self.update_nav()

    def update_nav(self):
        key = self.current()
        self.btn_back.set_label(_("Back"))
        self.btn_back.set_visible(0 < self.idx and key not in ("install", "done"))
        labels = {"summary": _("Install"), "luxai": _("Continue") if self.s["luxai"] else _("Skip")}
        self.btn_next.set_label(labels.get(key, _("Continue")))
        self.btn_next.set_visible(key != "install")
        if key == "done":
            ok = self.result and self.result[0] == "ok"
            self.btn_next.set_label(_("Restart Now") if ok else _("Quit"))
        self.btn_extra.set_visible(self.extra_action is not None)
        self.btn_next.set_sensitive(bool(self.valid()))
        erase = key == "summary" and (self.s["mode"] in ("erase", "partition")
                                      or self.s["mode"] == "manual" and self.layout is not None
                                      and bool(self.layout.destroy_list()))
        ctx = self.btn_next.get_style_context()
        (ctx.add_class if erase else ctx.remove_class)("danger-btn")
        self.nav_hint.set_text("" if self.btn_next.get_sensitive() or key == "done" else self.why())

    def go_next(self):
        key = self.current()
        if key == "done":
            if self.result and self.result[0] == "ok":
                self.restart()
            else:
                Gtk.main_quit()
            return
        if not self.valid():
            return
        if key == "network" and not self.online:
            return
        self.idx += 1
        self.render()
        if self.current() == "install":
            self.start_install()

    def go_back(self):
        if self.current() == "summary":
            self.s["layout_ok"] = False
        if self.idx > 0 and self.current() not in ("install", "done"):
            self.idx -= 1
            self.render()

    def on_delete(self, *_a):
        if self.installing:
            # Zavreni by instalaci prerusilo uprostred zapisu na disk (nespustitelny system)
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.OK, text=_("LuxOS is being installed"))
            dlg.format_secondary_text(_("Closing the window now would interrupt the installation and leave "
                                        "the disk unusable. Please wait until the installation finishes."))
            dlg.run()
            dlg.destroy()
            return True
        if self.current() not in ("welcome", "done"):
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.NONE, text=_("Quit the installation?"))
            dlg.format_secondary_text(_("Closing the window interrupts the installation. LuxOS will not be "
                                        "installed and your choices will be lost."))
            dlg.add_buttons(_("Continue Installing"), Gtk.ResponseType.CANCEL, _("Quit"), Gtk.ResponseType.OK)
            dlg.set_default_response(Gtk.ResponseType.CANCEL)
            r = dlg.run()
            dlg.destroy()
            if r != Gtk.ResponseType.OK:
                return True
        Gtk.main_quit()
        return False

