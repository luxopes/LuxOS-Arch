        auto.connect("notify::active", lambda s, _p: self.s.__setitem__("autologin", s.get_active()))
        add(_("Log in automatically"), auto)
        page.pack_start(self.hint(_("With automatic login, anyone who turns on the computer can use your account.")),
                        False, False, 0)
        lock = {"busy": False}

        def on_full(_e):
            self.s["fullname"] = full.get_text()
            if not self.s["user_edited"]:
                lock["busy"] = True
                user.set_text(suggest_username(self.s["fullname"]))
                lock["busy"] = False
            refresh()

        def on_user(_e):
            if not lock["busy"]:
                self.s["user_edited"] = bool(user.get_text())
            self.s["username"] = user.get_text()
            if not self.s["host_edited"]:
                lock["busy"] = True
                host.set_text(f"{self.s['username']}-luxos" if self.s["username"] else "")
                lock["busy"] = False
            refresh()

        def on_host(_e):
            if not lock["busy"]:
                self.s["host_edited"] = bool(host.get_text())
            self.s["hostname"] = host.get_text()
            refresh()

        def refresh():
            u, h = self.s["username"], self.s["hostname"]
            if u and u in RESERVED_USERS:
                say(user_msg, _("This name is reserved by the system."))
            elif u and not valid_user(u):
                say(user_msg, _("Use lowercase letters, numbers, - and _ (max 32 characters)."))
            else:
                say(user_msg, "")
            say(host_msg, _("Use letters, numbers and - (no spaces).") if h and not valid_host(h) else "")
            for m in (user_msg, host_msg):
                ctx = m.get_style_context()
                (ctx.add_class if m.get_text() else ctx.remove_class)("error")
            self.update_nav()
        full.connect("changed", on_full)
        user.connect("changed", on_user)
        host.connect("changed", on_host)
        self.why = lambda: _("Fill in your name, user name, password and computer name.")
        self.valid = lambda: (bool(self.s["fullname"].strip()) and valid_user(self.s["username"])
                              and valid_host(self.s["hostname"]) and bool(self.s["pw1"])
                              and self.s["pw1"] == self.s["pw2"])
        refresh()
        GLib.idle_add(lambda: (full.grab_focus_without_selecting(), full.set_position(-1)) and False)

