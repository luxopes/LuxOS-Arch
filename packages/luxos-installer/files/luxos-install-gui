                inner = self.node_what(luks)
                add(it, luks.id, "changes-prevent-symbolic", L.luks_names().get(luks.id, ""),
                    _("Locked - unlock to use") if luks.locked else _("Encrypted (LUKS2)") +
                    ("" if inner in (_("not used"), _("Encrypted volume")) else "  ·  " + inner),
                    size_bin(L.size_of(luks)), self.use_text(lu), self.change_text(luks))
            return it

