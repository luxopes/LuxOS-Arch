    def load_layouts(self):
        if self.layouts is not None:
            return self.layouts
        common = [((layout, variant), _(name), f"{name} {_(name)} {layout} {variant}")
                  for name, layout, variant in KEYMAPS]
        seen = {k for k, _t, _h in common}
        country = self.s["locale"][3:5].lower()
        common.sort(key=lambda it: it[0][0] != country)
        rest, section = [], None
        try:
            with open("/usr/share/X11/xkb/rules/evdev.lst", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("!"):
                        section = line[1:].strip()
                        continue
                    m = re.match(r"\s+(\S+)\s+(.*)", line)
                    if not m:
                        continue
                    if section == "layout":
                        key, desc = (m.group(1), ""), m.group(2)
                    elif section == "variant" and ":" in m.group(2):
                        layout, desc = m.group(2).split(":", 1)
                        key, desc = (layout.strip(), m.group(1)), desc.strip()
                    else:
                        continue
                    if key not in seen:
                        seen.add(key)
                        rest.append((key, desc, f"{desc} {key[0]} {key[1]}"))
        except OSError:
            pass
        rest.sort(key=lambda it: it[1].lower())
        self.layouts = common + rest
        return self.layouts

    def xkb_name(self, key):
        return next((t for k, t, _h in self.load_layouts() if k == key), " ".join(p for p in key if p))

    def xkb_values(self):
        """(XKB_LAYOUT, XKB_VARIANT, XKB_OPTIONS) pro backend: seznamy oddelene carkou."""
        lays = self.s["xkb"]
        opts = self.s["xkb_switch"] if len(lays) > 1 else ""
        return ",".join(l for l, _v in lays), ",".join(v for _l, v in lays), opts

    def xkb_live(self):
        """Rozlozeni hned i v live systemu (pole na vyzkouseni)."""
        layout, variant, opts = self.xkb_values()
        cmd = ["setxkbmap", "-layout", layout, "-variant", variant, "-option", ""] + (["-option", opts] if opts else [])
        try:
            subprocess.Popen(cmd, stderr=subprocess.DEVNULL)
        except OSError:
            pass

