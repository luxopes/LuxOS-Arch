    # ---- bezpecne smazani (WIPE) ----
    def disk_by_path(self, path):
        return next((d for d in self.disks or [] if d["path"] == path), None)

    def wipe_plan(self):
        """[(disk nebo None, bajty)] - co volba smaze (jen misto pro LuxOS)."""
        mode, d = self.s["mode"], self.selected_disk()
        if mode == "manual":
            if self.layout is None:
                return []
            return [(self.disk_by_path(n.disk) if n.kind == "part" else None, b) for n, b in self.layout.wipe_targets()]
        if not d:
            return []
        if mode == "erase":
            return [(d, d["size"])]
        if mode == "freespace":
            return [(d, int((d.get("probe") or {}).get("FREE_BYTES") or 0))]
        if mode == "partition":
            p = self.part_info(self.s.get("part")) or {}
            return [(d, int(p.get("size") or 0))]
        return []

    @staticmethod
    def wipe_speed(d):
        """Odhad rychlosti prepsani (B/s): NVMe ~1,5 GB/s, SSD ~450 MB/s, HDD/nevime ~130 MB/s."""
        if not d:
            return 130e6
        if d.get("tran") == "nvme" or d.get("name", "").startswith("nvme"):
            return 1.5e9
        return 450e6 if d.get("rota") is False else 130e6

    def wipe_estimate(self):
        plan = self.wipe_plan()
        return sum(b for _d, b in plan), sum(b / self.wipe_speed(d) for d, b in plan)

    def wipe_card(self, page):
        total, sec = self.wipe_estimate()
        if total <= 0:
            self.s["wipe"] = False
            return
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.get_style_context().add_class("card")
        row = Gtk.Box(spacing=12)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        t = Gtk.Label(label=_("Erase securely first (slow)"), xalign=0)
        t.get_style_context().add_class("card-title")
        texts.pack_start(t, False, False, 0)
        texts.pack_start(self.hint(_("Overwrites the space for LuxOS (%s) so that old files there cannot be "
                                     "recovered. Other partitions are not touched.") % size_text(total)),
                         False, False, 0)
        row.pack_start(texts, True, True, 0)
        sw = Gtk.Switch(active=self.s["wipe"], valign=Gtk.Align.CENTER)
        sw.connect("notify::active", lambda w, _p: self.s.__setitem__("wipe", w.get_active()))
        row.pack_end(sw, False, False, 0)
        box.pack_start(row, False, False, 0)
        box.pack_start(self.hint(_("This can take long: %s. SSD and NVMe drives with a fast erase command finish "
                                   "much sooner. You can skip the rest while it runs; the installation then "
                                   "continues.") % wipe_time_text(sec)), False, False, 0)
        encrypted = self.layout.of("luks") if self.s["mode"] == "manual" and self.layout else self.s["encrypt"]
        if encrypted:
            box.pack_start(self.hint(_("Recommended with encryption: nothing unencrypted from before stays on the "
                                       "disk.")), False, False, 0)
        page.pack_start(box, False, False, 0)

