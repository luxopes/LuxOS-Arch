# ---- pomocne funkce --------------------------------------------------------------
def set_ui_lang(locale):
    """Prepne jazyk pruvodce za behu (luxos_i18n cte jazyk jen pri importu)."""
    os.environ["LANG"] = locale
    code = locale.split("_")[0].split(".")[0]
    luxos_i18n._TR.clear()
    try:
        with open(os.path.join(I18N_DIR, code + ".tsv"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("#") or "\t" not in line:
                    continue
                k, v = line.rstrip("\n").split("\t", 1)
                if v:
                    luxos_i18n._TR[k] = v
    except OSError:
        pass


def load_templates():
    """Sablony softwaru z TEMPLATE_DIR: [{"id", "name", "description", "apps", "icon", "download"}] podle @order."""
    out = []
    try:
        names = sorted(f for f in os.listdir(TEMPLATE_DIR) if f.endswith(".list")) if TEMPLATE_DIR else []
    except OSError:
        names = []
    for fn in names:
        t = {"id": fn[:-5], "order": 999, "name": fn[:-5], "description": "", "apps": "", "icon": "", "download": 0}
        if not re.fullmatch(r"[a-z0-9_-]+", t["id"]):
            continue
        try:
            with open(os.path.join(TEMPLATE_DIR, fn), encoding="utf-8") as f:
                for line in f:
                    m = re.match(r"@(\w+)\s+(.*?)\s*$", line)
                    if m and m.group(1) in t and m.group(1) != "id":
                        k, v = m.groups()
                        if k in ("order", "download"):
                            try:
                                v = int(v)
                            except ValueError:
                                continue
                        t[k] = v
        except OSError:
            continue
        out.append(t)
    return sorted(out, key=lambda t: (t["order"], t["id"]))


def size_text(n):
    """Velikost v jednotkach SI (stejne jako numfmt --to=si v TUI)."""
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if n >= 10 or unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return ""


def size_bin(n):
    """Velikost v binarnich jednotkach (editor oddilu: stejne jako sgdisk/lvcreate)."""
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if n >= 100 or unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return ""


def ram_bytes():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def say(label, text):
    """Text napovedy; prazdna se skryje."""
    label.set_text(text)
    label.set_visible(bool(text))


def run_async(work, done):
    """work() ve vlakne, done(vysledek, vyjimka) v hlavni smycce GTK."""
    def target():
        try:
            res, err = work(), None
        except Exception as e:  # noqa: BLE001 - chyba se zobrazi v GUI
            res, err = None, e
        GLib.idle_add(lambda: done(res, err) and False)
    threading.Thread(target=target, daemon=True).start()


def cmd_out(*cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def have_internet():
    if FAKE:
        return os.environ.get("LUXOS_INSTALL_FAKE_OFFLINE") != "1"
    try:
        req = urllib.request.Request("https://geo.mirror.pkgbuild.com/", method="HEAD")
        urllib.request.urlopen(req, timeout=6).close()
        return True
    except Exception:  # noqa: BLE001
        return False


def sudo_ok():
    if FAKE:
        return True
    try:
        return subprocess.run(["sudo", "-n", "true"], capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def suggest_username(fullname):
    first = (fullname.strip().split() or [""])[0]
    ascii_ = unicodedata.normalize("NFKD", first).encode("ascii", "ignore").decode()
    name = re.sub(r"[^a-z0-9]", "", ascii_.lower())
    if name and not re.match(r"[a-z_]", name):
        name = "u" + name
    return name[:32]


def valid_user(u):
    return bool(re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", u)) and u not in RESERVED_USERS


def valid_host(h):
    return bool(re.fullmatch(r"[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?", h))


