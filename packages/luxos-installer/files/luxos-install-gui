    def sync_steps(self):
        """Krok Partitions jen pri rucnim rozdeleni (hned za Destination)."""
        want = self.s["mode"] == "manual"
        if want and "partitions" not in self.steps:
            self.steps.insert(self.steps.index("disk") + 1, "partitions")
        elif not want and "partitions" in self.steps:
            self.steps.remove("partitions")
        self.render_sidebar()

    def pick_mode(self, mode):
        if mode != self.s["mode"]:
            self.s["mode"] = mode
            self.s["erase_ok"] = False
            self.sync_steps()
            GLib.idle_add(lambda: self.render() and False)
            if mode == "erase":
                # potvrzeni smazani musi byt videt
                GLib.timeout_add(120, self.scroll_to_erase)

    def scroll_to_erase(self):
        adj = self.scroll.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size() - 150)
        return False

