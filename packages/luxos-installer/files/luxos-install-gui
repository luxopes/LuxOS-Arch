    def search_list(self, page, items, selected, on_select, height=260, placeholder=None):
        """Vyhledavaci pole + seznam; items = [(klic, text, hledany_text)]."""
        entry = Gtk.SearchEntry(placeholder_text=placeholder or _("Type to search"))
        page.pack_start(entry, False, False, 0)
        lb = Gtk.ListBox(activate_on_single_click=True)
        lb.get_style_context().add_class("list")
        sel_row = None
        for key, text, hay in items:
            row = Gtk.ListBoxRow()
            row.key, row.hay = key, (hay or text).lower()
            row.add(Gtk.Label(label=text, xalign=0))
            lb.add(row)
            if key == selected and sel_row is None:
                sel_row = row
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=height)
        sw.get_style_context().add_class("list")
        sw.add(lb)
        page.pack_start(sw, True, True, 0)

        def flt(row):
            q = entry.get_text().strip().lower()
            if not q:
                return True
            q2 = unicodedata.normalize("NFKD", q).encode("ascii", "ignore").decode()
            return q in row.hay or (q2 and q2 in row.hay)
        lb.set_filter_func(flt)
        entry.connect("search-changed", lambda _e: lb.invalidate_filter())
        lb.connect("row-selected", lambda _l, row: row and on_select(row.key))
        if sel_row:
            lb.select_row(sel_row)

            def scroll_to():
                alloc = sel_row.get_allocation()
                if alloc.y > 0:
                    sw.get_vadjustment().set_value(max(0, alloc.y - 60))
                return False
            GLib.timeout_add(150, scroll_to)
        return entry, lb

