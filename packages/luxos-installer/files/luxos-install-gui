        def add_block(parent, n):
            """Oddil/LV a nad nim LUKS (a obsah) jako potomci."""
            u = n.use
            luks = L.luks_on(n.id)
            icon = "drive-harddisk-symbolic" if n.kind == "part" else "drive-multidisk-symbolic"
            it = add(parent, n.id, icon, self.node_name(n), self.node_what(n), size_bin(L.size_of(n)),
                     self.use_text(u), self.change_text(n))
            if luks is not None:
