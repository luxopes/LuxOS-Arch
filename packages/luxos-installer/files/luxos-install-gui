    def default_xkb(locale):
        """US jako vychozi (prvni) a rozlozeni podle zeme jazyka navic k prepnuti. US i u jinych
        jazyku: live system pouzivaji i lide z jinych zemi a hesla/kody se pisi stejne vsude."""
