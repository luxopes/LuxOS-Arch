    # -- texty radku --
    def node_name(self, n):
        if n.kind == "lv":
            return n.name
        if n.existing:
            return n.dev.rsplit("/", 1)[-1]
        return _("New partition")

    def node_what(self, n):
        L = self.layout
        if n.delete:
            return _("will be deleted")
        if n.kind == "part" and L.is_esp_part(n):
            return _("EFI system partition")
        if n.kind == "part" and (n.ptype == "bios" or n.parttype == lay.BIOS_GUID):
            return _("BIOS boot partition")
        if n.existing and not n.use and not L.consumers(n.id):
            if n.fstype == "LVM2_member":
                return _("LVM physical volume")
            kind = part_kind({"name": n.dev, "fstype": n.fstype, "parttype": n.parttype})
            return f"{n.label}  ·  {kind}" if n.label and n.label not in kind else kind
        if any(c.kind == "vg" for c in L.consumers(n.id)):
            vg = next(c for c in L.consumers(n.id) if c.kind == "vg")
            return _("LVM physical volume (%s)") % vg.name
        if n.use:
            if n.use["type"] == "swap":
                return _("Swap")
            return n.use.get("fstype", "btrfs")
        if L.luks_on(n.id):
            return _("Encrypted volume")
        return _("not used")

    @staticmethod
    def use_text(u):
        if not u:
            return ""
        return _("swap") if u["type"] == "swap" else u["mount"]

    def change_text(self, n):
        L = self.layout
        if n.delete:
            return _("delete")
        if n.kind == "part" and n.resize:
            return _("resize to %s") % size_bin(n.resize)
        if not n.existing:
            return _("create")
        if n.use:
            return _("format") if n.use.get("format", True) else _("keep data")
        if any(not c.existing for c in L.consumers(n.id)):
            return _("erase")
        return ""

    # -- akce --
    def selected_node(self):
        k = self.layout_sel
        return self.layout.nodes.get(k) if isinstance(k, str) else None

    def update_layout_buttons(self, btns):
        L, k = self.layout, self.layout_sel
        n = self.selected_node()
        is_free = isinstance(k, str) and k.startswith(("free:", "vgfree:"))
        btns["add"].set_sensitive(is_free or (n is not None and n.kind in ("disk", "vg")))
        btns["edit"].set_sensitive(n is not None and n.kind in ("part", "lv", "luks") and not n.delete
                                   and not (n.kind == "luks" and n.locked))
        btns["delete"].set_sensitive(n is not None and (n.kind in ("part", "lv") and not n.delete
                                                        or n.kind == "vg" and not n.existing
                                                        or n.kind == "luks" and not n.existing))
        if n is not None and (n.kind in ("part", "lv") and n.delete):
            btns["delete"].set_label(_("Keep"))
            btns["delete"].set_sensitive(True)
        else:
            btns["delete"].set_label(_("Delete"))
        btns["erase"].set_sensitive(n is not None and n.kind == "disk")
        btns["erase"].set_label(_("Keep Partitions") if n is not None and n.kind == "disk" and n.wipe
                                else _("Erase Disk"))
        btns["unlock"].set_sensitive(n is not None and n.kind == "luks" and n.locked)
        btns["vg"].set_sensitive(any(L.is_free_block(x) for x in L.nodes.values()))

    def layout_changed(self):
        GLib.idle_add(lambda: self.render() and False)

    def layout_reset(self):
        scan = self.layout.scan if self.layout else None
        self.layout = lay.Layout(scan) if scan else None
        if self.layout:
            self.layout.passphrase = self.s["luks1"] if self.s["luks1"] == self.s["luks2"] else ""
        self.layout_sel = None
        self.layout_changed()

    def apply_preset(self, disk, kind):
        L = self.layout
        if disk is None:
            return
        try:
            L.preset(disk, kind, ram=ram_bytes())
        except lay.PresetTooSmall as e:
            # plan zustal beze zmeny; srozumitelna hlaska misto neplatneho rozlozeni
            need = f"{-(-e.need // lay.GiB)} GiB"
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.OK, text=lay.message("preset_small", (e.disk, need), tr=_))
            dlg.run()
            dlg.destroy()
            return
        self.s["preset_disk"] = disk
        self.layout_sel = None
        self.layout_changed()

    def layout_action(self, key):
        L, k, n = self.layout, self.layout_sel, self.selected_node()
        if key == "add":
            if isinstance(k, str) and k.startswith("free:"):
                self.edit_dialog(None, disk=k[5:])
            elif isinstance(k, str) and k.startswith("vgfree:"):
                self.edit_dialog(None, vg=k[7:])
            elif n is not None and n.kind == "disk":
                self.edit_dialog(None, disk=n.dev)
            elif n is not None and n.kind == "vg":
                self.edit_dialog(None, vg=n.id)
        elif key == "edit" and n is not None:
            # LUKS radek upravuje svazek pod nim (vcetne sifrovani)
            base = L.nodes.get(n.on) if n.kind == "luks" and not n.existing else n
            self.edit_dialog(base)
        elif key == "delete" and n is not None:
            if n.kind in ("part", "lv") and n.delete:
                L.restore(n.id)
            elif n.kind == "luks" and not n.existing:
                L.encrypt(n.on, False)
            elif n.existing and n.kind in ("part", "lv") and not self.confirm(
                    _("Delete %s?") % n.dev, _("All data on it will be lost when you click Install.")):
                return
            else:
                L.remove(n.id)
            self.layout_changed()
        elif key == "erase" and n is not None and n.kind == "disk":
            if not n.wipe and n.existing and L.parts_of(n.dev) and not self.confirm(
                    _("Erase %s?") % n.dev,
                    _("All partitions on this disk will be deleted when you click Install.")):
                return
            L.wipe_disk(n.dev, not n.wipe)
            self.layout_changed()
        elif key == "vg":
            self.vg_dialog()
        elif key == "unlock" and n is not None:
            self.unlock_dialog(n)

    def confirm(self, title, text):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.NONE, text=title)
        dlg.format_secondary_text(text)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("Continue"), Gtk.ResponseType.OK)
        r = dlg.run()
        dlg.destroy()
        return r == Gtk.ResponseType.OK

    # -- dialog svazku (novy oddil/LV nebo uprava) --
    USE_KINDS = (("fs", "File system"), ("swap", "Swap"), ("esp", "EFI system partition"),
                 ("bios", "BIOS boot partition"), ("none", "Do not use (for example for LVM)"))

    def edit_dialog(self, node, disk=None, vg=None):
        L = self.layout
        new = node is None
        kind = "lv" if (vg or (node is not None and node.kind == "lv")) else "part"
        top = node
        luks = L.luks_on(node.id) if node is not None else None
        if luks is not None:
            top = luks
        use = dict(top.use) if top is not None and top.use else None
        dlg = Gtk.Dialog(title=_("New Volume") if new else _("Edit %s") % (node.dev or self.node_name(node)),
                         transient_for=self, modal=True)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("OK"), Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)
        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        box.pack_start(grid, True, True, 0)
        r = [0]

        def row(label, w):
            lab = Gtk.Label(label=label, xalign=1)
            lab.get_style_context().add_class("subtitle")
            grid.attach(lab, 0, r[0], 1, 1)
            grid.attach(w, 1, r[0], 1, 1)
