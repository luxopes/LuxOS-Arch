        def after_check(ok, _err):
            self.online = bool(ok)
            if ok:
                say(status, _("Connected."))
                self.update_nav()
            else:
                say(status, _("Still offline."))
                run_async(wifi_list, fill)

        def do_connect(_b):
            if not chosen["ssid"]:
                return
            spinner.start()
            say(status, _("Connecting to %s…") % chosen["ssid"])
            cmd = ["nmcli", "--wait", "25", "device", "wifi", "connect", chosen["ssid"]]
            if chosen["secure"]:
                cmd += ["password", pw.get_text()]

            def work():
                if FAKE:
                    return True
                return subprocess.run(cmd, capture_output=True, timeout=40).returncode == 0

            def done(ok, _err):
                spinner.stop()
                if ok:
                    recheck()
                else:
                    say(status, _("Could not connect. Check the password and try again."))
            run_async(work, done)
        connect.connect("clicked", do_connect)
        pw.connect("activate", do_connect)
        row2 = Gtk.Box(spacing=8)
        again = Gtk.Button(label=_("Try again"))
        again.connect("clicked", recheck)
        row2.pack_start(again, False, False, 0)
