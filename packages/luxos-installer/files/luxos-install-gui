    def load_layouts(self):
        if self.layouts is not None:
            return self.layouts
        common = [((layout, variant), _(name), f"{name} {_(name)} {layout} {variant}")
                  for name, layout, variant in KEYMAPS]
        seen = {k for k, _t, _h in common}
        country = self.s["locale"][3:5].lower()
        common.sort(key=lambda it: it[0][0] != country)
        rest, section = [], None
        try:
            with open("/usr/share/X11/xkb/rules/evdev.lst", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("!"):
                        section = line[1:].strip()
                        continue
                    m = re.match(r"\s+(\S+)\s+(.*)", line)
                    if not m:
                        continue
                    if section == "layout":
                        key, desc = (m.group(1), ""), m.group(2)
                    elif section == "variant" and ":" in m.group(2):
                        layout, desc = m.group(2).split(":", 1)
                        key, desc = (layout.strip(), m.group(1)), desc.strip()
                    else:
                        continue
                    if key not in seen:
                        seen.add(key)
                        rest.append((key, desc, f"{desc} {key[0]} {key[1]}"))
        except OSError:
            pass
        rest.sort(key=lambda it: it[1].lower())
        self.layouts = common + rest
        return self.layouts

