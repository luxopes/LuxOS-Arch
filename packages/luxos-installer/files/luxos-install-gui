    def tile(self, t, selected):
        """Dlazdice sablony: ikona, nazev, popis, aplikace; zatrzeni vpravo nahore."""
        ev = Gtk.EventBox()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        ctx = box.get_style_context()
        ctx.add_class("tile")
        if selected:
            ctx.add_class("selected")
        top = Gtk.Box(spacing=10)
        img = Gtk.Image.new_from_icon_name(t["icon"] or "applications-other", Gtk.IconSize.DIALOG)
        img.set_pixel_size(40)
        top.pack_start(img, False, False, 0)
        name = Gtk.Label(label=_(t["name"]), xalign=0, wrap=True, max_width_chars=22)
        name.get_style_context().add_class("card-title")
        top.pack_start(name, True, True, 0)
        check = Gtk.Image.new_from_icon_name("object-select-symbolic", Gtk.IconSize.BUTTON) if selected \
            else Gtk.Image(width_request=16)
        check.get_style_context().add_class("tile-check")
        check.set_valign(Gtk.Align.START)
        top.pack_end(check, False, False, 0)
        box.pack_start(top, False, False, 0)
        desc = Gtk.Label(label=_(t["description"]), xalign=0, wrap=True, max_width_chars=30, width_chars=24)
        desc.get_style_context().add_class("hint")
        box.pack_start(desc, False, False, 0)
        if t["apps"]:
            apps = Gtk.Label(label=t["apps"], xalign=0, wrap=True, max_width_chars=30)
            apps.get_style_context().add_class("tile-apps")
            box.pack_start(apps, False, False, 0)
        if t["download"]:
            box.pack_start(self.hint(_("about %s to download") % size_text(t["download"] * 1000 ** 2)),
                           False, False, 0)
        ev.add(box)
        ev.connect("button-press-event", lambda *_a: self.toggle_template(t["id"]))
        ev.connect("realize", lambda w: w.get_window().set_cursor(
            Gdk.Cursor.new_from_name(w.get_display(), "pointer")))
        return ev

    def toggle_template(self, tid):
        cur = self.s["templates"]
        if tid is None:
            self.s["templates"] = []
        elif tid in cur:
            self.s["templates"] = [x for x in cur if x != tid]
        else:
            order = [t["id"] for t in self.templates]
            self.s["templates"] = sorted(cur + [tid], key=order.index)
        GLib.idle_add(lambda: self.render() and False)

    def templates_text(self):
        names = [_(t["name"]) for t in self.templates if t["id"] in self.s["templates"]]
        return ", ".join(names) if names else _("Only the essentials")

