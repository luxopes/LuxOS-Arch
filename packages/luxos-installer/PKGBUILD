# Maintainer: LuxOS Team

pkgname=luxos-installer
pkgver=1.1.0
pkgrel=6
pkgdesc="LuxOS installer"
arch=(any)
url="https://github.com/luxos"
license=(MIT)
depends=(bash gum arch-install-scripts gptfdisk dosfstools e2fsprogs btrfs-progs cryptsetup parted
         util-linux curl luxos-drivers luxos-i18n luxos-account networkmanager)

package() {
    local f="$startdir/files"
    install -Dm755 -t "$pkgdir/usr/bin" "$f/luxos-install" "$f/luxos-install-gui"
    install -Dm755 "$f/setup-chroot.sh" "$pkgdir/usr/share/luxos/installer/setup-chroot.sh"
    install -Dm644 -t "$pkgdir/usr/share/luxos/installer" "$f/packages" "$f/install.conf.example" "$f/pacman.conf"
    install -Dm644 "$f/luxos-install.desktop" "$pkgdir/usr/share/applications/luxos-install.desktop"
}
