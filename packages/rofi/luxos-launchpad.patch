+/* LuxOS: bezi compositing manager (vlastnik vyberu _NET_WM_CM_S<obrazovka>)? */
+static gboolean luxos_compositor_running(void) {
+  char name[32];
+  int screen = xcb->screen_nbr < 0 ? 0 : xcb->screen_nbr;
+  snprintf(name, sizeof(name), "_NET_WM_CM_S%d", screen);
+  xcb_intern_atom_reply_t *atom = xcb_intern_atom_reply(
+      xcb->connection,
+      xcb_intern_atom(xcb->connection, 0, strlen(name), name), NULL);
+  if (atom == NULL) {
+    return TRUE;
+  }
+  xcb_get_selection_owner_reply_t *owner = xcb_get_selection_owner_reply(
+      xcb->connection, xcb_get_selection_owner(xcb->connection, atom->atom),
+      NULL);
+  gboolean running = owner == NULL || owner->owner != XCB_WINDOW_NONE;
+  free(owner);
+  free(atom);
+  return running;
+}
