+/** LuxOS: nacteny drun pro drun_mode_luxos_resort() */
+static DRunModePrivateData *luxos_drun_pd = NULL;
+
+gboolean drun_mode_luxos_resort(void) {
+  DRunModePrivateData *pd = luxos_drun_pd;
+  if (pd == NULL || pd->entry_list == NULL) {
+    return FALSE;
+  }
+  // Vse mimo historii (zaporny index = abecedne), pak index podle nove
+  // historie a stejne razeni jako pri nacteni
+  for (size_t i = 0; i < pd->cmd_list_length; i++) {
+    pd->entry_list[i].sort_index = -1;
+  }
+  get_apps_history(pd);
+  g_qsort_with_data(pd->entry_list, pd->cmd_list_length, sizeof(DRunModeEntry),
+                    drun_int_sort_list, NULL);
+  TICK_N("LuxOS resort done");
+  return TRUE;
+}
