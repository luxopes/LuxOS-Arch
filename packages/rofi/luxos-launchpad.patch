+/**
+ * LuxOS (-custom-resort): kb-custom-N (tlacitko razeni / Alt+N v Launchpadu)
+ * spusti "CMD N" (pripravi novou historii drun a ulozi volbu), drun se podle
+ * ni preradi, seznam se znovu vyfiltruje s puvodnim textem a vybrana je
+ * prvni polozka. Okno se nezavira (zadne bliknuti).
+ *
+ * @returns FALSE pri chybe (volajici pak pouzije -custom-exit)
+ */
+static gboolean luxos_resort(RofiViewState *state, unsigned int index) {
+#ifdef ENABLE_DRUN
+  gint argc = 0;
+  gchar **argv = NULL;
+  GError *error = NULL;
+  if (!g_shell_parse_argv(config.custom_resort, &argc, &argv, &error)) {
+    g_warning("custom-resort: %s", error->message);
+    g_error_free(error);
+    return FALSE;
+  }
+  gchar **args = g_new0(gchar *, argc + 2);
+  for (gint i = 0; i < argc; i++) {
+    args[i] = argv[i];
+  }
+  args[argc] = g_strdup_printf("%u", index + 1);
+  gint status = 0;
+  gboolean ok = g_spawn_sync(NULL, args, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL,
+                             NULL, NULL, &status, &error);
+  g_free(args[argc]);
+  g_free(args);
+  g_strfreev(argv);
+  if (!ok) {
+    g_warning("custom-resort: %s", error->message);
+    g_error_free(error);
+    return FALSE;
+  }
+  if (!WIFEXITED(status) || WEXITSTATUS(status) != 0 ||
+      !drun_mode_luxos_resort()) {
+    return FALSE;
+  }
+  // Zvyrazneni zvoleneho tlacitka: stav "selected", ostatni "alternate"
+  // (button-sort-X selected / alternate v motivu)
+  gchar *want = g_strdup_printf("kb-custom-%u", index + 1);
+  for (GList *iter = state->luxos_buttons; iter != NULL; iter = iter->next) {
+    textbox *t = (textbox *)iter->data;
+    const char *a = rofi_theme_get_string(WIDGET(t), "action", NULL);
+    if (a != NULL && g_str_has_prefix(a, "kb-custom-")) {
+      textbox_font(t, g_strcmp0(a, want) == 0 ? HIGHLIGHT : ALT);
+    }
+  }
+  g_free(want);
+  // Stejny hledany text, nove poradi, vybrana prvni polozka
+  state->selected_line = UINT32_MAX;
+  state->refilter = TRUE;
+  rofi_view_refilter_force(state);
+  if (state->list_view) {
+    listview_set_selected(state->list_view, 0);
+  }
+  rofi_view_queue_redraw();
+  return TRUE;
+#else
+  (void)state;
+  (void)index;
+  return FALSE;
+#endif
+}
