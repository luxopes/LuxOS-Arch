 #endif
 }
 
+gboolean rofi_view_luxos_swipe(RofiViewState *state, int dir) {
+  if (state == NULL || config.custom_resort == NULL) {
+    return FALSE;
+  }
+  int count = 0;
+  for (GList *iter = state->luxos_buttons; iter != NULL; iter = iter->next) {
+    const char *a = rofi_theme_get_string(WIDGET(iter->data), "action", NULL);
+    if (a != NULL && g_str_has_prefix(a, "kb-custom-")) {
+      count++;
+    }
+  }
+  if (count < 2) {
+    return FALSE;
+  }
+  if (state->luxos_sort < 0) {
+    // vychozi razeni od Launchpadu (1..N), jinak prvni
+    const char *env = g_getenv("LUXOS_ROFI_SORT");
+    int start = env != NULL ? atoi(env) : 1;
+    state->luxos_sort = (start >= 1 && start <= count) ? start - 1 : 0;
+  }
+  int next = ((state->luxos_sort + dir) % count + count) % count;
+  return luxos_resort(state, (unsigned int)next);
+}
