+void listview_luxos_scroll_page(listview *lv, int dir) {
+  if (lv == NULL) {
+    return;
+  }
+  if (listview_keep_rows(lv)) {
+    unsigned int rows = MAX(1u, lv->max_rows);
+    for (unsigned int i = 0; i < rows; i++) {
+      listview_scroll_rows(lv, dir);
+    }
+    return;
+  }
+  if (dir > 0) {
+    listview_nav_page_next(lv);
+  } else {
+    listview_nav_page_prev(lv);
+  }
+}
