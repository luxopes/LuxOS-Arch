# Maintainer: LuxOS Team
# rofi z Archu + volba -hover-no-scroll (Launchpad): s -hover-select a -scroll-method 1 najeti
# mysi jen zvyrazni dlazdici a pohled se nehne (puvodni rofi vyber vycentruje, pod mysi je pak
# jina dlazdice a mrizka "ujizdi"), kolecko posune pohled o radek i se zvyraznenim, po zmene
# hledaneho textu je vybrana nejlepsi shoda a pri otevreni se nevybira dlazdice pod stojici mysi.
# Volba -custom-exit: vlastni klavesy / tlacitka razeni Launchpadu ukonci rofi s kodem 10+ i v
# rezimu drun/combi. Bez compositoru je pozadim okna snimek obrazovky (rohy zaobleneho panelu
# jinak cerne). S compositorem vizual s alfou podle XRender (ve VM s llvmpipe byl vybrany vizual
# hloubky 32 bez alfy a rohy byly cerne i se zapnutym compositorem).
# Repozitar [luxos] je v /etc/lux/lux.conf pred [extra], takze ma tento balik prednost; pri nove
# verzi v Archu zvysit pkgver (a sha256sums), pkgrel nechat X.1.
# Puvodni PKGBUILD Archu (udrzovatele Morten Linderud, Robin Candau) je v PKGBUILD.arch.

pkgname=rofi
pkgver=2.0.0
pkgrel=1.2
pkgdesc="A window switcher, application launcher and dmenu replacement (LuxOS: hover without scrolling)"
url="https://davatorium.github.io/rofi"
arch=('x86_64')
license=('MIT')
depends=('bash' 'cairo' 'gdk-pixbuf2' 'glib2' 'glibc' 'hicolor-icon-theme' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'pango' 'startup-notification' 'wayland' 'xcb-imdkit' 'xcb-util' 'xcb-util-cursor' 'xcb-util-keysyms' 'xcb-util-wm')
makedepends=('check' 'git' 'meson' 'pandoc' 'wayland-protocols')
provides=('rofi-wayland')
replaces=('rofi-wayland')
source=("git+https://github.com/davatorium/rofi.git#tag=${pkgver}"
        'git+https://github.com/sardemff7/libgwater.git'
        'git+https://github.com/sardemff7/libnkutils.git'
        'fix_xfce4-terminal_binary_name.patch'
        'hover-no-scroll.patch'
        'luxos-launchpad.patch'
        'argb-visual.patch')
sha256sums=('3ad746f25b373bfa2e49db20c5009ffd4d959dd113e47281e98e7132f7314ac8'
            'SKIP'
            'SKIP'
            '0cd6f1360580f49647ceb7d169ab015f4998e778fd750ce3ad2e861f333824e3'
            '0745f3af7de9178a277a0af83f98a795abba5b4f1062befea0e368fae66dde91'
            'dd23157c86bbcf7af85b993db391127aecad8c3b5afac547c08a2c250f6ea58b'
            'f2493d689150893db1fd3ca1f72b0fb00f2ed5b3529c485729430f349ec8d54e')

prepare() {
	cd "${pkgname}"

	git submodule init
	git config submodule.subprojects/libgwater.url "${srcdir}/libgwater"
	git config submodule.subprojects/libnkutils.url "${srcdir}/libnkutils"
	git -c protocol.file.allow=always submodule update

	# xfce4-terminal.wrapper is a Debian specific script that Arch does not provide
	patch -Np1 -i "${srcdir}/fix_xfce4-terminal_binary_name.patch"
	# LuxOS: -hover-no-scroll
	patch -Np1 -i "${srcdir}/hover-no-scroll.patch"
	# LuxOS: -custom-exit (razeni Launchpadu), bez compositoru snimek jako pozadi
	patch -Np1 -i "${srcdir}/luxos-launchpad.patch"
	# LuxOS: 32bitovy vizual s alfou podle XRender (Xorg s GLX nabizi i vizualy hloubky 32 bez alfy;
	# compositor pak okno kreslil nepruhledne a rohy Launchpadu byly cerne)
	patch -Np1 -i "${srcdir}/argb-visual.patch"
}

build() {
	arch-meson "${pkgname}" build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "${pkgdir}"

	cd "${pkgname}"
	install -Dm 644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
	install -Dm 755 Examples/*.sh -t "${pkgdir}/usr/share/doc/${pkgname}/examples"
}
