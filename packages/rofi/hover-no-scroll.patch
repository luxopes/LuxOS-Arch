+  } else if (listview_keep_rows(lv)) {
+    offset = scroll_keep_rows(lv);
   } else if (lv->pack_direction == ROFI_ORIENTATION_VERTICAL) {
     offset = scroll_continious_elements(lv);
   } else {
@@ -722,6 +795,11 @@ listview_trigger_action(widget *wid, MouseBindingListviewAction action,
                         G_GNUC_UNUSED gint x, G_GNUC_UNUSED gint y,
                         G_GNUC_UNUSED void *user_data) {
   listview *lv = (listview *)wid;
+  if (listview_keep_rows(lv) &&
