diff --git a/source/widgets/listview.c b/source/widgets/listview.c
index 03e94d3..9838a45 100644
--- a/source/widgets/listview.c
+++ b/source/widgets/listview.c
@@ -348,6 +348,77 @@ static unsigned int scroll_continious_rows(listview *lv) {
   return offset;
 }
 
+// LuxOS (-hover-no-scroll): mrizka po radcich, pohled se posune jen kdyz by
+// vyber byl mimo nej (a jen o nutny pocet radku). Najeti mysi tak jen
+// zvyrazni dlazdici - pohled pod ukazatelem se nehne a nevznikne smycka
+// "vyber se vycentruje, pod mysi je jina dlazdice, vyber se posune".
+static unsigned int scroll_keep_rows(listview *lv) {
+  unsigned int cols = MAX(1u, lv->menu_columns);
+  unsigned int rows = MAX(1u, lv->max_rows);
+  unsigned int req_rows = (lv->req_elements + cols - 1) / cols;
+  unsigned int first = lv->cur_page / cols;
+  unsigned int selected = lv->selected / cols;
+  if (selected < first) {
+    first = selected;
+  } else if (selected >= first + rows) {
+    first = selected - rows + 1;
+  }
+  // Na konci seznamu nenechavat prazdne radky (po filtrovani apod.)
+  if (req_rows <= rows) {
+    first = 0;
+  } else if (first > req_rows - rows) {
+    first = req_rows - rows;
+  }
+  unsigned int offset = first * cols;
+  if (offset != lv->cur_page) {
+    lv->cur_page = offset;
+    lv->rchanged = TRUE;
+  }
+  return offset;
+}
+
+// LuxOS (-hover-no-scroll): kolecko posune pohled o radek a vyber s nim, takze
+// zvyraznena zustava dlazdice na stejnem miste (pod ukazatelem mysi).
+static void listview_scroll_rows(listview *lv, int dir) {
+  unsigned int cols = MAX(1u, lv->menu_columns);
+  unsigned int rows = MAX(1u, lv->max_rows);
+  unsigned int req_rows = (lv->req_elements + cols - 1) / cols;
+  unsigned int first = lv->cur_page / cols;
+  if (lv->req_elements == 0 || req_rows <= rows) {
+    return;
+  }
+  if (dir > 0) {
+    if (first >= req_rows - rows) {
+      return;
+    }
+    lv->cur_page = (first + 1) * cols;
+    lv->selected = MIN(lv->req_elements - 1, lv->selected + cols);
+  } else {
+    if (first == 0) {
+      return;
+    }
+    lv->cur_page = (first - 1) * cols;
+    lv->selected = lv->selected >= cols ? lv->selected - cols : 0;
+  }
+  // Vyber musi zustat v novem pohledu (posledni radek muze byt kratsi)
+  if (lv->selected < lv->cur_page) {
+    lv->selected = lv->cur_page;
+  } else if (lv->selected >= lv->cur_page + rows * cols) {
+    lv->selected = MIN(lv->req_elements - 1, lv->cur_page + rows * cols - 1);
+  }
+  lv->rchanged = TRUE;
+  lv->barview.direction = LEFT_TO_RIGHT;
+  if (lv->sc_callback) {
+    lv->sc_callback(lv, lv->selected, lv->sc_udata);
+  }
+  widget_queue_redraw(WIDGET(lv));
+}
+
+static gboolean listview_keep_rows(listview *lv) {
+  return config.hover_no_scroll && lv->scroll_type != LISTVIEW_SCROLL_PER_PAGE &&
+         lv->pack_direction != ROFI_ORIENTATION_VERTICAL && !lv->reverse;
+}
+
