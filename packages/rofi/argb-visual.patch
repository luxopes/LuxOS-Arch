+/* LuxOS: ma vizual 32 bitu v XRender kanal alfa? Xorg s GLX (napr. llvmpipe ve VM) nabizi i vizualy
+ * hloubky 32 bez alfy; s takovym compositor (xfwm4) kresli okno nepruhledne a zaoblene rohy
+ * Launchpadu jsou cerne. Bez rozsireni Render (NULL) se vezme kazdy vizual jako dosud. */
+static gboolean luxos_visual_has_alpha(xcb_render_query_pict_formats_reply_t *r,
+                                       xcb_visualid_t vid) {
+  if (r == NULL) {
+    return TRUE;
+  }
+  xcb_render_pictformat_t fmt = 0;
+  for (xcb_render_pictscreen_iterator_t si =
+           xcb_render_query_pict_formats_screens_iterator(r);
+       si.rem && !fmt; xcb_render_pictscreen_next(&si)) {
+    for (xcb_render_pictdepth_iterator_t di =
+             xcb_render_pictscreen_depths_iterator(si.data);
+         di.rem && !fmt; xcb_render_pictdepth_next(&di)) {
+      for (xcb_render_pictvisual_iterator_t vi =
+               xcb_render_pictdepth_visuals_iterator(di.data);
+           vi.rem; xcb_render_pictvisual_next(&vi)) {
+        if (vi.data->visual == vid) {
+          fmt = vi.data->format;
+          break;
+        }
+      }
+    }
+  }
+  for (xcb_render_pictforminfo_iterator_t fi =
+           xcb_render_query_pict_formats_formats_iterator(r);
+       fmt && fi.rem; xcb_render_pictforminfo_next(&fi)) {
+    if (fi.data->id == fmt) {
+      return fi.data->type == XCB_RENDER_PICT_TYPE_DIRECT &&
+             fi.data->direct.alpha_mask != 0;
+    }
+  }
+  return FALSE;
+}
