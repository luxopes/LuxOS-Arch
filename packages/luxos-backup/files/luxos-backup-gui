class AddDiskDialog(Gtk.Dialog):
    """Vyber externiho nebo sitoveho disku; volitelne sifrovani pri priprave."""

    def __init__(self, parent, preselect=None):
        super().__init__(title=_("Add Backup Disk"), transient_for=parent, modal=True, use_header_bar=True)
        self.set_default_size(520, -1)
        self.get_header_bar().set_show_close_button(True)
        self.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
        self.ok = self.add_button(_("Use Disk"), Gtk.ResponseType.OK)
        self.ok.get_style_context().add_class("suggested-action")
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)

        lab = Gtk.Label(label=_("External disks"), xalign=0)
        lab.get_style_context().add_class("group-title")
        box.pack_start(lab, False, False, 0)
        self.disks = core.external_disks()
        self.group = Group()
        box.pack_start(self.group, False, False, 0)
        first = None
        self.radios = []
        for d in self.disks:
            rb = Gtk.RadioButton.new_from_widget(first)
            first = first or rb
            fs = d["inner_fstype"] or d["fstype"] or _("empty")
            hint = f"{human(d['size'])} · {fs}" + (" · " + _("encrypted") if d["encrypted"] else "")
            self.group.row(d["label"] or d["model"] or d["path"], rb, hint)
            rb.set_active(d["path"] == preselect)
            self.radios.append((rb, d))
        if not self.disks:
            self.group.row(_("No external disk is connected."), hint=_("Connect a USB disk, or use a network disk."))

        lab = Gtk.Label(label=_("Network disk"), xalign=0)
        lab.get_style_context().add_class("group-title")
        box.pack_start(lab, False, False, 0)
        net = Group()
        box.pack_start(net, False, False, 0)
        self.net_radio = Gtk.RadioButton.new_from_widget(first)
        self.address = Gtk.Entry(placeholder_text="sftp://user@server/folder  ·  smb://user@server/share",
                                 width_chars=34)
        self.address.connect("changed", lambda *_a: self.net_radio.set_active(bool(self.address.get_text())))
        self.net_pw = Gtk.Entry(visibility=False, placeholder_text=_("Password"),
                                input_purpose=Gtk.InputPurpose.PASSWORD)
        self.net_pw.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.net_pw.connect("icon-press", lambda e, *_a: e.set_visibility(not e.get_visibility()))
        addr_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        addr_box.pack_start(self.address, False, False, 0)
        addr_box.pack_start(self.net_pw, False, False, 0)
        net.row(_("Server address"), self.net_radio,
                _("The password is kept in the keyring. A shared folder (SMB) gets one backup image file."))
        net.pack_start(addr_box, False, False, 0)
        addr_box.set_margin_start(14)
        addr_box.set_margin_end(14)
        addr_box.set_margin_bottom(10)
        if not self.disks:
            self.net_radio.set_active(True)

        enc = Group()
        box.pack_start(enc, False, False, 8)
        self.encrypt = Gtk.Switch()
        enc.row(_("Encrypt backups"), self.encrypt,
                _("The disk is erased and protected with a password. Without the password nobody can "
                  "read the backups – keep it safe."))
        self.pw1 = Gtk.Entry(visibility=False, placeholder_text=_("Password for the backup disk"))
        self.pw2 = Gtk.Entry(visibility=False, placeholder_text=_("Repeat the password"))
        self.pw_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_start=14, margin_end=14,
                              margin_bottom=10)
        self.pw_box.pack_start(self.pw1, False, False, 0)
        self.pw_box.pack_start(self.pw2, False, False, 0)
        enc.pack_start(self.pw_box, False, False, 0)
        self.encrypt.connect("notify::active", lambda *_a: self.pw_box.set_visible(self.encrypt.get_active()))
        self.show_all()
        self.pw_box.set_visible(False)

    def choice(self):
        """("local", disk) | ("net", adresa, heslo) a heslo sifrovani (nebo None, nebo False = nesouhlasi)."""
        pw = None
        if self.encrypt.get_active():
            pw = self.pw1.get_text()
            if not pw or pw != self.pw2.get_text():
                return None, False
        if self.net_radio.get_active():
            return ("net", self.address.get_text().strip(), self.net_pw.get_text()), pw
        for rb, d in self.radios:
            if rb.get_active():
                return ("local", d), pw
        return None, pw


