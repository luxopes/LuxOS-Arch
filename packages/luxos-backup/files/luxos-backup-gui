def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000.0
    return str(n)


def when_text(t):
    """'Dnes 14:00', 'Vcera 9:00' nebo datum."""
    if not t:
        return _("Never")
    lt = time.localtime(t)
    today = time.localtime()
    hm = time.strftime("%H:%M", lt)
    if lt[:3] == today[:3]:
        return _("Today %s") % hm
    if lt[:3] == time.localtime(time.time() - 86400)[:3]:
        return _("Yesterday %s") % hm
    return time.strftime("%Y-%m-%d %H:%M", lt)


def day_text(t):
    lt = time.localtime(t)
    if lt[:3] == time.localtime()[:3]:
        return _("Today")
    if lt[:3] == time.localtime(time.time() - 86400)[:3]:
        return _("Yesterday")
    return time.strftime("%Y-%m-%d", lt)


def in_thread(work, done):
    """work() v jinem vlakne, done(vysledek, chyba) zpet v hlavnim."""
    def go():
        try:
            res, err = work(), None
        except Exception as e:      # noqa: BLE001 - chybu ukaze okno
            res, err = None, e
        GLib.idle_add(lambda: done(res, err) and False)
    threading.Thread(target=go, daemon=True).start()


def message(parent, title, text, kind=Gtk.MessageType.INFO):
    d = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=kind, buttons=Gtk.ButtonsType.OK,
                          text=title)
    d.format_secondary_text(text)
    d.run()
    d.destroy()


def confirm(parent, title, text, ok_label, danger=False):
    d = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
                          buttons=Gtk.ButtonsType.NONE, text=title)
    d.format_secondary_text(text)
    d.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
    b = d.add_button(ok_label, Gtk.ResponseType.OK)
    b.get_style_context().add_class("destructive-action" if danger else "suggested-action")
    d.set_default_response(Gtk.ResponseType.CANCEL)
    r = d.run()
    d.destroy()
    return r == Gtk.ResponseType.OK


class Group(Gtk.Box):
    """Skupina radku v ramecku (jako v ostatnich aplikacich LuxOS)."""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.get_style_context().add_class("group")

    def clear(self):
        for c in self.get_children():
            self.remove(c)

    def row(self, title, widget=None, hint=None, extra=None):
        box = Gtk.Box(spacing=12)
        box.get_style_context().add_class("row")
        if self.get_children():
            box.get_style_context().add_class("row-sep")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        head = Gtk.Box(spacing=6)
        lab = Gtk.Label(label=title, xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
        head.pack_start(lab, False, False, 0)
        if extra:
            head.pack_start(extra, False, False, 0)
        text.pack_start(head, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0, wrap=True)
            h.get_style_context().add_class("hint")
            text.pack_start(h, False, False, 0)
        box.pack_start(text, True, True, 0)
        if widget:
            widget.set_valign(Gtk.Align.CENTER)
            box.pack_end(widget, False, False, 0)
        self.pack_start(box, False, False, 0)
        box.show_all()
        return box


def section(page, title):
    lab = Gtk.Label(label=title, xalign=0)
    lab.get_style_context().add_class("group-title")
    page.pack_start(lab, False, False, 0)
    g = Group()
    page.pack_start(g, False, False, 0)
    return g


