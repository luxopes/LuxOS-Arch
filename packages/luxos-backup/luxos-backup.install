# LuxOS Zalohy: uzivatelsky casovac zapnout pro vsechny uzivatele (i v chrootu instalatoru).
# Dokud uzivatel nepridal disk zaloh, sluzba hned skonci (nic nestoji).

post_install() {
    systemctl --global enable luxos-backup.timer >/dev/null 2>&1 || true
    udevadm control --reload >/dev/null 2>&1 || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl --global disable luxos-backup.timer >/dev/null 2>&1 || true
}
