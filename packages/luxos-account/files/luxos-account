    def password_changed(self):
        new, again = self.pw_new.get_text(), self.pw_again.get_text()
        level, text = accgtk.password_strength(new)
        self.pw_bar.set_value(level)
        self.pw_hint.set_text(text)
        ok = not acc.password_problem(new) and new == again
        self.pw_btn.set_sensitive(ok)
        if again and new != again and len(again) >= len(new):
            self.pw_btn.set_tooltip_text(_("The new passwords do not match."))
        else:
            self.pw_btn.set_tooltip_text(None)

    def save_password(self):
        cur, new, again = self.pw_current.get_text(), self.pw_new.get_text(), self.pw_again.get_text()
        if new != again:
            self.say(self.pw_status, _("The new passwords do not match."), "error")
            return
        if not self.pw_btn.get_sensitive():
            return
        self.pw_btn.set_sensitive(False)
        self.say(self.pw_status, _("Changing the password…"))

        def done(_res, err):
            self.password_changed()
            if err:
                self.failed(self.pw_status, err)
                return
            for e in (self.pw_current, self.pw_new, self.pw_again):
                e.set_text("")
            self.say(self.pw_status, _("The password was changed and other sessions were signed out."), "good")
        accgtk.run_async(lambda: acc.change_password(cur, new), done)

