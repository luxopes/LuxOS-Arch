        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, width_request=210)
        side.get_style_context().add_class("side")
        bar = Gtk.StackSidebar(stack=self.pages, vexpand=True)
        side.pack_start(bar, True, True, 0)
        foot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=10)
        web = Gtk.Button(label=_("Open on the Web"), tooltip_text=acc.SETTINGS_URL)
        web.connect("clicked", lambda b: accgtk.open_url(b, acc.SETTINGS_URL))
