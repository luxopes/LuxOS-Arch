    def choose_export(self):
        dlg = Gtk.FileChooserDialog(title=_("Export Your Data"), transient_for=self,
                                    action=Gtk.FileChooserAction.SAVE)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("Save"), Gtk.ResponseType.ACCEPT)
        dlg.set_do_overwrite_confirmation(True)
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or GLib.get_home_dir()
        dlg.set_current_folder(folder)
        dlg.set_current_name("luxai-account-%s.json" % time.strftime("%Y-%m-%d"))
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.ACCEPT else None
        dlg.destroy()
        if path:
            self.export_to(path)

    def export_to(self, path):
        self.export_btn.set_sensitive(False)
        self.export_spin.show()
        self.export_spin.start()
        self.say(self.export_status, _("Exporting…"))

        def progress(i, n):
            GLib.idle_add(lambda: self.say(self.export_status, _("Downloading chat %d of %d…") % (i + 1, n)) and False)

        def done(res, err):
            self.export_btn.set_sensitive(True)
            self.export_spin.stop()
            self.export_spin.hide()
            if err:
                self.failed(self.export_status, err)
                return
            if res["history"]:
                text = _("Exported to %s (web chats: %d).") % (res["path"], res["conversations"])
            else:
                text = _("Exported to %s. The web chat history could not be included.") \
                    % res["path"]
            self.say(self.export_status, text, "good")
            self.export_status.web.set_visible(not res["history"])
        accgtk.run_async(lambda: acc.export_data(path, progress=progress), done)

    def confirm_delete(self):
        """Silne potvrzeni: napsat e-mail uctu a zaskrtnout, ze to nejde vratit. Pak se otevre
        rozepsany e-mail podpore (nic se neodesle samo)."""
        email = self.user.get("email", "")
        dlg = Gtk.Dialog(title=_("Delete LuxAI Account"), transient_for=self, modal=True, use_header_bar=True)
        dlg.get_header_bar().set_show_close_button(True)   # horni lista s krizkem, tlacitka dole
        dlg.set_default_size(480, -1)
        area = dlg.get_content_area()
        area.set_spacing(10)
        area.set_border_width(18)
        warn = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        warn.set_markup("<b>%s</b>" % GLib.markup_escape_text(_("Deleting the account cannot be undone.")))
        area.pack_start(warn, False, False, 0)
        area.pack_start(Gtk.Label(label=_("All chats, settings and the usage history of %s will be deleted. "
                                          "Export your data first if you want to keep it.") % email,
                                  xalign=0, wrap=True, max_width_chars=60), False, False, 0)
        area.pack_start(Gtk.Label(label=_("Type your e-mail address to confirm:"), xalign=0), False, False, 0)
        entry = Gtk.Entry(placeholder_text=email)
        area.pack_start(entry, False, False, 0)
        sure = Gtk.CheckButton(label=_("I understand that my LuxAI account and data will be deleted"))
        area.pack_start(sure, False, False, 0)
        hint = Gtk.Label(label=_("Your e-mail program opens with a prepared request to %s. "
                                 "The account is deleted after you send it.") % acc.SUPPORT_EMAIL,
                         xalign=0, wrap=True, max_width_chars=60)
        hint.get_style_context().add_class("dim")
        area.pack_start(hint, False, False, 0)
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END, margin_top=6)
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda _b: dlg.response(Gtk.ResponseType.CANCEL))
        go = Gtk.Button(label=_("Write Deletion Request"), sensitive=False)
        go.get_style_context().add_class("destructive-action")
        go.connect("clicked", lambda _b: dlg.response(Gtk.ResponseType.ACCEPT))
        buttons.pack_start(cancel, False, False, 0)
        buttons.pack_start(go, False, False, 0)
        area.pack_start(buttons, False, False, 0)

        def update(*_a):
            go.set_sensitive(bool(email) and entry.get_text().strip().lower() == email.lower() and sure.get_active())
        entry.connect("changed", update)
        sure.connect("toggled", update)
        dlg.delete_entry, dlg.delete_sure, dlg.delete_go = entry, sure, go   # pro testy
        self.delete_dialog = dlg

        def response(d, resp):
            if resp == Gtk.ResponseType.ACCEPT and go.get_sensitive():
                accgtk.open_url(self, acc.deletion_mailto(self.user))
                self.say(self.delete_status, _("Your e-mail program opened with the deletion request. "
                                               "Send it to finish."), "good")
            d.destroy()
            self.delete_dialog = None
        dlg.connect("response", response)
        dlg.show_all()
        return dlg

    # -- aktualizace po /api/me nebo po ulozeni zmeny (bez prestavby stranek) --
    def update_user(self, user):
        if user:
            self.user = dict(user)
        u = self.user
        name = u.get("displayName") or u.get("username") or u.get("email", "")
        sub = " · ".join(x for x in ("@" + u["username"] if u.get("username") else "", u.get("email", "")) if x)
        for n, e in self.ident:
            n.set_text(name)
            e.set_text(sub)
        self.fill_usage(u.get("usage") or {})
        self._filling = True
        if u.get("username") is not None:
            self.username.set_text(u.get("username") or "")
        self.username_btn.set_sensitive(False)
        self._filling = False
        self.email_label.set_text(u.get("email", ""))
        settings = u.get("settings") or {}
        self.style.set_active_id(settings.get("aiResponseStyle") or "balanced")
        self.style_changed(self.style)
        self.set_theme_switch(settings.get("theme"))

    def profile_loaded(self, data, err):
        if err and err.code == "signed_out":
            self.show_login(_("Your session has expired. Please sign in again."))
        elif data and data.get("user") and getattr(self, "outer", None) and self.outer.get_parent():
            self.update_user(data["user"])
        elif data:
            self.show_profile(acc.load() or {}, data)
        return False

    def sign_out(self, _b):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.OK_CANCEL, text=_("Sign out of LuxAI?"))
        dlg.format_secondary_text(_("LuxAI, Lux Code and LSL IDE will stop using this account on this computer."))
        if dlg.run() == Gtk.ResponseType.OK:
            run_async(acc.logout, lambda *_a: self.show_login() or False)
        dlg.destroy()


def main():
    login_mode = len(sys.argv) > 1 and sys.argv[1] in ("login", "register")
    if login_mode and acc.load():
        return 0
    GLib.set_prgname("luxos-account")
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = AccountWindow(login_mode, "register" if sys.argv[1:2] == ["register"] else "password")
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0 if (not login_mode or acc.load()) else 1


if __name__ == "__main__":
    sys.exit(main())
