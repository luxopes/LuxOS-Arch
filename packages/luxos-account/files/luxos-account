        outer.pack_start(self.pages, True, True, 0)
        self.ident = []          # (jmeno, podtitulek) - aktualizuji se po zmene uzivatelskeho jmena
        for name, title, build in (("overview", _("Overview"), self.page_overview),
                                   ("profile", _("Profile"), self.page_profile),
                                   ("security", _("Password & Security"), self.page_security),
                                   ("preferences", _("Preferences"), self.page_preferences),
                                   ("privacy", _("Privacy & Data"), self.page_privacy)):
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=22)
            heading = Gtk.Label(label=title, xalign=0)
            heading.get_style_context().add_class("page-title")
            box.pack_start(heading, False, False, 0)
            build(box)
            sw.add(box)
            self.pages.add_titled(sw, name, title)
        self.replace(outer)
        if keep:
            self.pages.set_visible_child_name(keep)
        self.update_user(self.user)

    def card(self, box, title, text=None, danger=False):
        c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        c.get_style_context().add_class("card")
        if danger:
            c.get_style_context().add_class("danger-card")
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("card-title")
        c.pack_start(t, False, False, 0)
        if text:
            d = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=70)
            d.get_style_context().add_class("dim")
            c.pack_start(d, False, False, 0)
        box.pack_start(c, False, False, 0)
        return c

    def status_row(self, card):
        """Radek hlasky karty + (skryte) tlacitko Otevrit na webu pro zmeny, ktere server z aplikace nepovoli."""
        row = Gtk.Box(spacing=8)
        lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        lbl.set_no_show_all(True)
        web = Gtk.Button(label=_("Open on the Web"))
        web.get_style_context().add_class("link")
        web.connect("clicked", lambda b: accgtk.open_url(b, acc.SETTINGS_URL))
        web.set_no_show_all(True)
        row.pack_start(lbl, True, True, 0)
        row.pack_end(web, False, False, 0)
        card.pack_start(row, False, False, 0)
        lbl.web = web
        return lbl

    def say(self, lbl, text, kind="dim"):
        ctx = lbl.get_style_context()
        for c in ("error", "good", "dim"):
            ctx.remove_class(c)
        ctx.add_class(kind)
        lbl.set_text(text)
        lbl.set_visible(bool(text))
        lbl.web.set_visible(False)

    def failed(self, lbl, err):
        """Chyba spravy uctu: vyprsela session -> prihlaseni, 403 -> tlacitko na web, jinak hlaska."""
        if err.code == "signed_out":
            self.show_login(_("Your session has expired. Please sign in again."))
            return
        self.say(lbl, acc.account_error_text(err, _), "error")
        lbl.web.set_visible(acc.web_only(err))

    def identity(self, box, size=72):
        top = Gtk.Box(spacing=16)
        name = self.user.get("displayName") or self.user.get("username") or self.user.get("email", "")
        if luxos_avatar:
            avatar = self.photo(size, name)
        else:
            avatar = Gtk.Label(label=(name[:1] or "?").upper())
            avatar.get_style_context().add_class("avatar")
        top.pack_start(avatar, False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, spacing=2)
        n = Gtk.Label(xalign=0, ellipsize=3)
        n.get_style_context().add_class("name")
        e = Gtk.Label(xalign=0, ellipsize=3, selectable=True)
        e.get_style_context().add_class("dim")
        texts.pack_start(n, False, False, 0)
        texts.pack_start(e, False, False, 0)
        top.pack_start(texts, True, True, 0)
        box.pack_start(top, False, False, 0)
        self.ident.append((n, e))

    # -- Prehled: kdo jsem, spotreba AI za mesic (GET /api/me) --
    def page_overview(self, box):
        self.identity(box)
        self.usage_card = self.card(box, _("AI usage this month"))
        self.usage_body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.usage_card.pack_start(self.usage_body, False, False, 0)
        apps = self.card(box, _("Used by"))
        apps.pack_start(Gtk.Label(label="LuxAI · Lux Code · LSL IDE", xalign=0), False, False, 0)

    def fill_usage(self, usage):
        for c in self.usage_body.get_children():
            self.usage_body.remove(c)
        b = self.usage_body
        if usage.get("unlimited"):
            b.pack_start(Gtk.Label(label=_("Unlimited"), xalign=0), False, False, 0)
        elif usage:
            for label, desc, used, limit in (
                    ("Flash", _("smarter, can see images"), usage.get("fastTokens", 0), usage.get("fastLimit", 0)),
                    ("Lite", _("faster, larger limit"), usage.get("liteTokens", 0), usage.get("liteLimit", 0))):
                used, limit = int(used or 0), int(limit or 0)
                row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                head = Gtk.Box(spacing=8)
                t = Gtk.Label(label=label, xalign=0)
                t.get_style_context().add_class("card-title")
                head.pack_start(t, False, False, 0)
                d = Gtk.Label(label=desc, xalign=0)
                d.get_style_context().add_class("dim")
                head.pack_start(d, False, False, 0)
                pct = min(100, int(used * 100 / limit + 0.5)) if limit else 0   # jako Math.round na webu
                p = Gtk.Label(label=f"{pct} %")
                p.get_style_context().add_class("pct" if pct < 90 else "error")
                head.pack_end(p, False, False, 0)
                row.pack_start(head, False, False, 0)
                bar = Gtk.LevelBar(min_value=0, max_value=max(limit, 1), value=min(used, max(limit, 1)))
                bar.get_style_context().add_class("usage")
                row.pack_start(bar, False, False, 0)
                row.pack_start(Gtk.Label(label=_("%s of %s tokens") % (group(used), group(limit)), xalign=0),
                               False, False, 0)
                b.pack_start(row, False, False, 0)
            when = acc.usage_reset(usage)
            days = acc.days_until(when)
            reset = Gtk.Label(label=_("The limits reset on %s (in %d days).") % (time.strftime("%x", when), days),
                              xalign=0, wrap=True)
            reset.get_style_context().add_class("dim")
            b.pack_start(reset, False, False, 0)
        else:
            b.pack_start(Gtk.Label(label=_("Loading…"), xalign=0), False, False, 0)
        b.show_all()

