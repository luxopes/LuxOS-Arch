def run_async(work, done):
    def target():
        try:
            res, err = work(), None
        except acc.AccountError as e:
            res, err = None, e
        GLib.idle_add(done, res, err)
    threading.Thread(target=target, daemon=True).start()


class PhotoButton(Gtk.Button):
    """Profilova fotka uctu v pocitaci (jako na prihlasovaci obrazovce); klik otevre Profilovou fotku."""

    def __init__(self, size, name):
        super().__init__(relief=Gtk.ReliefStyle.NONE, tooltip_text=_("Change Picture"))
        self.get_style_context().add_class("photo")
        self.size, self.name, self.pix, self.stamp = size, name, None, None
        area = Gtk.DrawingArea()
        area.set_size_request(size, size)
        area.connect("draw", self.draw)
        self.add(area)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("clicked", lambda _b: open_picture())
        self.reload()

    def reload(self):
        path = luxos_avatar.current() if luxos_avatar else None
        try:
            stamp = (path, os.stat(path).st_mtime_ns) if path else None
        except OSError:
            stamp = None
        if stamp == self.stamp and self.stamp is not None:
            return
        self.stamp, self.pix = stamp, None
        if path:
            try:
                self.pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, self.size * 2, self.size * 2, True)
            except GLib.Error:
                self.pix = None
        self.queue_draw()

    def draw(self, w, cr):
        d = min(w.get_allocated_width(), w.get_allocated_height())
        cx = cy = d / 2
        cr.arc(cx, cy, d / 2, 0, 2 * math.pi)
        cr.clip()
        if self.pix:
            s = d / min(self.pix.get_width(), self.pix.get_height())
            cr.translate(cx, cy)
            cr.scale(s, s)
            Gdk.cairo_set_source_pixbuf(cr, self.pix, -self.pix.get_width() / 2, -self.pix.get_height() / 2)
            cr.paint()
            return False
        g = cairo.LinearGradient(0, 0, d, d)
        g.add_color_stop_rgb(0, 0.24, 0.48, 1.0)
        g.add_color_stop_rgb(1, 0.55, 0.30, 1.0)
        cr.set_source(g)
        cr.paint()
        cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(d * 0.42)
        t = (self.name.strip()[:1] or "?").upper()
        ext = cr.text_extents(t)
        cr.move_to(cx - ext.width / 2 - ext.x_bearing, cy - ext.height / 2 - ext.y_bearing)
        cr.set_source_rgb(1, 1, 1)
        cr.show_text(t)
        return False


def open_picture():
    try:
        subprocess.Popen(["luxos-profile-picture"])
    except OSError:
        pass


def computer_name():
    """Jmeno uctu v pocitaci (GECOS), jinak prihlasovaci jmeno."""
    name = GLib.get_real_name()
    return name if name and name != "Unknown" else GLib.get_user_name()


class AccountWindow(Gtk.Window):
    def __init__(self, login_mode, start_mode="password"):
        super().__init__(title=_("LuxAI Account"))
        self.login_mode = login_mode
        self.start_mode = start_mode
        self.signed_in = False
        self.web = None
        self.set_default_size(520, 600)
        self.set_icon_name("luxos-app")
        self.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=_("LuxAI Account")))
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.add(self.stack)
        self.connect("destroy", lambda *_a: self.web and self.web.close())
        # fotka zmenena v Profilove fotce: po navratu do okna ukazat novou
        self.photos = []
        self.connect("focus-in-event", lambda *_a: [p.reload() for p in self.photos] and False)
        self.show_page()

    def page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=24)
        return box

    def photo(self, size, name):
        btn = PhotoButton(size, name)
        self.photos = [p for p in self.photos if p.get_parent() is not None] + [btn]
        return btn

    def replace(self, box):
        for child in self.stack.get_children():
            self.stack.remove(child)
        self.stack.add(box)
        self.stack.show_all()

    def show_page(self):
        a = acc.load()
        if a:
            self.show_profile(a)
            run_async(acc.me, self.profile_loaded)
        else:
            self.show_login(mode=self.start_mode)

