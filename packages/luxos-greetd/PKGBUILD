# Maintainer: LuxOS Team
# Prihlasovaci obrazovka LuxOS 1.1.0 pro greetd: luxos-greeter v LSL pod `luxwm --greeter` (bez X serveru), relace
# LuxOS na Waylandu i LuxOS (X11). Instalace baliku prepne display-manager.service z LightDM na greetd, odebrani
# ho vrati (luxos-greetd.install). Popis: docs/developers/wayland-session.md; testy: tests/test_luxos_greeter_wl.py.

pkgname=luxos-greetd
pkgver=1.1.0
pkgrel=2
pkgdesc="LuxOS login screen on Wayland (greetd + LSL greeter under luxwm)"
arch=(x86_64)
url="https://github.com/luxopes/LuxOS-Arch"
license=(GPL-3.0-or-later)
# !strip: programy v LSL po strip nejdou spustit
options=(!debug !strip)
depends=(greetd 'luxwm>=0.1.0-12' 'luxos-desktop>=1.1.0-98' gtk3 cairo pango luxos-i18n accountsservice)
optdepends=('xorg-xinit: login screen on NVIDIA 470 and older (Xorg instead of Wayland)')
makedepends=('lsl>=0.11.0')
backup=(etc/greetd/luxos.toml)
install=luxos-greetd.install

build() {
    # vazby na C (greetd IPC, GDK) a spolecne moduly luxos-desktop jako systemove bindingy LSL
    lslc --target linux-x86_64-gnu --system-bindings "$startdir/files/lsl" \
        --system-bindings "$startdir/../luxos-desktop/files/lsl" "$startdir/files/lsl/luxos-greeter.lsl" luxos-greeter
}

package() {
    local f="$startdir/files"
    install -Dm755 luxos-greeter "$pkgdir/usr/lib/luxos/luxos-greeter"
    install -Dm755 "$f/luxos-greeter-session" "$pkgdir/usr/lib/luxos/luxos-greeter-session"
    install -Dm755 "$f/luxos-greetd-splash" "$pkgdir/usr/lib/luxos/luxos-greetd-splash"
    install -Dm644 "$f/luxos.toml" "$pkgdir/etc/greetd/luxos.toml"
    install -Dm644 "$f/luxos-greetd.service" "$pkgdir/usr/lib/systemd/system/luxos-greetd.service"
    install -Dm644 "$f/luxos-greetd.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/luxos-greetd.conf"
}
