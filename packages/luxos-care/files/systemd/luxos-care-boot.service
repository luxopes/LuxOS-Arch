[Unit]
Description=LuxOS Care: confirm that the system started correctly
Documentation=https://systemd.io/AUTOMATIC_BOOT_ASSESSMENT/
# Uspech -> boot-complete.target -> systemd-bless-boot oznaci polozku zavadece za dobrou.
# Neuspech (napr. graficke prihlaseni nenabehlo) -> po 3 pokusech zavadec pouzije zalozni jadro.
After=graphical.target multi-user.target display-manager.service
Before=boot-complete.target
ConditionPathExists=!/run/archiso
ConditionKernelCommandLine=!luxos.snapshot

[Service]
Type=oneshot
RemainAfterExit=yes
# Bezi ve chvili, kdy startuje prihlasovaci obrazovka: nebrat ji procesor ani disk
# (kontrola po startu neni naspech)
ExecStart=/usr/bin/luxos-care boot-check
TimeoutStartSec=30min
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=graphical.target
RequiredBy=boot-complete.target
