[Unit]
Description=LuxOS Care: automatic system update
Wants=network-online.target
After=network-online.target NetworkManager.service
ConditionPathExists=!/run/archiso
ConditionKernelCommandLine=!luxos.snapshot

[Service]
Type=oneshot
ExecStart=/usr/bin/luxos-care update
# Stahovani se pri vypnuti prerusi, instalace dobehne (luxos-care ceka na dokonceni transakce)
KillMode=mixed
TimeoutStopSec=30min
Nice=10
IOSchedulingClass=idle
