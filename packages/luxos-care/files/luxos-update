def read_json(path, default):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, type(default)) else default
    except (OSError, ValueError):
        return default


def read_countme():
    """[general] countme v /etc/lux/lux.conf (vychozi zapnuto). Cte ho lux-config z lux-engine
    (i conf.d a starsi format); bez nej primo TOML."""
    try:
        if "/usr/lib/lux" not in sys.path:
            sys.path.append("/usr/lib/lux")
        import lux_config
        return lux_config.parse("/etc/lux/lux.conf", ROOT).get("countme") != "off"
    except Exception:  # noqa: BLE001 - jen zobrazeni
        pass
    try:
        import tomllib
        with open(LUX_CONF, "rb") as f:
            return tomllib.load(f).get("general", {}).get("countme", True) is not False
    except (OSError, ValueError):
        return True


def read_mode():
    try:
        with open(CONF) as f:
            for line in f:
                if line.strip().startswith("MODE="):
                    v = line.split("=", 1)[1].strip().strip('"')
                    if v in ("carefree", "classic"):
                        return v
    except OSError:
        pass
    return "carefree"


def history(limit=40):
    """Zaznamy historie od nejnovejsiho."""
    out = []
    try:
        with open(os.path.join(STATE_DIR, "history.jsonl")) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    return out[-limit:][::-1]


def last_upgrade(log=None, limit=262144):
    """Cas posledni aktualizace baliku podle zaznamu spravce baliku ("[...] [ALPM] upgraded ...").
    Aktualizace prikazem lux update (Terminal, tlacitko v uvitacim okne) LuxOS Care nezapise -
    okno pak ukazovalo "Posledni aktualizace: nikdy" hned po aktualizaci. 0 = nevime."""
    import datetime
    log = log or ROOT + "/var/log/lux.log"
    try:
        with open(log, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - limit))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return 0
    for line in reversed(lines):
        if "] [ALPM] upgraded " not in line or not line.startswith("["):
            continue
        try:
            return int(datetime.datetime.strptime(line[1:line.index("]")], "%Y-%m-%dT%H:%M:%S%z").timestamp())
        except ValueError:
            continue
    return 0


def when(t):
    if not t:
        return _("never")
    d = time.time() - t
    if d < 90:
        return _("just now")
    if d < 3600:
        return _("%d min ago") % (d // 60)
    if time.strftime("%Y%m%d", time.localtime(t)) == time.strftime("%Y%m%d"):
        return _("today at %s") % time.strftime("%H:%M", time.localtime(t))
    return time.strftime("%d.%m.%Y %H:%M", time.localtime(t))


def fmt_size(b):
    return f"{b / 1024 / 1024:.0f} MB" if b >= 1024 * 1024 else f"{b / 1024:.0f} kB"


def problem_title(p):
    t = _(p.get("title", ""))
    args = p.get("args") or []
    return t.replace("%s", str(args[0])) if "%s" in t and args else t


