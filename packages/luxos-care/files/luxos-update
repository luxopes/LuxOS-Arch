    @staticmethod
    def clear(box):
        for c in box.get_children():
            box.remove(c)

    # -- stav --
    def schedule_refresh(self):
        GLib.timeout_add(400, lambda: self.refresh() and False)

    def running(self):
        p = read_json(PROGRESS, {})
        if not p:
            return None
        pid = int(p.get("pid", 0) or 0)
        if pid and not ROOT and not os.path.exists(f"/proc/{pid}"):
            return None
        return p

    def refresh(self):
        st = read_json(os.path.join(STATE_DIR, "state.json"), {})
        mode = read_mode()
        prog = self.running()
        for k, b in self.mode_btns.items():
            ctx = b.get_style_context()
            (ctx.add_class if k == mode else ctx.remove_class)("current")

        pending = st.get("pending", [])
        reboot = bool(st.get("needs_reboot"))
        if prog:
            self.title.set_text(_("Updating LuxOS…"))
        elif reboot:
            self.title.set_text(_("Restart to finish the update"))
        elif pending:
            self.title.set_text(_("%d updates available") % len(pending))
        elif st.get("last_error") and int(st.get("failures", 0) or 0) > 0:
            self.title.set_text(_("Updates could not be installed"))
        else:
            self.title.set_text(_("LuxOS is up to date"))
        sub = [_("Last update: %s") % when(max(int(st.get("last_update", 0) or 0), last_upgrade())),
               _("Last check: %s") % when(max(int(st.get("last_check", 0) or 0),
                                              int(st.get("last_check_updates", 0) or 0)))]
        if mode == "carefree" and st.get("last_skip_reason") and not prog:
            why = {"metered": _("waiting for an unmetered connection (Data Saver)"),
                   "battery": _("waiting for the charger or more battery"),
                   "offline": _("waiting for the internet connection")}.get(st["last_skip_reason"])
            if why and int(st.get("last_skip", 0)) > int(st.get("last_success", 0) or 0):
                sub.append(_("Automatic update is %s.") % why)
        self.sub.set_text("\n".join(sub))
        self.update_btn.set_visible(not prog and not reboot)
        self.update_btn.set_sensitive(not prog)
        self.restart_btn.set_visible(reboot and not prog)
        self.check_btn.set_sensitive(not prog)
        self.show_progress(prog)

        # aktualizace
        self.clear(self.updates_group)
        if pending:
            for name, old, new in pending[:60]:
                self.row(self.updates_group, name, f"{old} → {new}")
            if len(pending) > 60:
                self.row(self.updates_group, _("and %d more") % (len(pending) - 60))
        else:
            self.row(self.updates_group, _("No updates are waiting."),
                     _("LuxOS checks for updates automatically."))
        # *.luxnew/*.luxsave (klic "pacnew" zapisoval LuxOS Care do LuxOS 1.0)
        # nove verze se slouci samy (lux_configmerge.py); zbyde jen to, co nejde bez konfliktu - system
        # dal pouziva soubor uzivatele, zadne strasidelne hlaseni
        for f in st.get("new_configs", st.get("pacnew", []))[:10]:
            if f.endswith((".luxnew", ".pacnew")):
                cur = f.rsplit(".", 1)[0]
                self.row(self.updates_group, _("New version of a configuration file: %s") % cur,
                         _("Your current file stays in use and the system works normally. "
                           "To review it: sudo lux config-diff %s") % cur)
            else:
                self.row(self.updates_group, _("New configuration file to review: %s") % f,
                         _("Your settings were kept. Merge the files when convenient: lux configs"), status="warn")

        # zdravi
        self.clear(self.health_group)
        probs = st.get("problems", [])
        if not probs:
            self.row(self.health_group, _("No problems found"), _("Last check: %s") % when(st.get("last_check")),
                     status="ok")
        for p in probs:
            sub = p.get("detail", "")
            ai = p.get("ai") or {}
            if ai.get("status") == "pending":
                sub = (sub + " · " if sub else "") + (_("Waiting for LuxAI Flash") if mode == "carefree" else "")
            elif ai.get("status") == "failed":
                sub = (sub + " · " if sub else "") + _("The repair did not help")
            if mode == "classic" and p.get("rules"):
                sub = (sub + " · " if sub else "") + _("Switch to Carefree to repair it automatically.")
            self.row(self.health_group, problem_title(p), sub, status="bad" if p.get("severity") == "serious" else "warn")
        prev = st.get("prev_kernel")
        if prev:
            if st.get("prev_kernel_ok"):
                auto = (_("If a new kernel fails to start, LuxOS starts this one automatically.")
                        if st.get("auto_fallback") else
                        _("If a new kernel fails to start, choose “LuxOS (previous kernel)” in the boot menu."))
                self.row(self.health_group, _("Previous kernel %s is kept as a fallback") % prev, auto, status="ok")
            else:
                self.row(self.health_group, _("The previous kernel %s could not be prepared") % prev,
                         {"esp_full": _("The boot partition is full.")}.get(st.get("prev_kernel_error"), ""),
                         status="warn")
        else:
            self.row(self.health_group, _("Previous kernel"),
                     _("After the next kernel update the current kernel stays available as a fallback."))

        self.show_protection()
        self.show_countme()

        # historie
        self.clear(self.history_group)
        hist = history(15)
        if not hist:
            self.row(self.history_group, _("Nothing yet"), _("Updates and repairs will be listed here."))
        for i, h in enumerate(hist):
            title, detail, ok = history_text(h)
            sub = when(h.get("time")) + (f" · {detail}" if detail else "")
            if h.get("kind") in EXPANDABLE:
                self.history_row(h, hist[i + 1:], title, sub, ok)
            else:
                self.row(self.history_group, title, sub, status="ok" if ok else "bad")
        if hist:
            more = Gtk.Button(label=_("Show Full Log…"))
            more.connect("clicked", lambda _b: self.full_log())
            self.row(self.history_group, _("Audit log"), "/var/lib/luxos-care/history.jsonl", widget=more)
        self.win.show_all()
        self.update_btn.set_visible(not prog and not reboot)
        self.restart_btn.set_visible(reboot and not prog)
        self.prog_box.set_visible(bool(prog))
        return True

    # -- historie: rozbalitelne radky --
    def expand_latest(self, kind):
        """--latest: rozbalit nejnovejsi zaznam daneho druhu (a posunout okno k nemu)."""
        kinds = LATEST_KINDS.get(kind)
        if not kinds:
            return
        for h in history(15):
            if h.get("kind") in kinds:
                self.expanded.add(history_key(h))
                self.scroll_to = history_key(h)
                return

    def latest_expander(self):
        for r in self.history_group.get_children():
            for c in r.get_children():
                if getattr(c, "luxos_key", None) == self.scroll_to:
                    return c
        return None

    def scroll_to_latest(self):
        exp = self.latest_expander()
        if exp is not None:
            pos = exp.translate_coordinates(self.scroll.get_child(), 0, 0)
            if pos:
                adj = self.scroll.get_vadjustment()
                adj.set_value(min(max(0, pos[1] - 60), adj.get_upper() - adj.get_page_size()))
        return False

    def history_row(self, h, older, title, sub, ok):
        """Radek historie s rozbalenim: seznam baliku (stara → nova verze) nebo co oprava udelala."""
        r = Gtk.Box(spacing=10)
        r.get_style_context().add_class("row")
        if self.history_group.get_children():
            r.get_style_context().add_class("row-sep")
        dot = Gtk.Label(label="●")
        dot.get_style_context().add_class("ok" if ok else "bad")
        dot.set_valign(Gtk.Align.START)
        r.pack_start(dot, False, False, 0)
        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label(label=title, xalign=0)
        t.set_line_wrap(True)
        head.pack_start(t, False, False, 0)
        s = Gtk.Label(label=sub, xalign=0)
        s.get_style_context().add_class("hint")
        s.set_line_wrap(True)
        head.pack_start(s, False, False, 0)
        exp = Gtk.Expander()
        exp.set_label_widget(head)
        exp.set_hexpand(True)
        key = history_key(h)
        since = next((int(o.get("time") or 0) for o in older if o.get("kind") == "update"), 0)
        exp.luxos_key = key

        def toggled(e, _p):
            if e.get_expanded():
                self.expanded.add(key)
                if e.get_child() is None:
                    e.add(self.history_details(h, since))
                    e.get_child().show_all()
            else:
                self.expanded.discard(key)
        if key in self.expanded:
            exp.add(self.history_details(h, since))
            exp.set_expanded(True)
        exp.connect("notify::expanded", toggled)
        r.pack_start(exp, True, True, 0)
        self.history_group.pack_start(r, False, False, 0)
        return exp

    def history_details(self, h, since=0):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("details")

        def line(text, cls="hint"):
            lab = Gtk.Label(label=text, xalign=0)
            lab.set_line_wrap(True)
            lab.set_selectable(True)
            if cls:
                lab.get_style_context().add_class(cls)
            box.pack_start(lab, False, False, 0)
            return lab
        k = h.get("kind")
        if k == "repair":
            if h.get("title"):
                line(_("Problem: %s") % problem_title(h))
            act = _(ACTION_LABELS.get(h.get("action"), h.get("action", "")))
            if h.get("target"):
                act += f" ({h['target']})"
            line(_("What LuxOS did: %s") % act)
            if not h.get("ok", True):
                line(_("The repair did not help"))
            if (h.get("output") or "").strip():
                line(h["output"].strip()[-600:], "pkg-ver")
        elif k == "verify_repair":
            if h.get("repaired"):
                line(_("Reinstalled packages: %s") % " ".join(sorted(h["repaired"])))
            if h.get("failed"):
                line(_("Could not repair: %s") % " ".join(sorted(h["failed"])))
        elif k == "verify":
            if h.get("packages"):
                line(_("Affected packages: %s") % " ".join(sorted(h["packages"])))
        key = history_key(h)
        if key not in self.changes_cache:
            self.changes_cache[key] = care.history_changes(h, since)
        changes = self.changes_cache[key]
        if changes:
            self.package_list(box, changes)
        elif k == "update" and h.get("ok", True):
            line(_("Details aren't available for this older update."))
        if len(box.get_children()) == 0:
            line(_("No more details were recorded."))
        return box

    def package_list(self, box, changes):
        """Balicky serazene podle nazvu: nazev aplikace (nebo balicku) a stara → nova verze. Dlouhy
        seznam se posouva."""
        rows = []
        for c in changes:
            name = c.get("name", "")
            friendly = app_name(name, c.get("new") or c.get("old") or "")
            rows.append(((friendly or name).lower(), name, friendly, change_text(c)))
        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        for _sort, name, friendly, what in sorted(rows):
            item = Gtk.Box(spacing=8)
            lab = Gtk.Label(label=friendly or name, xalign=0)
            lab.set_selectable(True)
            lab.set_ellipsize(Pango.EllipsizeMode.END)
            lab.set_max_width_chars(34)
            item.pack_start(lab, False, False, 0)
            sub = (f"{name} · {what}" if what else name) if friendly else what
            if sub:
                v = Gtk.Label(label=sub, xalign=0)
                v.get_style_context().add_class("pkg-ver")
                v.set_selectable(True)
                v.set_ellipsize(Pango.EllipsizeMode.END)
                item.pack_start(v, True, True, 0)
            lst.pack_start(item, False, False, 0)
        if len(rows) > 12:
            sw = Gtk.ScrolledWindow()
            sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sw.set_min_content_height(240)
            sw.set_max_content_height(240)
            sw.add(lst)
            box.pack_start(sw, False, False, 0)
        else:
            box.pack_start(lst, False, False, 0)
        brand = next((c for c in changes if c.get("name") == "luxos-branding" and c.get("new")), None)
        if brand and GLib.find_program_in_path("luxos-whats-new"):
            # Co je noveho: novinky aktualni verze LuxOS
            notes = Gtk.Button(label=_("LuxOS release notes"))
            notes.set_halign(Gtk.Align.START)
            notes.connect("clicked", lambda _b: self.whats_new())
            box.pack_start(notes, False, False, 0)
        return lst

    def whats_new(self):
        try:
            subprocess.Popen(["luxos-whats-new"], stdin=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            self.error(str(e))

    def verify_running(self):
        p = read_json(VERIFY_PROGRESS, {})
        if not p:
            return None
        pid = int(p.get("pid", 0) or 0)
        if pid and not ROOT and not os.path.exists(f"/proc/{pid}"):
            return None
        return p

    def show_protection(self):
        """Ochrana systemu: zapnuta? a vysledek posledni kontroly souboru (luxos-care verify)."""
        self.clear(self.protect_group)
        try:
            st = protect.status()
        except Exception:  # noqa: BLE001 - stav jen pro zobrazeni
            st = {"enabled": False, "state": "off", "verified": 0, "result": "", "problem_count": 0, "affected": []}
        if st["enabled"] and st["state"] in ("ro", "rw"):
            sub = (_("System files are open for an update right now.") if st["state"] == "rw" else
                   _("System files (/usr) are read-only. Only updates and app installations can change them."))
            self.row(self.protect_group, _("System protection: On"), sub, status="ok")
        elif st["enabled"]:
            self.row(self.protect_group, _("System protection: On after the next restart"), "", status="warn")
        else:
            on = Gtk.Button(label=_("Turn On"))
            on.set_sensitive(not self.protect_busy)
            on.connect("clicked", lambda _b: self.set_protect(True))
            self.row(self.protect_group, _("System protection: Off"),
                     _("When it is on, programs cannot change system files outside of updates."), status="warn",
                     widget=on)
        run = self.verify_running()
        self.verify_btn.set_sensitive(run is None)
        if run:
            total = max(1, int(run.get("total", 0) or 0))
            pct = int(100 * int(run.get("done", 0) or 0) / total)
            self.row(self.protect_group, _("Verifying system files… %d %%") % pct, run.get("package", ""))
            if not self.verify_poll:
                self.verify_poll = GLib.timeout_add(1000, self.poll_verify)
            return
        res = protect.load_result() if st.get("verified") else {}
        if not st.get("verified"):
            self.row(self.protect_group, _("System files were not verified yet."),
                     _("LuxOS checks them once a week while the computer is charging."))
        elif st.get("problem_count"):
            fix = Gtk.Button(label=_("Repair"))
            fix.get_style_context().add_class("suggested-action")
            fix.connect("clicked", lambda _b: self.start_unit("luxos-care-repair-now.service"))
            paths = [p.get("path", "") for p in res.get("problems", [])[:3]]
            sub = _("Verified %s") % when(st["verified"]) + " · " + \
                _("Repair reinstalls: %s") % " ".join(st.get("affected", [])[:8])
            if paths:
                sub += "\n" + "\n".join(paths)
            self.row(self.protect_group, _("%d system files were changed or are missing") % st["problem_count"],
                     sub, status="bad", widget=fix)
        else:
            self.row(self.protect_group, _("System files verified on %s") % time.strftime(
                "%d.%m.%Y", time.localtime(st["verified"])), _("No modified system files."), status="ok")

    def poll_verify(self):
        if self.verify_running():
            self.show_protection()
            self.protect_group.show_all()
            return True
        self.verify_poll = None
        self.refresh()
        return False

    def verify_now(self):
        self.start_unit("luxos-care-verify-now.service")
        self.verify_btn.set_sensitive(False)
        GLib.timeout_add(800, lambda: self.refresh() and False)

    def show_countme(self):
        on = read_countme()
        self.countme_switch.handler_block(self.countme_handler)
        self.countme_switch.set_active(on)
        self.countme_switch.handler_unblock(self.countme_handler)
        self.countme_switch.set_sensitive(not self.countme_busy)

    def on_countme(self, sw, _pspec):
        want = sw.get_active()
        if self.countme_busy or want == read_countme():
            return
        self.countme_busy = True
        sw.set_sensitive(False)

        def done(pid, status):
            self.countme_busy = False
            GLib.spawn_close_pid(pid)
            self.show_countme()        # zruseni hesla nebo chyba: prepinac zpet podle souboru
        try:
            pid, *_x = GLib.spawn_async(["pkexec", HELPER, "set-countme", "on" if want else "off"],
                                        flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.DO_NOT_REAP_CHILD)
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, done)
        except GLib.Error as e:
            self.countme_busy = False
            self.show_countme()
            self.error(e.message)

    def set_protect(self, on):
        if self.protect_busy:
            return
        self.protect_busy = True

        def done(pid, status):
            self.protect_busy = False
            GLib.spawn_close_pid(pid)
            self.refresh()
        try:
            pid, *_x = GLib.spawn_async(["pkexec", HELPER, "set-protect", "on" if on else "off"],
                                        flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.DO_NOT_REAP_CHILD)
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, done)
        except GLib.Error as e:
            self.protect_busy = False
            self.error(e.message)

    def show_progress(self, prog):
        if not prog:
            if self.poll_id:
                GLib.source_remove(self.poll_id)
                self.poll_id = None
            self.prog_box.set_visible(False)
            return
        self.prog_box.set_visible(True)
        self.progress.set_fraction(float(prog.get("fraction", 0)))
        ph = prog.get("phase")
        if ph == "download" and prog.get("total_bytes"):
            text = _("Downloading… %s of %s") % (fmt_size(prog.get("bytes", 0)), fmt_size(prog["total_bytes"]))
        elif ph == "install" and prog.get("total"):
            text = _("Installing %s (%d of %d)") % (prog.get("text", ""), prog.get("done", 0), prog["total"])
        else:
            text = {"check": _("Checking for updates…"), "keyring": _("Updating signing keys…"),
                    "download": _("Downloading…"), "install": _("Installing…"),
                    "cleanup": _("Finishing…")}.get(ph, _("Working…"))
        self.prog_label.set_text(text + "  " + _("Do not turn off the computer."))
        if not self.poll_id:
            self.poll_id = GLib.timeout_add(500, self.poll)

    def poll(self):
        prog = self.running()
        if not prog:
            self.poll_id = None
            self.refresh()
            return False
        self.show_progress(prog)
        return True

    # -- akce --
    def start_unit(self, unit):
        if self.sysbus is None:
            return self.error(_("The system service is not available."))
        try:
            self.sysbus.call_sync("org.freedesktop.systemd1", "/org/freedesktop/systemd1",
                                  "org.freedesktop.systemd1.Manager", "StartUnit",
                                  GLib.Variant("(ss)", (unit, "replace")), None,
                                  Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)
        except GLib.Error as e:
            return self.error(_("Could not start: %s") % e.message)
        if unit.startswith("luxos-care-update"):
            self.title.set_text(_("Updating LuxOS…"))
            self.prog_box.set_visible(True)
            self.progress.pulse()
            self.prog_label.set_text(_("Checking for updates…"))
            self.update_btn.set_sensitive(False)
            GLib.timeout_add(700, self.poll_start)
        return None

    def poll_start(self):
        """Po spusteni: cekat na prvni zapis prubehu (nebo na konec, kdyz nebylo co delat)."""
        prog = self.running()
        if prog:
            self._ticks = 0
            self.show_progress(prog)
            return False
        self._ticks = getattr(self, "_ticks", 0) + 1
        if self._ticks > 90:
            self._ticks = 0
            self.refresh()
            return False
        self.progress.pulse()
        return True

    def set_mode(self, m):
        if self.mode_busy or m == read_mode():
            return
        self.mode_busy = True

        def done(pid, status):
            self.mode_busy = False
            GLib.spawn_close_pid(pid)
            self.refresh()
        try:
            pid, *_x = GLib.spawn_async(["pkexec", HELPER, "set-mode", m],
                                        flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.DO_NOT_REAP_CHILD)
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, done)
        except GLib.Error as e:
            self.mode_busy = False
            self.error(e.message)

    def restart(self):
        for cmd in (["xfce4-session-logout", "--reboot", "--fast"], ["systemctl", "reboot"]):
            try:
                subprocess.Popen(cmd, start_new_session=True)
                return
            except OSError:
                continue

    def full_log(self):
        d = Gtk.Dialog(title=_("Audit log"), transient_for=self.win, modal=True)
        d.add_button(_("Close"), Gtk.ResponseType.CLOSE)
        d.set_default_size(620, 460)
        sw = Gtk.ScrolledWindow()
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        lines = []
        for h in history(500):
            title, detail, ok = history_text(h)
            lines.append(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(h.get('time', 0)))}  "
                         f"{'OK ' if ok else 'ERR'}  {title}" + (f" — {detail}" if detail else ""))
            if h.get("output"):
                lines.append("        " + h["output"].strip().replace("\n", "\n        ")[:600])
        tv.get_buffer().set_text("\n".join(lines) or _("Nothing yet"))
        sw.add(tv)
        sw.set_vexpand(True)
        d.get_content_area().pack_start(sw, True, True, 0)
        d.show_all()
        d.run()
        d.destroy()

    def error(self, text):
        m = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE, text=text)
        m.run()
        m.destroy()


