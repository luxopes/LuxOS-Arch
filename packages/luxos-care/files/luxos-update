    return f"{h.get('time', 0)}|{h.get('kind', '')}|{h.get('action', '')}|{h.get('problem', '')}"


def app_name(name, version=""):
    """Nazev aplikace pro balicek (Name z jejiho .desktop v jazyce uzivatele), jinak "". """
    for path in care.package_desktop_files(name, version):
        try:
            info = Gio.DesktopAppInfo.new_from_filename(path)
        except (TypeError, GLib.Error):
            info = None
        if info is not None and not info.get_nodisplay() and info.get_name():
            return info.get_name()
    return ""


def change_text(c):
    """Popis zmeny jednoho baliku: "1.0-1 → 1.1-1", "Nainstalovano 2.0-1"..."""
    a, old, new = c.get("action"), c.get("old", ""), c.get("new", "")
    if a == "installed":
        return _("Installed %s") % new
    if a == "removed":
        return _("Removed %s") % old
    if a == "reinstalled":
        return _("Reinstalled %s") % new
    if a == "downgraded":
        return _("Back to an older version: %s → %s") % (old, new)
    return f"{old} → {new}" if old and new else ""


