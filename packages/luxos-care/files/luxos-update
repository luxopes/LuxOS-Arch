    # -- stavebni prvky --
    def group_title(self, text):
        lab = Gtk.Label(label=text, xalign=0)
        lab.get_style_context().add_class("group-title")
        return lab

    def group(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.get_style_context().add_class("group")
        return box

    def row(self, group, title, sub="", status=None, first=False, widget=None):
        r = Gtk.Box(spacing=10)
        r.get_style_context().add_class("row")
        if group.get_children():
            r.get_style_context().add_class("row-sep")
        if status is not None:
            dot = Gtk.Label(label={"ok": "●", "bad": "●", "warn": "●"}.get(status, "●"))
            dot.get_style_context().add_class(status)
            dot.set_valign(Gtk.Align.START)
            r.pack_start(dot, False, False, 0)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label(label=title, xalign=0)
        t.set_line_wrap(True)
        box.pack_start(t, False, False, 0)
        if sub:
            s = Gtk.Label(label=sub, xalign=0)
            s.get_style_context().add_class("hint")
            s.set_line_wrap(True)
            box.pack_start(s, False, False, 0)
        r.pack_start(box, True, True, 0)
        if widget is not None:
            widget.set_valign(Gtk.Align.CENTER)
            r.pack_end(widget, False, False, 0)
        group.pack_start(r, False, False, 0)
        return r

    @staticmethod
    def clear(box):
        for c in box.get_children():
            box.remove(c)

    # -- stav --
    def schedule_refresh(self):
        GLib.timeout_add(400, lambda: self.refresh() and False)

    def running(self):
        p = read_json(PROGRESS, {})
        if not p:
            return None
        pid = int(p.get("pid", 0) or 0)
        if pid and not ROOT and not os.path.exists(f"/proc/{pid}"):
            return None
        return p

    def refresh(self):
        st = read_json(os.path.join(STATE_DIR, "state.json"), {})
        mode = read_mode()
        prog = self.running()
        for k, b in self.mode_btns.items():
            ctx = b.get_style_context()
            (ctx.add_class if k == mode else ctx.remove_class)("current")

        pending = st.get("pending", [])
        reboot = bool(st.get("needs_reboot"))
        if prog:
            self.title.set_text(_("Updating LuxOS…"))
        elif reboot:
            self.title.set_text(_("Restart to finish the update"))
        elif pending:
            self.title.set_text(_("%d updates available") % len(pending))
        elif st.get("last_error") and int(st.get("failures", 0) or 0) > 0:
            self.title.set_text(_("Updates could not be installed"))
        else:
            self.title.set_text(_("LuxOS is up to date"))
        sub = [_("Last update: %s") % when(st.get("last_update")),
               _("Last check: %s") % when(max(int(st.get("last_check", 0) or 0),
                                              int(st.get("last_check_updates", 0) or 0)))]
        if mode == "carefree" and st.get("last_skip_reason") and not prog:
            why = {"metered": _("waiting for an unmetered connection (Data Saver)"),
                   "battery": _("waiting for the charger or more battery"),
                   "offline": _("waiting for the internet connection")}.get(st["last_skip_reason"])
            if why and int(st.get("last_skip", 0)) > int(st.get("last_success", 0) or 0):
                sub.append(_("Automatic update is %s.") % why)
        self.sub.set_text("\n".join(sub))
        self.update_btn.set_visible(not prog and not reboot)
        self.update_btn.set_sensitive(not prog)
        self.restart_btn.set_visible(reboot and not prog)
        self.check_btn.set_sensitive(not prog)
        self.show_progress(prog)

        # aktualizace
        self.clear(self.updates_group)
        if pending:
            for name, old, new in pending[:60]:
                self.row(self.updates_group, name, f"{old} → {new}")
            if len(pending) > 60:
                self.row(self.updates_group, _("and %d more") % (len(pending) - 60))
        else:
            self.row(self.updates_group, _("No updates are waiting."),
                     _("LuxOS checks for updates automatically."))
        for f in st.get("pacnew", [])[:10]:
            self.row(self.updates_group, _("New configuration file to review: %s") % f,
                     _("Your settings were kept. Compare the files with pacdiff when convenient."), status="warn")

        # zdravi
        self.clear(self.health_group)
        probs = st.get("problems", [])
        if not probs:
            self.row(self.health_group, _("No problems found"), _("Last check: %s") % when(st.get("last_check")),
                     status="ok")
        for p in probs:
            sub = p.get("detail", "")
            ai = p.get("ai") or {}
            if ai.get("status") == "pending":
                sub = (sub + " · " if sub else "") + (_("Waiting for LuxAI Flash") if mode == "carefree" else "")
            elif ai.get("status") == "failed":
                sub = (sub + " · " if sub else "") + _("The repair did not help")
            if mode == "classic" and p.get("rules"):
                sub = (sub + " · " if sub else "") + _("Switch to Carefree to repair it automatically.")
            self.row(self.health_group, problem_title(p), sub, status="bad" if p.get("severity") == "serious" else "warn")
        prev = st.get("prev_kernel")
        if prev:
            if st.get("prev_kernel_ok"):
                auto = (_("If a new kernel fails to start, LuxOS starts this one automatically.")
                        if st.get("auto_fallback") else
                        _("If a new kernel fails to start, choose “LuxOS (previous kernel)” in the boot menu."))
                self.row(self.health_group, _("Previous kernel %s is kept as a fallback") % prev, auto, status="ok")
            else:
                self.row(self.health_group, _("The previous kernel %s could not be prepared") % prev,
                         {"esp_full": _("The boot partition is full.")}.get(st.get("prev_kernel_error"), ""),
                         status="warn")
        else:
            self.row(self.health_group, _("Previous kernel"),
                     _("After the next kernel update the current kernel stays available as a fallback."))

        # historie
        self.clear(self.history_group)
        hist = history(15)
        if not hist:
            self.row(self.history_group, _("Nothing yet"), _("Updates and repairs will be listed here."))
        for h in hist:
            title, detail, ok = history_text(h)
            sub = when(h.get("time")) + (f" · {detail}" if detail else "")
            self.row(self.history_group, title, sub, status="ok" if ok else "bad")
        if hist:
            more = Gtk.Button(label=_("Show Full Log…"))
            more.connect("clicked", lambda _b: self.full_log())
            self.row(self.history_group, _("Audit log"), "/var/lib/luxos-care/history.jsonl", widget=more)
        self.win.show_all()
        self.update_btn.set_visible(not prog and not reboot)
        self.restart_btn.set_visible(reboot and not prog)
        self.prog_box.set_visible(bool(prog))
        return True

    def show_progress(self, prog):
        if not prog:
            if self.poll_id:
                GLib.source_remove(self.poll_id)
                self.poll_id = None
            self.prog_box.set_visible(False)
            return
        self.prog_box.set_visible(True)
        self.progress.set_fraction(float(prog.get("fraction", 0)))
        ph = prog.get("phase")
        if ph == "download" and prog.get("total_bytes"):
            text = _("Downloading… %s of %s") % (fmt_size(prog.get("bytes", 0)), fmt_size(prog["total_bytes"]))
        elif ph == "install" and prog.get("total"):
            text = _("Installing %s (%d of %d)") % (prog.get("text", ""), prog.get("done", 0), prog["total"])
        else:
            text = {"check": _("Checking for updates…"), "keyring": _("Updating signing keys…"),
                    "download": _("Downloading…"), "install": _("Installing…"),
                    "cleanup": _("Finishing…")}.get(ph, _("Working…"))
        self.prog_label.set_text(text + "  " + _("Do not turn off the computer."))
        if not self.poll_id:
            self.poll_id = GLib.timeout_add(500, self.poll)

    def poll(self):
        prog = self.running()
        if not prog:
            self.poll_id = None
            self.refresh()
            return False
        self.show_progress(prog)
        return True

    # -- akce --
    def start_unit(self, unit):
        if self.sysbus is None:
            return self.error(_("The system service is not available."))
        try:
            self.sysbus.call_sync("org.freedesktop.systemd1", "/org/freedesktop/systemd1",
                                  "org.freedesktop.systemd1.Manager", "StartUnit",
                                  GLib.Variant("(ss)", (unit, "replace")), None,
                                  Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)
        except GLib.Error as e:
            return self.error(_("Could not start: %s") % e.message)
        if unit.startswith("luxos-care-update"):
            self.title.set_text(_("Updating LuxOS…"))
            self.prog_box.set_visible(True)
            self.progress.pulse()
            self.prog_label.set_text(_("Checking for updates…"))
            self.update_btn.set_sensitive(False)
            GLib.timeout_add(700, self.poll_start)
        return None

    def poll_start(self):
        """Po spusteni: cekat na prvni zapis prubehu (nebo na konec, kdyz nebylo co delat)."""
        prog = self.running()
        if prog:
            self._ticks = 0
            self.show_progress(prog)
            return False
        self._ticks = getattr(self, "_ticks", 0) + 1
        if self._ticks > 90:
            self._ticks = 0
            self.refresh()
            return False
        self.progress.pulse()
        return True

    def set_mode(self, m):
        if self.mode_busy or m == read_mode():
            return
        self.mode_busy = True

        def done(pid, status):
            self.mode_busy = False
            GLib.spawn_close_pid(pid)
            self.refresh()
        try:
            pid, *_x = GLib.spawn_async(["pkexec", HELPER, "set-mode", m],
                                        flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.DO_NOT_REAP_CHILD)
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, done)
        except GLib.Error as e:
            self.mode_busy = False
            self.error(e.message)

    def restart(self):
        for cmd in (["xfce4-session-logout", "--reboot", "--fast"], ["systemctl", "reboot"]):
            try:
                subprocess.Popen(cmd, start_new_session=True)
                return
            except OSError:
                continue

    def full_log(self):
        d = Gtk.Dialog(title=_("Audit log"), transient_for=self.win, modal=True)
        d.add_button(_("Close"), Gtk.ResponseType.CLOSE)
        d.set_default_size(620, 460)
        sw = Gtk.ScrolledWindow()
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        lines = []
        for h in history(500):
            title, detail, ok = history_text(h)
            lines.append(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(h.get('time', 0)))}  "
                         f"{'OK ' if ok else 'ERR'}  {title}" + (f" — {detail}" if detail else ""))
            if h.get("output"):
                lines.append("        " + h["output"].strip().replace("\n", "\n        ")[:600])
        tv.get_buffer().set_text("\n".join(lines) or _("Nothing yet"))
        sw.add(tv)
        sw.set_vexpand(True)
        d.get_content_area().pack_start(sw, True, True, 0)
        d.show_all()
        d.run()
        d.destroy()

    def error(self, text):
        m = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE, text=text)
        m.run()
        m.destroy()


APP_ID = "luxos-update"


def main():
    GLib.set_prgname(APP_ID)
    GLib.set_application_name(_("Software Update"))
    App()
    Gtk.main()


if __name__ == "__main__":
    main()
