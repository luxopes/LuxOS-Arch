def read_json(path, default):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, type(default)) else default
    except (OSError, ValueError):
        return default


def read_mode():
    try:
        with open(CONF) as f:
            for line in f:
                if line.strip().startswith("MODE="):
                    v = line.split("=", 1)[1].strip().strip('"')
                    if v in ("carefree", "classic"):
                        return v
    except OSError:
        pass
    return "carefree"


def history(limit=40):
    out = []
    try:
        with open(os.path.join(STATE_DIR, "history.jsonl")) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    return out[-limit:][::-1]


def when(t):
    if not t:
        return _("never")
    d = time.time() - t
    if d < 90:
        return _("just now")
    if d < 3600:
        return _("%d min ago") % (d // 60)
    if time.strftime("%Y%m%d", time.localtime(t)) == time.strftime("%Y%m%d"):
        return _("today at %s") % time.strftime("%H:%M", time.localtime(t))
    return time.strftime("%d.%m.%Y %H:%M", time.localtime(t))


def fmt_size(b):
    return f"{b / 1024 / 1024:.0f} MB" if b >= 1024 * 1024 else f"{b / 1024:.0f} kB"


def problem_title(p):
    t = _(p.get("title", ""))
    args = p.get("args") or []
    return t.replace("%s", str(args[0])) if "%s" in t and args else t


ACTION_LABELS = {
    "remove_db_lock": "Removed a stale package manager lock",
    "complete_upgrade": "Finished an interrupted update",
    "refresh_keyring": "Refreshed the package signing keys",
    "rebuild_initramfs": "Rebuilt the kernel boot files",
    "dkms_autoinstall": "Rebuilt driver modules",
    "reinstall_package": "Reinstalled a package",
    "restart_unit": "Restarted a service",
    "clean_cache": "Freed disk space",
    "retry_new_kernel": "Will try the newest kernel again",
    "use_previous_kernel": "Will start the previous kernel",
    "none": "Only reported the problem",
}


def history_text(h):
    """(nadpis, podrobnost, ok) radku historie."""
    k = h.get("kind")
    ok = h.get("ok", True)
    if k == "update":
        if ok:
            n = int(h.get("count", 0))
            return _("Updated %d packages") % n, (_("including the kernel") if h.get("kernel") else ""), True
        return _("Update failed"), h.get("error", ""), False
    if k == "repair":
        act = _(ACTION_LABELS.get(h.get("action"), h.get("action", "")))
        if h.get("target"):
            act += f" ({h['target']})"
        src = _("chosen by LuxAI Flash") if h.get("source") == "ai" else _("built-in rule")
        return act, f"{problem_title(h)} · {src}", ok
    if k == "kernel":
        if h.get("released"):
            return _("Released the kept kernel %s for reinstallation") % h["released"], "", True
        if ok:
            return _("Kept the previous kernel %s") % h.get("prev", ""), _("Boot menu: LuxOS (previous kernel)"), True
        return _("The previous kernel could not be prepared"), h.get("error", ""), False
    if k == "boot":
        return _("A start did not finish correctly"), ", ".join(h.get("problems", [])), False
    if k == "mode":
        return (_("Mode changed to Carefree") if h.get("mode") == "carefree" else _("Mode changed to Classic")), "", True
    return k or "?", "", ok


