#!/usr/bin/env python3
"""LuxOS Care - aktualizace, zalozni jadro a samooprava (viz /usr/lib/luxos/python/luxos_care.py).

  luxos-care [status] [--json]      stav (kdokoli)
  luxos-care history [N]            auditni zaznam oprav a aktualizaci
  luxos-care mode [carefree|classic]
  luxos-care update [--manual]      (root, luxos-care-update.service)
  luxos-care check [--updates]      (root, luxos-care-check.service)
  luxos-care apply ID-N             (root, luxos-care-apply@ID-N.service: volba LuxAI)
  luxos-care boot-check             (root, pred boot-complete.target)
  luxos-care kernel-pre|kernel-post (root, hooky jadra lux; cile na stdin)
  luxos-care kernel-switch          (root) prechod na jadro LuxOS (linux-luxos), puvodni zustane
                                    jako zalozni; spousti ho i `lux update` (after-update.d)
  luxos-care release-kept           (root) vystup transakce na stdin: uvolni zalozni jadro
                                    se stejnou verzi, jaka se ma nainstalovat

Snimky systemu (btrfs, viz /usr/lib/luxos/python/luxos_snapshots.py):
  luxos-care snapshots [--json]     (root) seznam snimku
  luxos-care snapshot [--kind system]  (root) novy snimek hned (system = pred lux system apply)
  luxos-care rollback JMENO|--booted --yes
                                    (root) snimek se stane systemem od pristiho startu
  luxos-care boot-entries           (root) obnovit polozky snimku a obnovy v zavadeci
  luxos-care snapshot-pre           (root, hook 05-luxos-snapshot; baliky na stdin)
  luxos-care after-rollback         (root, prvni start po navratu)

Obnova (LuxOS Recovery, /usr/lib/luxos/care/luxos-recovery):
  luxos-care disk-check [--repair] [--json]
                                    (root) kontrola disku, bez --repair nic nezapisuje
  luxos-care reinstall --yes        (root) preinstalace systemu se zachovanim /home a uctu
"""
import json
import os
import sys
import time

sys.path.insert(0, "/usr/lib/luxos/python")
import luxos_care as care  # noqa: E402
import luxos_snapshots as snap  # noqa: E402
import luxos_recovery as rec  # noqa: E402
from luxos_i18n import _  # noqa: E402


def need_root():
    if os.geteuid() != 0 and not care.ROOT:
        sys.exit(_("This command must be run as root."))


def fmt_time(t):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) if t else _("never")


def status(as_json):
    st = care.load_state()
    st["mode"] = care.mode()
    st.pop("attempts", None)
    st.pop("rules_done_once", None)
    for p in st.get("problems", []):
        if "ai" in p:
            p["ai"] = {k: v for k, v in p["ai"].items() if k != "diagnosis"}
    if as_json:
        print(json.dumps(st, indent=1, ensure_ascii=False))
        return 0
    print(_("Mode: %s") % (_("Carefree") if st["mode"] == "carefree" else _("Classic")))
    print(_("Last update: %s") % fmt_time(st.get("last_update")))
    print(_("Last check: %s") % fmt_time(st.get("last_check")))
    pend = st.get("pending", [])
    print(_("%d updates available") % len(pend))
    if st.get("prev_kernel"):
        print(_("Previous kernel: %s") % st["prev_kernel"])
    for p in st.get("problems", []):
        print("! " + _(p["title"]).replace("%s", " ".join(p.get("args", []))))
    if st.get("needs_reboot"):
        print(_("Restart to finish the update"))
    for f in st.get("pacnew", []):
        print(_("New configuration file to review: %s") % f)
    return 0


SNAP_ERRORS = {
    "not_found": "No such snapshot: %s",
    "busy": "Another package operation is running. Try it again when it finishes.",
    "kernel_missing": "The kernel of this snapshot (%s) was not kept, it cannot be started.",
    "no_subvolume": "The system subvolume %s was not found.",
    "kernel_copy_failed": "The kernel could not be copied to the boot partition: %s",
    "mount_failed": "The system disk could not be opened: %s",
    "no_device": "The system disk was not found.",
    "snapshot_failed": "The snapshot could not be created: %s",
    "subvolume_failed": "The snapshot could not be created: %s",
    "delete_failed": "The snapshot could not be deleted: %s",
    "no_packages": "The list of installed packages could not be read.",
    "kernel_not_saved": "The current kernel could not be saved, the reinstall was not started.",
    "install_failed": "Installing the packages failed (is the internet connected?): %s",
    "initramfs_failed": "Creating the initramfs failed: %s",
    "bootloader_failed": "Updating the boot loader failed: %s",
}
UNSUPPORTED = {
    "live": "Snapshots are not available in the live system.",
    "disabled": "Snapshots are turned off (SNAPSHOTS=no in /etc/luxos/care.conf).",
    "not_btrfs": "Snapshots need the Btrfs file system (LuxOS installs on Btrfs).",
    "no_subvolume": "Snapshots need the system on a Btrfs subvolume (LuxOS installs it as @).",
    "snapshot_boot": "LuxOS is running from a snapshot.",
}


def snap_error(e):
    msg = _(SNAP_ERRORS.get(e.code, "%s"))
    if "%s" in msg:
        msg = msg % (e.detail or e.code)
    return msg


def cmd_snapshots(args):
    need_root()
    ok, why = snap.supported()
    if not ok and why != "snapshot_boot":
        sys.exit(_(UNSUPPORTED.get(why, why)))
    try:
        with snap.snapshot_lock(), snap.top_level() as top:
            items = snap.describe(top)
    except snap.SnapshotError as e:
        sys.exit(snap_error(e))
    if "--json" in args:
        print(json.dumps(items, indent=1, ensure_ascii=False))
        return 0
    if not items:
        print(_("No snapshots yet. One is taken before every update."))
        return 0
    for i, s in enumerate(reversed(items), 1):
        flags = []
        if s["booted"]:
            flags.append(_("running now"))
        if not s["bootable"]:
            flags.append(_("not in the boot menu"))
        pk = " ".join(s["packages"][:6]) + (" …" if s["count"] > 6 else "")
        print(f"{i:2}  {s['name']}  {s['label']}" + (f"  [{', '.join(flags)}]" if flags else ""))
        if pk:
            print("      " + pk)
    return 0


def cmd_snapshot(_args):
    need_root()
    ok, why = snap.supported()
    if not ok:
        sys.exit(_(UNSUPPORTED.get(why, why)))
    try:
        with snap.snapshot_lock(), snap.top_level() as top:
            lay = care.detect_layout()
            # --kind system: lux system apply (snimek pred zmenou konfigurace systemu)
            kind = "system" if "--kind" in _args and "system" in _args else "manual"
            meta = snap.create(top, kind, lay=lay)
            snap.prune(top)
            snaps = snap.list_snapshots(top)
            snap.gc_kernels(lay, top, snaps)
            snap.sync_boot(top, lay, snaps)
    except snap.SnapshotError as e:
        sys.exit(snap_error(e))
    care.history("snapshot", ok=True, name=meta["name"])
    print(_("Snapshot %s created.") % meta["name"])
    return 0


def cmd_rollback(args):
    need_root()
    name = snap.booted_snapshot() if "--booted" in args else next((a for a in args if not a.startswith("-")), "")
    if not name:
        sys.exit("usage: luxos-care rollback NAME|--booted --yes")
    if "--yes" not in args:
        sys.exit(_("Add --yes to confirm (lux rollback asks first)."))
    ok, why = snap.supported()
    if not ok and why != "snapshot_boot":
        sys.exit(_(UNSUPPORTED.get(why, why)))
    try:
        with snap.snapshot_lock(), snap.top_level() as top:
            res = snap.rollback(top, name)
    except snap.SnapshotError as e:
        care.history("rollback", ok=False, to=name, error=e.code)
        sys.exit(snap_error(e))
    print(_("Done. After a restart LuxOS starts as it was: %s") % res["label"])
    print(_("The current system was kept as the snapshot %s (nothing was deleted).") % res["replaced"])
    return 0


def cmd_boot_entries(_args):
    need_root()
    ok, why = snap.supported()
    if not ok and why != "snapshot_boot":
        print(_(UNSUPPORTED.get(why, why)))
        return 0
    try:
        with snap.snapshot_lock(), snap.top_level() as top:
            for f in snap.sync_boot(top):
                print(f)
    except snap.SnapshotError as e:
        sys.exit(snap_error(e))
    return 0


def cmd_disk_check(args):
    need_root()
    repair = "--repair" in args
    try:
        with snap.snapshot_lock(), snap.top_level() as top:
            res = rec.disk_check(top, repair=repair, out=lambda t: None if "--json" in args else print("… " + t))
    except snap.SnapshotError as e:
        sys.exit(snap_error(e))
    if "--json" in args:
        print(rec.results_json(res))
    else:
        for title, ok, out in res:
            print(("✓ " if ok else "✗ ") + title)
            if not ok and out:
                print("\n".join("    " + ln for ln in out.splitlines()[-15:]))
        bad = [t for t, ok, _o in res if not ok]
        print(_("No problems found.") if not bad else _("Problems found: %d") % len(bad))
    return 0 if all(ok for _t, ok, _o in res) else 1


def cmd_reinstall(args):
    need_root()
    if "--yes" not in args:
        sys.exit(_("Add --yes to confirm (LuxOS Recovery asks first)."))
    ok, why = snap.supported()
    if not ok and why != "snapshot_boot":
        sys.exit(_(UNSUPPORTED.get(why, why)))
    try:
        with snap.snapshot_lock(), snap.top_level() as top:
            res = rec.reinstall(top, out=lambda t: print("… " + t, flush=True))
    except snap.SnapshotError as e:
        care.history("reinstall", ok=False, error=e.code)
        sys.exit(snap_error(e))
    print(_("LuxOS was reinstalled. Your files and accounts were kept."))
    print(_("The previous system was kept as the snapshot %s (nothing was deleted).") % res["kept"])
    if res["foreign"]:
        print(_("Not reinstalled (not from the repositories): %s") % " ".join(res["foreign"]))
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    args = argv[2:]
    if cmd == "status":
        return status("--json" in args)
    if cmd == "history":
        n = int(args[0]) if args and args[0].isdigit() else 30
        for h in care.read_history(n):
            print(json.dumps(h, ensure_ascii=False))
        return 0
    if cmd == "mode":
        if not args:
            print(care.mode())
            return 0
        need_root()
        care.set_mode(args[0])
        care.history("mode", mode=args[0])
        return 0
    if cmd == "update":
        need_root()
        return care.do_update(manual="--manual" in args)
    if cmd == "check":
        need_root()
        try:
            with care.CareLock(wait=True):
                care.do_check()
        except BlockingIOError:
            return 0
        if "--updates" in args:
            care.do_check_updates(force=True)
        return 0
    if cmd == "apply":
        need_root()
        rid, _s, n = (args[0] if args else "").rpartition("-")
        if not n.isdigit():
            sys.exit("usage: luxos-care apply ID-N")
        with care.CareLock(wait=True):
            ok, out = care.apply_ai_choice(rid, int(n))
        print(out[-2000:] if out else ("ok" if ok else "failed"))
        return 0 if ok else 1
    if cmd == "boot-check":
        need_root()
        rc = care.boot_check()
        try:
            with care.CareLock(wait=True):
                if rc == 0:
                    care.tsc_fix()
                care.do_check(boot=True)
        except Exception as e:  # noqa: BLE001 - vysledek startu rozhoduje boot_check
            care.log(f"check after boot failed: {e}")
        if rc == 0:
            try:
                snap.ensure_entries()
            except Exception as e:  # noqa: BLE001
                care.log(f"snapshot boot entries: {e}")
        return rc
    if cmd == "kernel-switch":
        need_root()
        try:
            with care.CareLock(wait=True):
                rc = care.kernel_migrate()
        except Exception as e:  # noqa: BLE001
            care.log(f"kernel switch failed: {e}")
            return 1
        return rc
    if cmd == "release-kept":
        # lux-engine -S ... 2>&1 | luxos-care release-kept: uvolni zalozni jadro kolidujici s instalaci
        need_root()
        print(" ".join(care.release_kept_conflicts(sys.stdin.read())))
        return 0
    if cmd == "snapshot-pre":
        # Hook pred transakci (AbortOnFail): chyba snimku nevadi, transakce pri startu ze snimku ano
        need_root()
        targets = [] if sys.stdin.isatty() else sys.stdin.read().split()
        rc = snap.pre_transaction(targets)
        if rc:
            print(_("LuxOS is running from a snapshot, changes would be lost after a restart. "
                    "To keep this version, run: lux rollback"), file=sys.stderr)
        return rc
    if cmd == "after-rollback":
        need_root()
        return snap.after_rollback()
    handlers = {"snapshots": cmd_snapshots, "snapshot": cmd_snapshot, "rollback": cmd_rollback,
                "boot-entries": cmd_boot_entries, "disk-check": cmd_disk_check, "reinstall": cmd_reinstall}
    if cmd in handlers:
        return handlers[cmd](args)
    if cmd in ("kernel-pre", "kernel-post"):
        need_root()
        targets = [] if sys.stdin.isatty() else sys.stdin.read().split()
        try:
            return (care.kernel_pre if cmd == "kernel-pre" else care.kernel_post)(targets)
        except Exception as e:  # noqa: BLE001 - hook nesmi rozbit transakci
            care.log(f"{cmd} failed: {e}")
            return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
