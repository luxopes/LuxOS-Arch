# LuxOS Care: sluzby zapnout hned pri instalaci (i v chrootu instalatoru); v live ISO
# je nespusti ConditionPathExists=!/run/archiso.
# shellcheck disable=SC2086  # seznam jednotek se zamerne rozdeli na slova
_units="luxos-care-update.timer luxos-care-check.timer luxos-care-boot.service"

post_install() {
    systemctl enable $_units >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl start luxos-care-update.timer luxos-care-check.timer >/dev/null 2>&1 || true
    fi
}

post_upgrade() {
    # Nove jednotky i u starsich instalaci (enable je idempotentni)
    systemctl enable $_units >/dev/null 2>&1 || true
    # Prechod na jadro LuxOS (LuxOS 0.9.7) hned po teto aktualizaci, ne az pri dalsi: bezi mimo
    # transakci a pocka na jeji konec (luxos-care kernel-switch; uz prepnuty system nic nedela)
    if [ -d /run/systemd/system ] && ! grep -qs '^KERNEL=linux-luxos' /etc/luxos/care.conf; then
        systemd-run --quiet --no-block --on-active=20 --unit="luxos-kernel-switch-$$" \
            /usr/bin/luxos-care kernel-switch >/dev/null 2>&1 || true
    fi
}

pre_remove() {
    systemctl disable --now luxos-care-update.timer luxos-care-check.timer >/dev/null 2>&1 || true
    systemctl disable luxos-care-boot.service >/dev/null 2>&1 || true
}
