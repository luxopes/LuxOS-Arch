# Maintainer: LuxOS Team
# xfce4-notifyd z Archu + historie oznameni jen pro dulezita oznameni: do logu (zvonek v horni
# liste) se ulozi jen oznameni s hintem x-luxos-keep (zmena casu, pripominky Kalendare). Ostatni
# (sit, internet, hlasitost, aplikace) se jen ukazou a nezustanou v historii. Po zavreni oznameni
# se zbyla posunou k okraji (puvodne zustala mezera). Klik na oznameni ho rozbali (cely text),
# dalsi klik spusti vychozi akci; zavira krizek v rohu, ktery se ukaze pri najeti mysi. Oznameni
# se prekryvajici s otevrenym popupem horni listy (Ovladaci centrum, Kalendar, nabidky, Launchpad)
# se do jeho zavreni skryje.
# Repozitar [luxos] je v /etc/lux/lux.conf pred [extra], takze ma tento balik prednost; pri nove
# verzi v Archu zvysit pkgver (a sha256sums), pkgrel nechat X.1.
# Puvodni PKGBUILD Archu (udrzovatele Evangelos Foutras, Robin Candau) je v PKGBUILD.arch.

pkgname=xfce4-notifyd
pkgver=0.9.7
pkgrel=3.3
pkgdesc="Notification daemon for the Xfce desktop (LuxOS: history keeps only important notices, click for details)"
arch=('x86_64')
url="https://docs.xfce.org/apps/notifyd/start"
license=('GPL-2.0-or-later')
groups=('xfce4-goodies')
depends=('libxfce4ui' 'libxfce4util' 'libnotify' 'xfconf' 'sqlite' 'libcanberra'
         'gtk-layer-shell' 'hicolor-icon-theme')
makedepends=('git' 'glib2-devel' 'xfce4-panel' 'xfce4-dev-tools')
source=("git+https://gitlab.xfce.org/apps/xfce4-notifyd.git#tag=$pkgname-$pkgver"
        'luxos-log-kept-only.patch'
        'luxos-reflow.patch'
        'luxos-click-detail.patch'
        'luxos-below-popups.patch')
sha256sums=('76dec9b137b06860402badfb820bccf6d2c7e6b00925e2cbb4d06c2674811d8f'
            'af4724bb96fbd7724c3e1bc160947c13e8f04e8cfd9a9e7546ab1a59a8851af1'
            'bbd01053c8b819f1f9ba99cd7f5ad0228133de51f8408fb5ccd006669cd0f133'
            '91a4e632555206cce288746e922a73fa8ba755cb6f8711a4c27109d2b51fadc6'
            '1bd968c0fa50827377f33cd17176ec5c38ee1473fd240d5167bde69921bdf6de')

prepare() {
  cd $pkgname
  # LuxOS: do historie jen oznameni s hintem x-luxos-keep
  patch -Np1 -i "$srcdir/luxos-log-kept-only.patch"
  # LuxOS: po zavreni oznameni se zbyla posunou (bez mezery)
  patch -Np1 -i "$srcdir/luxos-reflow.patch"
  # LuxOS: klik ukaze cele oznameni, krizek pri najeti mysi
  patch -Np1 -i "$srcdir/luxos-click-detail.patch"
  # LuxOS: oznameni pod otevrenym popupem horni listy skryte
  patch -Np1 -i "$srcdir/luxos-below-popups.patch"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-debug \
    --enable-maintainer-mode
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
