# Maintainer: LuxOS Team
# xfce4-notifyd z Archu + historie oznameni jen pro dulezita oznameni: do logu (zvonek v horni
# liste) se ulozi jen oznameni s hintem x-luxos-keep (zmena casu, pripominky Kalendare). Ostatni
# (sit, internet, hlasitost, aplikace) se jen ukazou a nezustanou v historii.
# Repozitar [luxos] je v /etc/lux/lux.conf pred [extra], takze ma tento balik prednost; pri nove
# verzi v Archu zvysit pkgver (a sha256sums), pkgrel nechat X.1.
# Puvodni PKGBUILD Archu (udrzovatele Evangelos Foutras, Robin Candau) je v PKGBUILD.arch.

pkgname=xfce4-notifyd
pkgver=0.9.7
pkgrel=3.1
pkgdesc="Notification daemon for the Xfce desktop (LuxOS: history keeps only important notices)"
arch=('x86_64')
url="https://docs.xfce.org/apps/notifyd/start"
license=('GPL-2.0-or-later')
groups=('xfce4-goodies')
depends=('libxfce4ui' 'libxfce4util' 'libnotify' 'xfconf' 'sqlite' 'libcanberra'
         'gtk-layer-shell' 'hicolor-icon-theme')
makedepends=('git' 'glib2-devel' 'xfce4-panel' 'xfce4-dev-tools')
source=("git+https://gitlab.xfce.org/apps/xfce4-notifyd.git#tag=$pkgname-$pkgver"
        'luxos-log-kept-only.patch')
sha256sums=('76dec9b137b06860402badfb820bccf6d2c7e6b00925e2cbb4d06c2674811d8f'
            'af4724bb96fbd7724c3e1bc160947c13e8f04e8cfd9a9e7546ab1a59a8851af1')

prepare() {
  cd $pkgname
  # LuxOS: do historie jen oznameni s hintem x-luxos-keep
  patch -Np1 -i "$srcdir/luxos-log-kept-only.patch"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-debug \
    --enable-maintainer-mode
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
