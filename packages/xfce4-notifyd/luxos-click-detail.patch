+/* LuxOS: vychozi akce oznameni - id "default", jinak akce bez popisku */
+static const gchar *
+xfce_notify_window_luxos_default_action(XfceNotifyWindow *window)
+{
+    if (window->actions == NULL)
+        return NULL;
+    for (gsize i = 0; i < window->actions->n_actions; ++i) {
+        if (g_strcmp0(window->actions->actions[i].id, "default") == 0)
+            return window->actions->actions[i].id;
+    }
+    for (gsize i = 0; i < window->actions->n_actions; ++i) {
+        const gchar *id = window->actions->actions[i].id;
+        const gchar *label = window->actions->actions[i].label;
+        if (id != NULL && *id != '\0' && (label == NULL || *label == '\0'))
+            return id;
+    }
+    return NULL;
+}
+
+static gboolean
+xfce_notify_window_luxos_label_cut(GtkWidget *label)
+{
+    return gtk_widget_get_visible(label)
+        && gtk_widget_get_realized(label)
+        && pango_layout_is_ellipsized(gtk_label_get_layout(GTK_LABEL(label)));
+}
+
+/* LuxOS: rozbalene = cely nadpis i text (vic radku, bez "...") */
+static void
+xfce_notify_window_luxos_set_expanded(XfceNotifyWindow *window, gboolean expanded)
+{
+    window->luxos_expanded = expanded;
+    /* rozumna mez jen pro extremne dlouhy text, aby okno nepreteklo obrazovku */
+    gtk_label_set_lines(GTK_LABEL(window->summary), expanded ? 6 : 1);
+    gtk_label_set_lines(GTK_LABEL(window->body), expanded ? 40 : 3);
+    gtk_widget_queue_resize(GTK_WIDGET(window));
+}
+
 static gboolean
 xfce_notify_window_button_release(GtkWidget *widget,
                                   GdkEventButton *evt)
 {
-    g_signal_emit(G_OBJECT(widget), signals[SIG_CLOSED], 0,
+    XfceNotifyWindow *window = XFCE_NOTIFY_WINDOW(widget);
+    const gchar *action;
+
+    /* LuxOS: klik na tlacitko (akce, krizek) vyridi tlacitko samo */
+    for (GtkWidget *w = gtk_get_event_widget((GdkEvent *)evt); w != NULL && w != widget; w = gtk_widget_get_parent(w)) {
+        if (GTK_IS_BUTTON(w))
+            return FALSE;
+    }
+
+    /* LuxOS: jiny nez levy klik oznameni zavre jako drive */
+    if (evt->button != GDK_BUTTON_PRIMARY) {
+        g_signal_emit(G_OBJECT(widget), signals[SIG_CLOSED], 0,
+                      XFCE_NOTIFY_CLOSE_REASON_DISMISSED);
+        return FALSE;
+    }
+
+    /* LuxOS: prvni klik ukaze cele oznameni (zkraceny nadpis/text) misto zavreni */
+    if (!window->luxos_expanded
+        && (xfce_notify_window_luxos_label_cut(window->summary)
+            || xfce_notify_window_luxos_label_cut(window->body)))
+    {
+        xfce_notify_window_luxos_set_expanded(window, TRUE);
+        return TRUE;
+    }
+
+    /* dalsi klik (nebo prvni, kdyz neni co rozbalit) spusti vychozi akci a zavre */
+    action = xfce_notify_window_luxos_default_action(window);
+    g_object_ref(window);
+    if (action != NULL) {
+        gchar *id = g_strdup(action);
+        g_signal_emit(G_OBJECT(window), signals[SIG_ACTION_INVOKED], 0, id);
+        g_free(id);
+    }
+    g_signal_emit(G_OBJECT(window), signals[SIG_CLOSED], 0,
                   XFCE_NOTIFY_CLOSE_REASON_DISMISSED);
+    g_object_unref(window);
 
-    return FALSE;
+    return TRUE;
+}
+
+static void
+xfce_notify_window_luxos_close_clicked(GtkWidget *button, gpointer user_data)
+{
+    g_signal_emit(G_OBJECT(user_data), signals[SIG_CLOSED], 0,
+                  XFCE_NOTIFY_CLOSE_REASON_DISMISSED);
 }
 
