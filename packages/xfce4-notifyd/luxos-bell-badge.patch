+/* LuxOS: neprectena oznameni = cervena tecka vpravo nahore na zvonku. Kreslime ji sami: ikony
+ * WhiteSur maji variantu "-new" s modrou teckou, kterou nacteni jako symbolicke ikony prebarvi
+ * barvou textu, takze tecka v liste skoro neni videt (a vlastni znak pak plugin nepridal).
+ * Kolem tecky se zvonek vymaze (mezera 1 px), aby byla ostra na svetle i tmave liste a pri 1x i 2x. */
+#define LUXOS_BADGE_RED_R (0xF2 / 255.0)
+#define LUXOS_BADGE_RED_G (0x3D / 255.0)
+#define LUXOS_BADGE_RED_B (0x3D / 255.0)
+
+static void
+luxos_draw_unread_badge(cairo_surface_t *surface, gint scale_factor) {
+  gdouble size = (gdouble)cairo_image_surface_get_width(surface) / MAX(scale_factor, 1);
+  gdouble r = MAX(2.0, (gdouble)(gint)(size * 0.2 + 0.5));
+  gdouble gap = MAX(1.0, (gdouble)(gint)(size / 16.0));
+  gdouble cx = size - r;
+  gdouble cy = r;
+  cairo_t *cr = cairo_create(surface);
+
+  /* gdk_cairo_surface_create_from_pixbuf nastavi device scale -> kreslime v logickych px */
+  cairo_set_operator(cr, CAIRO_OPERATOR_CLEAR);
+  cairo_arc(cr, cx, cy, r + gap, 0.0, 2 * G_PI);
+  cairo_fill(cr);
+
+  cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+  cairo_set_source_rgb(cr, LUXOS_BADGE_RED_R, LUXOS_BADGE_RED_G, LUXOS_BADGE_RED_B);
+  cairo_arc(cr, cx, cy, r, 0.0, 2 * G_PI);
+  cairo_fill(cr);
+
+  cairo_destroy(cr);
+}
