+#ifdef ENABLE_X11
+/* LuxOS: oznameni nikdy nad otevrenym vyskakovacim oknem horni listy (Ovladaci centrum, Kalendar,
+ * nabidka Whisker, nabidky panelu a jeho modulu, Launchpad/Hledani v rofi). Oznameni ma ve xfwm4
+ * vrstvu nad vsemi okny, proto ho sam WM pod popup nedostane. Notifyd proto sleduje mapovani oken
+ * na korenovem okne X (SubstructureNotify): zachyti i okna mimo luxos-hub (rofi, nabidky panelu),
+ * bez D-Bus, bez dotazovani a bez zavislosti na compositoru. Oznameni, ktere se s takovym oknem
+ * prekryva, se do jeho zavreni skryje (odpocet stoji), pak se ukaze s plnym casem. */
+static GList *luxos_windows = NULL;
+static GHashTable *luxos_popups = NULL;  /* XID okna na korenu -> GdkRectangle* */
+static guint luxos_update_id = 0;
+
+static void xfce_notify_window_luxos_check(XfceNotifyWindow *window);
+
+static Atom
+luxos_window_type(Display *dpy, Window w)
+{
+    Atom type = None, actual = None;
+    int format = 0;
+    unsigned long n = 0, after = 0;
+    unsigned char *data = NULL;
+
+    if (XGetWindowProperty(dpy, w, XInternAtom(dpy, "_NET_WM_WINDOW_TYPE", False), 0, 1, False,
+                           XA_ATOM, &actual, &format, &n, &after, &data) == Success
+        && data != NULL && n > 0 && format == 32)
+    {
+        type = ((Atom *)data)[0];
+    }
+    if (data != NULL)
+        XFree(data);
+    return type;
+}
+
+/* -1 = okno bez WM_CLASS (ramecek WM), 0 = jine okno, 1 = vyskakovaci okno horni listy */
+static gint
+luxos_classify(Display *dpy, Window w, gboolean override_redirect)
+{
+    XClassHint hint = { NULL, NULL };
+    const gchar *name, *klass;
+    gint ret = 0;
+
+    if (XGetClassHint(dpy, w, &hint) == 0)
+        return -1;
+    name = hint.res_name != NULL ? hint.res_name : "";
+    klass = hint.res_class != NULL ? hint.res_class : "";
+
+    if (g_ascii_strcasecmp(name, "luxos-control-center") == 0
+        || g_ascii_strcasecmp(name, "luxos-calendar") == 0
+        || g_ascii_strcasecmp(klass, "rofi") == 0)
+    {
+        ret = 1;
+    } else if (g_ascii_strcasecmp(klass, "xfce4-panel") == 0
+               || g_ascii_strcasecmp(klass, "wrapper-2.0") == 0)
+    {
+        /* panel a jeho moduly (Whisker, zvuk, zvonek): nabidky; samotna lista ani bubliny ne */
+        Atom type = luxos_window_type(dpy, w);
+        if (override_redirect) {
+            ret = type != XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_TOOLTIP", False)
+                && type != XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_NOTIFICATION", False)
+                && type != XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_DND", False);
+        } else {
+            ret = type == XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_MENU", False)
+                || type == XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_POPUP_MENU", False)
+                || type == XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_DROPDOWN_MENU", False);
+        }
+    }
+
+    if (hint.res_name != NULL)
+        XFree(hint.res_name);
+    if (hint.res_class != NULL)
+        XFree(hint.res_class);
+    return ret;
+}
+
+static gboolean
+luxos_update_all(gpointer data)
+{
+    luxos_update_id = 0;
+    for (GList *l = luxos_windows; l != NULL; l = l->next)
+        xfce_notify_window_luxos_check(XFCE_NOTIFY_WINDOW(l->data));
+    return G_SOURCE_REMOVE;
+}
+
+static void
+luxos_schedule_update(void)
+{
+    if (luxos_update_id == 0)
+        luxos_update_id = g_idle_add(luxos_update_all, NULL);
+}
+
+/* namapovane okno na korenu (popup s override-redirect, nebo ramecek WM s klientem uvnitr) */
+static void
+luxos_track(Display *dpy, Window w, gboolean override_redirect)
+{
+    gint kind = luxos_classify(dpy, w, override_redirect);
+
+    if (kind < 0 && !override_redirect) {
+        Window root_ret, parent_ret, *children = NULL;
+        unsigned int n = 0;
+        if (XQueryTree(dpy, w, &root_ret, &parent_ret, &children, &n) != 0) {
+            for (unsigned int i = 0; i < n && kind < 0; ++i)
+                kind = luxos_classify(dpy, children[i], FALSE);
+            if (children != NULL)
+                XFree(children);
+        }
+    }
+
+    if (kind == 1) {
+        Window root_ret;
+        int x, y;
+        unsigned int width, height, border, depth;
+        if (XGetGeometry(dpy, w, &root_ret, &x, &y, &width, &height, &border, &depth) != 0) {
+            GdkRectangle *rect = g_new(GdkRectangle, 1);
+            rect->x = x;
+            rect->y = y;
+            rect->width = width + 2 * border;
+            rect->height = height + 2 * border;
+            g_hash_table_replace(luxos_popups, GSIZE_TO_POINTER(w), rect);
+            luxos_schedule_update();
+        }
+    }
+}
+
+static GdkFilterReturn
+luxos_root_filter(GdkXEvent *gdk_xevent, GdkEvent *event, gpointer data)
+{
+    XEvent *xev = gdk_xevent;
+    Window root = GPOINTER_TO_SIZE(data);
+    GdkDisplay *display = gdk_display_get_default();
+
+    switch (xev->type) {
+        case MapNotify:
+            if (xev->xmap.event == root) {
+                gdk_x11_display_error_trap_push(display);
+                luxos_track(xev->xany.display, xev->xmap.window, xev->xmap.override_redirect);
+                gdk_x11_display_error_trap_pop_ignored(display);
+            }
+            break;
+        case UnmapNotify:
+            if (xev->xunmap.event == root
+                && g_hash_table_remove(luxos_popups, GSIZE_TO_POINTER(xev->xunmap.window)))
+            {
+                luxos_schedule_update();
+            }
+            break;
+        case DestroyNotify:
+            if (xev->xdestroywindow.event == root
+                && g_hash_table_remove(luxos_popups, GSIZE_TO_POINTER(xev->xdestroywindow.window)))
+            {
+                luxos_schedule_update();
+            }
+            break;
+        case ConfigureNotify:
+            if (xev->xconfigure.event == root) {
+                GdkRectangle *rect = g_hash_table_lookup(luxos_popups, GSIZE_TO_POINTER(xev->xconfigure.window));
+                if (rect != NULL) {
+                    rect->x = xev->xconfigure.x;
+                    rect->y = xev->xconfigure.y;
+                    rect->width = xev->xconfigure.width + 2 * xev->xconfigure.border_width;
+                    rect->height = xev->xconfigure.height + 2 * xev->xconfigure.border_width;
+                    luxos_schedule_update();
+                }
+            }
+            break;
+        default:
+            break;
+    }
+
+    return GDK_FILTER_CONTINUE;
+}
+
+static void
+luxos_watch_start(void)
+{
+    GdkDisplay *display = gdk_display_get_default();
+    GdkWindow *groot;
+    Display *dpy;
+    Window root, root_ret, parent_ret, *children = NULL;
+    unsigned int n = 0;
+    XWindowAttributes attrs;
+
+    if (luxos_popups != NULL || !GDK_IS_X11_DISPLAY(display))
+        return;
+
+    luxos_popups = g_hash_table_new_full(g_direct_hash, g_direct_equal, NULL, g_free);
+    groot = gdk_get_default_root_window();
+    dpy = gdk_x11_display_get_xdisplay(display);
+    root = gdk_x11_window_get_xid(groot);
+
+    gdk_window_set_events(groot, gdk_window_get_events(groot) | GDK_SUBSTRUCTURE_MASK);
+    gdk_window_add_filter(groot, luxos_root_filter, GSIZE_TO_POINTER(root));
+
+    gdk_x11_display_error_trap_push(display);
+    /* zachovat masky, ktere na koreni vybral GDK (vlastnosti korene, XSETTINGS) */
+    if (XGetWindowAttributes(dpy, root, &attrs) != 0)
+        XSelectInput(dpy, root, attrs.your_event_mask | SubstructureNotifyMask);
+    /* popup otevreny uz pri spusteni notifyd */
+    if (XQueryTree(dpy, root, &root_ret, &parent_ret, &children, &n) != 0) {
+        for (unsigned int i = 0; i < n; ++i) {
+            if (XGetWindowAttributes(dpy, children[i], &attrs) != 0 && attrs.map_state == IsViewable)
+                luxos_track(dpy, children[i], attrs.override_redirect);
+        }
+        if (children != NULL)
+            XFree(children);
+    }
+    gdk_x11_display_error_trap_pop_ignored(display);
+}
+#endif
+
+static void
+xfce_notify_window_luxos_set_suppressed(XfceNotifyWindow *window, gboolean suppressed)
+{
+    if (window->luxos_suppressed == suppressed)
+        return;
+    window->luxos_suppressed = suppressed;
+
+    if (suppressed) {
+        if (gtk_widget_get_visible(GTK_WIDGET(window))) {
+            /* odpocet stoji, dokud je oznameni skryte */
+            if (window->expire_id != 0) {
+                g_source_remove(window->expire_id);
+                window->expire_id = 0;
+            }
+            xfce_notify_window_reset_fade_and_slide(window);
+            window->mouse_hover = FALSE;
+            if (window->luxos_close != NULL)
+                gtk_widget_hide(window->luxos_close);
+            window->luxos_show_pending = TRUE;
+            gtk_widget_hide(GTK_WIDGET(window));
+        }
+    } else if (window->luxos_show_pending) {
+        window->luxos_show_pending = FALSE;
+        gtk_widget_show(GTK_WIDGET(window));
+    }
+}
+
+static void
+xfce_notify_window_luxos_check(XfceNotifyWindow *window)
+{
+    gboolean covered = FALSE;
+
+#ifdef ENABLE_X11
+    if (window->luxos_has_rect && luxos_popups != NULL) {
+        GHashTableIter iter;
+        gpointer value;
+        gint scale = gtk_widget_get_scale_factor(GTK_WIDGET(window));
+        GdkRectangle rect = {
+            window->luxos_rect.x * scale, window->luxos_rect.y * scale,
+            window->luxos_rect.width * scale, window->luxos_rect.height * scale,
+        };
+
+        g_hash_table_iter_init(&iter, luxos_popups);
+        while (!covered && g_hash_table_iter_next(&iter, NULL, &value))
+            covered = gdk_rectangle_intersect(&rect, value, NULL);
+    }
+#endif
+
+    xfce_notify_window_luxos_set_suppressed(window, covered);
+}
+
