APP_QUERY = r"""
pacman -Qqe | while read -r p; do
  bins=$(pacman -Qlq "$p" 2>/dev/null | grep -E '^/usr/bin/[^/]+$')
  b=$(printf '%s\n' "$bins" | grep -x "/usr/bin/$p" || printf '%s\n' "$bins" | grep -x "/usr/bin/${p#*-}" \
      || printf '%s\n' "$bins" | head -n 1)
  printf '%s\t%s\n' "$p" "$b"
done
"""
BIN_RE = re.compile(r"^/usr/bin/[A-Za-z0-9._+-]+$")


def list_apps():
    """{balik: prikaz} explicitne nainstalovanych balicku mimo zakladni system.

    Dotaz bezi uvnitr sandboxu (bez site); vystup je neduveryhodny, proto se filtruje."""
    out = subprocess.run([sys.executable, "-I", os.path.realpath(__file__), "__query"],
                         capture_output=True, text=True, errors="replace").stdout
    apps = {}
    for line in out.splitlines()[:2000]:
        name, _sep, cmd = CTRL_RE.sub("", line).strip().partition("\t")
        if name and PKG_RE.match(name) and name not in BASE_PACKAGES:
            apps[name] = cmd if BIN_RE.match(cmd) else ""
    return apps


def cmd_query(args):
    # Pomocny vnitrni prikaz pro list_apps (bez site a bez terminalu)
    spec = base_spec(["/bin/sh", "-c", APP_QUERY], tty=False, quiet=True)
    return launch(spec, stdin=subprocess.DEVNULL)


