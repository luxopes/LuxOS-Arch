def systemd_scope_available():
    rundir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return bool(shutil.which("systemd-run")) and os.path.exists(os.path.join(rundir, "systemd/private")) \
        and os.environ.get("LUXOS_SANDBOX_NO_SCOPE") != "1"


def launch(spec, stdin=None):
    """Spusti prikaz v sandboxu podle spec; vrati navratovy kod."""
    spec = dict(spec)
    spec.setdefault("tty", sys.stdin.isatty() and sys.stdout.isatty() and stdin is None)
    if spec.get("net"):
        if not shutil.which("pasta"):
            die(_("Network for the sandbox needs pasta (package passt)."))
        spec["host_addrs"] = host_addresses()
        spec["host_nets"] = host_networks()
        if spec["host_nets"] is None:
            die(_("Could not set up the sandbox network: %s") % "ip -j route")
    cmd = [sys.executable, "-I", os.path.realpath(__file__), "__enter"]
    env = dict(os.environ)
    env["LUXOS_SANDBOX_SPEC"] = json.dumps(spec)
    if spec.get("net"):
        cmd = ["pasta", "--config-net", "--quiet", "--no-map-gw", "-t", "none", "-u", "none", "-T", "none",
               "-U", "none", "--dns-forward", DNS_ADDR, "--", *cmd]
    if systemd_scope_available():
        ncpu = os.cpu_count() or 2
        quota = max(100, ncpu * 100 * 3 // 4)
        props = [f"{k}={v}" for k, v in LIMITS.items()] + [f"CPUQuota={quota}%"]
        cmd = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
               f"--unit=luxos-sandbox-{os.getpid()}-{secrets.token_hex(3)}",
               *[x for p in props for x in ("-p", p)], "--", *cmd]
    elif not spec.get("quiet"):
        info(_("Warning: systemd user session not available, running without memory/CPU limits."))
    try:
        r = subprocess.run(cmd, env=env, stdin=stdin)
    except KeyboardInterrupt:
        return 130
    return r.returncode


def bwrap_args(spec, fds):
    """Sestavi argumenty bwrap. fds: seznam FD, ktere musi zustat otevrene."""
    def keep(fd):
        os.set_inheritable(fd, True)
        fds.append(fd)
        return str(fd)

    def data_fd(content):
        fd = os.memfd_create("luxos-sandbox", 0)
        os.write(fd, content)
        os.lseek(fd, 0, os.SEEK_SET)
        return keep(fd)

    install = spec["mode"] == "install"
    root_fd = open_root()
    if root_fd is None:
        die(_("No sandbox yet. Create it with: luxos-sandbox create"))
    a = ["bwrap", "--unshare-all", "--die-with-parent", "--hostname", "sandbox", "--clearenv"]
    if spec.get("net"):
        a += ["--share-net"]          # sdili jen net namespace vytvoreny pastou, ne hostitele
    if not spec.get("tty"):
        a += ["--new-session"]        # bez ridiciho terminalu (ochrana proti TIOCSTI)
    if install:
        a += ["--uid", "0", "--gid", "0", "--cap-drop", "ALL", "--cap-add", "CAP_SYS_CHROOT"]
    else:
        a += ["--uid", str(spec["uid"]), "--gid", str(spec["gid"]), "--cap-drop", "ALL"]
    # Koren je cerstvy tmpfs od bwrap; trvale adresare se pripoji jako FD (bez symlinku)
    for d in PERSIST_DIRS:
        try:
            fd = open_sub(root_fd, d, create=(d in ("opt", "srv", "mnt", "root")), mode=0o755)
        except OSError:
            continue
        a += ["--bind-fd", keep(fd), "/" + d]
    for link, target in (("bin", "usr/bin"), ("sbin", "usr/bin"), ("lib", "usr/lib"), ("lib64", "usr/lib")):
        a += ["--symlink", target, "/" + link]
    a += ["--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", "/run",
          "--dir", "/run/luxos", "--tmpfs", "/home"]
    try:
        home_fd = open_sub(root_fd, "home/sandbox", create=True, mode=0o700)
    except OSError:
        die(_("The sandbox is damaged (home is not a directory). Run: luxos-sandbox reset"))
    a += ["--bind-fd", keep(home_fd), SANDBOX_HOME]
    if spec.get("shared"):
        try:
            shared_fd = open_shared()
        except OSError as e:
            die(_("Shared folder is not usable: %s") % e)
        try:
            os.unlink("Shared", dir_fd=home_fd)   # pripadny podvrzeny symlink
        except (FileNotFoundError, IsADirectoryError, PermissionError):
            pass
        except OSError:
            pass
        a += ["--bind-fd", keep(shared_fd), SHARED_IN]
    if spec.get("net"):
        a += ["--ro-bind-data", data_fd(f"nameserver {DNS_ADDR}\noptions edns0\n".encode()),
              "/run/luxos/resolv.conf"]
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin", "LANG": "C.UTF-8", "SHELL": "/bin/bash",
           "HOME": "/root" if install else SANDBOX_HOME, "USER": "root" if install else "sandbox",
           "LOGNAME": "root" if install else "sandbox", "XDG_RUNTIME_DIR": "/run/luxos/runtime",
           "TERM": spec.get("term") or "xterm-256color", "LUXOS_SANDBOX": "1",
           "PS1": r"\[\e[1;35m\][sandbox]\[\e[0m\] \w \$ "}
    a += ["--dir", "/run/luxos/runtime", "--chmod", "0700", "/run/luxos/runtime"]
    if spec.get("wayland"):
        # jediny soket Waylandu v sandboxu: vlastni soket wp-security-context, nikdy soket plochy
        a += ["--bind", spec["wayland"], "/run/luxos/runtime/wayland-0"]
        env.update({"WAYLAND_DISPLAY": "wayland-0", "XDG_SESSION_TYPE": "wayland", "GDK_BACKEND": "wayland,x11",
                    "QT_QPA_PLATFORM": "wayland;xcb", "MOZ_ENABLE_WAYLAND": "1",
                    "ELECTRON_OZONE_PLATFORM_HINT": "auto", "NO_AT_BRIDGE": "1"})
    if spec.get("x11"):
        a += ["--bind", spec["x11"], "/tmp/.X11-unix/X0",
              "--ro-bind-data", data_fd(bytes.fromhex(spec["xauth"])), "/run/luxos/Xauthority"]
        env.update({"DISPLAY": ":0", "XAUTHORITY": "/run/luxos/Xauthority", "NO_AT_BRIDGE": "1"})
        if not spec.get("wayland"):
            env.update({"GDK_BACKEND": "x11", "QT_QPA_PLATFORM": "xcb"})
    for k, v in env.items():
        a += ["--setenv", k, v]
    a += ["--seccomp", data_fd(filter_bytes(spec["mode"]))]
    a += ["--remount-ro", "/", "--chdir", "/root" if install else SANDBOX_HOME, "--"]
    a += spec["argv"]
    os.close(root_fd)
    return a


def open_shared():
    """~/Sandbox (vytvori se 0700); nesmi to byt symlink."""
    home_fd = open_dir_nofollow(os.path.dirname(SHARED_HOST))
    try:
        return open_sub(home_fd, os.path.basename(SHARED_HOST), create=True, mode=0o700)
    finally:
        os.close(home_fd)


def enter():
    """Vnitrni krok: (v namespace od pasty) priprava site a exec bwrap."""
    spec = json.loads(os.environ.pop("LUXOS_SANDBOX_SPEC"))
    _USER[:] = [spec["user"]]
    global IN_NS
    IN_NS = bool(spec.get("net"))
    if spec.get("net"):
        try:
            setup_netns(spec)
        except (OSError, subprocess.CalledProcessError, ValueError) as e:
            die(_("Could not set up the sandbox network: %s") % e)
    fds = []
    args = bwrap_args(spec, fds)
    if os.environ.get("LUXOS_SANDBOX_DEBUG") == "1":
        info(" ".join(args))
    try:
        os.execvp("bwrap", args)
    except FileNotFoundError:
        die(_("bubblewrap (bwrap) is not installed."))


def base_spec(argv, mode="run", **kw):
    spec = {"mode": mode, "argv": argv, "uid": os.getuid(), "gid": os.getgid(), "user": username(),
            "term": os.environ.get("TERM", "")}
    spec.update(kw)
    return spec


