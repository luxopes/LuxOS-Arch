# ---- bezpecne otevirani cest ------------------------------------------------
def open_dir_nofollow(path, trusted_owner=None):
    """Otevre adresar po jednotlivych komponentach bez nasledovani symlinku.

    trusted_owner: mnozina UID, ktere smi vlastnit kazdou komponentu (jinak chyba)
    a zadna komponenta nesmi byt zapisovatelna pro skupinu/ostatni (krome sticky /tmp).
    """
    if not path.startswith("/"):
        raise ValueError(path)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for comp in [c for c in path.split("/") if c]:
            if comp in (".", ".."):
                raise OSError(f"invalid path component in {path}")
            nfd = os.open(comp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
            if trusted_owner is not None:
                st = os.fstat(fd)
                if st.st_uid not in trusted_owner or (st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX):
                    raise OSError(f"unsafe ownership or permissions on {path} ({comp})")
        return fd
    except BaseException:
        os.close(fd)
        raise


def open_sub(dir_fd, rel, create=False, mode=0o755):
    """Otevre podadresar (rel bez ..) pod dir_fd s O_NOFOLLOW, volitelne ho vytvori."""
    fd = os.dup(dir_fd)
    try:
        for comp in [c for c in rel.split("/") if c]:
            if comp in (".", ".."):
                raise OSError("invalid path")
            try:
                nfd = os.open(comp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(comp, mode, dir_fd=fd)
                nfd = os.open(comp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
        return fd
    except BaseException:
        os.close(fd)
        raise


def root_path():
    return os.path.join(BASE, username())


def open_root():
    """FD korene sandboxu; overi, ze cesta je bezpecna a koren patri uzivateli (0700)."""
    if IN_NS:
        # V user namespace od pasty se root hostitele jevi jako overflowuid (65534)
        # a uzivatel jako 0
        try:
            with open("/proc/sys/kernel/overflowuid") as f:
                trusted = {int(f.read())}
        except (OSError, ValueError):
            trusted = {65534}
        if TESTING:
            trusted.add(0)
    else:
        trusted = {0, os.getuid()} if TESTING else {0}
    try:
        base_fd = open_dir_nofollow(BASE, trusted)
    except FileNotFoundError:
        return None
    try:
        fd = os.open(username(), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=base_fd)
    except FileNotFoundError:
        return None
    finally:
        os.close(base_fd)
    st = os.fstat(fd)
    if st.st_uid != os.getuid():
        os.close(fd)
        die(_("Sandbox directory is not owned by you: %s") % root_path())
    if st.st_mode & 0o077:
        os.fchmod(fd, 0o700)
    try:
        os.stat("usr/bin", dir_fd=fd, follow_symlinks=False)
    except FileNotFoundError:
        os.close(fd)
        return None   # prazdny/rozpracovany adresar
    return fd


def exists():
    fd = open_root()
    if fd is None:
        return False
    os.close(fd)
    return True


