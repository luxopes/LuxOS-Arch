def cmd_versions(args):
    # Pro lux update: "balik verze" v sandboxu (balicky z komunity se tu aktualizuji z AUR)
    fd = open_root()
    if fd is None:
        return 1
    try:
        for name, ver in sorted(sandbox_packages(fd, versions=True).items()):
            if VERSION_RE.match(ver):
                print(name, ver)
    finally:
        os.close(fd)
    return 0


def cmd_command_hint(args):
    """Obsluha "command not found": prikaz je jen v sandboxu (obal chybel) -> spoustece obnovit a poradit."""
    if len(args) != 1 or not CMD_RE.match(args[0]):
        return 1
    cmd = args[0]
    try:
        apps = sync_launchers()
    except Exception:   # noqa: BLE001
        return 1
    if not any(cmd in a["commands"] for a in apps):
        return 1
    gui = any(a["commands"].get(cmd) for a in apps)
    in_path = os.path.realpath(BIN_DIR) in {os.path.realpath(d) for d in os.environ.get("PATH", "").split(":") if d}
    if in_path:
        start = cmd
    else:
        start = f"luxos-sandbox run {'--gui ' if gui else ''}--net -- {cmd}"
    print(_("%s is installed in the sandbox (without access to your files). Start it with: %s") % (cmd, start))
    if not in_path:
        print(_("In a new terminal window just type: %s") % cmd)
    return 0


def launcher_notice(cmd):
    """Jednou za prihlaseni a prikaz (jen v terminalu): ze prikaz bezi v sandboxu."""
    if not sys.stderr.isatty():
        return
    rundir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    d = os.path.join(rundir, "luxos-sandbox")
    name = re.sub(r"[^A-Za-z0-9._+-]", "_", os.path.basename(cmd))
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        os.close(os.open(os.path.join(d, "notice-" + name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600))
    except OSError:
        return   # uz oznameno (nebo nejde zapsat - pak radeji nic)
    info("\033[2m" + _("%s runs in the sandbox: internet only, no access to your files.") % name + "\033[0m")


def du(fd):
    total = 0
    for _root, _dirs, files, rootfd in os.fwalk(".", dir_fd=fd, follow_symlinks=False):
        for name in files:
            try:
                total += os.stat(name, dir_fd=rootfd, follow_symlinks=False).st_blocks * 512
            except OSError:
                pass
    return total


def cmd_status(args):
    fd = open_root()
    if fd is None:
        if "--json" in args:
            print(json.dumps({"exists": False}))
        else:
            print(_("No sandbox yet. Create it with: luxos-sandbox create"))
        return 1
    size = du(fd)
    os.close(fd)
    if "--json" in args:
        print(json.dumps({"exists": True, "path": root_path(), "size": size, "shared": SHARED_HOST,
                          "link": f"/dev/sandbox/{username()}", "apps": list_apps(),
                          "trusted_display": trusted_display_commands()}))
        return 0
    print(_("Sandbox: %s") % root_path())
    if os.path.islink(f"/dev/sandbox/{username()}"):
        print(_("Link: %s") % f"/dev/sandbox/{username()}")
    print(_("Size: %s") % f"{size / 1024 / 1024:.0f} MiB")
    print(_("Shared folder: %s (only with --shared)") % SHARED_HOST)
    apps = list_apps()
    print(_("Installed apps: %s") % (", ".join(apps) if apps else _("none")))
    return 0


def cmd_trusted_display(args):
    """luxos-sandbox trusted-display [--json] | PRIKAZ on|off - vyslovne povoleni pro jeden prikaz."""
    if not args or args == ["--json"]:
        cmds = trusted_display_commands()
        if args:
            print(json.dumps({"trusted_display": cmds}))
        else:
            print(_("Trusted display: %s") % (", ".join(cmds) if cmds else _("none")))
        return 0
    if len(args) != 2 or args[1] not in ("on", "off") or not CMD_NAME_RE.match(args[0]):
        die(_("Usage: luxos-sandbox trusted-display [<command> on|off]"))
    cmds = set(trusted_display_commands())
    (cmds.add if args[1] == "on" else cmds.discard)(args[0])
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = TRUSTED_DISPLAY_FILE + f".tmp-{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("".join(c + "\n" for c in sorted(cmds)))
    os.replace(tmp, TRUSTED_DISPLAY_FILE)
    if args[1] == "on":
        print(_("%s will use a trusted display: faster drawing, but if the app breaks out of its sandbox "
                "window, it can see and type into your other windows.") % args[0])
    else:
        print(_("%s uses the protected display again.") % args[0])
    return 0


def cmd_shell(args):
    require_sandbox()
    net = "--net" in args
    shared = "--shared" in args
    return launch(base_spec(["/bin/bash", "-l"], net=net, shared=shared))


def import_file(path):
    """Zkopiruje soubor hostitele do ~/Downloads v sandboxu (data pres stdin, nikdy bind)."""
    try:
        f = open(path, "rb")
    except OSError as e:
        die(str(e))
    if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
        die(_("Not a regular file: %s") % path)
    name = re.sub(r"[^A-Za-z0-9._+-]", "_", os.path.basename(path)).lstrip(".") or "program"
    script = 'mkdir -p "$HOME/Downloads" && cat > "$HOME/Downloads/$1" && chmod 755 "$HOME/Downloads/$1"'
    with f:
        rc = launch(base_spec(["/bin/sh", "-c", script, "sh", name], tty=False), stdin=f)
    if rc != 0:
        die(_("Copying the file into the sandbox failed."))
    return f"{SANDBOX_HOME}/Downloads/{name}"


def is_host_file(arg):
    """Soubor hostitele ke zkopirovani: relativni cesta s '/' (./program) nebo cesta
    v domove, /tmp ci na vymennem mediu. Systemove cesty (/usr/bin/...) patri sandboxu."""
    if "/" not in arg:
        return False
    path = os.path.abspath(os.path.expanduser(arg))
    if not (arg.startswith(("./", "../", "~/")) or not arg.startswith("/")):
        roots = [os.path.expanduser("~"), "/tmp", "/media", "/run/media", "/mnt"]
        if TESTING:
            roots.append(os.environ.get("LUXOS_SANDBOX_TEST_IMPORT_ROOT", "/nonexistent"))
        if not any(path == r or path.startswith(r.rstrip("/") + "/") for r in roots):
            return False
    return os.path.isfile(path)


def parse_run_opts(args):
    opts = {"net": False, "gui": False, "shared": False, "launcher": False}
    while args and args[0].startswith("--"):
        a = args.pop(0)
        if a == "--":
            break
        if a[2:] not in opts:
            die(_("Unknown option: %s") % a)
        opts[a[2:]] = True
    return opts, args


def cmd_run(args):
    opts, argv = parse_run_opts(list(args))
    if opts["launcher"] and not exists():
        # spoustec z doby, kdy sandbox existoval (napr. smazany jinak nez luxos-sandbox destroy): uklidit
        sync_quietly()
    require_sandbox()
    if not argv:
        die(_("Usage: luxos-sandbox run [--net] [--gui] [--shared] <command...>"))
    if opts["launcher"]:
        launcher_notice(argv[0])
    if is_host_file(argv[0]):
        print(_("Copying %s into the sandbox...") % argv[0], file=sys.stderr)
        argv[0] = import_file(os.path.expanduser(argv[0]))
    spec = base_spec(argv, net=opts["net"], shared=opts["shared"])
    xe = wl = None
    try:
        if opts["gui"] and wayland_socket():
            app_id = re.sub(r"[^A-Za-z0-9._+-]", "_", os.path.basename(argv[0]))[:64] or "app"
            wl = WaylandListener(app_id)
            spec["wayland"] = wl.start()
            xe = SandboxXwayland(spec["wayland"], wl.instance)
            xsock = xe.start()
            if xsock:
                spec["x11"] = xsock
                spec["xauth"] = xauth_record(xe.cookie).hex()
            spec["tty"] = False
        elif opts["gui"]:
            trusted = os.path.basename(argv[0]) in trusted_display_commands()
            if trusted:
                info(_("Warning: %s uses a trusted display (set in Sandbox). If the app breaks out of its "
                       "sandbox window, it can see and type into your other windows.") % os.path.basename(argv[0]))
            xe = Xephyr("Sandbox - " + os.path.basename(argv[0]), trusted=trusted)
            spec["x11"] = xe.start()
            spec["xauth"] = xauth_record(xe.cookie).hex()
            spec["tty"] = False
        return launch(spec)
    finally:
        if xe:
            xe.stop()
        if wl:
            wl.stop()


def valid_pkgs(pkgs):
    if not pkgs:
        die(_("No package given."))
    for p in pkgs:
        if not PKG_RE.match(p):
            die(_("Invalid package name: %s") % p)
    return pkgs


def cmd_install(args):
    require_sandbox()
    pkgs = valid_pkgs(args)
    # Stazene balicky se po instalaci smazou (sandbox nema drzet vlastni cache)
    script = ('/usr/bin/pacman -Syu --needed --noconfirm --disable-sandbox -- "$@"; rc=$?; '
              'rm -f /var/cache/pacman/pkg/*.pkg.tar.* /var/cache/pacman/pkg/*.sig 2>/dev/null; exit $rc')
    spec = base_spec(["/bin/sh", "-c", script, "sh", *pkgs], mode="install", net=True)
    rc = launch(spec)
    sync_quietly()
    return rc


BUILD_DIR = SANDBOX_HOME + "/.cache/lux-build"


def cmd_build_install(args):
    """Sestaveni a instalace balicku ze skriptu PKGBUILD (zdroj komunita/AUR) uvnitr sandboxu.

    luxos-sandbox build-install [--asdeps] [--deps "a b"] NAZEV < tar
    Na stdin je tar adresare s PKGBUILD (lux ho stahl a zkontroloval na hostiteli - sestavuje se presne ten).
    Postup: zavislosti z repozitaru Archu (jako root sandboxu) -> rozbaleni a makepkg jako uzivatel sandboxu
    (se siti, skript bezi jen uvnitr) -> pacman -U (root sandboxu). Na hostitele se nic nezapisuje."""
    require_sandbox()
    args = list(args)
    asdeps = "--asdeps" in args
    deps = []
    while args and args[0].startswith("--"):
        a = args.pop(0)
        if a == "--deps" and args:
            deps = args.pop(0).split()
        elif a != "--asdeps":
            die(_("Unknown option: %s") % a)
    if len(args) != 1:
        die(_("Usage: luxos-sandbox build-install [--asdeps] [--deps \"a b\"] <name> < directory.tar"))
    name = valid_pkgs(args)[0]
    deps = valid_pkgs(deps) if deps else []
    tty = sys.stdin.isatty()
    if tty:
        die(_("The build directory is expected as a tar archive on standard input."))
    # 1) nastroje pro sestaveni a zavislosti (jen repozitare Archu v sandboxu)
    script = ('/usr/bin/pacman -Syu --needed --noconfirm --disable-sandbox base-devel git && '
              'if [ $# -gt 0 ]; then /usr/bin/pacman -S --needed --asdeps --noconfirm --disable-sandbox -- "$@"; fi; '
              'rc=$?; rm -f /var/cache/pacman/pkg/*.pkg.tar.* /var/cache/pacman/pkg/*.sig 2>/dev/null; exit $rc')
    print(_("Preparing build tools in the sandbox..."), file=sys.stderr)
    if launch(base_spec(["/bin/sh", "-c", script, "sh", *deps], mode="install", net=True, tty=False),
              stdin=subprocess.DEVNULL) != 0:
        die(_("Installing the build tools into the sandbox failed."))
    # 2) rozbaleni (data jdou pres stdin) a sestaveni jako uzivatel sandboxu
    d = f"{BUILD_DIR}/{name}"
    unpack = f'rm -rf "{d}" && mkdir -p "{d}" && tar -x --no-same-owner --no-same-permissions -C "{d}" -f -'
    if launch(base_spec(["/bin/sh", "-c", unpack], tty=False), stdin=sys.stdin.buffer) != 0:
        die(_("Copying the build files into the sandbox failed."))
    print(_("Building %s in the sandbox...") % name, file=sys.stderr)
    # Podepsane zdroje (validpgpkeys, napr. neofetch): klice autoru do klicenky uzivatele SANDBOXU
    # (jako yay/paru, hostitel se nemeni), jinak makepkg skonci "unknown public key". Jen otisky
    # hex; keys.openpgp.org casto nema ID uzivatele, proto i keyserver.ubuntu.com.
    build = (f'cd "{d}" && for k in $(makepkg --printsrcinfo 2>/dev/null | sed -n "s/^[[:space:]]*validpgpkeys = //p" '
             '| grep -E "^[0-9A-Fa-f]{8,40}$" | sort -u); do gpg --list-keys "$k" >/dev/null 2>&1 && continue; '
             'echo "PGP: $k" >&2; gpg --batch --recv-keys "$k" >/dev/null 2>&1 || '
             'gpg --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys "$k" >/dev/null 2>&1 || '
             'echo "PGP key $k could not be downloaded" >&2; done; makepkg -f --noconfirm --noprogressbar')
    if launch(base_spec(["/bin/sh", "-c", build], net=True, tty=False), stdin=subprocess.DEVNULL) != 0:
        die(_("Building %s in the sandbox failed.") % name)
    # 3) instalace vysledku (bez ladicich -debug balicku)
    inst = (f'set -- $(ls "{d}"/*.pkg.tar.* 2>/dev/null | grep -v -- "-debug-" | grep -v "\\.sig$"); '
            '[ $# -gt 0 ] || { echo "no package was built" >&2; exit 1; }; '
            f'/usr/bin/pacman -U --needed --noconfirm --disable-sandbox {"--asdeps " if asdeps else ""}-- "$@"; rc=$?; '
            f'rm -rf "{d}"; exit $rc')
    rc = launch(base_spec(["/bin/sh", "-c", inst], mode="install", tty=False), stdin=subprocess.DEVNULL)
    sync_quietly()
    if rc != 0:
        die(_("Installing %s into the sandbox failed.") % name)
    return 0


def cmd_remove_app(args):
    require_sandbox()
    pkgs = valid_pkgs(args)
    spec = base_spec(["/usr/bin/pacman", "-Rns", "--noconfirm", "--", *pkgs], mode="install")
    rc = launch(spec)
    sync_quietly()
    return rc


def confirm(question, args):
    if "--yes" in args or "-y" in args:
        return True
    if not sys.stdin.isatty():
        die(_("Confirmation needed: add --yes"))
    ans = input(question + " [" + _("yes") + "/" + _("no") + "] ").strip().lower()
    return ans in ("y", "yes", _("yes"))


def cmd_reset(args):
    if not confirm(_("Wipe the whole sandbox (all installed apps and files inside) and create it again?"), args):
        return 1
    r = subprocess.run(["pkexec", HELPER, "reset"])
    sync_quietly()
    if r.returncode != 0:
        die(_("Resetting the sandbox failed."))
    print(_("Sandbox is ready: %s") % root_path())
    return 0


def cmd_destroy(args):
    if not os.path.isdir(root_path()):
        print(_("No sandbox yet. Create it with: luxos-sandbox create"))
        return 0
    if not confirm(_("Delete the sandbox with everything inside? (~/Sandbox stays)"), args):
        return 1
    r = subprocess.run(["pkexec", HELPER, "destroy"])
    sync_quietly()
    if r.returncode != 0:
        die(_("Deleting the sandbox failed."))
    print(_("Sandbox deleted."))
    return 0


