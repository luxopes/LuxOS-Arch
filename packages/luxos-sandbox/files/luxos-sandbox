BASE = os.environ.get("LUXOS_SANDBOX_BASE", "/var/lib/luxos/sandbox") if TESTING else "/var/lib/luxos/sandbox"
HELPER = "/usr/lib/luxos/sandbox/luxos-sandbox-helper"
SHARED_HOST = os.path.expanduser("~/Sandbox")
if TESTING and os.environ.get("LUXOS_SANDBOX_SHARED"):
    SHARED_HOST = os.environ["LUXOS_SANDBOX_SHARED"]
SANDBOX_HOME = "/home/sandbox"
SHARED_IN = SANDBOX_HOME + "/Shared"
DNS_ADDR = "169.254.1.53"
# Trvale adresare korene (ostatni cesty v / jsou docasne - tmpfs)
PERSIST_DIRS = ("usr", "etc", "var", "opt", "srv", "root", "mnt")
# Balicky zakladniho systemu (shodne s pomocnikem) - nejsou to "aplikace"
BASE_PACKAGES = ("base", "filesystem", "bash", "coreutils", "pacman", "archlinux-keyring", "ca-certificates",
                 "sed", "grep", "gawk", "findutils", "tar", "gzip", "xz", "zstd", "less", "nano",
                 "which", "procps-ng", "curl", "file", "diffutils", "glibc")
PKG_RE = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]*$")
