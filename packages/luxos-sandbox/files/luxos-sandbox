def sandbox_bin_exists(root_fd, name):
    try:
        st = os.stat(f"usr/bin/{name}", dir_fd=root_fd, follow_symlinks=False)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode)


def desktop_exec_command(value, bins):
    """Prikaz z radku Exec= jen pro VYBER mezi binarkami balicku - samotny radek se nikdy nepouzije."""
    import shlex
    try:
        words = shlex.split(value)
    except ValueError:
        return ""
    while words and (words[0] == "env" or "=" in words[0] and not words[0].startswith("/")):
        words.pop(0)
    if not words:
        return ""
    name = words[0].rsplit("/", 1)[-1]
    return name if name in bins else ""


def collect_launchers(root_fd):
    """Spoustece podle obsahu sandboxu: [{package, commands: {prikaz: gui}, desktops: [...]}]."""
    apps, total_cmds, total_desktops = [], 0, 0
    for pkg, files in sorted(sandbox_packages(root_fd).items()):
        bins = sorted({f[8:] for f in files if f.startswith("usr/bin/") and CMD_RE.match(f[8:])})
        bins = [b for b in bins if sandbox_bin_exists(root_fd, b)][:MAX_CMDS_PER_PKG]
        desktops = []
        for f in files:
            m = DESKTOP_RE.match(f)
            if not m or len(desktops) >= MAX_DESKTOPS_PER_PKG or total_desktops >= MAX_DESKTOPS:
                continue
            data = read_at(root_fd, f, 64 * 1024)
            if not data:
                continue
            keys = parse_desktop(data)
            if keys.get("Type") != "Application" or any(
                    keys.get(k, "").lower() == "true" for k in ("NoDisplay", "Hidden", "Terminal")):
                continue
            cmd = desktop_exec_command(keys.get("Exec", ""), bins) or main_command(pkg, bins)
            name = clean_text(localized(keys, "Name"), 60)
            if not cmd or not name:
                continue
            fid = re.sub(r"[^A-Za-z0-9._-]", "_", f"{DESKTOP_PREFIX}{pkg}--{m.group(1)}")
            cats = [c for c in keys.get("Categories", "").split(";") if c in CATEGORIES][:3]
            desktops.append({"id": fid, "name": name, "comment": clean_text(localized(keys, "Comment"), 160),
                             "categories": cats, "command": cmd,
                             "icon": find_icon(root_fd, keys.get("Icon", ""))})
            total_desktops += 1
        gui = {d["command"] for d in desktops}
        commands = {}
        for b in bins:
            if total_cmds >= MAX_CMDS:
                break
            if command_allowed(b) and not host_command_exists(b):
                commands[b] = b in gui
                total_cmds += 1
        apps.append({"package": pkg, "main": main_command(pkg, bins), "commands": commands, "desktops": desktops})
    return apps


def write_if_changed(dir_path, name, content, mode):
    """Atomicky zapis do vlastni slozky uzivatele; beze zmeny se soubor nemeni (Launchpad nic neprepocita)."""
    path = os.path.join(dir_path, name)
    try:
        with open(path, "rb") as f:
            if f.read(len(content) + 1) == content and stat.S_IMODE(os.fstat(f.fileno()).st_mode) == mode:
                return
    except OSError:
        pass
    tmp = os.path.join(dir_path, f".{name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(content)
            os.fchmod(f.fileno(), mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def has_mark(path, mark):
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return False
        with open(path, "rb") as f:
            return mark.encode() in f.read(4096)
    except OSError:
        return False


def wrapper_script(pkg, cmd, gui):
    flags = "--gui --net" if gui else "--net"
    return (f"#!/bin/sh\n{WRAPPER_MARK} ({pkg})\n"
            f"# Generated by luxos-sandbox sync-launchers - changes are overwritten.\n"
            f"exec {SELF} run {flags} --launcher -- /usr/bin/{cmd} \"$@\"\n").encode()


def desktop_text(pkg, d, icon):
    lines = ["[Desktop Entry]", "Type=Application", "Name=" + _("%s (Sandbox)") % d["name"]]
    if d["comment"]:
        lines.append("Comment=" + d["comment"])
    # StartupWMClass = app_id okna (luxos-sandbox ho dava podle prikazu): Dock a lista najdou ikonu a nazev
    lines += [f"Exec={SELF} run --gui --net --launcher -- /usr/bin/{d['command']}", "Icon=" + icon,
              "Terminal=false", "StartupNotify=false", "StartupWMClass=" + d["command"]]
    if d["categories"]:
        lines.append("Categories=" + ";".join(d["categories"]) + ";")
    lines.append(f"{DESKTOP_MARK}={pkg}")
    return ("\n".join(lines) + "\n").encode()


def sync_launchers():
    """Srovna obaly prikazu, polozky Launchpadu a ikony s obsahem sandboxu (opakovane volani nic nemeni)."""
    import fcntl
    root_fd = open_root()
    try:
        apps = collect_launchers(root_fd) if root_fd is not None else []
    finally:
        if root_fd is not None:
            os.close(root_fd)
    for d in (LAUNCH_DIR, BIN_DIR, ICON_DIR, APPS_DIR):
        os.makedirs(d, mode=0o755, exist_ok=True)
    with open(os.path.join(LAUNCH_DIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        want_bin, want_desk, want_icon = set(), set(), set()
        for app in apps:
            for cmd, gui in app["commands"].items():
                write_if_changed(BIN_DIR, cmd, wrapper_script(app["package"], cmd, gui), 0o755)
                want_bin.add(cmd)
            for d in app["desktops"]:
                icon = "luxos-sandbox"
                if d["icon"]:
                    data, ext = d["icon"]
                    iname = f"{d['id']}.{ext}"
                    write_if_changed(ICON_DIR, iname, data, 0o644)
                    want_icon.add(iname)
                    icon = os.path.join(ICON_DIR, iname)
                write_if_changed(APPS_DIR, d["id"] + ".desktop", desktop_text(app["package"], d, icon), 0o644)
                want_desk.add(d["id"] + ".desktop")
        # zastarale: jen soubory, ktere vytvoril luxos-sandbox (znacka), nic ciziho
        for name in os.listdir(BIN_DIR):
            p = os.path.join(BIN_DIR, name)
            if name not in want_bin and has_mark(p, WRAPPER_MARK):
                os.unlink(p)
        for name in os.listdir(APPS_DIR):
            p = os.path.join(APPS_DIR, name)
            if (name.startswith(DESKTOP_PREFIX) and name.endswith(".desktop") and name not in want_desk
                    and has_mark(p, DESKTOP_MARK + "=")):
                os.unlink(p)
        for name in os.listdir(ICON_DIR):
            p = os.path.join(ICON_DIR, name)
            if name not in want_icon and not os.path.isdir(p):
                os.unlink(p)
    return apps


def launchers_json(apps):
    return {"bin": BIN_DIR, "apps": [
        {"package": a["package"], "main": a["main"], "commands": sorted(a["commands"]),
         "gui": [{"name": _("%s (Sandbox)") % d["name"], "command": d["command"]} for d in a["desktops"]]}
        for a in apps]}


def sync_quietly():
    """Po zmene sandboxu: chyba spoustecu nikdy neshodi samotnou operaci."""
    try:
        sync_launchers()
    except Exception as e:   # noqa: BLE001 - jen varovani
        info(_("Warning: could not update the sandbox app launchers: %s") % e)


def cmd_sync_launchers(args):
    apps = sync_launchers()
    if "--json" in args:
        print(json.dumps(launchers_json(apps)))
    elif "--quiet" not in args:
        cmds = sorted({c for a in apps for c in a["commands"]})
        guis = sorted(_("%s (Sandbox)") % d["name"] for a in apps for d in a["desktops"])
        print(_("Commands: %s") % (", ".join(cmds) if cmds else _("none")))
        print(_("Launchpad: %s") % (", ".join(guis) if guis else _("none")))
    return 0


def cmd_has_app(args):
    # Pro lux remove: je balik nainstalovany v sandboxu jako aplikace?
    if len(args) != 1 or not PKG_RE.match(args[0]):
        return 2
    fd = open_root()
    if fd is None:
        return 1
    try:
        return 0 if args[0] in sandbox_packages(fd, apps_only=False) else 1
