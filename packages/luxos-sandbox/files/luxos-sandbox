def cmd_create(args):
    if exists():
        print(_("Sandbox already exists: %s") % root_path())
        return 0
    if not os.path.exists(HELPER):
        die(_("Helper not found: %s") % HELPER)
    print(_("Creating sandbox (minimal Arch Linux system), this can take a few minutes..."))
    r = subprocess.run(["pkexec", HELPER, "create"])
    if r.returncode != 0:
        die(_("Creating the sandbox failed."))
    try:
        os.close(open_shared())
