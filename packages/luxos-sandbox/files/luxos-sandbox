        print(f"  {cmd}")
        print(f"      {_(desc)}")


def on_signal(signum, _frame):
    # SIGTERM/SIGHUP -> beznou cestou ven, aby se ukoncil i Xephyr (finally v cmd_run)
    raise SystemExit(128 + signum)


def main():
    import signal
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    if os.geteuid() == 0 and argv[0] not in ("__enter",):
        die(_("Run luxos-sandbox as a normal user, not root."))
    cmd, args = argv[0], argv[1:]
    table = {"create": cmd_create, "status": cmd_status, "shell": cmd_shell, "run": cmd_run,
             "install": cmd_install, "build-install": cmd_build_install, "remove-app": cmd_remove_app, "reset": cmd_reset,
             "destroy": cmd_destroy, "__query": cmd_query, "sync-launchers": cmd_sync_launchers,
             "__has-app": cmd_has_app, "__command-hint": cmd_command_hint}
    if cmd == "__enter":
        enter()
        return 1
    if cmd not in table:
        die(_("Unknown command: %s") % cmd)
    return table[cmd](args) or 0


if __name__ == "__main__":
    sys.exit(main())
