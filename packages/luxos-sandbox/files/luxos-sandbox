def read_regular(dir_fd, name, limit):
    """Obsah regularniho souboru name primo v adresari dir_fd (bez symlinku, FIFO apod.), nejvys limit bajtu."""
    if not name or "/" in name or name in (".", ".."):
        return None
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=dir_fd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            return None
        chunks, size = [], 0
        while size <= limit:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
        return b"".join(chunks) if size <= limit else None
    except OSError:
        return None
    finally:
        os.close(fd)


def read_at(root_fd, rel, limit):
    """Soubor rel (relativne ke koreni sandboxu) - kazda komponenta s O_NOFOLLOW, nikdy mimo koren."""
    d, _sep, name = rel.rpartition("/")
    if not all(PATH_COMP_RE.match(c) for c in rel.split("/")):
        return None
    try:
        dfd = open_sub(root_fd, d) if d else os.dup(root_fd)
    except OSError:
        return None
    try:
        return read_regular(dfd, name, limit)
    finally:
        os.close(dfd)


def db_sections(data):
    """Sekce souboru databaze balicku (%NAME%, %REASON%, %FILES% ...) -> {sekce: [radky]}."""
    out, cur = {}, None
    for line in data.decode("utf-8", "replace").splitlines():
        if len(line) > 2 and line.startswith("%") and line.endswith("%"):
            cur = out.setdefault(line[1:-1], [])
        elif cur is not None and line:
            cur.append(line)
    return out


def sandbox_packages(root_fd, apps_only=True, versions=False):
    """{balik: [soubory]} explicitne nainstalovanych balicku mimo zakladni system;
    versions=True: {balik: verze} vsech balicku mimo zakladni system (i zavislosti).

    Cte se primo databaze balicku v koreni (bez spousteni sandboxu, rychle i pri prihlaseni)."""
    try:
        dbfd = open_sub(root_fd, LOCAL_DB)
    except OSError:
        return {}
    pkgs = {}
    try:
        try:
            entries = sorted(e for e in os.listdir(dbfd) if DBENTRY_RE.match(e))
        except OSError:
            return {}
        for entry in entries:
            if len(pkgs) >= MAX_PACKAGES:
                break
            try:
                efd = os.open(entry, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dbfd)
            except OSError:
                continue
            try:
                desc = read_regular(efd, "desc", 256 * 1024)
                if not desc:
                    continue
                sec = db_sections(desc)
                name = (sec.get("NAME") or [""])[0]
                if not PKG_RE.match(name) or not entry.startswith(name + "-") or name in BASE_PACKAGES:
                    continue
                if apps_only and name in BUILD_PACKAGES:
                    continue
                if versions:
                    pkgs[name] = (sec.get("VERSION") or [""])[0].strip()
                    continue
                if (sec.get("REASON") or ["0"])[0].strip() != "0":
                    continue   # zavislost, ne aplikace
                files = read_regular(efd, "files", 16 * 1024 * 1024)
                pkgs[name] = (db_sections(files).get("FILES") or [])[:200000] if files else []
            finally:
                os.close(efd)
    finally:
        os.close(dbfd)
    return pkgs


def clean_text(value, limit):
    """Text ze sandboxu pro .desktop: bez ridicich a neviditelnych znaku a escape sekvenci, zkraceny."""
    value = TEXT_BAD_RE.sub("", value.replace("\\s", " ").replace("\\n", " ").replace("\\t", " "))
    value = " ".join(value.replace("\\", "").split())
    return value[:limit].strip()


def parse_desktop(data):
    """Klice skupiny [Desktop Entry] (jen ta, prvni vyskyt klice plati)."""
    keys, group = {}, None
    for line in data.decode("utf-8", "replace").splitlines()[:2000]:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            if group == "Desktop Entry":
                break
            group = line[1:-1]
            continue
        if group == "Desktop Entry" and "=" in line:
            k, _sep, v = line.partition("=")
            keys.setdefault(k.strip(), v.strip())
    return keys


def localized(keys, key):
    """Hodnota klice v jazyce uzivatele (Name[cs_CZ], Name[cs], Name)."""
    lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    lang = lang.split(".")[0].split("@")[0]
    cands = [f"{key}[{lang}]", f"{key}[{lang.split('_')[0]}]"] if lang and lang not in ("C", "POSIX") else []
    for k in cands + [key]:
        if keys.get(k):
            return keys[k]
    return ""


def valid_icon(data, ext):
    if not data:
        return False
    if ext == "png":
        if len(data) < 24 or data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
            return False
        w, h = struct.unpack(">II", data[16:24])
        return 0 < w <= 1024 and 0 < h <= 1024
    try:
        text = data.decode("utf-8").lower()
    except UnicodeDecodeError:
        return False
    if "<svg" not in text:
        return False
    for bad in ("<!doctype", "<!entity", "<script", "<foreignobject", "<iframe", "<?xml-stylesheet", "javascript:",
                "@import", "xi:include"):
        if bad in text:
            return False
    if re.search(r"\son[a-z]+\s*=", text):   # obsluha udalosti (onload=...)
        return False
    # odkazy jen dovnitr souboru (#id) nebo vlozeny rastrovy obrazek - nic z disku ani ze site
    for ref in re.findall(r"href\s*=\s*[\"']([^\"']*)", text) + re.findall(r"url\(\s*[\"']?([^)\"']*)", text):
        ref = ref.strip()
        if not (ref.startswith("#") or ref.startswith(("data:image/png;base64,", "data:image/jpeg;base64,"))):
            return False
    return True


def find_icon(root_fd, value):
    """(data, pripona) ikony z hodnoty Icon= - jen regularni PNG/SVG rozumne velikosti uvnitr korene."""
    value = value.strip()
    cands = []
    if value.startswith("/"):
        rel = value[1:]
        ext = rel.rsplit(".", 1)[-1].lower()
        if rel.startswith("usr/share/") and ext in ICON_LIMIT:
            cands.append((rel, ext))
    elif ICON_NAME_RE.match(value):
        base = value[:-4] if value.lower().endswith((".png", ".svg")) else value
        if ICON_NAME_RE.match(base):
            cands = [(f"{d}/{base}.{ext}", ext) for d in ICON_DIRS for ext in ("svg", "png")]
    for rel, ext in cands:
        data = read_at(root_fd, rel, ICON_LIMIT[ext])
        if valid_icon(data, ext):
            return data, ext
    return None


def main_command(pkg, bins):
    """Hlavni prikaz balicku (jako APP_QUERY): stejny nazev, nazev bez predpony, jinak prvni."""
    for want in (pkg, pkg.split("-", 1)[-1], pkg.rsplit("-", 1)[0]):
        if want in bins:
            return want
    return bins[0] if bins else ""


def host_command_exists(name):
    """Ma system (hostitel) prikaz tohoto jmena? Pak obal nevznika - prikaz systemu vzdy vyhraje."""
    dirs = [d for d in os.environ.get("PATH", "").split(":") if d.startswith("/")]
    dirs += ["/usr/local/sbin", "/usr/local/bin", "/usr/bin", "/usr/bin/site_perl", "/usr/bin/vendor_perl",
             "/usr/bin/core_perl", "/usr/lib/luxos/override-bin", os.path.expanduser("~/.local/bin")]
    own = os.path.realpath(BIN_DIR)
    for d in dirs:
        if os.path.realpath(d) == own:
            continue
        if os.path.lexists(os.path.join(d, name)):
            return True
    return False


