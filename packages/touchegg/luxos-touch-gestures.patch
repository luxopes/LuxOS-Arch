+double LibinputTouchHandler::getSpreadDelta() const {
+  if (this->state.startX.empty()) {
+    return 0;
+  }
+  double sx = 0, sy = 0, cx = 0, cy = 0;
+  for (const auto &pair : this->state.startX) {
+    int32_t slot = pair.first;
+    sx += this->state.startX.at(slot);
+    sy += this->state.startY.at(slot);
+    cx += this->state.currentX.at(slot);
+    cy += this->state.currentY.at(slot);
+  }
+  double n = static_cast<double>(this->state.startX.size());
+  sx /= n;
+  sy /= n;
+  cx /= n;
+  cy /= n;
+  double startDist = 0, currentDist = 0;
+  for (const auto &pair : this->state.startX) {
+    int32_t slot = pair.first;
+    startDist += std::hypot(this->state.startX.at(slot) - sx,
+                            this->state.startY.at(slot) - sy);
+    currentDist += std::hypot(this->state.currentX.at(slot) - cx,
+                              this->state.currentY.at(slot) - cy);
+  }
+  return (currentDist - startDist) / n;
+}
+
+bool LibinputTouchHandler::allFingersMoved(double minDelta) const {
+  for (const auto &pair : this->state.startX) {
+    int32_t slot = pair.first;
+    double diffX = this->state.currentX.at(slot) - this->state.startX.at(slot);
+    double diffY = this->state.currentY.at(slot) - this->state.startY.at(slot);
+    if (std::max(std::abs(diffX), std::abs(diffY)) < minDelta) {
+      return false;
+    }
+  }
+  return true;
+}
