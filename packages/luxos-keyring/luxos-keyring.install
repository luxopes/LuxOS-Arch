# Klice LuxOS do klicenky spravce baliku (pokud uz je inicializovana).
# S lux-engine je nacte jeho hook lux-engine-keyrings (po transakci); tady jen bez nej (LuxOS 0.9.0,
# kde se klicenky aktualizuji samostatnou transakci jeste pred vymenou jadra za lux-engine).
post_install() {
    [[ -e /usr/share/libalpm/hooks/lux-engine-keyrings.hook ]] && return 0
    local PATH="/usr/lib/lux/alpm/bin:$PATH" key gpgdir
    # jadro LuxOS 0.9.0 (luxos-pacman) melo nastroj klicenky pod jmenem z Archu
    for key in lux-engine-key pacman-key; do command -v "$key" >/dev/null && break; key=""; done
    [[ -n $key ]] || return 0
    for gpgdir in /etc/lux/keyring /etc/pacman.d/gnupg; do
        if [[ -r $gpgdir/pubring.gpg || -r $gpgdir/pubring.kbx ]]; then
            "$key" --populate luxos
            return 0
        fi
    done
}
post_upgrade() { post_install; }
