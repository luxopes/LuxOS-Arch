+/**************************************************************/
+static void ExecOnScrollCmd (struct genmon_t *poPlugin, const char *dir)
+/* LuxOS: <scroll> command with "up" / "down" */
+{
+    GError *error = NULL;
+    char *cmd = g_strdup_printf ("%s %s", poPlugin->oMonitor.onScrollCmd, dir);
+
+    xfce_spawn_command_line (gdk_screen_get_default (), cmd, 0, 0, 1, &error);
+    if (error)
+        g_error_free (error);
+    g_free (cmd);
+}
+
+static gboolean OnScroll (GtkWidget *w, GdkEventScroll *ev, void *p_pvPlugin)
+{
+    struct genmon_t *poPlugin = (genmon_t *) p_pvPlugin;
+    struct monitor_t *poMonitor = &(poPlugin->oMonitor);
+    gdouble dx, dy;
+
+    if (!poMonitor->onScrollCmd || !poMonitor->onScrollCmd[0])
+        return FALSE;
+    switch (ev->direction)
+        {
+        case GDK_SCROLL_UP:
+        case GDK_SCROLL_RIGHT:
+            ExecOnScrollCmd (poPlugin, "up");
+            break;
+        case GDK_SCROLL_DOWN:
+        case GDK_SCROLL_LEFT:
+            ExecOnScrollCmd (poPlugin, "down");
+            break;
+        case GDK_SCROLL_SMOOTH:
+            /* touchpad: jeden krok za kazdy cely "zub" kolecka */
+            if (gdk_event_get_scroll_deltas ((GdkEvent *) ev, &dx, &dy))
+                poMonitor->scrollDelta += dy;
+            while (poMonitor->scrollDelta <= -1.0)
+                {
+                    poMonitor->scrollDelta += 1.0;
+                    ExecOnScrollCmd (poPlugin, "up");
+                }
+            while (poMonitor->scrollDelta >= 1.0)
+                {
+                    poMonitor->scrollDelta -= 1.0;
+                    ExecOnScrollCmd (poPlugin, "down");
+                }
+            break;
+        default:
+            break;
+        }
+    return TRUE;
+}
+
