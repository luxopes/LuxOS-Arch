#!/bin/bash
# LuxOS - generator systemd: limit procesu a vlaken jedne relace a uzivatele s pevnym spodnim limitem.
# Staticke drop-iny (tasks-session.conf 5 %, tasks-user.conf 8 % maxima jadra) jsou na pocitacich
# s 4-8 GB RAM tesne: 8 GB -> relace ~3 000 vlaken, prohlizec + Steam + IDE ma 2 000-4 000. Zde:
#   relace    = max(5 % maxima, min(4096, RAM v MB / 2))
#   uzivatel  = max(8 % maxima, relace + 1024)  (Terminal a nove prihlaseni maji vzdy rezervu)
# Spodni limit RAM/2 drzi fork bombu i v nejhorsim pripade (0,83 MB na proces, namereno) pod ~40 % RAM;
# zastavi ji hlavne luxos-forkguard (luxos-desktop), limit je zaloha. 16 GB a vic: beze zmeny (5 %/8 %).
# Vystup do adresare generatoru ($1): ma prednost pred /usr/lib, /etc (vlastni nastaveni spravce) pred nim.
# Pri chybe nic nezapise a plati staticke drop-iny. LUXOS_PROC = falesny /proc pro testy.
set -u
out=${1:-}
[[ -n $out && -d $out ]] || exit 0
proc=${LUXOS_PROC:-/proc}

num() {
    local v
    [[ -r $1 ]] || return 1
    v=$(<"$1") || return 1
    [[ $v =~ ^[0-9]+$ ]] || return 1
    echo "$v"
}
threads=$(num "$proc/sys/kernel/threads-max") || exit 0
pidmax=$(num "$proc/sys/kernel/pid_max") || pidmax=$((threads + 1))
max=$threads
((pidmax - 1 < max)) && max=$((pidmax - 1))
ram_kb=0
if [[ -r $proc/meminfo ]]; then
    while read -r key val _; do
        if [[ $key == MemTotal: ]]; then
            ram_kb=$val
            break
        fi
    done <"$proc/meminfo"
fi
[[ $ram_kb =~ ^[0-9]+$ ]] || exit 0
((ram_kb > 0 && max > 0)) || exit 0

floor=$((ram_kb / 1024 / 2))
((floor > 4096)) && floor=4096
session=$((max * 5 / 100))
((session < floor)) && session=$floor
user=$((max * 8 / 100))
((user < session + 1024)) && user=$((session + 1024))
# nikdy vic nez polovina maxima jadra (zbytek pro system a sluzby)
((user > max / 2)) && user=$((max / 2))
((session > user)) && session=$user

mkdir -p "$out/session-.scope.d" "$out/user-.slice.d" || exit 0
printf '# luxos-tasks-generator: 5 %% maxima jadra, nejmene min(4096, RAM/2) (RAM %s MB, maximum %s)\n[Scope]\nTasksMax=%s\n' \
    "$((ram_kb / 1024))" "$max" "$session" >"$out/session-.scope.d/10-luxos-tasks.conf"
printf '# luxos-tasks-generator: 8 %% maxima jadra, nejmene limit relace + 1024\n[Slice]\nTasksMax=%s\n' \
    "$user" >"$out/user-.slice.d/10-luxos-tasks.conf"
exit 0
