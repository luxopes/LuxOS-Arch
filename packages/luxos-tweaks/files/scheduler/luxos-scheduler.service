[Unit]
Description=LuxOS CPU scheduler (sched_ext scx_lavd)
Documentation=https://github.com/sched-ext/scx
# Az po startu prihlasovaci obrazovky: nacteni programu BPF nebere procesor startu a na planovac
# nic neceka. Bez sched_ext v jadre se jednotka preskoci; zapnuty scx_loader (scx-tools) ma prednost.
After=graphical.target
ConditionPathExists=/sys/kernel/sched_ext
ConditionPathExists=!/etc/systemd/system/multi-user.target.wants/scx_loader.service
Conflicts=scx_loader.service
# Opakovany pad: luxos-scheduler po 3 padech za 24 h sam zustane u planovace jadra (konec s 0, zadna
# selhana sluzba); StartLimit je jen pojistka proti rychlemu cyklu
StartLimitIntervalSec=1h
StartLimitBurst=8

[Service]
Type=simple
ExecStart=/usr/lib/luxos/luxos-scheduler
# Pad: jadro hned prejde na EEVDF, novy pokus po 10 s, 30 s ... nejvys po 10 min (nacteni programu
# BPF bere procesor - zadne rychle opakovani pri zatizeni)
Restart=on-failure
RestartSec=10
RestartSteps=4
RestartMaxDelaySec=10min
# scx_* se pri SIGINT ukonci cisty (jadro prejde zpet na EEVDF); luxos-scheduler signal preda
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=10
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=graphical.target
