# LuxOS - prechod ze systemd-oomd na earlyoom u stavajicich instalaci
# Hook initramfs "luxos-boot": drop-in v /etc (mkinitcpio cte jen /etc/mkinitcpio.conf.d), vlastni
# zmeny uzivatele se neprepisuji. Initramfs se znovu sestavi sam (hook mkinitcpio na usr/lib/initcpio).
_boot_hook() {
    local d=/etc/mkinitcpio.conf.d f=/etc/mkinitcpio.conf.d/zz-luxos-boot.conf
    [ -e "$f" ] && return 0
    mkdir -p "$d" && install -m644 /usr/lib/luxos/boot/zz-luxos-boot.conf "$f"
}

# Hook initramfs "luxos-slim" (mensi initramfs, zadny useknuty obraz na plnem EFI oddilu): stejne jako
# luxos-boot; mkinitcpio initramfs sestavi znovu po teto transakci (novy soubor v usr/lib/initcpio).
_slim_hook() {
    local d=/etc/mkinitcpio.conf.d f=/etc/mkinitcpio.conf.d/zz-luxos-slim.conf
    [ -e "$f" ] && return 0
    mkdir -p "$d" && install -m644 /usr/lib/luxos/boot/zz-luxos-slim.conf "$f"
}

post_install() {
    systemctl enable earlyoom.service >/dev/null 2>&1 || true
    systemctl enable luxos-scheduler.service >/dev/null 2>&1 || true
    _boot_hook
    _slim_hook
    /usr/lib/luxos/luxos-faillock-setup || true
    _tmp_on_disk
}

# /tmp z pameti (tmpfs) na disk: subvolume @tmp + fstab, plati od pristiho startu (bezici /tmp se
# nemeni). V chrootu (instalator, ISO) a pri startu ze snimku nic; nikdy neselze.
_tmp_on_disk() {
    /usr/lib/luxos/luxos-tmp-setup 2>&1 | sed 's/^/  /' || true
}

post_upgrade() {
    _boot_hook
    _slim_hook
    /usr/lib/luxos/luxos-faillock-setup || true
    _tmp_on_disk
    systemctl disable systemd-oomd.service systemd-oomd.socket >/dev/null 2>&1 || true
    # Cache balicku cisti LuxOS Care (lux); paccache.timer z pacman-contrib uz LuxOS nepouziva
    systemctl disable paccache.timer >/dev/null 2>&1 || true
    systemctl enable earlyoom.service >/dev/null 2>&1 || true
    # Planovac scx_lavd (LuxOS 1.0): zapnout jednou pri prechodu; vypina se v /etc/luxos/scheduler.conf
    # (luxos-care scheduler default), rucni "systemctl disable" pozdejsi aktualizace nevrati
    if [ "$(vercmp "$2" 1.0.0-8)" -lt 0 ]; then
        systemctl enable luxos-scheduler.service >/dev/null 2>&1 || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1
        systemctl stop systemd-oomd.service systemd-oomd.socket >/dev/null 2>&1 || true
        systemctl stop paccache.timer >/dev/null 2>&1 || true
        systemctl restart earlyoom.service >/dev/null 2>&1 || true
        # Nova nastaveni sysctl (kernel.kptr_restrict) hned, bez restartu
        sysctl -q --system >/dev/null 2>&1 || true
    fi
}

post_remove() {
    rm -f /etc/mkinitcpio.conf.d/zz-luxos-boot.conf /etc/mkinitcpio.conf.d/zz-luxos-slim.conf
}
