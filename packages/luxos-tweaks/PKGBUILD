# Maintainer: LuxOS Team

pkgname=luxos-tweaks
pkgver=1.0.0
pkgrel=3
pkgdesc="LuxOS performance defaults: zram, sysctl, I/O schedulers, low-memory safeguard (earlyoom), Battery/Data Saver system parts"
arch=(any)
url="https://github.com/luxos"
license=(MIT)
depends=(systemd zram-generator pacman-contrib reflector earlyoom dbus)
install=luxos-tweaks.install
backup=(etc/systemd/zram-generator.conf)

package() {
    local f="$startdir/files"
    install -Dm644 "$f/zram-generator.conf"  "$pkgdir/etc/systemd/zram-generator.conf"
    install -Dm644 "$f/99-luxos.conf"        "$pkgdir/usr/lib/sysctl.d/99-luxos.conf"
    install -Dm644 "$f/modules-luxos.conf"   "$pkgdir/usr/lib/modules-load.d/luxos.conf"
    install -Dm644 "$f/journald.conf"        "$pkgdir/usr/lib/systemd/journald.conf.d/50-luxos.conf"
    install -Dm644 "$f/system.conf"          "$pkgdir/usr/lib/systemd/system.conf.d/50-luxos.conf"
    install -Dm644 "$f/user.conf"            "$pkgdir/usr/lib/systemd/user.conf.d/50-luxos.conf"
    install -Dm644 "$f/60-luxos-ioschedulers.rules" "$pkgdir/usr/lib/udev/rules.d/60-luxos-ioschedulers.rules"
    # Pojistka proti nedostatku pameti: earlyoom ukonci jeden proces (systemd-oomd by na Xfce
    # ukoncil celou relaci), brzda pro aplikace a ochrana grafickeho serveru
    install -Dm644 "$f/earlyoom.conf"        "$pkgdir/usr/lib/systemd/system/earlyoom.service.d/10-luxos.conf"
    install -Dm644 "$f/memory-user.conf"     "$pkgdir/usr/lib/systemd/system/user-.slice.d/10-luxos-memory.conf"
    install -Dm644 "$f/memory-display.conf"  "$pkgdir/usr/lib/systemd/system/lightdm.service.d/10-luxos-memory.conf"
    install -Dm644 "$f/makepkg.conf"         "$pkgdir/etc/makepkg.conf.d/luxos.conf"
    install -Dm644 "$f/services"             "$pkgdir/usr/lib/luxos/services"
    # Sporic baterie - systemova cast (luxos-powersaver zapina jednotku bez hesla pres polkit)
    install -Dm755 "$f/power/luxos-powersaver-helper" "$pkgdir/usr/lib/luxos/luxos-powersaver-helper"
    install -Dm644 "$f/power/luxos-powersaver.service" "$pkgdir/usr/lib/systemd/system/luxos-powersaver.service"
    install -Dm644 "$f/power/50-luxos-powersaver.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-luxos-powersaver.rules"
    # Sporic dat: stahovani systemovych sluzeb na pozadi se na merenem pripojeni preskoci
    install -Dm755 "$f/power/luxos-unmetered" "$pkgdir/usr/lib/luxos/luxos-unmetered"
    local u
    for u in reflector archlinux-keyring-wkd-sync; do
        install -Dm644 "$f/power/50-luxos-datasaver.conf" "$pkgdir/usr/lib/systemd/system/$u.service.d/50-luxos-datasaver.conf"
    done
}
