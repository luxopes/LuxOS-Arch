<?xml version="1.0" encoding="UTF-8"?>
<!--
 LuxOS - zvyrazneni syntaxe LSL (Lux Simple Lang) pro Textovy editor (GtkSourceView 4).
 Bloky koncici "end", komentare # a /* */, retezce "" '' r"" l"{...}".
-->
<language id="lsl" name="LSL" version="2.0" _section="Script">
  <metadata>
    <property name="mimetypes">text/x-lsl</property>
    <property name="globs">*.lsl</property>
    <property name="line-comment-start">#</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="escape" name="Escaped Character" map-to="def:special-char"/>
    <style id="interpolation" name="Interpolation" map-to="def:special-char"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="declaration" name="Declaration" map-to="def:type"/>
    <style id="builtin" name="Builtin" map-to="def:builtin"/>
    <style id="constant" name="Constant" map-to="def:special-constant"/>
    <style id="boolean" name="Boolean" map-to="def:boolean"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="function" name="Function Name" map-to="def:function"/>
  </styles>

  <definitions>
    <context id="escape" style-ref="escape">
      <match>\\[ntr"'\\0]</match>
    </context>

    <context id="interp-string" style-ref="string" end-at-line-end="true">
      <start>l"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
        <context id="interp" style-ref="interpolation">
          <match>\{[^{}"]*\}</match>
        </context>
      </include>
    </context>

    <context id="raw-string" style-ref="string" end-at-line-end="true">
      <start>r"</start>
      <end>"</end>
    </context>

    <context id="raw-string-single" style-ref="string" end-at-line-end="true">
      <start>r'</start>
      <end>'</end>
    </context>

    <context id="double-string" style-ref="string" end-at-line-end="true">
      <start>"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <context id="single-string" style-ref="string" end-at-line-end="true">
      <start>'</start>
      <end>'</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <context id="function-name">
      <match>\b(function|class)\s+([A-Za-z_][A-Za-z0-9_]*)</match>
      <include>
        <context sub-pattern="1" style-ref="declaration"/>
        <context sub-pattern="2" style-ref="function"/>
      </include>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>if</keyword>
      <keyword>elif</keyword>
      <keyword>else</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>while</keyword>
      <keyword>loop</keyword>
      <keyword>break</keyword>
      <keyword>continue</keyword>
      <keyword>end</keyword>
      <keyword>return</keyword>
      <keyword>call</keyword>
      <keyword>load</keyword>
      <keyword>from</keyword>
      <keyword>as</keyword>
      <keyword>safe</keyword>
      <keyword>try</keyword>
      <keyword>unsafe</keyword>
      <keyword>lock</keyword>
      <keyword>check</keyword>
      <keyword>global</keyword>
      <keyword>exit</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
      <keyword>print</keyword>
      <keyword>printl</keyword>
      <keyword>printr</keyword>
    </context>

    <context id="declarations" style-ref="declaration">
      <keyword>function</keyword>
      <keyword>class</keyword>
      <keyword>ctype</keyword>
      <keyword>init</keyword>
      <keyword>origin</keyword>
      <keyword>self</keyword>
    </context>

    <context id="builtins" style-ref="builtin">
      <keyword>Int</keyword>
      <keyword>Float</keyword>
      <keyword>String</keyword>
      <keyword>Bool</keyword>
      <keyword>List</keyword>
      <keyword>Dictionary</keyword>
      <keyword>Tuple</keyword>
      <keyword>Set</keyword>
      <keyword>ByteArray</keyword>
      <keyword>IntArray</keyword>
      <keyword>FloatArray</keyword>
      <keyword>RealArray</keyword>
      <keyword>Error</keyword>
      <keyword>len</keyword>
      <keyword>range</keyword>
      <keyword>rang</keyword>
      <keyword>input</keyword>
      <keyword>arg</keyword>
      <keyword>arg_count</keyword>
      <keyword>type</keyword>
      <keyword>Public</keyword>
      <keyword>Private</keyword>
    </context>

    <context id="booleans" style-ref="boolean">
      <keyword>True</keyword>
      <keyword>False</keyword>
      <keyword>true</keyword>
      <keyword>false</keyword>
    </context>

    <context id="none" style-ref="constant">
      <keyword>None</keyword>
    </context>

    <context id="number" style-ref="number">
      <match>(?&lt;![\w.])([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?|0[xX][0-9A-Fa-f]+|0[bB][01]+)(?![\w.])</match>
    </context>

    <context id="lsl" class="no-spell-check">
      <include>
        <context ref="def:c-like-comment-multiline" style-ref="comment"/>
        <context ref="def:shebang" style-ref="comment"/>
        <context id="line-comment" style-ref="comment" end-at-line-end="true" class-disabled="no-spell-check" class="comment">
          <start>#</start>
          <include>
            <context ref="def:in-comment"/>
          </include>
        </context>
        <context ref="interp-string"/>
        <context ref="raw-string"/>
        <context ref="raw-string-single"/>
        <context ref="double-string"/>
        <context ref="single-string"/>
        <context ref="function-name"/>
        <context ref="keywords"/>
        <context ref="declarations"/>
        <context ref="builtins"/>
        <context ref="booleans"/>
        <context ref="none"/>
        <context ref="number"/>
      </include>
    </context>
  </definitions>
</language>
